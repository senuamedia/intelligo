/// Intelligo LMS - Stripe Payment Integration
///
/// Complete Stripe integration for payment processing including:
/// - Product/Price management for courses
/// - Checkout sessions for purchases
/// - Subscription management (monthly/annual)
/// - Webhook handling for payment events
/// - Refund processing and invoice generation
/// - Coupon/discount support
/// - Multi-currency support
/// - Connect marketplace for course creators

module intelligo::integrations::payments::stripe

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List}
use std::http::{HttpClient, Request, Response, Headers}
use std::crypto::{hmac_sha256, constant_time_compare}
use std::json::{Json, to_json, from_json}

// =============================================================================
// CONFIGURATION
// =============================================================================

/// Stripe configuration
type StripeConfig {
    /// API secret key
    secret_key: String,

    /// Publishable key (for client)
    publishable_key: String,

    /// Webhook signing secret
    webhook_secret: String,

    /// Connect client ID (for marketplace)
    connect_client_id: Option<String>,

    /// Default currency
    default_currency: Currency,

    /// API version
    api_version: String,

    /// Base API URL
    base_url: String,

    /// Webhook tolerance window (seconds)
    webhook_tolerance: i64,

    /// Enable test mode
    test_mode: Bool
}

impl StripeConfig {
    fn default() -> StripeConfig {
        StripeConfig {
            secret_key: "",
            publishable_key: "",
            webhook_secret: "",
            connect_client_id: None,
            default_currency: Currency::USD,
            api_version: "2023-10-16",
            base_url: "https://api.stripe.com/v1",
            webhook_tolerance: 300,
            test_mode: true
        }
    }

    fn from_env() -> Result<StripeConfig, StripeError> {
        let secret_key = std::env::get("STRIPE_SECRET_KEY")
            .ok_or(StripeError::ConfigurationError { message: "STRIPE_SECRET_KEY not set".to_string() })?;
        let publishable_key = std::env::get("STRIPE_PUBLISHABLE_KEY")
            .ok_or(StripeError::ConfigurationError { message: "STRIPE_PUBLISHABLE_KEY not set".to_string() })?;
        let webhook_secret = std::env::get("STRIPE_WEBHOOK_SECRET")
            .ok_or(StripeError::ConfigurationError { message: "STRIPE_WEBHOOK_SECRET not set".to_string() })?;

        Ok(StripeConfig {
            secret_key,
            publishable_key,
            webhook_secret,
            connect_client_id: std::env::get("STRIPE_CONNECT_CLIENT_ID"),
            default_currency: Currency::USD,
            api_version: "2023-10-16".to_string(),
            base_url: "https://api.stripe.com/v1".to_string(),
            webhook_tolerance: 300,
            test_mode: secret_key.starts_with("sk_test_")
        })
    }
}

// =============================================================================
// CURRENCY TYPES
// =============================================================================

/// Supported currencies
enum Currency {
    USD,
    EUR,
    GBP,
    CAD,
    AUD,
    JPY,
    CHF,
    INR,
    BRL,
    MXN,
    Custom { code: String }
}

impl Currency {
    fn to_code(&self) -> String {
        match self {
            Currency::USD => "usd",
            Currency::EUR => "eur",
            Currency::GBP => "gbp",
            Currency::CAD => "cad",
            Currency::AUD => "aud",
            Currency::JPY => "jpy",
            Currency::CHF => "chf",
            Currency::INR => "inr",
            Currency::BRL => "brl",
            Currency::MXN => "mxn",
            Currency::Custom { code } => code.to_lowercase()
        }.to_string()
    }

    fn from_code(code: &str) -> Currency {
        match code.to_lowercase().as_str() {
            "usd" => Currency::USD,
            "eur" => Currency::EUR,
            "gbp" => Currency::GBP,
            "cad" => Currency::CAD,
            "aud" => Currency::AUD,
            "jpy" => Currency::JPY,
            "chf" => Currency::CHF,
            "inr" => Currency::INR,
            "brl" => Currency::BRL,
            "mxn" => Currency::MXN,
            _ => Currency::Custom { code: code.to_string() }
        }
    }

    /// Check if currency uses zero decimal (no cents)
    fn is_zero_decimal(&self) -> Bool {
        matches!(self, Currency::JPY)
    }

    /// Convert amount to smallest unit (cents/pence/etc)
    fn to_smallest_unit(&self, amount: f64) -> i64 {
        if self.is_zero_decimal() {
            amount as i64
        } else {
            (amount * 100.0).round() as i64
        }
    }

    /// Convert from smallest unit to decimal
    fn from_smallest_unit(&self, amount: i64) -> f64 {
        if self.is_zero_decimal() {
            amount as f64
        } else {
            amount as f64 / 100.0
        }
    }
}

