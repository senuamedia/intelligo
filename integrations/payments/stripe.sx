    default_payment_method: Option<String>,
    footer: Option<String>,
    custom_fields: List<CustomField>
}

/// Custom field for invoices
type CustomField {
    name: String,
    value: String
}

/// Stripe product (represents a course)
type StripeProduct {
    id: String,
    name: String,
    description: Option<String>,
    active: Bool,
    metadata: Map<String, String>,
    images: List<String>,
    default_price: Option<String>,
    created: i64,
    updated: i64
}

/// Stripe price (pricing for a product)
type StripePrice {
    id: String,
    product: String,
    active: Bool,
    currency: String,
    unit_amount: Option<i64>,
    billing_scheme: BillingScheme,
    recurring: Option<RecurringPrice>,
    type_: PriceType,
    metadata: Map<String, String>,
    created: i64
}

/// Billing scheme
enum BillingScheme {
    PerUnit,
    Tiered
}

/// Recurring pricing
type RecurringPrice {
    interval: PriceInterval,
    interval_count: i32,
    trial_period_days: Option<i32>,
    usage_type: UsageType
}

/// Price interval
enum PriceInterval {
    Day,
    Week,
    Month,
    Year
}

/// Usage type for metered billing
enum UsageType {
    Licensed,
    Metered
}

/// Price type
enum PriceType {
    OneTime,
    Recurring
}

/// Checkout session
type CheckoutSession {
    id: String,
    url: Option<String>,
    success_url: String,
    cancel_url: String,
    customer: Option<String>,
    customer_email: Option<String>,
    payment_status: PaymentStatus,
    status: SessionStatus,
    mode: SessionMode,
    line_items: Option<List<LineItem>>,
    metadata: Map<String, String>,
    amount_total: Option<i64>,
    currency: Option<String>,
    subscription: Option<String>,
    payment_intent: Option<String>,
    created: i64,
    expires_at: i64
}

/// Payment status
enum PaymentStatus {
    Paid,
    Unpaid,
    NoPaymentRequired
}

/// Session status
enum SessionStatus {
    Open,
    Complete,
    Expired
}

/// Session mode
enum SessionMode {
    Payment,
    Setup,
    Subscription
}

/// Line item in checkout
