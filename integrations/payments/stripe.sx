/// Stripe customer
type StripeCustomer {
    id: String,
    email: Option<String>,
    name: Option<String>,
    description: Option<String>,
    metadata: Map<String, String>,
    default_source: Option<String>,
    invoice_settings: Option<InvoiceSettings>,
    created: i64,
    livemode: Bool
}

/// Invoice settings for customer
