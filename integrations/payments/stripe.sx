/// Account type
enum AccountType {
    Standard,
    Express,
    Custom
}

/// Business profile
type BusinessProfile {
    name: Option<String>,
    url: Option<String>,
    support_email: Option<String>
}

/// Account capabilities
type AccountCapabilities {
    card_payments: CapabilityStatus,
    transfers: CapabilityStatus
}

/// Capability status
enum CapabilityStatus {
    Active,
    Inactive,
    Pending
}

/// Transfer to connected account
type StripeTransfer {
    id: String,
    amount: i64,
    currency: String,
    destination: String,
