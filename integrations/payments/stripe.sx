}

// =============================================================================
// WEBHOOK TYPES
// =============================================================================

/// Stripe webhook event
type StripeEvent {
    id: String,
    type_: String,
    api_version: String,
    created: i64,
    livemode: Bool,
    pending_webhooks: i64,
    data: EventData
}

/// Event data wrapper
type EventData {
    object: Json,
    previous_attributes: Option<Map<String, Json>>
}

/// Webhook event types we handle
enum WebhookEventType {
    /// Checkout completed
    CheckoutSessionCompleted,
    /// Payment succeeded
    PaymentIntentSucceeded,
    /// Payment failed
    PaymentIntentPaymentFailed,
    /// Subscription created
    CustomerSubscriptionCreated,
    /// Subscription updated
    CustomerSubscriptionUpdated,
    /// Subscription deleted
    CustomerSubscriptionDeleted,
    /// Invoice paid
    InvoicePaid,
    /// Invoice payment failed
    InvoicePaymentFailed,
    /// Refund created
    ChargeRefunded,
    /// Customer created
    CustomerCreated,
    /// Account updated (Connect)
    AccountUpdated,
    /// Transfer created (Connect)
    TransferCreated,
    /// Unknown event
    Unknown { event_type: String }
}

impl WebhookEventType {
    fn from_string(s: &str) -> WebhookEventType {
        match s {
            "checkout.session.completed" => WebhookEventType::CheckoutSessionCompleted,
            "payment_intent.succeeded" => WebhookEventType::PaymentIntentSucceeded,
            "payment_intent.payment_failed" => WebhookEventType::PaymentIntentPaymentFailed,
            "customer.subscription.created" => WebhookEventType::CustomerSubscriptionCreated,
            "customer.subscription.updated" => WebhookEventType::CustomerSubscriptionUpdated,
            "customer.subscription.deleted" => WebhookEventType::CustomerSubscriptionDeleted,
            "invoice.paid" => WebhookEventType::InvoicePaid,
            "invoice.payment_failed" => WebhookEventType::InvoicePaymentFailed,
            "charge.refunded" => WebhookEventType::ChargeRefunded,
            "customer.created" => WebhookEventType::CustomerCreated,
            "account.updated" => WebhookEventType::AccountUpdated,
            "transfer.created" => WebhookEventType::TransferCreated,
            _ => WebhookEventType::Unknown { event_type: s.to_string() }
        }
    }
}

// =============================================================================
// ERROR TYPES
// =============================================================================

/// Stripe-specific errors
enum StripeError {
    /// Configuration error
    ConfigurationError { message: String },
    /// API error from Stripe
    ApiError { code: String, message: String, status: i32 },
    /// Card error
    CardError { code: String, decline_code: Option<String>, message: String },
    /// Invalid request
    InvalidRequest { message: String },
    /// Authentication error
    AuthenticationError { message: String },
    /// Rate limit exceeded
    RateLimitError { retry_after: Option<i64> },
    /// Webhook verification failed
    WebhookError { message: String },
    /// Idempotency error
    IdempotencyError { message: String },
    /// Network error
    NetworkError { message: String },
    /// Serialization error
    SerializationError { message: String }
}

impl StripeError {
    fn to_lms_error(&self) -> LmsError {
        match self {
            StripeError::ConfigurationError { message } =>
                LmsError::IntegrationError { provider: "stripe".to_string(), message: message.clone() },
            StripeError::ApiError { message, .. } =>
                LmsError::IntegrationError { provider: "stripe".to_string(), message: message.clone() },
            StripeError::CardError { message, .. } =>
                LmsError::IntegrationError { provider: "stripe".to_string(), message: message.clone() },
            StripeError::InvalidRequest { message } =>
                LmsError::ValidationFailed { errors: vec![ValidationError { field: "stripe".to_string(), message: message.clone(), code: "invalid_request".to_string() }] },
            StripeError::AuthenticationError { message } =>
                LmsError::AccessDenied { reason: message.clone() },
            StripeError::RateLimitError { retry_after } =>
                LmsError::RateLimitExceeded { retry_after: Duration::seconds(retry_after.unwrap_or(60)) },
            StripeError::WebhookError { message } =>
                LmsError::IntegrationError { provider: "stripe".to_string(), message: message.clone() },
            _ => LmsError::IntegrationError { provider: "stripe".to_string(), message: format!("{:?}", self) }
        }
    }
}

