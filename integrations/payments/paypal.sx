/// Intelligo LMS - PayPal Payment Integration
///
/// Complete PayPal integration for payment processing including:
/// - Orders API for one-time purchases
/// - Subscriptions API for recurring billing
/// - Webhook handling for payment events
/// - Payout to instructors

module intelligo::integrations::payments::paypal

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List}
use std::http::{HttpClient, Request, Response, Headers}
use std::json::{Json, to_json, from_json}
use std::crypto::{sha256, hmac_sha256}
use std::base64

// =============================================================================
// CONFIGURATION
// =============================================================================

/// PayPal configuration
type PayPalConfig {
    /// Client ID
    client_id: String,

    /// Client secret
    client_secret: String,

    /// Webhook ID (for signature verification)
    webhook_id: String,

    /// API base URL
    base_url: String,

    /// Sandbox mode
    sandbox: Bool,

    /// Default currency
    default_currency: String,

    /// App fee percentage for marketplace
    app_fee_percentage: f64
}

impl PayPalConfig {
    fn default() -> PayPalConfig {
        PayPalConfig {
            client_id: "",
            client_secret: "",
            webhook_id: "",
            base_url: "https://api-m.sandbox.paypal.com",
            sandbox: true,
            default_currency: "USD",
            app_fee_percentage: 10.0
        }
    }

    fn from_env() -> Result<PayPalConfig, PayPalError> {
        let client_id = std::env::get("PAYPAL_CLIENT_ID")
            .ok_or(PayPalError::ConfigurationError { message: "PAYPAL_CLIENT_ID not set".to_string() })?;
        let client_secret = std::env::get("PAYPAL_CLIENT_SECRET")
            .ok_or(PayPalError::ConfigurationError { message: "PAYPAL_CLIENT_SECRET not set".to_string() })?;
        let webhook_id = std::env::get("PAYPAL_WEBHOOK_ID")
            .ok_or(PayPalError::ConfigurationError { message: "PAYPAL_WEBHOOK_ID not set".to_string() })?;

        let sandbox = std::env::get("PAYPAL_SANDBOX")
            .map(|v| v.to_lowercase() == "true")
            .unwrap_or(true);

        let base_url = if sandbox {
            "https://api-m.sandbox.paypal.com"
        } else {
            "https://api-m.paypal.com"
        }.to_string();

        Ok(PayPalConfig {
            client_id,
            client_secret,
            webhook_id,
            base_url,
            sandbox,
            default_currency: std::env::get("PAYPAL_DEFAULT_CURRENCY").unwrap_or("USD".to_string()),
            app_fee_percentage: std::env::get("PAYPAL_APP_FEE_PERCENT")
                .and_then(|v| v.parse().ok())
                .unwrap_or(10.0)
        })
    }

    fn production() -> PayPalConfig {
        PayPalConfig {
            base_url: "https://api-m.paypal.com".to_string(),
            sandbox: false,
            ..PayPalConfig::default()
        }
    }
}

// =============================================================================
// PAYPAL TYPES
// =============================================================================

/// PayPal access token
type AccessToken {
    token: String,
    token_type: String,
    expires_at: DateTime
}

/// PayPal order
type PayPalOrder {
    id: String,
    status: OrderStatus,
    intent: OrderIntent,
    purchase_units: List<PurchaseUnit>,
    payer: Option<Payer>,
    create_time: String,
    update_time: Option<String>,
    links: List<HateoasLink>
}

/// Order status
enum OrderStatus {
    Created,
    Saved,
    Approved,
    Voided,
    Completed,
    PayerActionRequired
}

impl OrderStatus {
    fn from_string(s: &str) -> OrderStatus {
        match s.to_uppercase().as_str() {
            "CREATED" => OrderStatus::Created,
            "SAVED" => OrderStatus::Saved,
            "APPROVED" => OrderStatus::Approved,
            "VOIDED" => OrderStatus::Voided,
            "COMPLETED" => OrderStatus::Completed,
            "PAYER_ACTION_REQUIRED" => OrderStatus::PayerActionRequired,
            _ => OrderStatus::Created
        }
    }

    fn to_string(&self) -> String {
        match self {
            OrderStatus::Created => "CREATED",
            OrderStatus::Saved => "SAVED",
            OrderStatus::Approved => "APPROVED",
            OrderStatus::Voided => "VOIDED",
            OrderStatus::Completed => "COMPLETED",
            OrderStatus::PayerActionRequired => "PAYER_ACTION_REQUIRED"
        }.to_string()
    }
}

/// Order intent
enum OrderIntent {
    Capture,
    Authorize
}

impl OrderIntent {
    fn to_string(&self) -> String {
        match self {
            OrderIntent::Capture => "CAPTURE",
            OrderIntent::Authorize => "AUTHORIZE"
        }.to_string()
    }
}

