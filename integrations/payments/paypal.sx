}

/// Payout item status
enum PayoutItemStatus {
    Success,
    Failed,
    Pending,
    Unclaimed,
    Returned,
    Onhold,
    Blocked,
    Refunded,
    Reversed
}

impl PayoutItemStatus {
    fn from_string(s: &str) -> PayoutItemStatus {
        match s.to_uppercase().as_str() {
            "SUCCESS" => PayoutItemStatus::Success,
            "FAILED" => PayoutItemStatus::Failed,
            "PENDING" => PayoutItemStatus::Pending,
            "UNCLAIMED" => PayoutItemStatus::Unclaimed,
            "RETURNED" => PayoutItemStatus::Returned,
            "ONHOLD" => PayoutItemStatus::Onhold,
            "BLOCKED" => PayoutItemStatus::Blocked,
            "REFUNDED" => PayoutItemStatus::Refunded,
            "REVERSED" => PayoutItemStatus::Reversed,
            _ => PayoutItemStatus::Pending
        }
    }
}

// =============================================================================
// WEBHOOK TYPES
// =============================================================================

/// PayPal webhook event
type PayPalWebhookEvent {
    id: String,
    event_version: String,
    create_time: String,
    resource_type: String,
    event_type: String,
    summary: String,
    resource: Json,
    links: List<HateoasLink>
}

/// Webhook event types
enum PayPalEventType {
    /// Checkout order approved
    CheckoutOrderApproved,
    /// Checkout order completed
    CheckoutOrderCompleted,
    /// Payment capture completed
    PaymentCaptureCompleted,
    /// Payment capture denied
    PaymentCaptureDenied,
    /// Payment capture refunded
    PaymentCaptureRefunded,
    /// Subscription activated
    BillingSubscriptionActivated,
    /// Subscription cancelled
    BillingSubscriptionCancelled,
    /// Subscription suspended
    BillingSubscriptionSuspended,
    /// Subscription payment failed
    BillingSubscriptionPaymentFailed,
    /// Payout batch success
    PaymentPayoutsBatchSuccess,
    /// Unknown event
    Unknown { event_type: String }
}

impl PayPalEventType {
    fn from_string(s: &str) -> PayPalEventType {
        match s {
            "CHECKOUT.ORDER.APPROVED" => PayPalEventType::CheckoutOrderApproved,
            "CHECKOUT.ORDER.COMPLETED" => PayPalEventType::CheckoutOrderCompleted,
            "PAYMENT.CAPTURE.COMPLETED" => PayPalEventType::PaymentCaptureCompleted,
            "PAYMENT.CAPTURE.DENIED" => PayPalEventType::PaymentCaptureDenied,
            "PAYMENT.CAPTURE.REFUNDED" => PayPalEventType::PaymentCaptureRefunded,
            "BILLING.SUBSCRIPTION.ACTIVATED" => PayPalEventType::BillingSubscriptionActivated,
            "BILLING.SUBSCRIPTION.CANCELLED" => PayPalEventType::BillingSubscriptionCancelled,
            "BILLING.SUBSCRIPTION.SUSPENDED" => PayPalEventType::BillingSubscriptionSuspended,
            "BILLING.SUBSCRIPTION.PAYMENT.FAILED" => PayPalEventType::BillingSubscriptionPaymentFailed,
            "PAYMENT.PAYOUTSBATCH.SUCCESS" => PayPalEventType::PaymentPayoutsBatchSuccess,
            _ => PayPalEventType::Unknown { event_type: s.to_string() }
        }
    }
}

// =============================================================================
// ERROR TYPES
// =============================================================================

/// PayPal-specific errors
enum PayPalError {
    /// Configuration error
    ConfigurationError { message: String },
    /// Authentication error
    AuthenticationError { message: String },
    /// API error
    ApiError { name: String, message: String, debug_id: Option<String> },
    /// Invalid request
    InvalidRequest { message: String, details: Option<List<ErrorDetail>> },
    /// Resource not found
    NotFound { resource_type: String, resource_id: String },
    /// Unprocessable entity
    UnprocessableEntity { message: String, details: Option<List<ErrorDetail>> },
    /// Rate limit exceeded
    RateLimitError { retry_after: Option<i64> },
    /// Webhook verification failed
    WebhookError { message: String },
    /// Network error
    NetworkError { message: String },
    /// Serialization error
    SerializationError { message: String }
}

/// Error detail
type ErrorDetail {
    field: String,
    value: Option<String>,
    location: Option<String>,
    issue: String,
    description: Option<String>
}

impl PayPalError {
    fn to_lms_error(&self) -> LmsError {
        match self {
            PayPalError::ConfigurationError { message } =>
                LmsError::IntegrationError { provider: "paypal".to_string(), message: message.clone() },
            PayPalError::AuthenticationError { message } =>
                LmsError::AccessDenied { reason: message.clone() },
            PayPalError::ApiError { message, .. } =>
                LmsError::IntegrationError { provider: "paypal".to_string(), message: message.clone() },
            PayPalError::NotFound { resource_type, resource_id } =>
                LmsError::NotFound { entity_type: resource_type.clone(), id: resource_id.clone() },
            PayPalError::RateLimitError { retry_after } =>
                LmsError::RateLimitExceeded { retry_after: Duration::seconds(retry_after.unwrap_or(60)) },
            _ => LmsError::IntegrationError { provider: "paypal".to_string(), message: format!("{:?}", self) }
        }
    }
}

