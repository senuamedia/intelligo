// Student Information System (SIS) Integration Module for Intelligo LMS
// Provides roster sync, grade passback, and enrollment management

module intelligo::integrations::sis

pub use intelligo::integrations::sis::core::*
pub use intelligo::integrations::sis::csv::*
pub use intelligo::integrations::sis::oneroster::*
pub use intelligo::integrations::sis::sis_sync::*

use intelligo::core::types::*
use std::collections::HashMap
use std::time::{DateTime, Duration}

/// Supported SIS provider types
pub enum SisProviderType {
    Csv,
    OneRoster,
    PowerSchool,
    Infinite_Campus,
    Skyward,
    Clever,
    ClassLink,
    Custom,
}

impl SisProviderType {
    pub fn to_string(self) -> String {
        match self {
            SisProviderType::Csv => "CSV".to_string(),
            SisProviderType::OneRoster => "OneRoster".to_string(),
            SisProviderType::PowerSchool => "PowerSchool".to_string(),
            SisProviderType::Infinite_Campus => "Infinite Campus".to_string(),
            SisProviderType::Skyward => "Skyward".to_string(),
            SisProviderType::Clever => "Clever".to_string(),
            SisProviderType::ClassLink => "ClassLink".to_string(),
            SisProviderType::Custom => "Custom".to_string(),
        }
    }
}

/// SIS Configuration
pub type SisConfig {
    provider_id: String,
    provider_type: SisProviderType,
    display_name: String,
    enabled: bool,
    organization_id: String,

    // Connection settings
    api_endpoint: Option<String>,
    api_key: Option<String>,
    api_secret: Option<String>,
    oauth_config: Option<SisOAuthConfig>,

    // Sync settings
    sync_users: bool,
    sync_courses: bool,
    sync_enrollments: bool,
    sync_grades: bool,
    sync_attendance: bool,

    // Schedule
    auto_sync: bool,
    sync_interval: Duration,
    last_sync: Option<DateTime>,
    next_sync: Option<DateTime>,

    // Mapping configuration
    field_mappings: SisFieldMappings,
    role_mappings: HashMap<String, String>,
    term_mappings: HashMap<String, String>,

    // Behavior settings
    create_missing_users: bool,
    create_missing_courses: bool,
    deactivate_missing_users: bool,
    archive_missing_courses: bool,

    created_at: DateTime,
    updated_at: DateTime,
}

/// OAuth configuration for SIS
pub type SisOAuthConfig {
    client_id: String,
    client_secret: String,
    token_url: String,
    scope: Option<String>,
}

/// Field mappings for SIS sync
pub type SisFieldMappings {
    // User field mappings
    user_id: String,
    user_email: String,
    user_first_name: String,
    user_last_name: String,
    user_role: Option<String>,
    user_grade_level: Option<String>,
    user_status: Option<String>,

    // Course field mappings
    course_id: String,
    course_code: String,
    course_name: String,
    course_description: Option<String>,
    course_term: Option<String>,
    course_status: Option<String>,

    // Enrollment field mappings
    enrollment_user_id: String,
    enrollment_course_id: String,
    enrollment_role: String,
    enrollment_status: Option<String>,
    enrollment_start_date: Option<String>,
    enrollment_end_date: Option<String>,

    // Grade field mappings
    grade_user_id: Option<String>,
    grade_course_id: Option<String>,
    grade_assignment_id: Option<String>,
    grade_score: Option<String>,
    grade_max_score: Option<String>,
}

impl SisFieldMappings {
    pub fn default() -> Self {
        SisFieldMappings {
            user_id: "sourcedId".to_string(),
            user_email: "email".to_string(),
            user_first_name: "givenName".to_string(),
            user_last_name: "familyName".to_string(),
            user_role: Some("role".to_string()),
            user_grade_level: Some("grades".to_string()),
            user_status: Some("status".to_string()),

            course_id: "sourcedId".to_string(),
            course_code: "courseCode".to_string(),
            course_name: "title".to_string(),
            course_description: Some("description".to_string()),
            course_term: Some("terms".to_string()),
            course_status: Some("status".to_string()),

            enrollment_user_id: "user.sourcedId".to_string(),
            enrollment_course_id: "class.sourcedId".to_string(),
            enrollment_role: "role".to_string(),
            enrollment_status: Some("status".to_string()),
            enrollment_start_date: Some("beginDate".to_string()),
            enrollment_end_date: Some("endDate".to_string()),

            grade_user_id: Some("user.sourcedId".to_string()),
            grade_course_id: Some("class.sourcedId".to_string()),
            grade_assignment_id: Some("lineItem.sourcedId".to_string()),
            grade_score: Some("score".to_string()),
            grade_max_score: Some("resultValueMax".to_string()),
        }
    }
}

/// SIS User representation
pub type SisUser {
    source_id: String,
    email: String,
    first_name: String,
    last_name: String,
    username: Option<String>,
    role: SisRole,
    grade_levels: Vec<String>,
    status: SisUserStatus,
    phone: Option<String>,
    metadata: HashMap<String, String>,
}

/// SIS User roles
pub enum SisRole {
    Student,
    Teacher,
    Administrator,
    Parent,
    Guardian,
    Aide,
    Counselor,
    Other { name: String },
}

impl SisRole {
    pub fn from_string(s: &str) -> Self {
        match s.to_lowercase().as_str() {
            "student" => SisRole::Student,
            "teacher" | "instructor" => SisRole::Teacher,
            "administrator" | "admin" => SisRole::Administrator,
            "parent" => SisRole::Parent,
            "guardian" => SisRole::Guardian,
            "aide" | "assistant" => SisRole::Aide,
            "counselor" => SisRole::Counselor,
            _ => SisRole::Other { name: s.to_string() },
        }
    }

    pub fn to_lms_role(self) -> String {
        match self {
            SisRole::Student => "student".to_string(),
            SisRole::Teacher => "instructor".to_string(),
            SisRole::Administrator => "admin".to_string(),
            SisRole::Parent | SisRole::Guardian => "observer".to_string(),
            SisRole::Aide => "ta".to_string(),
            SisRole::Counselor => "advisor".to_string(),
            SisRole::Other { name } => name.to_lowercase(),
        }
    }
}

/// SIS User status
pub enum SisUserStatus {
    Active,
    Inactive,
    ToBeDeleted,
}

impl SisUserStatus {
    pub fn from_string(s: &str) -> Self {
        match s.to_lowercase().as_str() {
            "active" => SisUserStatus::Active,
            "inactive" | "disabled" => SisUserStatus::Inactive,
            "tobedeleted" | "deleted" => SisUserStatus::ToBeDeleted,
            _ => SisUserStatus::Active,
        }
    }
}

