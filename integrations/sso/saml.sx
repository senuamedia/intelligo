// SAML 2.0 SSO Implementation for Intelligo LMS
// Supports SP-initiated and IdP-initiated SSO flows

module intelligo::integrations::sso::saml

use intelligo::integrations::sso::*
use intelligo::core::types::*
use std::collections::HashMap
use std::time::{DateTime, Duration}
use std::crypto::{X509Certificate, PrivateKey, Signature}
use std::encoding::{Base64, Deflate}
use std::xml::{XmlDocument, XmlNode, XmlParser}
use std::http::Client as HttpClient
use std::uuid::Uuid

/// SAML Name ID formats
pub enum SamlNameIdFormat {
    Unspecified,
    EmailAddress,
    Persistent,
    Transient,
    X509SubjectName,
    WindowsDomainQualifiedName,
    KerberosPrincipalName,
    EntityIdentifier,
}

impl SamlNameIdFormat {
    pub fn to_urn(self) -> String {
        match self {
            SamlNameIdFormat::Unspecified =>
                "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified".to_string(),
            SamlNameIdFormat::EmailAddress =>
                "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress".to_string(),
            SamlNameIdFormat::Persistent =>
                "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent".to_string(),
            SamlNameIdFormat::Transient =>
                "urn:oasis:names:tc:SAML:2.0:nameid-format:transient".to_string(),
            SamlNameIdFormat::X509SubjectName =>
                "urn:oasis:names:tc:SAML:1.1:nameid-format:X509SubjectName".to_string(),
            SamlNameIdFormat::WindowsDomainQualifiedName =>
                "urn:oasis:names:tc:SAML:1.1:nameid-format:WindowsDomainQualifiedName".to_string(),
            SamlNameIdFormat::KerberosPrincipalName =>
                "urn:oasis:names:tc:SAML:2.0:nameid-format:kerberos".to_string(),
            SamlNameIdFormat::EntityIdentifier =>
                "urn:oasis:names:tc:SAML:2.0:nameid-format:entity".to_string(),
        }
    }

    pub fn from_urn(urn: String) -> Option<Self> {
        match urn.as_str() {
            "urn:oasis:names:tc:SAML:1.1:nameid-format:unspecified" =>
                Some(SamlNameIdFormat::Unspecified),
            "urn:oasis:names:tc:SAML:1.1:nameid-format:emailAddress" =>
                Some(SamlNameIdFormat::EmailAddress),
            "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent" =>
                Some(SamlNameIdFormat::Persistent),
            "urn:oasis:names:tc:SAML:2.0:nameid-format:transient" =>
                Some(SamlNameIdFormat::Transient),
            _ => None,
        }
    }
}

/// SAML binding types
pub enum SamlBinding {
    HttpRedirect,
    HttpPost,
    HttpArtifact,
    Soap,
}

impl SamlBinding {
    pub fn to_urn(self) -> String {
        match self {
            SamlBinding::HttpRedirect =>
                "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect".to_string(),
            SamlBinding::HttpPost =>
                "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-POST".to_string(),
            SamlBinding::HttpArtifact =>
                "urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Artifact".to_string(),
            SamlBinding::Soap =>
                "urn:oasis:names:tc:SAML:2.0:bindings:SOAP".to_string(),
        }
    }
}

/// SAML configuration
pub type SamlConfig {
    // Service Provider (SP) settings
    sp_entity_id: String,
    sp_acs_url: String,
    sp_slo_url: Option<String>,
    sp_certificate: Option<X509Certificate>,
    sp_private_key: Option<PrivateKey>,
    sp_metadata_url: Option<String>,

    // Identity Provider (IdP) settings
    idp_entity_id: String,
    idp_sso_url: String,
    idp_slo_url: Option<String>,
    idp_certificate: X509Certificate,
    idp_metadata_url: Option<String>,

    // Security settings
    sign_authn_requests: bool,
    sign_logout_requests: bool,
    want_assertions_signed: bool,
    want_response_signed: bool,
    want_assertions_encrypted: bool,

    // Bindings
    authn_request_binding: SamlBinding,
    response_binding: SamlBinding,
    logout_binding: Option<SamlBinding>,

    // Name ID
    name_id_format: SamlNameIdFormat,

    // Attribute mappings
    attribute_mappings: SamlAttributeMappings,

    // Timing
    clock_skew_tolerance: Duration,
    session_duration: Duration,
}

/// SAML attribute mappings
pub type SamlAttributeMappings {
    email: String,
    first_name: Option<String>,
    last_name: Option<String>,
    display_name: Option<String>,
    groups: Option<String>,
    role: Option<String>,
    department: Option<String>,
    custom: HashMap<String, String>,
}

impl SamlAttributeMappings {
    pub fn default() -> Self {
        SamlAttributeMappings {
            email: "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress".to_string(),
            first_name: Some("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname".to_string()),
            last_name: Some("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname".to_string()),
            display_name: Some("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name".to_string()),
            groups: Some("http://schemas.xmlsoap.org/claims/Group".to_string()),
            role: None,
            department: None,
            custom: HashMap::new(),
        }
    }
}

/// SAML AuthnRequest
pub type SamlAuthnRequest {
    id: String,
    issue_instant: DateTime,
    destination: String,
    issuer: String,
    acs_url: String,
    name_id_format: SamlNameIdFormat,
    force_authn: bool,
    is_passive: bool,
    relay_state: Option<String>,
}

/// SAML Response (parsed)
pub type SamlResponse {
    id: String,
    in_response_to: Option<String>,
    issue_instant: DateTime,
    destination: Option<String>,
    issuer: String,
    status: SamlStatus,
    assertions: Vec<SamlAssertion>,
}

/// SAML Status
pub type SamlStatus {
    code: SamlStatusCode,
    sub_code: Option<String>,
    message: Option<String>,
}

pub enum SamlStatusCode {
    Success,
    Requester,
    Responder,
    VersionMismatch,
    AuthnFailed,
    InvalidAttrNameOrValue,
    InvalidNameIdPolicy,
    NoAuthnContext,
    NoAvailableIdp,
    NoPassive,
    NoSupportedIdp,
    PartialLogout,
    ProxyCountExceeded,
    RequestDenied,
    RequestUnsupported,
    RequestVersionDeprecated,
    RequestVersionTooHigh,
    RequestVersionTooLow,
    ResourceNotRecognized,
    TooManyResponses,
    UnknownAttrProfile,
    UnknownPrincipal,
    UnsupportedBinding,
}

/// SAML Assertion
pub type SamlAssertion {
    id: String,
    issue_instant: DateTime,
    issuer: String,
    subject: SamlSubject,
    conditions: SamlConditions,
    authn_statements: Vec<SamlAuthnStatement>,
    attribute_statements: Vec<SamlAttributeStatement>,
    signature_valid: bool,
}

/// SAML Subject
pub type SamlSubject {
    name_id: String,
    name_id_format: SamlNameIdFormat,
    confirmation_method: Option<String>,
    confirmation_data: Option<SamlSubjectConfirmationData>,
}

/// SAML Subject Confirmation Data
pub type SamlSubjectConfirmationData {
    not_on_or_after: Option<DateTime>,
    recipient: Option<String>,
    in_response_to: Option<String>,
}

/// SAML Conditions
pub type SamlConditions {
    not_before: Option<DateTime>,
    not_on_or_after: Option<DateTime>,
    audience_restrictions: Vec<String>,
}

/// SAML AuthnStatement
pub type SamlAuthnStatement {
    authn_instant: DateTime,
    session_index: Option<String>,
    session_not_on_or_after: Option<DateTime>,
    authn_context_class_ref: Option<String>,
}

/// SAML Attribute Statement
pub type SamlAttributeStatement {
    attributes: Vec<SamlAttribute>,
}

/// SAML Attribute
pub type SamlAttribute {
    name: String,
    name_format: Option<String>,
    friendly_name: Option<String>,
    values: Vec<String>,
}

/// SAML Logout Request
pub type SamlLogoutRequest {
    id: String,
    issue_instant: DateTime,
    destination: String,
    issuer: String,
    name_id: String,
    name_id_format: SamlNameIdFormat,
    session_index: Option<String>,
    reason: Option<String>,
}

/// SAML Logout Response
pub type SamlLogoutResponse {
    id: String,
    in_response_to: String,
    issue_instant: DateTime,
    destination: Option<String>,
    issuer: String,
    status: SamlStatus,
}

/// SAML Provider implementation
pub actor SamlProvider {
    provider_id: String,
    config: SamlConfig,
    pending_requests: HashMap<String, SamlPendingRequest>,
    http_client: HttpClient,

    pub fn new(provider_id: String, config: SamlConfig) -> Self {
        SamlProvider {
            provider_id: provider_id,
            config: config,
            pending_requests: HashMap::new(),
            http_client: HttpClient::new(),
        }
    }

    /// Generate SP metadata XML
    pub fn generate_metadata(self) -> String {
        let sp_cert_data = match &self.config.sp_certificate {
            Some(cert) => cert.to_pem_base64(),
            None => "".to_string(),
        };

        format!(r#"<?xml version="1.0" encoding="UTF-8"?>
<md:EntityDescriptor xmlns:md="urn:oasis:names:tc:SAML:2.0:metadata"
                     entityID="{entity_id}">
    <md:SPSSODescriptor AuthnRequestsSigned="{sign_requests}"
                        WantAssertionsSigned="{want_signed}"
                        protocolSupportEnumeration="urn:oasis:names:tc:SAML:2.0:protocol">
        {key_descriptor}
        <md:NameIDFormat>{name_id_format}</md:NameIDFormat>
        <md:AssertionConsumerService Binding="{acs_binding}"
                                     Location="{acs_url}"
                                     index="0"
                                     isDefault="true"/>
        {slo_service}
    </md:SPSSODescriptor>
</md:EntityDescriptor>"#,
            entity_id = self.config.sp_entity_id,
            sign_requests = self.config.sign_authn_requests,
            want_signed = self.config.want_assertions_signed,
            key_descriptor = if sp_cert_data.is_empty() {
                "".to_string()
            } else {
                format!(r#"<md:KeyDescriptor use="signing">
            <ds:KeyInfo xmlns:ds="http://www.w3.org/2000/09/xmldsig#">
                <ds:X509Data>
                    <ds:X509Certificate>{}</ds:X509Certificate>
                </ds:X509Data>
            </ds:KeyInfo>
        </md:KeyDescriptor>"#, sp_cert_data)
            },
            name_id_format = self.config.name_id_format.to_urn(),
            acs_binding = self.config.response_binding.to_urn(),
            acs_url = self.config.sp_acs_url,
            slo_service = match &self.config.sp_slo_url {
                Some(url) => format!(r#"<md:SingleLogoutService Binding="{}"
                                       Location="{}"/>"#,
                    self.config.logout_binding.as_ref()
                        .map(|b| b.to_urn())
                        .unwrap_or(SamlBinding::HttpRedirect.to_urn()),
                    url),
                None => "".to_string(),
            },
        )
    }

    /// Create an AuthnRequest
    fn create_authn_request(mut self, return_url: String) -> SamlAuthnRequest {
        let request_id = format!("_{}",Uuid::new_v4().to_string());

        let request = SamlAuthnRequest {
            id: request_id.clone(),
            issue_instant: DateTime::now(),
            destination: self.config.idp_sso_url.clone(),
            issuer: self.config.sp_entity_id.clone(),
            acs_url: self.config.sp_acs_url.clone(),
            name_id_format: self.config.name_id_format.clone(),
            force_authn: false,
            is_passive: false,
            relay_state: Some(return_url.clone()),
        };

        // Store pending request for validation
        self.pending_requests.insert(request_id.clone(), SamlPendingRequest {
            id: request_id,
            created_at: DateTime::now(),
            return_url: return_url,
        });

        request
    }

    /// Serialize AuthnRequest to XML
    fn serialize_authn_request(self, request: SamlAuthnRequest) -> String {
        format!(r#"<?xml version="1.0" encoding="UTF-8"?>
<samlp:AuthnRequest xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                    xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                    ID="{id}"
                    Version="2.0"
                    IssueInstant="{issue_instant}"
                    Destination="{destination}"
                    AssertionConsumerServiceURL="{acs_url}"
                    ProtocolBinding="{binding}">
    <saml:Issuer>{issuer}</saml:Issuer>
    <samlp:NameIDPolicy Format="{name_id_format}"
                        AllowCreate="true"/>
</samlp:AuthnRequest>"#,
            id = request.id,
            issue_instant = request.issue_instant.to_iso8601(),
            destination = request.destination,
            acs_url = request.acs_url,
            binding = self.config.response_binding.to_urn(),
            issuer = request.issuer,
            name_id_format = request.name_id_format.to_urn(),
        )
    }

    /// Encode AuthnRequest for redirect binding
    fn encode_redirect_request(self, xml: String, relay_state: Option<String>) -> String {
        let deflated = Deflate::compress(xml.as_bytes());
        let encoded = Base64::encode(deflated);

        let mut params = format!("SAMLRequest={}", url_encode(encoded));

        if let Some(state) = relay_state {
            params = format!("{}&RelayState={}", params, url_encode(state));
        }

        if self.config.sign_authn_requests {
            if let Some(ref key) = self.config.sp_private_key {
                let sig_alg = "http://www.w3.org/2001/04/xmldsig-more#rsa-sha256";
                params = format!("{}&SigAlg={}", params, url_encode(sig_alg.to_string()));

                let signature = key.sign_sha256(params.as_bytes());
                let sig_encoded = Base64::encode(signature);
                params = format!("{}&Signature={}", params, url_encode(sig_encoded));
            }
        }

        format!("{}?{}", self.config.idp_sso_url, params)
    }

    /// Parse SAML Response
    fn parse_response(self, response_xml: String) -> Result<SamlResponse, SsoError> {
        let doc = XmlParser::parse(response_xml).map_err(|e|
            SsoError::InvalidAssertion { details: format!("XML parse error: {}", e) }
        )?;

        let response_node = doc.root().ok_or(
            SsoError::InvalidAssertion { details: "Empty response".to_string() }
        )?;

        // Extract response attributes
        let id = response_node.attr("ID").ok_or(
            SsoError::InvalidAssertion { details: "Missing Response ID".to_string() }
        )?;

        let in_response_to = response_node.attr("InResponseTo");

        let issue_instant = response_node.attr("IssueInstant")
            .and_then(|s| DateTime::parse_iso8601(s).ok())
            .ok_or(
                SsoError::InvalidAssertion { details: "Missing or invalid IssueInstant".to_string() }
            )?;

        let destination = response_node.attr("Destination");

        // Extract issuer
        let issuer = response_node.find("Issuer")
            .and_then(|n| n.text())
            .ok_or(
                SsoError::InvalidAssertion { details: "Missing Issuer".to_string() }
            )?;

        // Extract status
        let status = self.parse_status(response_node.find("Status"))?;

        // Extract assertions
        let mut assertions = Vec::new();
        for assertion_node in response_node.find_all("Assertion") {
            let assertion = self.parse_assertion(assertion_node)?;
            assertions.push(assertion);
        }

        Ok(SamlResponse {
            id: id,
            in_response_to: in_response_to,
            issue_instant: issue_instant,
            destination: destination,
            issuer: issuer,
            status: status,
            assertions: assertions,
        })
    }

    /// Parse SAML Status
    fn parse_status(self, status_node: Option<XmlNode>) -> Result<SamlStatus, SsoError> {
        let node = status_node.ok_or(
            SsoError::InvalidAssertion { details: "Missing Status".to_string() }
        )?;

        let status_code_node = node.find("StatusCode").ok_or(
            SsoError::InvalidAssertion { details: "Missing StatusCode".to_string() }
        )?;

        let code_value = status_code_node.attr("Value").ok_or(
            SsoError::InvalidAssertion { details: "Missing StatusCode Value".to_string() }
        )?;

        let code = self.parse_status_code(code_value);
        let sub_code = status_code_node.find("StatusCode").and_then(|n| n.attr("Value"));
        let message = node.find("StatusMessage").and_then(|n| n.text());

        Ok(SamlStatus {
            code: code,
            sub_code: sub_code,
            message: message,
        })
    }

    /// Parse status code string to enum
    fn parse_status_code(self, value: String) -> SamlStatusCode {
        match value.as_str() {
            "urn:oasis:names:tc:SAML:2.0:status:Success" => SamlStatusCode::Success,
            "urn:oasis:names:tc:SAML:2.0:status:Requester" => SamlStatusCode::Requester,
            "urn:oasis:names:tc:SAML:2.0:status:Responder" => SamlStatusCode::Responder,
            "urn:oasis:names:tc:SAML:2.0:status:VersionMismatch" => SamlStatusCode::VersionMismatch,
            "urn:oasis:names:tc:SAML:2.0:status:AuthnFailed" => SamlStatusCode::AuthnFailed,
            _ => SamlStatusCode::Responder,
        }
    }

    /// Parse SAML Assertion
    fn parse_assertion(self, node: XmlNode) -> Result<SamlAssertion, SsoError> {
        let id = node.attr("ID").ok_or(
            SsoError::InvalidAssertion { details: "Missing Assertion ID".to_string() }
        )?;

        let issue_instant = node.attr("IssueInstant")
            .and_then(|s| DateTime::parse_iso8601(s).ok())
            .ok_or(
                SsoError::InvalidAssertion { details: "Missing Assertion IssueInstant".to_string() }
            )?;

        let issuer = node.find("Issuer")
            .and_then(|n| n.text())
            .ok_or(
                SsoError::InvalidAssertion { details: "Missing Assertion Issuer".to_string() }
            )?;

        // Parse subject
        let subject = self.parse_subject(node.find("Subject"))?;

        // Parse conditions
        let conditions = self.parse_conditions(node.find("Conditions"))?;

        // Parse authn statements
        let mut authn_statements = Vec::new();
        for stmt_node in node.find_all("AuthnStatement") {
            authn_statements.push(self.parse_authn_statement(stmt_node)?);
        }

        // Parse attribute statements
        let mut attribute_statements = Vec::new();
        for stmt_node in node.find_all("AttributeStatement") {
            attribute_statements.push(self.parse_attribute_statement(stmt_node)?);
        }

        // Validate signature
        let signature_valid = self.validate_assertion_signature(node.clone());

        Ok(SamlAssertion {
            id: id,
            issue_instant: issue_instant,
            issuer: issuer,
            subject: subject,
            conditions: conditions,
            authn_statements: authn_statements,
            attribute_statements: attribute_statements,
            signature_valid: signature_valid,
        })
    }

    /// Parse SAML Subject
    fn parse_subject(self, subject_node: Option<XmlNode>) -> Result<SamlSubject, SsoError> {
        let node = subject_node.ok_or(
            SsoError::InvalidAssertion { details: "Missing Subject".to_string() }
        )?;

        let name_id_node = node.find("NameID").ok_or(
            SsoError::InvalidAssertion { details: "Missing NameID".to_string() }
        )?;

        let name_id = name_id_node.text().ok_or(
            SsoError::InvalidAssertion { details: "Empty NameID".to_string() }
        )?;

        let format = name_id_node.attr("Format")
            .and_then(|f| SamlNameIdFormat::from_urn(f))
            .unwrap_or(SamlNameIdFormat::Unspecified);

        let confirmation_data = node.find("SubjectConfirmation")
            .and_then(|n| n.find("SubjectConfirmationData"))
            .map(|n| SamlSubjectConfirmationData {
                not_on_or_after: n.attr("NotOnOrAfter").and_then(|s| DateTime::parse_iso8601(s).ok()),
                recipient: n.attr("Recipient"),
                in_response_to: n.attr("InResponseTo"),
            });

        Ok(SamlSubject {
            name_id: name_id,
            name_id_format: format,
            confirmation_method: node.find("SubjectConfirmation").and_then(|n| n.attr("Method")),
            confirmation_data: confirmation_data,
        })
    }

    /// Parse SAML Conditions
    fn parse_conditions(self, conditions_node: Option<XmlNode>) -> Result<SamlConditions, SsoError> {
        match conditions_node {
            Some(node) => {
                let not_before = node.attr("NotBefore")
                    .and_then(|s| DateTime::parse_iso8601(s).ok());
                let not_on_or_after = node.attr("NotOnOrAfter")
                    .and_then(|s| DateTime::parse_iso8601(s).ok());

                let mut audience_restrictions = Vec::new();
                for ar_node in node.find_all("AudienceRestriction") {
                    for aud_node in ar_node.find_all("Audience") {
                        if let Some(audience) = aud_node.text() {
                            audience_restrictions.push(audience);
                        }
                    }
                }

                Ok(SamlConditions {
                    not_before: not_before,
                    not_on_or_after: not_on_or_after,
                    audience_restrictions: audience_restrictions,
                })
            },
            None => Ok(SamlConditions {
                not_before: None,
                not_on_or_after: None,
                audience_restrictions: Vec::new(),
            }),
        }
    }

    /// Parse AuthnStatement
    fn parse_authn_statement(self, node: XmlNode) -> Result<SamlAuthnStatement, SsoError> {
        let authn_instant = node.attr("AuthnInstant")
            .and_then(|s| DateTime::parse_iso8601(s).ok())
            .ok_or(
                SsoError::InvalidAssertion { details: "Missing AuthnInstant".to_string() }
            )?;

        Ok(SamlAuthnStatement {
            authn_instant: authn_instant,
            session_index: node.attr("SessionIndex"),
            session_not_on_or_after: node.attr("SessionNotOnOrAfter")
                .and_then(|s| DateTime::parse_iso8601(s).ok()),
            authn_context_class_ref: node.find("AuthnContext")
                .and_then(|n| n.find("AuthnContextClassRef"))
                .and_then(|n| n.text()),
        })
    }

    /// Parse AttributeStatement
    fn parse_attribute_statement(self, node: XmlNode) -> Result<SamlAttributeStatement, SsoError> {
        let mut attributes = Vec::new();

        for attr_node in node.find_all("Attribute") {
            let name = attr_node.attr("Name").ok_or(
                SsoError::InvalidAssertion { details: "Missing Attribute Name".to_string() }
            )?;

            let mut values = Vec::new();
            for value_node in attr_node.find_all("AttributeValue") {
                if let Some(value) = value_node.text() {
                    values.push(value);
                }
            }

            attributes.push(SamlAttribute {
                name: name,
                name_format: attr_node.attr("NameFormat"),
                friendly_name: attr_node.attr("FriendlyName"),
                values: values,
            });
        }

        Ok(SamlAttributeStatement { attributes: attributes })
    }

    /// Validate assertion signature
    fn validate_assertion_signature(self, node: XmlNode) -> bool {
        let signature_node = match node.find("Signature") {
            Some(n) => n,
            None => return false,
        };

        // Extract signed info and signature value
        let signed_info = match signature_node.find("SignedInfo") {
            Some(n) => n,
            None => return false,
        };

        let signature_value = match signature_node.find("SignatureValue")
            .and_then(|n| n.text()) {
            Some(v) => v,
            None => return false,
        };

        // Canonicalize and verify
        let canonical_signed_info = signed_info.canonicalize();
        let signature_bytes = match Base64::decode(signature_value) {
            Ok(b) => b,
            Err(_) => return false,
        };

        self.config.idp_certificate.verify_signature(
            canonical_signed_info.as_bytes(),
            &signature_bytes
        )
    }

    /// Validate SAML response
    fn validate_response(self, response: &SamlResponse, request_id: Option<String>) -> Result<(), SsoError> {
        // Check status
        match response.status.code {
            SamlStatusCode::Success => {},
            _ => {
                let message = response.status.message.clone()
                    .unwrap_or("Authentication failed".to_string());
                return Err(SsoError::AuthenticationFailed { message: message });
            }
        }

        // Validate InResponseTo if we have the request ID
        if let Some(req_id) = request_id {
            if let Some(ref in_response_to) = response.in_response_to {
                if in_response_to != &req_id {
                    return Err(SsoError::InvalidAssertion {
                        details: "InResponseTo does not match request ID".to_string()
                    });
                }
            }
        }

        // Validate issuer matches IdP
        if response.issuer != self.config.idp_entity_id {
            return Err(SsoError::InvalidAssertion {
                details: format!("Issuer mismatch: expected {}, got {}",
                    self.config.idp_entity_id, response.issuer)
            });
        }

        // Validate destination if present
        if let Some(ref dest) = response.destination {
            if dest != &self.config.sp_acs_url {
                return Err(SsoError::InvalidAssertion {
                    details: "Destination mismatch".to_string()
                });
            }
        }

        // Validate each assertion
        for assertion in &response.assertions {
            self.validate_assertion(assertion)?;
        }

        Ok(())
    }

    /// Validate a single assertion
    fn validate_assertion(self, assertion: &SamlAssertion) -> Result<(), SsoError> {
        let now = DateTime::now();

        // Check signature if required
        if self.config.want_assertions_signed && !assertion.signature_valid {
            return Err(SsoError::InvalidSignature);
        }

        // Validate issuer
        if assertion.issuer != self.config.idp_entity_id {
            return Err(SsoError::InvalidAssertion {
                details: "Assertion issuer mismatch".to_string()
            });
        }

        // Validate conditions timing
        if let Some(not_before) = assertion.conditions.not_before {
            if now < not_before - self.config.clock_skew_tolerance {
                return Err(SsoError::InvalidAssertion {
                    details: "Assertion not yet valid".to_string()
                });
            }
        }

        if let Some(not_on_or_after) = assertion.conditions.not_on_or_after {
            if now >= not_on_or_after + self.config.clock_skew_tolerance {
                return Err(SsoError::TokenExpired);
            }
        }

        // Validate audience restriction
        if !assertion.conditions.audience_restrictions.is_empty() {
            if !assertion.conditions.audience_restrictions.contains(&self.config.sp_entity_id) {
                return Err(SsoError::InvalidAssertion {
                    details: "SP not in audience restriction".to_string()
                });
            }
        }

        // Validate subject confirmation
        if let Some(ref confirmation_data) = assertion.subject.confirmation_data {
            if let Some(not_on_or_after) = confirmation_data.not_on_or_after {
                if now >= not_on_or_after + self.config.clock_skew_tolerance {
                    return Err(SsoError::TokenExpired);
                }
            }

            if let Some(ref recipient) = confirmation_data.recipient {
                if recipient != &self.config.sp_acs_url {
                    return Err(SsoError::InvalidAssertion {
                        details: "Recipient mismatch".to_string()
                    });
                }
            }
        }

        Ok(())
    }

    /// Extract user attributes from assertion
    fn extract_attributes(self, assertion: &SamlAssertion) -> HashMap<String, String> {
        let mut attributes = HashMap::new();
        let mappings = &self.config.attribute_mappings;

        // Build reverse mapping
        let mut attr_map: HashMap<&String, &str> = HashMap::new();
        attr_map.insert(&mappings.email, "email");
        if let Some(ref fn_attr) = mappings.first_name {
            attr_map.insert(fn_attr, "first_name");
        }
        if let Some(ref ln_attr) = mappings.last_name {
            attr_map.insert(ln_attr, "last_name");
        }
        if let Some(ref dn_attr) = mappings.display_name {
            attr_map.insert(dn_attr, "display_name");
        }
        if let Some(ref role_attr) = mappings.role {
            attr_map.insert(role_attr, "role");
        }
        if let Some(ref dept_attr) = mappings.department {
            attr_map.insert(dept_attr, "department");
        }

        // Extract attributes
        for stmt in &assertion.attribute_statements {
            for attr in &stmt.attributes {
                if let Some(&mapped_name) = attr_map.get(&attr.name) {
                    if let Some(value) = attr.values.first() {
                        attributes.insert(mapped_name.to_string(), value.clone());
                    }
                }

                // Also include custom mappings
                if let Some(custom_name) = mappings.custom.get(&attr.name) {
                    if let Some(value) = attr.values.first() {
                        attributes.insert(custom_name.clone(), value.clone());
                    }
                }
            }
        }

        // Use NameID as fallback for email
        if !attributes.contains_key("email") {
            match assertion.subject.name_id_format {
                SamlNameIdFormat::EmailAddress => {
                    attributes.insert("email".to_string(), assertion.subject.name_id.clone());
                },
                _ => {}
            }
        }

        attributes
    }

    /// Extract groups from assertion
    fn extract_groups(self, assertion: &SamlAssertion) -> Vec<String> {
        let groups_attr = match &self.config.attribute_mappings.groups {
            Some(attr) => attr,
            None => return Vec::new(),
        };

        for stmt in &assertion.attribute_statements {
            for attr in &stmt.attributes {
                if &attr.name == groups_attr {
                    return attr.values.clone();
                }
            }
        }

        Vec::new()
    }

    /// Create logout request
    fn create_logout_request(self, name_id: String, session_index: Option<String>) -> SamlLogoutRequest {
        SamlLogoutRequest {
            id: format!("_{}", Uuid::new_v4().to_string()),
            issue_instant: DateTime::now(),
            destination: self.config.idp_slo_url.clone().unwrap_or_default(),
            issuer: self.config.sp_entity_id.clone(),
            name_id: name_id,
            name_id_format: self.config.name_id_format.clone(),
            session_index: session_index,
            reason: Some("urn:oasis:names:tc:SAML:2.0:logout:user".to_string()),
        }
    }

    /// Serialize logout request to XML
    fn serialize_logout_request(self, request: SamlLogoutRequest) -> String {
        format!(r#"<?xml version="1.0" encoding="UTF-8"?>
<samlp:LogoutRequest xmlns:samlp="urn:oasis:names:tc:SAML:2.0:protocol"
                     xmlns:saml="urn:oasis:names:tc:SAML:2.0:assertion"
                     ID="{id}"
                     Version="2.0"
                     IssueInstant="{issue_instant}"
                     Destination="{destination}">
    <saml:Issuer>{issuer}</saml:Issuer>
    <saml:NameID Format="{name_id_format}">{name_id}</saml:NameID>
    {session_index}
</samlp:LogoutRequest>"#,
            id = request.id,
            issue_instant = request.issue_instant.to_iso8601(),
            destination = request.destination,
            issuer = request.issuer,
            name_id_format = request.name_id_format.to_urn(),
            name_id = request.name_id,
            session_index = match request.session_index {
                Some(idx) => format!("<samlp:SessionIndex>{}</samlp:SessionIndex>", idx),
                None => "".to_string(),
            },
        )
    }
}

impl SsoProvider for SamlProvider {
    fn get_config(self) -> SsoConfig {
        SsoConfig {
            provider_id: self.provider_id.clone(),
            provider_type: SsoProviderType::Saml2,
            display_name: "SAML SSO".to_string(),
            enabled: true,
            organization_id: None,
            saml_config: Some(self.config.clone()),
            oidc_config: None,
            ldap_config: None,
            auto_provision_users: true,
            default_role: None,
            attribute_mappings: HashMap::new(),
            allowed_domains: Vec::new(),
            created_at: DateTime::now(),
            updated_at: DateTime::now(),
        }
    }

    async fn initiate_auth(mut self, return_url: String) -> Result<SsoAuthRequest, SsoError> {
        let authn_request = self.create_authn_request(return_url.clone());
        let xml = self.serialize_authn_request(authn_request.clone());

        let redirect_url = match self.config.authn_request_binding {
            SamlBinding::HttpRedirect => {
                self.encode_redirect_request(xml, authn_request.relay_state.clone())
            },
            SamlBinding::HttpPost => {
                // For POST binding, return the form submission URL
                // The caller should render an auto-submit form
                self.config.idp_sso_url.clone()
            },
            _ => {
                return Err(SsoError::ConfigurationError {
                    message: "Unsupported AuthnRequest binding".to_string()
                });
            }
        };

        Ok(SsoAuthRequest {
            redirect_url: redirect_url,
            state: authn_request.id.clone(),
            nonce: None,
            relay_state: authn_request.relay_state,
        })
    }

    async fn process_callback(mut self, request: SsoCallbackRequest) -> Result<SsoAuthResult, SsoError> {
        // Check for error response
        if let Some(error) = request.error {
            return Err(SsoError::AuthenticationFailed {
                message: request.error_description.unwrap_or(error)
            });
        }

        // Get SAML response
        let encoded_response = request.saml_response.ok_or(
            SsoError::InvalidAssertion { details: "Missing SAMLResponse".to_string() }
        )?;

        // Decode response
        let response_xml = Base64::decode(encoded_response)
            .map_err(|_| SsoError::InvalidAssertion { details: "Invalid base64 encoding".to_string() })
            .and_then(|bytes| String::from_utf8(bytes)
                .map_err(|_| SsoError::InvalidAssertion { details: "Invalid UTF-8".to_string() })
            )?;

        // Parse response
        let response = self.parse_response(response_xml)?;

        // Find and validate against pending request
        let pending_request = request.relay_state.as_ref()
            .or(response.in_response_to.as_ref())
            .and_then(|id| self.pending_requests.remove(id));

        // Validate response
        self.validate_response(&response, pending_request.as_ref().map(|p| p.id.clone()))?;

        // Extract user info from first valid assertion
        let assertion = response.assertions.first().ok_or(
            SsoError::InvalidAssertion { details: "No assertions in response".to_string() }
        )?;

        let attributes = self.extract_attributes(assertion);
        let groups = self.extract_groups(assertion);

        let email = attributes.get("email").cloned();
        let display_name = attributes.get("display_name").cloned()
            .or_else(|| {
                let first = attributes.get("first_name");
                let last = attributes.get("last_name");
                match (first, last) {
                    (Some(f), Some(l)) => Some(format!("{} {}", f, l)),
                    (Some(f), None) => Some(f.clone()),
                    (None, Some(l)) => Some(l.clone()),
                    _ => None,
                }
            });

        Ok(SsoAuthResult {
            success: true,
            user_id: None, // Will be set by SsoManager after provisioning
            email: email,
            display_name: display_name,
            attributes: attributes,
            groups: groups,
            session_token: None,
            provider_id: self.provider_id.clone(),
            provider_type: SsoProviderType::Saml2,
            is_new_user: false,
            error: None,
        })
    }

    async fn validate_session(self, session_id: Uuid) -> Result<SsoSession, SsoError> {
        // SAML sessions are typically managed by the SP
        // This would query the session store
        Err(SsoError::SessionError {
            message: "Session validation should be done through SsoManager".to_string()
        })
    }

    async fn terminate_session(self, session_id: Uuid) -> Result<(), SsoError> {
        // For SAML, this would initiate SLO if configured
        Ok(())
    }

    fn get_logout_url(self, session_id: Uuid, return_url: String) -> Option<String> {
        // Return SLO URL if configured
        self.config.idp_slo_url.clone()
    }
}

/// Pending SAML request tracking
type SamlPendingRequest {
    id: String,
    created_at: DateTime,
    return_url: String,
}

/// URL encode helper
fn url_encode(s: String) -> String {
    s.chars().map(|c| {
        match c {
            'A'..='Z' | 'a'..='z' | '0'..='9' | '-' | '_' | '.' | '~' => c.to_string(),
            _ => format!("%{:02X}", c as u8),
        }
    }).collect()
}

/// Fetch and parse IdP metadata
pub async fn fetch_idp_metadata(metadata_url: String) -> Result<SamlIdpMetadata, SsoError> {
    let client = HttpClient::new();
    let response = client.get(metadata_url)
        .send()
        .await
        .map_err(|e| SsoError::NetworkError { message: e.to_string() })?;

    if !response.status().is_success() {
        return Err(SsoError::NetworkError {
            message: format!("Failed to fetch metadata: {}", response.status())
        });
    }

    let xml = response.text().await
        .map_err(|e| SsoError::NetworkError { message: e.to_string() })?;

    parse_idp_metadata(xml)
}

/// Parse IdP metadata XML
pub fn parse_idp_metadata(xml: String) -> Result<SamlIdpMetadata, SsoError> {
    let doc = XmlParser::parse(xml)
        .map_err(|e| SsoError::ConfigurationError { message: format!("Invalid metadata XML: {}", e) })?;

    let root = doc.root().ok_or(
        SsoError::ConfigurationError { message: "Empty metadata".to_string() }
    )?;

    let entity_id = root.attr("entityID").ok_or(
        SsoError::ConfigurationError { message: "Missing entityID".to_string() }
    )?;

    let idp_descriptor = root.find("IDPSSODescriptor").ok_or(
        SsoError::ConfigurationError { message: "Missing IDPSSODescriptor".to_string() }
    )?;

    // Extract SSO URL
    let sso_service = idp_descriptor.find_all("SingleSignOnService")
        .find(|n| n.attr("Binding") == Some(SamlBinding::HttpRedirect.to_urn()))
        .or_else(|| idp_descriptor.find("SingleSignOnService"))
        .ok_or(
            SsoError::ConfigurationError { message: "Missing SingleSignOnService".to_string() }
        )?;

    let sso_url = sso_service.attr("Location").ok_or(
        SsoError::ConfigurationError { message: "Missing SSO Location".to_string() }
    )?;

    // Extract SLO URL if present
    let slo_url = idp_descriptor.find_all("SingleLogoutService")
        .find(|n| n.attr("Binding") == Some(SamlBinding::HttpRedirect.to_urn()))
        .or_else(|| idp_descriptor.find("SingleLogoutService"))
        .and_then(|n| n.attr("Location"));

    // Extract certificate
    let cert_data = idp_descriptor.find("KeyDescriptor")
        .and_then(|n| n.find("KeyInfo"))
        .and_then(|n| n.find("X509Data"))
        .and_then(|n| n.find("X509Certificate"))
        .and_then(|n| n.text())
        .ok_or(
            SsoError::ConfigurationError { message: "Missing X509Certificate".to_string() }
        )?;

    let certificate = X509Certificate::from_pem(cert_data)
        .map_err(|e| SsoError::ConfigurationError {
            message: format!("Invalid certificate: {}", e)
        })?;

    // Extract name ID formats
    let name_id_formats: Vec<SamlNameIdFormat> = idp_descriptor.find_all("NameIDFormat")
        .filter_map(|n| n.text())
        .filter_map(|f| SamlNameIdFormat::from_urn(f))
        .collect();

    Ok(SamlIdpMetadata {
        entity_id: entity_id,
        sso_url: sso_url,
        slo_url: slo_url,
        certificate: certificate,
        name_id_formats: name_id_formats,
    })
}

/// IdP metadata structure
pub type SamlIdpMetadata {
    entity_id: String,
    sso_url: String,
    slo_url: Option<String>,
    certificate: X509Certificate,
    name_id_formats: Vec<SamlNameIdFormat>,
}
