/// Intelligo LMS - Microsoft Teams Integration
///
/// Complete Microsoft Teams integration including:
/// - Graph API integration
/// - Team/Channel creation for courses
/// - Meeting scheduling
/// - Notifications to channels
/// - Assignment sync
/// - Grade posting

module intelligo::integrations::communication::teams

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List}
use std::http::{HttpClient, Request, Response, Headers}
use std::json::{Json, to_json, from_json}

// =============================================================================
// CONFIGURATION
// =============================================================================

/// Microsoft Teams configuration
type TeamsConfig {
    /// Azure AD tenant ID
    tenant_id: String,
    /// Application (client) ID
    client_id: String,
    /// Client secret
    client_secret: String,
    /// Default owner user ID (for created teams)
    default_owner_id: Option<String>,
    /// Webhook URL for incoming notifications
    webhook_url: Option<String>,
    /// Enable meeting transcription
    enable_transcription: Bool,
    /// Default meeting provider
    meeting_provider: MeetingProvider
}

/// Meeting provider
enum MeetingProvider {
    MicrosoftTeams,
    Skype
}

impl TeamsConfig {
    fn from_env() -> Result<TeamsConfig, TeamsError> {
        Ok(TeamsConfig {
            tenant_id: std::env::get("MICROSOFT_TENANT_ID")
                .ok_or(TeamsError::ConfigurationError { message: "MICROSOFT_TENANT_ID not set".to_string() })?,
            client_id: std::env::get("MICROSOFT_CLIENT_ID")
                .ok_or(TeamsError::ConfigurationError { message: "MICROSOFT_CLIENT_ID not set".to_string() })?,
            client_secret: std::env::get("MICROSOFT_CLIENT_SECRET")
                .ok_or(TeamsError::ConfigurationError { message: "MICROSOFT_CLIENT_SECRET not set".to_string() })?,
            default_owner_id: std::env::get("TEAMS_DEFAULT_OWNER_ID"),
            webhook_url: std::env::get("TEAMS_WEBHOOK_URL"),
            enable_transcription: std::env::get("TEAMS_ENABLE_TRANSCRIPTION")
                .map(|v| v.to_lowercase() == "true")
                .unwrap_or(false),
            meeting_provider: MeetingProvider::MicrosoftTeams
        })
    }
}

// =============================================================================
// TEAMS TYPES
// =============================================================================

/// Microsoft Teams team
type Team {
    id: String,
    display_name: String,
    description: Option<String>,
    visibility: TeamVisibility,
    is_archived: Bool,
    web_url: Option<String>,
    created_at: Option<DateTime>,
    /// Internal metadata
    internal_id: Option<String>,
    /// Linked course ID
    course_id: Option<CourseId>
}

/// Team visibility
enum TeamVisibility {
    Private,
    Public
}

impl TeamVisibility {
    fn to_string(&self) -> String {
        match self {
            TeamVisibility::Private => "Private".to_string(),
            TeamVisibility::Public => "Public".to_string()
        }
    }
}

/// Teams channel
type Channel {
    id: String,
    display_name: String,
    description: Option<String>,
    membership_type: ChannelMembershipType,
    web_url: Option<String>,
    email: Option<String>,
    is_favorite_by_default: Bool
}

/// Channel membership type
enum ChannelMembershipType {
    Standard,
    Private,
    Shared
}

impl ChannelMembershipType {
    fn to_string(&self) -> String {
        match self {
            ChannelMembershipType::Standard => "standard".to_string(),
            ChannelMembershipType::Private => "private".to_string(),
            ChannelMembershipType::Shared => "shared".to_string()
        }
    }
}

/// Team member
type TeamMember {
    id: String,
    user_id: String,
    display_name: String,
    email: Option<String>,
    roles: List<TeamRole>
}

/// Team role
enum TeamRole {
    Owner,
    Member,
    Guest
}

impl TeamRole {
    fn to_string(&self) -> String {
        match self {
            TeamRole::Owner => "owner".to_string(),
            TeamRole::Member => "member".to_string(),
            TeamRole::Guest => "guest".to_string()
        }
    }
}

/// Online meeting
type OnlineMeeting {
    id: String,
    subject: String,
    start_time: DateTime,
    end_time: DateTime,
    join_url: String,
    join_web_url: String,
    video_teleconference_id: Option<String>,
    participants: MeetingParticipants,
    lobby_bypass_settings: LobbyBypassSettings,
    is_entry_exit_announced: Bool,
    allow_attendee_to_enable_camera: Bool,
    allow_attendee_to_enable_mic: Bool,
    recording_enabled: Bool
}

/// Meeting participants
type MeetingParticipants {
    organizer: MeetingParticipant,
    attendees: List<MeetingParticipant>
}

/// Meeting participant
type MeetingParticipant {
    upn: Option<String>,
    role: ParticipantRole,
    identity: Option<ParticipantIdentity>
}

/// Participant role
enum ParticipantRole {
    Presenter,
    Attendee,
    Producer,
    Coorganizer
}

impl ParticipantRole {
    fn to_string(&self) -> String {
        match self {
            ParticipantRole::Presenter => "presenter".to_string(),
            ParticipantRole::Attendee => "attendee".to_string(),
            ParticipantRole::Producer => "producer".to_string(),
            ParticipantRole::Coorganizer => "coorganizer".to_string()
        }
    }
}

/// Participant identity
type ParticipantIdentity {
    user: Option<IdentityUser>
}

/// Identity user
type IdentityUser {
    id: String,
    display_name: Option<String>
}

/// Lobby bypass settings
type LobbyBypassSettings {
    scope: LobbyBypassScope,
    is_dial_in_bypass_enabled: Bool
}

/// Lobby bypass scope
enum LobbyBypassScope {
    Everyone,
    Organization,
    OrganizationAndFederated,
    Organizer,
    InvitedUsers
}

impl LobbyBypassScope {
    fn to_string(&self) -> String {
        match self {
            LobbyBypassScope::Everyone => "everyone".to_string(),
            LobbyBypassScope::Organization => "organization".to_string(),
            LobbyBypassScope::OrganizationAndFederated => "organizationAndFederated".to_string(),
            LobbyBypassScope::Organizer => "organizer".to_string(),
            LobbyBypassScope::InvitedUsers => "invitedUsersInCompany".to_string()
        }
    }
}

/// Chat message
type ChatMessage {
    id: String,
    message_type: MessageType,
    created_at: DateTime,
    subject: Option<String>,
    body: MessageBody,
    from: MessageFrom,
    attachments: List<MessageAttachment>,
    mentions: List<MessageMention>,
    importance: MessageImportance,
    web_url: Option<String>
}

/// Message type
enum MessageType {
    Message,
    ChatEvent,
    Typing,
    UnknownFutureValue
}

/// Message body
type MessageBody {
    content_type: MessageContentType,
    content: String
}

/// Message content type
enum MessageContentType {
    Text,
    Html
}

impl MessageContentType {
    fn to_string(&self) -> String {
        match self {
            MessageContentType::Text => "text".to_string(),
            MessageContentType::Html => "html".to_string()
        }
    }
}

/// Message from info
type MessageFrom {
    user: Option<UserIdentity>
}

/// User identity
type UserIdentity {
    id: String,
    display_name: Option<String>,
    user_identity_type: Option<String>
}

/// Message attachment
type MessageAttachment {
    id: String,
    content_type: String,
    content_url: Option<String>,
    name: Option<String>,
    thumbnail_url: Option<String>
}

/// Message mention
type MessageMention {
    id: i32,
    mentioned: MentionedEntity,
    mention_text: String
}

/// Mentioned entity
type MentionedEntity {
    user: Option<UserIdentity>,
    conversation: Option<ConversationIdentity>
}

/// Conversation identity
type ConversationIdentity {
    id: String,
    display_name: Option<String>
}

/// Message importance
enum MessageImportance {
    Normal,
    High,
    Urgent
}

impl MessageImportance {
    fn to_string(&self) -> String {
        match self {
            MessageImportance::Normal => "normal".to_string(),
            MessageImportance::High => "high".to_string(),
            MessageImportance::Urgent => "urgent".to_string()
        }
    }
}

/// Adaptive card for rich notifications
type AdaptiveCard {
    schema: String,
    type_: String,
    version: String,
    body: List<CardElement>,
    actions: List<CardAction>
}

/// Card element
enum CardElement {
    TextBlock {
        text: String,
        size: Option<String>,
        weight: Option<String>,
        color: Option<String>,
        wrap: Bool
    },
    Image {
        url: String,
        size: Option<String>,
        alt_text: Option<String>
    },
    ColumnSet {
        columns: List<CardColumn>
    },
    FactSet {
        facts: List<CardFact>
    },
    Container {
        items: List<CardElement>
    }
}

/// Card column
type CardColumn {
    width: String,
    items: List<CardElement>
}

/// Card fact
type CardFact {
    title: String,
    value: String
}

/// Card action
enum CardAction {
    OpenUrl {
        title: String,
        url: String
    },
    Submit {
        title: String,
        data: Json
    },
    ShowCard {
        title: String,
        card: AdaptiveCard
    }
}

// =============================================================================
// ERROR TYPES
// =============================================================================

/// Teams errors
enum TeamsError {
    /// Configuration error
    ConfigurationError { message: String },
    /// Authentication error
    AuthenticationError { message: String },
    /// API error
    ApiError { code: String, message: String },
    /// Team not found
    TeamNotFound { team_id: String },
    /// Channel not found
    ChannelNotFound { team_id: String, channel_id: String },
    /// User not found
    UserNotFound { user_id: String },
    /// Permission denied
    PermissionDenied { message: String },
    /// Rate limit
    RateLimitError { retry_after: i64 },
    /// Network error
    NetworkError { message: String },
    /// Meeting error
    MeetingError { message: String }
}

impl TeamsError {
    fn to_lms_error(&self) -> LmsError {
        match self {
            TeamsError::ConfigurationError { message } =>
                LmsError::IntegrationError { provider: "teams".to_string(), message: message.clone() },
            TeamsError::AuthenticationError { message } =>
                LmsError::AccessDenied { reason: message.clone() },
            TeamsError::TeamNotFound { team_id } =>
                LmsError::NotFound { entity_type: "team".to_string(), id: team_id.clone() },
            TeamsError::ChannelNotFound { team_id, channel_id } =>
                LmsError::NotFound { entity_type: "channel".to_string(), id: format!("{}:{}", team_id, channel_id) },
            TeamsError::UserNotFound { user_id } =>
                LmsError::NotFound { entity_type: "user".to_string(), id: user_id.clone() },
            TeamsError::PermissionDenied { message } =>
                LmsError::AccessDenied { reason: message.clone() },
            TeamsError::RateLimitError { retry_after } =>
                LmsError::RateLimitExceeded { retry_after: Duration::seconds(*retry_after) },
            _ => LmsError::IntegrationError { provider: "teams".to_string(), message: format!("{:?}", self) }
        }
    }
}

