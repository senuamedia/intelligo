/// Intelligo LMS - Email Integration
///
/// Complete email integration including:
/// - SMTP provider support
/// - SendGrid integration
/// - AWS SES integration
/// - Microsoft Graph API (Outlook)
/// - Gmail API
/// - Email templates (welcome, enrollment, grade, certificate)
/// - Bulk email for announcements
/// - Email preferences and unsubscribe

module intelligo::integrations::communication::email

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}
use std::http::{HttpClient, Request, Response, Headers}
use std::json::{Json, to_json, from_json}
use std::base64

// =============================================================================
// EMAIL PROVIDER TYPES
// =============================================================================

/// Email provider identifier
enum EmailProvider {
    Smtp,
    SendGrid,
    AwsSes,
    MicrosoftGraph,
    Gmail,
    Custom { provider_id: String }
}

impl EmailProvider {
    fn to_string(&self) -> String {
        match self {
            EmailProvider::Smtp => "smtp".to_string(),
            EmailProvider::SendGrid => "sendgrid".to_string(),
            EmailProvider::AwsSes => "aws_ses".to_string(),
            EmailProvider::MicrosoftGraph => "microsoft_graph".to_string(),
            EmailProvider::Gmail => "gmail".to_string(),
            EmailProvider::Custom { provider_id } => provider_id.clone()
        }
    }
}

// =============================================================================
// PROVIDER CONFIGURATIONS
// =============================================================================

/// SMTP configuration
type SmtpConfig {
    host: String,
    port: i32,
    username: String,
    password: String,
    use_tls: Bool,
    use_starttls: Bool,
    from_email: String,
    from_name: String,
    reply_to: Option<String>
}

impl SmtpConfig {
    fn default() -> SmtpConfig {
        SmtpConfig {
            host: "localhost",
            port: 587,
            username: "",
            password: "",
            use_tls: false,
            use_starttls: true,
            from_email: "noreply@intelligo.edu",
            from_name: "Intelligo LMS",
            reply_to: None
        }
    }
}

/// SendGrid configuration
type SendGridConfig {
    api_key: String,
    from_email: String,
    from_name: String,
    reply_to: Option<String>,
    /// Sandbox mode for testing
    sandbox_mode: Bool,
    /// IP pool name
    ip_pool_name: Option<String>
}

impl SendGridConfig {
    fn from_env() -> Result<SendGridConfig, EmailError> {
        let api_key = std::env::get("SENDGRID_API_KEY")
            .ok_or(EmailError::ConfigurationError { message: "SENDGRID_API_KEY not set".to_string() })?;

        Ok(SendGridConfig {
            api_key,
            from_email: std::env::get("SENDGRID_FROM_EMAIL").unwrap_or("noreply@intelligo.edu".to_string()),
            from_name: std::env::get("SENDGRID_FROM_NAME").unwrap_or("Intelligo LMS".to_string()),
            reply_to: std::env::get("SENDGRID_REPLY_TO"),
            sandbox_mode: std::env::get("SENDGRID_SANDBOX").map(|v| v == "true").unwrap_or(false),
            ip_pool_name: std::env::get("SENDGRID_IP_POOL")
        })
    }
}

/// AWS SES configuration
type AwsSesConfig {
    region: String,
    access_key_id: String,
    secret_access_key: String,
    from_email: String,
    from_name: String,
    reply_to: Option<String>,
    /// Configuration set name
    configuration_set: Option<String>
}

impl AwsSesConfig {
    fn from_env() -> Result<AwsSesConfig, EmailError> {
        Ok(AwsSesConfig {
            region: std::env::get("AWS_REGION").unwrap_or("us-east-1".to_string()),
            access_key_id: std::env::get("AWS_ACCESS_KEY_ID")
                .ok_or(EmailError::ConfigurationError { message: "AWS_ACCESS_KEY_ID not set".to_string() })?,
            secret_access_key: std::env::get("AWS_SECRET_ACCESS_KEY")
                .ok_or(EmailError::ConfigurationError { message: "AWS_SECRET_ACCESS_KEY not set".to_string() })?,
            from_email: std::env::get("AWS_SES_FROM_EMAIL").unwrap_or("noreply@intelligo.edu".to_string()),
            from_name: std::env::get("AWS_SES_FROM_NAME").unwrap_or("Intelligo LMS".to_string()),
            reply_to: std::env::get("AWS_SES_REPLY_TO"),
            configuration_set: std::env::get("AWS_SES_CONFIG_SET")
        })
    }
}

/// Microsoft Graph configuration (for Outlook/365)
type MicrosoftGraphConfig {
    tenant_id: String,
    client_id: String,
    client_secret: String,
    /// Send as this user (requires Mail.Send permission)
    sender_email: String,
    /// Use application permissions (vs delegated)
    use_app_permissions: Bool
}

impl MicrosoftGraphConfig {
    fn from_env() -> Result<MicrosoftGraphConfig, EmailError> {
        Ok(MicrosoftGraphConfig {
            tenant_id: std::env::get("MICROSOFT_TENANT_ID")
                .ok_or(EmailError::ConfigurationError { message: "MICROSOFT_TENANT_ID not set".to_string() })?,
            client_id: std::env::get("MICROSOFT_CLIENT_ID")
                .ok_or(EmailError::ConfigurationError { message: "MICROSOFT_CLIENT_ID not set".to_string() })?,
            client_secret: std::env::get("MICROSOFT_CLIENT_SECRET")
                .ok_or(EmailError::ConfigurationError { message: "MICROSOFT_CLIENT_SECRET not set".to_string() })?,
            sender_email: std::env::get("MICROSOFT_SENDER_EMAIL").unwrap_or("noreply@intelligo.edu".to_string()),
            use_app_permissions: true
        })
    }
}

/// Gmail API configuration
type GmailConfig {
    client_id: String,
    client_secret: String,
    refresh_token: String,
    sender_email: String
}

impl GmailConfig {
    fn from_env() -> Result<GmailConfig, EmailError> {
        Ok(GmailConfig {
            client_id: std::env::get("GMAIL_CLIENT_ID")
                .ok_or(EmailError::ConfigurationError { message: "GMAIL_CLIENT_ID not set".to_string() })?,
            client_secret: std::env::get("GMAIL_CLIENT_SECRET")
                .ok_or(EmailError::ConfigurationError { message: "GMAIL_CLIENT_SECRET not set".to_string() })?,
            refresh_token: std::env::get("GMAIL_REFRESH_TOKEN")
                .ok_or(EmailError::ConfigurationError { message: "GMAIL_REFRESH_TOKEN not set".to_string() })?,
            sender_email: std::env::get("GMAIL_SENDER_EMAIL").unwrap_or("noreply@intelligo.edu".to_string())
        })
    }
}

// =============================================================================
// EMAIL TYPES
// =============================================================================

/// Email address with optional name
type EmailAddress {
    email: String,
    name: Option<String>
}

impl EmailAddress {
    fn new(email: &str) -> EmailAddress {
        EmailAddress { email: email.to_string(), name: None }
    }

    fn with_name(email: &str, name: &str) -> EmailAddress {
        EmailAddress { email: email.to_string(), name: Some(name.to_string()) }
    }

    fn to_string(&self) -> String {
        match &self.name {
            Some(name) => format!("{} <{}>", name, self.email),
            None => self.email.clone()
        }
    }
}

/// Email attachment
type EmailAttachment {
    filename: String,
    content_type: String,
    content: Vec<u8>,
    content_id: Option<String>,
    disposition: AttachmentDisposition
}

/// Attachment disposition
enum AttachmentDisposition {
    Attachment,
    Inline
}

/// Email message
type EmailMessage {
    /// Unique message ID
    id: String,
    /// From address
    from: EmailAddress,
    /// To addresses
    to: List<EmailAddress>,
    /// CC addresses
    cc: List<EmailAddress>,
    /// BCC addresses
    bcc: List<EmailAddress>,
    /// Reply-to address
    reply_to: Option<EmailAddress>,
    /// Subject
    subject: String,
    /// Plain text body
    text_body: Option<String>,
    /// HTML body
    html_body: Option<String>,
    /// Attachments
    attachments: List<EmailAttachment>,
    /// Headers
    headers: Map<String, String>,
    /// Tags for tracking
    tags: List<String>,
    /// Template ID (for provider templates)
    template_id: Option<String>,
    /// Template data
    template_data: Map<String, Dynamic>,
    /// Metadata
    metadata: Map<String, String>,
    /// Send at (scheduled send)
    send_at: Option<DateTime>,
    /// Priority
    priority: EmailPriority
}

/// Email priority
enum EmailPriority {
    Low,
    Normal,
    High
}

impl EmailMessage {
    fn new(to: EmailAddress, subject: &str) -> EmailMessage {
        EmailMessage {
            id: generate_uuid(),
            from: EmailAddress::new("noreply@intelligo.edu"),
            to: vec![to],
            cc: vec![],
            bcc: vec![],
            reply_to: None,
            subject: subject.to_string(),
            text_body: None,
            html_body: None,
            attachments: vec![],
            headers: Map::new(),
            tags: vec![],
            template_id: None,
            template_data: Map::new(),
            metadata: Map::new(),
            send_at: None,
            priority: EmailPriority::Normal
        }
    }

    fn with_body(mut self, text: &str, html: Option<&str>) -> Self {
        self.text_body = Some(text.to_string());
        self.html_body = html.map(|h| h.to_string());
        self
    }

    fn with_template(mut self, template_id: &str, data: Map<String, Dynamic>) -> Self {
        self.template_id = Some(template_id.to_string());
        self.template_data = data;
        self
    }

    fn add_attachment(mut self, attachment: EmailAttachment) -> Self {
        self.attachments.push(attachment);
        self
    }

    fn add_tag(mut self, tag: &str) -> Self {
        self.tags.push(tag.to_string());
        self
    }
}

/// Send result
type SendResult {
    message_id: String,
    provider_message_id: Option<String>,
    status: SendStatus,
    provider: EmailProvider,
    timestamp: DateTime
}

/// Send status
enum SendStatus {
    Queued,
    Sent,
    Delivered,
    Failed { error: String },
    Bounced { bounce_type: BounceType },
    Complained
}

/// Bounce type
enum BounceType {
    Hard,
    Soft,
    Transient
}

// =============================================================================
// EMAIL TEMPLATES
// =============================================================================

/// Email template type
enum EmailTemplateType {
    Welcome,
    Enrollment,
    EnrollmentConfirmation,
    CourseInvitation,
    AssignmentDue,
    AssignmentGraded,
    GradePosted,
    CourseAnnouncement,
    Certificate,
    PasswordReset,
    EmailVerification,
    AccountDeactivation,
    Custom { name: String }
}

impl EmailTemplateType {
    fn to_string(&self) -> String {
        match self {
            EmailTemplateType::Welcome => "welcome".to_string(),
            EmailTemplateType::Enrollment => "enrollment".to_string(),
            EmailTemplateType::EnrollmentConfirmation => "enrollment_confirmation".to_string(),
            EmailTemplateType::CourseInvitation => "course_invitation".to_string(),
            EmailTemplateType::AssignmentDue => "assignment_due".to_string(),
            EmailTemplateType::AssignmentGraded => "assignment_graded".to_string(),
            EmailTemplateType::GradePosted => "grade_posted".to_string(),
            EmailTemplateType::CourseAnnouncement => "course_announcement".to_string(),
            EmailTemplateType::Certificate => "certificate".to_string(),
            EmailTemplateType::PasswordReset => "password_reset".to_string(),
            EmailTemplateType::EmailVerification => "email_verification".to_string(),
            EmailTemplateType::AccountDeactivation => "account_deactivation".to_string(),
            EmailTemplateType::Custom { name } => name.clone()
        }
    }
}

/// Email template
type EmailTemplate {
    id: String,
    template_type: EmailTemplateType,
    name: String,
    subject: String,
    text_body: String,
    html_body: String,
    /// Variables available in template
    variables: List<String>,
    /// Tenant-specific (None = global)
    tenant_id: Option<TenantId>,
    /// Active
    active: Bool,
    created_at: DateTime,
    updated_at: DateTime
}

impl EmailTemplate {
    /// Render template with data
    fn render(&self, data: &Map<String, Dynamic>) -> (String, String, String) {
        let subject = self.render_string(&self.subject, data);
        let text_body = self.render_string(&self.text_body, data);
        let html_body = self.render_string(&self.html_body, data);
        (subject, text_body, html_body)
    }

    fn render_string(&self, template: &str, data: &Map<String, Dynamic>) -> String {
        let mut result = template.to_string();
        for (key, value) in data {
            let placeholder = format!("{{{{{}}}}}", key);
            let replacement = match value {
                Dynamic::String(s) => s.clone(),
                Dynamic::Int(i) => i.to_string(),
                Dynamic::Float(f) => f.to_string(),
                Dynamic::Bool(b) => b.to_string(),
                _ => "".to_string()
            };
            result = result.replace(&placeholder, &replacement);
        }
        result
    }
}

// =============================================================================
// EMAIL PREFERENCES
// =============================================================================

/// User email preferences
type EmailPreferences {
    user_id: UserId,
    /// Global email enabled
    emails_enabled: Bool,
    /// Preference by type
    type_preferences: Map<String, Bool>,
    /// Unsubscribed from all
    unsubscribed: Bool,
    /// Unsubscribe token
    unsubscribe_token: String,
    /// Preferred frequency
    digest_frequency: DigestFrequency,
    /// Quiet hours
    quiet_hours: Option<QuietHours>,
    updated_at: DateTime
}

/// Digest frequency
enum DigestFrequency {
    Immediate,
    Daily,
    Weekly,
    Never
}

/// Quiet hours (no emails during this time)
type QuietHours {
    start_hour: i32,
    end_hour: i32,
    timezone: String
}

impl EmailPreferences {
    fn default(user_id: UserId) -> EmailPreferences {
        EmailPreferences {
            user_id,
            emails_enabled: true,
            type_preferences: Map::new(),
            unsubscribed: false,
            unsubscribe_token: generate_token(),
            digest_frequency: DigestFrequency::Immediate,
            quiet_hours: None,
            updated_at: DateTime::now()
        }
    }

    /// Check if user should receive this email type
    fn should_receive(&self, email_type: &EmailTemplateType) -> Bool {
        if self.unsubscribed || !self.emails_enabled {
            return false
        }

        let type_key = email_type.to_string();
        self.type_preferences.get(&type_key).copied().unwrap_or(true)
    }

    /// Update preference for email type
    fn set_preference(&mut self, email_type: &EmailTemplateType, enabled: Bool) {
        let type_key = email_type.to_string();
        self.type_preferences.insert(type_key, enabled);
        self.updated_at = DateTime::now();
    }

    /// Unsubscribe from all
    fn unsubscribe_all(&mut self) {
        self.unsubscribed = true;
        self.updated_at = DateTime::now();
    }

    /// Resubscribe
    fn resubscribe(&mut self) {
        self.unsubscribed = false;
        self.updated_at = DateTime::now();
    }
}

// =============================================================================
// ERROR TYPES
// =============================================================================

/// Email errors
enum EmailError {
    /// Configuration error
    ConfigurationError { message: String },
    /// Provider error
    ProviderError { provider: String, message: String },
    /// Template not found
    TemplateNotFound { template_type: String },
    /// Template render error
    TemplateRenderError { message: String },
    /// Invalid email address
    InvalidEmailAddress { email: String },
    /// Rate limit exceeded
    RateLimitError { retry_after: Option<i64> },
    /// User unsubscribed
    UserUnsubscribed { user_id: UserId },
    /// Network error
    NetworkError { message: String },
    /// Send failed
    SendFailed { message: String }
}

impl EmailError {
    fn to_lms_error(&self) -> LmsError {
        match self {
            EmailError::ConfigurationError { message } =>
                LmsError::IntegrationError { provider: "email".to_string(), message: message.clone() },
            EmailError::TemplateNotFound { template_type } =>
                LmsError::NotFound { entity_type: "email_template".to_string(), id: template_type.clone() },
            EmailError::RateLimitError { retry_after } =>
                LmsError::RateLimitExceeded { retry_after: Duration::seconds(retry_after.unwrap_or(60)) },
            _ => LmsError::IntegrationError { provider: "email".to_string(), message: format!("{:?}", self) }
        }
    }
}

// =============================================================================
// EMAIL SERVICE CONFIGURATION
// =============================================================================

/// Email service configuration
type EmailServiceConfig {
    /// Default provider
    default_provider: EmailProvider,
    /// SMTP config
    smtp: Option<SmtpConfig>,
    /// SendGrid config
    sendgrid: Option<SendGridConfig>,
    /// AWS SES config
    aws_ses: Option<AwsSesConfig>,
    /// Microsoft Graph config
    microsoft_graph: Option<MicrosoftGraphConfig>,
    /// Gmail config
    gmail: Option<GmailConfig>,
    /// Base URL for links in emails
    base_url: String,
    /// Default from email
    default_from_email: String,
    /// Default from name
    default_from_name: String,
    /// Rate limit (emails per minute)
    rate_limit: i32,
    /// Batch size for bulk emails
    batch_size: i32,
    /// Enable tracking
    enable_tracking: Bool
}

impl EmailServiceConfig {
    fn default() -> EmailServiceConfig {
        EmailServiceConfig {
            default_provider: EmailProvider::Smtp,
            smtp: None,
            sendgrid: None,
            aws_ses: None,
            microsoft_graph: None,
            gmail: None,
            base_url: "https://intelligo.edu".to_string(),
            default_from_email: "noreply@intelligo.edu".to_string(),
            default_from_name: "Intelligo LMS".to_string(),
            rate_limit: 100,
            batch_size: 500,
            enable_tracking: true
        }
    }
}

// =============================================================================
// EMAIL SERVICE ACTOR
// =============================================================================

/// Email service actor
actor EmailService {
    /// Configuration
    config: EmailServiceConfig,

    /// HTTP client
    client: HttpClient,

    /// Templates (template_type -> template)
    templates: Map<String, EmailTemplate>,

    /// User preferences
    preferences: Map<UserId, EmailPreferences>,

    /// Send queue
    queue: List<QueuedEmail>,

    /// Send history (message_id -> result)
    history: Map<String, SendResult>,

    /// Rate limiter (minute -> count)
    rate_counter: Map<i64, i32>,

    /// Microsoft Graph access token
    ms_graph_token: Option<AccessToken>,

    /// Gmail access token
    gmail_token: Option<AccessToken>
}

/// Queued email for bulk sending
type QueuedEmail {
    message: EmailMessage,
    created_at: DateTime,
    attempts: i32,
    last_attempt: Option<DateTime>
}

/// Access token for OAuth-based providers
type AccessToken {
    token: String,
    expires_at: DateTime
}

impl EmailService {
    /// Create new email service
    pub fn new(config: EmailServiceConfig) -> EmailService {
        let mut service = EmailService {
            config,
            client: HttpClient::new(),
            templates: Map::new(),
            preferences: Map::new(),
            queue: vec![],
            history: Map::new(),
            rate_counter: Map::new(),
            ms_graph_token: None,
            gmail_token: None
        };

        // Initialize default templates
        service.init_default_templates();
        service
    }

    fn init_default_templates(&mut self) {
        // Welcome email
        self.templates.insert("welcome".to_string(), EmailTemplate {
            id: "tpl_welcome".to_string(),
            template_type: EmailTemplateType::Welcome,
            name: "Welcome Email".to_string(),
            subject: "Welcome to {{platform_name}}!".to_string(),
            text_body: r#"Hi {{user_name}},

Welcome to {{platform_name}}! We're excited to have you.

Get started by exploring your courses at {{base_url}}/courses

Best regards,
The {{platform_name}} Team"#.to_string(),
            html_body: r#"<h1>Welcome to {{platform_name}}!</h1>
<p>Hi {{user_name}},</p>
<p>We're excited to have you on board. Get started by exploring your courses.</p>
<a href="{{base_url}}/courses" style="background:#4CAF50;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;">View Courses</a>
<p>Best regards,<br>The {{platform_name}} Team</p>"#.to_string(),
            variables: vec!["user_name".to_string(), "platform_name".to_string(), "base_url".to_string()],
            tenant_id: None,
            active: true,
            created_at: DateTime::now(),
            updated_at: DateTime::now()
        });

        // Enrollment confirmation
        self.templates.insert("enrollment_confirmation".to_string(), EmailTemplate {
            id: "tpl_enrollment".to_string(),
            template_type: EmailTemplateType::EnrollmentConfirmation,
            name: "Enrollment Confirmation".to_string(),
            subject: "You're enrolled in {{course_name}}".to_string(),
            text_body: r#"Hi {{user_name}},

Congratulations! You've been enrolled in {{course_name}}.

Course Details:
- Start Date: {{start_date}}
- Instructor: {{instructor_name}}

Access your course: {{course_url}}

Best regards,
The {{platform_name}} Team"#.to_string(),
            html_body: r#"<h1>Enrollment Confirmed!</h1>
<p>Hi {{user_name}},</p>
<p>Congratulations! You've been enrolled in <strong>{{course_name}}</strong>.</p>
<table>
<tr><td>Start Date:</td><td>{{start_date}}</td></tr>
<tr><td>Instructor:</td><td>{{instructor_name}}</td></tr>
</table>
<a href="{{course_url}}" style="background:#2196F3;color:white;padding:10px 20px;text-decoration:none;border-radius:5px;">Go to Course</a>"#.to_string(),
            variables: vec!["user_name".to_string(), "course_name".to_string(), "start_date".to_string(), "instructor_name".to_string(), "course_url".to_string()],
