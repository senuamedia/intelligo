    Understand,
    Apply,
    Analyze,
    Evaluate,
    Create
}

// =============================================================================
// COURSE ACTIVITY MAPPING
// =============================================================================

/// Maps activities to courses with workflow configuration
pub type CourseActivity {
    /// Mapping ID
    id: CourseActivityId,

    /// Course this activity belongs to
    course_id: CourseId,

    /// Module within the course (optional)
    module_id: Option<ModuleId>,

    /// The activity
    activity_id: ActivityId,

    /// Position in sequence
    position: i32,

    /// Is this activity required for course completion?
    required: bool,

    /// Override activity settings for this course
    overrides: Option<ActivityOverrides>,

    /// Prerequisites (other activities that must be completed first)
    prerequisites: List<ActivityPrerequisite>,

    /// Workflow configuration
    workflow: Option<ActivityWorkflow>
}

/// Course activity ID wrapper
pub type CourseActivityId = String;

/// Override settings when activity is used in a course
pub type ActivityOverrides {
    /// Override title
    title: Option<String>,

    /// Override instructions
    instructions: Option<String>,

    /// Override availability
    available_from: Option<DateTime>,
    available_until: Option<DateTime>,

    /// Override time limit
    time_limit: Option<Duration>,

    /// Override max attempts
    max_attempts: Option<i32>,

    /// Override grading weight
    weight: Option<f32>
}

/// Prerequisite definition
pub type ActivityPrerequisite {
    /// The required activity
    activity_id: ActivityId,

    /// Requirement type
    requirement: PrerequisiteRequirement,

    /// Minimum score (if score-based)
    min_score: Option<f32>
}

/// Types of prerequisites
pub enum PrerequisiteRequirement {
    /// Must be completed
    Completed,

    /// Must be completed with passing score
    Passed,

    /// Must achieve minimum score
    MinScore,

    /// Must have attempted
    Attempted,

    /// Must have started
    Started
}

