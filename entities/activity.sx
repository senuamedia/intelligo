/// Intelligo LMS - Activity Entity
///
/// Activities are the building blocks of courses. They represent completable
/// learning experiences such as SCORM packages, videos, assignments, quizzes,
/// discussions, and custom content.

module intelligo::entities::activity

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// ACTIVITY ENTITY
// =============================================================================

/// A learning activity within a course
pub type Activity {
    /// Unique activity identifier
    id: ActivityId,

    /// Tenant ID for multi-tenancy
    tenant_id: TenantId,

    /// Activity type
    activity_type: ActivityType,

    /// Activity title
    title: String,

    /// Short description
    description: Option<String>,

    /// Detailed instructions for learners
    instructions: Option<String>,

    /// Activity category for organization
    category_id: Option<TermId>,

    /// Tags for searchability
    tags: List<String>,

    /// Thumbnail/icon
    thumbnail: Option<MediaId>,

    /// External content reference (SCORM, video, etc.)
    content_ref: Option<ContentReference>,

    /// Configuration for this activity type
    config: ActivityConfig,

    /// Completion criteria
    completion_criteria: CompletionCriteria,

    /// Grading configuration
    grading: Option<GradingConfig>,

    /// Time constraints
    time_constraints: Option<TimeConstraints>,

    /// Availability settings
    availability: AvailabilitySettings,

    /// AI-generated metadata
    ai_metadata: Option<AiActivityMetadata>,

    /// Status
    status: ActivityStatus,

    /// Version for optimistic locking
    version: i32,

    /// Creation timestamp
    created_at: DateTime,

    /// Last update timestamp
    updated_at: DateTime,

    /// Created by user
    created_by: UserId,

    /// Last updated by user
    updated_by: UserId
}

/// Activity ID wrapper
pub type ActivityId = String;

/// Activity status
pub enum ActivityStatus {
    /// Draft - being created/edited
    Draft,
    /// Published - available for use
    Published,
    /// Archived - no longer active
    Archived
}

impl ActivityStatus {
    fn from_string(s: &str) -> Option<ActivityStatus> {
        match s.to_lowercase().as_str() {
            "draft" => Some(ActivityStatus::Draft),
            "published" => Some(ActivityStatus::Published),
            "archived" => Some(ActivityStatus::Archived),
            _ => None
        }
    }

    fn to_string(&self) -> String {
        match self {
            ActivityStatus::Draft => "draft".to_string(),
            ActivityStatus::Published => "published".to_string(),
            ActivityStatus::Archived => "archived".to_string()
        }
    }
}

// =============================================================================
// ACTIVITY TYPES
// =============================================================================

/// Types of learning activities
pub enum ActivityType {
    /// SCORM 1.2/2004 package
    Scorm { version: ScormVersion },

    /// xAPI/Tin Can package
    XApi { activity_iri: String },

    /// cmi5 assignable unit
    Cmi5 { au_id: String },

    /// Video lesson
    Video { provider: VideoProvider, video_id: String },

    /// Interactive video with questions
    InteractiveVideo { video_id: String, interactions: List<VideoInteraction> },

    /// Reading/text content
    Reading { content_id: ContentId },

    /// Quiz/assessment
    Quiz { assessment_id: AssessmentId },

    /// Assignment submission
    Assignment { assignment_id: AssignmentId },

    /// Discussion participation
    Discussion { discussion_id: DiscussionId, min_posts: Option<i32> },

    /// Live session (webinar, class)
    LiveSession { session_id: SessionId },

    /// External URL
    ExternalUrl { url: String, track_time: bool },

    /// File download
    FileDownload { file_id: MediaId },

    /// Survey/feedback form
    Survey { survey_id: SurveyId },

    /// Peer review
    PeerReview { submission_type: String, review_count: i32 },

    /// Simulation/lab
    Simulation { simulation_id: String, provider: String },

    /// AI-guided learning
    AiTutor { topic: String, learning_objectives: List<String> },

    /// Checklist completion
    Checklist { items: List<ChecklistItem> },

    /// Certificate/badge earning
    Achievement { achievement_id: AchievementId },

    /// Custom activity type
    Custom { type_name: String, config: Map<String, Dynamic> }
}

/// SCORM version
pub enum ScormVersion {
    Scorm12,
    Scorm2004_2nd,
    Scorm2004_3rd,
    Scorm2004_4th
}

/// Video provider type
pub enum VideoProvider {
    Internal,
    YouTube,
    Vimeo,
    Kaltura,
    Wistia,
    BrightCove,
    Custom
}

/// Video interaction point
pub type VideoInteraction {
    timestamp: Duration,
    interaction_type: VideoInteractionType,
    question: Option<String>,
    options: Option<List<String>>,
    correct_answer: Option<String>
}

/// Types of video interactions
pub enum VideoInteractionType {
    Question,
    Pause,
    Hotspot,
    Branch,
    Note
}

/// Checklist item
pub type ChecklistItem {
    id: String,
    title: String,
    description: Option<String>,
    required: bool
}

// =============================================================================
// CONTENT REFERENCE
// =============================================================================

/// Reference to external or internal content
pub enum ContentReference {
    /// SCORM package in storage
    ScormPackage { package_id: String, manifest_path: String },

    /// xAPI package
    XApiPackage { package_id: String, launch_url: String },

    /// Media file
    Media { media_id: MediaId, media_type: MediaType },

    /// External URL
    External { url: String, embed: bool },

    /// Internal content block
    Content { content_id: ContentId },

    /// LTI tool
    Lti { tool_id: String, launch_url: String }
}

/// Media type
pub enum MediaType {
    Video,
    Audio,
    Document,
    Image,
    Interactive
}

// =============================================================================
// ACTIVITY CONFIGURATION
// =============================================================================

/// Activity-specific configuration
pub type ActivityConfig {
    /// Maximum attempts allowed (None = unlimited)
    max_attempts: Option<i32>,

    /// Allow retrying after completion
    allow_retry: bool,

    /// Show correct answers after completion
    show_answers: bool,

    /// Randomize content/questions
    randomize: bool,

    /// Require sequential completion
    sequential: bool,

    /// Custom settings per activity type
    custom: Map<String, Dynamic>
}

impl ActivityConfig {
    fn default() -> ActivityConfig {
        ActivityConfig {
            max_attempts: None,
            allow_retry: true,
            show_answers: false,
            randomize: false,
            sequential: false,
            custom: Map::new()
        }
    }
}

// =============================================================================
// COMPLETION CRITERIA
// =============================================================================

/// Criteria for completing an activity
pub type CompletionCriteria {
    /// Completion type
    completion_type: CompletionType,

    /// Minimum score required (percentage)
    min_score: Option<f32>,

    /// Minimum time spent
    min_time: Option<Duration>,

    /// Required progress percentage
    min_progress: Option<f32>,

    /// Custom completion rules
    custom_rules: Option<List<CompletionRule>>
}

/// How completion is determined
pub enum CompletionType {
    /// Auto-complete when viewed
    OnView,

    /// Auto-complete when launched
    OnLaunch,

    /// Complete based on content CMI data
    CmiData,

    /// Complete when scoring threshold met
    OnScore,

    /// Complete when time threshold met
    OnTime,

    /// Manual completion by learner
    ManualLearner,

    /// Manual completion by instructor
    ManualInstructor,

    /// Custom rules
    Custom
}

/// Custom completion rule
pub type CompletionRule {
    field: String,
    operator: ComparisonOperator,
    value: Dynamic
}

/// Comparison operators for rules
pub enum ComparisonOperator {
    Equals,
    NotEquals,
    GreaterThan,
    LessThan,
    GreaterOrEqual,
    LessOrEqual,
    Contains,
    StartsWith,
    EndsWith
}

// =============================================================================
// GRADING CONFIGURATION
// =============================================================================

/// Grading configuration for an activity
pub type GradingConfig {
    /// Is this activity graded?
    is_graded: bool,

    /// Weight in course grade (0.0 - 1.0)
    weight: f32,

    /// Maximum points
    max_points: f32,

    /// Passing score (percentage)
    passing_score: Option<f32>,

    /// Grade category
    category: Option<String>,

    /// Grading rubric
    rubric_id: Option<RubricId>,

    /// Late submission policy
    late_policy: Option<LatePolicy>
}

/// Late submission policy
pub type LatePolicy {
    /// Accept late submissions
    accept_late: bool,

    /// Penalty per day (percentage)
    penalty_per_day: f32,

    /// Maximum penalty (percentage)
    max_penalty: f32,

    /// Grace period after deadline
    grace_period: Option<Duration>,

    /// Hard cutoff date
    cutoff_date: Option<DateTime>
}

// =============================================================================
// TIME CONSTRAINTS
// =============================================================================

/// Time-related constraints for an activity
pub type TimeConstraints {
    /// Estimated completion time
    estimated_time: Option<Duration>,

    /// Time limit for completion
    time_limit: Option<Duration>,

    /// Countdown timer visible
    show_timer: bool,

    /// Auto-submit when time expires
    auto_submit: bool,

    /// Extra time accommodation (percentage)
    extra_time_percent: Option<f32>
}

// =============================================================================
// AVAILABILITY SETTINGS
// =============================================================================

/// When and how an activity is available
pub type AvailabilitySettings {
    /// Available from date
    available_from: Option<DateTime>,

    /// Available until date
    available_until: Option<DateTime>,

    /// Release based on rules
    release_rules: Option<List<ReleaseRule>>,

    /// Visible but locked message
    locked_message: Option<String>,

    /// Hide if not available (vs. show as locked)
    hide_if_unavailable: bool
}

/// Rule for releasing content
pub type ReleaseRule {
    rule_type: ReleaseRuleType,
    config: Map<String, Dynamic>
}

/// Types of release rules
pub enum ReleaseRuleType {
    /// Release on specific date
    OnDate { date: DateTime },

    /// Release after completing another activity
    AfterActivity { activity_id: ActivityId },

    /// Release after completing a module
    AfterModule { module_id: ModuleId },

    /// Release based on score in another activity
    OnScore { activity_id: ActivityId, min_score: f32 },

    /// Release based on group membership
    ForGroup { group_id: GroupId },

    /// Custom rule
    Custom { rule_name: String }
}

