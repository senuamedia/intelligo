// =============================================================================
// ACTIVITY ACTOR
// =============================================================================

/// Actor for managing activities
pub actor ActivityActor {
    state {
        storage: Box<dyn ActivityStorage>,
        ai_service: Option<Box<dyn AiService>>
    }

    /// Create a new activity
    receive CreateActivity(input: CreateActivityInput) -> Result<Activity, ActivityError> {
        // Validate input
        self.validate_activity_input(&input)?;

        let now = DateTime::now();
        let id = generate_uuid();

        let activity = Activity {
            id,
            tenant_id: input.tenant_id,
            activity_type: input.activity_type,
            title: input.title,
            description: input.description,
            instructions: input.instructions,
            category_id: input.category_id,
            tags: input.tags.unwrap_or_default(),
            thumbnail: input.thumbnail,
            content_ref: input.content_ref,
            config: input.config.unwrap_or_else(|| ActivityConfig::default()),
            completion_criteria: input.completion_criteria,
            grading: input.grading,
            time_constraints: input.time_constraints,
            availability: input.availability.unwrap_or_else(|| AvailabilitySettings {
                available_from: None,
                available_until: None,
                release_rules: None,
                locked_message: None,
                hide_if_unavailable: false
            }),
            ai_metadata: None,
            status: ActivityStatus::Draft,
            version: 1,
            created_at: now,
            updated_at: now,
            created_by: input.created_by,
            updated_by: input.created_by
        };

        self.state.storage.save(&activity).await?;

        // Generate AI metadata asynchronously if AI service available
        if let Some(ref ai) = self.state.ai_service {
            self.generate_ai_metadata(&activity.id).await.ok();
        }

        Ok(activity)
    }

    /// Update an activity
    receive UpdateActivity(id: ActivityId, input: UpdateActivityInput) -> Result<Activity, ActivityError> {
        let mut activity = self.state.storage.get(&id).await?
            .ok_or(ActivityError::NotFound { id: id.clone() })?;

        // Apply updates
        if let Some(title) = input.title {
            activity.title = title;
        }
        if let Some(description) = input.description {
            activity.description = Some(description);
        }
        if let Some(instructions) = input.instructions {
            activity.instructions = Some(instructions);
        }
        if let Some(config) = input.config {
            activity.config = config;
        }
        if let Some(completion) = input.completion_criteria {
            activity.completion_criteria = completion;
        }
        if let Some(grading) = input.grading {
            activity.grading = Some(grading);
        }
        if let Some(availability) = input.availability {
            activity.availability = availability;
        }

        activity.updated_at = DateTime::now();
        activity.updated_by = input.updated_by;
        activity.version += 1;

        self.state.storage.save(&activity).await?;

        Ok(activity)
    }

    /// Publish an activity
    receive PublishActivity(id: ActivityId, by: UserId) -> Result<Activity, ActivityError> {
        let mut activity = self.state.storage.get(&id).await?
            .ok_or(ActivityError::NotFound { id: id.clone() })?;

        // Validate activity is ready for publishing
        self.validate_for_publish(&activity)?;

        activity.status = ActivityStatus::Published;
        activity.updated_at = DateTime::now();
        activity.updated_by = by;
        activity.version += 1;

        self.state.storage.save(&activity).await?;

        Ok(activity)
    }

    /// Map activity to a course
    receive MapToCourse(input: MapToCourseInput) -> Result<CourseActivity, ActivityError> {
        // Validate activity exists
        let activity = self.state.storage.get(&input.activity_id).await?
            .ok_or(ActivityError::NotFound { id: input.activity_id.clone() })?;

        // Create the mapping
        let mapping = CourseActivity {
            id: generate_uuid(),
            course_id: input.course_id,
            module_id: input.module_id,
            activity_id: input.activity_id,
            position: input.position,
            required: input.required.unwrap_or(true),
            overrides: input.overrides,
            prerequisites: input.prerequisites.unwrap_or_default(),
            workflow: input.workflow
        };

        self.state.storage.save_mapping(&mapping).await?;

        Ok(mapping)
    }

    /// Set activity prerequisites
    receive SetPrerequisites(activity_id: ActivityId, course_id: CourseId, prerequisites: List<ActivityPrerequisite>) -> Result<(), ActivityError> {
        let mut mapping = self.state.storage.get_mapping(&activity_id, &course_id).await?
            .ok_or(ActivityError::MappingNotFound {
                activity_id: activity_id.clone(),
                course_id: course_id.clone()
            })?;

        // Validate no circular dependencies
        self.check_circular_dependencies(&activity_id, &course_id, &prerequisites)?;

        mapping.prerequisites = prerequisites;
        self.state.storage.save_mapping(&mapping).await?;

        Ok(())
    }

    /// Check if activity is available for a learner
    receive CheckAvailability(activity_id: ActivityId, course_id: CourseId, user_id: UserId) -> Result<AvailabilityResult, ActivityError> {
        let activity = self.state.storage.get(&activity_id).await?
            .ok_or(ActivityError::NotFound { id: activity_id.clone() })?;

        let mapping = self.state.storage.get_mapping(&activity_id, &course_id).await?
            .ok_or(ActivityError::MappingNotFound {
                activity_id: activity_id.clone(),
                course_id: course_id.clone()
            })?;

        // Check date-based availability
        let now = DateTime::now();
        let availability = &activity.availability;

        if let Some(from) = &availability.available_from {
            if now < *from {
                return Ok(AvailabilityResult::NotYetAvailable {
                    available_from: from.clone()
                });
            }
        }

        if let Some(until) = &availability.available_until {
            if now > *until {
                return Ok(AvailabilityResult::NoLongerAvailable {
                    expired_at: until.clone()
                });
            }
        }

        // Check prerequisites
        for prereq in &mapping.prerequisites {
            let progress = self.state.storage.get_progress(&user_id, &prereq.activity_id, &course_id).await?;

            let met = match &prereq.requirement {
                PrerequisiteRequirement::Completed => {
                    progress.map(|p| matches!(p.status, ProgressStatus::Completed | ProgressStatus::Passed)).unwrap_or(false)
                }
                PrerequisiteRequirement::Passed => {
                    progress.map(|p| matches!(p.status, ProgressStatus::Passed)).unwrap_or(false)
                }
                PrerequisiteRequirement::MinScore => {
                    if let Some(min) = prereq.min_score {
                        progress.and_then(|p| p.score).map(|s| s >= min).unwrap_or(false)
                    } else {
                        true
                    }
                }
                PrerequisiteRequirement::Attempted => {
                    progress.map(|p| p.attempts > 0).unwrap_or(false)
                }
                PrerequisiteRequirement::Started => {
                    progress.map(|p| p.first_accessed.is_some()).unwrap_or(false)
                }
            };

            if !met {
                return Ok(AvailabilityResult::PrerequisiteNotMet {
                    prerequisite: prereq.clone()
                });
            }
        }

        Ok(AvailabilityResult::Available)
    }

    /// Generate AI metadata for an activity
    receive GenerateAiMetadata(activity_id: ActivityId) -> Result<AiActivityMetadata, ActivityError> {
        let activity = self.state.storage.get(&activity_id).await?
            .ok_or(ActivityError::NotFound { id: activity_id.clone() })?;

        let ai = self.state.ai_service.as_ref()
            .ok_or(ActivityError::AiNotConfigured)?;

        // Generate metadata based on activity content
        let metadata = ai.generate_activity_metadata(&activity).await
            .map_err(|e| ActivityError::AiError { message: e.to_string() })?;

        // Save metadata to activity
        let mut updated = activity;
        updated.ai_metadata = Some(metadata.clone());
        updated.updated_at = DateTime::now();
        self.state.storage.save(&updated).await?;

        Ok(metadata)
    }

    /// Suggest activities for a course based on learning objectives
    receive SuggestActivities(input: SuggestActivitiesInput) -> Result<List<ActivitySuggestion>, ActivityError> {
        let ai = self.state.ai_service.as_ref()
            .ok_or(ActivityError::AiNotConfigured)?;

        let suggestions = ai.suggest_activities(
            &input.learning_objectives,
            &input.target_audience,
            input.duration_budget,
            &input.preferences
        ).await.map_err(|e| ActivityError::AiError { message: e.to_string() })?;

        Ok(suggestions)
    }

    // Helper methods

    fn validate_activity_input(&self, input: &CreateActivityInput) -> Result<(), ActivityError> {
        if input.title.is_empty() {
            return Err(ActivityError::ValidationError {
                field: "title".to_string(),
                message: "Title is required".to_string()
            });
        }
        Ok(())
    }

    fn validate_for_publish(&self, activity: &Activity) -> Result<(), ActivityError> {
        if activity.title.is_empty() {
            return Err(ActivityError::NotReadyToPublish {
                reason: "Activity must have a title".to_string()
            });
        }
        // Add more validation as needed
        Ok(())
    }

    fn check_circular_dependencies(
        &self,
        activity_id: &ActivityId,
        course_id: &CourseId,
        prerequisites: &List<ActivityPrerequisite>
    ) -> Result<(), ActivityError> {
        // Would implement DAG check here
        Ok(())
    }

    async fn generate_ai_metadata(&self, activity_id: &ActivityId) -> Result<(), ActivityError> {
        // Trigger async AI metadata generation
        Ok(())
    }
}

// =============================================================================
// INPUT/OUTPUT TYPES
// =============================================================================

/// Input for creating an activity
pub type CreateActivityInput {
    tenant_id: TenantId,
    activity_type: ActivityType,
    title: String,
    description: Option<String>,
    instructions: Option<String>,
    category_id: Option<TermId>,
    tags: Option<List<String>>,
    thumbnail: Option<MediaId>,
    content_ref: Option<ContentReference>,
    config: Option<ActivityConfig>,
    completion_criteria: CompletionCriteria,
    grading: Option<GradingConfig>,
    time_constraints: Option<TimeConstraints>,
    availability: Option<AvailabilitySettings>,
    created_by: UserId
}

/// Input for updating an activity
pub type UpdateActivityInput {
    title: Option<String>,
    description: Option<String>,
    instructions: Option<String>,
    config: Option<ActivityConfig>,
    completion_criteria: Option<CompletionCriteria>,
    grading: Option<GradingConfig>,
    availability: Option<AvailabilitySettings>,
    updated_by: UserId
}

/// Input for mapping activity to course
pub type MapToCourseInput {
    activity_id: ActivityId,
    course_id: CourseId,
    module_id: Option<ModuleId>,
    position: i32,
    required: Option<bool>,
    overrides: Option<ActivityOverrides>,
    prerequisites: Option<List<ActivityPrerequisite>>,
    workflow: Option<ActivityWorkflow>
}

/// Input for AI activity suggestions
pub type SuggestActivitiesInput {
    learning_objectives: List<String>,
    target_audience: String,
    duration_budget: Option<Duration>,
    preferences: Map<String, Dynamic>
}

/// AI-generated activity suggestion
pub type ActivitySuggestion {
    activity_type: ActivityType,
    title: String,
    description: String,
    estimated_duration: Duration,
    learning_objectives: List<String>,
    confidence: f32,
    rationale: String
}

/// Availability check result
pub enum AvailabilityResult {
    Available,
    NotYetAvailable { available_from: DateTime },
    NoLongerAvailable { expired_at: DateTime },
    PrerequisiteNotMet { prerequisite: ActivityPrerequisite },
    MaxAttemptsReached { attempts: i32 },
    Locked { message: String }
}

// =============================================================================
// ERRORS
// =============================================================================

/// Activity errors
pub enum ActivityError {
    NotFound { id: ActivityId },
    MappingNotFound { activity_id: ActivityId, course_id: CourseId },
    ValidationError { field: String, message: String },
    NotReadyToPublish { reason: String },
    CircularDependency { activities: List<ActivityId> },
    AiNotConfigured,
    AiError { message: String },
    StorageError { message: String }
}

impl ActivityError {
    fn to_string(&self) -> String {
        match self {
            ActivityError::NotFound { id } =>
                format!("Activity not found: {}", id),
            ActivityError::MappingNotFound { activity_id, course_id } =>
                format!("Activity {} not mapped to course {}", activity_id, course_id),
            ActivityError::ValidationError { field, message } =>
                format!("Validation error on {}: {}", field, message),
            ActivityError::NotReadyToPublish { reason } =>
                format!("Activity not ready to publish: {}", reason),
            ActivityError::CircularDependency { activities } =>
                format!("Circular dependency detected: {:?}", activities),
            ActivityError::AiNotConfigured =>
                "AI service not configured".to_string(),
            ActivityError::AiError { message } =>
                format!("AI error: {}", message),
            ActivityError::StorageError { message } =>
                format!("Storage error: {}", message)
        }
    }
}

// =============================================================================
// STORAGE TRAIT
// =============================================================================

/// Storage interface for activities
pub trait ActivityStorage: Send + Sync {
    async fn get(&self, id: &ActivityId) -> Result<Option<Activity>, ActivityError>;
    async fn save(&self, activity: &Activity) -> Result<(), ActivityError>;
    async fn delete(&self, id: &ActivityId) -> Result<(), ActivityError>;
    async fn list(&self, tenant_id: &TenantId, filter: &ActivityFilter) -> Result<List<Activity>, ActivityError>;

    async fn get_mapping(&self, activity_id: &ActivityId, course_id: &CourseId) -> Result<Option<CourseActivity>, ActivityError>;
    async fn save_mapping(&self, mapping: &CourseActivity) -> Result<(), ActivityError>;
    async fn list_course_activities(&self, course_id: &CourseId) -> Result<List<CourseActivity>, ActivityError>;

    async fn get_progress(&self, user_id: &UserId, activity_id: &ActivityId, course_id: &CourseId) -> Result<Option<ActivityProgress>, ActivityError>;
    async fn save_progress(&self, progress: &ActivityProgress) -> Result<(), ActivityError>;
}

/// Filter for listing activities
pub type ActivityFilter {
    activity_type: Option<String>,
    category_id: Option<TermId>,
    status: Option<ActivityStatus>,
    search: Option<String>,
    tags: Option<List<String>>,
    limit: Option<i32>,
    offset: Option<i32>
}

// =============================================================================
// AI SERVICE TRAIT
// =============================================================================

/// AI service interface for activity intelligence
pub trait AiService: Send + Sync {
    async fn generate_activity_metadata(&self, activity: &Activity) -> Result<AiActivityMetadata, String>;
    async fn suggest_activities(
        &self,
        objectives: &List<String>,
        audience: &str,
        duration: Option<Duration>,
        preferences: &Map<String, Dynamic>
    ) -> Result<List<ActivitySuggestion>, String>;
}

// =============================================================================
// HELPERS
// =============================================================================

fn generate_uuid() -> String {
    std::uuid::v4()
}
