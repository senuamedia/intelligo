}

/// Input for submitting a discussion post
type SubmitDiscussionInput {
    assessment_id: AssessmentId,
    body: String,
    format: TextFormat,
    parent_post_id: Option<String>,
    attachments: List<MediaId>
}

// =============================================================================
// FILTER TYPES
// =============================================================================

/// Filter options for submission queries
type SubmissionFilter {
    tenant_id: Option<TenantId>,
    course_id: Option<CourseId>,
    assessment_id: Option<AssessmentId>,
    student_id: Option<StudentId>,
    enrollment_id: Option<EnrollmentId>,
    status: Option<SubmissionStatus>,
    is_late: Option<Bool>,
    is_graded: Option<Bool>,
