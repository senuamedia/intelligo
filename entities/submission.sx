/// Intelligo LMS - Submission Entity
///
/// Submissions represent student work submitted for assessments.
/// They include content (text, files, quiz responses), attempt tracking,
/// plagiarism detection results, and proctoring flags.

module intelligo::entities::submission

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, Set, List}

// =============================================================================
// SUBMISSION ENTITY
// =============================================================================

/// A student submission for an assessment
type Submission {
    /// Unique identifier
    id: SubmissionId,

    /// UUID for external references
    uuid: String,

    /// Bundle type (quiz_submission, assignment_submission, discussion_post, etc.)
    bundle: String,

    /// Assessment this is submitted for
    assessment_id: AssessmentId,

    /// Course context
    course_id: CourseId,

    /// Enrollment context
    enrollment_id: EnrollmentId,

    /// Student who submitted
    student_id: StudentId,

    /// Tenant for multi-tenancy
    tenant_id: TenantId,

    // =========================================================================
    // Attempt Tracking
    // =========================================================================

    /// Attempt number (1-indexed)
    attempt_number: i32,

    /// Attempt ID for detailed tracking
    attempt_id: AttemptId,

    /// All attempts for this student/assessment
    attempt_history: List<AttemptSummary>,

    // =========================================================================
    // Content
    // =========================================================================

    /// Type of submission
    submission_type: SubmissionType,

    /// Submitted content
    content: SubmissionContent,

    /// Question responses (for quizzes/exams)
    question_responses: List<QuestionResponse>,

    // =========================================================================
    // Status
    // =========================================================================

    /// Submission status
    status: SubmissionStatus,

    /// Whether this is a late submission
    is_late: Bool,

    /// Time past due (if late)
    late_duration: Option<Duration>,

    /// Whether this is a resubmission
    is_resubmission: Bool,

    /// Previous submission ID (if resubmission)
    previous_submission_id: Option<SubmissionId>,

    // =========================================================================
    // Timing
    // =========================================================================

    /// When the attempt was started
    started_at: DateTime,

    /// When submitted
    submitted_at: Option<DateTime>,

    /// Time spent on submission (seconds)
    time_spent_seconds: i64,

    /// Time limit for this attempt (copied from assessment at start)
    time_limit: Option<Duration>,

    /// Whether auto-submitted due to timeout
    auto_submitted: Bool,

    // =========================================================================
    // Plagiarism Detection
    // =========================================================================

    /// Plagiarism detection results
    plagiarism: Option<PlagiarismResult>,

    // =========================================================================
    // Proctoring
    // =========================================================================

    /// Proctoring session data
    proctoring_session: Option<ProctoringSession>,

    /// Proctoring flags/violations
    proctoring_flags: List<ProctoringFlag>,

    /// Overall proctoring status
    proctoring_status: Option<ProctoringStatus>,

    // =========================================================================
    // Grading
    // =========================================================================

    /// Whether grading is complete
    is_graded: Bool,

    /// Grade ID (if graded)
    grade_id: Option<GradeId>,

    /// Quick reference to score (denormalized)
    score: Option<f32>,

    /// Quick reference to max points
    max_points: f32,

    // =========================================================================
    // Metadata
    // =========================================================================

    /// IP address of submission
    ip_address: Option<String>,

    /// User agent string
    user_agent: Option<String>,

    /// Submission source
    submission_source: SubmissionSource,

    /// Additional metadata
    metadata: Map<String, Dynamic>,

    // =========================================================================
    // Timestamps
    // =========================================================================

    /// When created
    created_at: DateTime,

    /// When last updated
    updated_at: DateTime
}

// =============================================================================
// SUBMISSION CONTENT
// =============================================================================

/// The actual content of a submission
enum SubmissionContent {
    /// Text submission
    Text {
        body: String,
        format: TextFormat,
        word_count: i32
    },

    /// File upload submission
    Files {
        files: List<SubmittedFile>
    },

    /// URL submission
    Url {
        url: String,
        title: Option<String>,
        preview: Option<String>
    },

    /// Media recording submission
    Media {
        media_id: MediaId,
        media_type: MediaType,
        duration_seconds: Option<i32>,
        transcript: Option<String>
    },

    /// Quiz/exam responses (questions answered inline)
    QuizResponses {
        /// Included for backward compatibility, main data in question_responses
        response_count: i32
    },

    /// Discussion post
    DiscussionPost {
        body: String,
        format: TextFormat,
        word_count: i32,
        parent_post_id: Option<String>,
        attachments: List<SubmittedFile>,
        replies: List<DiscussionReply>
    },

    /// Google Docs submission
    GoogleDocs {
        doc_id: String,
        doc_url: String,
        doc_title: String,
        snapshot_file_id: Option<MediaId>
    },

    /// Office Online submission
    OfficeOnline {
        doc_id: String,
        doc_url: String,
        doc_title: String,
        doc_type: String,
        snapshot_file_id: Option<MediaId>
    },

    /// Mixed content submission
    Mixed {
        items: List<SubmissionContentItem>
    }
}

/// Text format
enum TextFormat {
    PlainText,
    Markdown,
    Html,
    RichText
}

/// Media type
enum MediaType {
    Video,
    Audio,
    Image
}

/// A file included in a submission
type SubmittedFile {
    /// Unique identifier
    id: String,

    /// File reference in media system
    media_id: MediaId,

    /// Original filename
    filename: String,

    /// File size in bytes
    file_size: i64,

    /// MIME type
    mime_type: String,

    /// When uploaded
    uploaded_at: DateTime,

    /// File hash for integrity
    file_hash: Option<String>,

    /// Preview URL (for images, PDFs)
    preview_url: Option<String>
}

/// An item in mixed content submission
type SubmissionContentItem {
    id: String,
    content_type: String,
    content: SubmissionContent,
    position: i32
}

/// A reply in a discussion
type DiscussionReply {
    id: String,
    author_id: UserId,
    body: String,
    format: TextFormat,
    created_at: DateTime,
    updated_at: DateTime,
    is_edited: Bool
}

// =============================================================================
// QUESTION RESPONSE
// =============================================================================

/// A response to a question in a quiz/exam
type QuestionResponse {
    /// Unique identifier
    id: String,

    /// Question ID
    question_id: String,

    /// Response content
    response: ResponseContent,

    /// Whether the response is correct (auto-graded)
    is_correct: Option<Bool>,

    /// Partial correctness (0.0-1.0)
    correctness: Option<f32>,

    /// Points earned
    points_earned: Option<f32>,

    /// Maximum points possible
    max_points: f32,

    /// Feedback provided
    feedback: Option<String>,

    /// Time spent on this question (seconds)
    time_spent_seconds: i64,

    /// When answered
    answered_at: DateTime,

    /// Number of times answer was changed
    change_count: i32,

    /// Hints used
    hints_used: List<String>,

    /// Points deducted for hints
    hint_penalty: f32,

    /// Whether flagged for review (by student)
    flagged_for_review: Bool
}

/// The content of a question response
enum ResponseContent {
    /// Single choice selected
    SingleChoice {
        selected_option_id: String
    },

    /// Multiple choices selected
    MultipleChoice {
        selected_option_ids: List<String>
    },

    /// True/False answer
    TrueFalse {
        value: Bool
    },

    /// Short text answer
    ShortAnswer {
        text: String
    },

    /// Essay response
    Essay {
        text: String,
        format: TextFormat,
        word_count: i32
    },

    /// Fill in the blank answers
    FillInBlank {
        blanks: Map<String, String>
    },

    /// Matching responses
    Matching {
        matches: Map<String, String>  // premise_id -> response_id
    },

    /// Ordering response
    Ordering {
        ordered_ids: List<String>
    },

    /// Numeric answer
    Numeric {
        value: f64,
        units: Option<String>
    },

    /// Hotspot selection
    Hotspot {
        x: f32,
        y: f32,
        region_id: Option<String>
    },

    /// File upload response
    FileUpload {
        files: List<SubmittedFile>
    },

    /// Likert scale response
    Likert {
        value: i32,
        label: Option<String>
    },

    /// No response provided
    Unanswered
}

// =============================================================================
// ATTEMPT TRACKING
// =============================================================================

/// Summary of a previous attempt
type AttemptSummary {
    /// Attempt ID
    attempt_id: AttemptId,

    /// Attempt number
    attempt_number: i32,

    /// Submission ID
    submission_id: SubmissionId,

    /// Score achieved
    score: Option<f32>,

    /// Max points
    max_points: f32,

    /// Percentage
    percentage: Option<f32>,

    /// Time spent (seconds)
    time_spent_seconds: i64,

    /// When submitted
    submitted_at: Option<DateTime>,

    /// Status
    status: SubmissionStatus
}

/// Detailed attempt record
type Attempt {
    /// Unique identifier
    id: AttemptId,

    /// UUID for external references
    uuid: String,

    /// Submission ID
    submission_id: SubmissionId,

    /// Assessment ID
    assessment_id: AssessmentId,

    /// Student ID
    student_id: StudentId,

    /// Attempt number
    attempt_number: i32,

    /// When started
    started_at: DateTime,

    /// When ended
    ended_at: Option<DateTime>,

    /// Time spent (seconds)
    time_spent_seconds: i64,

    /// Time limit for this attempt
    time_limit: Option<Duration>,

    /// Time remaining when submitted
    time_remaining: Option<Duration>,

    /// Question order (if randomized)
    question_order: List<String>,

    /// Option order per question (if randomized)
    option_orders: Map<String, List<String>>,

    /// Event log
    events: List<AttemptEvent>,

    /// Whether auto-submitted
    auto_submitted: Bool,

    /// IP address
    ip_address: Option<String>,

    /// User agent
    user_agent: Option<String>
}

/// An event during an attempt
type AttemptEvent {
    /// Event type
    event_type: AttemptEventType,

    /// When it occurred
    timestamp: DateTime,

    /// Event data
    data: Map<String, Dynamic>
}

/// Types of attempt events
enum AttemptEventType {
    /// Attempt started
    Started,
    /// Question viewed
    QuestionViewed,
    /// Answer saved
    AnswerSaved,
    /// Answer changed
    AnswerChanged,
    /// Hint requested
    HintRequested,
    /// Question flagged
    QuestionFlagged,
    /// Question unflagged
    QuestionUnflagged,
    /// Timer warning shown
    TimerWarning,
    /// Navigation (next/prev)
    Navigation,
    /// Focus lost (tab switch)
    FocusLost,
    /// Focus regained
    FocusRegained,
    /// Submitted
    Submitted,
    /// Auto-submitted (timeout)
    AutoSubmitted,
    /// Custom event
    Custom { name: String }
}

// =============================================================================
// PLAGIARISM DETECTION
// =============================================================================

/// Results of plagiarism detection
type PlagiarismResult {
    /// Detection provider
    provider: PlagiarismProvider,

    /// Overall similarity score (0-100)
    similarity_score: f32,

    /// AI content probability (0-100)
    ai_probability: Option<f32>,

    /// Detailed matches
    matches: List<PlagiarismMatch>,

    /// Sources found
    sources: List<PlagiarismSource>,

    /// Report URL
    report_url: Option<String>,

    /// Detection status
    status: PlagiarismStatus,

    /// When detection was run
    checked_at: DateTime,

    /// Error message (if failed)
    error_message: Option<String>
}

/// Plagiarism detection provider
enum PlagiarismProvider {
    /// Built-in detection
    Builtin,
    /// Turnitin
    Turnitin,
    /// Copyleaks
    Copyleaks,
    /// Unicheck
    Unicheck,
    /// Custom provider
    Custom { name: String }
}

/// A plagiarism match in the submission
type PlagiarismMatch {
    /// Start position in text
    start_pos: i32,

    /// End position in text
    end_pos: i32,

    /// Matched text
    matched_text: String,

    /// Source URL or reference
    source: String,

    /// Match percentage
    match_percentage: f32
}

/// A source found in plagiarism check
type PlagiarismSource {
    /// Source type
    source_type: SourceType,

    /// Source title/name
    title: String,

    /// Source URL
    url: Option<String>,

    /// Match percentage from this source
    match_percentage: f32,

    /// Whether this is a student submission match
    is_student_submission: Bool
}

/// Type of plagiarism source
enum SourceType {
    Website,
    Journal,
    Book,
    StudentSubmission,
    Database,
    Other
}

/// Status of plagiarism check
enum PlagiarismStatus {
    /// Pending check
    Pending,
    /// Currently checking
    InProgress,
    /// Check complete
    Complete,
    /// Check failed
    Failed,
    /// Not applicable
    NotApplicable
}

// =============================================================================
// PROCTORING SESSION
// =============================================================================

/// Proctoring session data
type ProctoringSession {
    /// Session ID
    session_id: String,

    /// Provider session reference
    provider_session_id: Option<String>,

    /// Provider used
    provider: ProctoringProvider,

    /// When session started
    started_at: DateTime,

    /// When session ended
    ended_at: Option<DateTime>,

    /// Recording URLs
    recordings: ProctoringRecordings,

    /// Identity verification result
    identity_verification: Option<IdentityVerification>,

    /// Room scan result
    room_scan: Option<RoomScanResult>,

    /// Session events
    events: List<ProctoringEvent>
}

/// Proctoring service provider
enum ProctoringProvider {
    Builtin,
    Proctorio,
    Respondus,
    ExamSoft,
    Honorlock,
    ProctorU,
    Custom { name: String }
}

/// Proctoring recordings
type ProctoringRecordings {
    webcam_url: Option<String>,
    screen_url: Option<String>,
    audio_url: Option<String>,
    combined_url: Option<String>
}

/// Identity verification result
type IdentityVerification {
    verified: Bool,
    method: VerificationMethod,
    confidence: f32,
    verified_at: DateTime,
    photo_id_url: Option<String>,
    face_match_score: Option<f32>
}

/// Verification method
enum VerificationMethod {
    PhotoId,
    Biometric,
    Challenge,
    Manual
}

/// Room scan result
type RoomScanResult {
    completed: Bool,
    completed_at: Option<DateTime>,
    recording_url: Option<String>,
    flags: List<String>
}

/// A proctoring event
type ProctoringEvent {
    event_type: ProctoringEventType,
    timestamp: DateTime,
    severity: RiskLevel,
    data: Map<String, Dynamic>,
    screenshot_url: Option<String>
}

/// Types of proctoring events
enum ProctoringEventType {
    SessionStart,
    SessionEnd,
    FaceDetected,
    FaceLost,
    MultipleFaces,
    PhoneDetected,
    TabSwitch,
    WindowSwitch,
    CopyPaste,
    RightClick,
    PrintScreen,
    Keyboard,
    AudioAnomaly,
    MovementAnomaly,
    BrowserWarning,
    FullscreenExit,
    Custom { name: String }
}

/// A proctoring flag/violation
type ProctoringFlag {
    /// Unique identifier
    id: String,

    /// Flag type
    flag_type: ProctoringEventType,

    /// Severity
    severity: RiskLevel,

    /// When detected
    detected_at: DateTime,

    /// Description
    description: String,

    /// Evidence (screenshot, recording timestamp)
    evidence: Option<ProctoringEvidence>,

    /// Whether reviewed by instructor
    reviewed: Bool,

    /// Reviewer's decision
    decision: Option<FlagDecision>,

    /// Reviewer notes
    reviewer_notes: Option<String>,

    /// Reviewed by
    reviewed_by: Option<UserId>,

    /// Reviewed at
    reviewed_at: Option<DateTime>
}

/// Evidence for a proctoring flag
type ProctoringEvidence {
    screenshot_url: Option<String>,
    recording_url: Option<String>,
    recording_timestamp: Option<i32>,
    additional_data: Map<String, Dynamic>
}

/// Decision on a proctoring flag
enum FlagDecision {
    /// Dismissed as false positive
    Dismissed,
    /// Noted but no action
    Noted,
    /// Warning issued
    Warning,
    /// Points deducted
    PointsDeducted { points: f32 },
    /// Attempt invalidated
    AttemptInvalidated,
    /// Referred for further review
    Referred
}

/// Overall proctoring status
enum ProctoringStatus {
    /// Proctoring not required
    NotRequired,
    /// Pending review
    PendingReview,
    /// Passed proctoring review
    Passed,
    /// Failed proctoring review
    Failed,
    /// Flagged for instructor review
    Flagged,
    /// Review in progress
    UnderReview
}

// =============================================================================
// LATE SUBMISSION
// =============================================================================

/// Late submission information
type LateSubmissionInfo {
    /// Original due date
    due_date: DateTime,

    /// Actual submission time
    submitted_at: DateTime,

    /// Duration past due
    late_duration: Duration,

    /// Whether within grace period
    within_grace_period: Bool,

    /// Penalty applied
    penalty_applied: Option<LatePenalty>,

    /// Exception granted
    exception: Option<LateException>
}

/// Late penalty applied
type LatePenalty {
    /// Penalty type
    penalty_type: PenaltyType,

    /// Percentage deducted
    percentage_deducted: f32,

    /// Points deducted
    points_deducted: f32
}

/// Penalty type
enum PenaltyType {
    None,
    PercentPerDay,
    FlatPercent,
    ZeroAfterDeadline
}

/// Late exception granted
type LateException {
    /// Reason for exception
    reason: String,

    /// Extended due date
    extended_due_date: Option<DateTime>,

    /// Penalty waived
    penalty_waived: Bool,

    /// Granted by
    granted_by: UserId,

    /// Granted at
    granted_at: DateTime
}

// =============================================================================
// SUBMISSION SOURCE
// =============================================================================

/// Source of the submission
enum SubmissionSource {
    /// Web interface
    Web,
    /// Mobile app
    MobileApp,
    /// LTI launch
    Lti,
    /// API submission
    Api,
    /// Auto-submit (timeout)
    AutoSubmit,
    /// Imported
    Import
}

