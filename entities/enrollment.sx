    activity_type: ActivityType,
    timestamp: DateTime,
    details: Map<String, Dynamic>,
    ip_address: Option<String>,
    user_agent: Option<String>
}

/// Type of enrollment activity
enum ActivityType {
    /// Logged in
    Login,
    /// Logged out
    Logout,
    /// Viewed content
    ContentView,
    /// Started assessment
    AssessmentStart,
    /// Submitted assessment
    AssessmentSubmit,
    /// Downloaded resource
    ResourceDownload,
    /// Posted in discussion
    DiscussionPost,
    /// Received grade
    GradeReceived,
    /// Certificate issued
    CertificateIssued,
    /// Custom activity
    Custom { name: String }
}

