/// Intelligo LMS - Enrollment Entity
///
/// Enrollments represent the relationship between students and courses.
/// They track enrollment status, roles, progress, accommodations, and certificates.

module intelligo::entities::enrollment

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, Set, List}

// =============================================================================
// ENROLLMENT ENTITY
// =============================================================================

/// An enrollment represents a user's participation in a course
type Enrollment {
    /// Unique identifier
    id: EnrollmentId,

    /// UUID for external references
    uuid: String,

    /// Bundle type (student_enrollment, instructor_enrollment, ta_enrollment, etc.)
    bundle: String,

    /// Course enrolled in
    course_id: CourseId,

    /// User enrolled
    user_id: UserId,

    /// Tenant for multi-tenancy
    tenant_id: TenantId,

    /// Section (if course has sections)
    section_id: Option<SectionId>,

    // =========================================================================
    // Role & Status
    // =========================================================================

    /// Role in the course
    role: CourseRole,

    /// Enrollment status
    status: EnrollmentStatus,

    /// Source of enrollment
    source: EnrollmentSource,

    // =========================================================================
    // Dates
    // =========================================================================

    /// When enrollment was created
    enrolled_at: DateTime,

    /// When enrollment starts (for delayed start)
    start_date: Option<DateTime>,

    /// When enrollment ends/expires
    end_date: Option<DateTime>,

    /// When enrollment was completed
    completed_at: Option<DateTime>,

    /// Last activity in course
    last_activity_at: Option<DateTime>,

    // =========================================================================
    // Progress Caching
    // =========================================================================

    /// Cached progress data
    progress: EnrollmentProgress,

    /// Current module
    current_module_id: Option<ModuleId>,

    /// Current lesson
    current_lesson_id: Option<LessonId>,

    // =========================================================================
    // Grading
    // =========================================================================

    /// Current grade (cached)
    current_grade: Option<f32>,

    /// Current letter grade (cached)
    current_letter_grade: Option<String>,

    /// Whether currently passing
    is_passing: Bool,

    /// Grade book entry ID
    gradebook_entry_id: Option<String>,

    // =========================================================================
    // Accommodations
    // =========================================================================

    /// Student accommodations
    accommodations: Option<Accommodations>,

    // =========================================================================
    // Engagement
    // =========================================================================

    /// Total time spent in course (seconds)
    total_time_seconds: i64,

    /// Login count
    login_count: i32,

    /// Engagement score (0-100)
    engagement_score: Option<f32>,

    /// Risk level (early warning)
    risk_level: RiskLevel,

    /// Risk factors identified
    risk_factors: List<RiskFactor>,

    // =========================================================================
    // Certificate
    // =========================================================================

    /// Certificate issued
    certificate: Option<CertificateInfo>,

    // =========================================================================
    // Metadata
    // =========================================================================

    /// External ID (from SIS)
    external_id: Option<String>,

    /// LTI context
    lti_context: Option<LtiEnrollmentContext>,

    /// Additional metadata
    metadata: Map<String, Dynamic>,

    // =========================================================================
    // Timestamps
    // =========================================================================

    /// When created
    created_at: DateTime,

    /// When last updated
    updated_at: DateTime
}

// =============================================================================
// ENROLLMENT PROGRESS
// =============================================================================

/// Cached progress data for an enrollment
type EnrollmentProgress {
    /// Overall completion percentage
    overall_percentage: f32,

    /// Module progress
    module_progress: Map<ModuleId, ModuleProgress>,

    /// Lesson completion count
    lessons_completed: i32,

    /// Total lessons in course
    total_lessons: i32,

    /// Assessments completed count
    assessments_completed: i32,

    /// Total assessments in course
    total_assessments: i32,

    /// Assignments submitted count
    assignments_submitted: i32,

    /// Total assignments
    total_assignments: i32,

    /// Required items completed
    required_completed: i32,

    /// Total required items
    total_required: i32,

    /// SCORM completion status (if SCORM course)
    scorm_status: Option<ScormCompletionStatus>,

    /// xAPI statements count
    xapi_statements: i32,

    /// Competencies mastered
    competencies_mastered: List<CompetencyId>,

    /// Badges earned
    badges_earned: List<BadgeId>,

    /// Skills developed
    skills_acquired: List<SkillProgress>,

    /// Last progress update
    last_updated: DateTime
}

/// Progress for a single module
type ModuleProgress {
    module_id: ModuleId,
    percentage: f32,
    is_completed: Bool,
    completed_at: Option<DateTime>,
    lessons_completed: i32,
    total_lessons: i32,
    assessments_completed: i32,
    total_assessments: i32,
    time_spent_seconds: i64
}

/// Progress on a skill
type SkillProgress {
    skill_id: SkillId,
    skill_name: String,
    level: SkillLevel,
    progress_percentage: f32,
    evidence_count: i32
}

// =============================================================================
// ACCOMMODATIONS
// =============================================================================

/// Student accommodations for accessibility and special needs
type Accommodations {
    /// Unique identifier
    id: String,

    /// Extra time on assessments
    extra_time: Option<ExtraTime>,

    /// Extended deadlines
    extended_deadlines: Option<ExtendedDeadlines>,

    /// Alternative formats
    alternative_formats: List<AlternativeFormat>,

    /// Assistive technology allowed
    assistive_technology: List<AssistiveTechnology>,

    /// Reduced distraction environment
    reduced_distraction: Bool,

    /// Breaks allowed
    breaks: Option<BreakAccommodation>,

    /// Reader/scribe allowed
    reader_scribe: Bool,

    /// Separate testing location
    separate_location: Bool,

    /// Notes/attachments about accommodations
    notes: Option<String>,

    /// Documentation reference
    documentation_id: Option<MediaId>,

    /// Approved by
    approved_by: UserId,

    /// Approved at
    approved_at: DateTime,

    /// Valid until
    valid_until: Option<DateTime>,

    /// Accommodation source
    source: AccommodationSource
}

/// Extra time accommodation
type ExtraTime {
    /// Time multiplier (e.g., 1.5 = 50% extra time)
    multiplier: f32,

    /// Or fixed extra minutes
    fixed_minutes: Option<i32>,

    /// Applies to
    applies_to: ExtraTimeScope
}

/// What extra time applies to
enum ExtraTimeScope {
    /// All timed assessments
    AllAssessments,
    /// Only exams
    ExamsOnly,
    /// Only quizzes
    QuizzesOnly,
    /// Specific assessments
    Specific { assessment_ids: List<AssessmentId> }
}

/// Extended deadline accommodation
type ExtendedDeadlines {
    /// Extra days for all assignments
    extra_days: i32,

    /// Or percentage extension
    percentage_extension: Option<f32>,

    /// Require prior approval for each
    require_approval: Bool
}

/// Alternative format accommodation
enum AlternativeFormat {
    /// Large print
    LargePrint { font_size: i32 },
    /// Audio version
    Audio,
    /// Braille
    Braille,
    /// Electronic text
    ElectronicText,
    /// Simplified language
    SimplifiedLanguage,
    /// Translation
    Translation { language: String },
    /// Other format
    Other { description: String }
}

/// Assistive technology accommodation
enum AssistiveTechnology {
    ScreenReader,
    SpeechToText,
    TextToSpeech,
    Magnification,
    Calculator,
    DictionaryThesaurus,
    SpellChecker,
    GrammarChecker,
    Other { name: String }
}

/// Break accommodation
type BreakAccommodation {
    /// Break frequency (minutes between breaks)
    frequency_minutes: i32,

    /// Break duration (minutes)
    duration_minutes: i32,

    /// Stop timer during breaks
    stop_timer: Bool
}

/// Source of accommodation
enum AccommodationSource {
    /// Disability services office
    DisabilityServices,
    /// IEP (Individualized Education Program)
    Iep,
    /// 504 Plan
    Section504,
    /// Instructor granted
    Instructor,
    /// Temporary medical
    Medical,
    /// Other
    Other { source: String }
}

// =============================================================================
// CERTIFICATE
// =============================================================================

/// Certificate information
type CertificateInfo {
    /// Certificate ID
    certificate_id: CertificateId,

    /// Certificate UUID
    uuid: String,

    /// Certificate template used
    template_id: String,

    /// When issued
    issued_at: DateTime,

    /// Issued by
    issued_by: Option<UserId>,

    /// Certificate URL
    certificate_url: String,

    /// Verification URL
    verification_url: String,

    /// Verification code
    verification_code: String,

    /// Final grade at time of issue
    final_grade: f32,

    /// Final letter grade
    final_letter_grade: Option<String>,

    /// Completion date
    completion_date: DateTime,

    /// Certificate type
    certificate_type: CertificateType,

    /// Credentials earned
    credentials: List<Credential>,

    /// Expiry date (for certifications)
    expires_at: Option<DateTime>,

    /// Whether certificate is valid
    is_valid: Bool,

    /// Revocation info (if revoked)
    revocation: Option<CertificateRevocation>,

    /// Blockchain verification (if applicable)
    blockchain_tx: Option<String>
}

/// Type of certificate
enum CertificateType {
    /// Course completion certificate
    Completion,
    /// Certificate with grade
    Achievement,
    /// Professional certification
    Certification,
    /// Badge/micro-credential
    Badge,
    /// Continuing education units
    Ceu,
    /// Degree/diploma
    Degree
}

/// A credential earned
type Credential {
    credential_type: String,
    name: String,
    issuer: String,
    external_id: Option<String>,
    metadata: Map<String, Dynamic>
}

/// Certificate revocation info
type CertificateRevocation {
    revoked_at: DateTime,
    revoked_by: UserId,
    reason: String
}

// =============================================================================
// RISK FACTORS
// =============================================================================

/// A risk factor for early warning system
type RiskFactor {
    /// Factor type
    factor_type: RiskFactorType,

    /// Severity
    severity: RiskLevel,

    /// Description
    description: String,

    /// When detected
    detected_at: DateTime,

    /// Value/metric
    value: Option<f32>,

    /// Threshold that was crossed
    threshold: Option<f32>,

    /// Recommended intervention
    recommended_intervention: Option<String>
}

/// Types of risk factors
enum RiskFactorType {
    /// Low engagement
    LowEngagement,
    /// Declining grades
    DecliningGrades,
    /// Missed assignments
    MissedAssignments,
    /// Inactivity
    Inactivity,
    /// Failed assessments
    FailedAssessments,
    /// Low participation
    LowParticipation,
    /// At-risk of not completing
    AtRiskCompletion,
    /// Custom factor
    Custom { name: String }
}

// =============================================================================
// LTI CONTEXT
// =============================================================================

/// LTI enrollment context
type LtiEnrollmentContext {
    /// LTI consumer key
    consumer_key: String,

    /// LTI user ID
    lti_user_id: String,

    /// LTI context ID
    context_id: String,

    /// LTI resource link ID
    resource_link_id: Option<String>,

    /// LTI roles
    lti_roles: List<String>,

    /// Launch URL
    launch_url: Option<String>,

    /// Last LTI launch
    last_launch: DateTime
}

