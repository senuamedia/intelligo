    status: EnrollmentStatus,
    progress_percentage: f32,
    current_grade: Option<f32>,
    letter_grade: Option<String>,
    last_activity_at: Option<DateTime>,
    risk_level: RiskLevel,
    has_certificate: Bool
}

/// Course enrollment statistics
type EnrollmentStats {
    course_id: CourseId,
    total_enrolled: i32,
    active_count: i32,
    completed_count: i32,
    withdrawn_count: i32,
    students_count: i32,
    instructors_count: i32,
    average_progress: f32,
    average_grade: Option<f32>,
    at_risk_count: i32,
    certificates_issued: i32
}
