    /// Text feedback
    text: Option<String>,

    /// Text format
    text_format: TextFormat,

    /// Audio feedback
    audio: Option<MediaFeedback>,

    /// Video feedback
    video: Option<MediaFeedback>,

    /// Canned feedback items used
    canned_feedback_ids: List<String>,

    /// Attachments
    attachments: List<FeedbackAttachment>
}

/// Text format
enum TextFormat {
    PlainText,
    Markdown,
    Html,
    RichText
}

/// Media feedback (audio/video)
type MediaFeedback {
    /// Media ID
    media_id: MediaId,

    /// Duration in seconds
    duration_seconds: i32,

    /// Transcript (if available)
    transcript: Option<String>,

    /// When recorded
    recorded_at: DateTime
}

/// Feedback attachment
type FeedbackAttachment {
    id: String,
    media_id: MediaId,
    filename: String,
    description: Option<String>
}

/// An inline annotation on a document
type Annotation {
    /// Unique identifier
    id: String,

    /// Type of annotation
    annotation_type: AnnotationType,

    /// Location in document
    location: AnnotationLocation,

    /// Annotation content
    content: String,

    /// Color/highlight color
    color: Option<String>,

    /// Created by
    created_by: UserId,

    /// Created at
    created_at: DateTime
}

/// Type of annotation
enum AnnotationType {
    Comment,
    Highlight,
    Strikethrough,
    Suggestion,
    Correction,
    Praise,
    Question
}

/// Location of an annotation
type AnnotationLocation {
    /// Page number (for documents)
    page: Option<i32>,

    /// Start position
    start_offset: i32,

    /// End position
    end_offset: i32,

    /// Selected text
    selected_text: Option<String>,

    /// Coordinates (for image annotations)
    coordinates: Option<AnnotationCoords>
}

/// Coordinates for image/document annotations
type AnnotationCoords {
    x: f32,
    y: f32,
    width: Option<f32>,
    height: Option<f32>
}

// =============================================================================
// GRADE STATUS
// =============================================================================

/// Status of a grade
enum GradeStatus {
    /// Grading not started
    Pending,
    /// Grading in progress
    InProgress,
    /// Graded but not published
    Graded,
    /// Published to student
    Published,
    /// Under review/appeal
    UnderReview,
    /// Revised after appeal
    Revised
}

/// Role of the grader
enum GraderRole {
    Instructor,
    TeachingAssistant,
    Grader,
    Peer,
    AI,
    System
}

// =============================================================================
// GRADE HISTORY
// =============================================================================

/// An entry in grade history (audit trail)
type GradeHistoryEntry {
    /// Version number
    version: i32,

    /// When this version was created
    timestamp: DateTime,

    /// Who made the change
    changed_by: UserId,

    /// Role of who made the change
    changer_role: GraderRole,

    /// Type of change
    change_type: GradeChangeType,

    /// Previous values
    previous_values: GradeSnapshot,

    /// New values
    new_values: GradeSnapshot,

    /// Reason for change
    reason: Option<String>
}

/// Type of grade change
enum GradeChangeType {
    /// Initial grading
    InitialGrade,
    /// Score modified
    ScoreModified,
    /// Feedback updated
    FeedbackUpdated,
    /// Adjustment added
    AdjustmentAdded,
    /// Published to student
    Published,
    /// Regrade requested
    RegradeRequested,
    /// Regraded
    Regraded,
    /// Appeal processed
    AppealProcessed
}

/// Snapshot of grade values for history
type GradeSnapshot {
    points_earned: f32,
    percentage: f32,
    letter_grade: Option<String>,
    adjustments: List<GradeAdjustment>,
    feedback_text: Option<String>,
    status: GradeStatus
}

// =============================================================================
// GRADEBOOK AGGREGATION
// =============================================================================

/// Gradebook entry for a student in a course
type GradebookEntry {
    /// Student ID
    student_id: StudentId,

    /// Enrollment ID
    enrollment_id: EnrollmentId,

    /// Course ID
    course_id: CourseId,

    /// Assessment grades
    assessment_grades: Map<AssessmentId, GradeSummary>,

    /// Category totals
    category_totals: Map<String, CategoryTotal>,

    /// Overall course grade
    course_grade: CourseGrade,

    /// Last updated
    updated_at: DateTime
}

/// Summary of a grade for gradebook
type GradeSummary {
    grade_id: GradeId,
    points_earned: f32,
    max_points: f32,
    percentage: f32,
    letter_grade: Option<String>,
    status: GradeStatus,
    is_late: Bool,
    is_missing: Bool,
    is_excused: Bool,
    graded_at: Option<DateTime>
}

/// Total for a grade category
type CategoryTotal {
    /// Category name
    category: String,

    /// Category weight
    weight: f32,

    /// Points earned
    points_earned: f32,

    /// Points possible
    points_possible: f32,

    /// Percentage
    percentage: f32,

    /// Weighted contribution
    weighted_contribution: f32,

    /// Assessments in category
    assessment_count: i32,

    /// Graded assessments
    graded_count: i32,

    /// Dropped lowest scores
    dropped_scores: List<DroppedScore>
}

/// A score that was dropped
type DroppedScore {
    assessment_id: AssessmentId,
    points_earned: f32,
    max_points: f32
}

/// Overall course grade
type CourseGrade {
    /// Total points earned
    total_points: f32,

    /// Total points possible
    total_possible: f32,

    /// Current percentage
    current_percentage: f32,

    /// Projected final percentage
    projected_percentage: Option<f32>,

    /// Current letter grade
    letter_grade: Option<String>,

    /// GPA points
    gpa_points: Option<f32>,

    /// Whether passing
    is_passing: Bool,

    /// Aggregation method used
    aggregation_type: AggregationType,

    /// Missing assignments affect grade
    missing_affects_grade: Bool
}

/// How grades are aggregated
enum AggregationType {
    /// Total points
    TotalPoints,
    /// Weighted categories
    WeightedCategories,
    /// Weighted assignments
    WeightedAssignments,
    /// Equal weight
    EqualWeight,
    /// Custom formula
    Custom { formula: String }
}

