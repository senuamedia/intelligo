/// Intelligo LMS - Grade Entity
///
/// Grades represent the evaluation results for student submissions.
/// They include points, percentages, letter grades, rubric assessments,
/// AI grading results, feedback, and audit trails.

module intelligo::entities::grade

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, Set, List}

// =============================================================================
// GRADE ENTITY
// =============================================================================

/// A grade record for a student submission
type Grade {
    /// Unique identifier
    id: GradeId,

    /// UUID for external references
    uuid: String,

    /// Bundle type (points_grade, rubric_grade, pass_fail_grade, etc.)
    bundle: String,

    /// Submission being graded
    submission_id: SubmissionId,

    /// Assessment context
    assessment_id: AssessmentId,

    /// Course context
    course_id: CourseId,

    /// Enrollment context
    enrollment_id: EnrollmentId,

    /// Student being graded
    student_id: StudentId,

    /// Tenant for multi-tenancy
    tenant_id: TenantId,

    // =========================================================================
    // Score
    // =========================================================================

    /// Points earned
    points_earned: f32,

    /// Maximum points possible
    max_points: f32,

    /// Percentage score (0-100)
    percentage: f32,

    /// Letter grade (if applicable)
    letter_grade: Option<String>,

    /// GPA points (if applicable)
    gpa_points: Option<f32>,

    /// Pass/Fail result (if applicable)
    passed: Option<Bool>,

    // =========================================================================
    // Adjustments
    // =========================================================================

    /// Raw points before adjustments
    raw_points: f32,

    /// Late penalty applied
    late_penalty: Option<LatePenaltyApplied>,

    /// Extra credit points
    extra_credit: f32,

    /// Manual adjustments
    adjustments: List<GradeAdjustment>,

    /// Final adjusted points
    adjusted_points: f32,

    // =========================================================================
    // Grading Method
    // =========================================================================

    /// How this was graded
    grading_method: GradingMethod,

    /// Rubric assessment (if rubric-graded)
    rubric_assessment: Option<RubricAssessment>,

    /// AI grading result (if AI-graded)
    ai_grading: Option<AiGradingResult>,

    /// Peer reviews (if peer-graded)
    peer_reviews: List<PeerReview>,

    /// Question-level scores (for quizzes)
    question_scores: List<QuestionScore>,

    // =========================================================================
    // Feedback
    // =========================================================================

    /// Overall feedback
    feedback: GradeFeedback,

    /// Inline annotations (on documents)
    annotations: List<Annotation>,

    // =========================================================================
    // Status
    // =========================================================================

    /// Grading status
    status: GradeStatus,

    /// Whether visible to student
    is_published: Bool,

    /// When published to student
    published_at: Option<DateTime>,

    /// Whether student has viewed
    viewed_by_student: Bool,

    /// When student viewed
    viewed_at: Option<DateTime>,

    // =========================================================================
    // Grader Info
    // =========================================================================

    /// Who graded this
    graded_by: Option<UserId>,

    /// Grader role
    grader_role: Option<GraderRole>,

    /// When grading was completed
    graded_at: Option<DateTime>,

    // =========================================================================
    // Audit Trail
    // =========================================================================

    /// Grade history
    history: List<GradeHistoryEntry>,

    /// Current version number
    version: i32,

    // =========================================================================
    // Metadata
    // =========================================================================

    /// Additional metadata
    metadata: Map<String, Dynamic>,

    // =========================================================================
    // Timestamps
    // =========================================================================

    /// When created
    created_at: DateTime,

    /// When last updated
    updated_at: DateTime
}

// =============================================================================
// SCORE TYPES
// =============================================================================

/// Late penalty that was applied
type LatePenaltyApplied {
    /// Original points
    original_points: f32,

    /// Points after penalty
    penalized_points: f32,

    /// Penalty percentage
    penalty_percentage: f32,

    /// Penalty type used
    penalty_type: PenaltyType,

    /// Duration late
    late_duration: Duration,

    /// Whether within grace period
    within_grace_period: Bool
}

/// Penalty type
enum PenaltyType {
    None,
    PercentPerDay,
    FlatPercent,
    ZeroAfterDeadline
}

/// A manual grade adjustment
type GradeAdjustment {
    /// Unique identifier
    id: String,

    /// Adjustment type
    adjustment_type: AdjustmentType,

    /// Points added (positive) or subtracted (negative)
    points: f32,

    /// Reason for adjustment
    reason: String,

    /// Who made the adjustment
    adjusted_by: UserId,

    /// When adjusted
    adjusted_at: DateTime
}

/// Types of grade adjustments
enum AdjustmentType {
    /// Manual point adjustment
    ManualAdjustment,
    /// Curve applied
    Curve,
    /// Extra credit
    ExtraCredit,
    /// Penalty
    Penalty,
    /// Accommodation
    Accommodation,
    /// Error correction
    ErrorCorrection,
    /// Other
    Other { reason: String }
}

// =============================================================================
// RUBRIC ASSESSMENT
// =============================================================================

/// Rubric-based assessment result
type RubricAssessment {
    /// Rubric used
    rubric_id: RubricId,

    /// Criterion scores
    criterion_scores: List<CriterionScore>,

    /// Total points from rubric
    total_points: f32,

    /// Maximum possible from rubric
    max_rubric_points: f32,

    /// Rubric percentage
    rubric_percentage: f32
}

/// Score for a single rubric criterion
type CriterionScore {
    /// Criterion ID
    criterion_id: String,

    /// Criterion name
    criterion_name: String,

    /// Level selected
    level_id: String,

    /// Level name
    level_name: String,

    /// Points awarded
    points: f32,

    /// Maximum points for criterion
    max_points: f32,

    /// Comments for this criterion
    comments: Option<String>,

    /// Scored by
    scored_by: Option<UserId>
}

// =============================================================================
// AI GRADING
// =============================================================================

/// AI grading result
type AiGradingResult {
    /// Model used
    model: String,

    /// Model version
    model_version: String,

    /// Suggested score
    suggested_score: f32,

    /// Confidence level (0-1)
    confidence: f32,

    /// Whether auto-accepted
    auto_accepted: Bool,

    /// Human review required
    requires_review: Bool,

    /// Human reviewed
    was_reviewed: Bool,

    /// Reviewer
    reviewed_by: Option<UserId>,

    /// Review result
    review_decision: Option<AiReviewDecision>,

    /// Final score (after any review)
    final_score: f32,

    /// AI-generated feedback
    generated_feedback: Option<String>,

    /// Grading criteria matched
    criteria_matches: List<AiCriteriaMatch>,

    /// Explanation of score
    explanation: Option<String>,

    /// When graded
    graded_at: DateTime,

    /// Processing time (ms)
    processing_time_ms: i64
}

/// Human review decision on AI grade
enum AiReviewDecision {
    /// Accepted as-is
    Accepted,
    /// Modified by human
    Modified { original_score: f32 },
    /// Rejected and regraded manually
    Rejected
}

/// AI criteria matching result
type AiCriteriaMatch {
    /// Criterion or rubric element
    criterion: String,

    /// Whether criterion was met
    met: Bool,

    /// Partial match score (0-1)
    match_score: f32,

    /// Evidence found in submission
    evidence: Option<String>,

    /// Explanation
    explanation: Option<String>
}

// =============================================================================
// PEER REVIEW
// =============================================================================

/// A peer review of a submission
type PeerReview {
    /// Unique identifier
    id: String,

    /// Reviewer (student) ID
    reviewer_id: StudentId,

    /// Reviewer's enrollment ID
    reviewer_enrollment_id: EnrollmentId,

    /// Whether anonymous
    is_anonymous: Bool,

    /// Score given
    score: f32,

    /// Maximum possible score
    max_score: f32,

    /// Rubric assessment (if using rubric)
    rubric_assessment: Option<RubricAssessment>,

    /// Written feedback
    feedback: String,

    /// Quality rating of this review (by instructor)
    review_quality: Option<ReviewQuality>,

    /// When submitted
    submitted_at: DateTime,

    /// Whether visible to submitter
    is_published: Bool
}

/// Quality assessment of a peer review
type ReviewQuality {
    /// Rating (1-5)
    rating: i32,

    /// Comments on review quality
    comments: Option<String>,

    /// Rated by
    rated_by: UserId,

    /// Rated at
    rated_at: DateTime
}

// =============================================================================
// QUESTION SCORES
// =============================================================================

/// Score for an individual question
type QuestionScore {
    /// Question ID
    question_id: String,

    /// Points earned
    points_earned: f32,

    /// Maximum points
    max_points: f32,

    /// Whether correct (for auto-graded)
    is_correct: Option<Bool>,

    /// Partial credit (0-1)
    partial_credit: Option<f32>,

    /// Grading method used
    grading_method: QuestionGradingMethod,

    /// Feedback for this question
    feedback: Option<String>,

    /// Who graded (for manual)
    graded_by: Option<UserId>,

    /// When graded
    graded_at: Option<DateTime>
}

/// How a question was graded
enum QuestionGradingMethod {
    /// System auto-graded
    Auto,
    /// Manually graded by instructor
    Manual,
    /// AI-assisted grading
    AiAssisted,
    /// Peer graded
    Peer
}

// =============================================================================
// FEEDBACK
// =============================================================================

/// Feedback on a grade
