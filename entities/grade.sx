}

// =============================================================================
// DEFAULT IMPLEMENTATIONS
// =============================================================================

impl Grade {
    /// Create a new grade
    fn new(
        bundle: String,
        submission_id: SubmissionId,
        assessment_id: AssessmentId,
        course_id: CourseId,
        enrollment_id: EnrollmentId,
        student_id: StudentId,
        tenant_id: TenantId,
        max_points: f32
    ) -> Grade {
        let now = DateTime::now();
        Grade {
            id: generate_grade_id(),
            uuid: generate_uuid(),
            bundle,
            submission_id,
            assessment_id,
            course_id,
            enrollment_id,
            student_id,
            tenant_id,
            points_earned: 0.0,
            max_points,
            percentage: 0.0,
            letter_grade: None,
            gpa_points: None,
            passed: None,
            raw_points: 0.0,
            late_penalty: None,
            extra_credit: 0.0,
            adjustments: vec![],
            adjusted_points: 0.0,
            grading_method: GradingMethod::ManualGraded,
            rubric_assessment: None,
            ai_grading: None,
            peer_reviews: vec![],
            question_scores: vec![],
            feedback: GradeFeedback::default(),
            annotations: vec![],
            status: GradeStatus::Pending,
            is_published: false,
            published_at: None,
            viewed_by_student: false,
            viewed_at: None,
            graded_by: None,
            grader_role: None,
            graded_at: None,
            history: vec![],
            version: 0,
            metadata: Map::new(),
            created_at: now,
            updated_at: now
        }
    }

    /// Set the score and recalculate percentage
    fn set_score(&mut self, points: f32) {
        self.raw_points = points;
        self.recalculate();
    }

    /// Recalculate adjusted points and percentage
    fn recalculate(&mut self) {
        // Start with raw points
        let mut adjusted = self.raw_points;

        // Apply late penalty
        if let Some(penalty) = &self.late_penalty {
            adjusted = penalty.penalized_points;
        }

        // Apply adjustments
        for adj in &self.adjustments {
            adjusted += adj.points;
        }

        // Add extra credit
        adjusted += self.extra_credit;

        // Ensure non-negative
        self.adjusted_points = adjusted.max(0.0);
        self.points_earned = self.adjusted_points;

        // Calculate percentage
        if self.max_points > 0.0 {
            self.percentage = (self.adjusted_points / self.max_points) * 100.0;
        } else {
            self.percentage = 0.0;
        }
    }

    /// Apply late penalty
    fn apply_late_penalty(&mut self, penalty_type: PenaltyType, late_duration: Duration) {
        let penalty_percentage = match penalty_type {
            PenaltyType::None => 0.0,
            PenaltyType::PercentPerDay => {
                let days = late_duration.as_days() as f32;
                (days * 10.0).min(100.0) // 10% per day, max 100%
            },
            PenaltyType::FlatPercent => 10.0, // Default 10%
            PenaltyType::ZeroAfterDeadline => 100.0
        };

        let penalized = self.raw_points * (1.0 - penalty_percentage / 100.0);

        self.late_penalty = Some(LatePenaltyApplied {
            original_points: self.raw_points,
            penalized_points: penalized.max(0.0),
            penalty_percentage,
            penalty_type,
            late_duration,
            within_grace_period: false
        });

        self.recalculate();
    }

    /// Add adjustment
    fn add_adjustment(&mut self, adjustment: GradeAdjustment) {
        self.adjustments.push(adjustment);
        self.recalculate();
        self.version += 1;
    }

    /// Calculate letter grade from percentage
    fn calculate_letter_grade(&mut self, scale: &GradingScale) {
        for level in &scale.levels {
            if self.percentage >= level.min_percentage && self.percentage <= level.max_percentage {
                self.letter_grade = Some(level.label.clone());
                self.gpa_points = level.gpa_points;
                return;
            }
        }
    }

    /// Publish grade to student
    fn publish(&mut self) {
        self.is_published = true;
        self.published_at = Some(DateTime::now());
        self.status = GradeStatus::Published;
    }

    /// Mark as viewed by student
    fn mark_viewed(&mut self) {
        if !self.viewed_by_student {
            self.viewed_by_student = true;
            self.viewed_at = Some(DateTime::now());
        }
    }

    /// Record history entry
    fn record_history(&mut self, changed_by: UserId, changer_role: GraderRole, change_type: GradeChangeType, reason: Option<String>) {
        let previous = GradeSnapshot {
            points_earned: self.points_earned,
            percentage: self.percentage,
            letter_grade: self.letter_grade.clone(),
            adjustments: self.adjustments.clone(),
            feedback_text: self.feedback.text.clone(),
            status: self.status.clone()
        };

        self.history.push(GradeHistoryEntry {
            version: self.version,
            timestamp: DateTime::now(),
            changed_by,
            changer_role,
            change_type,
            previous_values: previous.clone(),
            new_values: previous, // Will be updated after changes
            reason
        });

        self.version += 1;
    }

    /// Get effective score (considering all factors)
    fn effective_score(&self) -> f32 {
        self.adjusted_points
    }

    /// Check if needs grading review
    fn needs_review(&self) -> Bool {
        if let Some(ai) = &self.ai_grading {
            return ai.requires_review && !ai.was_reviewed
        }
        false
    }
}

impl GradeFeedback {
    fn default() -> GradeFeedback {
        GradeFeedback {
            text: None,
            text_format: TextFormat::PlainText,
            audio: None,
            video: None,
            canned_feedback_ids: vec![],
            attachments: vec![]
        }
    }

    /// Check if feedback is empty
    fn is_empty(&self) -> Bool {
        self.text.is_none() &&
        self.audio.is_none() &&
        self.video.is_none() &&
        self.attachments.is_empty()
    }
}

impl GradebookEntry {
    /// Create a new gradebook entry
    fn new(student_id: StudentId, enrollment_id: EnrollmentId, course_id: CourseId) -> GradebookEntry {
        GradebookEntry {
            student_id,
            enrollment_id,
            course_id,
            assessment_grades: Map::new(),
            category_totals: Map::new(),
            course_grade: CourseGrade::default(),
            updated_at: DateTime::now()
        }
    }

    /// Recalculate all totals
    fn recalculate(&mut self, weights: &Map<String, f32>, passing_grade: f32) {
        // Recalculate category totals
        // ... implementation details

        // Recalculate course grade
        let total_earned: f32 = self.assessment_grades.values()
            .map(|g| g.points_earned)
            .sum();
        let total_possible: f32 = self.assessment_grades.values()
            .map(|g| g.max_points)
            .sum();

        self.course_grade.total_points = total_earned;
        self.course_grade.total_possible = total_possible;

        if total_possible > 0.0 {
            self.course_grade.current_percentage = (total_earned / total_possible) * 100.0;
        }

        self.course_grade.is_passing = self.course_grade.current_percentage >= passing_grade;
        self.updated_at = DateTime::now();
    }

    /// Get missing assignment count
    fn missing_count(&self) -> i32 {
        self.assessment_grades.values()
            .filter(|g| g.is_missing)
            .count() as i32
    }

    /// Get late submission count
    fn late_count(&self) -> i32 {
        self.assessment_grades.values()
            .filter(|g| g.is_late)
            .count() as i32
    }
}

impl CourseGrade {
    fn default() -> CourseGrade {
        CourseGrade {
            total_points: 0.0,
            total_possible: 0.0,
            current_percentage: 0.0,
            projected_percentage: None,
            letter_grade: None,
            gpa_points: None,
            is_passing: false,
            aggregation_type: AggregationType::TotalPoints,
            missing_affects_grade: true
        }
    }
}

impl AiGradingResult {
    /// Create a new AI grading result
    fn new(model: String, suggested_score: f32, confidence: f32) -> AiGradingResult {
        let auto_accepted = confidence >= 0.90;
        AiGradingResult {
            model,
            model_version: "1.0".to_string(),
            suggested_score,
            confidence,
            auto_accepted,
            requires_review: !auto_accepted,
            was_reviewed: false,
            reviewed_by: None,
            review_decision: None,
            final_score: if auto_accepted { suggested_score } else { 0.0 },
            generated_feedback: None,
            criteria_matches: vec![],
            explanation: None,
            graded_at: DateTime::now(),
            processing_time_ms: 0
        }
    }

    /// Accept AI grade
    fn accept(&mut self) {
        self.was_reviewed = true;
        self.review_decision = Some(AiReviewDecision::Accepted);
        self.final_score = self.suggested_score;
    }

    /// Modify AI grade
    fn modify(&mut self, new_score: f32, reviewer: UserId) {
        let original = self.suggested_score;
        self.was_reviewed = true;
        self.reviewed_by = Some(reviewer);
        self.review_decision = Some(AiReviewDecision::Modified { original_score: original });
        self.final_score = new_score;
    }

    /// Reject AI grade
    fn reject(&mut self, reviewer: UserId) {
        self.was_reviewed = true;
        self.reviewed_by = Some(reviewer);
        self.review_decision = Some(AiReviewDecision::Rejected);
        self.final_score = 0.0;
    }
}

/// Standard grading scale
type GradingScale {
    id: String,
    name: String,
    levels: List<GradeLevel>
}

/// Grade level in a scale
type GradeLevel {
    label: String,
    min_percentage: f32,
    max_percentage: f32,
    gpa_points: Option<f32>
}

impl GradingScale {
    /// Standard US letter grade scale
    fn standard_letter_scale() -> GradingScale {
        GradingScale {
            id: "standard_letter".to_string(),
            name: "Standard Letter Grade".to_string(),
            levels: vec![
                GradeLevel { label: "A".to_string(), min_percentage: 93.0, max_percentage: 100.0, gpa_points: Some(4.0) },
                GradeLevel { label: "A-".to_string(), min_percentage: 90.0, max_percentage: 92.99, gpa_points: Some(3.7) },
                GradeLevel { label: "B+".to_string(), min_percentage: 87.0, max_percentage: 89.99, gpa_points: Some(3.3) },
                GradeLevel { label: "B".to_string(), min_percentage: 83.0, max_percentage: 86.99, gpa_points: Some(3.0) },
                GradeLevel { label: "B-".to_string(), min_percentage: 80.0, max_percentage: 82.99, gpa_points: Some(2.7) },
                GradeLevel { label: "C+".to_string(), min_percentage: 77.0, max_percentage: 79.99, gpa_points: Some(2.3) },
                GradeLevel { label: "C".to_string(), min_percentage: 73.0, max_percentage: 76.99, gpa_points: Some(2.0) },
                GradeLevel { label: "C-".to_string(), min_percentage: 70.0, max_percentage: 72.99, gpa_points: Some(1.7) },
                GradeLevel { label: "D+".to_string(), min_percentage: 67.0, max_percentage: 69.99, gpa_points: Some(1.3) },
                GradeLevel { label: "D".to_string(), min_percentage: 63.0, max_percentage: 66.99, gpa_points: Some(1.0) },
                GradeLevel { label: "D-".to_string(), min_percentage: 60.0, max_percentage: 62.99, gpa_points: Some(0.7) },
                GradeLevel { label: "F".to_string(), min_percentage: 0.0, max_percentage: 59.99, gpa_points: Some(0.0) }
            ]
        }
    }
}
