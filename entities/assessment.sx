    weight: Option<f32>,
    passing_score: Option<f32>,
    grade_category: Option<String>,
    questions: Option<List<Question>>,
    randomize_questions: Option<Bool>,
    randomize_options: Option<Bool>,
    question_count: Option<i32>,
    rubric: Option<Rubric>,
    timing: Option<TimingSettings>,
    max_attempts: Option<i32>,
    attempt_scoring: Option<AttemptScoring>,
    show_answers: Option<ShowAnswersPolicy>,
    show_feedback: Option<ShowFeedbackPolicy>,
    show_score_immediately: Option<Bool>,
    one_question_at_a_time: Option<Bool>,
    lock_after_answer: Option<Bool>,
    proctoring: Option<ProctoringConfig>,
    ai_grading: Option<AiGradingConfig>,
    access_code: Option<String>,
    require_lockdown_browser: Option<Bool>,
    learning_objectives: Option<List<LearningObjectiveId>>,
    competencies: Option<List<CompetencyId>>,
    status: Option<EntityStatus>
}

/// Input for adding a question
type AddQuestionInput {
    question_type: QuestionType,
    text: String,
    stem: Option<String>,
    points: f32,
    position: Option<i32>,
    options: List<QuestionOption>,
    correct_answers: List<CorrectAnswer>,
    general_feedback: Option<String>,
    correct_feedback: Option<String>,
    incorrect_feedback: Option<String>,
    hints: List<QuestionHint>,
    difficulty: Option<SkillLevel>,
    bloom_level: Option<BloomLevel>,
    tags: List<String>
}

// =============================================================================
// FILTER TYPES
// =============================================================================

/// Filter options for assessment queries
type AssessmentFilter {
    tenant_id: Option<TenantId>,
    course_id: Option<CourseId>,
    module_id: Option<ModuleId>,
    assessment_type: Option<AssessmentType>,
    status: Option<EntityStatus>,
    grade_category: Option<String>,
    has_due_date: Option<Bool>,
    due_date_range: Option<DateRange>,
    search: Option<String>
}

// =============================================================================
// DEFAULT IMPLEMENTATIONS
// =============================================================================

impl Assessment {
    /// Create a new assessment with defaults
    fn new(
        bundle: String,
        module_id: ModuleId,
        course_id: CourseId,
        tenant_id: TenantId,
        title: String,
        description: String,
        assessment_type: AssessmentType,
        total_points: f32
    ) -> Assessment {
        let now = DateTime::now();
        Assessment {
            id: generate_assessment_id(),
            uuid: generate_uuid(),
            bundle,
            module_id,
            course_id,
            tenant_id,
            title,
            description,
            instructions: None,
            assessment_type,
            grading_type: GradingType::Points,
            total_points,
            weight: None,
            passing_score: None,
            grade_category: None,
            questions: vec![],
            question_bank_refs: vec![],
            randomize_questions: false,
            randomize_options: false,
            question_count: None,
            rubric: None,
            timing: TimingSettings::default(),
            max_attempts: Some(1),
            attempt_scoring: AttemptScoring::Highest,
            attempt_cooldown: None,
            show_answers: ShowAnswersPolicy::AfterSubmission,
            show_feedback: ShowFeedbackPolicy::AfterSubmission,
            show_score_immediately: true,
            one_question_at_a_time: false,
            lock_after_answer: false,
            proctoring: None,
            ai_grading: None,
            access_code: None,
            ip_restrictions: vec![],
            require_lockdown_browser: false,
            learning_objectives: vec![],
            competencies: vec![],
            status: EntityStatus::Draft,
            created_at: now,
            updated_at: now,
            published_at: None
        }
    }

    /// Check if assessment is available now
    fn is_available(&self) -> Bool {
        if self.status != EntityStatus::Published {
            return false
        }

        let now = DateTime::now();

        if let Some(from) = &self.timing.available_from {
            if now < *from {
                return false
            }
        }

        if let Some(until) = &self.timing.available_until {
            if now > *until {
                return false
            }
        }

        true
    }

    /// Check if assessment is past due
    fn is_past_due(&self) -> Bool {
        if let Some(due) = &self.timing.due_date {
            return DateTime::now() > *due
        }
        false
    }

    /// Check if still within grace period
    fn is_in_grace_period(&self) -> Bool {
        if let (Some(due), Some(grace)) = (&self.timing.due_date, &self.timing.grace_period) {
            let now = DateTime::now();
            let grace_end = *due + *grace;
            return now > *due && now <= grace_end
        }
        false
    }

    /// Get total question count
    fn question_count(&self) -> i32 {
        self.questions.len() as i32
    }

    /// Check if this is a timed assessment
    fn is_timed(&self) -> Bool {
        self.timing.time_limit.is_some()
    }

    /// Check if proctoring is enabled
    fn is_proctored(&self) -> Bool {
        self.proctoring.as_ref().map(|p| p.enabled).unwrap_or(false)
    }

    /// Check if AI grading is enabled
    fn has_ai_grading(&self) -> Bool {
        self.ai_grading.as_ref().map(|a| a.enabled).unwrap_or(false)
    }
}

impl Question {
    /// Create a new question with defaults
    fn new(
        question_type: QuestionType,
        text: String,
        points: f32,
        position: i32
    ) -> Question {
        Question {
            id: generate_uuid(),
            question_type,
            text,
            stem: None,
            points,
            position,
            is_required: true,
            options: vec![],
            correct_answers: vec![],
            matching_pairs: None,
            ordering_items: None,
            numeric_config: None,
            fill_blank_config: None,
            file_upload_config: None,
            images: vec![],
            audio: None,
            video: None,
            general_feedback: None,
            correct_feedback: None,
            incorrect_feedback: None,
            option_feedback: Map::new(),
            hints: vec![],
            hint_penalty: 0.0,
            difficulty: SkillLevel::Intermediate,
            bloom_level: BloomLevel::Understand,
            tags: vec![],
            learning_objectives: vec![],
            source_bank_id: None,
            explanation: None
        }
    }

    /// Check if question is auto-gradable
    fn is_auto_gradable(&self) -> Bool {
        match &self.question_type {
            QuestionType::MultipleChoice { .. } => true,
            QuestionType::TrueFalse => true,
            QuestionType::ShortAnswer => true,
            QuestionType::FillInBlank => true,
            QuestionType::Matching => true,
            QuestionType::Ordering => true,
            QuestionType::Numeric => true,
            QuestionType::Likert => true,
            QuestionType::Essay => false,
            QuestionType::Hotspot => true,
            QuestionType::FileUpload => false,
            QuestionType::Custom { .. } => false
        }
    }
}

impl TimingSettings {
    fn default() -> TimingSettings {
        TimingSettings {
            time_limit: None,
            due_date: None,
            available_from: None,
            available_until: None,
            grace_period: None,
            time_per_question: None,
            show_timer: true,
            time_warning_minutes: Some(5),
            auto_submit_on_timeout: true
        }
    }
}

impl Rubric {
    /// Create a new rubric with defaults
    fn new(title: String, created_by: UserId) -> Rubric {
        let now = DateTime::now();
        Rubric {
            id: generate_uuid(),
            uuid: generate_uuid(),
            title,
            description: None,
            criteria: vec![],
            total_points: 0.0,
            use_ranges: false,
            is_reusable: false,
            shared_with_courses: vec![],
            created_by,
            created_at: now,
            updated_at: now
        }
    }

    /// Calculate total points from criteria
    fn calculate_total_points(&self) -> f32 {
        self.criteria.iter().map(|c| c.max_points).sum()
    }
}

impl QuestionBank {
    /// Create a new question bank
    fn new(title: String, tenant_id: TenantId, created_by: UserId) -> QuestionBank {
        let now = DateTime::now();
        QuestionBank {
            id: generate_uuid(),
            uuid: generate_uuid(),
            tenant_id,
            title,
            description: None,
            questions: vec![],
            categories: vec![],
            shared_with_courses: vec![],
            is_global: false,
            created_by,
            created_at: now,
            updated_at: now
        }
    }

    /// Get question count
    fn question_count(&self) -> i32 {
        self.questions.len() as i32
    }

    /// Get questions by difficulty
    fn get_by_difficulty(&self, difficulty: SkillLevel) -> List<&Question> {
        self.questions.iter().filter(|q| q.difficulty == difficulty).collect()
    }

    /// Get questions by tag
    fn get_by_tag(&self, tag: &String) -> List<&Question> {
        self.questions.iter().filter(|q| q.tags.contains(tag)).collect()
    }
}

impl ProctoringConfig {
    fn default() -> ProctoringConfig {
        ProctoringConfig {
            enabled: false,
            provider: ProctoringProvider::Builtin,
            record_webcam: true,
            record_screen: true,
            record_audio: false,
            face_detection: true,
            multi_face_detection: true,
            phone_detection: true,
            tab_switch_detection: true,
            copy_paste_detection: true,
            max_tab_switches: Some(3),
            flag_only: true,
            id_verification: false,
            room_scan: false,
            custom_rules: vec![]
        }
    }
}

impl AiGradingConfig {
    fn default() -> AiGradingConfig {
        AiGradingConfig {
            enabled: false,
            model: "claude-sonnet".to_string(),
            auto_grade_types: vec![
                QuestionType::ShortAnswer,
                QuestionType::Essay
            ],
            confidence_threshold: 0.85,
            use_rubric: true,
            generate_feedback: true,
            require_review_below_confidence: true,
            custom_instructions: None,
            grading_criteria: vec![],
            example_answers: vec![]
        }
    }
}
