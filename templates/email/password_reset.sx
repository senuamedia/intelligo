// Password Reset Email Template for Intelligo LMS
// Sent when users request a password reset

module intelligo::templates::email::password_reset

use intelligo::templates::*
use intelligo::core::types::*

/// Password reset email template ID
pub const TEMPLATE_ID: &str = "email.password_reset";

/// Create the password reset email template configuration
pub fn get_template_config() -> TemplateConfig {
    TemplateConfig {
        template_id: TEMPLATE_ID.to_string(),
        template_type: TemplateType::Email,
        name: "Password Reset".to_string(),
        description: Some("Sent when a user requests to reset their password".to_string()),
        category: "security".to_string(),

        subject: Some("Reset Your {{organization_name}} Password".to_string()),
        body_html: PASSWORD_RESET_HTML.to_string(),
        body_text: Some(PASSWORD_RESET_TEXT.to_string()),

        default_locale: "en".to_string(),
        available_locales: vec!["en".to_string(), "es".to_string(), "fr".to_string()],

        enabled: true,
        track_opens: true,
        track_clicks: true,

        required_variables: vec![
            "user_name".to_string(),
            "user_email".to_string(),
            "organization_name".to_string(),
            "reset_url".to_string(),
            "expires_in".to_string(),
        ],
        optional_variables: vec![
            "user_first_name".to_string(),
            "request_ip".to_string(),
            "request_location".to_string(),
            "request_browser".to_string(),
            "support_email".to_string(),
        ],

        created_at: DateTime::now(),
        updated_at: DateTime::now(),
    }
}

/// Build context for password reset email
pub fn build_context(
    user_name: String,
    user_email: String,
    user_first_name: Option<String>,
    organization_name: String,
    reset_url: String,
    expires_in: String,
    request_ip: Option<String>,
    request_location: Option<String>,
    request_browser: Option<String>,
    support_email: Option<String>
) -> TemplateContext {
    let mut ctx = TemplateContext::new()
        .set_string("user_name", user_name)
        .set_string("user_email", user_email)
        .set_string("organization_name", organization_name)
        .set_string("reset_url", reset_url)
        .set_string("expires_in", expires_in)
        .set_string("year", DateTime::now().year().to_string());

    if let Some(first_name) = user_first_name {
        ctx = ctx.set_string("user_first_name", first_name);
    }

    if let Some(ip) = request_ip {
        ctx = ctx.set_string("request_ip", ip);
        ctx = ctx.set_bool("has_request_info", true);
    }

    if let Some(location) = request_location {
        ctx = ctx.set_string("request_location", location);
    }

    if let Some(browser) = request_browser {
        ctx = ctx.set_string("request_browser", browser);
    }

    if let Some(support) = support_email {
        ctx = ctx.set_string("support_email", support);
    }

    ctx
}

const PASSWORD_RESET_HTML: &str = r#"
<h1>Password Reset Request</h1>

<p>Hi {{#if user_first_name}}{{user_first_name}}{{else}}{{user_name}}{{/if}},</p>

<p>We received a request to reset the password for your {{organization_name}} account associated with <strong>{{user_email}}</strong>.</p>

<p style="text-align: center; margin: 30px 0;">
    <a href="{{reset_url}}" class="button">Reset Your Password</a>
</p>

<p>This link will expire in <strong>{{expires_in}}</strong>.</p>

<div style="background-color: #f8f9fa; border-radius: 4px; padding: 15px; margin: 20px 0;">
    <p style="margin: 0 0 10px 0;"><strong>Didn't request this?</strong></p>
    <p style="margin: 0;">If you didn't request a password reset, you can safely ignore this email. Your password will remain unchanged.</p>
</div>

{{#if has_request_info}}
<h2>Request Details</h2>
<table style="width: 100%; border-collapse: collapse; margin: 20px 0;">
    {{#if request_ip}}
    <tr>
        <td style="padding: 8px; border-bottom: 1px solid #eee;"><strong>IP Address:</strong></td>
        <td style="padding: 8px; border-bottom: 1px solid #eee;">{{request_ip}}</td>
    </tr>
    {{/if}}
    {{#if request_location}}
    <tr>
        <td style="padding: 8px; border-bottom: 1px solid #eee;"><strong>Location:</strong></td>
        <td style="padding: 8px; border-bottom: 1px solid #eee;">{{request_location}}</td>
    </tr>
    {{/if}}
    {{#if request_browser}}
    <tr>
        <td style="padding: 8px; border-bottom: 1px solid #eee;"><strong>Browser:</strong></td>
        <td style="padding: 8px; border-bottom: 1px solid #eee;">{{request_browser}}</td>
    </tr>
    {{/if}}
</table>
{{/if}}

<div style="background-color: #fff3cd; border: 1px solid #ffc107; border-radius: 4px; padding: 15px; margin: 20px 0;">
    <p style="margin: 0;"><strong>Security Tips:</strong></p>
    <ul style="margin: 10px 0 0 0; padding-left: 20px;">
        <li>Create a strong password with at least 8 characters</li>
        <li>Use a mix of letters, numbers, and symbols</li>
        <li>Never share your password with anyone</li>
        <li>Don't use the same password on multiple sites</li>
    </ul>
</div>

{{#if support_email}}
<p>If you're having trouble resetting your password, contact our support team at <a href="mailto:{{support_email}}">{{support_email}}</a>.</p>
{{/if}}

<p>
    Best regards,<br>
    The {{organization_name}} Security Team
</p>

<hr style="margin: 30px 0; border: none; border-top: 1px solid #eee;">

<p style="font-size: 12px; color: #666;">
    <strong>Button not working?</strong> Copy and paste this link into your browser:<br>
    <a href="{{reset_url}}" style="word-break: break-all;">{{reset_url}}</a>
</p>
"#;

const PASSWORD_RESET_TEXT: &str = r#"
PASSWORD RESET REQUEST

Hi {{#if user_first_name}}{{user_first_name}}{{else}}{{user_name}}{{/if}},

We received a request to reset the password for your {{organization_name}} account associated with {{user_email}}.

Reset your password by visiting this link:
{{reset_url}}

This link will expire in {{expires_in}}.

DIDN'T REQUEST THIS?
If you didn't request a password reset, you can safely ignore this email. Your password will remain unchanged.

{{#if has_request_info}}
REQUEST DETAILS
---------------
{{#if request_ip}}IP Address: {{request_ip}}{{/if}}
{{#if request_location}}Location: {{request_location}}{{/if}}
{{#if request_browser}}Browser: {{request_browser}}{{/if}}
{{/if}}

SECURITY TIPS
- Create a strong password with at least 8 characters
- Use a mix of letters, numbers, and symbols
- Never share your password with anyone
- Don't use the same password on multiple sites

{{#if support_email}}
If you're having trouble resetting your password, contact our support team at {{support_email}}.
{{/if}}

Best regards,
The {{organization_name}} Security Team
"#;
