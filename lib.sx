/// Intelligo LMS - Main Library Entry Point
///
/// Intelligo is an AI-powered Learning Management System built on the
/// Modulus runtime. It provides comprehensive learning, compliance,
/// and analytics capabilities.
///
/// # Architecture
///
/// The system is organized into several key modules:
///
/// - **entities**: Core domain entities (Course, Module, Lesson, etc.)
/// - **api**: REST API endpoints and handlers
/// - **ai**: AI-powered features via the hive swarm system
/// - **compliance**: SCORM 1.2, SCORM 2004, and xAPI support
/// - **taxonomy**: Skills, competencies, and learning objectives
/// - **runtime**: Actor system, messaging, and scheduling
/// - **integrations**: Third-party service integrations
/// - **admin**: Administrative dashboards and reporting
/// - **learner**: Learner-facing content delivery
/// - **tenant**: Multi-tenancy support
///
/// # Example
///
/// ```sx
/// use intelligo::*
///
/// fn main() {
///     // Initialize the LMS
///     let config = Config::from_file("config.toml");
///     let app = Application::new(config);
///
///     // Start the server
///     app.run();
/// }
/// ```

module intelligo

// Core modules
pub mod core { pub use intelligo::core::*; }
pub mod entities { pub use intelligo::entities::*; }
pub mod api { pub use intelligo::api::*; }

// AI and learning
pub mod ai { pub use intelligo::ai::*; }
pub mod taxonomy { pub use intelligo::taxonomy::*; }

// Compliance
pub mod compliance { pub use intelligo::compliance::*; }

// Infrastructure
pub mod runtime { pub use intelligo::runtime::*; }
pub mod config { pub use intelligo::config::*; }

// User interfaces
pub mod admin { pub use intelligo::admin::*; }
pub mod learner { pub use intelligo::learner::*; }

// Integrations
pub mod integrations { pub use intelligo::integrations::*; }

// Multi-tenancy
pub mod tenant { pub use intelligo::tenant::*; }

// Presentation
pub mod themes { pub use intelligo::themes::*; }
pub mod templates { pub use intelligo::templates::*; }
pub mod publishing { pub use intelligo::publishing::*; }

// Testing
pub mod chai { pub use intelligo::chai::*; }

