// =============================================================================
// INTELLIGO LMS - Learner Dashboard
// =============================================================================
// Personalized learner dashboard providing course progress, upcoming deadlines,
// recent activity, AI recommendations, achievements, and quick access to
// enrolled courses following Aether CMS patterns.
// =============================================================================

module intelligo::learner::dashboard

use intelligo::core::types::*
use intelligo::entities::enrollment::{Enrollment, EnrollmentStatus}
use intelligo::entities::course::{Course, CourseBundle}
use intelligo::entities::progress::{Progress, CompletionStatus}
use intelligo::entities::grade::{Grade}
use intelligo::entities::assessment::{Assessment}
use intelligo::ai::hives::learning_path_hive::{ContentRecommendation, ProgressReport}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// Dashboard Configuration
// =============================================================================

/// Learner dashboard configuration
pub struct LearnerDashboardConfig {
    /// Show AI recommendations
    show_recommendations: bool,
    /// Number of recommendations to show
    recommendation_count: i32,
    /// Show achievements section
    show_achievements: bool,
    /// Show leaderboard
    show_leaderboard: bool,
    /// Show calendar
    show_calendar: bool,
    /// Recent activity count
    recent_activity_count: i32,
    /// Upcoming deadlines days ahead
    deadline_lookahead_days: i32,
    /// Enable gamification features
    gamification_enabled: bool,
    /// Show study streak
    show_study_streak: bool,
}

impl Default for LearnerDashboardConfig {
    fn default() -> Self {
        LearnerDashboardConfig {
            show_recommendations: true,
            recommendation_count: 5,
            show_achievements: true,
            show_leaderboard: false,
            show_calendar: true,
            recent_activity_count: 10,
            deadline_lookahead_days: 14,
            gamification_enabled: true,
            show_study_streak: true,
        }
    }
}

