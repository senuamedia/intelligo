        let passed = if self.negated { !is_some } else { is_some };
        AssertionResult::new(
            passed,
            format!(
                "Expected {:?} {} be Some",
                self.actual,
                if self.negated { "to not" } else { "to" }
            ),
            self.message
        )
    }

    /// Assert option is None
    pub fn none(self) -> AssertionResult {
        let is_none = self.actual.is_none();
        let passed = if self.negated { !is_none } else { is_none };
        AssertionResult::new(
            passed,
            format!(
                "Expected {:?} {} be None",
                self.actual,
                if self.negated { "to not" } else { "to" }
            ),
            self.message
        )
    }
}

