    /// Assert result is Err
    pub fn err(self) -> AssertionResult {
        let is_err = self.actual.is_err();
        let passed = if self.negated { !is_err } else { is_err };
        AssertionResult::new(
            passed,
            format!(
                "Expected {:?} {} be Err",
                self.actual,
