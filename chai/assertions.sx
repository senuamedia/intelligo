/// Intelligo LMS - Chai Assertions
///
/// Core assertion library with BDD and TDD style assertions.

module intelligo::chai::assertions

use std::collections::{Map, List}
use std::time::Duration

// =============================================================================
// EXPECT INTERFACE (BDD Style)
// =============================================================================

/// Create an expectation for BDD-style assertions
pub fn expect<T>(actual: T) -> Expectation<T> {
    Expectation {
        actual,
        negated: false,
        message: None
    }
}

/// Expectation wrapper for chainable assertions
pub type Expectation<T> {
    actual: T,
    negated: bool,
    message: Option<String>
}

impl<T> Expectation<T> {
    /// Negate the next assertion
    pub fn not(self) -> Expectation<T> {
        Expectation {
            actual: self.actual,
            negated: !self.negated,
            message: self.message
        }
    }

    /// Alias for not
    pub fn to_not(self) -> Expectation<T> {
        self.not()
    }

    /// Add custom failure message
    pub fn because(mut self, msg: &str) -> Expectation<T> {
        self.message = Some(msg.to_string());
        self
    }

    /// Chainable property - no-op for readability
    pub fn to(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn be(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn been(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn is(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn that(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn which(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn and(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn has(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn have(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn with(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn at(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn of(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn same(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn but(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn does(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn still(self) -> Expectation<T> {
        self
    }

    /// Chainable property - no-op for readability
    pub fn also(self) -> Expectation<T> {
        self
    }
}

// Equality assertions
impl<T: PartialEq + std::fmt::Debug> Expectation<T> {
    /// Assert equality
    pub fn equal(self, expected: T) -> AssertionResult {
        let passed = if self.negated {
            self.actual != expected
        } else {
            self.actual == expected
        };

        AssertionResult::new(
            passed,
            format!(
                "Expected {:?} {} equal {:?}",
                self.actual,
                if self.negated { "to not" } else { "to" },
                expected
            ),
            self.message
        )
    }

    /// Alias for equal
    pub fn equals(self, expected: T) -> AssertionResult {
        self.equal(expected)
    }

    /// Alias for equal
    pub fn eq(self, expected: T) -> AssertionResult {
        self.equal(expected)
    }

    /// Deep equality (same as equal for most types)
    pub fn deep_equal(self, expected: T) -> AssertionResult {
        self.equal(expected)
    }

    /// Alias for deep_equal
    pub fn eql(self, expected: T) -> AssertionResult {
        self.deep_equal(expected)
    }
}

// Boolean assertions
impl Expectation<bool> {
    /// Assert value is true
    pub fn true_(self) -> AssertionResult {
        let passed = if self.negated { !self.actual } else { self.actual };
        AssertionResult::new(
            passed,
            format!(
                "Expected {} {} be true",
                self.actual,
                if self.negated { "to not" } else { "to" }
            ),
            self.message
        )
    }

    /// Assert value is false
    pub fn false_(self) -> AssertionResult {
        let passed = if self.negated { self.actual } else { !self.actual };
        AssertionResult::new(
            passed,
            format!(
                "Expected {} {} be false",
                self.actual,
                if self.negated { "to not" } else { "to" }
            ),
            self.message
        )
    }
}

