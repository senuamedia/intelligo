// =============================================================================
// DATE/TIME MATCHERS
// =============================================================================

/// Matches if date is in the past
pub struct BeInPast;

impl Matcher<DateTime> for BeInPast {
    fn matches(&self, actual: &DateTime) -> bool {
        *actual < DateTime::now()
    }

    fn failure_message(&self, actual: &DateTime) -> String {
        format!("expected {:?} to be in the past", actual)
    }

    fn negated_failure_message(&self, actual: &DateTime) -> String {
        format!("expected {:?} not to be in the past", actual)
    }
}

pub fn be_in_past() -> BeInPast {
    BeInPast
}

/// Matches if date is in the future
pub struct BeInFuture;

impl Matcher<DateTime> for BeInFuture {
    fn matches(&self, actual: &DateTime) -> bool {
        *actual > DateTime::now()
    }

    fn failure_message(&self, actual: &DateTime) -> String {
        format!("expected {:?} to be in the future", actual)
    }

    fn negated_failure_message(&self, actual: &DateTime) -> String {
        format!("expected {:?} not to be in the future", actual)
    }
}

pub fn be_in_future() -> BeInFuture {
    BeInFuture
}

/// Matches if date is within last N days
pub struct BeWithinLastDays {
    days: i64
}

impl Matcher<DateTime> for BeWithinLastDays {
    fn matches(&self, actual: &DateTime) -> bool {
        let cutoff = DateTime::now() - Duration::days(self.days);
        *actual >= cutoff && *actual <= DateTime::now()
    }

    fn failure_message(&self, actual: &DateTime) -> String {
        format!("expected {:?} to be within the last {} days", actual, self.days)
    }

    fn negated_failure_message(&self, actual: &DateTime) -> String {
        format!("expected {:?} not to be within the last {} days", actual, self.days)
    }
}

pub fn be_within_last_days(days: i64) -> BeWithinLastDays {
    BeWithinLastDays { days }
}

// =============================================================================
// CUSTOM MATCHER BUILDER
// =============================================================================

/// Builder for creating custom matchers
pub struct CustomMatcher<T> {
    check_fn: Box<dyn Fn(&T) -> bool>,
    message_fn: Box<dyn Fn(&T) -> String>,
    negated_message_fn: Box<dyn Fn(&T) -> String>
}

impl<T> CustomMatcher<T> {
    pub fn new<F, M, N>(check: F, message: M, negated_message: N) -> CustomMatcher<T>
    where
        F: Fn(&T) -> bool + 'static,
        M: Fn(&T) -> String + 'static,
        N: Fn(&T) -> String + 'static
    {
        CustomMatcher {
            check_fn: Box::new(check),
            message_fn: Box::new(message),
            negated_message_fn: Box::new(negated_message)
        }
    }
}

impl<T> Matcher<T> for CustomMatcher<T> {
    fn matches(&self, actual: &T) -> bool {
        (self.check_fn)(actual)
    }

    fn failure_message(&self, actual: &T) -> String {
        (self.message_fn)(actual)
    }

    fn negated_failure_message(&self, actual: &T) -> String {
        (self.negated_message_fn)(actual)
    }
}

/// Create a simple custom matcher
pub fn custom_matcher<T, F: Fn(&T) -> bool + 'static>(
    description: &str,
    check: F
) -> CustomMatcher<T> {
    let desc = description.to_string();
    let desc2 = description.to_string();
    CustomMatcher::new(
        check,
        move |_| format!("expected to {}", desc),
        move |_| format!("expected not to {}", desc2)
    )
}
