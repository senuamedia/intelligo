/// Common test user data
pub type TestUser {
    id: String,
    email: String,
    first_name: String,
    last_name: String,
    role: String
}

impl TestUser {
    pub fn learner() -> TestUser {
        let n = sequence("user");
        TestUser {
            id: format!("user_{}", n),
            email: format!("learner{}@test.com", n),
            first_name: format!("Test{}", n),
            last_name: "Learner",
            role: "learner".to_string()
        }
    }

    pub fn instructor() -> TestUser {
        let n = sequence("user");
        TestUser {
            id: format!("user_{}", n),
            email: format!("instructor{}@test.com", n),
            first_name: format!("Prof{}", n),
            last_name: "Teacher",
            role: "instructor".to_string()
        }
    }

    pub fn admin() -> TestUser {
        let n = sequence("user");
        TestUser {
            id: format!("user_{}", n),
            email: format!("admin{}@test.com", n),
            first_name: format!("Admin{}", n),
            last_name: "User",
            role: "admin".to_string()
        }
    }
}

/// Common test course data
pub type TestCourse {
    id: String,
    title: String,
    description: String,
    instructor_id: String,
    status: String
}

impl TestCourse {
    pub fn draft() -> TestCourse {
        let n = sequence("course");
        TestCourse {
            id: format!("course_{}", n),
            title: format!("Test Course {}", n),
            description: "A test course for unit testing".to_string(),
            instructor_id: "instructor_1".to_string(),
            status: "draft".to_string()
        }
    }

    pub fn published() -> TestCourse {
        let mut course = TestCourse::draft();
        course.status = "published".to_string();
        course
    }

    pub fn archived() -> TestCourse {
        let mut course = TestCourse::draft();
        course.status = "archived".to_string();
        course
    }
}

