/// Test SCORM package data
pub type TestScormPackage {
    id: String,
    title: String,
    version: String,
    manifest_xml: String
}

impl TestScormPackage {
    pub fn scorm_12() -> TestScormPackage {
        let n = sequence("scorm");
        TestScormPackage {
            id: format!("scorm_{}", n),
            title: format!("SCORM 1.2 Package {}", n),
            version: "1.2".to_string(),
            manifest_xml: r#"<?xml version="1.0"?>
<manifest identifier="test_manifest">
  <organizations default="org1">
    <organization identifier="org1">
      <title>Test Organization</title>
      <item identifier="item1" identifierref="res1">
        <title>Lesson 1</title>
      </item>
    </organization>
  </organizations>
  <resources>
    <resource identifier="res1" type="webcontent" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>"#.to_string()
        }
    }

    pub fn scorm_2004() -> TestScormPackage {
        let n = sequence("scorm");
        TestScormPackage {
            id: format!("scorm_{}", n),
            title: format!("SCORM 2004 Package {}", n),
            version: "2004".to_string(),
            manifest_xml: r#"<?xml version="1.0"?>
<manifest identifier="test_manifest" xmlns:imsss="http://www.imsglobal.org/xsd/imsss">
  <organizations default="org1">
    <organization identifier="org1">
      <title>Test Organization</title>
      <item identifier="item1" identifierref="res1">
        <title>Lesson 1</title>
        <imsss:sequencing>
          <imsss:controlMode choice="true" flow="true"/>
        </imsss:sequencing>
      </item>
    </organization>
  </organizations>
  <resources>
    <resource identifier="res1" type="webcontent" adlcp:scormType="sco" href="index.html">
      <file href="index.html"/>
    </resource>
  </resources>
</manifest>"#.to_string()
        }
    }
}

