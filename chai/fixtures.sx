/// Test xAPI statement data
pub type TestXapiStatement {
    id: String,
    actor_mbox: String,
    verb_id: String,
    object_id: String,
    result_score: Option<f64>,
    result_success: Option<bool>,
    result_completion: Option<bool>
}

impl TestXapiStatement {
    pub fn attempted() -> TestXapiStatement {
        let n = sequence("xapi");
        TestXapiStatement {
            id: format!("statement_{}", n),
            actor_mbox: "mailto:learner@test.com".to_string(),
            verb_id: "http://adlnet.gov/expapi/verbs/attempted".to_string(),
            object_id: format!("http://example.com/activities/lesson_{}", n),
            result_score: None,
            result_success: None,
            result_completion: None
        }
    }

    pub fn completed() -> TestXapiStatement {
        let mut stmt = TestXapiStatement::attempted();
        stmt.verb_id = "http://adlnet.gov/expapi/verbs/completed".to_string();
        stmt.result_completion = Some(true);
        stmt
    }

    pub fn passed() -> TestXapiStatement {
        let mut stmt = TestXapiStatement::completed();
        stmt.verb_id = "http://adlnet.gov/expapi/verbs/passed".to_string();
        stmt.result_success = Some(true);
        stmt.result_score = Some(0.85);
        stmt
    }

    pub fn failed() -> TestXapiStatement {
        let mut stmt = TestXapiStatement::completed();
        stmt.verb_id = "http://adlnet.gov/expapi/verbs/failed".to_string();
        stmt.result_success = Some(false);
        stmt.result_score = Some(0.45);
        stmt
    }
}

// =============================================================================
// DATABASE FIXTURE HELPERS
// =============================================================================

/// Transactional test context
pub type TestContext {
    transaction_id: String,
    fixtures_loaded: List<String>,
    cleanup_fns: List<Box<dyn Fn()>>
}

impl TestContext {
    pub fn new() -> TestContext {
        TestContext {
            transaction_id: format!("tx_{}", sequence("transaction")),
            fixtures_loaded: vec![],
            cleanup_fns: vec![]
        }
    }

    /// Register a cleanup function
    pub fn on_cleanup(&mut self, f: impl Fn() + 'static) {
        self.cleanup_fns.push(Box::new(f));
    }

    /// Run all cleanup functions
    pub fn cleanup(&self) {
        for f in self.cleanup_fns.iter().rev() {
            f();
        }
    }
}

/// Test database seeder
pub type TestSeeder {
    data: Map<String, List<Map<String, Dynamic>>>
}

impl TestSeeder {
    pub fn new() -> TestSeeder {
        TestSeeder {
            data: Map::new()
        }
    }

    /// Add seed data for a table
    pub fn seed(&mut self, table: &str, rows: List<Map<String, Dynamic>>) -> &mut Self {
        self.data.insert(table.to_string(), rows);
        self
    }

    /// Get seed data for a table
    pub fn get(&self, table: &str) -> Option<&List<Map<String, Dynamic>>> {
        self.data.get(table)
    }

    /// Apply seeds (returns SQL for debugging)
    pub fn to_sql(&self) -> List<String> {
        let mut statements = vec![];
        for (table, rows) in &self.data {
            for row in rows {
                let columns: Vec<String> = row.keys().cloned().collect();
                let values: Vec<String> = row.values()
                    .map(|v| format!("'{}'", v))
                    .collect();
                statements.push(format!(
                    "INSERT INTO {} ({}) VALUES ({})",
                    table,
                    columns.join(", "),
                    values.join(", ")
                ));
            }
        }
        statements
    }
}

// =============================================================================
// FIXTURE MACROS
// =============================================================================

/// Create a map from key-value pairs
#[macro]
pub fn test_map(pairs: List<(String, Dynamic)>) -> Map<String, Dynamic> {
    let mut map = Map::new();
    for (key, value) in pairs {
        map.insert(key, value);
    }
    map
}

/// Create a test user map
pub fn user_data(overrides: Map<String, Dynamic>) -> Map<String, Dynamic> {
    let n = sequence("user");
    let mut data = Map::new();
    data.insert("id".to_string(), Box::new(format!("user_{}", n)));
    data.insert("email".to_string(), Box::new(format!("user{}@test.com", n)));
    data.insert("first_name".to_string(), Box::new(format!("User{}", n)));
    data.insert("last_name".to_string(), Box::new("Test".to_string()));
    data.insert("role".to_string(), Box::new("learner".to_string()));

    for (key, value) in overrides {
        data.insert(key, value);
    }
    data
}

/// Create a test course map
pub fn course_data(overrides: Map<String, Dynamic>) -> Map<String, Dynamic> {
    let n = sequence("course");
    let mut data = Map::new();
    data.insert("id".to_string(), Box::new(format!("course_{}", n)));
    data.insert("title".to_string(), Box::new(format!("Course {}", n)));
    data.insert("description".to_string(), Box::new("Test course".to_string()));
    data.insert("status".to_string(), Box::new("draft".to_string()));

    for (key, value) in overrides {
        data.insert(key, value);
    }
    data
}

/// Reset all fixtures and sequences
pub fn reset_fixtures() {
    FixtureRegistry::reset();
}
