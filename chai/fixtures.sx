/// Test enrollment data
pub type TestEnrollment {
    id: String,
    user_id: String,
    course_id: String,
    status: String,
    progress: f64
}

impl TestEnrollment {
    pub fn active() -> TestEnrollment {
        let n = sequence("enrollment");
        TestEnrollment {
            id: format!("enrollment_{}", n),
            user_id: format!("user_{}", n),
            course_id: "course_1".to_string(),
            status: "active".to_string(),
            progress: 0.0
        }
    }

    pub fn completed() -> TestEnrollment {
        let mut enrollment = TestEnrollment::active();
        enrollment.status = "completed".to_string();
        enrollment.progress = 100.0;
        enrollment
    }

    pub fn in_progress(progress: f64) -> TestEnrollment {
        let mut enrollment = TestEnrollment::active();
        enrollment.progress = progress;
        enrollment
    }
}

