/// Intelligo LMS - Test Fixtures
///
/// Provides fixture management and test data factories for testing.

module intelligo::chai::fixtures

use std::collections::{Map, List}
use std::sync::{Arc, Mutex}

// =============================================================================
// FIXTURE REGISTRY
// =============================================================================

/// Global fixture registry
static mut FIXTURE_REGISTRY: Option<FixtureRegistry> = None;

/// Registry for test fixtures
pub type FixtureRegistry {
    fixtures: Map<String, Box<dyn Fn() -> Dynamic + Send + Sync>>,
    instances: Arc<Mutex<Map<String, Dynamic>>>,
    sequences: Arc<Mutex<Map<String, i64>>>
}

impl FixtureRegistry {
    pub fn new() -> FixtureRegistry {
        FixtureRegistry {
            fixtures: Map::new(),
            instances: Arc::new(Mutex::new(Map::new())),
            sequences: Arc::new(Mutex::new(Map::new()))
        }
    }

    pub fn global() -> &'static mut FixtureRegistry {
        unsafe {
            if FIXTURE_REGISTRY.is_none() {
                FIXTURE_REGISTRY = Some(FixtureRegistry::new());
            }
            FIXTURE_REGISTRY.as_mut().unwrap()
        }
    }

    pub fn reset() {
        unsafe {
            FIXTURE_REGISTRY = Some(FixtureRegistry::new());
        }
    }

    /// Register a fixture factory
    pub fn define<T: 'static>(
        &mut self,
        name: &str,
        factory: impl Fn() -> T + Send + Sync + 'static
    ) {
        self.fixtures.insert(
            name.to_string(),
            Box::new(move || Box::new(factory()) as Dynamic)
        );
    }

    /// Get next sequence number
    pub fn next_sequence(&self, name: &str) -> i64 {
        let mut sequences = self.sequences.lock().unwrap();
        let seq = sequences.entry(name.to_string()).or_insert(0);
        *seq += 1;
        *seq
    }

    /// Reset sequences
    pub fn reset_sequences(&self) {
        self.sequences.lock().unwrap().clear();
    }
}

// =============================================================================
// FIXTURE DSL
// =============================================================================

/// Define a fixture
pub fn define_fixture<T: 'static>(
    name: &str,
    factory: impl Fn() -> T + Send + Sync + 'static
) {
    FixtureRegistry::global().define(name, factory);
}

/// Create a fixture instance
pub fn fixture<T: Clone + 'static>(name: &str) -> T {
    let registry = FixtureRegistry::global();
    if let Some(factory) = registry.fixtures.get(name) {
        let value = factory();
        *value.downcast::<T>().unwrap()
    } else {
        panic!("Fixture '{}' not found", name);
    }
}

/// Get next sequence number for a named sequence
pub fn sequence(name: &str) -> i64 {
    FixtureRegistry::global().next_sequence(name)
}

// =============================================================================
// FACTORY BUILDER
// =============================================================================

/// Builder for creating test factories
pub struct Factory<T> {
    base: Box<dyn Fn() -> T + Send + Sync>,
    traits: Map<String, Box<dyn Fn(&mut T) + Send + Sync>>,
    sequences: Map<String, Box<dyn Fn(i64) -> Dynamic + Send + Sync>>
}

impl<T: Clone + 'static> Factory<T> {
    /// Create a new factory
    pub fn new(base: impl Fn() -> T + Send + Sync + 'static) -> Factory<T> {
        Factory {
            base: Box::new(base),
            traits: Map::new(),
            sequences: Map::new()
        }
    }

    /// Add a trait to the factory
    pub fn with_trait(
        mut self,
        name: &str,
        modifier: impl Fn(&mut T) + Send + Sync + 'static
    ) -> Self {
        self.traits.insert(name.to_string(), Box::new(modifier));
        self
    }

    /// Add a sequence to the factory
    pub fn with_sequence<V: 'static>(
        mut self,
        name: &str,
        generator: impl Fn(i64) -> V + Send + Sync + 'static
    ) -> Self {
        self.sequences.insert(
            name.to_string(),
            Box::new(move |n| Box::new(generator(n)) as Dynamic)
        );
        self
    }

    /// Build an instance
    pub fn build(&self) -> T {
        (self.base)()
    }

    /// Build an instance with traits
    pub fn build_with(&self, traits: &[&str]) -> T {
        let mut instance = (self.base)();
        for trait_name in traits {
            if let Some(modifier) = self.traits.get(*trait_name) {
                modifier(&mut instance);
            }
        }
        instance
    }

    /// Build multiple instances
    pub fn build_list(&self, count: usize) -> List<T> {
        (0..count).map(|_| self.build()).collect()
    }
}

