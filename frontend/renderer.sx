// ============================================================================
// Helper Functions
// ============================================================================

fn escape_html(s: &str) -> String {
    s.replace("&", "&amp;")
     .replace("<", "&lt;")
     .replace(">", "&gt;")
     .replace("\"", "&quot;")
     .replace("'", "&#39;")
}

fn escape_json(s: &str) -> String {
    s.replace("'", "\\'")
}

fn generate_component_id(name: &str) -> String {
    format!("{}_{}", name, std::random::random_u32())
}

fn hex_encode(data: &[u8]) -> String {
    data.iter()
        .map(|b| format!("{:02x}", b))
        .collect::<Vec<String>>()
        .join("")
}
