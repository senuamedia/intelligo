/// Intelligo LMS - Frontend API Client
///
/// Lightweight API client for fetching data from the LMS API.
/// Supports caching, authentication, and error handling.

module intelligo::frontend::api_client

use intelligo::frontend::*
use intelligo::core::*

// ============================================================================
// API Client
// ============================================================================

/// Frontend API client for communicating with the LMS backend
pub actor ApiClient {
    config: ApiClientConfig,
    cache: ApiCache,
    auth_token: Option<String>,
    refresh_token: Option<String>,

    pub fn new(config: ApiClientConfig) -> Self {
        ApiClient {
            config,
            cache: ApiCache::new(),
            auth_token: None,
            refresh_token: None,
        }
    }

    // ========================================================================
    // Authentication
    // ========================================================================

    /// Set authentication tokens
    pub fn set_tokens(mut self, auth_token: String, refresh_token: Option<String>) {
        self.auth_token = Some(auth_token);
        self.refresh_token = refresh_token;
    }

    /// Clear authentication
    pub fn clear_auth(mut self) {
        self.auth_token = None;
        self.refresh_token = None;
    }

    /// Check if authenticated
    pub fn is_authenticated(self) -> bool {
        self.auth_token.is_some()
    }

    /// Login with email and password
    pub async fn login(mut self, email: &str, password: &str) -> Result<AuthResponse, FrontendError> {
        let response = self.post("/auth/login", &LoginRequest {
            email: email.to_string(),
            password: password.to_string(),
        }).await?;

        let auth: AuthResponse = serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })?;

        self.set_tokens(auth.access_token.clone(), auth.refresh_token.clone());

        Ok(auth)
    }

    /// Logout
    pub async fn logout(mut self) -> Result<(), FrontendError> {
        if let Some(token) = &self.auth_token {
            let _ = self.post::<(), ()>("/auth/logout", &()).await;
        }
        self.clear_auth();
        self.cache.clear();
        Ok(())
    }

    /// Refresh access token
    pub async fn refresh_auth(mut self) -> Result<AuthResponse, FrontendError> {
        let refresh_token = self.refresh_token.clone().ok_or(
            FrontendError::AuthError { message: "No refresh token".to_string() }
        )?;

        let response = self.post("/auth/refresh", &RefreshRequest {
            refresh_token,
        }).await?;

        let auth: AuthResponse = serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })?;

        self.set_tokens(auth.access_token.clone(), auth.refresh_token.clone());

        Ok(auth)
    }

    // ========================================================================
    // User API
    // ========================================================================

    /// Get current user profile
    pub async fn get_profile(self) -> Result<UserProfile, FrontendError> {
        self.get_cached("/user/profile", Duration::minutes(5)).await
    }

    /// Update user profile
    pub async fn update_profile(mut self, profile: &UpdateProfileRequest) -> Result<UserProfile, FrontendError> {
        let response = self.patch("/user/profile", profile).await?;
        self.cache.invalidate("/user/profile");
        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    /// Get user preferences
    pub async fn get_preferences(self) -> Result<UserPreferences, FrontendError> {
        self.get_cached("/user/preferences", Duration::minutes(15)).await
    }

    // ========================================================================
    // Course API
    // ========================================================================

    /// List courses
    pub async fn list_courses(self, params: &CourseListParams) -> Result<PaginatedResponse<Course>, FrontendError> {
        let query = self.build_query_string(params);
        self.get_cached(&format!("/courses?{}", query), Duration::minutes(5)).await
    }

    /// Get course by ID
    pub async fn get_course(self, course_id: &str) -> Result<Course, FrontendError> {
        self.get_cached(&format!("/courses/{}", course_id), Duration::minutes(10)).await
    }

    /// Get course modules
    pub async fn get_course_modules(self, course_id: &str) -> Result<Vec<Module>, FrontendError> {
        self.get_cached(&format!("/courses/{}/modules", course_id), Duration::minutes(10)).await
    }

    /// Get lesson by ID
    pub async fn get_lesson(self, course_id: &str, lesson_id: &str) -> Result<Lesson, FrontendError> {
        self.get_cached(&format!("/courses/{}/lessons/{}", course_id, lesson_id), Duration::minutes(10)).await
    }

    // ========================================================================
    // Enrollment API
    // ========================================================================

    /// Get user enrollments
    pub async fn get_enrollments(self) -> Result<Vec<Enrollment>, FrontendError> {
        self.get_cached("/enrollments", Duration::minutes(5)).await
    }

    /// Enroll in course
    pub async fn enroll(mut self, course_id: &str) -> Result<Enrollment, FrontendError> {
        let response = self.post(&format!("/courses/{}/enroll", course_id), &()).await?;
        self.cache.invalidate("/enrollments");
        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    // ========================================================================
    // Progress API
    // ========================================================================

    /// Get course progress
    pub async fn get_progress(self, course_id: &str) -> Result<CourseProgress, FrontendError> {
        self.get_cached(&format!("/progress/{}", course_id), Duration::minutes(1)).await
    }

    /// Mark lesson complete
    pub async fn complete_lesson(mut self, course_id: &str, lesson_id: &str) -> Result<LessonProgress, FrontendError> {
        let response = self.post(&format!("/progress/{}/lessons/{}/complete", course_id, lesson_id), &()).await?;
        self.cache.invalidate(&format!("/progress/{}", course_id));
        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    /// Track video progress
    pub async fn track_video(self, lesson_id: &str, position: f64, duration: f64) -> Result<(), FrontendError> {
        self.post(&format!("/progress/video/{}", lesson_id), &VideoProgress {
            position,
            duration,
        }).await?;
        Ok(())
    }

    // ========================================================================
    // Assessment API
    // ========================================================================

    /// Get assessment
    pub async fn get_assessment(self, assessment_id: &str) -> Result<Assessment, FrontendError> {
        self.get_cached(&format!("/assessments/{}", assessment_id), Duration::minutes(5)).await
    }

    /// Start assessment attempt
    pub async fn start_assessment(self, assessment_id: &str) -> Result<AssessmentAttempt, FrontendError> {
        let response = self.post(&format!("/assessments/{}/start", assessment_id), &()).await?;
        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    /// Submit assessment answers
    pub async fn submit_assessment(self, attempt_id: &str, answers: &Vec<Answer>) -> Result<AssessmentResult, FrontendError> {
        let response = self.post(&format!("/assessments/attempts/{}/submit", attempt_id), answers).await?;
        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    // ========================================================================
    // Notification API
    // ========================================================================

    /// Get notifications
    pub async fn get_notifications(self) -> Result<Vec<Notification>, FrontendError> {
        self.get("/notifications").await
    }

    /// Get unread notification count
    pub async fn get_notification_count(self) -> Result<NotificationCount, FrontendError> {
        self.get_cached("/notifications/count", Duration::seconds(30)).await
    }

    /// Mark notification as read
    pub async fn mark_notification_read(mut self, notification_id: &str) -> Result<(), FrontendError> {
        self.post(&format!("/notifications/{}/read", notification_id), &()).await?;
        self.cache.invalidate("/notifications/count");
        Ok(())
    }

    // ========================================================================
    // Search API
    // ========================================================================

    /// Search courses
    pub async fn search(self, query: &str, filters: Option<&SearchFilters>) -> Result<SearchResults, FrontendError> {
        let mut params = vec![format!("q={}", urlencoding::encode(query))];
        if let Some(f) = filters {
            if let Some(ref category) = f.category {
                params.push(format!("category={}", category));
            }
            if let Some(ref level) = f.level {
                params.push(format!("level={}", level));
            }
        }
        self.get(&format!("/search?{}", params.join("&"))).await
    }

    /// Get search suggestions
    pub async fn get_suggestions(self, query: &str) -> Result<Vec<String>, FrontendError> {
        self.get_cached(&format!("/search/suggest?q={}", urlencoding::encode(query)), Duration::minutes(5)).await
    }

    // ========================================================================
    // Dashboard API
    // ========================================================================

    /// Get student dashboard data
    pub async fn get_student_dashboard(self) -> Result<StudentDashboard, FrontendError> {
        self.get_cached("/dashboard/student", Duration::minutes(2)).await
    }

    /// Get teacher dashboard data
    pub async fn get_teacher_dashboard(self) -> Result<TeacherDashboard, FrontendError> {
        self.get_cached("/dashboard/teacher", Duration::minutes(2)).await
    }

    /// Get admin dashboard data
    pub async fn get_admin_dashboard(self) -> Result<AdminDashboard, FrontendError> {
        self.get_cached("/dashboard/admin", Duration::minutes(1)).await
    }

    // ========================================================================
    // HTTP Methods
    // ========================================================================

    async fn get<T: DeserializeOwned>(self, path: &str) -> Result<T, FrontendError> {
        let response = self.request(HttpMethod::Get, path, None).await?;
        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    async fn get_cached<T: DeserializeOwned + Clone>(self, path: &str, ttl: Duration) -> Result<T, FrontendError> {
        // Check cache first
        if let Some(cached) = self.cache.get::<T>(path) {
            return Ok(cached);
        }

        // Fetch from API
        let result: T = self.get(path).await?;

        // Cache the result
        self.cache.set(path, &result, ttl);

        Ok(result)
    }

    async fn post<T: Serialize, R: DeserializeOwned>(self, path: &str, body: &T) -> Result<R, FrontendError> {
        let body_json = serde_json::to_value(body)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })?;

        let response = self.request(HttpMethod::Post, path, Some(body_json)).await?;

        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    async fn patch<T: Serialize, R: DeserializeOwned>(self, path: &str, body: &T) -> Result<R, FrontendError> {
        let body_json = serde_json::to_value(body)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })?;

        let response = self.request(HttpMethod::Patch, path, Some(body_json)).await?;

        serde_json::from_value(response)
            .map_err(|e| FrontendError::ApiError { status: 0, message: e.to_string() })
    }

    async fn delete(self, path: &str) -> Result<(), FrontendError> {
        self.request(HttpMethod::Delete, path, None).await?;
        Ok(())
    }

    async fn request(self, method: HttpMethod, path: &str, body: Option<Value>) -> Result<Value, FrontendError> {
        let url = format!("{}{}", self.config.base_url, path);

        let mut headers = Map::new();
        headers.insert("Content-Type".to_string(), "application/json".to_string());
        headers.insert("Accept".to_string(), "application/json".to_string());

        // Add auth header if authenticated
        if let Some(ref token) = self.auth_token {
            headers.insert("Authorization".to_string(), format!("Bearer {}", token));
        }

        // Add tenant header
        if let Some(ref tenant) = self.config.tenant_id {
            headers.insert("X-Tenant-ID".to_string(), tenant.clone());
        }

        // Make request
        let response = http::request(HttpRequest {
            method,
            url,
            headers,
            body,
            timeout: self.config.timeout,
        }).await.map_err(|e| FrontendError::ApiError {
            status: 0,
            message: format!("Network error: {}", e)
        })?;

        // Handle errors
        if response.status >= 400 {
            // Try to refresh token on 401
            if response.status == 401 && self.refresh_token.is_some() {
                // Token refresh would happen here
            }

            let message = response.body.get("message")
                .and_then(|m| m.as_str())
                .unwrap_or("Unknown error")
                .to_string();

            return Err(FrontendError::ApiError {
                status: response.status,
                message,
            });
        }

        Ok(response.body)
    }

    fn build_query_string<T: Serialize>(self, params: &T) -> String {
        // Serialize params to query string
        serde_urlencoded::to_string(params).unwrap_or_default()
    }
}

// ============================================================================
// API Client Configuration
// ============================================================================

pub type ApiClientConfig = type {
    base_url: String,
    tenant_id: Option<String>,
    timeout: Duration,
    retry_count: i32,
    cache_enabled: bool,
}

impl ApiClientConfig {
    pub fn default() -> Self {
        ApiClientConfig {
            base_url: "/api/v1".to_string(),
            tenant_id: None,
            timeout: Duration::seconds(30),
            retry_count: 3,
            cache_enabled: true,
        }
    }

    pub fn with_base_url(mut self, url: &str) -> Self {
        self.base_url = url.to_string();
        self
    }

    pub fn with_tenant(mut self, tenant_id: &str) -> Self {
        self.tenant_id = Some(tenant_id.to_string());
        self
    }
}

// ============================================================================
// API Cache
// ============================================================================

/// Simple in-memory cache for API responses
pub actor ApiCache {
    entries: Map<String, CacheEntry>,
    max_size: usize,

    pub fn new() -> Self {
        ApiCache {
            entries: Map::new(),
            max_size: 100,
        }
    }

    pub fn get<T: Clone>(self, key: &str) -> Option<T> {
        if let Some(entry) = self.entries.get(key) {
            if entry.expires_at > Instant::now() {
                // Would need proper type handling
                return None; // Simplified for now
            }
        }
        None
    }

    pub fn set<T: Clone>(mut self, key: &str, value: &T, ttl: Duration) {
        if self.entries.len() >= self.max_size {
            self.evict_oldest();
        }

        self.entries.insert(key.to_string(), CacheEntry {
            key: key.to_string(),
            value: Value::Null, // Simplified
            expires_at: Instant::now() + ttl,
            created_at: Instant::now(),
        });
    }

    pub fn invalidate(mut self, key: &str) {
        self.entries.remove(key);
    }

    pub fn invalidate_prefix(mut self, prefix: &str) {
        let keys: Vec<String> = self.entries.keys()
            .filter(|k| k.starts_with(prefix))
            .cloned()
            .collect();

        for key in keys {
            self.entries.remove(&key);
        }
    }

    pub fn clear(mut self) {
        self.entries.clear();
    }

    fn evict_oldest(mut self) {
        if let Some((oldest_key, _)) = self.entries.iter()
            .min_by_key(|(_, e)| e.created_at) {
            self.entries.remove(&oldest_key.clone());
        }
    }
}

type CacheEntry = type {
    key: String,
    value: Value,
    expires_at: Instant,
    created_at: Instant,
}

// ============================================================================
// HTTP Types
// ============================================================================

pub enum HttpMethod {
    Get,
    Post,
    Put,
    Patch,
    Delete,
}

pub type HttpRequest = type {
    method: HttpMethod,
    url: String,
    headers: Map<String, String>,
    body: Option<Value>,
    timeout: Duration,
}

pub type HttpResponse = type {
    status: i32,
    headers: Map<String, String>,
    body: Value,
}

