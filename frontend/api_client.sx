// ============================================================================
// Request/Response Types
// ============================================================================

pub type LoginRequest = type {
    email: String,
    password: String,
}

pub type RefreshRequest = type {
    refresh_token: String,
}

pub type AuthResponse = type {
    access_token: String,
    refresh_token: Option<String>,
    expires_in: i64,
    user: UserProfile,
}

pub type UserProfile = type {
    id: String,
    email: String,
    display_name: String,
    avatar_url: Option<String>,
    role: String,
    created_at: DateTime,
}

pub type UpdateProfileRequest = type {
    display_name: Option<String>,
    avatar_url: Option<String>,
    bio: Option<String>,
}

pub type CourseListParams = type {
    page: Option<i32>,
    limit: Option<i32>,
    category: Option<String>,
    level: Option<String>,
    sort: Option<String>,
}

pub type PaginatedResponse<T> = type {
    items: Vec<T>,
    total: i64,
    page: i32,
    per_page: i32,
    total_pages: i32,
}

pub type Course = type {
    id: String,
    title: String,
    description: String,
    thumbnail_url: Option<String>,
    instructor_name: String,
    duration_minutes: i32,
    level: String,
    category: String,
    rating: f64,
    enrollment_count: i32,
}

pub type Module = type {
    id: String,
    title: String,
    description: String,
    order: i32,
    lessons: Vec<LessonSummary>,
}

pub type LessonSummary = type {
    id: String,
    title: String,
    duration_minutes: i32,
    content_type: String,
}

pub type Lesson = type {
    id: String,
    title: String,
    content: String,
    video_url: Option<String>,
    attachments: Vec<Attachment>,
    duration_minutes: i32,
    next_lesson_id: Option<String>,
    prev_lesson_id: Option<String>,
}

pub type Attachment = type {
    id: String,
    name: String,
    url: String,
    size_bytes: i64,
}

pub type Enrollment = type {
    id: String,
    course: Course,
    enrolled_at: DateTime,
    progress: f64,
    status: String,
}

pub type CourseProgress = type {
    course_id: String,
    total_lessons: i32,
    completed_lessons: i32,
    percentage: f64,
    last_accessed: Option<DateTime>,
}

pub type LessonProgress = type {
    lesson_id: String,
    completed: bool,
    completed_at: Option<DateTime>,
    time_spent_seconds: i64,
}

pub type VideoProgress = type {
    position: f64,
    duration: f64,
}

pub type Assessment = type {
    id: String,
    title: String,
    description: String,
    time_limit_minutes: Option<i32>,
    passing_score: f64,
    questions: Vec<Question>,
}

pub type Question = type {
    id: String,
    question_type: String,
    text: String,
    options: Option<Vec<QuestionOption>>,
    points: f64,
}

pub type QuestionOption = type {
    id: String,
    text: String,
}

pub type AssessmentAttempt = type {
    id: String,
    assessment_id: String,
    started_at: DateTime,
    expires_at: Option<DateTime>,
}

pub type Answer = type {
    question_id: String,
    answer: Value,
}

pub type AssessmentResult = type {
    attempt_id: String,
    score: f64,
    passed: bool,
    feedback: Vec<QuestionFeedback>,
}

pub type QuestionFeedback = type {
    question_id: String,
    correct: bool,
    points_earned: f64,
    explanation: Option<String>,
}

pub type Notification = type {
    id: String,
    title: String,
    body: String,
    notification_type: String,
    read: bool,
    created_at: DateTime,
    action_url: Option<String>,
}

pub type NotificationCount = type {
    unread: i32,
    total: i32,
}

pub type SearchFilters = type {
    category: Option<String>,
    level: Option<String>,
    duration_min: Option<i32>,
    duration_max: Option<i32>,
    rating_min: Option<f64>,
}

pub type SearchResults = type {
    query: String,
    total: i64,
    items: Vec<SearchResult>,
    facets: Map<String, Vec<Facet>>,
}

pub type SearchResult = type {
    id: String,
    title: String,
    description: String,
    result_type: String,
    url: String,
    highlights: Vec<String>,
}

pub type Facet = type {
    value: String,
    count: i64,
}

pub type StudentDashboard = type {
    enrollments: Vec<Enrollment>,
    recent_activity: Vec<Activity>,
    upcoming_deadlines: Vec<Deadline>,
    achievements: Vec<Achievement>,
    recommendations: Vec<Course>,
}

pub type TeacherDashboard = type {
    courses: Vec<TeacherCourse>,
    pending_reviews: Vec<PendingReview>,
    student_alerts: Vec<StudentAlert>,
    recent_submissions: Vec<Submission>,
}

pub type AdminDashboard = type {
    stats: AdminStats,
    recent_users: Vec<RecentUser>,
    system_alerts: Vec<SystemAlert>,
    usage_chart: Vec<UsageDataPoint>,
}

// Supporting types
pub type Activity = type { id: String, description: String, timestamp: DateTime }
pub type Deadline = type { id: String, title: String, due_date: DateTime, course_id: String }
pub type Achievement = type { id: String, title: String, description: String, earned_at: DateTime }
pub type TeacherCourse = type { id: String, title: String, student_count: i32, pending_submissions: i32 }
pub type PendingReview = type { id: String, student_name: String, assignment_title: String, submitted_at: DateTime }
pub type StudentAlert = type { id: String, student_name: String, alert_type: String, message: String }
pub type Submission = type { id: String, student_name: String, assignment_title: String, grade: Option<f64> }
pub type AdminStats = type { total_users: i64, active_users: i64, total_courses: i64, total_enrollments: i64 }
pub type RecentUser = type { id: String, name: String, email: String, registered_at: DateTime }
pub type SystemAlert = type { id: String, severity: String, message: String, timestamp: DateTime }
pub type UsageDataPoint = type { date: String, active_users: i64, page_views: i64 }
