/// Virus scanner
pub type VirusScanner = type {
    enabled: bool
}

impl VirusScanner {
    pub fn new() -> Self { VirusScanner { enabled: false } }

    pub fn scan(self, path: &str) -> Result<ScanResult, FileError> {
        // Virus scanning requires ClamAV or similar integration
        if !self.enabled {
            // Return clean result when scanning is disabled
            return Ok(ScanResult { is_infected: false, threat_name: None });
        }
        Err(FileError::ProcessingError { message: "Virus scanning not yet implemented - requires ClamAV integration".to_string() })
    }

    pub fn scan_bytes(self, data: &[u8]) -> Result<ScanResult, FileError> {
        if !self.enabled {
            return Ok(ScanResult { is_infected: false, threat_name: None });
        }
        Err(FileError::ProcessingError { message: "Virus scanning not yet implemented - requires ClamAV integration".to_string() })
    }
}

pub type ScanResult = type {
    is_infected: bool,
    threat_name: Option<String>
}

/// Image processor
pub type ImageProcessor = type {
    max_size: i32
}

impl ImageProcessor {
    pub fn new() -> Self { ImageProcessor { max_size: 4096 } }

    pub fn resize(self, data: &[u8], max_width: i32, max_height: i32) -> Result<ProcessedImage, FileError> {
        // Image processing requires image library integration
        Err(FileError::ProcessingError { message: "Image processing not yet implemented - requires image library integration".to_string() })
    }

    pub fn crop(self, data: &[u8], x: i32, y: i32, width: i32, height: i32) -> Result<ProcessedImage, FileError> {
        Err(FileError::ProcessingError { message: "Image processing not yet implemented - requires image library integration".to_string() })
    }

    pub fn rotate(self, data: &[u8], degrees: i32) -> Result<ProcessedImage, FileError> {
        Err(FileError::ProcessingError { message: "Image processing not yet implemented - requires image library integration".to_string() })
    }
}

pub type ProcessedImage = type {
    data: Vec<u8>,
    width: i32,
    height: i32
}

/// File metadata store trait
pub trait FileMetadataStore {
    fn save_session(self, session: &UploadSession) -> Result<(), FileError>;
    fn get_session(self, id: &str) -> Result<UploadSession, FileError>;
    fn update_session_status(self, id: &str, status: UploadStatus) -> Result<(), FileError>;

    fn save_file(self, file: &FileMetadata) -> Result<(), FileError>;
    fn get_file(self, id: &str) -> Result<FileMetadata, FileError>;
    fn list_files(self, tenant_id: &str, query: &FileQuery) -> Result<PagedResult<FileMetadata>, FileError>;
    fn delete_file(self, id: &str) -> Result<(), FileError>;
    fn soft_delete_file(self, id: &str) -> Result<(), FileError>;
    fn increment_download_count(self, id: &str) -> Result<(), FileError>;

    fn save_folder(self, folder: &Folder) -> Result<(), FileError>;
    fn get_folder(self, id: &str) -> Result<Folder, FileError>;
    fn list_folders(self, tenant_id: &str, parent_id: Option<String>) -> Result<Vec<Folder>, FileError>;
    fn delete_folder(self, id: &str) -> Result<(), FileError>;

    fn get_usage(self, tenant_id: &str) -> Result<StorageUsage, FileError>;
    fn update_usage(self, tenant_id: &str, delta: i64) -> Result<(), FileError>;
}

/// In-memory file metadata store (for testing/development)
pub actor InMemoryFileStore {
    sessions: HashMap<String, UploadSession>,
    files: HashMap<String, FileMetadata>,
    folders: HashMap<String, Folder>,
    usage: HashMap<String, StorageUsage>,

    pub fn new() -> Self {
        InMemoryFileStore {
            sessions: HashMap::new(),
            files: HashMap::new(),
            folders: HashMap::new(),
            usage: HashMap::new(),
        }
    }
}

impl FileMetadataStore for InMemoryFileStore {
    fn save_session(mut self, session: &UploadSession) -> Result<(), FileError> {
        self.sessions.insert(session.id.clone(), session.clone());
        Ok(())
    }

    fn get_session(self, id: &str) -> Result<UploadSession, FileError> {
        self.sessions.get(id).cloned().ok_or(FileError::NotFound { id: id.to_string() })
    }

    fn update_session_status(mut self, id: &str, status: UploadStatus) -> Result<(), FileError> {
        match self.sessions.get_mut(id) {
            Some(session) => {
                session.status = status;
                Ok(())
            },
            None => Err(FileError::NotFound { id: id.to_string() })
        }
    }

    fn save_file(mut self, file: &FileMetadata) -> Result<(), FileError> {
        self.files.insert(file.id.clone(), file.clone());
        Ok(())
    }

    fn get_file(self, id: &str) -> Result<FileMetadata, FileError> {
        self.files.get(id).cloned().ok_or(FileError::NotFound { id: id.to_string() })
    }

    fn list_files(self, tenant_id: &str, query: &FileQuery) -> Result<PagedResult<FileMetadata>, FileError> {
        let files: Vec<FileMetadata> = self.files.values()
            .filter(|f| f.tenant_id == tenant_id && f.deleted_at.is_none())
            .cloned()
            .collect();

        Ok(PagedResult {
            items: files.clone(),
            total: files.len() as i64,
            page: 1,
            page_size: files.len() as i32,
            has_more: false,
        })
    }

    fn delete_file(mut self, id: &str) -> Result<(), FileError> {
        self.files.remove(id);
        Ok(())
    }

    fn soft_delete_file(mut self, id: &str) -> Result<(), FileError> {
        match self.files.get_mut(id) {
            Some(file) => {
                file.deleted_at = Some(DateTime::now());
                Ok(())
            },
            None => Err(FileError::NotFound { id: id.to_string() })
        }
    }

    fn increment_download_count(mut self, id: &str) -> Result<(), FileError> {
        match self.files.get_mut(id) {
            Some(file) => {
                file.download_count += 1;
                Ok(())
            },
            None => Err(FileError::NotFound { id: id.to_string() })
        }
    }

    fn save_folder(mut self, folder: &Folder) -> Result<(), FileError> {
        self.folders.insert(folder.id.clone(), folder.clone());
        Ok(())
    }

    fn get_folder(self, id: &str) -> Result<Folder, FileError> {
        self.folders.get(id).cloned().ok_or(FileError::NotFound { id: id.to_string() })
    }

    fn list_folders(self, tenant_id: &str, parent_id: Option<String>) -> Result<Vec<Folder>, FileError> {
        let folders: Vec<Folder> = self.folders.values()
            .filter(|f| f.tenant_id == tenant_id && f.parent_id == parent_id)
            .cloned()
            .collect();
        Ok(folders)
    }

    fn delete_folder(mut self, id: &str) -> Result<(), FileError> {
        self.folders.remove(id);
        Ok(())
    }

    fn get_usage(self, tenant_id: &str) -> Result<StorageUsage, FileError> {
        Ok(self.usage.get(tenant_id).cloned().unwrap_or(StorageUsage {
            tenant_id: tenant_id.to_string(),
            used_bytes: 0,
            quota_bytes: 10737418240, // 10GB default
            file_count: 0,
        }))
    }

    fn update_usage(mut self, tenant_id: &str, delta: i64) -> Result<(), FileError> {
        let usage = self.usage.entry(tenant_id.to_string()).or_insert(StorageUsage {
            tenant_id: tenant_id.to_string(),
            used_bytes: 0,
            quota_bytes: 10737418240,
            file_count: 0,
        });
        usage.used_bytes = (usage.used_bytes as i64 + delta).max(0) as i64;
        Ok(())
    }
}

// ============================================================================
// Types
// ============================================================================

/// File metadata
pub type FileMetadata = type {
    id: String,
    tenant_id: String,
    filename: String,
    original_filename: String,
    content_type: String,
    size: i64,
    storage_path: String,
    folder_id: Option<String>,
    variants: Vec<FileVariant>,
    checksum: String,
    metadata: Map<String, String>,
    access_control: AccessControl,
    download_count: i64,
    created_at: DateTime,
    updated_at: DateTime,
    created_by: Option<String>,
    deleted_at: Option<DateTime>
}

/// File variant (for images)
pub type FileVariant = type {
    name: String,
    storage_path: String,
    width: i32,
    height: i32,
    size: i64
}

/// Access control
pub type AccessControl = type {
    public: bool,
    allowed_users: Vec<String>,
    allowed_groups: Vec<String>,
    expires_at: Option<DateTime>
}

impl Default for AccessControl {
    fn default() -> Self {
        AccessControl {
            public: false,
            allowed_users: vec![],
            allowed_groups: vec![],
            expires_at: None
        }
    }
}

/// Folder
pub type Folder = type {
    id: String,
    tenant_id: String,
    name: String,
    parent_id: Option<String>,
    path: String,
    metadata: Map<String, String>,
    created_at: DateTime,
    updated_at: DateTime,
    created_by: Option<String>
}

/// Upload session
pub type UploadSession = type {
    id: String,
    tenant_id: String,
    filename: String,
    content_type: String,
    size: i64,
    folder_id: Option<String>,
    upload_url: String,
    expires_at: DateTime,
    status: UploadStatus,
    created_at: DateTime
}

pub enum UploadStatus {
    Pending,
    Uploading,
    Completed,
    Failed,
    Expired
}

/// Request/Response types
pub type InitiateUploadRequest = type {
    filename: String,
    content_type: String,
    size: i64,
    folder_id: Option<String>
}

pub type UploadRequest = type {
    filename: String,
    content_type: String,
    data: Vec<u8>,
    folder_id: Option<String>,
    metadata: Option<Map<String, String>>,
    uploaded_by: Option<String>
}

pub type UpdateFileRequest = type {
    filename: Option<String>,
    folder_id: Option<String>,
    metadata: Option<Map<String, String>>,
    access_control: Option<AccessControl>
}

pub type DownloadOptions = type {
    user_id: Option<String>,
    expires_in: Option<Duration>
}

pub type FileContent = type {
    data: Vec<u8>,
    content_type: String,
    filename: String
}

pub type CreateFolderRequest = type {
    name: String,
    parent_id: Option<String>,
    metadata: Option<Map<String, String>>,
    created_by: Option<String>
}

pub type UpdateFolderRequest = type {
    name: Option<String>,
    parent_id: Option<String>,
    metadata: Option<Map<String, String>>
}

pub type FileQuery = type {
    folder_id: Option<String>,
    content_type: Option<String>,
    search: Option<String>,
    created_after: Option<DateTime>,
    created_before: Option<DateTime>,
    page: Option<i32>,
    page_size: Option<i32>
}

impl Default for FileQuery {
    fn default() -> Self {
        FileQuery {
            folder_id: None,
            content_type: None,
            search: None,
            created_after: None,
            created_before: None,
            page: Some(1),
            page_size: Some(20)
        }
    }
}

pub type PagedResult<T> = type {
    items: Vec<T>,
    total: i64,
    page: i32,
    page_size: i32
}

/// Storage usage
pub type StorageUsage = type {
    used_bytes: i64,
    file_count: i64,
    by_type: Map<String, i64>
}

/// Storage quota
pub type StorageQuota = type {
    max_bytes: i64,
    max_files: Option<i64>,
    max_file_size: Option<i64>
}

pub type SignedUrlOptions = type {
    content_disposition: Option<String>
}

impl Default for SignedUrlOptions {
    fn default() -> Self {
        SignedUrlOptions { content_disposition: None }
    }
}

pub enum AccessType {
    Read,
    Write,
    Delete
}

/// Configuration
pub type FileServiceConfig = type {
    storage_provider: StorageProviderType,
    allowed_types: Option<Vec<String>>,
    denied_types: Option<Vec<String>>,
    max_file_size: i64,
    enable_virus_scanning: bool,
    generate_image_variants: bool
}

pub enum StorageProviderType {
    Local(LocalStorageConfig),
    S3(S3StorageConfig),
    Azure(AzureStorageConfig),
    GCS(GCSStorageConfig)
}

pub type LocalStorageConfig = type { base_path: String }
pub type S3StorageConfig = type { bucket: String, region: String, access_key: String, secret_key: String }
pub type AzureStorageConfig = type { account: String, container: String, access_key: String }
pub type GCSStorageConfig = type { bucket: String, credentials_path: String }

/// File error
pub enum FileError {
    FileNotFound(String),
    FolderNotFound(String),
    VariantNotFound(String),
    FolderNotEmpty(String),
    InvalidFileType(String),
    InvalidState(String),
    QuotaExceeded,
    AccessDenied,
    VirusDetected(String),
    StorageError(String),
    ProcessingError(String)
}

impl FileError {
    pub fn to_string(self) -> String {
        match self {
            FileError::FileNotFound(m) => format!("File not found: {}", m),
            FileError::FolderNotFound(m) => format!("Folder not found: {}", m),
            FileError::VariantNotFound(m) => format!("Variant not found: {}", m),
            FileError::FolderNotEmpty(m) => format!("Folder not empty: {}", m),
            FileError::InvalidFileType(m) => format!("Invalid file type: {}", m),
            FileError::InvalidState(m) => m,
            FileError::QuotaExceeded => "Storage quota exceeded".to_string(),
            FileError::AccessDenied => "Access denied".to_string(),
            FileError::VirusDetected(m) => format!("Virus detected: {}", m),
            FileError::StorageError(m) => format!("Storage error: {}", m),
            FileError::ProcessingError(m) => format!("Processing error: {}", m)
        }
    }
}

// Crypto utilities
fn sha256(data: &[u8]) -> Vec<u8> {
    // SHA-256 implementation using std::crypto
    std::crypto::sha256(data)
}

mod hex {
    pub fn encode(data: Vec<u8>) -> String {
        data.iter()
            .map(|b| format!("{:02x}", b))
            .collect::<Vec<String>>()
            .join("")
    }
}
