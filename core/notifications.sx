/// Notification error
pub enum NotificationError {
    ChannelNotFound(String),
    ChannelNotConfigured(String),
    InvalidMessage(String),
    MissingRecipient(String),
    DeliveryFailed(String),
    PreferencesError(String)
}

impl NotificationError {
    pub fn to_string(self) -> String {
        match self {
            NotificationError::ChannelNotFound(c) => format!("Channel not found: {}", c),
            NotificationError::ChannelNotConfigured(c) => format!("Channel not configured: {}", c),
            NotificationError::InvalidMessage(m) => m,
            NotificationError::MissingRecipient(m) => m,
            NotificationError::DeliveryFailed(m) => format!("Delivery failed: {}", m),
            NotificationError::PreferencesError(m) => m
        }
    }
}
