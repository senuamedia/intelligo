    host: String,
    port: i32,
    username: Option<String>,
    password: Option<String>,
    from_address: String,
    from_name: String
}

impl Default for SmtpConfig {
    fn default() -> Self {
        SmtpConfig {
            host: "localhost".to_string(),
            port: 587,
            username: None,
            password: None,
            from_address: "noreply@example.com".to_string(),
            from_name: "Intelligo LMS".to_string()
        }
    }
}

