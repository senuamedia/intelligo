// ============================================================================
// Text Analyzer
// ============================================================================

/// Text analyzer for search indexing
pub type TextAnalyzer = type {}

impl TextAnalyzer {
    pub fn new() -> Self { TextAnalyzer {} }

    pub fn analyze(self, text: &str) -> String {
        text.to_lowercase()
            .chars()
            .filter(|c| c.is_alphanumeric() || c.is_whitespace())
            .collect()
    }
}

// ============================================================================
// Types
// ============================================================================

/// Search query
pub type SearchQuery = type {
    query: String,
    entity_types: Option<Vec<String>>,
    filters: Option<Vec<SearchFilter>>,
    facets: Option<Vec<String>>,
    sort: Option<Vec<SortField>>,
    page: Option<i32>,
    page_size: Option<i32>,
    highlight: Option<bool>
}

/// Search filter
pub type SearchFilter = type {
    field: String,
    operator: FilterOperator,
    value: Value
}

pub enum FilterOperator {
    Equals,
    NotEquals,
    GreaterThan,
    LessThan,
    GreaterThanOrEqual,
    LessThanOrEqual,
    In,
    NotIn,
    Contains,
    StartsWith,
    Range
}

/// Sort field
pub type SortField = type {
    field: String,
    order: SortOrder
}

pub enum SortOrder {
    Ascending,
    Descending
}

/// Parsed query
pub type ParsedQuery = type {
    terms: Vec<String>,
    phrases: Vec<String>,
    required: Vec<String>,
    excluded: Vec<String>,
    field_queries: Vec<FieldQuery>
}

pub type FieldQuery = type {
    field: String,
    value: String
}

pub enum TermModifier {
    Optional,
    Required,
    Excluded
}

/// Search request
pub type SearchRequest = type {
    tenant_id: String,
    query: ParsedQuery,
    entity_types: Option<Vec<String>>,
    filters: Option<Vec<SearchFilter>>,
    facets: Option<Vec<String>>,
    sort: Option<Vec<SortField>>,
    page: i32,
    page_size: i32,
    highlight: bool
}

/// Search results
pub type SearchResults = type {
    hits: Vec<SearchHit>,
    total: i64,
    page: i32,
    page_size: i32,
    facets: Map<String, Vec<FacetValue>>,
    suggestions: Vec<String>
}

/// Search hit
pub type SearchHit = type {
    id: String,
    entity_type: String,
    score: f64,
    fields: Map<String, String>,
    highlights: Map<String, String>
}

/// Quick search results
pub type QuickSearchResults = type {
    categories: Map<String, Vec<SearchHit>>
}

impl QuickSearchResults {
    pub fn new() -> Self { QuickSearchResults { categories: Map::new() } }

    pub fn add_category(mut self, category: &str, hits: Vec<SearchHit>) {
        self.categories.insert(category.to_string(), hits);
    }
}

/// Autocomplete request
pub type AutocompleteRequest = type {
    tenant_id: String,
    prefix: String,
    entity_type: Option<String>,
    limit: i32
}

/// Suggestion
pub type Suggestion = type {
    text: String,
    entity_type: String,
    id: Option<String>,
    score: f64
}

/// Index document
pub type IndexDocument = type {
    id: String,
    entity_type: String,
    fields: Map<String, String>,
    metadata: Map<String, Value>
}

/// Analyzed document
pub type AnalyzedDocument = type {
    id: String,
    entity_type: String,
    fields: Map<String, String>,
    analyzed_fields: Map<String, String>,
    metadata: Map<String, Value>
}

/// Indexing results
pub type IndexingResults = type {
    total: i32,
    successful: i32,
    failed: i32,
    errors: Vec<IndexingError>
}

impl IndexingResults {
    pub fn new() -> Self { IndexingResults { total: 0, successful: 0, failed: 0, errors: vec![] } }

    pub fn add_success(mut self, id: String) {
        self.total += 1;
        self.successful += 1;
    }

    pub fn add_failure(mut self, id: String, error: String) {
        self.total += 1;
        self.failed += 1;
        self.errors.push(IndexingError { id, error });
    }
}

pub type IndexingError = type { id: String, error: String }

/// Reindex results
pub type ReindexResults = type {
    entity_type: String,
    total: i32,
    indexed: i32,
    failed: i32
}

/// Facet definition
pub type FacetDefinition = type {
    field: String,
    label: String,
    facet_type: FacetType
}

impl FacetDefinition {
    pub fn new(field: &str, label: &str, facet_type: FacetType) -> Self {
        FacetDefinition {
            field: field.to_string(),
            label: label.to_string(),
            facet_type
        }
    }
}

pub enum FacetType {
    Terms,
    Range,
    Date
}

/// Facet value
pub type FacetValue = type {
    value: String,
    count: i64
}

/// Saved search
pub type SavedSearch = type {
    id: String,
    name: String,
    query: SearchQuery,
    created_at: DateTime
}

/// Popular search
pub type PopularSearch = type {
    query: String,
    count: i64
}

/// Search analytics
pub type SearchAnalytics = type {
    total_searches: i64,
    unique_queries: i64,
    avg_results: f64,
    zero_result_queries: Vec<String>,
    top_queries: Vec<PopularSearch>
}

pub type AnalyticsQuery = type {
    from: Option<DateTime>,
    to: Option<DateTime>
}

/// Search configuration
pub type SearchConfig = type {
    backend: SearchBackendType,
    index_prefix: String,
    default_page_size: i32,
    max_page_size: i32
}

pub enum SearchBackendType {
    InMemory,
    Elasticsearch(ElasticsearchConfig),
    OpenSearch(OpenSearchConfig),
    Meilisearch(MeilisearchConfig)
}

pub type ElasticsearchConfig = type {
    hosts: Vec<String>,
    username: Option<String>,
    password: Option<String>
}

pub type OpenSearchConfig = type {
    hosts: Vec<String>,
    username: Option<String>,
    password: Option<String>
}

pub type MeilisearchConfig = type {
    host: String,
    api_key: Option<String>
}

pub type ElasticsearchClient = type { config: ElasticsearchConfig }
impl ElasticsearchClient {
    pub fn new(config: &ElasticsearchConfig) -> Self {
        ElasticsearchClient { config: config.clone() }
    }
}

/// Search error
pub enum SearchError {
    ValidationError(String),
    QueryParseError(String),
    IndexError(String),
    BackendError(String),
    NotFound(String)
}

impl SearchError {
    pub fn to_string(self) -> String {
        match self {
            SearchError::ValidationError(m) => m,
            SearchError::QueryParseError(m) => format!("Query parse error: {}", m),
            SearchError::IndexError(m) => format!("Index error: {}", m),
            SearchError::BackendError(m) => format!("Backend error: {}", m),
            SearchError::NotFound(m) => format!("Not found: {}", m)
        }
    }
}
