// =============================================================================
// Type Aliases
// =============================================================================

type TokenId = String
type ProviderId = String
type MfaSecretId = String
type PasswordResetToken = String

// =============================================================================
// User Entity
// =============================================================================

/// LMS User - extends base user concepts for educational context
type User {
    id: UserId,
    /// Unique username
    username: String,
    /// Email address
    email: String,
    /// Display name shown in UI
    display_name: String,
    /// First name
    first_name: Option<String>,
    /// Last name
    last_name: Option<String>,
    /// Password hash (argon2)
    password_hash: Option<String>,
    /// When password was last changed
    password_changed_at: Option<DateTime>,
    /// Account status
    status: UserStatus,
    /// Email verified
    email_verified: Bool,
    /// Phone number (for SMS MFA)
    phone_number: Option<String>,
    /// Phone verified
    phone_verified: Bool,
    /// User's timezone
    timezone: Option<String>,
    /// Preferred locale/language
    locale: Option<String>,
    /// Avatar URL
    avatar_url: Option<String>,
    /// Tenant this user belongs to
    tenant_id: TenantId,
    /// Global system roles
    roles: Set<RoleId>,
    /// Last login timestamp
    last_login_at: Option<DateTime>,
    /// Last activity timestamp
    last_activity_at: Option<DateTime>,
    /// Failed login attempt count
    failed_login_attempts: i32,
    /// Account locked until
    locked_until: Option<DateTime>,
    /// Account creation
    created_at: DateTime,
    updated_at: DateTime,
    /// Student/Employee ID (for SIS integration)
    external_id: Option<String>,
    /// Additional metadata
    metadata: Map<String, Dynamic>
}

enum UserStatus {
    /// Account is active
    Active,
    /// Account is pending email verification
    PendingVerification,
    /// Account is suspended
    Suspended { reason: String, until: Option<DateTime> },
    /// Account is deactivated
    Deactivated,
    /// Account is locked due to failed logins
    Locked { until: DateTime }
}

impl UserStatus {
    fn is_active(&self) -> Bool {
        match self {
            UserStatus::Active => true,
            _ => false
        }
    }

    fn from_string(s: &str) -> Self {
        match s {
            "Active" => UserStatus::Active,
            "PendingVerification" => UserStatus::PendingVerification,
            "Deactivated" => UserStatus::Deactivated,
            s if s.starts_with("Suspended:") => {
                let reason = s.strip_prefix("Suspended:").unwrap_or("").to_string();
                UserStatus::Suspended { reason, until: None }
            },
            s if s.starts_with("Locked:") => {
                let until_str = s.strip_prefix("Locked:").unwrap_or("");
                let until = DateTime::parse(until_str).unwrap_or(DateTime::now());
                UserStatus::Locked { until }
            },
            _ => UserStatus::Active
        }
    }

    fn to_string(&self) -> String {
        match self {
            UserStatus::Active => "Active".to_string(),
            UserStatus::PendingVerification => "PendingVerification".to_string(),
            UserStatus::Suspended { reason, until: _ } => format!("Suspended:{}", reason),
            UserStatus::Deactivated => "Deactivated".to_string(),
            UserStatus::Locked { until } => format!("Locked:{}", until.to_rfc3339())
        }
    }
}

// =============================================================================
// Authentication Configuration
// =============================================================================

type AuthConfig {
    // Session settings
    session_lifetime: Duration,
    session_cookie_name: String,
    session_cookie_secure: Bool,
    session_cookie_http_only: Bool,
    session_cookie_same_site: SameSite,
    max_sessions_per_user: Option<i32>,

    // Token settings
    access_token_lifetime: Duration,
    refresh_token_lifetime: Duration,
    jwt_secret: String,
    jwt_algorithm: JwtAlgorithm,
    jwt_issuer: String,
    jwt_audience: String,

    // Password settings
    password_min_length: i32,
    password_require_uppercase: Bool,
    password_require_lowercase: Bool,
    password_require_number: Bool,
    password_require_special: Bool,
    password_max_age_days: Option<i32>,
    password_history_count: i32,

    // Login settings
    max_login_attempts: i32,
    lockout_duration: Duration,
    require_email_verification: Bool,

    // MFA settings
    mfa_enabled: Bool,
    mfa_required_for_roles: Set<String>,
    allowed_mfa_methods: Set<MfaMethod>,

    // SSO providers
    oauth_providers: Map<ProviderId, OAuthProviderConfig>,
    saml_providers: Map<ProviderId, SamlProviderConfig>,

    // LMS-specific
    allow_guest_access: Bool,
    auto_enroll_on_first_login: Bool
}

enum SameSite {
    Strict,
    Lax,
    None
}

impl AuthConfig {
    fn default() -> Self {
        AuthConfig {
            session_lifetime: Duration::from_hours(24),
            session_cookie_name: "intelligo_session".to_string(),
            session_cookie_secure: true,
            session_cookie_http_only: true,
            session_cookie_same_site: SameSite::Lax,
            max_sessions_per_user: Some(5),

            access_token_lifetime: Duration::from_minutes(15),
            refresh_token_lifetime: Duration::from_days(7),
            jwt_secret: "".to_string(), // Must be set
            jwt_algorithm: JwtAlgorithm::HS256,
            jwt_issuer: "intelligo".to_string(),
            jwt_audience: "intelligo".to_string(),

            password_min_length: 8,
            password_require_uppercase: true,
            password_require_lowercase: true,
            password_require_number: true,
            password_require_special: false,
            password_max_age_days: None,
            password_history_count: 5,

            max_login_attempts: 5,
            lockout_duration: Duration::from_minutes(30),
            require_email_verification: true,

            mfa_enabled: true,
            mfa_required_for_roles: Set::from(["administrator".to_string(), "tenant_admin".to_string()]),
            allowed_mfa_methods: Set::from([MfaMethod::Totp, MfaMethod::Email, MfaMethod::Backup]),

            oauth_providers: Map::new(),
            saml_providers: Map::new(),

            allow_guest_access: false,
            auto_enroll_on_first_login: false
        }
    }
}

