// =============================================================================
// Session & Token Types
// =============================================================================

/// Authentication session with device tracking
type AuthSession {
    id: SessionId,
    user_id: UserId,
    tenant_id: TenantId,
    created_at: DateTime,
    expires_at: DateTime,
    last_activity: DateTime,
    ip_address: Option<String>,
    user_agent: Option<String>,
    device_info: Option<DeviceInfo>,
    auth_method: AuthMethod,
    mfa_verified: Bool,
    provider_id: Option<ProviderId>,
    /// Active course context (for LMS)
    current_course_id: Option<CourseId>,
    /// Is this a guest session
    is_guest: Bool,
    metadata: Map<String, Dynamic>
}

type DeviceInfo {
    device_id: Option<String>,
    device_type: DeviceType,
    os: String,
    os_version: Option<String>,
    browser: String,
    browser_version: Option<String>,
    is_mobile: Bool,
    /// Device fingerprint for tracking
    fingerprint: Option<String>
}

enum DeviceType {
    Desktop,
    Mobile,
    Tablet,
    Unknown
}

enum AuthMethod {
    Password,
    OAuth { provider: ProviderId },
    Saml { provider: ProviderId },
    ApiKey,
    Token,
    MagicLink,
    LtiLaunch { platform: String },
    Guest
}

/// JWT-based auth token
type AuthToken {
    id: TokenId,
    token_type: TokenType,
    user_id: UserId,
    tenant_id: TenantId,
    value: String,
    created_at: DateTime,
    expires_at: DateTime,
    revoked: Bool,
    revoked_at: Option<DateTime>,
    revoked_reason: Option<String>,
    scope: Set<String>,
    /// Session this token belongs to
    session_id: Option<SessionId>
}

enum TokenType {
    Access,
    Refresh,
    IdToken,
    PasswordReset,
    EmailVerification,
    MagicLink,
    ApiKey,
    LtiToken
}

type TokenPair {
    access_token: String,
    refresh_token: String,
    token_type: String,
    expires_in: i64,
    scope: String,
    id_token: Option<String>
}

// =============================================================================
// MFA Types
// =============================================================================

enum MfaMethod {
    /// Time-based One-Time Password (Google Authenticator, etc.)
    Totp,
    /// SMS verification code
    Sms,
    /// Email verification code
    Email,
    /// WebAuthn/FIDO2 passkey
    Passkey,
    /// Backup codes
    Backup
}

type MfaEnrollment {
    id: MfaSecretId,
    user_id: UserId,
    method: MfaMethod,
    /// Secret for TOTP
    secret: Option<String>,
    /// Phone number for SMS
    phone_number: Option<String>,
    /// Email for email codes
    email: Option<String>,
    verified: Bool,
    created_at: DateTime,
    last_used: Option<DateTime>,
    /// Credential ID for passkeys
    credential_id: Option<String>,
    /// Public key for passkeys
    public_key: Option<String>,
    metadata: Map<String, Dynamic>
}

type BackupCodes {
    user_id: UserId,
    codes: List<BackupCode>,
    generated_at: DateTime
}

type BackupCode {
    code_hash: String,
    used: Bool,
    used_at: Option<DateTime>
}

type TotpEnrollment {
    id: MfaSecretId,
    secret: String,
    provisioning_uri: String,
    qr_code: String
}

// =============================================================================
// Login Request/Response Types
// =============================================================================

type LoginRequest {
    username_or_email: String,
    password: String,
    remember_me: Bool,
    mfa_code: Option<String>,
    mfa_method: Option<MfaMethod>,
    device_info: Option<DeviceInfo>,
    /// For LTI launch context
    lti_context: Option<LtiContext>
}

type LtiContext {
    platform_id: String,
    deployment_id: String,
    context_id: Option<String>,
    resource_link_id: Option<String>,
    roles: List<String>
}

type LoginResponse {
    success: Bool,
    session: Option<AuthSession>,
    tokens: Option<TokenPair>,
    requires_mfa: Bool,
    mfa_methods: List<MfaMethod>,
    user: Option<AuthenticatedUser>,
    error: Option<LoginError>,
    /// MFA challenge token for two-step login
    mfa_challenge_token: Option<String>
}

type AuthenticatedUser {
    id: UserId,
    username: String,
    email: String,
    display_name: String,
    first_name: Option<String>,
    last_name: Option<String>,
    roles: Set<RoleId>,
    permissions: Set<PermissionId>,
    avatar_url: Option<String>,
    email_verified: Bool,
    mfa_enabled: Bool,
    tenant_id: TenantId,
    /// Enrolled courses for quick access
    enrolled_course_ids: List<CourseId>,
    /// Teaching courses for instructors
    teaching_course_ids: List<CourseId>
}

enum LoginError {
    InvalidCredentials,
    AccountLocked { until: DateTime },
    AccountSuspended { reason: String },
    AccountDeactivated,
    EmailNotVerified,
    MfaRequired,
    InvalidMfaCode,
    MfaMethodNotAllowed,
    SessionLimitReached,
    IpBlocked,
    PasswordExpired,
    TenantSuspended,
    TenantNotFound,
    ProviderError { message: String }
}

impl LoginError {
    fn to_string(&self) -> String {
        match self {
            LoginError::InvalidCredentials => "Invalid username or password".to_string(),
            LoginError::AccountLocked { until } => format!("Account locked until {}", until),
            LoginError::AccountSuspended { reason } => format!("Account suspended: {}", reason),
            LoginError::AccountDeactivated => "Account has been deactivated".to_string(),
            LoginError::EmailNotVerified => "Please verify your email address".to_string(),
            LoginError::MfaRequired => "Multi-factor authentication required".to_string(),
            LoginError::InvalidMfaCode => "Invalid verification code".to_string(),
            LoginError::MfaMethodNotAllowed => "This MFA method is not allowed".to_string(),
            LoginError::SessionLimitReached => "Maximum sessions reached".to_string(),
            LoginError::IpBlocked => "Access from this IP is blocked".to_string(),
            LoginError::PasswordExpired => "Password has expired, please reset it".to_string(),
            LoginError::TenantSuspended => "Your organization's access has been suspended".to_string(),
            LoginError::TenantNotFound => "Organization not found".to_string(),
            LoginError::ProviderError { message } => format!("Authentication provider error: {}", message)
        }
    }
}

