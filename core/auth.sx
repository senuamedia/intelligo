// =============================================================================
// Intelligo LMS - Authentication System
// =============================================================================
// Comprehensive authentication supporting local, OAuth, SAML, and social logins
// with MFA/2FA support, session management, and LMS-specific features
// =============================================================================

module intelligo::core::auth

