/// Intelligo LMS - Tenant Limits
///
/// Resource limits, quotas, and enforcement for multi-tenant deployments.
/// Provides configurable limits per tier with soft and hard enforcement.

module intelligo::tenant::limits

use intelligo::tenant::core::*
use intelligo::tenant::billing::*
use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// LIMIT DEFINITIONS
// =============================================================================

/// Complete limit configuration for a tenant
type TenantLimits {
    /// Tenant ID
    tenant_id: TenantId,

    /// Source of limits (plan-based or custom)
    source: LimitSource,

    /// User limits
    user_limits: UserLimits,

    /// Content limits
    content_limits: ContentLimits,

    /// Storage limits
    storage_limits: StorageLimits,

    /// API limits
    api_limits: ApiLimits,

    /// Feature limits
    feature_limits: FeatureLimits,

    /// Integration limits
    integration_limits: IntegrationLimits,

    /// Custom limits
    custom_limits: Map<String, LimitValue>,

    /// Enforcement mode
    enforcement: EnforcementMode,

    /// Grace period after limit exceeded
    grace_period: Duration,

    /// Last updated
    updated_at: DateTime
}

impl TenantLimits {
    /// Create default limits for tier
    fn for_tier(tenant_id: TenantId, tier: &SubscriptionTier) -> TenantLimits {
        TenantLimits {
            tenant_id,
            source: LimitSource::Plan { tier: tier.clone() },
            user_limits: UserLimits::for_tier(tier),
            content_limits: ContentLimits::for_tier(tier),
            storage_limits: StorageLimits::for_tier(tier),
            api_limits: ApiLimits::for_tier(tier),
            feature_limits: FeatureLimits::for_tier(tier),
            integration_limits: IntegrationLimits::for_tier(tier),
            custom_limits: Map::new(),
            enforcement: EnforcementMode::Soft,
            grace_period: Duration::days(7),
            updated_at: DateTime::now()
        }
    }
}

/// Source of limit configuration
enum LimitSource {
    /// Limits derived from subscription plan
    Plan { tier: SubscriptionTier },
    /// Custom limits set for tenant
    Custom,
    /// Hybrid (plan base with custom overrides)
    Hybrid { tier: SubscriptionTier }
}

/// Enforcement mode
enum EnforcementMode {
    /// Warn but don't block (grace period)
    Soft,
    /// Block new resources when limit reached
    Hard,
    /// Block and notify
    Strict,
    /// No enforcement (monitoring only)
    Monitor
}

/// Generic limit value
enum LimitValue {
    /// Numeric limit
    Numeric { value: i64, unit: String },
    /// Boolean limit (enabled/disabled)
    Boolean { enabled: Bool },
    /// Rate limit
    Rate { count: i64, period: Duration },
    /// Unlimited
    Unlimited
}

impl LimitValue {
    fn is_exceeded(&self, current: i64) -> Bool {
        match self {
            LimitValue::Numeric { value, .. } => current >= *value,
            LimitValue::Boolean { enabled } => !enabled,
            LimitValue::Rate { count, .. } => current >= *count,
            LimitValue::Unlimited => false
        }
    }

    fn remaining(&self, current: i64) -> i64 {
        match self {
            LimitValue::Numeric { value, .. } => (*value - current).max(0),
            LimitValue::Boolean { enabled } => if *enabled { i64::MAX } else { 0 },
            LimitValue::Rate { count, .. } => (*count - current).max(0),
            LimitValue::Unlimited => i64::MAX
        }
    }
}

// =============================================================================
// USER LIMITS
// =============================================================================

/// User-related limits
type UserLimits {
    /// Maximum total users
    max_total_users: LimitValue,

    /// Maximum active users (logged in within period)
    max_active_users: LimitValue,

    /// Maximum admin users
    max_admin_users: LimitValue,

    /// Maximum instructor users
    max_instructors: LimitValue,

    /// Maximum concurrent sessions per user
    max_concurrent_sessions: LimitValue,

    /// Session timeout
    session_timeout: Duration,

    /// Allow SSO
    allow_sso: Bool,

    /// Allow bulk import
    allow_bulk_import: Bool,

    /// Max bulk import size
    max_bulk_import_size: i32
}

impl UserLimits {
    fn for_tier(tier: &SubscriptionTier) -> UserLimits {
        match tier {
            SubscriptionTier::Free => UserLimits {
                max_total_users: LimitValue::Numeric { value: 25, unit: "users".to_string() },
                max_active_users: LimitValue::Numeric { value: 25, unit: "users".to_string() },
                max_admin_users: LimitValue::Numeric { value: 2, unit: "users".to_string() },
                max_instructors: LimitValue::Numeric { value: 3, unit: "users".to_string() },
                max_concurrent_sessions: LimitValue::Numeric { value: 1, unit: "sessions".to_string() },
                session_timeout: Duration::hours(24),
                allow_sso: false,
                allow_bulk_import: false,
                max_bulk_import_size: 0
            },
            SubscriptionTier::Starter => UserLimits {
                max_total_users: LimitValue::Numeric { value: 100, unit: "users".to_string() },
                max_active_users: LimitValue::Numeric { value: 100, unit: "users".to_string() },
                max_admin_users: LimitValue::Numeric { value: 5, unit: "users".to_string() },
                max_instructors: LimitValue::Numeric { value: 10, unit: "users".to_string() },
                max_concurrent_sessions: LimitValue::Numeric { value: 2, unit: "sessions".to_string() },
                session_timeout: Duration::hours(48),
                allow_sso: false,
                allow_bulk_import: true,
                max_bulk_import_size: 100
            },
            SubscriptionTier::Professional => UserLimits {
                max_total_users: LimitValue::Numeric { value: 500, unit: "users".to_string() },
                max_active_users: LimitValue::Numeric { value: 500, unit: "users".to_string() },
                max_admin_users: LimitValue::Numeric { value: 10, unit: "users".to_string() },
                max_instructors: LimitValue::Numeric { value: 50, unit: "users".to_string() },
                max_concurrent_sessions: LimitValue::Numeric { value: 3, unit: "sessions".to_string() },
                session_timeout: Duration::hours(72),
                allow_sso: true,
                allow_bulk_import: true,
                max_bulk_import_size: 500
            },
            SubscriptionTier::Business => UserLimits {
                max_total_users: LimitValue::Numeric { value: 2000, unit: "users".to_string() },
                max_active_users: LimitValue::Numeric { value: 2000, unit: "users".to_string() },
                max_admin_users: LimitValue::Numeric { value: 25, unit: "users".to_string() },
                max_instructors: LimitValue::Numeric { value: 200, unit: "users".to_string() },
                max_concurrent_sessions: LimitValue::Numeric { value: 5, unit: "sessions".to_string() },
                session_timeout: Duration::days(7),
                allow_sso: true,
                allow_bulk_import: true,
                max_bulk_import_size: 2000
            },
            SubscriptionTier::Enterprise | SubscriptionTier::Custom { .. } => UserLimits {
                max_total_users: LimitValue::Unlimited,
                max_active_users: LimitValue::Unlimited,
                max_admin_users: LimitValue::Unlimited,
                max_instructors: LimitValue::Unlimited,
                max_concurrent_sessions: LimitValue::Unlimited,
                session_timeout: Duration::days(30),
                allow_sso: true,
                allow_bulk_import: true,
                max_bulk_import_size: 10000
            }
        }
    }
}

