}

impl ContentLimits {
    fn for_tier(tier: &SubscriptionTier) -> ContentLimits {
        match tier {
            SubscriptionTier::Free => ContentLimits {
                max_courses: LimitValue::Numeric { value: 3, unit: "courses".to_string() },
                max_published_courses: LimitValue::Numeric { value: 2, unit: "courses".to_string() },
                max_modules_per_course: LimitValue::Numeric { value: 5, unit: "modules".to_string() },
                max_lessons_per_module: LimitValue::Numeric { value: 10, unit: "lessons".to_string() },
                max_assessments: LimitValue::Numeric { value: 5, unit: "assessments".to_string() },
                max_questions_per_assessment: LimitValue::Numeric { value: 25, unit: "questions".to_string() },
                max_question_banks: LimitValue::Numeric { value: 1, unit: "banks".to_string() },
                max_learning_paths: LimitValue::Numeric { value: 0, unit: "paths".to_string() },
                max_certificates: LimitValue::Numeric { value: 1, unit: "templates".to_string() },
                allow_scorm: false,
                allow_xapi: false
            },
            SubscriptionTier::Starter => ContentLimits {
                max_courses: LimitValue::Numeric { value: 15, unit: "courses".to_string() },
                max_published_courses: LimitValue::Numeric { value: 10, unit: "courses".to_string() },
                max_modules_per_course: LimitValue::Numeric { value: 10, unit: "modules".to_string() },
                max_lessons_per_module: LimitValue::Numeric { value: 20, unit: "lessons".to_string() },
                max_assessments: LimitValue::Numeric { value: 25, unit: "assessments".to_string() },
                max_questions_per_assessment: LimitValue::Numeric { value: 50, unit: "questions".to_string() },
                max_question_banks: LimitValue::Numeric { value: 5, unit: "banks".to_string() },
                max_learning_paths: LimitValue::Numeric { value: 3, unit: "paths".to_string() },
                max_certificates: LimitValue::Numeric { value: 5, unit: "templates".to_string() },
                allow_scorm: false,
                allow_xapi: false
            },
            SubscriptionTier::Professional => ContentLimits {
                max_courses: LimitValue::Numeric { value: 50, unit: "courses".to_string() },
                max_published_courses: LimitValue::Numeric { value: 50, unit: "courses".to_string() },
                max_modules_per_course: LimitValue::Numeric { value: 25, unit: "modules".to_string() },
                max_lessons_per_module: LimitValue::Numeric { value: 50, unit: "lessons".to_string() },
                max_assessments: LimitValue::Numeric { value: 100, unit: "assessments".to_string() },
                max_questions_per_assessment: LimitValue::Numeric { value: 100, unit: "questions".to_string() },
                max_question_banks: LimitValue::Numeric { value: 25, unit: "banks".to_string() },
                max_learning_paths: LimitValue::Numeric { value: 15, unit: "paths".to_string() },
                max_certificates: LimitValue::Numeric { value: 20, unit: "templates".to_string() },
                allow_scorm: true,
                allow_xapi: true
            },
            SubscriptionTier::Business => ContentLimits {
                max_courses: LimitValue::Numeric { value: 200, unit: "courses".to_string() },
                max_published_courses: LimitValue::Numeric { value: 200, unit: "courses".to_string() },
                max_modules_per_course: LimitValue::Numeric { value: 50, unit: "modules".to_string() },
                max_lessons_per_module: LimitValue::Numeric { value: 100, unit: "lessons".to_string() },
                max_assessments: LimitValue::Numeric { value: 500, unit: "assessments".to_string() },
                max_questions_per_assessment: LimitValue::Numeric { value: 200, unit: "questions".to_string() },
                max_question_banks: LimitValue::Numeric { value: 100, unit: "banks".to_string() },
                max_learning_paths: LimitValue::Numeric { value: 50, unit: "paths".to_string() },
                max_certificates: LimitValue::Unlimited,
                allow_scorm: true,
                allow_xapi: true
            },
            SubscriptionTier::Enterprise | SubscriptionTier::Custom { .. } => ContentLimits {
                max_courses: LimitValue::Unlimited,
                max_published_courses: LimitValue::Unlimited,
                max_modules_per_course: LimitValue::Unlimited,
                max_lessons_per_module: LimitValue::Unlimited,
                max_assessments: LimitValue::Unlimited,
                max_questions_per_assessment: LimitValue::Unlimited,
                max_question_banks: LimitValue::Unlimited,
                max_learning_paths: LimitValue::Unlimited,
                max_certificates: LimitValue::Unlimited,
                allow_scorm: true,
                allow_xapi: true
            }
        }
    }
}

// =============================================================================
// STORAGE LIMITS
// =============================================================================

/// Storage-related limits
type StorageLimits {
    /// Total storage quota (bytes)
    total_storage_bytes: LimitValue,

    /// Maximum file size (bytes)
    max_file_size_bytes: LimitValue,

    /// Maximum video storage (bytes)
    max_video_storage_bytes: LimitValue,

    /// Allowed file types
    allowed_file_types: Set<String>,

    /// Maximum video duration per file (seconds)
    max_video_duration_seconds: i32,

    /// Enable CDN
    cdn_enabled: Bool,

    /// Bandwidth limit per month (bytes)
    monthly_bandwidth_bytes: LimitValue
}

impl StorageLimits {
    fn for_tier(tier: &SubscriptionTier) -> StorageLimits {
        let gb = 1024 * 1024 * 1024i64;
        let mb = 1024 * 1024i64;

        let standard_file_types = Set::from([
            "pdf".to_string(), "doc".to_string(), "docx".to_string(),
            "ppt".to_string(), "pptx".to_string(), "xls".to_string(),
            "xlsx".to_string(), "txt".to_string(), "jpg".to_string(),
            "jpeg".to_string(), "png".to_string(), "gif".to_string(),
            "mp4".to_string(), "mp3".to_string(), "zip".to_string()
        ]);

        match tier {
            SubscriptionTier::Free => StorageLimits {
                total_storage_bytes: LimitValue::Numeric { value: 1 * gb, unit: "bytes".to_string() },
                max_file_size_bytes: LimitValue::Numeric { value: 50 * mb, unit: "bytes".to_string() },
                max_video_storage_bytes: LimitValue::Numeric { value: 500 * mb, unit: "bytes".to_string() },
                allowed_file_types: standard_file_types,
                max_video_duration_seconds: 600, // 10 minutes
                cdn_enabled: false,
                monthly_bandwidth_bytes: LimitValue::Numeric { value: 5 * gb, unit: "bytes".to_string() }
            },
            SubscriptionTier::Starter => StorageLimits {
                total_storage_bytes: LimitValue::Numeric { value: 10 * gb, unit: "bytes".to_string() },
                max_file_size_bytes: LimitValue::Numeric { value: 200 * mb, unit: "bytes".to_string() },
                max_video_storage_bytes: LimitValue::Numeric { value: 5 * gb, unit: "bytes".to_string() },
                allowed_file_types: standard_file_types,
                max_video_duration_seconds: 1800, // 30 minutes
                cdn_enabled: true,
                monthly_bandwidth_bytes: LimitValue::Numeric { value: 50 * gb, unit: "bytes".to_string() }
            },
            SubscriptionTier::Professional => StorageLimits {
                total_storage_bytes: LimitValue::Numeric { value: 100 * gb, unit: "bytes".to_string() },
                max_file_size_bytes: LimitValue::Numeric { value: 500 * mb, unit: "bytes".to_string() },
                max_video_storage_bytes: LimitValue::Numeric { value: 50 * gb, unit: "bytes".to_string() },
                allowed_file_types: standard_file_types,
                max_video_duration_seconds: 3600, // 60 minutes
                cdn_enabled: true,
                monthly_bandwidth_bytes: LimitValue::Numeric { value: 500 * gb, unit: "bytes".to_string() }
            },
            SubscriptionTier::Business => StorageLimits {
                total_storage_bytes: LimitValue::Numeric { value: 500 * gb, unit: "bytes".to_string() },
                max_file_size_bytes: LimitValue::Numeric { value: 2 * gb, unit: "bytes".to_string() },
                max_video_storage_bytes: LimitValue::Numeric { value: 250 * gb, unit: "bytes".to_string() },
                allowed_file_types: standard_file_types,
                max_video_duration_seconds: 7200, // 2 hours
                cdn_enabled: true,
                monthly_bandwidth_bytes: LimitValue::Numeric { value: 2000 * gb, unit: "bytes".to_string() }
            },
            SubscriptionTier::Enterprise | SubscriptionTier::Custom { .. } => StorageLimits {
                total_storage_bytes: LimitValue::Unlimited,
                max_file_size_bytes: LimitValue::Numeric { value: 10 * gb, unit: "bytes".to_string() },
                max_video_storage_bytes: LimitValue::Unlimited,
                allowed_file_types: standard_file_types,
                max_video_duration_seconds: 14400, // 4 hours
                cdn_enabled: true,
                monthly_bandwidth_bytes: LimitValue::Unlimited
            }
        }
    }
}

// =============================================================================
// API LIMITS
// =============================================================================

/// API and rate limits
type ApiLimits {
    /// API access enabled
    api_enabled: Bool,

    /// Requests per minute
    requests_per_minute: LimitValue,

    /// Requests per hour
    requests_per_hour: LimitValue,

    /// Requests per day
    requests_per_day: LimitValue,

    /// Concurrent requests
    concurrent_requests: LimitValue,

    /// Webhook endpoints
    max_webhooks: LimitValue,

    /// API keys
    max_api_keys: LimitValue
}

impl ApiLimits {
    fn for_tier(tier: &SubscriptionTier) -> ApiLimits {
        match tier {
            SubscriptionTier::Free => ApiLimits {
                api_enabled: false,
                requests_per_minute: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                requests_per_hour: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                requests_per_day: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                concurrent_requests: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                max_webhooks: LimitValue::Numeric { value: 0, unit: "webhooks".to_string() },
                max_api_keys: LimitValue::Numeric { value: 0, unit: "keys".to_string() }
            },
            SubscriptionTier::Starter => ApiLimits {
                api_enabled: false,
                requests_per_minute: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                requests_per_hour: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                requests_per_day: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                concurrent_requests: LimitValue::Numeric { value: 0, unit: "requests".to_string() },
                max_webhooks: LimitValue::Numeric { value: 0, unit: "webhooks".to_string() },
                max_api_keys: LimitValue::Numeric { value: 0, unit: "keys".to_string() }
            },
            SubscriptionTier::Professional => ApiLimits {
                api_enabled: true,
                requests_per_minute: LimitValue::Numeric { value: 60, unit: "requests".to_string() },
                requests_per_hour: LimitValue::Numeric { value: 1000, unit: "requests".to_string() },
                requests_per_day: LimitValue::Numeric { value: 10000, unit: "requests".to_string() },
                concurrent_requests: LimitValue::Numeric { value: 5, unit: "requests".to_string() },
                max_webhooks: LimitValue::Numeric { value: 5, unit: "webhooks".to_string() },
                max_api_keys: LimitValue::Numeric { value: 3, unit: "keys".to_string() }
            },
            SubscriptionTier::Business => ApiLimits {
                api_enabled: true,
                requests_per_minute: LimitValue::Numeric { value: 300, unit: "requests".to_string() },
                requests_per_hour: LimitValue::Numeric { value: 5000, unit: "requests".to_string() },
                requests_per_day: LimitValue::Numeric { value: 50000, unit: "requests".to_string() },
                concurrent_requests: LimitValue::Numeric { value: 20, unit: "requests".to_string() },
                max_webhooks: LimitValue::Numeric { value: 25, unit: "webhooks".to_string() },
                max_api_keys: LimitValue::Numeric { value: 10, unit: "keys".to_string() }
            },
            SubscriptionTier::Enterprise | SubscriptionTier::Custom { .. } => ApiLimits {
                api_enabled: true,
                requests_per_minute: LimitValue::Numeric { value: 1000, unit: "requests".to_string() },
                requests_per_hour: LimitValue::Numeric { value: 20000, unit: "requests".to_string() },
                requests_per_day: LimitValue::Unlimited,
                concurrent_requests: LimitValue::Numeric { value: 100, unit: "requests".to_string() },
                max_webhooks: LimitValue::Unlimited,
                max_api_keys: LimitValue::Unlimited
            }
        }
    }
}

