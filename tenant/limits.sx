/// Content-related limits
type ContentLimits {
    /// Maximum courses
    max_courses: LimitValue,

    /// Maximum published courses
    max_published_courses: LimitValue,

    /// Maximum modules per course
    max_modules_per_course: LimitValue,

    /// Maximum lessons per module
    max_lessons_per_module: LimitValue,

    /// Maximum assessments
    max_assessments: LimitValue,

    /// Maximum questions per assessment
    max_questions_per_assessment: LimitValue,

    /// Maximum question banks
    max_question_banks: LimitValue,

    /// Maximum learning paths
    max_learning_paths: LimitValue,

    /// Maximum certificates
    max_certificates: LimitValue,

    /// Allow SCORM import
    allow_scorm: Bool,

    /// Allow xAPI
