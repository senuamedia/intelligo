// =============================================================================
// INTEGRATION LIMITS
// =============================================================================

/// Integration-related limits
type IntegrationLimits {
    /// SSO integrations
    max_sso_providers: LimitValue,

    /// LTI connections
    max_lti_connections: LimitValue,

    /// Calendar integrations
    calendar_sync_enabled: Bool,

    /// HRIS integrations
    hris_sync_enabled: Bool,

    /// Custom integrations
    max_custom_integrations: LimitValue
}

impl IntegrationLimits {
    fn for_tier(tier: &SubscriptionTier) -> IntegrationLimits {
        match tier {
            SubscriptionTier::Free | SubscriptionTier::Starter => IntegrationLimits {
                max_sso_providers: LimitValue::Numeric { value: 0, unit: "providers".to_string() },
                max_lti_connections: LimitValue::Numeric { value: 0, unit: "connections".to_string() },
                calendar_sync_enabled: false,
                hris_sync_enabled: false,
                max_custom_integrations: LimitValue::Numeric { value: 0, unit: "integrations".to_string() }
            },
            SubscriptionTier::Professional => IntegrationLimits {
                max_sso_providers: LimitValue::Numeric { value: 1, unit: "providers".to_string() },
                max_lti_connections: LimitValue::Numeric { value: 3, unit: "connections".to_string() },
                calendar_sync_enabled: true,
                hris_sync_enabled: false,
                max_custom_integrations: LimitValue::Numeric { value: 0, unit: "integrations".to_string() }
            },
            SubscriptionTier::Business => IntegrationLimits {
                max_sso_providers: LimitValue::Numeric { value: 3, unit: "providers".to_string() },
                max_lti_connections: LimitValue::Numeric { value: 10, unit: "connections".to_string() },
                calendar_sync_enabled: true,
                hris_sync_enabled: true,
                max_custom_integrations: LimitValue::Numeric { value: 5, unit: "integrations".to_string() }
            },
            SubscriptionTier::Enterprise | SubscriptionTier::Custom { .. } => IntegrationLimits {
                max_sso_providers: LimitValue::Unlimited,
                max_lti_connections: LimitValue::Unlimited,
                calendar_sync_enabled: true,
                hris_sync_enabled: true,
                max_custom_integrations: LimitValue::Unlimited
            }
        }
    }
}

// =============================================================================
// LIMIT CHECKER
// =============================================================================

/// Result of limit check
type LimitCheckResult {
    allowed: Bool,
    limit_name: String,
    current_value: i64,
    limit_value: LimitValue,
    remaining: i64,
    warning: Option<String>,
    enforcement_action: Option<EnforcementAction>
}

/// Enforcement action to take
enum EnforcementAction {
    None,
    Warn,
    Block,
    BlockAndNotify,
    Throttle { delay_ms: i64 }
}

/// Limit checker actor
actor LimitChecker {
    var tenant_limits: Map<TenantId, TenantLimits> = Map::new()
    var current_usage: Map<TenantId, Map<String, i64>> = Map::new()
    var rate_windows: Map<(TenantId, String), RateWindow> = Map::new()

    fn new() -> Self {
        LimitChecker::default()
    }

    /// Register limits for tenant
    receive RegisterLimits(limits: TenantLimits) {
        self.tenant_limits.insert(limits.tenant_id.clone(), limits);
        checkpoint();
    }

    /// Check if action is allowed
    receive CheckLimit(tenant_id: TenantId, limit_name: String, increment: i64) -> LimitCheckResult {
        let limits = match self.tenant_limits.get(&tenant_id) {
            Some(l) => l,
            None => {
                return LimitCheckResult {
                    allowed: true,
                    limit_name,
                    current_value: 0,
                    limit_value: LimitValue::Unlimited,
                    remaining: i64::MAX,
                    warning: None,
                    enforcement_action: None
                };
            }
        };

        let current = self.get_current_value(&tenant_id, &limit_name);
        let limit_value = self.get_limit_value(limits, &limit_name);
        let new_value = current + increment;

        let is_exceeded = limit_value.is_exceeded(new_value);
        let remaining = limit_value.remaining(new_value);

        let (allowed, action, warning) = match (&limits.enforcement, is_exceeded) {
            (EnforcementMode::Monitor, _) => (true, None, if is_exceeded { Some("Limit exceeded (monitoring)".to_string()) } else { None }),
            (EnforcementMode::Soft, true) => (true, Some(EnforcementAction::Warn), Some("Limit exceeded - grace period active".to_string())),
            (EnforcementMode::Hard, true) => (false, Some(EnforcementAction::Block), Some("Limit exceeded".to_string())),
            (EnforcementMode::Strict, true) => (false, Some(EnforcementAction::BlockAndNotify), Some("Limit exceeded - action blocked".to_string())),
            (_, false) => {
                // Check for warning thresholds
                let percentage_used = if let LimitValue::Numeric { value, .. } = &limit_value {
                    (new_value as f64 / *value as f64) * 100.0
                } else {
                    0.0
                };

                let warning = if percentage_used >= 90.0 {
                    Some("Critical: Approaching limit (>90%)".to_string())
                } else if percentage_used >= 75.0 {
                    Some("Warning: Approaching limit (>75%)".to_string())
                } else {
                    None
                };

                (true, None, warning)
            }
        };

        LimitCheckResult {
            allowed,
            limit_name,
            current_value: new_value,
            limit_value,
            remaining,
            warning,
            enforcement_action: action
        }
    }

    /// Record usage
    receive RecordUsage(tenant_id: TenantId, metric: String, value: i64) {
        let usage = self.current_usage.entry(tenant_id).or_insert(Map::new());
        *usage.entry(metric).or_insert(0) += value;
        checkpoint();
    }

    /// Set usage (for absolute values like storage)
    receive SetUsage(tenant_id: TenantId, metric: String, value: i64) {
        let usage = self.current_usage.entry(tenant_id).or_insert(Map::new());
        usage.insert(metric, value);
        checkpoint();
    }

    /// Check rate limit
    receive CheckRateLimit(tenant_id: TenantId, limit_name: String) -> LimitCheckResult {
        let limits = match self.tenant_limits.get(&tenant_id) {
            Some(l) => l,
            None => {
                return LimitCheckResult {
                    allowed: true,
                    limit_name,
                    current_value: 0,
                    limit_value: LimitValue::Unlimited,
                    remaining: i64::MAX,
                    warning: None,
                    enforcement_action: None
                };
            }
        };

        let limit_value = self.get_limit_value(limits, &limit_name);

        let window_key = (tenant_id.clone(), limit_name.clone());
        let now = DateTime::now();

        let window = self.rate_windows.entry(window_key).or_insert(RateWindow {
            start: now,
            count: 0
        });

        // Get window duration from limit
        let window_duration = match &limit_value {
            LimitValue::Rate { period, .. } => period.clone(),
            _ => Duration::minutes(1)
        };

        // Reset window if expired
        if now - window.start >= window_duration {
            window.start = now;
            window.count = 0;
        }

        window.count += 1;

        let is_exceeded = limit_value.is_exceeded(window.count);
        let remaining = limit_value.remaining(window.count);

        let (allowed, action) = if is_exceeded {
            match &limits.enforcement {
                EnforcementMode::Monitor => (true, None),
                EnforcementMode::Soft => (true, Some(EnforcementAction::Warn)),
                EnforcementMode::Hard => (false, Some(EnforcementAction::Throttle { delay_ms: 1000 })),
                EnforcementMode::Strict => (false, Some(EnforcementAction::Block)),
            }
        } else {
            (true, None)
        };

        checkpoint();

        LimitCheckResult {
            allowed,
            limit_name,
            current_value: window.count,
            limit_value,
            remaining,
            warning: if is_exceeded { Some("Rate limit exceeded".to_string()) } else { None },
            enforcement_action: action
        }
    }

    /// Get current usage summary
    receive GetUsageSummary(tenant_id: TenantId) -> Map<String, i64> {
        self.current_usage.get(&tenant_id).cloned().unwrap_or_default()
    }

    /// Reset usage for new period
    receive ResetPeriodUsage(tenant_id: TenantId) {
        if let Some(usage) = self.current_usage.get_mut(&tenant_id) {
            // Keep absolute metrics (storage, users), reset periodic ones
            let to_reset = vec!["api_calls", "ai_tokens", "bandwidth", "emails_sent"];
            for metric in to_reset {
                usage.remove(metric);
            }
        }

        // Clear rate windows
        self.rate_windows.retain(|(tid, _), _| tid != &tenant_id);

        checkpoint();
    }

    // Internal methods

    fn get_current_value(&self, tenant_id: &TenantId, metric: &str) -> i64 {
        self.current_usage.get(tenant_id)
            .and_then(|u| u.get(metric))
            .cloned()
            .unwrap_or(0)
    }

    fn get_limit_value(&self, limits: &TenantLimits, name: &str) -> LimitValue {
        match name {
            "users" | "max_total_users" => limits.user_limits.max_total_users.clone(),
            "active_users" => limits.user_limits.max_active_users.clone(),
            "courses" => limits.content_limits.max_courses.clone(),
            "storage" => limits.storage_limits.total_storage_bytes.clone(),
            "api_per_minute" => limits.api_limits.requests_per_minute.clone(),
            "api_per_hour" => limits.api_limits.requests_per_hour.clone(),
            "api_per_day" => limits.api_limits.requests_per_day.clone(),
            "ai_tokens" => limits.feature_limits.ai_tokens_per_month.clone(),
            _ => {
                limits.custom_limits.get(name)
                    .cloned()
                    .unwrap_or(LimitValue::Unlimited)
            }
        }
    }
}

/// Rate limiting window
type RateWindow {
    start: DateTime,
    count: i64
}

// =============================================================================
// TESTS
// =============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_limit_value_exceeded() {
        let limit = LimitValue::Numeric { value: 100, unit: "items".to_string() };
        assert!(!limit.is_exceeded(50));
        assert!(limit.is_exceeded(100));
        assert!(limit.is_exceeded(150));
    }

    #[test]
    fn test_limit_remaining() {
        let limit = LimitValue::Numeric { value: 100, unit: "items".to_string() };
        assert_eq!(limit.remaining(50), 50);
        assert_eq!(limit.remaining(100), 0);
        assert_eq!(limit.remaining(150), 0);
    }

    #[test]
    fn test_tier_limits() {
        let free_limits = UserLimits::for_tier(&SubscriptionTier::Free);
        let enterprise_limits = UserLimits::for_tier(&SubscriptionTier::Enterprise);

        assert!(!free_limits.allow_sso);
        assert!(enterprise_limits.allow_sso);
    }
}
