            welcome_title: "Welcome Back".to_string(),
            welcome_subtitle: Some("Sign in to continue your learning journey".to_string()),
            show_social_login: true,
            show_remember_me: true,
            show_forgot_password: true,
            show_registration: true,
            custom_footer_html: None,
            form_position: FormPosition::Center,
            form_style: FormStyle::Card
        }
