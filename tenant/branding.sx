}

// =============================================================================
// BRANDING MANAGER
// =============================================================================

/// Branding management actor
actor BrandingManager {
    var brandings: Map<String, TenantBranding> = Map::new()
    var tenant_active_branding: Map<TenantId, String> = Map::new()
    var css_cache: Map<String, String> = Map::new()

    fn new() -> Self {
        BrandingManager::default()
    }

    /// Create branding for tenant
    receive CreateBranding(tenant_id: TenantId, name: String) -> TenantBranding {
        let mut branding = TenantBranding::default_for_tenant(tenant_id.clone());
        branding.name = name;

        // Set as active if first branding
        if !self.tenant_active_branding.contains_key(&tenant_id) {
            branding.is_active = true;
            self.tenant_active_branding.insert(tenant_id, branding.id.clone());
        } else {
            branding.is_active = false;
        }

        self.brandings.insert(branding.id.clone(), branding.clone());
        checkpoint();

        branding
    }

    /// Get branding by ID
    receive GetBranding(id: String) -> Option<TenantBranding> {
        self.brandings.get(&id).cloned()
    }

    /// Get active branding for tenant
    receive GetActiveBranding(tenant_id: TenantId) -> Option<TenantBranding> {
        self.tenant_active_branding.get(&tenant_id)
            .and_then(|id| self.brandings.get(id))
            .cloned()
    }

    /// List brandings for tenant
    receive ListBrandings(tenant_id: TenantId) -> List<TenantBranding> {
        self.brandings.values()
            .filter(|b| b.tenant_id == tenant_id)
            .cloned()
            .collect()
    }

    /// Update branding
    receive UpdateBranding(id: String, update: BrandingUpdate) -> Result<TenantBranding, TenantError> {
        let branding = self.brandings.get_mut(&id)
            .ok_or(TenantError::ConfigurationError {
                message: "Branding not found".to_string()
            })?;

        if let Some(name) = update.name {
            branding.name = name;
        }

        if let Some(logo) = update.logo {
            branding.logo = logo;
        }

        if let Some(favicon) = update.favicon {
            branding.favicon = favicon;
        }

        if let Some(colors) = update.colors {
            branding.colors = colors;
        }

        if let Some(typography) = update.typography {
            branding.typography = typography;
        }

        if let Some(layout) = update.layout {
            branding.layout = layout;
        }

        if let Some(login_page) = update.login_page {
            branding.login_page = login_page;
        }

        if let Some(email_branding) = update.email_branding {
            branding.email_branding = email_branding;
        }

        if let Some(css) = update.custom_css {
            branding.custom_css = Some(css);
        }

        if let Some(js) = update.custom_js {
            branding.custom_js = Some(js);
        }

        if let Some(social) = update.social_links {
            branding.social_links = social;
        }

        if let Some(footer) = update.footer {
            branding.footer = footer;
        }

        if let Some(seo) = update.seo {
            branding.seo = seo;
        }

        branding.updated_at = DateTime::now();

        // Invalidate CSS cache
        self.css_cache.remove(&id);

        let updated = branding.clone();
        checkpoint();

        Ok(updated)
    }

    /// Set active branding for tenant
    receive SetActiveBranding(tenant_id: TenantId, branding_id: String) -> Result<(), TenantError> {
        // Verify branding exists and belongs to tenant
        let branding = self.brandings.get(&branding_id)
            .ok_or(TenantError::ConfigurationError {
                message: "Branding not found".to_string()
            })?;

        if branding.tenant_id != tenant_id {
            return Err(TenantError::ConfigurationError {
                message: "Branding does not belong to tenant".to_string()
            });
        }

        // Deactivate current active branding
        if let Some(current_id) = self.tenant_active_branding.get(&tenant_id) {
            if let Some(current) = self.brandings.get_mut(current_id) {
                current.is_active = false;
            }
        }

        // Activate new branding
        if let Some(new_branding) = self.brandings.get_mut(&branding_id) {
            new_branding.is_active = true;
            new_branding.published_at = Some(DateTime::now());
        }

        self.tenant_active_branding.insert(tenant_id, branding_id);
        checkpoint();

        Ok(())
    }

    /// Get compiled CSS for branding
    receive GetCompiledCss(branding_id: String) -> Option<String> {
        // Check cache
        if let Some(css) = self.css_cache.get(&branding_id) {
            return Some(css.clone());
        }

        // Generate CSS
        if let Some(branding) = self.brandings.get(&branding_id) {
            let css = branding.generate_css_variables();
            self.css_cache.insert(branding_id, css.clone());
            return Some(css);
        }

        None
    }

    /// Delete branding
    receive DeleteBranding(id: String) -> Result<(), TenantError> {
        let branding = self.brandings.get(&id)
            .ok_or(TenantError::ConfigurationError {
                message: "Branding not found".to_string()
            })?;

        if branding.is_active {
            return Err(TenantError::ConfigurationError {
                message: "Cannot delete active branding".to_string()
            });
        }

        self.brandings.remove(&id);
        self.css_cache.remove(&id);
        checkpoint();

        Ok(())
    }

    /// Duplicate branding
    receive DuplicateBranding(id: String, new_name: String) -> Result<TenantBranding, TenantError> {
        let original = self.brandings.get(&id)
            .ok_or(TenantError::ConfigurationError {
                message: "Branding not found".to_string()
            })?
            .clone();

        let mut new_branding = original;
        new_branding.id = generate_uuid();
        new_branding.name = new_name;
        new_branding.is_active = false;
        new_branding.created_at = DateTime::now();
        new_branding.updated_at = DateTime::now();
        new_branding.published_at = None;

        self.brandings.insert(new_branding.id.clone(), new_branding.clone());
        checkpoint();

        Ok(new_branding)
    }

    /// Clear CSS cache
    receive ClearCache() {
        self.css_cache.clear();
    }
}

// =============================================================================
// SUPPORTING TYPES
// =============================================================================

/// Branding update request
type BrandingUpdate {
    name: Option<String>,
    logo: Option<LogoConfig>,
    favicon: Option<FaviconConfig>,
    colors: Option<ColorPalette>,
    typography: Option<TypographyConfig>,
    layout: Option<LayoutConfig>,
    login_page: Option<LoginPageConfig>,
    email_branding: Option<EmailBrandingConfig>,
    custom_css: Option<String>,
    custom_js: Option<String>,
    social_links: Option<SocialLinks>,
    footer: Option<FooterConfig>,
    seo: Option<SeoConfig>
}

/// Generate UUID
fn generate_uuid() -> String {
    std::uuid::v4()
}

// =============================================================================
// TESTS
// =============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_default_branding() {
        let tenant = TenantId("test".to_string());
        let branding = TenantBranding::default_for_tenant(tenant);

        assert_eq!(branding.name, "Default");
        assert!(branding.is_active);
        assert_eq!(branding.colors.primary, "#2563eb");
    }

    #[test]
    fn test_css_generation() {
        let tenant = TenantId("test".to_string());
        let branding = TenantBranding::default_for_tenant(tenant);
        let css = branding.generate_css_variables();

        assert!(css.contains("--color-primary: #2563eb"));
        assert!(css.contains("--font-family-primary:"));
    }

    #[test]
    fn test_color_palette() {
        let palette = ColorPalette::default();
        assert!(palette.dark_mode.is_some());
        assert_eq!(palette.success, "#10b981");
    }
}
