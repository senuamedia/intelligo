/// Intelligo LMS - Tenant Branding
///
/// Per-tenant branding configuration including logos, colors, typography,
/// custom CSS, and white-label domain settings.

module intelligo::tenant::branding

use intelligo::tenant::core::*
use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// BRANDING CONFIGURATION
// =============================================================================

/// Complete branding configuration for a tenant
type TenantBranding {
    /// Unique identifier
    id: String,

    /// Tenant ID this branding belongs to
    tenant_id: TenantId,

    /// Branding name (for multiple brand variants)
    name: String,

    /// Whether this is the active branding
    is_active: Bool,

    /// Logo configuration
    logo: LogoConfig,

    /// Favicon configuration
    favicon: FaviconConfig,

    /// Color palette
    colors: ColorPalette,

    /// Typography settings
    typography: TypographyConfig,

    /// Layout settings
    layout: LayoutConfig,

    /// Login page customization
    login_page: LoginPageConfig,

    /// Email branding
    email_branding: EmailBrandingConfig,

    /// Custom CSS
    custom_css: Option<String>,

    /// Custom JavaScript
    custom_js: Option<String>,

    /// Custom HTML for head section
    custom_head_html: Option<String>,

    /// Custom HTML for body start
    custom_body_start_html: Option<String>,

    /// Custom HTML for body end
    custom_body_end_html: Option<String>,

    /// Social media links
    social_links: SocialLinks,

    /// Footer configuration
    footer: FooterConfig,

    /// SEO metadata
    seo: SeoConfig,

    /// Created timestamp
    created_at: DateTime,

    /// Updated timestamp
    updated_at: DateTime,

    /// Last published timestamp
    published_at: Option<DateTime>
}

impl TenantBranding {
    /// Create default branding for tenant
    fn default_for_tenant(tenant_id: TenantId) -> TenantBranding {
        let now = DateTime::now();
        TenantBranding {
            id: generate_uuid(),
            tenant_id,
            name: "Default".to_string(),
            is_active: true,
            logo: LogoConfig::default(),
            favicon: FaviconConfig::default(),
            colors: ColorPalette::default(),
            typography: TypographyConfig::default(),
            layout: LayoutConfig::default(),
            login_page: LoginPageConfig::default(),
            email_branding: EmailBrandingConfig::default(),
            custom_css: None,
            custom_js: None,
            custom_head_html: None,
            custom_body_start_html: None,
            custom_body_end_html: None,
            social_links: SocialLinks::default(),
            footer: FooterConfig::default(),
            seo: SeoConfig::default(),
            created_at: now,
            updated_at: now,
            published_at: None
        }
    }

    /// Generate CSS variables from branding
    fn generate_css_variables(&self) -> String {
        let mut css = ":root {\n".to_string();

        // Colors
        css.push_str(&format!("  --color-primary: {};\n", self.colors.primary));
        css.push_str(&format!("  --color-primary-light: {};\n", self.colors.primary_light));
        css.push_str(&format!("  --color-primary-dark: {};\n", self.colors.primary_dark));
        css.push_str(&format!("  --color-secondary: {};\n", self.colors.secondary));
        css.push_str(&format!("  --color-secondary-light: {};\n", self.colors.secondary_light));
        css.push_str(&format!("  --color-secondary-dark: {};\n", self.colors.secondary_dark));
        css.push_str(&format!("  --color-accent: {};\n", self.colors.accent));
        css.push_str(&format!("  --color-success: {};\n", self.colors.success));
        css.push_str(&format!("  --color-warning: {};\n", self.colors.warning));
        css.push_str(&format!("  --color-error: {};\n", self.colors.error));
        css.push_str(&format!("  --color-info: {};\n", self.colors.info));
        css.push_str(&format!("  --color-text-primary: {};\n", self.colors.text_primary));
        css.push_str(&format!("  --color-text-secondary: {};\n", self.colors.text_secondary));
        css.push_str(&format!("  --color-text-disabled: {};\n", self.colors.text_disabled));
        css.push_str(&format!("  --color-background: {};\n", self.colors.background));
        css.push_str(&format!("  --color-surface: {};\n", self.colors.surface));
        css.push_str(&format!("  --color-border: {};\n", self.colors.border));

        // Typography
        css.push_str(&format!("  --font-family-primary: {};\n", self.typography.font_family_primary));
        css.push_str(&format!("  --font-family-secondary: {};\n", self.typography.font_family_secondary));
        css.push_str(&format!("  --font-family-mono: {};\n", self.typography.font_family_mono));
        css.push_str(&format!("  --font-size-base: {};\n", self.typography.font_size_base));
        css.push_str(&format!("  --line-height-base: {};\n", self.typography.line_height_base));

        // Layout
        css.push_str(&format!("  --border-radius: {};\n", self.layout.border_radius));
        css.push_str(&format!("  --spacing-unit: {};\n", self.layout.spacing_unit));
        css.push_str(&format!("  --container-max-width: {};\n", self.layout.container_max_width));

        css.push_str("}\n");

        // Dark mode overrides
        if let Some(ref dark) = self.colors.dark_mode {
            css.push_str("\n@media (prefers-color-scheme: dark) {\n");
            css.push_str("  :root {\n");
            css.push_str(&format!("    --color-text-primary: {};\n", dark.text_primary));
            css.push_str(&format!("    --color-text-secondary: {};\n", dark.text_secondary));
            css.push_str(&format!("    --color-background: {};\n", dark.background));
            css.push_str(&format!("    --color-surface: {};\n", dark.surface));
            css.push_str(&format!("    --color-border: {};\n", dark.border));
            css.push_str("  }\n");
            css.push_str("}\n");
        }

        // Custom CSS
        if let Some(ref custom) = self.custom_css {
            css.push_str("\n/* Custom CSS */\n");
            css.push_str(custom);
        }

        css
    }
}

// =============================================================================
// LOGO CONFIGURATION
// =============================================================================

/// Logo configuration
type LogoConfig {
    /// Primary logo URL
    primary: Option<String>,

    /// Light version (for dark backgrounds)
    light: Option<String>,

    /// Dark version (for light backgrounds)
    dark: Option<String>,

    /// Icon/square version
    icon: Option<String>,

    /// Logo alt text
    alt_text: String,

    /// Logo width (CSS value)
    width: String,

    /// Logo height (CSS value)
    height: String,

    /// Logo padding
    padding: String
}

impl Default for LogoConfig {
    fn default() -> Self {
        LogoConfig {
            primary: None,
            light: None,
            dark: None,
            icon: None,
            alt_text: "Logo".to_string(),
            width: "auto".to_string(),
            height: "40px".to_string(),
            padding: "0".to_string()
        }
    }
}

/// Favicon configuration
type FaviconConfig {
    /// ICO favicon
    ico: Option<String>,

    /// 16x16 PNG
    png_16: Option<String>,

    /// 32x32 PNG
    png_32: Option<String>,

    /// 180x180 Apple touch icon
    apple_touch: Option<String>,

    /// 192x192 Android icon
    android_192: Option<String>,

    /// 512x512 Android icon
    android_512: Option<String>,

    /// Safari pinned tab SVG
    safari_pinned: Option<String>,

    /// Safari pinned tab color
    safari_pinned_color: String,

    /// MS tile color
    ms_tile_color: String
}

impl Default for FaviconConfig {
    fn default() -> Self {
        FaviconConfig {
            ico: None,
            png_16: None,
            png_32: None,
            apple_touch: None,
            android_192: None,
            android_512: None,
            safari_pinned: None,
            safari_pinned_color: "#000000".to_string(),
            ms_tile_color: "#ffffff".to_string()
        }
    }
}

