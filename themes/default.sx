/// Default typography
fn default_typography() -> ThemeTypography {
    ThemeTypography {
        font_family: FontFamilies {
            sans: "'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif".to_string(),
            serif: "ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif".to_string(),
            mono: "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace".to_string()
        },
        font_sizes: FontSizes {
            xs: "0.75rem".to_string(),    // 12px
            sm: "0.875rem".to_string(),   // 14px
            base: "1rem".to_string(),     // 16px
            lg: "1.125rem".to_string(),   // 18px
            xl: "1.25rem".to_string(),    // 20px
            xl2: "1.5rem".to_string(),    // 24px
            xl3: "1.875rem".to_string(),  // 30px
            xl4: "2.25rem".to_string(),   // 36px
            xl5: "3rem".to_string(),      // 48px
            xl6: "3.75rem".to_string()    // 60px
        },
        font_weights: FontWeights::default(),
        line_heights: LineHeights::default(),
        letter_spacing: LetterSpacing::default()
    }
}

/// Default borders
fn default_borders() -> ThemeBorders {
    ThemeBorders {
        radius: BorderRadius {
            none: "0".to_string(),
            sm: "0.125rem".to_string(),   // 2px
            default: "0.25rem".to_string(), // 4px
            md: "0.375rem".to_string(),   // 6px
            lg: "0.5rem".to_string(),     // 8px
            xl: "0.75rem".to_string(),    // 12px
            xl2: "1rem".to_string(),      // 16px
            xl3: "1.5rem".to_string(),    // 24px
            full: "9999px".to_string()
        },
        width: BorderWidth::default()
    }
}

/// Default shadows
fn default_shadows() -> ThemeShadows {
    ThemeShadows {
        sm: "0 1px 2px 0 rgb(0 0 0 / 0.05)".to_string(),
        default: "0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1)".to_string(),
        md: "0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1)".to_string(),
        lg: "0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1)".to_string(),
        xl: "0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1)".to_string(),
        xl2: "0 25px 50px -12px rgb(0 0 0 / 0.25)".to_string(),
        inner: "inset 0 2px 4px 0 rgb(0 0 0 / 0.05)".to_string(),
        none: "none".to_string()
    }
}

/// Default animations
fn default_animations() -> ThemeAnimations {
    ThemeAnimations {
        enabled: true,
        duration_default: "150ms".to_string(),
        duration_75: "75ms".to_string(),
        duration_100: "100ms".to_string(),
        duration_150: "150ms".to_string(),
        duration_200: "200ms".to_string(),
        duration_300: "300ms".to_string(),
        duration_500: "500ms".to_string(),
        duration_700: "700ms".to_string(),
        duration_1000: "1000ms".to_string(),
        ease_linear: "linear".to_string(),
        ease_in: "cubic-bezier(0.4, 0, 1, 1)".to_string(),
        ease_out: "cubic-bezier(0, 0, 0.2, 1)".to_string(),
        ease_in_out: "cubic-bezier(0.4, 0, 0.2, 1)".to_string()
    }
}

/// Default component styles
fn default_components() -> Map<String, ComponentStyle> {
    let mut components = Map::new();

    // Button component
    components.insert("button".to_string(), ComponentStyle {
        css: r#"
.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    line-height: var(--leading-normal);
    border-radius: var(--radius-md);
    transition: all var(--duration-150) var(--ease-in-out);
    cursor: pointer;
    user-select: none;
}

.btn:focus {
    outline: 2px solid var(--primary-500);
    outline-offset: 2px;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}
"#.to_string(),
        variables: Map::new(),
        variants: {
            let mut v = Map::new();
            v.insert("primary".to_string(), r#"
    background-color: var(--primary-600);
    color: white;
}
.btn-primary:hover {
    background-color: var(--primary-700);
"#.to_string());
            v.insert("secondary".to_string(), r#"
    background-color: var(--neutral-100);
    color: var(--neutral-700);
}
.btn-secondary:hover {
    background-color: var(--neutral-200);
"#.to_string());
            v.insert("outline".to_string(), r#"
    background-color: transparent;
    border: 1px solid var(--primary-600);
    color: var(--primary-600);
}
.btn-outline:hover {
    background-color: var(--primary-50);
"#.to_string());
            v
        }
    });

    // Card component
    components.insert("card".to_string(), ComponentStyle {
        css: r#"
.card {
    background-color: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-default);
    box-shadow: var(--shadow-sm);
}

.card-header {
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border-default);
}

.card-body {
    padding: var(--space-6);
}

.card-footer {
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--border-default);
    background-color: var(--bg-secondary);
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Input component
    components.insert("input".to_string(), ComponentStyle {
        css: r#"
.input {
    display: block;
    width: 100%;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--text-primary);
    background-color: var(--bg-surface);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-150) var(--ease-in-out),
                box-shadow var(--duration-150) var(--ease-in-out);
}

.input:focus {
    outline: none;
    border-color: var(--primary-500);
    box-shadow: 0 0 0 3px var(--primary-100);
}

.input:disabled {
    background-color: var(--bg-tertiary);
    cursor: not-allowed;
}

.input::placeholder {
    color: var(--text-tertiary);
}

.input-error {
    border-color: var(--error-500);
}

.input-error:focus {
    box-shadow: 0 0 0 3px var(--error-100);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Badge component
    components.insert("badge".to_string(), ComponentStyle {
        css: r#"
.badge {
    display: inline-flex;
    align-items: center;
    padding: var(--space-0-5) var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--font-medium);
    line-height: var(--leading-tight);
    border-radius: var(--radius-full);
}

.badge-primary {
    background-color: var(--primary-100);
    color: var(--primary-700);
}

.badge-success {
    background-color: var(--success-100);
    color: var(--success-700);
}

.badge-warning {
    background-color: var(--warning-100);
    color: var(--warning-700);
}

.badge-error {
    background-color: var(--error-100);
    color: var(--error-700);
}

.badge-neutral {
    background-color: var(--neutral-100);
    color: var(--neutral-700);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Alert component
    components.insert("alert".to_string(), ComponentStyle {
        css: r#"
.alert {
    display: flex;
    padding: var(--space-4);
    border-radius: var(--radius-md);
    border: 1px solid;
}

.alert-icon {
    flex-shrink: 0;
    margin-right: var(--space-3);
}

.alert-info {
    background-color: var(--info-50);
    border-color: var(--info-200);
    color: var(--info-800);
}

.alert-success {
    background-color: var(--success-50);
    border-color: var(--success-200);
    color: var(--success-800);
}

.alert-warning {
    background-color: var(--warning-50);
    border-color: var(--warning-200);
    color: var(--warning-800);
}

.alert-error {
    background-color: var(--error-50);
    border-color: var(--error-200);
    color: var(--error-800);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Navigation component
    components.insert("nav".to_string(), ComponentStyle {
        css: r#"
.nav-link {
    display: flex;
    align-items: center;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    border-radius: var(--radius-md);
    transition: all var(--duration-150) var(--ease-in-out);
}

.nav-link:hover {
    background-color: var(--neutral-100);
    color: var(--text-primary);
}

.nav-link-active {
    background-color: var(--primary-50);
    color: var(--primary-700);
}

.nav-link-icon {
    margin-right: var(--space-3);
    color: var(--text-tertiary);
}

.nav-link:hover .nav-link-icon,
.nav-link-active .nav-link-icon {
    color: inherit;
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Table component
    components.insert("table".to_string(), ComponentStyle {
        css: r#"
.table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
}

.table th {
    padding: var(--space-3) var(--space-4);
    text-align: left;
    font-weight: var(--font-medium);
    color: var(--text-secondary);
    background-color: var(--bg-secondary);
    border-bottom: 1px solid var(--border-default);
}

.table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--border-subtle);
}

.table tr:hover td {
    background-color: var(--bg-secondary);
}

.table-striped tr:nth-child(even) td {
    background-color: var(--bg-secondary);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Modal component
    components.insert("modal".to_string(), ComponentStyle {
        css: r#"
.modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 50;
}

.modal {
    background-color: var(--bg-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    max-width: 32rem;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
}

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-4) var(--space-6);
    border-bottom: 1px solid var(--border-default);
}

.modal-title {
    font-size: var(--text-lg);
    font-weight: var(--font-semibold);
    color: var(--text-primary);
}

.modal-body {
    padding: var(--space-6);
}

.modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    border-top: 1px solid var(--border-default);
    background-color: var(--bg-secondary);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    // Progress component
    components.insert("progress".to_string(), ComponentStyle {
        css: r#"
.progress {
    width: 100%;
    height: 0.5rem;
    background-color: var(--neutral-200);
    border-radius: var(--radius-full);
    overflow: hidden;
}

.progress-bar {
    height: 100%;
    background-color: var(--primary-600);
    border-radius: var(--radius-full);
    transition: width var(--duration-300) var(--ease-out);
}

.progress-success .progress-bar {
    background-color: var(--success-600);
}

.progress-warning .progress-bar {
    background-color: var(--warning-600);
}

.progress-error .progress-bar {
    background-color: var(--error-600);
}
"#.to_string(),
        variables: Map::new(),
        variants: Map::new()
    });

    components
}

// =============================================================================
// TESTS
// =============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_create_default_theme() {
        let theme = create_default_theme();
        assert_eq!(theme.name, "Intelligo Default");
        assert!(theme.is_system);
        assert!(!theme.colors.primary.c500.is_empty());
    }

    #[test]
    fn test_default_colors() {
        let colors = default_colors();
        assert_eq!(colors.primary.c600, "#2563eb");
        assert_eq!(colors.success.c500, "#10b981");
    }

    #[test]
    fn test_theme_css_generation() {
        let theme = create_default_theme();
        let css = theme.to_css();
        assert!(css.contains("--primary-500"));
        assert!(css.contains("--bg-primary"));
    }
}
