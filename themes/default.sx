/// Intelligo LMS - Default Theme
///
/// The default light theme for Intelligo LMS with professional blue
/// color scheme and clean typography.

module intelligo::themes::default

use intelligo::themes::core::*
use std::collections::{Map, Set}
use std::time::DateTime

// =============================================================================
// DEFAULT THEME
// =============================================================================

/// Create the default light theme
pub fn create_default_theme() -> Theme {
    let mut theme = Theme::new(
        "Intelligo Default".to_string(),
        "intelligo-default".to_string(),
        ThemeType::Light
    );

    theme.description = Some("The default Intelligo LMS theme with a professional blue color scheme.".to_string());
    theme.author = Some("Intelligo Team".to_string());
    theme.version = "1.0.0".to_string();
    theme.is_system = true;

    // Set colors
    theme.colors = default_colors();

    // Set typography
    theme.typography = default_typography();

    // Set spacing
    theme.spacing = ThemeSpacing::default();

    // Set borders
    theme.borders = default_borders();

    // Set shadows
    theme.shadows = default_shadows();

    // Set animations
    theme.animations = default_animations();

    // Set component overrides
    theme.components = default_components();

    theme
}

