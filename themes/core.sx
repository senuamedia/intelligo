/// Intelligo LMS - Theme Core
///
/// Core theme entity definitions, theme context management, and
/// theme resolution for the learning management system.

module intelligo::themes::core

use intelligo::core::types::*
use intelligo::tenant::core::TenantId
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// THEME ENTITY
// =============================================================================

/// Complete theme definition
type Theme {
    /// Unique identifier
    id: ThemeId,

    /// Theme name
    name: String,

    /// Theme slug
    slug: String,

    /// Theme description
    description: Option<String>,

    /// Theme type
    theme_type: ThemeType,

    /// Color scheme
    colors: ThemeColors,

    /// Typography
    typography: ThemeTypography,

    /// Spacing system
    spacing: ThemeSpacing,

    /// Border styles
    borders: ThemeBorders,

    /// Shadow definitions
    shadows: ThemeShadows,

    /// Animation settings
    animations: ThemeAnimations,

    /// Component overrides
    components: Map<String, ComponentStyle>,

    /// Preview image URL
    preview_image: Option<String>,

    /// Author
    author: Option<String>,

    /// Version
    version: String,

    /// Parent theme (for inheritance)
    parent_id: Option<ThemeId>,

    /// Is system theme (cannot be modified)
    is_system: Bool,

    /// Is active
    is_active: Bool,

    /// Created at
    created_at: DateTime,

    /// Updated at
    updated_at: DateTime,

    /// Metadata
    metadata: Map<String, Dynamic>
}

impl Theme {
    fn new(name: String, slug: String, theme_type: ThemeType) -> Theme {
        let now = DateTime::now();
        Theme {
            id: ThemeId(generate_uuid()),
            name,
            slug,
            description: None,
            theme_type,
            colors: ThemeColors::default(),
            typography: ThemeTypography::default(),
            spacing: ThemeSpacing::default(),
            borders: ThemeBorders::default(),
            shadows: ThemeShadows::default(),
            animations: ThemeAnimations::default(),
            components: Map::new(),
            preview_image: None,
            author: None,
            version: "1.0.0".to_string(),
            parent_id: None,
            is_system: false,
            is_active: true,
            created_at: now,
            updated_at: now,
            metadata: Map::new()
        }
    }

    /// Generate CSS from theme
    fn to_css(&self) -> String {
        let mut css = String::new();

        // Root variables
        css.push_str(":root {\n");
        css.push_str(&self.colors.to_css_vars());
        css.push_str(&self.typography.to_css_vars());
        css.push_str(&self.spacing.to_css_vars());
        css.push_str(&self.borders.to_css_vars());
        css.push_str(&self.shadows.to_css_vars());
        css.push_str(&self.animations.to_css_vars());
        css.push_str("}\n");

        // Component styles
        for (component, style) in &self.components {
            css.push_str(&format!("\n/* {} */\n", component));
            css.push_str(&style.to_css());
        }

        css
    }

    /// Merge with parent theme
    fn merge_with_parent(&self, parent: &Theme) -> Theme {
        let mut merged = parent.clone();
        merged.id = self.id.clone();
        merged.name = self.name.clone();
        merged.slug = self.slug.clone();
        merged.parent_id = Some(parent.id.clone());

        // Merge colors (self overrides parent)
        merged.colors = self.colors.merge_with(&parent.colors);

        // Merge typography
        merged.typography = self.typography.merge_with(&parent.typography);

        // Merge component overrides
        for (key, style) in &self.components {
            merged.components.insert(key.clone(), style.clone());
        }

        merged
    }
}

/// Theme identifier
type ThemeId = String;

/// Theme type
enum ThemeType {
    /// Light theme
    Light,
    /// Dark theme
    Dark,
    /// High contrast for accessibility
    HighContrast,
    /// Auto (follows system preference)
    Auto,
    /// Custom
    Custom
}

impl ThemeType {
    fn to_string(&self) -> String {
        match self {
            ThemeType::Light => "light",
            ThemeType::Dark => "dark",
            ThemeType::HighContrast => "high_contrast",
            ThemeType::Auto => "auto",
            ThemeType::Custom => "custom"
        }.to_string()
    }

    fn from_string(s: &str) -> Option<ThemeType> {
        match s {
            "light" => Some(ThemeType::Light),
            "dark" => Some(ThemeType::Dark),
            "high_contrast" => Some(ThemeType::HighContrast),
            "auto" => Some(ThemeType::Auto),
            "custom" => Some(ThemeType::Custom),
            _ => None
        }
    }
}

// =============================================================================
// THEME COLORS
// =============================================================================

/// Theme color definitions
type ThemeColors {
    /// Primary brand color
    primary: ColorScale,

    /// Secondary brand color
    secondary: ColorScale,

    /// Accent color
    accent: ColorScale,

    /// Neutral/gray colors
    neutral: ColorScale,

    /// Success color
    success: ColorScale,

    /// Warning color
    warning: ColorScale,

    /// Error/danger color
    error: ColorScale,

    /// Info color
    info: ColorScale,

    /// Background colors
    background: BackgroundColors,

    /// Text colors
    text: TextColors,

    /// Border colors
    border: BorderColors
}

impl Default for ThemeColors {
    fn default() -> Self {
        ThemeColors {
            primary: ColorScale::from_hex("#2563eb"),
            secondary: ColorScale::from_hex("#7c3aed"),
            accent: ColorScale::from_hex("#f59e0b"),
            neutral: ColorScale::from_hex("#6b7280"),
            success: ColorScale::from_hex("#10b981"),
            warning: ColorScale::from_hex("#f59e0b"),
            error: ColorScale::from_hex("#ef4444"),
            info: ColorScale::from_hex("#3b82f6"),
            background: BackgroundColors::default(),
            text: TextColors::default(),
            border: BorderColors::default()
        }
    }
}

impl ThemeColors {
    fn to_css_vars(&self) -> String {
        let mut css = String::new();

        css.push_str(&self.primary.to_css_vars("primary"));
        css.push_str(&self.secondary.to_css_vars("secondary"));
        css.push_str(&self.accent.to_css_vars("accent"));
        css.push_str(&self.neutral.to_css_vars("neutral"));
        css.push_str(&self.success.to_css_vars("success"));
        css.push_str(&self.warning.to_css_vars("warning"));
        css.push_str(&self.error.to_css_vars("error"));
        css.push_str(&self.info.to_css_vars("info"));

        css.push_str(&format!("  --bg-primary: {};\n", self.background.primary));
        css.push_str(&format!("  --bg-secondary: {};\n", self.background.secondary));
        css.push_str(&format!("  --bg-tertiary: {};\n", self.background.tertiary));
        css.push_str(&format!("  --bg-surface: {};\n", self.background.surface));
        css.push_str(&format!("  --bg-elevated: {};\n", self.background.elevated));

        css.push_str(&format!("  --text-primary: {};\n", self.text.primary));
        css.push_str(&format!("  --text-secondary: {};\n", self.text.secondary));
        css.push_str(&format!("  --text-tertiary: {};\n", self.text.tertiary));
        css.push_str(&format!("  --text-disabled: {};\n", self.text.disabled));
        css.push_str(&format!("  --text-inverse: {};\n", self.text.inverse));

        css.push_str(&format!("  --border-default: {};\n", self.border.default));
        css.push_str(&format!("  --border-subtle: {};\n", self.border.subtle));
        css.push_str(&format!("  --border-strong: {};\n", self.border.strong));

        css
    }

    fn merge_with(&self, parent: &ThemeColors) -> ThemeColors {
        ThemeColors {
            primary: self.primary.clone(),
            secondary: self.secondary.clone(),
            accent: self.accent.clone(),
            neutral: self.neutral.clone(),
            success: self.success.clone(),
            warning: self.warning.clone(),
            error: self.error.clone(),
            info: self.info.clone(),
            background: self.background.clone(),
            text: self.text.clone(),
            border: self.border.clone()
        }
    }
}

/// Color scale (50-950)
type ColorScale {
    c50: String,
    c100: String,
    c200: String,
    c300: String,
    c400: String,
    c500: String,
    c600: String,
    c700: String,
    c800: String,
    c900: String,
    c950: String
}

impl ColorScale {
    fn from_hex(base: &str) -> ColorScale {
        // Generate color scale from base color
        // Simplified - would use proper color manipulation
        ColorScale {
            c50: lighten(base, 0.95),
            c100: lighten(base, 0.9),
            c200: lighten(base, 0.8),
            c300: lighten(base, 0.6),
            c400: lighten(base, 0.4),
            c500: base.to_string(),
            c600: darken(base, 0.1),
            c700: darken(base, 0.2),
            c800: darken(base, 0.3),
            c900: darken(base, 0.4),
            c950: darken(base, 0.5)
        }
    }

    fn to_css_vars(&self, name: &str) -> String {
        format!(
            r#"  --{}-50: {};
  --{}-100: {};
  --{}-200: {};
  --{}-300: {};
  --{}-400: {};
  --{}-500: {};
  --{}-600: {};
  --{}-700: {};
  --{}-800: {};
  --{}-900: {};
  --{}-950: {};
"#,
            name, self.c50,
            name, self.c100,
            name, self.c200,
            name, self.c300,
            name, self.c400,
            name, self.c500,
            name, self.c600,
            name, self.c700,
            name, self.c800,
            name, self.c900,
            name, self.c950
        )
    }
}

