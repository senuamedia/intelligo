// =============================================================================
// THEME TYPOGRAPHY
// =============================================================================

/// Typography settings
type ThemeTypography {
    /// Font families
    font_family: FontFamilies,

    /// Font sizes
    font_sizes: FontSizes,

    /// Font weights
    font_weights: FontWeights,

    /// Line heights
    line_heights: LineHeights,

    /// Letter spacing
    letter_spacing: LetterSpacing
}

impl Default for ThemeTypography {
    fn default() -> Self {
        ThemeTypography {
            font_family: FontFamilies::default(),
            font_sizes: FontSizes::default(),
            font_weights: FontWeights::default(),
            line_heights: LineHeights::default(),
            letter_spacing: LetterSpacing::default()
        }
    }
}

impl ThemeTypography {
    fn to_css_vars(&self) -> String {
        let mut css = String::new();

        css.push_str(&format!("  --font-sans: {};\n", self.font_family.sans));
        css.push_str(&format!("  --font-serif: {};\n", self.font_family.serif));
        css.push_str(&format!("  --font-mono: {};\n", self.font_family.mono));

        css.push_str(&format!("  --text-xs: {};\n", self.font_sizes.xs));
        css.push_str(&format!("  --text-sm: {};\n", self.font_sizes.sm));
        css.push_str(&format!("  --text-base: {};\n", self.font_sizes.base));
        css.push_str(&format!("  --text-lg: {};\n", self.font_sizes.lg));
        css.push_str(&format!("  --text-xl: {};\n", self.font_sizes.xl));
        css.push_str(&format!("  --text-2xl: {};\n", self.font_sizes.xl2));
        css.push_str(&format!("  --text-3xl: {};\n", self.font_sizes.xl3));
        css.push_str(&format!("  --text-4xl: {};\n", self.font_sizes.xl4));

        css.push_str(&format!("  --font-thin: {};\n", self.font_weights.thin));
        css.push_str(&format!("  --font-light: {};\n", self.font_weights.light));
        css.push_str(&format!("  --font-normal: {};\n", self.font_weights.normal));
        css.push_str(&format!("  --font-medium: {};\n", self.font_weights.medium));
        css.push_str(&format!("  --font-semibold: {};\n", self.font_weights.semibold));
        css.push_str(&format!("  --font-bold: {};\n", self.font_weights.bold));

        css.push_str(&format!("  --leading-none: {};\n", self.line_heights.none));
        css.push_str(&format!("  --leading-tight: {};\n", self.line_heights.tight));
        css.push_str(&format!("  --leading-normal: {};\n", self.line_heights.normal));
        css.push_str(&format!("  --leading-relaxed: {};\n", self.line_heights.relaxed));
        css.push_str(&format!("  --leading-loose: {};\n", self.line_heights.loose));

        css
    }

    fn merge_with(&self, _parent: &ThemeTypography) -> ThemeTypography {
        self.clone()
    }
}

