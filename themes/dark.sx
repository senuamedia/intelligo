    badge.insert("primary_bg".to_string(), "#1e3a5f".to_string())
    badge.insert("primary_text".to_string(), "#93c5fd".to_string())
    badge.insert("secondary_bg".to_string(), "#2d1b4e".to_string())
    badge.insert("secondary_text".to_string(), "#c4b5fd".to_string())
    badge.insert("success_bg".to_string(), "#064e3b".to_string())
    badge.insert("success_text".to_string(), "#6ee7b7".to_string())
    badge.insert("warning_bg".to_string(), "#78350f".to_string())
    badge.insert("warning_text".to_string(), "#fcd34d".to_string())
    badge.insert("error_bg".to_string(), "#7f1d1d".to_string())
    badge.insert("error_text".to_string(), "#fca5a5".to_string())
