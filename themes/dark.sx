/// Create dark theme typography
fn create_dark_typography() -> ThemeTypography {
    ThemeTypography {
        font_family_sans: "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif".to_string(),
        font_family_serif: "'Merriweather', Georgia, 'Times New Roman', serif".to_string(),
        font_family_mono: "'JetBrains Mono', 'Fira Code', 'SF Mono', Consolas, monospace".to_string(),

        font_size_xs: "0.75rem".to_string(),
        font_size_sm: "0.875rem".to_string(),
        font_size_base: "1rem".to_string(),
        font_size_lg: "1.125rem".to_string(),
        font_size_xl: "1.25rem".to_string(),
        font_size_2xl: "1.5rem".to_string(),
        font_size_3xl: "1.875rem".to_string(),
        font_size_4xl: "2.25rem".to_string(),
        font_size_5xl: "3rem".to_string(),

        font_weight_light: "300".to_string(),
        font_weight_normal: "400".to_string(),
        font_weight_medium: "500".to_string(),
        font_weight_semibold: "600".to_string(),
        font_weight_bold: "700".to_string(),

        line_height_tight: "1.25".to_string(),
        line_height_normal: "1.5".to_string(),
        line_height_relaxed: "1.75".to_string(),

        letter_spacing_tight: "-0.025em".to_string(),
        letter_spacing_normal: "0".to_string(),
        letter_spacing_wide: "0.05em".to_string(),
    }
}

/// Create dark theme spacing (same as default)
fn create_dark_spacing() -> ThemeSpacing {
    ThemeSpacing {
        xs: "0.25rem".to_string(),
        sm: "0.5rem".to_string(),
        md: "1rem".to_string(),
        lg: "1.5rem".to_string(),
        xl: "2rem".to_string(),
        xxl: "3rem".to_string(),
        xxxl: "4rem".to_string(),
    }
}

/// Create dark theme borders
fn create_dark_borders() -> ThemeBorders {
    ThemeBorders {
        radius_none: "0".to_string(),
        radius_sm: "0.25rem".to_string(),
        radius_md: "0.5rem".to_string(),
        radius_lg: "0.75rem".to_string(),
        radius_xl: "1rem".to_string(),
        radius_2xl: "1.5rem".to_string(),
        radius_full: "9999px".to_string(),

        width_thin: "1px".to_string(),
        width_medium: "2px".to_string(),
        width_thick: "4px".to_string(),
    }
}

/// Create dark theme shadows - adjusted for dark mode
fn create_dark_shadows() -> ThemeShadows {
    ThemeShadows {
        // Dark mode shadows use darker colors and subtle glows
        none: "none".to_string(),
        sm: "0 1px 2px 0 rgba(0, 0, 0, 0.3)".to_string(),
        md: "0 4px 6px -1px rgba(0, 0, 0, 0.4), 0 2px 4px -2px rgba(0, 0, 0, 0.3)".to_string(),
        lg: "0 10px 15px -3px rgba(0, 0, 0, 0.5), 0 4px 6px -4px rgba(0, 0, 0, 0.4)".to_string(),
        xl: "0 20px 25px -5px rgba(0, 0, 0, 0.6), 0 8px 10px -6px rgba(0, 0, 0, 0.5)".to_string(),
        xxl: "0 25px 50px -12px rgba(0, 0, 0, 0.7)".to_string(),
        inner: "inset 0 2px 4px 0 rgba(0, 0, 0, 0.4)".to_string(),
        glow: "0 0 15px rgba(59, 130, 246, 0.3)".to_string(), // Blue glow for focus states
    }
}

/// Create dark theme animations (same as default)
fn create_dark_animations() -> ThemeAnimations {
    ThemeAnimations {
        duration_fast: "100ms".to_string(),
        duration_normal: "200ms".to_string(),
        duration_slow: "300ms".to_string(),
        duration_slower: "500ms".to_string(),

        easing_default: "cubic-bezier(0.4, 0, 0.2, 1)".to_string(),
        easing_in: "cubic-bezier(0.4, 0, 1, 1)".to_string(),
        easing_out: "cubic-bezier(0, 0, 0.2, 1)".to_string(),
        easing_in_out: "cubic-bezier(0.4, 0, 0.2, 1)".to_string(),
        easing_bounce: "cubic-bezier(0.68, -0.55, 0.265, 1.55)".to_string(),
    }
}

/// Create dark theme component styles
fn create_dark_component_styles() -> Map<String, Map<String, String>> {
    let mut styles = Map::new()

    // Button styles
    let mut button = Map::new()
    button.insert("primary_bg".to_string(), "#3b82f6".to_string())
    button.insert("primary_hover".to_string(), "#60a5fa".to_string())
    button.insert("primary_active".to_string(), "#2563eb".to_string())
    button.insert("primary_text".to_string(), "#ffffff".to_string())
    button.insert("secondary_bg".to_string(), "#334155".to_string())
    button.insert("secondary_hover".to_string(), "#475569".to_string())
    button.insert("secondary_active".to_string(), "#1e293b".to_string())
    button.insert("secondary_text".to_string(), "#f1f5f9".to_string())
    button.insert("ghost_hover".to_string(), "#1e293b".to_string())
    button.insert("ghost_text".to_string(), "#94a3b8".to_string())
    button.insert("danger_bg".to_string(), "#dc2626".to_string())
    button.insert("danger_hover".to_string(), "#ef4444".to_string())
    button.insert("danger_text".to_string(), "#ffffff".to_string())
    button.insert("disabled_bg".to_string(), "#1e293b".to_string())
    button.insert("disabled_text".to_string(), "#475569".to_string())
    styles.insert("button".to_string(), button)

    // Card styles
    let mut card = Map::new()
    card.insert("bg".to_string(), "#1e293b".to_string())
    card.insert("bg_hover".to_string(), "#334155".to_string())
    card.insert("border".to_string(), "#334155".to_string())
    card.insert("shadow".to_string(), "0 4px 6px -1px rgba(0, 0, 0, 0.4)".to_string())
    card.insert("header_bg".to_string(), "#0f172a".to_string())
    card.insert("footer_bg".to_string(), "#0f172a".to_string())
    styles.insert("card".to_string(), card)

    // Input styles
    let mut input = Map::new()
