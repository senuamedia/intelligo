/// Intelligo LMS - Dark Theme
///
/// Dark mode theme with carefully selected colors for reduced eye strain
/// and excellent contrast ratios for accessibility.

module intelligo::themes::dark

use intelligo::themes::core::*

/// Create the dark theme
pub fn create_dark_theme() -> Theme {
    Theme {
        id: "dark".to_string(),
        name: "Intelligo Dark".to_string(),
        description: "Dark theme optimized for low-light environments".to_string(),
        colors: create_dark_colors(),
        typography: create_dark_typography(),
        spacing: create_dark_spacing(),
        borders: create_dark_borders(),
        shadows: create_dark_shadows(),
        animations: create_dark_animations(),
        component_styles: create_dark_component_styles(),
        is_dark_mode: true,
    }
}

