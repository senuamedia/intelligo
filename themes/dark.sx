    alert.insert("info_border".to_string(), "#0891b2".to_string())
    alert.insert("info_text".to_string(), "#67e8f9".to_string())
    alert.insert("success_bg".to_string(), "#064e3b".to_string())
    alert.insert("success_border".to_string(), "#059669".to_string())
    alert.insert("success_text".to_string(), "#6ee7b7".to_string())
    alert.insert("warning_bg".to_string(), "#78350f".to_string())
