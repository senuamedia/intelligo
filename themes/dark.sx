    // Tooltip styles
    let mut tooltip = Map::new()
    tooltip.insert("bg".to_string(), "#f1f5f9".to_string())
    tooltip.insert("text".to_string(), "#0f172a".to_string())
    tooltip.insert("shadow".to_string(), "0 4px 6px -1px rgba(0, 0, 0, 0.4)".to_string())
    styles.insert("tooltip".to_string(), tooltip)

    // Dropdown styles
    let mut dropdown = Map::new()
    dropdown.insert("bg".to_string(), "#1e293b".to_string())
    dropdown.insert("border".to_string(), "#334155".to_string())
    dropdown.insert("shadow".to_string(), "0 10px 15px -3px rgba(0, 0, 0, 0.5)".to_string())
    dropdown.insert("item_text".to_string(), "#f1f5f9".to_string())
    dropdown.insert("item_hover_bg".to_string(), "#334155".to_string())
    dropdown.insert("item_active_bg".to_string(), "#1e3a5f".to_string())
    dropdown.insert("item_disabled_text".to_string(), "#475569".to_string())
    dropdown.insert("divider".to_string(), "#334155".to_string())
    styles.insert("dropdown".to_string(), dropdown)

    // Code block styles
    let mut code = Map::new()
    code.insert("bg".to_string(), "#0f172a".to_string())
