/// Get CSS custom properties for dark theme
pub fn get_dark_theme_css() -> String {
    let theme = create_dark_theme()
    theme.to_css()
}

/// Check if system prefers dark mode
pub fn system_prefers_dark() -> bool {
    // Check system preference (would be injected from browser/OS)
    env::get("PREFERS_COLOR_SCHEME").unwrap_or("light".to_string()) == "dark"
}

/// Apply dark theme to document
pub fn apply_dark_theme() {
    let css = get_dark_theme_css()
    // Inject CSS variables into document root
    dom::set_css_variables(":root", css)
    dom::set_attribute("html", "data-theme", "dark")
    dom::add_class("html", "dark")
}

/// Toggle between light and dark themes
pub fn toggle_dark_mode(currently_dark: bool) -> bool {
    if currently_dark {
        // Switch to light
        let light_theme = intelligo::themes::default::create_default_theme()
        dom::set_css_variables(":root", light_theme.to_css())
        dom::set_attribute("html", "data-theme", "light")
        dom::remove_class("html", "dark")
        false
    } else {
        // Switch to dark
        apply_dark_theme()
        true
    }
}

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_dark_theme_creation() {
        let theme = create_dark_theme()
        assert_eq!(theme.id, "dark")
        assert_eq!(theme.is_dark_mode, true)
    }

    #[test]
    fn test_dark_colors_contrast() {
        let colors = create_dark_colors()
        // Dark mode should have light text on dark background
        assert!(colors.background.starts_with("#0") || colors.background.starts_with("#1"))
        assert!(colors.text_primary.starts_with("#f") || colors.text_primary.starts_with("#e"))
    }

    #[test]
    fn test_dark_component_styles() {
        let styles = create_dark_component_styles()
        assert!(styles.contains_key("button"))
        assert!(styles.contains_key("card"))
        assert!(styles.contains_key("code"))

        // Code block should have syntax highlighting colors
        let code = styles.get("code").unwrap()
        assert!(code.contains_key("keyword"))
        assert!(code.contains_key("string"))
    }

    #[test]
    fn test_css_generation() {
        let css = get_dark_theme_css()
        assert!(css.contains("--color-background:"))
        assert!(css.contains("--color-text-primary:"))
    }
}
