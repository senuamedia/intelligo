    // Modal styles
    let mut modal = Map::new()
    modal.insert("overlay".to_string(), "rgba(0, 0, 0, 0.8)".to_string())
    modal.insert("bg".to_string(), "#1e293b".to_string())
    modal.insert("border".to_string(), "#334155".to_string())
    modal.insert("shadow".to_string(), "0 25px 50px -12px rgba(0, 0, 0, 0.7)".to_string())
    modal.insert("header_bg".to_string(), "#0f172a".to_string())
    modal.insert("header_border".to_string(), "#334155".to_string())
    modal.insert("footer_bg".to_string(), "#0f172a".to_string())
    modal.insert("footer_border".to_string(), "#334155".to_string())
    styles.insert("modal".to_string(), modal)

    // Progress styles
    let mut progress = Map::new()
    progress.insert("track_bg".to_string(), "#334155".to_string())
    progress.insert("fill_primary".to_string(), "#3b82f6".to_string())
    progress.insert("fill_success".to_string(), "#10b981".to_string())
    progress.insert("fill_warning".to_string(), "#f59e0b".to_string())
    progress.insert("fill_error".to_string(), "#ef4444".to_string())
    progress.insert("text".to_string(), "#f1f5f9".to_string())
