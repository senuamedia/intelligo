            secondary: Some("#6c757d".to_string()),
            accent: Some("#0d6efd".to_string()),
            background: None,
            surface: None,
            text_primary: None,
            text_secondary: None,
            border: None,
            success: None,
            warning: None,
            error: None,
            info: None,
        }),
    ]
}

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_customization_creation() {
        let tenant_id = "test-tenant".to_string()
        let customization = TenantThemeCustomization::new(tenant_id.clone())
        assert_eq!(customization.tenant_id, tenant_id)
        assert!(matches!(customization.base_theme, ThemeBase::Light))
    }

    #[test]
    fn test_color_scale_generation() {
        let scale = generate_color_scale("#3b82f6")
        assert!(scale.c500.contains("3b82f6") || scale.c500.len() == 7)
    }

    #[test]
    fn test_hex_to_hsl_conversion() {
        let (h, s, l) = hex_to_hsl("#ff0000")
        assert!((h - 0.0).abs() < 1.0) // Red has hue ~0
        assert!((s - 1.0).abs() < 0.1) // Full saturation
        assert!((l - 0.5).abs() < 0.1) // 50% lightness
    }

    #[test]
    fn test_hsl_to_hex_conversion() {
        let hex = hsl_to_hex(0.0, 1.0, 0.5)
        assert_eq!(hex.to_lowercase(), "#ff0000")
    }

    #[test]
    fn test_theme_building() {
        let customization = TenantThemeCustomization::new("test".to_string())
            .with_colors(ColorOverrides {
                primary: Some("#ff5500".to_string()),
                secondary: None,
                accent: None,
                background: None,
                surface: None,
                text_primary: None,
                text_secondary: None,
                border: None,
                success: None,
                warning: None,
                error: None,
                info: None,
            })

        let theme = customization.build_theme()
        assert!(theme.id.contains("tenant"))
    }

    #[test]
    fn test_theme_templates() {
        let templates = get_theme_templates()
        assert!(templates.len() >= 5)
        assert!(templates.iter().any(|(name, _)| name == "Ocean Blue"))
    }
}
