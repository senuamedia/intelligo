/// Intelligo LMS - Application Settings
///
/// Application settings with defaults, validation, and hierarchical overrides
/// for tenant-specific customization.

module intelligo::config::settings

use intelligo::core::types::*
use intelligo::tenant::core::TenantId
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// APPLICATION SETTINGS
// =============================================================================

/// Complete application settings
type AppSettings {
    /// General settings
    general: GeneralSettings,

    /// Server settings
    server: ServerSettings,

    /// Database settings
    database: DatabaseSettings,

    /// Cache settings
    cache: CacheSettings,

    /// Session settings
    session: SessionSettings,

    /// Email settings
    email: EmailSettings,

    /// Storage settings
    storage: StorageSettings,

    /// Security settings
    security: SecuritySettings,

    /// AI settings
    ai: AiSettings,

    /// Notification settings
    notifications: NotificationSettings,

    /// Logging settings
    logging: LoggingSettings,

    /// Performance settings
    performance: PerformanceSettings
}

impl Default for AppSettings {
    fn default() -> Self {
        AppSettings {
            general: GeneralSettings::default(),
            server: ServerSettings::default(),
            database: DatabaseSettings::default(),
            cache: CacheSettings::default(),
            session: SessionSettings::default(),
            email: EmailSettings::default(),
            storage: StorageSettings::default(),
            security: SecuritySettings::default(),
            ai: AiSettings::default(),
            notifications: NotificationSettings::default(),
            logging: LoggingSettings::default(),
            performance: PerformanceSettings::default()
        }
    }
}

// =============================================================================
// GENERAL SETTINGS
// =============================================================================

/// General application settings
type GeneralSettings {
    /// Application name
    app_name: String,

    /// Application version
    app_version: String,

    /// Environment
    environment: String,

    /// Debug mode
    debug: Bool,

    /// Default timezone
    default_timezone: String,

    /// Default locale
    default_locale: String,

    /// Supported locales
    supported_locales: List<String>,

    /// Base URL
    base_url: String,

    /// API base URL
    api_base_url: String
}

impl Default for GeneralSettings {
    fn default() -> Self {
        GeneralSettings {
            app_name: "Intelligo LMS".to_string(),
            app_version: "1.0.0".to_string(),
            environment: "development".to_string(),
            debug: false,
            default_timezone: "UTC".to_string(),
            default_locale: "en-US".to_string(),
            supported_locales: vec![
                "en-US".to_string(),
                "en-GB".to_string(),
                "es-ES".to_string(),
                "fr-FR".to_string(),
                "de-DE".to_string()
            ],
            base_url: "http://localhost:8080".to_string(),
            api_base_url: "http://localhost:8080/api".to_string()
        }
    }
}

// =============================================================================
// SERVER SETTINGS
// =============================================================================

/// HTTP server settings
type ServerSettings {
    /// Bind host
    host: String,

    /// Bind port
    port: i32,

    /// Enable TLS
    tls_enabled: Bool,

    /// TLS cert path
    tls_cert_path: Option<String>,

    /// TLS key path
    tls_key_path: Option<String>,

    /// Worker threads
    worker_threads: i32,

    /// Max connections
    max_connections: i32,

    /// Keep-alive timeout
    keep_alive_timeout: Duration,

    /// Request timeout
    request_timeout: Duration,

    /// Body size limit
    body_size_limit: i64,

    /// Enable compression
    compression_enabled: Bool,

    /// CORS settings
    cors: CorsSettings
}

impl Default for ServerSettings {
    fn default() -> Self {
        ServerSettings {
            host: "0.0.0.0".to_string(),
            port: 8080,
            tls_enabled: false,
            tls_cert_path: None,
            tls_key_path: None,
            worker_threads: 4,
            max_connections: 10000,
            keep_alive_timeout: Duration::seconds(75),
            request_timeout: Duration::seconds(30),
            body_size_limit: 10 * 1024 * 1024, // 10MB
            compression_enabled: true,
            cors: CorsSettings::default()
        }
    }
}

/// CORS settings
type CorsSettings {
    enabled: Bool,
    allowed_origins: List<String>,
    allowed_methods: List<String>,
    allowed_headers: List<String>,
    expose_headers: List<String>,
    allow_credentials: Bool,
    max_age: Duration
}

impl Default for CorsSettings {
    fn default() -> Self {
        CorsSettings {
            enabled: true,
            allowed_origins: vec!["*".to_string()],
            allowed_methods: vec![
                "GET".to_string(),
                "POST".to_string(),
                "PUT".to_string(),
                "PATCH".to_string(),
                "DELETE".to_string(),
                "OPTIONS".to_string()
            ],
            allowed_headers: vec![
                "Content-Type".to_string(),
                "Authorization".to_string(),
                "X-Requested-With".to_string()
            ],
            expose_headers: vec![
                "X-Total-Count".to_string(),
                "X-Page-Count".to_string()
            ],
            allow_credentials: true,
            max_age: Duration::hours(24)
        }
    }
}

