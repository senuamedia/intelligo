/// Cache settings
type CacheSettings {
    /// Enable caching
    enabled: Bool,

    /// Cache driver
    driver: String,

    /// Redis URL
    redis_url: Option<String>,

    /// Default TTL
    default_ttl: Duration,

    /// Max entries (for memory cache)
    max_entries: i64,

    /// Enable compression
    compression: Bool,

    /// Key prefix
    key_prefix: String,

    /// Cache levels
    levels: CacheLevels
}

impl Default for CacheSettings {
    fn default() -> Self {
        CacheSettings {
            enabled: true,
            driver: "memory".to_string(),
            redis_url: None,
            default_ttl: Duration::hours(1),
            max_entries: 10000,
            compression: false,
            key_prefix: "intelligo:".to_string(),
            levels: CacheLevels::default()
        }
    }
}

/// Multi-level cache configuration
type CacheLevels {
    l1_enabled: Bool,
    l1_max_size: i64,
    l1_ttl: Duration,
    l2_enabled: Bool,
    l2_ttl: Duration
}

impl Default for CacheLevels {
    fn default() -> Self {
        CacheLevels {
            l1_enabled: true,
            l1_max_size: 1000,
            l1_ttl: Duration::minutes(5),
            l2_enabled: true,
            l2_ttl: Duration::hours(1)
        }
    }
}

