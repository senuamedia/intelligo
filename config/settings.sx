/// Database settings
type DatabaseSettings {
    /// Database URL
    url: String,

    /// Database driver
    driver: String,

    /// Connection pool size
    pool_size: i32,

    /// Min pool connections
    pool_min: i32,

    /// Connection timeout
    connect_timeout: Duration,

    /// Query timeout
    query_timeout: Duration,

    /// Idle timeout
    idle_timeout: Duration,

    /// Max lifetime
    max_lifetime: Duration,

    /// Enable SSL
    ssl_enabled: Bool,

    /// SSL mode
    ssl_mode: String,

    /// Run migrations on start
    auto_migrate: Bool,

    /// Enable query logging
    log_queries: Bool
}

impl Default for DatabaseSettings {
    fn default() -> Self {
        DatabaseSettings {
            url: "postgres://localhost/intelligo".to_string(),
            driver: "postgres".to_string(),
            pool_size: 20,
            pool_min: 5,
            connect_timeout: Duration::seconds(10),
            query_timeout: Duration::seconds(30),
            idle_timeout: Duration::minutes(10),
            max_lifetime: Duration::hours(1),
            ssl_enabled: false,
            ssl_mode: "prefer".to_string(),
            auto_migrate: true,
            log_queries: false
        }
    }
}

