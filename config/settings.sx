            password: PasswordSettings::default(),
            mfa: MfaSettings::default(),
            rate_limiting: RateLimitSettings::default(),
            allowed_ips: vec![],
            blocked_ips: vec![],
            csp_enabled: true,
            csp_policy: None,
            hsts_enabled: true,
            hsts_max_age: Duration::days(365),
            audit_enabled: true
        }
