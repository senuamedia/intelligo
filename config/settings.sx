// =============================================================================
// SETTINGS MANAGER
// =============================================================================

/// Settings manager actor
actor SettingsManager {
    var app_settings: AppSettings = AppSettings::default()
    var tenant_overrides: Map<TenantId, Map<String, Dynamic>> = Map::new()

    fn new() -> Self {
        SettingsManager::default()
    }

    /// Get all settings
    receive GetAll() -> AppSettings {
        self.app_settings.clone()
    }

    /// Get setting value
    receive Get(key: String) -> Option<Dynamic> {
        self.get_nested_value(&key)
    }

    /// Get setting with tenant override
    receive GetForTenant(key: String, tenant_id: TenantId) -> Option<Dynamic> {
        // Check tenant override first
        if let Some(overrides) = self.tenant_overrides.get(&tenant_id) {
            if let Some(value) = overrides.get(&key) {
                return Some(value.clone());
            }
        }

        // Fall back to global setting
        self.get_nested_value(&key)
    }

    /// Update setting
    receive Set(key: String, value: Dynamic) -> Result<(), SettingsError> {
        self.set_nested_value(&key, value)?;
        checkpoint();
        Ok(())
    }

    /// Set tenant override
    receive SetTenantOverride(tenant_id: TenantId, key: String, value: Dynamic) {
        self.tenant_overrides.entry(tenant_id)
            .or_insert(Map::new())
            .insert(key, value);
        checkpoint();
    }

    /// Remove tenant override
    receive RemoveTenantOverride(tenant_id: TenantId, key: String) {
        if let Some(overrides) = self.tenant_overrides.get_mut(&tenant_id) {
            overrides.remove(&key);
        }
        checkpoint();
    }

    /// Get all tenant overrides
    receive GetTenantOverrides(tenant_id: TenantId) -> Map<String, Dynamic> {
        self.tenant_overrides.get(&tenant_id).cloned().unwrap_or_default()
    }

    /// Load settings from config
    receive LoadFromConfig(config: Map<String, Dynamic>) {
        // Apply configuration values to settings
        for (key, value) in config {
            let _ = self.set_nested_value(&key, value);
        }
        checkpoint();
    }

    /// Reset to defaults
    receive ResetToDefaults() {
        self.app_settings = AppSettings::default();
        checkpoint();
    }

    // Internal methods

    fn get_nested_value(&self, key: &str) -> Option<Dynamic> {
        let parts: Vec<_> = key.split('.').collect();

        // Simplified - would need proper reflection
        match parts.as_slice() {
            ["general", "app_name"] => Some(Dynamic::String(self.app_settings.general.app_name.clone())),
            ["general", "debug"] => Some(Dynamic::Bool(self.app_settings.general.debug)),
            ["server", "port"] => Some(Dynamic::Int(self.app_settings.server.port as i64)),
            ["server", "host"] => Some(Dynamic::String(self.app_settings.server.host.clone())),
            ["database", "pool_size"] => Some(Dynamic::Int(self.app_settings.database.pool_size as i64)),
            ["cache", "enabled"] => Some(Dynamic::Bool(self.app_settings.cache.enabled)),
            ["security", "password", "min_length"] => Some(Dynamic::Int(self.app_settings.security.password.min_length as i64)),
            ["ai", "enabled"] => Some(Dynamic::Bool(self.app_settings.ai.enabled)),
            ["logging", "level"] => Some(Dynamic::String(self.app_settings.logging.level.clone())),
            _ => None
        }
    }

    fn set_nested_value(&mut self, key: &str, value: Dynamic) -> Result<(), SettingsError> {
        let parts: Vec<_> = key.split('.').collect();

        match parts.as_slice() {
            ["general", "app_name"] => {
                if let Dynamic::String(s) = value {
                    self.app_settings.general.app_name = s;
                }
            },
            ["general", "debug"] => {
                if let Dynamic::Bool(b) = value {
                    self.app_settings.general.debug = b;
                }
            },
            ["server", "port"] => {
                if let Dynamic::Int(i) = value {
                    self.app_settings.server.port = i as i32;
                }
            },
            ["cache", "enabled"] => {
                if let Dynamic::Bool(b) = value {
                    self.app_settings.cache.enabled = b;
                }
            },
            ["ai", "enabled"] => {
                if let Dynamic::Bool(b) = value {
                    self.app_settings.ai.enabled = b;
                }
            },
            _ => {
                return Err(SettingsError::InvalidKey { key: key.to_string() });
            }
        }

        Ok(())
    }
}

// =============================================================================
// ERRORS
// =============================================================================

enum SettingsError {
    InvalidKey { key: String },
    InvalidValue { key: String, message: String },
    ReadOnly { key: String }
}

impl SettingsError {
    fn to_string(&self) -> String {
        match self {
            SettingsError::InvalidKey { key } => format!("Invalid settings key: {}", key),
            SettingsError::InvalidValue { key, message } => format!("Invalid value for {}: {}", key, message),
            SettingsError::ReadOnly { key } => format!("Setting {} is read-only", key)
        }
    }
}

