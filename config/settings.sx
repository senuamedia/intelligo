#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_default_settings() {
        let settings = AppSettings::default();
        assert_eq!(settings.general.app_name, "Intelligo LMS");
        assert_eq!(settings.server.port, 8080);
        assert!(settings.cache.enabled);
    }

    #[test]
    fn test_password_settings() {
        let password = PasswordSettings::default();
        assert_eq!(password.min_length, 8);
        assert!(password.require_uppercase);
    }
}
