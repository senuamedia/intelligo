/// Intelligo LMS - Secret Management
///
/// Secure secret storage and retrieval with support for various backends
/// including environment variables, HashiCorp Vault, AWS Secrets Manager,
/// and encrypted local storage.

module intelligo::config::secrets

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// SECRET TYPES
// =============================================================================

/// A secret value with metadata
type Secret {
    /// Secret key/name
    key: String,

    /// Secret value (encrypted in storage)
    value: SecretValue,

    /// Secret version
    version: i32,

    /// Created timestamp
    created_at: DateTime,

    /// Updated timestamp
    updated_at: DateTime,

    /// Expires at
    expires_at: Option<DateTime>,

    /// Rotation schedule
    rotation_schedule: Option<Duration>,

    /// Last rotated
    last_rotated: Option<DateTime>,

    /// Tags for organization
    tags: Set<String>,

    /// Description
    description: Option<String>,

    /// Whether this secret is enabled
    enabled: Bool
}

impl Secret {
    fn is_expired(&self) -> Bool {
        if let Some(expires) = &self.expires_at {
            DateTime::now() >= *expires
        } else {
            false
        }
    }

    fn needs_rotation(&self) -> Bool {
        if let (Some(schedule), Some(last)) = (&self.rotation_schedule, &self.last_rotated) {
            DateTime::now() - *last >= *schedule
        } else {
            false
        }
    }
}

/// Secret value variants
enum SecretValue {
    /// Simple string secret
    String(String),

    /// Binary data
    Binary(Vec<u8>),

    /// Key-value pairs (e.g., database credentials)
    KeyValue(Map<String, String>),

    /// Certificate (PEM format)
    Certificate {
        certificate: String,
        private_key: String,
        chain: Option<String>
    },

    /// API key with optional metadata
    ApiKey {
        key: String,
        secret: Option<String>,
        endpoint: Option<String>
    },

    /// OAuth credentials
    OAuth {
        client_id: String,
        client_secret: String,
        token_url: Option<String>
    },

    /// SSH key pair
    SshKey {
        public_key: String,
        private_key: String,
        passphrase: Option<String>
    }
}

impl SecretValue {
    fn as_string(&self) -> Option<String> {
        match self {
            SecretValue::String(s) => Some(s.clone()),
            SecretValue::ApiKey { key, .. } => Some(key.clone()),
            _ => None
        }
    }

    fn get_field(&self, field: &str) -> Option<String> {
        match self {
            SecretValue::KeyValue(map) => map.get(field).cloned(),
            SecretValue::ApiKey { key, secret, endpoint } => {
                match field {
                    "key" => Some(key.clone()),
                    "secret" => secret.clone(),
                    "endpoint" => endpoint.clone(),
                    _ => None
                }
            },
            SecretValue::OAuth { client_id, client_secret, token_url } => {
                match field {
                    "client_id" => Some(client_id.clone()),
                    "client_secret" => Some(client_secret.clone()),
                    "token_url" => token_url.clone(),
                    _ => None
                }
            },
            SecretValue::Certificate { certificate, private_key, chain } => {
                match field {
                    "certificate" => Some(certificate.clone()),
                    "private_key" => Some(private_key.clone()),
                    "chain" => chain.clone(),
                    _ => None
                }
            },
            _ => None
        }
    }
}

// =============================================================================
// SECRET BACKENDS
// =============================================================================

/// Secret storage backend
enum SecretBackend {
    /// Environment variables
    Environment {
        prefix: String
    },

    /// Encrypted local file
    LocalFile {
        path: String,
        encryption_key_env: String
    },

    /// HashiCorp Vault
    Vault {
        address: String,
        mount_path: String,
        auth_method: VaultAuth
    },

    /// AWS Secrets Manager
    AwsSecretsManager {
        region: String,
        prefix: String
    },

    /// Azure Key Vault
    AzureKeyVault {
        vault_url: String,
        tenant_id: String
    },

    /// GCP Secret Manager
    GcpSecretManager {
        project_id: String
    },

    /// Memory-only (for testing)
    Memory
}

/// Vault authentication methods
enum VaultAuth {
    Token { token_env: String },
    AppRole { role_id_env: String, secret_id_env: String },
    Kubernetes { role: String },
    Aws { role: String }
}

/// Backend configuration
type SecretBackendConfig {
    /// Primary backend
    primary: SecretBackend,

    /// Fallback backends
    fallbacks: List<SecretBackend>,

    /// Cache secrets in memory
    cache_enabled: Bool,

    /// Cache TTL
    cache_ttl: Duration,

    /// Retry configuration
    retry_attempts: i32,
    retry_delay: Duration,

    /// Enable secret rotation
    rotation_enabled: Bool,

    /// Audit secret access
    audit_enabled: Bool
}

impl Default for SecretBackendConfig {
    fn default() -> Self {
        SecretBackendConfig {
            primary: SecretBackend::Environment {
                prefix: "INTELLIGO_SECRET_".to_string()
            },
            fallbacks: vec![],
            cache_enabled: true,
            cache_ttl: Duration::minutes(5),
            retry_attempts: 3,
            retry_delay: Duration::seconds(1),
            rotation_enabled: false,
            audit_enabled: true
        }
    }
}

// =============================================================================
// SECRET MANAGER
// =============================================================================

/// Secret manager actor
actor SecretManager {
    var config: SecretBackendConfig
    var cache: Map<String, (SecretValue, DateTime)> = Map::new()
    var audit_log: List<SecretAuditEntry> = vec![]
    var secrets_memory: Map<String, Secret> = Map::new()

    fn new(config: SecretBackendConfig) -> Self {
        SecretManager {
            config,
            ..Default::default()
        }
    }

    /// Get a secret by key
    receive Get(key: String) -> Result<SecretValue, SecretError> {
        // Check cache
        if self.config.cache_enabled {
            if let Some((value, cached_at)) = self.cache.get(&key) {
                if DateTime::now() - *cached_at < self.config.cache_ttl {
                    self.audit_access(&key, "cache_hit");
                    return Ok(value.clone());
                }
            }
        }

        // Try primary backend
        let result = self.get_from_backend(&self.config.primary, &key);

        if let Ok(value) = &result {
            // Cache the result
            if self.config.cache_enabled {
                self.cache.insert(key.clone(), (value.clone(), DateTime::now()));
            }
            self.audit_access(&key, "retrieved");
            return result;
        }

        // Try fallback backends
        for fallback in &self.config.fallbacks {
            if let Ok(value) = self.get_from_backend(fallback, &key) {
                if self.config.cache_enabled {
                    self.cache.insert(key.clone(), (value.clone(), DateTime::now()));
                }
                self.audit_access(&key, "fallback_retrieved");
                return Ok(value);
            }
        }

        self.audit_access(&key, "not_found");
        Err(SecretError::NotFound { key })
    }

    /// Get secret as string
    receive GetString(key: String) -> Result<String, SecretError> {
        let value = self.get_internal(&key)?;
        value.as_string().ok_or(SecretError::InvalidFormat {
            key,
            expected: "string".to_string()
        })
    }

    /// Get secret field
    receive GetField(key: String, field: String) -> Result<String, SecretError> {
        let value = self.get_internal(&key)?;
        value.get_field(&field).ok_or(SecretError::FieldNotFound {
            key,
            field
        })
    }

    /// Set a secret
    receive Set(key: String, value: SecretValue) -> Result<(), SecretError> {
        let secret = Secret {
            key: key.clone(),
            value: value.clone(),
            version: 1,
            created_at: DateTime::now(),
            updated_at: DateTime::now(),
            expires_at: None,
            rotation_schedule: None,
            last_rotated: None,
            tags: Set::new(),
            description: None,
            enabled: true
        };

        self.set_to_backend(&self.config.primary, &key, &secret)?;

        // Update cache
        if self.config.cache_enabled {
            self.cache.insert(key.clone(), (value, DateTime::now()));
        }

        // Store in memory for memory backend
        self.secrets_memory.insert(key.clone(), secret);

        self.audit_access(&key, "set");
        checkpoint();

        Ok(())
    }

    /// Set secret with metadata
    receive SetWithMeta(secret: Secret) -> Result<(), SecretError> {
        self.set_to_backend(&self.config.primary, &secret.key, &secret)?;

        if self.config.cache_enabled {
            self.cache.insert(secret.key.clone(), (secret.value.clone(), DateTime::now()));
        }

        self.secrets_memory.insert(secret.key.clone(), secret.clone());

        self.audit_access(&secret.key, "set_with_meta");
        checkpoint();

        Ok(())
    }

    /// Delete a secret
    receive Delete(key: String) -> Result<(), SecretError> {
        self.delete_from_backend(&self.config.primary, &key)?;

        self.cache.remove(&key);
        self.secrets_memory.remove(&key);

        self.audit_access(&key, "deleted");
        checkpoint();

        Ok(())
    }

    /// List secret keys
    receive List(prefix: Option<String>) -> List<String> {
        self.list_from_backend(&self.config.primary, &prefix)
    }

    /// Check if secret exists
    receive Exists(key: String) -> Bool {
        self.get_internal(&key).is_ok()
    }

    /// Rotate a secret
    receive Rotate(key: String, new_value: SecretValue) -> Result<i32, SecretError> {
        let mut secret = self.secrets_memory.get(&key)
            .cloned()
            .ok_or(SecretError::NotFound { key: key.clone() })?;

        secret.value = new_value.clone();
        secret.version += 1;
        secret.updated_at = DateTime::now();
        secret.last_rotated = Some(DateTime::now());

        self.set_to_backend(&self.config.primary, &key, &secret)?;

        if self.config.cache_enabled {
            self.cache.insert(key.clone(), (new_value, DateTime::now()));
        }

        self.secrets_memory.insert(key.clone(), secret.clone());

        self.audit_access(&key, "rotated");
        checkpoint();

        Ok(secret.version)
    }

    /// Get secrets needing rotation
    receive GetRotationCandidates() -> List<String> {
        self.secrets_memory.values()
            .filter(|s| s.needs_rotation())
            .map(|s| s.key.clone())
            .collect()
    }

    /// Clear cache
    receive ClearCache() {
        self.cache.clear();
    }

    /// Get audit log
    receive GetAuditLog(limit: i32) -> List<SecretAuditEntry> {
        self.audit_log.iter()
            .rev()
            .take(limit as usize)
            .cloned()
            .collect()
    }

    // Internal methods

    fn get_internal(&self, key: &str) -> Result<SecretValue, SecretError> {
        // Check cache
        if self.config.cache_enabled {
            if let Some((value, cached_at)) = self.cache.get(key) {
                if DateTime::now() - *cached_at < self.config.cache_ttl {
                    return Ok(value.clone());
                }
            }
        }

        self.get_from_backend(&self.config.primary, key)
    }

    fn get_from_backend(&self, backend: &SecretBackend, key: &str) -> Result<SecretValue, SecretError> {
        match backend {
            SecretBackend::Environment { prefix } => {
                let env_key = format!("{}{}", prefix, key.to_uppercase().replace(".", "_"));
                std::env::var(&env_key)
                    .map(SecretValue::String)
                    .map_err(|_| SecretError::NotFound { key: key.to_string() })
            },

            SecretBackend::Memory => {
                self.secrets_memory.get(key)
                    .map(|s| s.value.clone())
                    .ok_or(SecretError::NotFound { key: key.to_string() })
            },

            SecretBackend::LocalFile { path, encryption_key_env } => {
                self.get_from_encrypted_file(path, key, encryption_key_env)
            },

            SecretBackend::Vault { address, mount_path, auth_method } => {
                self.get_from_vault(address, mount_path, auth_method, key)
            },

            SecretBackend::AwsSecretsManager { region, prefix } => {
                self.get_from_aws(region, prefix, key)
            },

            SecretBackend::AzureKeyVault { vault_url, .. } => {
                self.get_from_azure(vault_url, key)
            },

            SecretBackend::GcpSecretManager { project_id } => {
                self.get_from_gcp(project_id, key)
            }
        }
    }

    fn set_to_backend(&self, backend: &SecretBackend, key: &str, secret: &Secret) -> Result<(), SecretError> {
        match backend {
            SecretBackend::Memory => Ok(()),
            SecretBackend::Environment { .. } => {
                Err(SecretError::BackendReadOnly {
                    backend: "environment".to_string()
                })
            },
            SecretBackend::LocalFile { path, encryption_key_env } => {
                self.set_to_encrypted_file(path, key, secret, encryption_key_env)
            },
            SecretBackend::Vault { address, mount_path, auth_method } => {
                self.set_to_vault(address, mount_path, auth_method, key, secret)
            },
            SecretBackend::AwsSecretsManager { region, prefix } => {
                self.set_to_aws(region, prefix, key, secret)
            },
            SecretBackend::AzureKeyVault { vault_url, .. } => {
                self.set_to_azure(vault_url, key, secret)
            },
            SecretBackend::GcpSecretManager { project_id } => {
                self.set_to_gcp(project_id, key, secret)
            }
        }
    }

    fn delete_from_backend(&self, backend: &SecretBackend, key: &str) -> Result<(), SecretError> {
        match backend {
            SecretBackend::Memory => Ok(()),
            SecretBackend::Environment { .. } => {
                Err(SecretError::BackendReadOnly {
                    backend: "environment".to_string()
                })
            },
            _ => Ok(()) // Would implement actual deletion
        }
    }

    fn list_from_backend(&self, backend: &SecretBackend, prefix: &Option<String>) -> List<String> {
        match backend {
            SecretBackend::Memory => {
                self.secrets_memory.keys()
                    .filter(|k| prefix.as_ref().map_or(true, |p| k.starts_with(p)))
                    .cloned()
                    .collect()
            },
            SecretBackend::Environment { prefix: env_prefix } => {
                std::env::vars()
                    .filter(|(k, _)| k.starts_with(env_prefix))
                    .map(|(k, _)| k[env_prefix.len()..].to_lowercase().replace("_", "."))
                    .filter(|k| prefix.as_ref().map_or(true, |p| k.starts_with(p)))
                    .collect()
            },
            _ => vec![] // Would implement for other backends
        }
    }

    // Backend-specific implementations (simplified)

    fn get_from_encrypted_file(&self, path: &str, key: &str, _encryption_key_env: &str) -> Result<SecretValue, SecretError> {
        // Would read and decrypt from file
        Err(SecretError::NotFound { key: key.to_string() })
    }

    fn set_to_encrypted_file(&self, _path: &str, _key: &str, _secret: &Secret, _encryption_key_env: &str) -> Result<(), SecretError> {
        // Would encrypt and write to file
        Ok(())
    }

    fn get_from_vault(&self, _address: &str, _mount_path: &str, _auth: &VaultAuth, key: &str) -> Result<SecretValue, SecretError> {
        // Would call Vault API
        Err(SecretError::NotFound { key: key.to_string() })
    }

    fn set_to_vault(&self, _address: &str, _mount_path: &str, _auth: &VaultAuth, _key: &str, _secret: &Secret) -> Result<(), SecretError> {
        // Would call Vault API
        Ok(())
    }

    fn get_from_aws(&self, _region: &str, _prefix: &str, key: &str) -> Result<SecretValue, SecretError> {
        // Would call AWS Secrets Manager API
        Err(SecretError::NotFound { key: key.to_string() })
    }

    fn set_to_aws(&self, _region: &str, _prefix: &str, _key: &str, _secret: &Secret) -> Result<(), SecretError> {
        // Would call AWS Secrets Manager API
        Ok(())
    }

    fn get_from_azure(&self, _vault_url: &str, key: &str) -> Result<SecretValue, SecretError> {
        // Would call Azure Key Vault API
        Err(SecretError::NotFound { key: key.to_string() })
    }

    fn set_to_azure(&self, _vault_url: &str, _key: &str, _secret: &Secret) -> Result<(), SecretError> {
        // Would call Azure Key Vault API
        Ok(())
    }

    fn get_from_gcp(&self, _project_id: &str, key: &str) -> Result<SecretValue, SecretError> {
        // Would call GCP Secret Manager API
        Err(SecretError::NotFound { key: key.to_string() })
    }

    fn set_to_gcp(&self, _project_id: &str, _key: &str, _secret: &Secret) -> Result<(), SecretError> {
        // Would call GCP Secret Manager API
        Ok(())
    }

    fn audit_access(&mut self, key: &str, action: &str) {
        if self.config.audit_enabled {
            self.audit_log.push(SecretAuditEntry {
                key: key.to_string(),
                action: action.to_string(),
                timestamp: DateTime::now(),
                source: None
            });

            // Keep log bounded
            if self.audit_log.len() > 10000 {
                self.audit_log = self.audit_log.split_off(5000);
            }
        }
    }
}

// =============================================================================
// AUDIT
// =============================================================================

/// Secret access audit entry
type SecretAuditEntry {
    key: String,
    action: String,
    timestamp: DateTime,
    source: Option<String>
}

// =============================================================================
// ERRORS
// =============================================================================

/// Secret errors
enum SecretError {
    NotFound { key: String },
    InvalidFormat { key: String, expected: String },
    FieldNotFound { key: String, field: String },
    BackendReadOnly { backend: String },
    BackendError { backend: String, message: String },
    Expired { key: String },
    EncryptionError { message: String },
    AuthenticationError { message: String }
}

impl SecretError {
    fn to_string(&self) -> String {
        match self {
            SecretError::NotFound { key } => format!("Secret not found: {}", key),
            SecretError::InvalidFormat { key, expected } => format!("Invalid format for {}: expected {}", key, expected),
            SecretError::FieldNotFound { key, field } => format!("Field {} not found in secret {}", field, key),
            SecretError::BackendReadOnly { backend } => format!("Backend {} is read-only", backend),
            SecretError::BackendError { backend, message } => format!("Backend {} error: {}", backend, message),
            SecretError::Expired { key } => format!("Secret {} has expired", key),
            SecretError::EncryptionError { message } => format!("Encryption error: {}", message),
            SecretError::AuthenticationError { message } => format!("Authentication error: {}", message)
        }
    }
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

/// Create database credentials secret
fn create_database_credentials(host: String, port: i32, database: String, username: String, password: String) -> SecretValue {
    let mut map = Map::new();
    map.insert("host".to_string(), host);
    map.insert("port".to_string(), port.to_string());
    map.insert("database".to_string(), database);
    map.insert("username".to_string(), username);
    map.insert("password".to_string(), password);
    SecretValue::KeyValue(map)
}

/// Create API key secret
fn create_api_key(key: String, secret: Option<String>, endpoint: Option<String>) -> SecretValue {
    SecretValue::ApiKey { key, secret, endpoint }
}

/// Create OAuth credentials secret
fn create_oauth_credentials(client_id: String, client_secret: String, token_url: Option<String>) -> SecretValue {
    SecretValue::OAuth { client_id, client_secret, token_url }
}

// =============================================================================
// TESTS
// =============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_secret_value_string() {
        let value = SecretValue::String("my-secret".to_string());
        assert_eq!(value.as_string(), Some("my-secret".to_string()));
    }

    #[test]
    fn test_secret_value_key_value() {
        let mut map = Map::new();
        map.insert("username".to_string(), "admin".to_string());
        map.insert("password".to_string(), "secret123".to_string());

        let value = SecretValue::KeyValue(map);
        assert_eq!(value.get_field("username"), Some("admin".to_string()));
        assert_eq!(value.get_field("password"), Some("secret123".to_string()));
        assert_eq!(value.get_field("missing"), None);
    }

    #[test]
    fn test_secret_expiration() {
        let secret = Secret {
            key: "test".to_string(),
            value: SecretValue::String("value".to_string()),
            version: 1,
            created_at: DateTime::now(),
            updated_at: DateTime::now(),
            expires_at: Some(DateTime::now() - Duration::hours(1)),
            rotation_schedule: None,
            last_rotated: None,
            tags: Set::new(),
            description: None,
            enabled: true
        };

        assert!(secret.is_expired());
    }

    #[test]
    fn test_create_helpers() {
        let db = create_database_credentials(
            "localhost".to_string(),
            5432,
            "mydb".to_string(),
            "user".to_string(),
            "pass".to_string()
        );

        assert_eq!(db.get_field("host"), Some("localhost".to_string()));
        assert_eq!(db.get_field("port"), Some("5432".to_string()));
    }
}
