// =============================================================================
// RESULT TYPE
// =============================================================================

/// Result type alias
pub type Result<T> = std::result::Result<T, LmsError>;

// =============================================================================
// ERROR HANDLER
// =============================================================================

/// Error handler for logging and reporting
pub type ErrorHandler {
    handlers: List<Box<dyn Fn(&LmsError) + Send + Sync>>,
    report_to_external: bool
}

impl ErrorHandler {
    pub fn new() -> ErrorHandler {
        ErrorHandler {
            handlers: vec![],
            report_to_external: false
        }
    }

    /// Add an error handler
    pub fn on_error<F>(&mut self, handler: F)
    where
        F: Fn(&LmsError) + Send + Sync + 'static
    {
        self.handlers.push(Box::new(handler));
    }

    /// Handle an error
    pub fn handle(&self, error: &LmsError) {
        for handler in &self.handlers {
            handler(error);
        }
    }

    /// Enable external error reporting
    pub fn enable_external_reporting(&mut self) {
        self.report_to_external = true;
    }
}

// =============================================================================
// ERROR ACCUMULATOR
// =============================================================================

/// Accumulates multiple errors
pub type ErrorAccumulator {
    errors: List<LmsError>
}

impl ErrorAccumulator {
    pub fn new() -> ErrorAccumulator {
        ErrorAccumulator { errors: vec![] }
    }

    /// Add an error
    pub fn add(&mut self, error: LmsError) {
        self.errors.push(error);
    }

    /// Check if has errors
    pub fn has_errors(&self) -> bool {
        !self.errors.is_empty()
    }

    /// Get error count
    pub fn count(&self) -> usize {
        self.errors.len()
    }

    /// Get all errors
    pub fn errors(&self) -> &List<LmsError> {
        &self.errors
    }

    /// Convert to combined error
    pub fn to_error(&self) -> Option<LmsError> {
        if self.errors.is_empty() {
            return None;
        }

        if self.errors.len() == 1 {
            return Some(self.errors[0].clone());
        }

        let messages: Vec<String> = self.errors.iter()
            .map(|e| e.message.clone())
            .collect();

        Some(LmsError::with_status(
            "MULTIPLE_ERRORS",
            &format!("{} errors occurred: {}", self.errors.len(), messages.join("; ")),
            400
        ))
    }

    /// Clear errors
    pub fn clear(&mut self) {
        self.errors.clear();
    }
}

// =============================================================================
// TRY MACROS
// =============================================================================

/// Try with context
#[macro]
pub fn try_with_context!(result: Result<T>, context: &str) -> Result<T> {
    result.map_err(|e| {
        LmsError::new(&e.code, &format!("{}: {}", context, e.message))
            .with_source(e)
    })
}

/// Ensure condition
#[macro]
pub fn ensure!(condition: bool, error: LmsError) {
    if !condition {
        return Err(error);
    }
}

/// Ensure some
#[macro]
pub fn ensure_some!(option: Option<T>, error: LmsError) -> Result<T> {
    option.ok_or(error)
}
