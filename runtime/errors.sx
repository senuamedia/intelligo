/// Course errors
pub mod course {
    use super::*;

    pub fn not_found(course_id: &str) -> LmsError {
        super::not_found("Course", course_id)
    }

    pub fn not_published(course_id: &str) -> LmsError {
        LmsError::with_status(
            "COURSE_NOT_PUBLISHED",
            &format!("Course '{}' is not published", course_id),
            400
        ).with_detail("course_id", course_id)
    }

    pub fn enrollment_required(course_id: &str) -> LmsError {
        LmsError::with_status(
            "ENROLLMENT_REQUIRED",
            &format!("Enrollment required to access course '{}'", course_id),
            403
        ).with_detail("course_id", course_id)
    }

    pub fn prerequisite_not_met(course_id: &str, prerequisite_id: &str) -> LmsError {
        LmsError::with_status(
            "PREREQUISITE_NOT_MET",
            &format!("Prerequisite '{}' must be completed before accessing course '{}'", prerequisite_id, course_id),
            403
        ).with_detail("course_id", course_id)
         .with_detail("prerequisite_id", prerequisite_id)
    }

    pub fn already_completed(course_id: &str) -> LmsError {
        LmsError::with_status(
            "COURSE_ALREADY_COMPLETED",
            &format!("Course '{}' has already been completed", course_id),
            400
        ).with_detail("course_id", course_id)
    }
}

