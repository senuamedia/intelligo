/// Authentication errors
pub mod auth {
    use super::*;

    pub fn invalid_credentials() -> LmsError {
        LmsError::with_status("INVALID_CREDENTIALS", "Invalid email or password", 401)
    }

    pub fn token_expired() -> LmsError {
        LmsError::with_status("TOKEN_EXPIRED", "Authentication token has expired", 401)
    }

    pub fn token_invalid() -> LmsError {
        LmsError::with_status("TOKEN_INVALID", "Authentication token is invalid", 401)
    }

    pub fn session_expired() -> LmsError {
        LmsError::with_status("SESSION_EXPIRED", "Session has expired. Please log in again.", 401)
    }

    pub fn account_locked(until: Option<&DateTime>) -> LmsError {
        let message = match until {
            Some(dt) => format!("Account is locked until {}", dt.to_rfc3339()),
            None => "Account is locked".to_string()
        };
        LmsError::with_status("ACCOUNT_LOCKED", &message, 403)
    }

    pub fn account_disabled() -> LmsError {
        LmsError::with_status("ACCOUNT_DISABLED", "Account has been disabled", 403)
    }

    pub fn mfa_required() -> LmsError {
        LmsError::with_status("MFA_REQUIRED", "Multi-factor authentication required", 401)
    }

    pub fn mfa_invalid() -> LmsError {
        LmsError::with_status("MFA_INVALID", "Invalid multi-factor authentication code", 401)
    }
}

