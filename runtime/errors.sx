/// Intelligo LMS - Error Handling
///
/// Provides comprehensive error types and handling utilities.

module intelligo::runtime::errors

use std::collections::{Map, List}
use std::time::DateTime

// =============================================================================
// ERROR TYPES
// =============================================================================

/// Base error trait
pub trait Error: std::fmt::Display + std::fmt::Debug + Send + Sync {
    /// Error code
    fn code(&self) -> &str;

    /// Error message
    fn message(&self) -> &str;

    /// Source error if any
    fn source(&self) -> Option<&dyn Error> {
        None
    }

    /// HTTP status code
    fn status_code(&self) -> i32 {
        500
    }

    /// Is this error retryable?
    fn is_retryable(&self) -> bool {
        false
    }

    /// Convert to LMS error
    fn to_lms_error(&self) -> LmsError {
        LmsError {
            code: self.code().to_string(),
            message: self.message().to_string(),
            status_code: self.status_code(),
            details: Map::new(),
            source: None,
            stack_trace: None,
            timestamp: DateTime::now()
        }
    }
}

/// Main LMS error type
#[derive(Clone, Debug)]
pub type LmsError {
    code: String,
    message: String,
    status_code: i32,
    details: Map<String, String>,
    source: Option<Box<LmsError>>,
    stack_trace: Option<String>,
    timestamp: DateTime
}

impl LmsError {
    /// Create a new error
    pub fn new(code: &str, message: &str) -> LmsError {
        LmsError {
            code: code.to_string(),
            message: message.to_string(),
            status_code: 500,
            details: Map::new(),
            source: None,
            stack_trace: None,
            timestamp: DateTime::now()
        }
    }

    /// Create with status code
    pub fn with_status(code: &str, message: &str, status_code: i32) -> LmsError {
        LmsError {
            code: code.to_string(),
            message: message.to_string(),
            status_code,
            details: Map::new(),
            source: None,
            stack_trace: None,
            timestamp: DateTime::now()
        }
    }

    /// Add a detail
    pub fn with_detail(mut self, key: &str, value: &str) -> Self {
        self.details.insert(key.to_string(), value.to_string());
        self
    }

    /// Set source error
    pub fn with_source(mut self, source: LmsError) -> Self {
        self.source = Some(Box::new(source));
        self
    }

    /// Capture stack trace
    pub fn with_stack_trace(mut self) -> Self {
        // In a real implementation, capture actual stack trace
        self.stack_trace = Some("Stack trace captured".to_string());
        self
    }

    /// Convert to JSON
    pub fn to_json(&self) -> String {
        let mut json = format!(
            r#"{{"code":"{}","message":"{}","status_code":{}"#,
            escape_json(&self.code),
            escape_json(&self.message),
            self.status_code
        );

        if !self.details.is_empty() {
            let details: Vec<String> = self.details.iter()
                .map(|(k, v)| format!(r#""{}":"{}""#, escape_json(k), escape_json(v)))
                .collect();
            json.push_str(&format!(r#","details":{{{}}}"#, details.join(",")));
        }

        json.push_str(&format!(r#","timestamp":"{}""#, self.timestamp.to_rfc3339()));
        json.push('}');
        json
    }
}

impl std::fmt::Display for LmsError {
    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        write!(f, "[{}] {}", self.code, self.message)
    }
}

fn escape_json(s: &str) -> String {
    s.replace('\\', "\\\\")
     .replace('"', "\\\"")
     .replace('\n', "\\n")
}

// =============================================================================
// COMMON ERRORS
// =============================================================================

/// Not found error
pub fn not_found(resource: &str, id: &str) -> LmsError {
    LmsError::with_status(
        "NOT_FOUND",
        &format!("{} with ID '{}' not found", resource, id),
        404
    ).with_detail("resource", resource)
     .with_detail("id", id)
}

/// Validation error
pub fn validation_error(message: &str) -> LmsError {
    LmsError::with_status("VALIDATION_ERROR", message, 400)
}

/// Validation errors (multiple)
pub fn validation_errors(errors: List<ValidationError>) -> LmsError {
    let messages: Vec<String> = errors.iter()
        .map(|e| format!("{}: {}", e.field, e.message))
        .collect();

    let mut error = LmsError::with_status(
        "VALIDATION_ERROR",
        &format!("Validation failed: {}", messages.join("; ")),
        400
    );

    for (i, e) in errors.iter().enumerate() {
        error = error.with_detail(&format!("error_{}_field", i), &e.field);
        error = error.with_detail(&format!("error_{}_message", i), &e.message);
    }

    error
}

#[derive(Clone)]
pub type ValidationError {
    field: String,
    message: String,
    code: Option<String>
}

impl ValidationError {
    pub fn new(field: &str, message: &str) -> ValidationError {
        ValidationError {
            field: field.to_string(),
            message: message.to_string(),
            code: None
        }
    }

    pub fn with_code(field: &str, message: &str, code: &str) -> ValidationError {
        ValidationError {
            field: field.to_string(),
            message: message.to_string(),
            code: Some(code.to_string())
        }
    }
}

/// Unauthorized error
pub fn unauthorized(message: &str) -> LmsError {
    LmsError::with_status("UNAUTHORIZED", message, 401)
}

/// Forbidden error
pub fn forbidden(message: &str) -> LmsError {
    LmsError::with_status("FORBIDDEN", message, 403)
}

/// Conflict error
pub fn conflict(message: &str) -> LmsError {
    LmsError::with_status("CONFLICT", message, 409)
}

/// Rate limit error
pub fn rate_limited(retry_after: i32) -> LmsError {
    LmsError::with_status(
        "RATE_LIMITED",
        "Too many requests. Please try again later.",
        429
    ).with_detail("retry_after_seconds", &retry_after.to_string())
}

/// Internal error
pub fn internal_error(message: &str) -> LmsError {
    LmsError::with_status("INTERNAL_ERROR", message, 500)
}

/// Service unavailable
pub fn service_unavailable(service: &str) -> LmsError {
    LmsError::with_status(
        "SERVICE_UNAVAILABLE",
        &format!("Service '{}' is temporarily unavailable", service),
        503
    ).with_detail("service", service)
}

/// Timeout error
pub fn timeout(operation: &str) -> LmsError {
    LmsError::with_status(
        "TIMEOUT",
        &format!("Operation '{}' timed out", operation),
        504
    ).with_detail("operation", operation)
}

