/// Create a single-tenant LRS
fn create_single_tenant_lrs() -> LearningRecordStore {
    LearningRecordStore::init()
}

/// Create a multi-tenant LRS
fn create_multi_tenant_lrs() -> MultiTenantLearningRecordStore {
    MultiTenantLearningRecordStore::init()
}

/// Create a tenant configuration
fn create_tenant_config(tenant_id: TenantId) -> TenantLrsConfig {
    TenantLrsConfig::new(tenant_id)
}

/// Create a forwarding target
fn create_forwarding_target(
    id: String,
    endpoint: String,
    username: String,
    password: String
) -> ForwardingTarget {
    ForwardingTarget {
        id,
        endpoint,
        auth_type: ForwardingAuthType::Basic,
        username,
        password_encrypted: password, // Should be encrypted
        active: true,
        filter: None,
        retry_config: RetryConfig::default(),
        last_success: None,
        error_count: 0
    }
}

/// Create a forwarding filter
fn create_forwarding_filter() -> ForwardingFilter {
    ForwardingFilter {
        verbs: None,
        activities: None,
        agents: None,
        min_score: None,
        only_completed: false,
        only_success: false
    }
}
