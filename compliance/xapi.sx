/// Standard extension IRIs
type ExtensionIRIs;

impl ExtensionIRIs {
    /// cmi5 session ID
    fn cmi5_session_id() -> IRI {
        "https://w3id.org/xapi/cmi5/context/extensions/sessionid".to_string()
    }

    /// cmi5 mastery score
    fn cmi5_mastery_score() -> IRI {
        "https://w3id.org/xapi/cmi5/context/extensions/masteryscore".to_string()
    }

    /// cmi5 launch mode
    fn cmi5_launch_mode() -> IRI {
        "https://w3id.org/xapi/cmi5/context/extensions/launchmode".to_string()
    }

    /// cmi5 move on
    fn cmi5_move_on() -> IRI {
        "https://w3id.org/xapi/cmi5/context/extensions/moveon".to_string()
    }

    /// cmi5 progress
    fn cmi5_progress() -> IRI {
        "https://w3id.org/xapi/cmi5/result/extensions/progress".to_string()
    }

    /// Video time
    fn video_time() -> IRI {
        "https://w3id.org/xapi/video/extensions/time".to_string()
    }

    /// Video progress
    fn video_progress() -> IRI {
        "https://w3id.org/xapi/video/extensions/progress".to_string()
    }

    /// Video played segments
    fn video_played_segments() -> IRI {
        "https://w3id.org/xapi/video/extensions/played-segments".to_string()
    }

    /// Attempt number
    fn attempt_number() -> IRI {
        "http://id.tincanapi.com/extension/attempt-id".to_string()
    }

    /// Browser info
    fn browser_info() -> IRI {
        "http://id.tincanapi.com/extension/browser-info".to_string()
    }
}

// =============================================================================
// CONVENIENCE FUNCTIONS
// =============================================================================

/// Create a fluent statement builder from user
fn statement_for_user(user_id: &UserId, tenant_id: &TenantId, name: Option<String>) -> FluentStatementBuilder {
    FluentStatementBuilder::from_user(user_id, tenant_id, name)
}

/// Create a batch generator for a tenant
fn create_batch_generator(tenant_id: &TenantId) -> BatchStatementGenerator {
    BatchStatementGenerator::new(tenant_id.clone())
}

/// Create a voiding statement
fn void_statement(voider: Actor, statement_id_to_void: StatementId) -> Statement {
    Statement::new(
        voider,
        Verbs::voided(),
        Object::StatementRef(StatementRef::new(statement_id_to_void))
    )
}
