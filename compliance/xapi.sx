// =============================================================================
// OBJECT
// =============================================================================

/// Object of the statement (what was acted upon)
enum Object {
    /// Activity (learning content)
    Activity(Activity),
    /// Another agent
    Agent(Agent),
    /// Reference to another statement
    StatementRef(StatementRef),
    /// Sub-statement
    SubStatement(Box<SubStatement>)
}

impl Object {
    fn to_json(&self) -> JsonValue {
        match self {
            Object::Activity(activity) => activity.to_json(),
            Object::Agent(agent) => agent.to_json(),
            Object::StatementRef(stmt_ref) => stmt_ref.to_json(),
            Object::SubStatement(sub) => sub.to_json()
        }
    }

    fn from_json(json: &JsonValue) -> Option<Object> {
        let obj = json.as_object()?;
        let object_type = obj.get("objectType").and_then(|v| v.as_string());

        match object_type {
            Some("Agent") => Agent::from_json(json).map(Object::Agent),
            Some("Group") => Agent::from_json(json).map(Object::Agent),
            Some("StatementRef") => StatementRef::from_json(json).map(Object::StatementRef),
            Some("SubStatement") => SubStatement::from_json(json).map(|s| Object::SubStatement(Box::new(s))),
            _ => Activity::from_json(json).map(Object::Activity)
        }
    }
}

/// Activity (learning object)
type Activity {
    /// Object type (always "Activity")
    object_type: Option<String>,

    /// Activity IRI (unique identifier)
    id: IRI,

    /// Activity definition
    definition: Option<ActivityDefinition>
}

impl Activity {
    /// Create activity with ID
    fn new(id: IRI) -> Activity {
        Activity {
            object_type: Some("Activity".to_string()),
            id,
            definition: None
        }
    }

    /// Create activity with definition
    fn with_definition(id: IRI, definition: ActivityDefinition) -> Activity {
        Activity {
            object_type: Some("Activity".to_string()),
            id,
            definition: Some(definition)
        }
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref object_type) = self.object_type {
            json.insert("objectType".to_string(), JsonValue::String(object_type.clone()));
        }

        json.insert("id".to_string(), JsonValue::String(self.id.clone()));

        if let Some(ref definition) = self.definition {
            json.insert("definition".to_string(), definition.to_json());
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Activity> {
        let obj = json.as_object()?;

        Some(Activity {
            object_type: obj.get("objectType").and_then(|v| v.as_string()).map(|s| s.to_string()),
            id: obj.get("id").and_then(|v| v.as_string())?.to_string(),
            definition: obj.get("definition").and_then(|v| ActivityDefinition::from_json(v))
        })
    }
}

/// Activity definition
type ActivityDefinition {
    /// Human-readable name
    name: Option<LanguageMap>,

    /// Human-readable description
    description: Option<LanguageMap>,

    /// Activity type IRI
    activity_type: Option<IRI>,

    /// More info URL
    more_info: Option<IRI>,

    /// Interaction type (for assessment activities)
    interaction_type: Option<InteractionType>,

    /// Correct response patterns
    correct_responses_pattern: Option<List<String>>,

    /// Choices for choice/sequencing interactions
    choices: Option<List<InteractionComponent>>,

    /// Scale for likert interactions
    scale: Option<List<InteractionComponent>>,

    /// Source for matching interactions
    source: Option<List<InteractionComponent>>,

    /// Target for matching interactions
    target: Option<List<InteractionComponent>>,

    /// Steps for performance interactions
    steps: Option<List<InteractionComponent>>,

    /// Extensions
    extensions: Option<Map<IRI, JsonValue>>
}

impl ActivityDefinition {
    fn new() -> ActivityDefinition {
        ActivityDefinition {
            name: None,
            description: None,
            activity_type: None,
            more_info: None,
            interaction_type: None,
            correct_responses_pattern: None,
            choices: None,
            scale: None,
            source: None,
            target: None,
            steps: None,
            extensions: None
        }
    }

    /// Set name
    fn with_name(mut self, lang: &str, name: &str) -> ActivityDefinition {
        let mut map = self.name.unwrap_or_else(Map::new);
        map.insert(lang.to_string(), name.to_string());
        self.name = Some(map);
        self
    }

    /// Set description
    fn with_description(mut self, lang: &str, desc: &str) -> ActivityDefinition {
        let mut map = self.description.unwrap_or_else(Map::new);
        map.insert(lang.to_string(), desc.to_string());
        self.description = Some(map);
        self
    }

    /// Set activity type
    fn with_type(mut self, activity_type: IRI) -> ActivityDefinition {
        self.activity_type = Some(activity_type);
        self
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref name) = self.name {
            let name_json: Map<String, JsonValue> = name.iter()
                .map(|(k, v)| (k.clone(), JsonValue::String(v.clone())))
                .collect();
            json.insert("name".to_string(), JsonValue::Object(name_json));
        }

        if let Some(ref description) = self.description {
            let desc_json: Map<String, JsonValue> = description.iter()
                .map(|(k, v)| (k.clone(), JsonValue::String(v.clone())))
                .collect();
            json.insert("description".to_string(), JsonValue::Object(desc_json));
        }

        if let Some(ref activity_type) = self.activity_type {
            json.insert("type".to_string(), JsonValue::String(activity_type.clone()));
        }

        if let Some(ref more_info) = self.more_info {
            json.insert("moreInfo".to_string(), JsonValue::String(more_info.clone()));
        }

        if let Some(ref interaction_type) = self.interaction_type {
            json.insert("interactionType".to_string(), JsonValue::String(interaction_type.to_string()));
        }

        if let Some(ref patterns) = self.correct_responses_pattern {
            let patterns_json: Vec<JsonValue> = patterns.iter()
                .map(|p| JsonValue::String(p.clone()))
                .collect();
            json.insert("correctResponsesPattern".to_string(), JsonValue::Array(patterns_json));
        }

        if let Some(ref choices) = self.choices {
            json.insert("choices".to_string(), self.components_to_json(choices));
        }

        if let Some(ref extensions) = self.extensions {
            json.insert("extensions".to_string(), JsonValue::Object(extensions.clone()));
        }

        JsonValue::Object(json)
    }

    fn components_to_json(&self, components: &List<InteractionComponent>) -> JsonValue {
        let arr: Vec<JsonValue> = components.iter().map(|c| c.to_json()).collect();
        JsonValue::Array(arr)
    }

    fn from_json(json: &JsonValue) -> Option<ActivityDefinition> {
        let obj = json.as_object()?;

        Some(ActivityDefinition {
            name: obj.get("name").and_then(|v| v.as_object()).map(|o| {
                o.iter().filter_map(|(k, v)| v.as_string().map(|s| (k.clone(), s.to_string()))).collect()
            }),
            description: obj.get("description").and_then(|v| v.as_object()).map(|o| {
                o.iter().filter_map(|(k, v)| v.as_string().map(|s| (k.clone(), s.to_string()))).collect()
            }),
            activity_type: obj.get("type").and_then(|v| v.as_string()).map(|s| s.to_string()),
            more_info: obj.get("moreInfo").and_then(|v| v.as_string()).map(|s| s.to_string()),
            interaction_type: obj.get("interactionType").and_then(|v| v.as_string()).and_then(|s| InteractionType::from_string(&s)),
            correct_responses_pattern: obj.get("correctResponsesPattern").and_then(|v| v.as_array()).map(|arr| {
                arr.iter().filter_map(|v| v.as_string().map(|s| s.to_string())).collect()
            }),
            choices: obj.get("choices").and_then(|v| parse_interaction_components(v)),
            scale: obj.get("scale").and_then(|v| parse_interaction_components(v)),
            source: obj.get("source").and_then(|v| parse_interaction_components(v)),
            target: obj.get("target").and_then(|v| parse_interaction_components(v)),
            steps: obj.get("steps").and_then(|v| parse_interaction_components(v)),
            extensions: obj.get("extensions").and_then(|v| v.as_object()).cloned()
        })
    }
}

/// Interaction type for assessment activities
enum InteractionType {
    TrueFalse,
    Choice,
    FillIn,
    LongFillIn,
    Matching,
    Performance,
    Sequencing,
    Likert,
    Numeric,
    Other
}

impl InteractionType {
    fn to_string(&self) -> String {
        match self {
            InteractionType::TrueFalse => "true-false",
            InteractionType::Choice => "choice",
            InteractionType::FillIn => "fill-in",
            InteractionType::LongFillIn => "long-fill-in",
            InteractionType::Matching => "matching",
            InteractionType::Performance => "performance",
            InteractionType::Sequencing => "sequencing",
            InteractionType::Likert => "likert",
            InteractionType::Numeric => "numeric",
            InteractionType::Other => "other"
        }.to_string()
    }

    fn from_string(s: &str) -> Option<InteractionType> {
        match s {
            "true-false" => Some(InteractionType::TrueFalse),
            "choice" => Some(InteractionType::Choice),
            "fill-in" => Some(InteractionType::FillIn),
            "long-fill-in" => Some(InteractionType::LongFillIn),
            "matching" => Some(InteractionType::Matching),
            "performance" => Some(InteractionType::Performance),
            "sequencing" => Some(InteractionType::Sequencing),
            "likert" => Some(InteractionType::Likert),
            "numeric" => Some(InteractionType::Numeric),
            "other" => Some(InteractionType::Other),
            _ => None
        }
    }
}

/// Interaction component (choice, scale item, etc.)
type InteractionComponent {
    /// Component ID
    id: String,

    /// Component description
    description: Option<LanguageMap>
}

impl InteractionComponent {
    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();
        json.insert("id".to_string(), JsonValue::String(self.id.clone()));

        if let Some(ref description) = self.description {
            let desc_json: Map<String, JsonValue> = description.iter()
                .map(|(k, v)| (k.clone(), JsonValue::String(v.clone())))
                .collect();
            json.insert("description".to_string(), JsonValue::Object(desc_json));
        }

        JsonValue::Object(json)
    }
}

/// Statement reference
type StatementRef {
    /// Object type (always "StatementRef")
    object_type: String,

    /// ID of referenced statement
    id: StatementId
}

impl StatementRef {
    fn new(id: StatementId) -> StatementRef {
        StatementRef {
            object_type: "StatementRef".to_string(),
            id
        }
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();
        json.insert("objectType".to_string(), JsonValue::String(self.object_type.clone()));
        json.insert("id".to_string(), JsonValue::String(self.id.clone()));
        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<StatementRef> {
        let obj = json.as_object()?;
        Some(StatementRef {
            object_type: "StatementRef".to_string(),
            id: obj.get("id").and_then(|v| v.as_string())?.to_string()
        })
    }
}

/// Sub-statement (embedded statement)
type SubStatement {
    actor: Actor,
    verb: Verb,
    object: Object,
    result: Option<Result>,
    context: Option<Context>,
    timestamp: Option<String>
}

impl SubStatement {
    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();
        json.insert("objectType".to_string(), JsonValue::String("SubStatement".to_string()));
        json.insert("actor".to_string(), self.actor.to_json());
        json.insert("verb".to_string(), self.verb.to_json());
        json.insert("object".to_string(), self.object.to_json());

        if let Some(ref result) = self.result {
            json.insert("result".to_string(), result.to_json());
        }

        if let Some(ref context) = self.context {
            json.insert("context".to_string(), context.to_json());
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<SubStatement> {
        let obj = json.as_object()?;

        Some(SubStatement {
            actor: Actor::from_json(obj.get("actor")?)?,
            verb: Verb::from_json(obj.get("verb")?)?,
            object: Object::from_json(obj.get("object")?)?,
            result: obj.get("result").and_then(|v| Result::from_json(v)),
            context: obj.get("context").and_then(|v| Context::from_json(v)),
            timestamp: obj.get("timestamp").and_then(|v| v.as_string()).map(|s| s.to_string())
        })
    }
}

