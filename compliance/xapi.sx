/// Intelligo LMS - xAPI (Experience API) Integration
///
/// Implementation of the xAPI (Tin Can) 1.0.3 specification for learning activity tracking.
/// Provides statement generation, verb registry, activity types, statement builder with
/// fluent API, context activities (parent, grouping, category), result handling with score,
/// success, completion, duration, response, extensions support, statement validation,
/// and batch statement generation.

module intelligo::compliance::xapi

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, Set, List}
use std::http::{HttpClient, HttpRequest, HttpResponse, HttpMethod}
use std::json::{Json, JsonValue}
use std::crypto::{sha256, sha1}

// =============================================================================
// IDENTITY TYPES
// =============================================================================

/// Unique identifier for a statement
type StatementId = String

/// IRI (Internationalized Resource Identifier)
type IRI = String

/// Language code (e.g., "en-US")
type LanguageCode = String

/// Language map (language -> text)
type LanguageMap = Map<LanguageCode, String>

// =============================================================================
// XAPI STATEMENT
// =============================================================================

/// Complete xAPI Statement
type Statement {
    /// Unique identifier for this statement
    id: Option<StatementId>,

    /// Actor who performed the action
    actor: Actor,

    /// Verb describing the action
    verb: Verb,

    /// Object the action was performed on
    object: Object,

    /// Result of the action
    result: Option<Result>,

    /// Context surrounding the action
    context: Option<Context>,

    /// Timestamp when action occurred (ISO 8601)
    timestamp: Option<String>,

    /// Timestamp when stored in LRS (ISO 8601, set by LRS)
    stored: Option<String>,

    /// Authority asserting this statement (usually the LRS)
    authority: Option<Actor>,

    /// Statement version (default: "1.0.0")
    version: Option<String>,

    /// Attachments
    attachments: Option<List<Attachment>>
}

impl Statement {
    fn new(actor: Actor, verb: Verb, object: Object) -> Statement {
        Statement {
            id: Some(generate_uuid()),
            actor,
            verb,
            object,
            result: None,
            context: None,
            timestamp: Some(DateTime::now().to_iso8601()),
            stored: None,
            authority: None,
            version: Some("1.0.0".to_string()),
            attachments: None
        }
    }

    /// Add result to statement
    fn with_result(mut self, result: Result) -> Statement {
        self.result = Some(result);
        self
    }

    /// Add context to statement
    fn with_context(mut self, context: Context) -> Statement {
        self.context = Some(context);
        self
    }

    /// Convert to JSON
    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref id) = self.id {
            json.insert("id".to_string(), JsonValue::String(id.clone()));
        }

        json.insert("actor".to_string(), self.actor.to_json());
        json.insert("verb".to_string(), self.verb.to_json());
        json.insert("object".to_string(), self.object.to_json());

        if let Some(ref result) = self.result {
            json.insert("result".to_string(), result.to_json());
        }

        if let Some(ref context) = self.context {
            json.insert("context".to_string(), context.to_json());
        }

        if let Some(ref timestamp) = self.timestamp {
            json.insert("timestamp".to_string(), JsonValue::String(timestamp.clone()));
        }

        if let Some(ref version) = self.version {
            json.insert("version".to_string(), JsonValue::String(version.clone()));
        }

        JsonValue::Object(json)
    }

    /// Parse from JSON
    fn from_json(json: &JsonValue) -> Option<Statement> {
        let obj = json.as_object()?;

        Some(Statement {
            id: obj.get("id").and_then(|v| v.as_string()).map(|s| s.to_string()),
            actor: Actor::from_json(obj.get("actor")?)?,
            verb: Verb::from_json(obj.get("verb")?)?,
            object: Object::from_json(obj.get("object")?)?,
            result: obj.get("result").and_then(|v| Result::from_json(v)),
            context: obj.get("context").and_then(|v| Context::from_json(v)),
            timestamp: obj.get("timestamp").and_then(|v| v.as_string()).map(|s| s.to_string()),
            stored: obj.get("stored").and_then(|v| v.as_string()).map(|s| s.to_string()),
            authority: obj.get("authority").and_then(|v| Actor::from_json(v)),
            version: obj.get("version").and_then(|v| v.as_string()).map(|s| s.to_string()),
            attachments: obj.get("attachments").and_then(|v| {
                v.as_array().map(|arr| {
                    arr.iter()
                        .filter_map(|a| Attachment::from_json(a))
                        .collect()
                })
            })
        })
    }
}

// =============================================================================
// ACTOR
// =============================================================================

/// Actor in an xAPI statement (Agent or Group)
enum Actor {
    /// Individual agent
    Agent(Agent),
    /// Group of agents
    Group(Group)
}

impl Actor {
    fn to_json(&self) -> JsonValue {
        match self {
            Actor::Agent(agent) => agent.to_json(),
            Actor::Group(group) => group.to_json()
        }
    }

    fn from_json(json: &JsonValue) -> Option<Actor> {
        let obj = json.as_object()?;
        let object_type = obj.get("objectType").and_then(|v| v.as_string());

        if object_type == Some("Group") {
            Group::from_json(json).map(Actor::Group)
        } else {
            Agent::from_json(json).map(Actor::Agent)
        }
    }
}

/// Agent (individual learner or system)
type Agent {
    /// Object type (always "Agent" for agents)
    object_type: Option<String>,

    /// Name of the agent
    name: Option<String>,

    /// Mailto IRI (email)
    mbox: Option<IRI>,

    /// SHA1 hash of mailto IRI
    mbox_sha1sum: Option<String>,

    /// OpenID URI
    openid: Option<IRI>,

    /// Account on a system
    account: Option<Account>
}

impl Agent {
    /// Create agent from email
    fn from_email(email: &str, name: Option<String>) -> Agent {
        Agent {
            object_type: Some("Agent".to_string()),
            name,
            mbox: Some(format!("mailto:{}", email)),
            mbox_sha1sum: None,
            openid: None,
            account: None
        }
    }

    /// Create agent from account
    fn from_account(home_page: &str, account_name: &str, name: Option<String>) -> Agent {
        Agent {
            object_type: Some("Agent".to_string()),
            name,
            mbox: None,
            mbox_sha1sum: None,
            openid: None,
            account: Some(Account {
                home_page: home_page.to_string(),
                name: account_name.to_string()
            })
        }
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref object_type) = self.object_type {
            json.insert("objectType".to_string(), JsonValue::String(object_type.clone()));
        }

        if let Some(ref name) = self.name {
            json.insert("name".to_string(), JsonValue::String(name.clone()));
        }

        if let Some(ref mbox) = self.mbox {
            json.insert("mbox".to_string(), JsonValue::String(mbox.clone()));
        }

        if let Some(ref mbox_sha1sum) = self.mbox_sha1sum {
            json.insert("mbox_sha1sum".to_string(), JsonValue::String(mbox_sha1sum.clone()));
        }

        if let Some(ref openid) = self.openid {
            json.insert("openid".to_string(), JsonValue::String(openid.clone()));
        }

        if let Some(ref account) = self.account {
            json.insert("account".to_string(), account.to_json());
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Agent> {
        let obj = json.as_object()?;

        Some(Agent {
            object_type: obj.get("objectType").and_then(|v| v.as_string()).map(|s| s.to_string()),
            name: obj.get("name").and_then(|v| v.as_string()).map(|s| s.to_string()),
            mbox: obj.get("mbox").and_then(|v| v.as_string()).map(|s| s.to_string()),
            mbox_sha1sum: obj.get("mbox_sha1sum").and_then(|v| v.as_string()).map(|s| s.to_string()),
            openid: obj.get("openid").and_then(|v| v.as_string()).map(|s| s.to_string()),
            account: obj.get("account").and_then(|v| Account::from_json(v))
        })
    }
}

/// Account on a system
type Account {
    /// Homepage of the account system
    home_page: IRI,

    /// Account name/ID
    name: String
}

impl Account {
    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();
        json.insert("homePage".to_string(), JsonValue::String(self.home_page.clone()));
        json.insert("name".to_string(), JsonValue::String(self.name.clone()));
        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Account> {
        let obj = json.as_object()?;
        Some(Account {
            home_page: obj.get("homePage").and_then(|v| v.as_string())?.to_string(),
            name: obj.get("name").and_then(|v| v.as_string())?.to_string()
        })
    }
}

/// Group of agents
type Group {
    /// Object type (always "Group")
    object_type: String,

    /// Name of the group
    name: Option<String>,

    /// Members of the group
    member: Option<List<Agent>>,

    /// Identified group fields (same as Agent)
    mbox: Option<IRI>,
    mbox_sha1sum: Option<String>,
    openid: Option<IRI>,
    account: Option<Account>
}

impl Group {
    /// Create anonymous group
    fn anonymous(members: List<Agent>) -> Group {
        Group {
            object_type: "Group".to_string(),
            name: None,
            member: Some(members),
            mbox: None,
            mbox_sha1sum: None,
            openid: None,
            account: None
        }
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();
        json.insert("objectType".to_string(), JsonValue::String(self.object_type.clone()));

        if let Some(ref name) = self.name {
            json.insert("name".to_string(), JsonValue::String(name.clone()));
        }

        if let Some(ref members) = self.member {
            let members_json: Vec<JsonValue> = members.iter().map(|m| m.to_json()).collect();
            json.insert("member".to_string(), JsonValue::Array(members_json));
        }

        if let Some(ref mbox) = self.mbox {
            json.insert("mbox".to_string(), JsonValue::String(mbox.clone()));
        }

        if let Some(ref account) = self.account {
            json.insert("account".to_string(), account.to_json());
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Group> {
        let obj = json.as_object()?;

        Some(Group {
            object_type: "Group".to_string(),
            name: obj.get("name").and_then(|v| v.as_string()).map(|s| s.to_string()),
            member: obj.get("member").and_then(|v| v.as_array()).map(|arr| {
                arr.iter().filter_map(|m| Agent::from_json(m)).collect()
            }),
            mbox: obj.get("mbox").and_then(|v| v.as_string()).map(|s| s.to_string()),
            mbox_sha1sum: obj.get("mbox_sha1sum").and_then(|v| v.as_string()).map(|s| s.to_string()),
            openid: obj.get("openid").and_then(|v| v.as_string()).map(|s| s.to_string()),
            account: obj.get("account").and_then(|v| Account::from_json(v))
        })
    }
}

// =============================================================================
// VERB
// =============================================================================

/// Verb describing the action taken
type Verb {
    /// Verb IRI (unique identifier)
    id: IRI,

    /// Human-readable names in different languages
    display: Option<LanguageMap>
}

impl Verb {
    /// Create verb with ID and display name
    fn new(id: IRI, display_en: Option<String>) -> Verb {
        let display = display_en.map(|d| {
            let mut map = Map::new();
            map.insert("en-US".to_string(), d);
            map
        });

        Verb { id, display }
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();
        json.insert("id".to_string(), JsonValue::String(self.id.clone()));

        if let Some(ref display) = self.display {
            let display_json: Map<String, JsonValue> = display.iter()
                .map(|(k, v)| (k.clone(), JsonValue::String(v.clone())))
                .collect();
            json.insert("display".to_string(), JsonValue::Object(display_json));
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Verb> {
        let obj = json.as_object()?;

        Some(Verb {
            id: obj.get("id").and_then(|v| v.as_string())?.to_string(),
            display: obj.get("display").and_then(|v| v.as_object()).map(|o| {
                o.iter()
                    .filter_map(|(k, v)| v.as_string().map(|s| (k.clone(), s.to_string())))
                    .collect()
            })
        })
    }
}

