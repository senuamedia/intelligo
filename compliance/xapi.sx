// =============================================================================
// RESULT
// =============================================================================

/// Result of an action
type Result {
    /// Score
    score: Option<Score>,

    /// Success status
    success: Option<Bool>,

    /// Completion status
    completion: Option<Bool>,

    /// Response given by actor
    response: Option<String>,

    /// Duration (ISO 8601)
    duration: Option<String>,

    /// Extensions
    extensions: Option<Map<IRI, JsonValue>>
}

impl Result {
    fn new() -> Result {
        Result {
            score: None,
            success: None,
            completion: None,
            response: None,
            duration: None,
            extensions: None
        }
    }

    /// Set score
    fn with_score(mut self, score: Score) -> Result {
        self.score = Some(score);
        self
    }

    /// Set success
    fn with_success(mut self, success: Bool) -> Result {
        self.success = Some(success);
        self
    }

    /// Set completion
    fn with_completion(mut self, completion: Bool) -> Result {
        self.completion = Some(completion);
        self
    }

    /// Set response
    fn with_response(mut self, response: String) -> Result {
        self.response = Some(response);
        self
    }

    /// Set duration
    fn with_duration(mut self, duration: Duration) -> Result {
        self.duration = Some(format_iso8601_duration(duration));
        self
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref score) = self.score {
            json.insert("score".to_string(), score.to_json());
        }

        if let Some(success) = self.success {
            json.insert("success".to_string(), JsonValue::Bool(success));
        }

        if let Some(completion) = self.completion {
            json.insert("completion".to_string(), JsonValue::Bool(completion));
        }

        if let Some(ref response) = self.response {
            json.insert("response".to_string(), JsonValue::String(response.clone()));
        }

        if let Some(ref duration) = self.duration {
            json.insert("duration".to_string(), JsonValue::String(duration.clone()));
        }

        if let Some(ref extensions) = self.extensions {
            json.insert("extensions".to_string(), JsonValue::Object(extensions.clone()));
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Result> {
        let obj = json.as_object()?;

        Some(Result {
            score: obj.get("score").and_then(|v| Score::from_json(v)),
            success: obj.get("success").and_then(|v| v.as_bool()),
            completion: obj.get("completion").and_then(|v| v.as_bool()),
            response: obj.get("response").and_then(|v| v.as_string()).map(|s| s.to_string()),
            duration: obj.get("duration").and_then(|v| v.as_string()).map(|s| s.to_string()),
            extensions: obj.get("extensions").and_then(|v| v.as_object()).cloned()
        })
    }
}

/// Score in a result
type Score {
    /// Scaled score (-1 to 1)
    scaled: Option<f32>,

    /// Raw score
    raw: Option<f32>,

    /// Minimum possible score
    min: Option<f32>,

    /// Maximum possible score
    max: Option<f32>
}

impl Score {
    fn new() -> Score {
        Score {
            scaled: None,
            raw: None,
            min: None,
            max: None
        }
    }

    /// Create from raw score with min/max
    fn from_raw(raw: f32, min: f32, max: f32) -> Score {
        let scaled = if max > min {
            Some((raw - min) / (max - min) * 2.0 - 1.0) // Convert to -1 to 1
        } else {
            None
        };

        Score {
            scaled,
            raw: Some(raw),
            min: Some(min),
            max: Some(max)
        }
    }

    /// Create from percentage (0-100)
    fn from_percentage(percent: f32) -> Score {
        Score {
            scaled: Some(percent / 50.0 - 1.0), // Convert 0-100 to -1 to 1
            raw: Some(percent),
            min: Some(0.0),
            max: Some(100.0)
        }
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(scaled) = self.scaled {
            json.insert("scaled".to_string(), JsonValue::Number(scaled as f64));
        }

        if let Some(raw) = self.raw {
            json.insert("raw".to_string(), JsonValue::Number(raw as f64));
        }

        if let Some(min) = self.min {
            json.insert("min".to_string(), JsonValue::Number(min as f64));
        }

        if let Some(max) = self.max {
            json.insert("max".to_string(), JsonValue::Number(max as f64));
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Score> {
        let obj = json.as_object()?;

        Some(Score {
            scaled: obj.get("scaled").and_then(|v| v.as_f64()).map(|n| n as f32),
            raw: obj.get("raw").and_then(|v| v.as_f64()).map(|n| n as f32),
            min: obj.get("min").and_then(|v| v.as_f64()).map(|n| n as f32),
            max: obj.get("max").and_then(|v| v.as_f64()).map(|n| n as f32)
        })
    }
}

// =============================================================================
// CONTEXT
// =============================================================================

/// Context surrounding the action
type Context {
    /// Registration (attempt) UUID
    registration: Option<String>,

    /// Instructor
    instructor: Option<Actor>,

    /// Team
    team: Option<Group>,

    /// Context activities
    context_activities: Option<ContextActivities>,

    /// Revision of the content
    revision: Option<String>,

    /// Platform
    platform: Option<String>,

    /// Language (RFC 5646)
    language: Option<String>,

    /// Statement reference
    statement: Option<StatementRef>,

    /// Extensions
    extensions: Option<Map<IRI, JsonValue>>
}

impl Context {
    fn new() -> Context {
        Context {
            registration: None,
            instructor: None,
            team: None,
            context_activities: None,
            revision: None,
            platform: None,
            language: None,
            statement: None,
            extensions: None
        }
    }

    /// Set registration
    fn with_registration(mut self, registration: String) -> Context {
        self.registration = Some(registration);
        self
    }

    /// Set instructor
    fn with_instructor(mut self, instructor: Actor) -> Context {
        self.instructor = Some(instructor);
        self
    }

    /// Set platform
    fn with_platform(mut self, platform: String) -> Context {
        self.platform = Some(platform);
        self
    }

    /// Set language
    fn with_language(mut self, language: String) -> Context {
        self.language = Some(language);
        self
    }

    /// Set context activities
    fn with_context_activities(mut self, activities: ContextActivities) -> Context {
        self.context_activities = Some(activities);
        self
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref registration) = self.registration {
            json.insert("registration".to_string(), JsonValue::String(registration.clone()));
        }

        if let Some(ref instructor) = self.instructor {
            json.insert("instructor".to_string(), instructor.to_json());
        }

        if let Some(ref team) = self.team {
            json.insert("team".to_string(), team.to_json());
        }

        if let Some(ref context_activities) = self.context_activities {
            json.insert("contextActivities".to_string(), context_activities.to_json());
        }

        if let Some(ref revision) = self.revision {
            json.insert("revision".to_string(), JsonValue::String(revision.clone()));
        }

        if let Some(ref platform) = self.platform {
            json.insert("platform".to_string(), JsonValue::String(platform.clone()));
        }

        if let Some(ref language) = self.language {
            json.insert("language".to_string(), JsonValue::String(language.clone()));
        }

        if let Some(ref extensions) = self.extensions {
            json.insert("extensions".to_string(), JsonValue::Object(extensions.clone()));
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<Context> {
        let obj = json.as_object()?;

        Some(Context {
            registration: obj.get("registration").and_then(|v| v.as_string()).map(|s| s.to_string()),
            instructor: obj.get("instructor").and_then(|v| Actor::from_json(v)),
            team: obj.get("team").and_then(|v| Group::from_json(v)),
            context_activities: obj.get("contextActivities").and_then(|v| ContextActivities::from_json(v)),
            revision: obj.get("revision").and_then(|v| v.as_string()).map(|s| s.to_string()),
            platform: obj.get("platform").and_then(|v| v.as_string()).map(|s| s.to_string()),
            language: obj.get("language").and_then(|v| v.as_string()).map(|s| s.to_string()),
            statement: obj.get("statement").and_then(|v| StatementRef::from_json(v)),
            extensions: obj.get("extensions").and_then(|v| v.as_object()).cloned()
        })
    }
}

/// Context activities
type ContextActivities {
    /// Parent activities (immediate context)
    parent: Option<List<Activity>>,

    /// Grouping activities (wider context)
    grouping: Option<List<Activity>>,

    /// Category activities (profile/recipe)
    category: Option<List<Activity>>,

    /// Other related activities
    other: Option<List<Activity>>
}

impl ContextActivities {
    fn new() -> ContextActivities {
        ContextActivities {
            parent: None,
            grouping: None,
            category: None,
            other: None
        }
    }

    /// Add parent activity
    fn with_parent(mut self, activity: Activity) -> ContextActivities {
        let mut parents = self.parent.unwrap_or_default();
        parents.push(activity);
        self.parent = Some(parents);
        self
    }

    /// Add grouping activity
    fn with_grouping(mut self, activity: Activity) -> ContextActivities {
        let mut groupings = self.grouping.unwrap_or_default();
        groupings.push(activity);
        self.grouping = Some(groupings);
        self
    }

    fn to_json(&self) -> JsonValue {
        let mut json = Map::new();

        if let Some(ref parent) = self.parent {
            let arr: Vec<JsonValue> = parent.iter().map(|a| a.to_json()).collect();
            json.insert("parent".to_string(), JsonValue::Array(arr));
        }

        if let Some(ref grouping) = self.grouping {
            let arr: Vec<JsonValue> = grouping.iter().map(|a| a.to_json()).collect();
            json.insert("grouping".to_string(), JsonValue::Array(arr));
        }

        if let Some(ref category) = self.category {
            let arr: Vec<JsonValue> = category.iter().map(|a| a.to_json()).collect();
            json.insert("category".to_string(), JsonValue::Array(arr));
        }

        if let Some(ref other) = self.other {
            let arr: Vec<JsonValue> = other.iter().map(|a| a.to_json()).collect();
            json.insert("other".to_string(), JsonValue::Array(arr));
        }

        JsonValue::Object(json)
    }

    fn from_json(json: &JsonValue) -> Option<ContextActivities> {
        let obj = json.as_object()?;

        fn parse_activities(value: Option<&JsonValue>) -> Option<List<Activity>> {
            value.and_then(|v| v.as_array()).map(|arr| {
                arr.iter().filter_map(|a| Activity::from_json(a)).collect()
            })
        }

        Some(ContextActivities {
            parent: parse_activities(obj.get("parent")),
            grouping: parse_activities(obj.get("grouping")),
            category: parse_activities(obj.get("category")),
            other: parse_activities(obj.get("other"))
        })
    }
}

/// Attachment
type Attachment {
    /// Usage type IRI
    usage_type: IRI,

    /// Display name
    display: LanguageMap,

    /// Description
    description: Option<LanguageMap>,

    /// Content type (MIME)
    content_type: String,

    /// Length in bytes
    length: i64,

    /// SHA-2 hash
    sha2: String,

    /// File URL (if not inline)
    file_url: Option<IRI>
}

impl Attachment {
    fn to_json(&self) -> JsonValue {
        let mut obj = JsonObject::new();
        obj.insert("usageType".to_string(), JsonValue::String(self.usage_type.0.clone()));
        obj.insert("display".to_string(), language_map_to_json(&self.display));
        if let Some(ref desc) = self.description {
            obj.insert("description".to_string(), language_map_to_json(desc));
        }
        obj.insert("contentType".to_string(), JsonValue::String(self.content_type.clone()));
        obj.insert("length".to_string(), JsonValue::Number(self.length as f64));
        obj.insert("sha2".to_string(), JsonValue::String(self.sha2.clone()));
        if let Some(ref url) = self.file_url {
            obj.insert("fileUrl".to_string(), JsonValue::String(url.0.clone()));
        }
        JsonValue::Object(obj)
    }

    fn from_json(json: &JsonValue) -> Option<Attachment> {
        let obj = json.as_object()?;

        let usage_type = obj.get("usageType")
            .and_then(|v| v.as_string())
            .map(|s| IRI(s.to_string()))?;

        let display = obj.get("display")
            .and_then(|v| parse_language_map(v))
            .unwrap_or_default();

        let description = obj.get("description")
            .and_then(|v| parse_language_map(v));

        let content_type = obj.get("contentType")
            .and_then(|v| v.as_string())
            .map(|s| s.to_string())?;

        let length = obj.get("length")
            .and_then(|v| v.as_number())
            .map(|n| n as i64)?;

        let sha2 = obj.get("sha2")
            .and_then(|v| v.as_string())
            .map(|s| s.to_string())?;

        let file_url = obj.get("fileUrl")
            .and_then(|v| v.as_string())
            .map(|s| IRI(s.to_string()));

        Some(Attachment {
            usage_type,
            display,
            description,
            content_type,
            length,
            sha2,
            file_url
        })
    }
}

// =============================================================================
// XAPI CLIENT
// =============================================================================

/// LRS connection configuration
type LrsConfig {
    /// Endpoint URL
    endpoint: String,

    /// Authorization header (Basic auth or OAuth token)
    authorization: String,

    /// Version header value
    version: String
}

impl LrsConfig {
    /// Create config with Basic auth
    fn with_basic_auth(endpoint: String, username: String, password: String) -> LrsConfig {
        let credentials = base64_encode(&format!("{}:{}", username, password));
        LrsConfig {
            endpoint: endpoint.trim_end_matches('/').to_string(),
            authorization: format!("Basic {}", credentials),
            version: "1.0.3".to_string()
        }
    }

    /// Create config with OAuth token
    fn with_oauth(endpoint: String, token: String) -> LrsConfig {
        LrsConfig {
            endpoint: endpoint.trim_end_matches('/').to_string(),
            authorization: format!("Bearer {}", token),
            version: "1.0.3".to_string()
        }
    }
}

/// Messages for xApiClient actor
enum XApiMessage {
    /// Send a single statement
    SendStatement {
        statement: Statement,
        reply_to: Actor<Result<StatementId, XApiError>>
    },

    /// Send multiple statements
    SendStatements {
        statements: List<Statement>,
        reply_to: Actor<Result<List<StatementId>, XApiError>>
    },

    /// Get a statement by ID
    GetStatement {
        statement_id: StatementId,
        reply_to: Actor<Result<Statement, XApiError>>
    },

    /// Query statements
    QueryStatements {
        query: StatementQuery,
        reply_to: Actor<Result<StatementResult, XApiError>>
    },

    /// Void a statement
    VoidStatement {
        statement_id: StatementId,
        actor: Actor,
        reply_to: Actor<Result<StatementId, XApiError>>
    },

    /// Get state
    GetState {
        activity_id: IRI,
        agent: Agent,
        state_id: String,
        registration: Option<String>,
        reply_to: Actor<Result<JsonValue, XApiError>>
    },

    /// Set state
    SetState {
        activity_id: IRI,
        agent: Agent,
        state_id: String,
        registration: Option<String>,
        state: JsonValue,
        reply_to: Actor<Result<(), XApiError>>
    },

    /// Delete state
    DeleteState {
        activity_id: IRI,
        agent: Agent,
        state_id: String,
        registration: Option<String>,
        reply_to: Actor<Result<(), XApiError>>
    }
}

/// Statement query parameters
type StatementQuery {
    /// Agent filter
    agent: Option<Agent>,

    /// Verb IRI filter
    verb: Option<IRI>,

    /// Activity IRI filter
    activity: Option<IRI>,

    /// Registration filter
    registration: Option<String>,

    /// Related activities flag
    related_activities: Option<Bool>,

    /// Related agents flag
    related_agents: Option<Bool>,

    /// Since timestamp (ISO 8601)
    since: Option<String>,

    /// Until timestamp (ISO 8601)
    until: Option<String>,

    /// Limit results
    limit: Option<i32>,

    /// Ascending order
    ascending: Option<Bool>,

    /// Format (ids, exact, canonical)
    format: Option<StatementFormat>
}

/// Statement response format
enum StatementFormat {
    /// Return only statement IDs
    Ids,
    /// Return exact representation
    Exact,
    /// Return canonical representation
    Canonical
}

impl StatementFormat {
    fn to_string(&self) -> String {
        match self {
            StatementFormat::Ids => "ids",
            StatementFormat::Exact => "exact",
            StatementFormat::Canonical => "canonical"
        }.to_string()
    }
}

impl StatementQuery {
    fn new() -> StatementQuery {
        StatementQuery {
            agent: None,
            verb: None,
            activity: None,
            registration: None,
            related_activities: None,
            related_agents: None,
            since: None,
            until: None,
            limit: None,
            ascending: None
        }
    }

    /// Build query string
    fn to_query_string(&self) -> String {
        let mut params = vec![];

        if let Some(ref agent) = self.agent {
            params.push(format!("agent={}", url_encode(&agent.to_json().to_string())));
        }

        if let Some(ref verb) = self.verb {
            params.push(format!("verb={}", url_encode(verb)));
        }

        if let Some(ref activity) = self.activity {
            params.push(format!("activity={}", url_encode(activity)));
        }

        if let Some(ref registration) = self.registration {
            params.push(format!("registration={}", registration));
        }

        if let Some(related_activities) = self.related_activities {
            params.push(format!("related_activities={}", related_activities));
        }

        if let Some(related_agents) = self.related_agents {
            params.push(format!("related_agents={}", related_agents));
        }

        if let Some(ref since) = self.since {
            params.push(format!("since={}", url_encode(since)));
        }

        if let Some(ref until) = self.until {
            params.push(format!("until={}", url_encode(until)));
        }

        if let Some(limit) = self.limit {
            params.push(format!("limit={}", limit));
        }

        if let Some(ascending) = self.ascending {
            params.push(format!("ascending={}", ascending));
        }

        params.join("&")
    }
}

/// Statement query result
type StatementResult {
    /// Returned statements
    statements: List<Statement>,

    /// More results URL
    more: Option<String>
}

/// xAPI error type
enum XApiError {
    /// Network error
    NetworkError { message: String },
    /// Authentication error
    AuthError { message: String },
    /// Bad request
    BadRequest { message: String },
    /// Not found
    NotFound { resource: String },
    /// Conflict
    Conflict { message: String },
    /// Server error
    ServerError { message: String },
    /// Parse error
    ParseError { message: String }
}

impl XApiError {
    fn message(&self) -> String {
        match self {
            XApiError::NetworkError { message } => format!("Network error: {}", message),
            XApiError::AuthError { message } => format!("Authentication error: {}", message),
            XApiError::BadRequest { message } => format!("Bad request: {}", message),
            XApiError::NotFound { resource } => format!("Not found: {}", resource),
            XApiError::Conflict { message } => format!("Conflict: {}", message),
            XApiError::ServerError { message } => format!("Server error: {}", message),
            XApiError::ParseError { message } => format!("Parse error: {}", message)
        }
    }
}

/// xAPI Client actor
actor XApiClient {
    config: LrsConfig,
    http_client: HttpClient,

    /// Initialize client
    fn init(config: LrsConfig) -> XApiClient {
        XApiClient {
            config,
            http_client: HttpClient::new()
        }
    }

    /// Handle messages
    fn receive(&mut self, msg: XApiMessage) {
        match msg {
            XApiMessage::SendStatement { statement, reply_to } => {
                let result = self.send_statement(statement);
                reply_to.send(result);
            },

            XApiMessage::SendStatements { statements, reply_to } => {
                let result = self.send_statements(statements);
                reply_to.send(result);
            },

            XApiMessage::GetStatement { statement_id, reply_to } => {
                let result = self.get_statement(&statement_id);
                reply_to.send(result);
            },

            XApiMessage::QueryStatements { query, reply_to } => {
                let result = self.query_statements(query);
                reply_to.send(result);
            },

            XApiMessage::VoidStatement { statement_id, actor, reply_to } => {
                let result = self.void_statement(&statement_id, actor);
                reply_to.send(result);
            },

            XApiMessage::GetState { activity_id, agent, state_id, registration, reply_to } => {
                let result = self.get_state(&activity_id, &agent, &state_id, registration.as_deref());
                reply_to.send(result);
            },

            XApiMessage::SetState { activity_id, agent, state_id, registration, state, reply_to } => {
                let result = self.set_state(&activity_id, &agent, &state_id, registration.as_deref(), state);
                reply_to.send(result);
            },

            XApiMessage::DeleteState { activity_id, agent, state_id, registration, reply_to } => {
                let result = self.delete_state(&activity_id, &agent, &state_id, registration.as_deref());
                reply_to.send(result);
            }
        }
    }

    /// Send a statement to LRS
    fn send_statement(&self, statement: Statement) -> Result<StatementId, XApiError> {
        let url = format!("{}/statements", self.config.endpoint);

        let request = HttpRequest::new(HttpMethod::POST, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version)
            .header("Content-Type", "application/json")
            .body(statement.to_json().to_string());

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        self.handle_response(response)?;

        // Parse statement ID from response
        let body = response.body();
        let json: JsonValue = Json::parse(&body)
            .map_err(|e| XApiError::ParseError { message: e.to_string() })?;

        json.as_array()
            .and_then(|arr| arr.first())
            .and_then(|v| v.as_string())
            .map(|s| s.to_string())
            .ok_or(XApiError::ParseError { message: "No statement ID in response".to_string() })
    }

    /// Send multiple statements
    fn send_statements(&self, statements: List<Statement>) -> Result<List<StatementId>, XApiError> {
        let url = format!("{}/statements", self.config.endpoint);

        let statements_json: Vec<JsonValue> = statements.iter().map(|s| s.to_json()).collect();
        let body = JsonValue::Array(statements_json).to_string();

        let request = HttpRequest::new(HttpMethod::POST, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version)
            .header("Content-Type", "application/json")
            .body(body);

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        self.handle_response(response)?;

        let body = response.body();
        let json: JsonValue = Json::parse(&body)
            .map_err(|e| XApiError::ParseError { message: e.to_string() })?;

        json.as_array()
            .map(|arr| arr.iter().filter_map(|v| v.as_string().map(|s| s.to_string())).collect())
            .ok_or(XApiError::ParseError { message: "Invalid response format".to_string() })
    }

    /// Get a statement by ID
    fn get_statement(&self, statement_id: &StatementId) -> Result<Statement, XApiError> {
        let url = format!("{}/statements?statementId={}", self.config.endpoint, statement_id);

        let request = HttpRequest::new(HttpMethod::GET, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version);

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        self.handle_response(response)?;

        let body = response.body();
        let json: JsonValue = Json::parse(&body)
            .map_err(|e| XApiError::ParseError { message: e.to_string() })?;

        Statement::from_json(&json)
            .ok_or(XApiError::ParseError { message: "Invalid statement format".to_string() })
    }

    /// Query statements
    fn query_statements(&self, query: StatementQuery) -> Result<StatementResult, XApiError> {
        let query_string = query.to_query_string();
        let url = if query_string.is_empty() {
            format!("{}/statements", self.config.endpoint)
        } else {
            format!("{}/statements?{}", self.config.endpoint, query_string)
        };

        let request = HttpRequest::new(HttpMethod::GET, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version);

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        self.handle_response(response)?;

        let body = response.body();
        let json: JsonValue = Json::parse(&body)
            .map_err(|e| XApiError::ParseError { message: e.to_string() })?;

        let obj = json.as_object()
            .ok_or(XApiError::ParseError { message: "Invalid response format".to_string() })?;

        let statements = obj.get("statements")
            .and_then(|v| v.as_array())
            .map(|arr| arr.iter().filter_map(|s| Statement::from_json(s)).collect())
            .unwrap_or_default();

        let more = obj.get("more")
            .and_then(|v| v.as_string())
            .map(|s| s.to_string());

        Ok(StatementResult { statements, more })
    }

    /// Void a statement
    fn void_statement(&self, statement_id: &StatementId, actor: Actor) -> Result<StatementId, XApiError> {
        let voiding_statement = Statement::new(
            actor,
            Verbs::voided(),
            Object::StatementRef(StatementRef::new(statement_id.clone()))
        );

        self.send_statement(voiding_statement)
    }

    /// Get state document
    fn get_state(&self, activity_id: &IRI, agent: &Agent, state_id: &str, registration: Option<&str>) -> Result<JsonValue, XApiError> {
        let mut url = format!(
            "{}/activities/state?activityId={}&agent={}&stateId={}",
            self.config.endpoint,
            url_encode(activity_id),
            url_encode(&agent.to_json().to_string()),
            url_encode(state_id)
        );

        if let Some(reg) = registration {
            url.push_str(&format!("&registration={}", reg));
        }

        let request = HttpRequest::new(HttpMethod::GET, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version);

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        if response.status() == 404 {
            return Err(XApiError::NotFound { resource: format!("State: {}", state_id) })
        }

        self.handle_response(response)?;

        let body = response.body();
        Json::parse(&body)
            .map_err(|e| XApiError::ParseError { message: e.to_string() })
    }

    /// Set state document
    fn set_state(&self, activity_id: &IRI, agent: &Agent, state_id: &str, registration: Option<&str>, state: JsonValue) -> Result<(), XApiError> {
        let mut url = format!(
            "{}/activities/state?activityId={}&agent={}&stateId={}",
            self.config.endpoint,
            url_encode(activity_id),
            url_encode(&agent.to_json().to_string()),
            url_encode(state_id)
        );

        if let Some(reg) = registration {
            url.push_str(&format!("&registration={}", reg));
        }

        let request = HttpRequest::new(HttpMethod::PUT, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version)
            .header("Content-Type", "application/json")
            .body(state.to_string());

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        self.handle_response(response)?;

        Ok(())
    }

    /// Delete state document
    fn delete_state(&self, activity_id: &IRI, agent: &Agent, state_id: &str, registration: Option<&str>) -> Result<(), XApiError> {
        let mut url = format!(
            "{}/activities/state?activityId={}&agent={}&stateId={}",
            self.config.endpoint,
            url_encode(activity_id),
            url_encode(&agent.to_json().to_string()),
            url_encode(state_id)
        );

        if let Some(reg) = registration {
            url.push_str(&format!("&registration={}", reg));
        }

        let request = HttpRequest::new(HttpMethod::DELETE, &url)
            .header("Authorization", &self.config.authorization)
            .header("X-Experience-API-Version", &self.config.version);

        let response = self.http_client.send(request)
            .map_err(|e| XApiError::NetworkError { message: e.to_string() })?;

        self.handle_response(response)?;

        Ok(())
    }

    /// Handle HTTP response and check for errors
    fn handle_response(&self, response: HttpResponse) -> Result<(), XApiError> {
        match response.status() {
            200..=299 => Ok(()),
            400 => Err(XApiError::BadRequest { message: response.body() }),
            401 | 403 => Err(XApiError::AuthError { message: "Authentication failed".to_string() }),
            404 => Err(XApiError::NotFound { resource: "Resource".to_string() }),
            409 => Err(XApiError::Conflict { message: response.body() }),
            _ => Err(XApiError::ServerError { message: format!("HTTP {}: {}", response.status(), response.body()) })
        }
    }
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

/// Generate UUID
fn generate_uuid() -> String {
    std::uuid::v4()
}

/// Parse a language map from JSON
fn parse_language_map(json: &JsonValue) -> Option<LanguageMap> {
    json.as_object().map(|obj| {
        obj.iter()
            .filter_map(|(k, v)| v.as_string().map(|s| (k.clone(), s.to_string())))
            .collect()
    })
}

/// Convert a language map to JSON
fn language_map_to_json(map: &LanguageMap) -> JsonValue {
    let mut obj = JsonObject::new();
    for (lang, text) in map {
        obj.insert(lang.clone(), JsonValue::String(text.clone()));
    }
    JsonValue::Object(obj)
}

/// Parse interaction components (choices, scale, source, target, steps)
fn parse_interaction_components(json: &JsonValue) -> Option<List<InteractionComponent>> {
    json.as_array().map(|arr| {
        arr.iter()
            .filter_map(|item| InteractionComponent::from_json(item))
            .collect()
    })
}

/// Base64 encode
fn base64_encode(input: &str) -> String {
    std::encoding::base64_encode(input)
}

/// URL encode
fn url_encode(input: &str) -> String {
    std::encoding::url_encode(input)
}

/// Format ISO 8601 duration
fn format_iso8601_duration(duration: Duration) -> String {
    let total_secs = duration.as_secs();
    let hours = total_secs / 3600;
    let minutes = (total_secs % 3600) / 60;
    let seconds = total_secs % 60;

    format!("PT{}H{}M{}S", hours, minutes, seconds)
}

/// Create xAPI client
fn create_xapi_client(config: LrsConfig) -> XApiClient {
    XApiClient::init(config)
}

// =============================================================================
// STATEMENT BUILDERS
// =============================================================================

/// Helper to build common learning statements
type StatementBuilder;

impl StatementBuilder {
    /// Build "completed course" statement
    fn completed_course(actor: Actor, course_id: &str, course_name: &str) -> Statement {
        let activity = Activity::with_definition(
            course_id.to_string(),
            ActivityDefinition::new()
                .with_name("en-US", course_name)
                .with_type(ActivityTypes::course())
        );

        Statement::new(actor, Verbs::completed(), Object::Activity(activity))
            .with_result(Result::new().with_completion(true))
    }

    /// Build "passed assessment" statement
    fn passed_assessment(actor: Actor, assessment_id: &str, assessment_name: &str, score: Score) -> Statement {
        let activity = Activity::with_definition(
            assessment_id.to_string(),
            ActivityDefinition::new()
                .with_name("en-US", assessment_name)
                .with_type(ActivityTypes::assessment())
        );

        Statement::new(actor, Verbs::passed(), Object::Activity(activity))
            .with_result(Result::new().with_score(score).with_success(true).with_completion(true))
    }

    /// Build "failed assessment" statement
    fn failed_assessment(actor: Actor, assessment_id: &str, assessment_name: &str, score: Score) -> Statement {
        let activity = Activity::with_definition(
            assessment_id.to_string(),
            ActivityDefinition::new()
                .with_name("en-US", assessment_name)
                .with_type(ActivityTypes::assessment())
        );

        Statement::new(actor, Verbs::failed(), Object::Activity(activity))
            .with_result(Result::new().with_score(score).with_success(false).with_completion(true))
    }

    /// Build "launched lesson" statement
    fn launched_lesson(actor: Actor, lesson_id: &str, lesson_name: &str) -> Statement {
        let activity = Activity::with_definition(
            lesson_id.to_string(),
            ActivityDefinition::new()
                .with_name("en-US", lesson_name)
                .with_type(ActivityTypes::lesson())
        );

        Statement::new(actor, Verbs::launched(), Object::Activity(activity))
    }

    /// Build "progressed in lesson" statement
    fn progressed_lesson(actor: Actor, lesson_id: &str, progress: f32) -> Statement {
        let activity = Activity::new(lesson_id.to_string());

        let mut extensions = Map::new();
        extensions.insert(
            "https://w3id.org/xapi/cmi5/result/extensions/progress".to_string(),
            JsonValue::Number(progress as f64)
        );

        Statement::new(actor, Verbs::progressed(), Object::Activity(activity))
            .with_result(Result {
                score: None,
                success: None,
                completion: Some(progress >= 1.0),
                response: None,
                duration: None,
                extensions: Some(extensions)
            })
    }

    /// Build "watched video" statement
    fn watched_video(actor: Actor, video_id: &str, video_name: &str, duration: Duration, progress: f32) -> Statement {
        let activity = Activity::with_definition(
            video_id.to_string(),
            ActivityDefinition::new()
                .with_name("en-US", video_name)
                .with_type(ActivityTypes::video())
        );

        Statement::new(actor, Verbs::watched(), Object::Activity(activity))
            .with_result(Result::new()
                .with_duration(duration)
                .with_completion(progress >= 0.95)
            )
    }

    /// Build "answered question" statement
    fn answered_question(
        actor: Actor,
        question_id: &str,
        question_text: &str,
        response: &str,
        correct: Bool
    ) -> Statement {
        let activity = Activity::with_definition(
            question_id.to_string(),
            ActivityDefinition::new()
                .with_name("en-US", question_text)
                .with_type(ActivityTypes::question())
        );

        Statement::new(actor, Verbs::answered(), Object::Activity(activity))
            .with_result(Result::new()
                .with_response(response.to_string())
                .with_success(correct)
            )
    }
}

// =============================================================================
// FLUENT STATEMENT BUILDER
// =============================================================================

/// Fluent API builder for constructing xAPI statements
type FluentStatementBuilder {
    /// The statement being built
    statement: Statement,

    /// Validation errors accumulated
    errors: List<String>
}

impl FluentStatementBuilder {
    /// Start building a statement with an actor
    fn actor(actor: Actor) -> FluentStatementBuilder {
        let statement = Statement {
            id: Some(generate_uuid()),
            actor,
            verb: Verb::new(String::new(), None),
            object: Object::Activity(Activity::new(String::new())),
            result: None,
            context: None,
            timestamp: Some(DateTime::now().to_iso8601()),
            stored: None,
            authority: None,
            version: Some("1.0.3".to_string()),
            attachments: None
        };

        FluentStatementBuilder {
            statement,
            errors: vec![]
        }
    }

    /// Create builder from email
    fn from_email(email: &str, name: Option<String>) -> FluentStatementBuilder {
        Self::actor(Actor::Agent(Agent::from_email(email, name)))
    }

    /// Create builder from account
    fn from_account(home_page: &str, account_name: &str, name: Option<String>) -> FluentStatementBuilder {
        Self::actor(Actor::Agent(Agent::from_account(home_page, account_name, name)))
    }

    /// Create builder from Intelligo user
    fn from_user(user_id: &UserId, tenant_id: &TenantId, name: Option<String>) -> FluentStatementBuilder {
        let home_page = format!("https://intelligo.ai/tenants/{}", tenant_id);
        Self::from_account(&home_page, user_id, name)
    }

    // =========================================================================
    // VERB METHODS
    // =========================================================================

    /// Set the verb
    fn verb(mut self, verb: Verb) -> FluentStatementBuilder {
        self.statement.verb = verb;
        self
    }

    /// Set verb to completed
    fn completed(self) -> FluentStatementBuilder {
        self.verb(Verbs::completed())
    }

    /// Set verb to passed
    fn passed(self) -> FluentStatementBuilder {
        self.verb(Verbs::passed())
    }

    /// Set verb to failed
    fn failed(self) -> FluentStatementBuilder {
        self.verb(Verbs::failed())
    }

    /// Set verb to attempted
    fn attempted(self) -> FluentStatementBuilder {
        self.verb(Verbs::attempted())
    }

    /// Set verb to experienced
    fn experienced(self) -> FluentStatementBuilder {
        self.verb(Verbs::experienced())
    }

    /// Set verb to launched
    fn launched(self) -> FluentStatementBuilder {
        self.verb(Verbs::launched())
    }

    /// Set verb to initialized
    fn initialized(self) -> FluentStatementBuilder {
        self.verb(Verbs::initialized())
    }

    /// Set verb to terminated
    fn terminated(self) -> FluentStatementBuilder {
        self.verb(Verbs::terminated())
    }

    /// Set verb to progressed
    fn progressed(self) -> FluentStatementBuilder {
        self.verb(Verbs::progressed())
    }

    /// Set verb to suspended
    fn suspended(self) -> FluentStatementBuilder {
        self.verb(Verbs::suspended())
    }

    /// Set verb to resumed
    fn resumed(self) -> FluentStatementBuilder {
        self.verb(Verbs::resumed())
    }

    /// Set verb to answered
    fn answered(self) -> FluentStatementBuilder {
        self.verb(Verbs::answered())
    }

    /// Set verb to voided
    fn voided(self) -> FluentStatementBuilder {
        self.verb(Verbs::voided())
    }

    /// Set verb to scored
    fn scored(self) -> FluentStatementBuilder {
        self.verb(Verbs::scored())
    }

    /// Set verb to mastered
    fn mastered(self) -> FluentStatementBuilder {
        self.verb(Verbs::mastered())
    }

    // =========================================================================
    // OBJECT METHODS
    // =========================================================================

    /// Set the object to an activity
    fn activity(mut self, id: IRI, definition: Option<ActivityDefinition>) -> FluentStatementBuilder {
        let activity = match definition {
            Some(def) => Activity::with_definition(id, def),
            None => Activity::new(id)
        };
        self.statement.object = Object::Activity(activity);
        self
    }

    /// Set the object to a course
    fn course(self, id: IRI, name: &str) -> FluentStatementBuilder {
        let def = ActivityDefinition::new()
            .with_name("en-US", name)
            .with_type(ActivityTypes::course());
        self.activity(id, Some(def))
    }

    /// Set the object to a lesson
    fn lesson(self, id: IRI, name: &str) -> FluentStatementBuilder {
        let def = ActivityDefinition::new()
            .with_name("en-US", name)
            .with_type(ActivityTypes::lesson());
        self.activity(id, Some(def))
    }

    /// Set the object to an assessment
    fn assessment(self, id: IRI, name: &str) -> FluentStatementBuilder {
        let def = ActivityDefinition::new()
            .with_name("en-US", name)
            .with_type(ActivityTypes::assessment());
        self.activity(id, Some(def))
    }

    /// Set the object to a module
    fn module(self, id: IRI, name: &str) -> FluentStatementBuilder {
        let def = ActivityDefinition::new()
            .with_name("en-US", name)
            .with_type(ActivityTypes::module());
        self.activity(id, Some(def))
    }

    /// Set the object to a question
    fn question(self, id: IRI, text: &str, interaction_type: Option<InteractionType>) -> FluentStatementBuilder {
        let mut def = ActivityDefinition::new()
            .with_name("en-US", text)
            .with_type(ActivityTypes::question());
        def.interaction_type = interaction_type;
        self.activity(id, Some(def))
    }

    /// Set the object to a video
    fn video(self, id: IRI, name: &str) -> FluentStatementBuilder {
        let def = ActivityDefinition::new()
            .with_name("en-US", name)
            .with_type(ActivityTypes::video());
        self.activity(id, Some(def))
    }

    /// Set the object to a statement reference (for voiding)
    fn statement_ref(mut self, statement_id: StatementId) -> FluentStatementBuilder {
        self.statement.object = Object::StatementRef(StatementRef::new(statement_id));
        self
    }

    // =========================================================================
    // RESULT METHODS
    // =========================================================================

    /// Set the result
    fn result(mut self, result: Result) -> FluentStatementBuilder {
        self.statement.result = Some(result);
        self
    }

    /// Set score with scaled value (must be -1 to 1)
    fn score_scaled(mut self, scaled: f32) -> FluentStatementBuilder {
        if scaled < -1.0 || scaled > 1.0 {
            self.errors.push("Scaled score must be between -1 and 1".to_string());
        }
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        let mut score = result.score.unwrap_or_else(Score::new);
        score.scaled = Some(scaled);
        result.score = Some(score);
        self.statement.result = Some(result);
        self
    }

    /// Set score with raw value
    fn score_raw(mut self, raw: f32, min: f32, max: f32) -> FluentStatementBuilder {
        if min > max {
            self.errors.push("Score min cannot be greater than max".to_string());
        }
        if raw < min || raw > max {
            self.errors.push("Raw score must be between min and max".to_string());
        }
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        let score = Score::from_raw(raw, min, max);
        result.score = Some(score);
        self.statement.result = Some(result);
        self
    }

    /// Set score from percentage
    fn score_percentage(mut self, percent: f32) -> FluentStatementBuilder {
        if percent < 0.0 || percent > 100.0 {
            self.errors.push("Percentage must be between 0 and 100".to_string());
        }
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        result.score = Some(Score::from_percentage(percent));
        self.statement.result = Some(result);
        self
    }

    /// Set success status
    fn success(mut self, success: Bool) -> FluentStatementBuilder {
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        result.success = Some(success);
        self.statement.result = Some(result);
        self
    }

    /// Mark as successful
    fn succeeded(self) -> FluentStatementBuilder {
        self.success(true)
    }

    /// Mark as not successful
    fn not_succeeded(self) -> FluentStatementBuilder {
        self.success(false)
    }

    /// Set completion status
    fn completion(mut self, completion: Bool) -> FluentStatementBuilder {
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        result.completion = Some(completion);
        self.statement.result = Some(result);
        self
    }

    /// Mark as complete
    fn complete(self) -> FluentStatementBuilder {
        self.completion(true)
    }

    /// Mark as incomplete
    fn incomplete(self) -> FluentStatementBuilder {
        self.completion(false)
    }

    /// Set the response
    fn response(mut self, response: String) -> FluentStatementBuilder {
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        result.response = Some(response);
        self.statement.result = Some(result);
        self
    }

    /// Set the duration
    fn duration(mut self, duration: Duration) -> FluentStatementBuilder {
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        result.duration = Some(format_iso8601_duration(duration));
        self.statement.result = Some(result);
        self
    }

    /// Set duration in seconds
    fn duration_secs(self, seconds: i64) -> FluentStatementBuilder {
        self.duration(Duration::from_secs(seconds as u64))
    }

    /// Add a result extension
    fn result_extension(mut self, iri: IRI, value: JsonValue) -> FluentStatementBuilder {
        let mut result = self.statement.result.unwrap_or_else(Result::new);
        let mut extensions = result.extensions.unwrap_or_else(Map::new);
        extensions.insert(iri, value);
        result.extensions = Some(extensions);
        self.statement.result = Some(result);
        self
    }

    // =========================================================================
    // CONTEXT METHODS
    // =========================================================================

    /// Set the context
    fn context(mut self, context: Context) -> FluentStatementBuilder {
        self.statement.context = Some(context);
        self
    }

    /// Set the registration UUID
    fn registration(mut self, registration: String) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        context.registration = Some(registration);
        self.statement.context = Some(context);
        self
    }

    /// Set the instructor
    fn instructor(mut self, instructor: Actor) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        context.instructor = Some(instructor);
        self.statement.context = Some(context);
        self
    }

    /// Set the team
    fn team(mut self, team: Group) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        context.team = Some(team);
        self.statement.context = Some(context);
        self
    }

    /// Set the platform
    fn platform(mut self, platform: String) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        context.platform = Some(platform);
        self.statement.context = Some(context);
        self
    }

    /// Set the language
    fn language(mut self, language: String) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        context.language = Some(language);
        self.statement.context = Some(context);
        self
    }

    /// Set the revision
    fn revision(mut self, revision: String) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        context.revision = Some(revision);
        self.statement.context = Some(context);
        self
    }

    /// Add a parent activity
    fn parent(mut self, activity: Activity) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        let mut ctx_activities = context.context_activities.unwrap_or_else(ContextActivities::new);
        ctx_activities = ctx_activities.with_parent(activity);
        context.context_activities = Some(ctx_activities);
        self.statement.context = Some(context);
        self
    }

    /// Add a parent activity by ID
    fn parent_id(self, activity_id: IRI) -> FluentStatementBuilder {
        self.parent(Activity::new(activity_id))
    }

    /// Add a grouping activity
    fn grouping(mut self, activity: Activity) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        let mut ctx_activities = context.context_activities.unwrap_or_else(ContextActivities::new);
        ctx_activities = ctx_activities.with_grouping(activity);
        context.context_activities = Some(ctx_activities);
        self.statement.context = Some(context);
        self
    }

    /// Add a grouping activity by ID
    fn grouping_id(self, activity_id: IRI) -> FluentStatementBuilder {
        self.grouping(Activity::new(activity_id))
    }

    /// Add a category activity
    fn category(mut self, activity: Activity) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        let mut ctx_activities = context.context_activities.unwrap_or_else(ContextActivities::new);
        let mut categories = ctx_activities.category.unwrap_or_default();
        categories.push(activity);
        ctx_activities.category = Some(categories);
        context.context_activities = Some(ctx_activities);
        self.statement.context = Some(context);
        self
    }

    /// Add a category activity by ID (for xAPI profiles)
    fn category_id(self, activity_id: IRI) -> FluentStatementBuilder {
        self.category(Activity::new(activity_id))
    }

    /// Add an other activity
    fn other(mut self, activity: Activity) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        let mut ctx_activities = context.context_activities.unwrap_or_else(ContextActivities::new);
        let mut others = ctx_activities.other.unwrap_or_default();
        others.push(activity);
        ctx_activities.other = Some(others);
        context.context_activities = Some(ctx_activities);
        self.statement.context = Some(context);
        self
    }

    /// Add a context extension
    fn context_extension(mut self, iri: IRI, value: JsonValue) -> FluentStatementBuilder {
        let mut context = self.statement.context.unwrap_or_else(Context::new);
        let mut extensions = context.extensions.unwrap_or_else(Map::new);
        extensions.insert(iri, value);
        context.extensions = Some(extensions);
        self.statement.context = Some(context);
        self
    }

    // =========================================================================
    // METADATA METHODS
    // =========================================================================

    /// Set the statement ID
    fn id(mut self, id: StatementId) -> FluentStatementBuilder {
        self.statement.id = Some(id);
        self
    }

    /// Set the timestamp
    fn timestamp(mut self, timestamp: DateTime) -> FluentStatementBuilder {
        self.statement.timestamp = Some(timestamp.to_iso8601());
        self
    }

    /// Set the authority
    fn authority(mut self, authority: Actor) -> FluentStatementBuilder {
        self.statement.authority = Some(authority);
        self
    }

    /// Add an attachment
    fn attachment(mut self, attachment: Attachment) -> FluentStatementBuilder {
        let mut attachments = self.statement.attachments.unwrap_or_default();
        attachments.push(attachment);
        self.statement.attachments = Some(attachments);
        self
    }

    // =========================================================================
    // BUILD METHODS
    // =========================================================================

    /// Validate the statement
    fn validate(&self) -> List<String> {
        let mut errors = self.errors.clone();

        // Validate verb ID is set
        if self.statement.verb.id.is_empty() {
            errors.push("Verb ID is required".to_string());
        }

        // Validate object ID is set
        match &self.statement.object {
            Object::Activity(activity) if activity.id.is_empty() => {
                errors.push("Activity ID is required".to_string());
            },
            Object::StatementRef(stmt_ref) if stmt_ref.id.is_empty() => {
                errors.push("Statement reference ID is required".to_string());
            },
            _ => {}
        }

        // Validate voiding statement has StatementRef object
        if self.statement.verb.id == "http://adlnet.gov/expapi/verbs/voided" {
            if !matches!(self.statement.object, Object::StatementRef(_)) {
                errors.push("Voiding statement must have StatementRef object".to_string());
            }
        }

        // Validate score if present
        if let Some(ref result) = self.statement.result {
            if let Some(ref score) = result.score {
                if let Some(scaled) = score.scaled {
                    if scaled < -1.0 || scaled > 1.0 {
                        errors.push("Scaled score must be between -1 and 1".to_string());
                    }
                }
                if let (Some(min), Some(max)) = (score.min, score.max) {
                    if min > max {
                        errors.push("Score min cannot be greater than max".to_string());
                    }
                }
                if let (Some(raw), Some(min)) = (score.raw, score.min) {
                    if raw < min {
                        errors.push("Raw score cannot be less than min".to_string());
                    }
                }
                if let (Some(raw), Some(max)) = (score.raw, score.max) {
                    if raw > max {
                        errors.push("Raw score cannot be greater than max".to_string());
                    }
                }
            }
        }

        errors
    }

    /// Build the statement (returns errors if invalid)
    fn build(self) -> Result<Statement, List<String>> {
        let errors = self.validate();
        if errors.is_empty() {
            Ok(self.statement)
        } else {
            Err(errors)
        }
    }

    /// Build the statement without validation
    fn build_unchecked(self) -> Statement {
        self.statement
    }
}

// =============================================================================
// BATCH STATEMENT GENERATOR
// =============================================================================

/// Generator for creating multiple xAPI statements efficiently
type BatchStatementGenerator {
    /// Template settings
    template: StatementTemplate,

    /// Generated statements
    statements: List<Statement>,

    /// Tenant ID for IRI generation
    tenant_id: TenantId,

    /// Base IRI for activities
    base_iri: IRI
}

/// Template for batch statement generation
type StatementTemplate {
    /// Default actor
    default_actor: Option<Actor>,

    /// Default context
    default_context: Option<Context>,

    /// Default authority
    default_authority: Option<Actor>,

    /// Default platform
    default_platform: Option<String>,

    /// Default language
    default_language: Option<String>,

    /// Include cmi5 profile category
    use_cmi5_profile: Bool
}

impl StatementTemplate {
    fn new() -> StatementTemplate {
        StatementTemplate {
            default_actor: None,
            default_context: None,
            default_authority: None,
            default_platform: Some("Intelligo LMS".to_string()),
            default_language: Some("en-US".to_string()),
            use_cmi5_profile: false
        }
    }
}

impl BatchStatementGenerator {
    /// Create a new batch generator
    fn new(tenant_id: TenantId) -> BatchStatementGenerator {
        BatchStatementGenerator {
            template: StatementTemplate::new(),
            statements: vec![],
            tenant_id: tenant_id.clone(),
            base_iri: format!("https://intelligo.ai/tenants/{}/xapi", tenant_id)
        }
    }

    /// Create with template
    fn with_template(tenant_id: TenantId, template: StatementTemplate) -> BatchStatementGenerator {
        BatchStatementGenerator {
            template,
            statements: vec![],
            tenant_id: tenant_id.clone(),
            base_iri: format!("https://intelligo.ai/tenants/{}/xapi", tenant_id)
        }
    }

    /// Set the base IRI
    fn set_base_iri(&mut self, base_iri: IRI) {
        self.base_iri = base_iri;
    }

    /// Generate activity IRI
    fn make_activity_iri(&self, activity_type: &str, id: &str) -> IRI {
        format!("{}/activities/{}/{}", self.base_iri, activity_type, id)
    }

    /// Generate course IRI
    fn make_course_iri(&self, course_id: &CourseId) -> IRI {
        self.make_activity_iri("course", course_id)
    }

    /// Generate lesson IRI
    fn make_lesson_iri(&self, lesson_id: &LessonId) -> IRI {
        self.make_activity_iri("lesson", lesson_id)
    }

    /// Generate assessment IRI
    fn make_assessment_iri(&self, assessment_id: &AssessmentId) -> IRI {
        self.make_activity_iri("assessment", assessment_id)
    }

    /// Generate module IRI
    fn make_module_iri(&self, module_id: &ModuleId) -> IRI {
        self.make_activity_iri("module", module_id)
    }

    /// Apply template settings to a statement
    fn apply_template(&self, statement: &mut Statement) {
        // Apply default context settings
        if self.template.default_context.is_some() || self.template.default_platform.is_some() {
            let mut context = statement.context.take().unwrap_or_else(Context::new);

            if let Some(ref default_ctx) = self.template.default_context {
                if context.registration.is_none() {
                    context.registration = default_ctx.registration.clone();
                }
                if context.instructor.is_none() {
                    context.instructor = default_ctx.instructor.clone();
                }
            }

            if context.platform.is_none() {
                context.platform = self.template.default_platform.clone();
            }

            if context.language.is_none() {
                context.language = self.template.default_language.clone();
            }

            // Add cmi5 profile category if enabled
            if self.template.use_cmi5_profile {
                let mut ctx_activities = context.context_activities.take().unwrap_or_else(ContextActivities::new);
                let mut categories = ctx_activities.category.unwrap_or_default();
                categories.push(Activity::new("https://w3id.org/xapi/cmi5/context/categories/cmi5".to_string()));
                ctx_activities.category = Some(categories);
                context.context_activities = Some(ctx_activities);
            }

            statement.context = Some(context);
        }

        // Apply default authority
        if statement.authority.is_none() {
            statement.authority = self.template.default_authority.clone();
        }
    }

    /// Add a course completed statement
    fn add_course_completed(
        &mut self,
        actor: Actor,
        course_id: &CourseId,
        course_name: &str,
        score: Option<Score>,
        duration: Option<Duration>
    ) {
        let activity_iri = self.make_course_iri(course_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", course_name)
                .with_type(ActivityTypes::course())
        );

        let mut result = Result::new().with_completion(true);
        if let Some(s) = score {
            result.score = Some(s);
        }
        if let Some(d) = duration {
            result.duration = Some(format_iso8601_duration(d));
        }

        let mut statement = Statement::new(actor, Verbs::completed(), Object::Activity(activity))
            .with_result(result);

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add an assessment passed statement
    fn add_assessment_passed(
        &mut self,
        actor: Actor,
        assessment_id: &AssessmentId,
        assessment_name: &str,
        score: Score,
        duration: Option<Duration>,
        parent_course: Option<&CourseId>
    ) {
        let activity_iri = self.make_assessment_iri(assessment_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", assessment_name)
                .with_type(ActivityTypes::assessment())
        );

        let mut result = Result::new()
            .with_score(score)
            .with_success(true)
            .with_completion(true);

        if let Some(d) = duration {
            result.duration = Some(format_iso8601_duration(d));
        }

        let mut statement = Statement::new(actor, Verbs::passed(), Object::Activity(activity))
            .with_result(result);

        // Add parent course context
        if let Some(course_id) = parent_course {
            let parent = Activity::new(self.make_course_iri(course_id));
            let ctx_activities = ContextActivities::new().with_parent(parent);
            statement = statement.with_context(Context::new().with_context_activities(ctx_activities));
        }

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add an assessment failed statement
    fn add_assessment_failed(
        &mut self,
        actor: Actor,
        assessment_id: &AssessmentId,
        assessment_name: &str,
        score: Score,
        duration: Option<Duration>,
        parent_course: Option<&CourseId>
    ) {
        let activity_iri = self.make_assessment_iri(assessment_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", assessment_name)
                .with_type(ActivityTypes::assessment())
        );

        let mut result = Result::new()
            .with_score(score)
            .with_success(false)
            .with_completion(true);

        if let Some(d) = duration {
            result.duration = Some(format_iso8601_duration(d));
        }

        let mut statement = Statement::new(actor, Verbs::failed(), Object::Activity(activity))
            .with_result(result);

        if let Some(course_id) = parent_course {
            let parent = Activity::new(self.make_course_iri(course_id));
            let ctx_activities = ContextActivities::new().with_parent(parent);
            statement = statement.with_context(Context::new().with_context_activities(ctx_activities));
        }

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add a lesson launched statement
    fn add_lesson_launched(
        &mut self,
        actor: Actor,
        lesson_id: &LessonId,
        lesson_name: &str,
        parent_module: Option<&ModuleId>,
        parent_course: Option<&CourseId>
    ) {
        let activity_iri = self.make_lesson_iri(lesson_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", lesson_name)
                .with_type(ActivityTypes::lesson())
        );

        let mut statement = Statement::new(actor, Verbs::launched(), Object::Activity(activity));

        // Add context activities
        let mut ctx_activities = ContextActivities::new();
        if let Some(module_id) = parent_module {
            ctx_activities = ctx_activities.with_parent(Activity::new(self.make_module_iri(module_id)));
        }
        if let Some(course_id) = parent_course {
            ctx_activities = ctx_activities.with_grouping(Activity::new(self.make_course_iri(course_id)));
        }

        if parent_module.is_some() || parent_course.is_some() {
            statement = statement.with_context(Context::new().with_context_activities(ctx_activities));
        }

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add a lesson completed statement
    fn add_lesson_completed(
        &mut self,
        actor: Actor,
        lesson_id: &LessonId,
        lesson_name: &str,
        duration: Option<Duration>,
        parent_module: Option<&ModuleId>,
        parent_course: Option<&CourseId>
    ) {
        let activity_iri = self.make_lesson_iri(lesson_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", lesson_name)
                .with_type(ActivityTypes::lesson())
        );

        let mut result = Result::new().with_completion(true);
        if let Some(d) = duration {
            result.duration = Some(format_iso8601_duration(d));
        }

        let mut statement = Statement::new(actor, Verbs::completed(), Object::Activity(activity))
            .with_result(result);

        let mut ctx_activities = ContextActivities::new();
        if let Some(module_id) = parent_module {
            ctx_activities = ctx_activities.with_parent(Activity::new(self.make_module_iri(module_id)));
        }
        if let Some(course_id) = parent_course {
            ctx_activities = ctx_activities.with_grouping(Activity::new(self.make_course_iri(course_id)));
        }

        if parent_module.is_some() || parent_course.is_some() {
            statement = statement.with_context(Context::new().with_context_activities(ctx_activities));
        }

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add a progress statement
    fn add_progress(
        &mut self,
        actor: Actor,
        activity_id: IRI,
        activity_name: &str,
        activity_type: IRI,
        progress_percent: f32
    ) {
        let activity = Activity::with_definition(
            activity_id,
            ActivityDefinition::new()
                .with_name("en-US", activity_name)
                .with_type(activity_type)
        );

        let mut extensions = Map::new();
        extensions.insert(
            "https://w3id.org/xapi/cmi5/result/extensions/progress".to_string(),
            JsonValue::Number(progress_percent as f64)
        );

        let result = Result {
            score: None,
            success: None,
            completion: Some(progress_percent >= 1.0),
            response: None,
            duration: None,
            extensions: Some(extensions)
        };

        let mut statement = Statement::new(actor, Verbs::progressed(), Object::Activity(activity))
            .with_result(result);

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add a question answered statement
    fn add_question_answered(
        &mut self,
        actor: Actor,
        question_id: &str,
        question_text: &str,
        response: &str,
        correct: Bool,
        parent_assessment: Option<&AssessmentId>
    ) {
        let activity_iri = self.make_activity_iri("question", question_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", question_text)
                .with_type(ActivityTypes::question())
        );

        let result = Result::new()
            .with_response(response.to_string())
            .with_success(correct);

        let mut statement = Statement::new(actor, Verbs::answered(), Object::Activity(activity))
            .with_result(result);

        if let Some(assessment_id) = parent_assessment {
            let parent = Activity::new(self.make_assessment_iri(assessment_id));
            let ctx_activities = ContextActivities::new().with_parent(parent);
            statement = statement.with_context(Context::new().with_context_activities(ctx_activities));
        }

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add a video watched statement
    fn add_video_watched(
        &mut self,
        actor: Actor,
        video_id: &str,
        video_name: &str,
        duration: Duration,
        progress: f32,
        parent_lesson: Option<&LessonId>
    ) {
        let activity_iri = self.make_activity_iri("video", video_id);
        let activity = Activity::with_definition(
            activity_iri,
            ActivityDefinition::new()
                .with_name("en-US", video_name)
                .with_type(ActivityTypes::video())
        );

        let result = Result::new()
            .with_duration(duration)
            .with_completion(progress >= 0.95);

        let mut statement = Statement::new(actor, Verbs::watched(), Object::Activity(activity))
            .with_result(result);

        if let Some(lesson_id) = parent_lesson {
            let parent = Activity::new(self.make_lesson_iri(lesson_id));
            let ctx_activities = ContextActivities::new().with_parent(parent);
            statement = statement.with_context(Context::new().with_context_activities(ctx_activities));
        }

        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Add a custom statement
    fn add_statement(&mut self, mut statement: Statement) {
        self.apply_template(&mut statement);
        self.statements.push(statement);
    }

    /// Get all generated statements
    fn get_statements(&self) -> &List<Statement> {
        &self.statements
    }

    /// Take all generated statements (consumes the generator)
    fn take_statements(self) -> List<Statement> {
        self.statements
    }

    /// Clear all generated statements
    fn clear(&mut self) {
        self.statements.clear();
    }

    /// Get statement count
    fn count(&self) -> usize {
        self.statements.len()
    }

    /// Validate all statements
    fn validate_all(&self) -> List<(usize, List<String>)> {
        self.statements.iter().enumerate()
            .filter_map(|(i, stmt)| {
                let builder = FluentStatementBuilder {
                    statement: stmt.clone(),
                    errors: vec![]
                };
                let errors = builder.validate();
                if errors.is_empty() {
                    None
                } else {
                    Some((i, errors))
                }
            })
            .collect()
    }
}

// =============================================================================
// STATEMENT VALIDATION
// =============================================================================

/// Validation result for statements
type StatementValidation {
    valid: Bool,
    errors: List<String>,
    warnings: List<String>
}

impl StatementValidation {
    fn new() -> StatementValidation {
        StatementValidation {
            valid: true,
            errors: vec![],
            warnings: vec![]
        }
    }

    fn add_error(&mut self, error: String) {
        self.valid = false;
        self.errors.push(error);
    }

    fn add_warning(&mut self, warning: String) {
        self.warnings.push(warning);
    }
}

/// Validate a statement according to xAPI 1.0.3 spec
fn validate_statement(statement: &Statement) -> StatementValidation {
    let mut result = StatementValidation::new();

    // Validate verb
    if statement.verb.id.is_empty() {
        result.add_error("Verb ID is required".to_string());
    }

    // Validate object
    match &statement.object {
        Object::Activity(activity) => {
            if activity.id.is_empty() {
                result.add_error("Activity ID is required".to_string());
            }
        },
        Object::StatementRef(stmt_ref) => {
            if stmt_ref.id.is_empty() {
                result.add_error("Statement reference ID is required".to_string());
            }
        },
        Object::Agent(_) | Object::SubStatement(_) => {}
    }

    // Validate voiding statement
    if statement.verb.id == "http://adlnet.gov/expapi/verbs/voided" {
        match &statement.object {
            Object::StatementRef(_) => {},
            _ => result.add_error("Voided verb requires StatementRef as object".to_string())
        }
    }

    // Validate score
    if let Some(ref res) = statement.result {
        if let Some(ref score) = res.score {
            if let Some(scaled) = score.scaled {
                if scaled < -1.0 || scaled > 1.0 {
                    result.add_error("Scaled score must be between -1 and 1".to_string());
                }
            }
            if let (Some(min), Some(max)) = (score.min, score.max) {
                if min > max {
                    result.add_error("Score min cannot be greater than max".to_string());
                }
            }
            if let (Some(raw), Some(min)) = (score.raw, score.min) {
                if raw < min {
                    result.add_error("Raw score cannot be less than min".to_string());
                }
            }
            if let (Some(raw), Some(max)) = (score.raw, score.max) {
                if raw > max {
                    result.add_error("Raw score cannot be greater than max".to_string());
                }
            }
        }

        // Warn about duration format
        if let Some(ref duration) = res.duration {
            if !duration.starts_with("P") {
                result.add_warning("Duration should be in ISO 8601 format".to_string());
            }
        }
    }

    // Validate timestamp format
    if let Some(ref timestamp) = statement.timestamp {
        // Basic check for ISO 8601 format
        if !timestamp.contains("T") {
            result.add_warning("Timestamp should be in ISO 8601 format".to_string());
        }
    }

    result
}

