/// Intelligo LMS - SCORM 2004 Runtime
///
/// Implementation of the SCORM 2004 Run-Time Environment (RTE) specification.
/// Supports SCORM 2004 2nd, 3rd, and 4th Editions with the API_1484_11 interface.

module intelligo::compliance::scorm::scorm2004

use intelligo::core::types::*
use intelligo::compliance::scorm::scorm12::{parse_timespan, format_timespan}
use std::time::{DateTime, Duration, Instant}
use std::collections::{Map, Set, List}

// =============================================================================
// SCORM 2004 IDENTITY TYPES
// =============================================================================

/// Unique identifier for a SCORM 2004 session
type Scorm2004SessionId = String

/// Unique identifier for an activity
type ActivityId = String

/// Unique identifier for an objective
type ObjectiveId = String

/// Unique identifier for an interaction
type InteractionId = String

/// Unique identifier for a learner
type LearnerId = String

// =============================================================================
// SCORM 2004 ERROR CODES
// =============================================================================

/// SCORM 2004 Error Codes (per specification)
enum Scorm2004Error {
    /// No error
    NoError,                            // 0
    /// General exception
    GeneralException,                   // 101
    /// General initialization failure
    GeneralInitializationFailure,       // 102
    /// Already initialized
    AlreadyInitialized,                 // 103
    /// Content instance terminated
    ContentInstanceTerminated,          // 104
    /// General termination failure
    GeneralTerminationFailure,          // 111
    /// Termination before initialization
    TerminationBeforeInitialization,    // 112
    /// Termination after termination
    TerminationAfterTermination,        // 113
    /// Retrieve data before initialization
    RetrieveBeforeInitialization,       // 122
    /// Retrieve data after termination
    RetrieveAfterTermination,           // 123
    /// Store data before initialization
    StoreBeforeInitialization,          // 132
    /// Store data after termination
    StoreAfterTermination,              // 133
    /// Commit before initialization
    CommitBeforeInitialization,         // 142
    /// Commit after termination
    CommitAfterTermination,             // 143
    /// General argument error
    GeneralArgumentError,               // 201
    /// General get failure
    GeneralGetFailure,                  // 301
    /// General set failure
    GeneralSetFailure,                  // 351
    /// General commit failure
    GeneralCommitFailure,               // 391
    /// Undefined data model element
    UndefinedDataModelElement,          // 401
    /// Unimplemented data model element
    UnimplementedDataModelElement,      // 402
    /// Data model element value not initialized
    DataModelElementValueNotInitialized, // 403
    /// Data model element is read only
    DataModelElementIsReadOnly,         // 404
    /// Data model element is write only
    DataModelElementIsWriteOnly,        // 405
    /// Data model element type mismatch
    DataModelElementTypeMismatch,       // 406
    /// Data model element value out of range
    DataModelElementValueOutOfRange,    // 407
    /// Data model dependency not established
    DataModelDependencyNotEstablished   // 408
}

impl Scorm2004Error {
    /// Get numeric error code
    fn code(&self) -> String {
        match self {
            Scorm2004Error::NoError => "0",
            Scorm2004Error::GeneralException => "101",
            Scorm2004Error::GeneralInitializationFailure => "102",
            Scorm2004Error::AlreadyInitialized => "103",
            Scorm2004Error::ContentInstanceTerminated => "104",
            Scorm2004Error::GeneralTerminationFailure => "111",
            Scorm2004Error::TerminationBeforeInitialization => "112",
            Scorm2004Error::TerminationAfterTermination => "113",
            Scorm2004Error::RetrieveBeforeInitialization => "122",
            Scorm2004Error::RetrieveAfterTermination => "123",
            Scorm2004Error::StoreBeforeInitialization => "132",
            Scorm2004Error::StoreAfterTermination => "133",
            Scorm2004Error::CommitBeforeInitialization => "142",
            Scorm2004Error::CommitAfterTermination => "143",
            Scorm2004Error::GeneralArgumentError => "201",
            Scorm2004Error::GeneralGetFailure => "301",
            Scorm2004Error::GeneralSetFailure => "351",
            Scorm2004Error::GeneralCommitFailure => "391",
            Scorm2004Error::UndefinedDataModelElement => "401",
            Scorm2004Error::UnimplementedDataModelElement => "402",
            Scorm2004Error::DataModelElementValueNotInitialized => "403",
            Scorm2004Error::DataModelElementIsReadOnly => "404",
            Scorm2004Error::DataModelElementIsWriteOnly => "405",
            Scorm2004Error::DataModelElementTypeMismatch => "406",
            Scorm2004Error::DataModelElementValueOutOfRange => "407",
            Scorm2004Error::DataModelDependencyNotEstablished => "408"
        }.to_string()
    }

    /// Get error description
    fn description(&self) -> String {
        match self {
            Scorm2004Error::NoError => "No Error",
            Scorm2004Error::GeneralException => "General Exception",
            Scorm2004Error::GeneralInitializationFailure => "General Initialization Failure",
            Scorm2004Error::AlreadyInitialized => "Already Initialized",
            Scorm2004Error::ContentInstanceTerminated => "Content Instance Terminated",
            Scorm2004Error::GeneralTerminationFailure => "General Termination Failure",
            Scorm2004Error::TerminationBeforeInitialization => "Termination Before Initialization",
            Scorm2004Error::TerminationAfterTermination => "Termination After Termination",
            Scorm2004Error::RetrieveBeforeInitialization => "Retrieve Data Before Initialization",
            Scorm2004Error::RetrieveAfterTermination => "Retrieve Data After Termination",
            Scorm2004Error::StoreBeforeInitialization => "Store Data Before Initialization",
            Scorm2004Error::StoreAfterTermination => "Store Data After Termination",
            Scorm2004Error::CommitBeforeInitialization => "Commit Before Initialization",
            Scorm2004Error::CommitAfterTermination => "Commit After Termination",
            Scorm2004Error::GeneralArgumentError => "General Argument Error",
            Scorm2004Error::GeneralGetFailure => "General Get Failure",
            Scorm2004Error::GeneralSetFailure => "General Set Failure",
            Scorm2004Error::GeneralCommitFailure => "General Commit Failure",
            Scorm2004Error::UndefinedDataModelElement => "Undefined Data Model Element",
            Scorm2004Error::UnimplementedDataModelElement => "Unimplemented Data Model Element",
            Scorm2004Error::DataModelElementValueNotInitialized => "Data Model Element Value Not Initialized",
            Scorm2004Error::DataModelElementIsReadOnly => "Data Model Element Is Read Only",
            Scorm2004Error::DataModelElementIsWriteOnly => "Data Model Element Is Write Only",
            Scorm2004Error::DataModelElementTypeMismatch => "Data Model Element Type Mismatch",
            Scorm2004Error::DataModelElementValueOutOfRange => "Data Model Element Value Out Of Range",
            Scorm2004Error::DataModelDependencyNotEstablished => "Data Model Dependency Not Established"
        }.to_string()
    }
}

// =============================================================================
// SCORM 2004 DATA MODEL
// =============================================================================

/// SCORM 2004 Completion Status
enum Cmi2004CompletionStatus {
    Completed,
    Incomplete,
    NotAttempted,
    Unknown
}

impl Cmi2004CompletionStatus {
    fn to_string(&self) -> String {
        match self {
            Cmi2004CompletionStatus::Completed => "completed",
            Cmi2004CompletionStatus::Incomplete => "incomplete",
            Cmi2004CompletionStatus::NotAttempted => "not attempted",
            Cmi2004CompletionStatus::Unknown => "unknown"
        }.to_string()
    }

    fn from_string(s: &str) -> Option<Cmi2004CompletionStatus> {
        match s {
            "completed" => Some(Cmi2004CompletionStatus::Completed),
            "incomplete" => Some(Cmi2004CompletionStatus::Incomplete),
            "not attempted" => Some(Cmi2004CompletionStatus::NotAttempted),
            "unknown" => Some(Cmi2004CompletionStatus::Unknown),
            _ => None
        }
    }
}

/// SCORM 2004 Success Status
enum Cmi2004SuccessStatus {
    Passed,
    Failed,
    Unknown
}

impl Cmi2004SuccessStatus {
    fn to_string(&self) -> String {
        match self {
            Cmi2004SuccessStatus::Passed => "passed",
            Cmi2004SuccessStatus::Failed => "failed",
            Cmi2004SuccessStatus::Unknown => "unknown"
        }.to_string()
    }

    fn from_string(s: &str) -> Option<Cmi2004SuccessStatus> {
        match s {
            "passed" => Some(Cmi2004SuccessStatus::Passed),
            "failed" => Some(Cmi2004SuccessStatus::Failed),
            "unknown" => Some(Cmi2004SuccessStatus::Unknown),
            _ => None
        }
    }
}

