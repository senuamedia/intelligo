}

/// Lesson mode (read-only)
enum CmiLessonMode {
    Browse,
    Normal,
    Review
}

impl CmiLessonMode {
    fn to_string(&self) -> String {
        match self {
            CmiLessonMode::Browse => "browse".to_string(),
            CmiLessonMode::Normal => "normal".to_string(),
            CmiLessonMode::Review => "review".to_string()
        }
    }

    fn from_string(s: &str) -> Option<CmiLessonMode> {
        match s {
            "browse" => Some(CmiLessonMode::Browse),
            "normal" => Some(CmiLessonMode::Normal),
            "review" => Some(CmiLessonMode::Review),
            _ => None
        }
    }
}

/// Score data
type CmiScore {
    /// Raw score (actual score achieved)
    raw: Option<f32>,

    /// Minimum possible score
    min: Option<f32>,

    /// Maximum possible score
    max: Option<f32>
}

impl CmiScore {
    fn new() -> CmiScore {
        CmiScore {
            raw: None,
            min: None,
            max: None
        }
    }

    /// Calculate scaled score (0-1)
    fn scaled(&self) -> Option<f32> {
        match (self.raw, self.min, self.max) {
            (Some(raw), Some(min), Some(max)) if max > min => {
                Some((raw - min) / (max - min))
            },
            (Some(raw), None, Some(max)) if max > 0.0 => {
                Some(raw / max)
            },
            _ => None
        }
    }

    /// Calculate percentage score
    fn percentage(&self) -> Option<f32> {
        self.scaled().map(|s| s * 100.0)
    }
}

// =============================================================================
// SCORM 1.2 CMI DATA MODEL - SUSPEND DATA
// =============================================================================

/// Suspend data for bookmarking
type CmiSuspendData {
    /// Free-form data string (max 4096 chars in SCORM 1.2)
    data: Option<String>
}

impl CmiSuspendData {
    fn new() -> CmiSuspendData {
        CmiSuspendData { data: None }
    }

    /// Validate suspend data length
    fn validate(&self) -> Result<(), Scorm12Error> {
        if let Some(ref data) = self.data {
            if data.len() > 4096 {
                return Err(Scorm12Error::IncorrectDataType)
            }
        }
        Ok(())
    }
}

// =============================================================================
// SCORM 1.2 CMI DATA MODEL - LAUNCH DATA
// =============================================================================

/// Launch data provided by LMS (read-only)
type CmiLaunchData {
    /// Data from manifest dataFromLMS element
    data: Option<String>
}

// =============================================================================
// SCORM 1.2 CMI DATA MODEL - COMMENTS
// =============================================================================

/// Learner comments
type CmiComments {
    /// Free-form comments from learner
    content: Option<String>
}

/// Comments from LMS (read-only)
type CmiCommentsFromLms {
    /// Comments provided by LMS
    content: Option<String>
}

