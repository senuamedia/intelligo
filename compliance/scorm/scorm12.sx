// HELPER FUNCTIONS
// =============================================================================

/// Build CMI element metadata map
fn build_element_metadata() -> Map<String, CmiElementMetadata> {
    let mut metadata = Map::new();

    // Core elements
    metadata.insert("cmi.core.student_id".to_string(), CmiElementMetadata {
        path: "cmi.core.student_id".to_string(),
        readable: true,
        writable: false,
        data_type: CmiDataType::CMIString255,
        max_length: Some(255),
        vocabulary: None
    });

    metadata.insert("cmi.core.student_name".to_string(), CmiElementMetadata {
        path: "cmi.core.student_name".to_string(),
        readable: true,
        writable: false,
        data_type: CmiDataType::CMIString255,
        max_length: Some(255),
        vocabulary: None
    });

    metadata.insert("cmi.core.lesson_location".to_string(), CmiElementMetadata {
        path: "cmi.core.lesson_location".to_string(),
        readable: true,
        writable: true,
        data_type: CmiDataType::CMIString255,
        max_length: Some(255),
        vocabulary: None
    });

    metadata.insert("cmi.core.lesson_status".to_string(), CmiElementMetadata {
        path: "cmi.core.lesson_status".to_string(),
        readable: true,
        writable: true,
        data_type: CmiDataType::CMIVocabulary,
        max_length: None,
        vocabulary: Some(vec![
            "passed".to_string(),
            "completed".to_string(),
            "failed".to_string(),
            "incomplete".to_string(),
            "browsed".to_string(),
            "not attempted".to_string()
        ])
    });

    metadata.insert("cmi.suspend_data".to_string(), CmiElementMetadata {
        path: "cmi.suspend_data".to_string(),
        readable: true,
        writable: true,
        data_type: CmiDataType::CMIString4096,
        max_length: Some(4096),
        vocabulary: None
    });

    // Add more metadata as needed...

    metadata
}

/// Generate unique identifier
fn generate_uuid() -> String {
    std::uuid::v4()
}

// =============================================================================
// COMPLETION/SUCCESS STATUS TRACKING
// =============================================================================

/// Track completion and success based on CMI data
type CompletionTracker {
    /// Whether learner has completed
    is_complete: Bool,

    /// Whether learner has passed
    is_successful: Bool,

    /// Completion percentage (0-100)
    progress_percent: f32,

    /// Final score
    final_score: Option<f32>,

    /// Time spent (formatted)
    total_time: String
}

impl CompletionTracker {
    /// Create tracker from CMI data
    fn from_cmi(cmi: &CmiDataModel) -> CompletionTracker {
        let is_complete = cmi.core.lesson_status.is_complete();
        let is_successful = cmi.core.lesson_status.is_successful();

        let progress_percent = if is_complete { 100.0 } else {
            // Estimate from lesson location if available
            0.0
        };

        CompletionTracker {
            is_complete,
            is_successful,
            progress_percent,
            final_score: cmi.core.score.raw,
            total_time: cmi.core.total_time.clone().unwrap_or_else(|| "0000:00:00.00".to_string())
        }
    }

    /// Check if mastery score is achieved
    fn check_mastery(&self, mastery_score: Option<f32>) -> Bool {
        match (self.final_score, mastery_score) {
            (Some(score), Some(mastery)) => score >= mastery,
            _ => false
        }
    }
}

