}

// =============================================================================
// SCORM 1.2 CMI DATA MODEL - INTERACTIONS
// =============================================================================

/// A learner interaction (question/response)
type CmiInteraction {
    /// Unique identifier for this interaction
    id: InteractionId,

    /// Objectives associated with this interaction
    objectives: List<ObjectiveId>,

    /// Time interaction occurred (format: HH:MM:SS.SS)
    time: Option<String>,

    /// Type of interaction
    interaction_type: CmiInteractionType,

    /// Correct response patterns
    correct_responses: List<String>,

    /// How the interaction was weighted
    weighting: Option<f32>,

    /// Learner's response
    student_response: Option<String>,

    /// Result of the interaction
    result: CmiInteractionResult,

    /// Latency (time to respond)
    latency: Option<String>
}

/// Interaction type
enum CmiInteractionType {
    TrueFalse,
    Choice,
    FillIn,
    Matching,
    Performance,
    Sequencing,
    Likert,
    Numeric
}

impl CmiInteractionType {
    fn to_string(&self) -> String {
        match self {
            CmiInteractionType::TrueFalse => "true-false".to_string(),
            CmiInteractionType::Choice => "choice".to_string(),
            CmiInteractionType::FillIn => "fill-in".to_string(),
            CmiInteractionType::Matching => "matching".to_string(),
            CmiInteractionType::Performance => "performance".to_string(),
            CmiInteractionType::Sequencing => "sequencing".to_string(),
            CmiInteractionType::Likert => "likert".to_string(),
            CmiInteractionType::Numeric => "numeric".to_string()
        }
    }

    fn from_string(s: &str) -> Option<CmiInteractionType> {
        match s {
            "true-false" => Some(CmiInteractionType::TrueFalse),
            "choice" => Some(CmiInteractionType::Choice),
            "fill-in" => Some(CmiInteractionType::FillIn),
            "matching" => Some(CmiInteractionType::Matching),
            "performance" => Some(CmiInteractionType::Performance),
            "sequencing" => Some(CmiInteractionType::Sequencing),
            "likert" => Some(CmiInteractionType::Likert),
            "numeric" => Some(CmiInteractionType::Numeric),
            _ => None
        }
    }
}

/// Interaction result
enum CmiInteractionResult {
    Correct,
    Wrong,
    Unanticipated,
    Neutral,
    Numeric { value: f32 }
}

impl CmiInteractionResult {
    fn to_string(&self) -> String {
        match self {
            CmiInteractionResult::Correct => "correct".to_string(),
            CmiInteractionResult::Wrong => "wrong".to_string(),
            CmiInteractionResult::Unanticipated => "unanticipated".to_string(),
            CmiInteractionResult::Neutral => "neutral".to_string(),
            CmiInteractionResult::Numeric { value } => value.to_string()
        }
    }

    fn from_string(s: &str) -> CmiInteractionResult {
        match s {
            "correct" => CmiInteractionResult::Correct,
            "wrong" => CmiInteractionResult::Wrong,
            "unanticipated" => CmiInteractionResult::Unanticipated,
            "neutral" => CmiInteractionResult::Neutral,
            _ => {
                if let Ok(value) = s.parse::<f32>() {
                    CmiInteractionResult::Numeric { value }
                } else {
                    CmiInteractionResult::Neutral
                }
            }
        }
    }
}

impl CmiInteraction {
    fn new(id: InteractionId) -> CmiInteraction {
        CmiInteraction {
            id,
            objectives: vec![],
            time: None,
            interaction_type: CmiInteractionType::Choice,
            correct_responses: vec![],
            weighting: None,
            student_response: None,
            result: CmiInteractionResult::Neutral,
            latency: None
        }
    }
}

