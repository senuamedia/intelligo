// =============================================================================
// COMPLETE CMI DATA MODEL
// =============================================================================

/// Complete CMI data model for SCORM 1.2
type CmiDataModel {
    /// Core data elements
    core: CmiCore,

    /// Suspend data for bookmarking
    suspend_data: CmiSuspendData,

    /// Launch data from LMS
    launch_data: CmiLaunchData,

    /// Learner comments
    comments: CmiComments,

    /// Comments from LMS
    comments_from_lms: CmiCommentsFromLms,

    /// Learning objectives
    objectives: List<CmiObjective>,

    /// Learner interactions
    interactions: List<CmiInteraction>,

    /// Student data from LMS
    student_data: CmiStudentData,

    /// Student preferences
    student_preference: CmiStudentPreference
}

impl CmiDataModel {
    /// Create new CMI data model with initial values
    fn new(
        student_id: String,
        student_name: String,
        lesson_mode: CmiLessonMode,
        credit: CmiCredit
    ) -> CmiDataModel {
        CmiDataModel {
            core: CmiCore {
                student_id,
                student_name,
                lesson_location: None,
                credit,
                lesson_status: CmiLessonStatus::NotAttempted,
                entry: CmiEntry::AbInitio,
                score: CmiScore::new(),
                total_time: Some("0000:00:00.00".to_string()),
                session_time: None,
                exit: CmiExit::Empty,
                lesson_mode
            },
            suspend_data: CmiSuspendData::new(),
            launch_data: CmiLaunchData { data: None },
            comments: CmiComments { content: None },
            comments_from_lms: CmiCommentsFromLms { content: None },
            objectives: vec![],
            interactions: vec![],
            student_data: CmiStudentData {
                mastery_score: None,
                max_time_allowed: None,
                time_limit_action: CmiTimeLimitAction::ContinueNoMessage
            },
            student_preference: CmiStudentPreference::new()
        }
    }

    /// Initialize for resume (returning learner)
    fn init_for_resume(&mut self, previous_data: &CmiDataModel) {
        self.core.entry = CmiEntry::Resume;
        self.core.lesson_location = previous_data.core.lesson_location.clone();
        self.core.total_time = previous_data.core.total_time.clone();
        self.suspend_data = CmiSuspendData {
            data: previous_data.suspend_data.data.clone()
        };
        self.objectives = previous_data.objectives.clone();
        self.core.lesson_status = previous_data.core.lesson_status.clone();
        self.core.score = previous_data.core.score.clone();
    }
}

// =============================================================================
// SCORM 1.2 SESSION
// =============================================================================

/// Active SCORM 1.2 session
type Scorm12Session {
    /// Session identifier
    id: Scorm12SessionId,

    /// User ID
    user_id: UserId,

    /// SCO identifier
    sco_id: String,

    /// Package ID
    package_id: ScormPackageId,

    /// Enrollment ID
    enrollment_id: EnrollmentId,

    /// CMI data model
    cmi: CmiDataModel,

    /// Session state
    state: Scorm12SessionState,

    /// Last error
    last_error: Scorm12Error,

    /// Error diagnostic info
    error_diagnostic: Option<String>,

    /// Session start time
    started_at: DateTime,

    /// Last activity time
    last_activity_at: DateTime,

    /// Number of LMS API calls
    api_call_count: i64,

    /// Dirty flag (data changed since last commit)
    is_dirty: Bool
}

/// Session state
enum Scorm12SessionState {
    /// Not yet initialized
    NotInitialized,
    /// Active session
    Initialized,
    /// Session terminated
    Terminated
}

impl Scorm12Session {
    fn new(
        user_id: UserId,
        sco_id: String,
        package_id: ScormPackageId,
        enrollment_id: EnrollmentId,
        student_name: String,
        lesson_mode: CmiLessonMode,
        credit: CmiCredit
    ) -> Scorm12Session {
        let now = DateTime::now();
        Scorm12Session {
            id: format!("scorm12_session_{}", generate_uuid()),
            user_id: user_id.clone(),
            sco_id,
            package_id,
            enrollment_id,
            cmi: CmiDataModel::new(user_id, student_name, lesson_mode, credit),
            state: Scorm12SessionState::NotInitialized,
            last_error: Scorm12Error::NoError,
            error_diagnostic: None,
            started_at: now,
            last_activity_at: now,
            api_call_count: 0,
            is_dirty: false
        }
    }
}

// =============================================================================
// SCORM 1.2 API RESULT
// =============================================================================

/// Result of SCORM API call
type Scorm12ApiResult {
    /// Return value ("true"/"false" for most calls)
    value: String,

    /// Error code
    error: Scorm12Error,

    /// Diagnostic message
    diagnostic: Option<String>
}

impl Scorm12ApiResult {
    fn success() -> Scorm12ApiResult {
        Scorm12ApiResult {
            value: "true".to_string(),
            error: Scorm12Error::NoError,
            diagnostic: None
        }
    }

    fn success_value(value: String) -> Scorm12ApiResult {
        Scorm12ApiResult {
            value,
            error: Scorm12Error::NoError,
            diagnostic: None
        }
    }

    fn error(error: Scorm12Error, diagnostic: Option<String>) -> Scorm12ApiResult {
        Scorm12ApiResult {
            value: "false".to_string(),
            error,
            diagnostic
        }
    }

    fn empty_value(error: Scorm12Error, diagnostic: Option<String>) -> Scorm12ApiResult {
        Scorm12ApiResult {
            value: "".to_string(),
            error,
            diagnostic
        }
    }
}

// =============================================================================
// SCORM 1.2 DATA MODEL ELEMENT METADATA
// =============================================================================

/// Metadata about a CMI data model element
type CmiElementMetadata {
    /// Full element path (e.g., "cmi.core.student_id")
    path: String,

    /// Whether element is readable
    readable: Bool,

    /// Whether element is writable
    writable: Bool,

    /// Data type
    data_type: CmiDataType,

    /// Maximum length (for strings)
    max_length: Option<i32>,

    /// Vocabulary (allowed values)
    vocabulary: Option<List<String>>
}

/// CMI data types
enum CmiDataType {
    CMIString255,
    CMIString4096,
    CMIIdentifier,
    CMIInteger,
    CMIDecimal,
    CMITimespan,
    CMITime,
    CMIBlank,
    CMIVocabulary
}

// =============================================================================
// TIME UTILITIES
// =============================================================================

/// Parse SCORM 1.2 timespan format (HHHH:MM:SS.SS)
fn parse_timespan(timespan: &str) -> Option<Duration> {
    let parts: List<&str> = timespan.split(':').collect();
    if parts.len() != 3 {
        return None
    }

    let hours: i64 = parts[0].parse().ok()?;
    let minutes: i64 = parts[1].parse().ok()?;

    let seconds_parts: List<&str> = parts[2].split('.').collect();
    let seconds: i64 = seconds_parts[0].parse().ok()?;
    let centiseconds: i64 = if seconds_parts.len() > 1 {
        seconds_parts[1].parse().unwrap_or(0)
    } else {
        0
    };

    let total_ms = (hours * 3600 + minutes * 60 + seconds) * 1000 + centiseconds * 10;
    Some(Duration::from_millis(total_ms))
}

/// Format duration as SCORM 1.2 timespan (HHHH:MM:SS.SS)
fn format_timespan(duration: Duration) -> String {
    let total_seconds = duration.as_secs();
    let hours = total_seconds / 3600;
    let minutes = (total_seconds % 3600) / 60;
    let seconds = total_seconds % 60;
    let centiseconds = (duration.subsec_millis() / 10) as i64;

    format!("{:04}:{:02}:{:02}.{:02}", hours, minutes, seconds, centiseconds)
}

/// Add two timespans and return result
fn add_timespans(time1: &str, time2: &str) -> Option<String> {
    let d1 = parse_timespan(time1)?;
    let d2 = parse_timespan(time2)?;
    Some(format_timespan(d1 + d2))
}

// =============================================================================
// SCORM 1.2 RUNTIME ACTOR
// =============================================================================

/// Messages for ScormRuntime12 actor
enum Scorm12Message {
    /// Initialize a new session
    CreateSession {
        user_id: UserId,
        sco_id: String,
        package_id: ScormPackageId,
        enrollment_id: EnrollmentId,
        student_name: String,
        lesson_mode: CmiLessonMode,
        credit: CmiCredit,
        reply_to: Actor<Scorm12SessionId>
    },

    /// Load previous session data for resume
    LoadPreviousSession {
        session_id: Scorm12SessionId,
        reply_to: Actor<Option<CmiDataModel>>
    },

    /// LMSInitialize
    Initialize {
        session_id: Scorm12SessionId,
        param: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSFinish
    Finish {
        session_id: Scorm12SessionId,
        param: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSGetValue
    GetValue {
        session_id: Scorm12SessionId,
        element: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSSetValue
    SetValue {
        session_id: Scorm12SessionId,
        element: String,
        value: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSCommit
    Commit {
        session_id: Scorm12SessionId,
        param: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSGetLastError
    GetLastError {
        session_id: Scorm12SessionId,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSGetErrorString
    GetErrorString {
        session_id: Scorm12SessionId,
        error_code: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// LMSGetDiagnostic
    GetDiagnostic {
        session_id: Scorm12SessionId,
        param: String,
        reply_to: Actor<Scorm12ApiResult>
    },

    /// Get session data
    GetSession {
        session_id: Scorm12SessionId,
        reply_to: Actor<Option<Scorm12Session>>
    },

    /// Persist session data to storage
    PersistSession {
        session_id: Scorm12SessionId,
        reply_to: Actor<Result<(), String>>
    }
}

/// SCORM 1.2 Runtime actor state
type Scorm12RuntimeState {
    /// Active sessions
    sessions: Map<Scorm12SessionId, Scorm12Session>,

    /// Persisted session data (for resume)
    persisted_data: Map<String, CmiDataModel>, // key: user_id + sco_id

    /// CMI element metadata
    element_metadata: Map<String, CmiElementMetadata>
}

/// SCORM 1.2 Runtime actor
actor ScormRuntime12 {
    state: Scorm12RuntimeState,

    /// Initialize the runtime
    fn init() -> ScormRuntime12 {
        ScormRuntime12 {
            state: Scorm12RuntimeState {
                sessions: Map::new(),
                persisted_data: Map::new(),
                element_metadata: build_element_metadata()
            }
        }
    }

    /// Handle incoming messages
    fn receive(&mut self, msg: Scorm12Message) {
        match msg {
            Scorm12Message::CreateSession {
                user_id, sco_id, package_id, enrollment_id,
                student_name, lesson_mode, credit, reply_to
            } => {
                let session = Scorm12Session::new(
                    user_id.clone(),
                    sco_id.clone(),
                    package_id,
                    enrollment_id,
                    student_name,
                    lesson_mode,
                    credit
                );

                // Check for previous data to resume
                let persist_key = format!("{}_{}", user_id, sco_id);
                if let Some(previous) = self.state.persisted_data.get(&persist_key) {
                    session.cmi.init_for_resume(previous);
                }

                let session_id = session.id.clone();
                self.state.sessions.insert(session_id.clone(), session);
                reply_to.send(session_id);
            },

            Scorm12Message::LoadPreviousSession { session_id, reply_to } => {
                let result = self.state.sessions.get(&session_id)
                    .map(|s| {
                        let key = format!("{}_{}", s.user_id, s.sco_id);
                        self.state.persisted_data.get(&key).cloned()
                    })
                    .flatten();
                reply_to.send(result);
            },

            Scorm12Message::Initialize { session_id, param, reply_to } => {
                let result = self.lms_initialize(&session_id, &param);
                reply_to.send(result);
            },

            Scorm12Message::Finish { session_id, param, reply_to } => {
                let result = self.lms_finish(&session_id, &param);
                reply_to.send(result);
            },

            Scorm12Message::GetValue { session_id, element, reply_to } => {
                let result = self.lms_get_value(&session_id, &element);
                reply_to.send(result);
            },

            Scorm12Message::SetValue { session_id, element, value, reply_to } => {
                let result = self.lms_set_value(&session_id, &element, &value);
                reply_to.send(result);
            },

            Scorm12Message::Commit { session_id, param, reply_to } => {
                let result = self.lms_commit(&session_id, &param);
                reply_to.send(result);
            },

            Scorm12Message::GetLastError { session_id, reply_to } => {
                let result = self.lms_get_last_error(&session_id);
                reply_to.send(result);
            },

            Scorm12Message::GetErrorString { session_id, error_code, reply_to } => {
                let result = self.lms_get_error_string(&error_code);
                reply_to.send(result);
            },

            Scorm12Message::GetDiagnostic { session_id, param, reply_to } => {
                let result = self.lms_get_diagnostic(&session_id, &param);
                reply_to.send(result);
            },

            Scorm12Message::GetSession { session_id, reply_to } => {
                let session = self.state.sessions.get(&session_id).cloned();
                reply_to.send(session);
            },

            Scorm12Message::PersistSession { session_id, reply_to } => {
                let result = self.persist_session(&session_id);
                reply_to.send(result);
            }
        }
    }

    // =========================================================================
    // SCORM 1.2 API IMPLEMENTATIONS
    // =========================================================================

    /// LMSInitialize("") - Initialize communication
    fn lms_initialize(&mut self, session_id: &Scorm12SessionId, param: &str) -> Scorm12ApiResult {
        // Parameter must be empty string
        if !param.is_empty() {
            return Scorm12ApiResult::error(
                Scorm12Error::InvalidArgumentError,
                Some("LMSInitialize parameter must be empty string".to_string())
            )
        }

        let session = match self.state.sessions.get_mut(session_id) {
            Some(s) => s,
            None => return Scorm12ApiResult::error(
                Scorm12Error::GeneralException,
                Some("Session not found".to_string())
            )
        };

        session.api_call_count += 1;
        session.last_activity_at = DateTime::now();

        match session.state {
            Scorm12SessionState::Initialized => {
                session.last_error = Scorm12Error::GeneralException;
                session.error_diagnostic = Some("Already initialized".to_string());
                Scorm12ApiResult::error(
                    Scorm12Error::GeneralException,
                    Some("Already initialized".to_string())
                )
            },
            Scorm12SessionState::Terminated => {
                session.last_error = Scorm12Error::GeneralException;
                session.error_diagnostic = Some("Session already terminated".to_string());
                Scorm12ApiResult::error(
                    Scorm12Error::GeneralException,
                    Some("Session already terminated".to_string())
                )
            },
            Scorm12SessionState::NotInitialized => {
                session.state = Scorm12SessionState::Initialized;
                session.last_error = Scorm12Error::NoError;
                session.error_diagnostic = None;
                Scorm12ApiResult::success()
            }
        }
    }

    /// LMSFinish("") - Terminate communication
    fn lms_finish(&mut self, session_id: &Scorm12SessionId, param: &str) -> Scorm12ApiResult {
        if !param.is_empty() {
            return Scorm12ApiResult::error(
                Scorm12Error::InvalidArgumentError,
                Some("LMSFinish parameter must be empty string".to_string())
            )
        }

        let session = match self.state.sessions.get_mut(session_id) {
            Some(s) => s,
            None => return Scorm12ApiResult::error(
                Scorm12Error::GeneralException,
                Some("Session not found".to_string())
            )
        };

        session.api_call_count += 1;
        session.last_activity_at = DateTime::now();

        match session.state {
            Scorm12SessionState::NotInitialized => {
                session.last_error = Scorm12Error::NotInitialized;
                Scorm12ApiResult::error(Scorm12Error::NotInitialized, None)
            },
            Scorm12SessionState::Terminated => {
                session.last_error = Scorm12Error::GeneralException;
                session.error_diagnostic = Some("Already terminated".to_string());
                Scorm12ApiResult::error(
                    Scorm12Error::GeneralException,
                    Some("Already terminated".to_string())
                )
            },
            Scorm12SessionState::Initialized => {
                // Update total time
                if let Some(session_time) = &session.cmi.core.session_time {
                    if let Some(total) = &session.cmi.core.total_time {
                        session.cmi.core.total_time = add_timespans(total, session_time);
                    }
                }

                // Persist data if exit is suspend
                if matches!(session.cmi.core.exit, CmiExit::Suspend) {
                    let persist_key = format!("{}_{}", session.user_id, session.sco_id);
                    self.state.persisted_data.insert(persist_key, session.cmi.clone());
                }

                session.state = Scorm12SessionState::Terminated;
                session.last_error = Scorm12Error::NoError;
                Scorm12ApiResult::success()
            }
        }
    }

    /// LMSGetValue(element) - Get data model element value
    fn lms_get_value(&mut self, session_id: &Scorm12SessionId, element: &str) -> Scorm12ApiResult {
        let session = match self.state.sessions.get_mut(session_id) {
            Some(s) => s,
            None => return Scorm12ApiResult::empty_value(
                Scorm12Error::GeneralException,
                Some("Session not found".to_string())
            )
        };

        session.api_call_count += 1;
        session.last_activity_at = DateTime::now();

        // Check initialization
        if !matches!(session.state, Scorm12SessionState::Initialized) {
            session.last_error = Scorm12Error::NotInitialized;
            return Scorm12ApiResult::empty_value(Scorm12Error::NotInitialized, None)
        }

        // Get value based on element path
        let result = self.get_cmi_value(&session.cmi, element);

        match result {
            Ok(value) => {
                session.last_error = Scorm12Error::NoError;
                Scorm12ApiResult::success_value(value)
            },
            Err(error) => {
                session.last_error = error.clone();
                session.error_diagnostic = Some(format!("Element: {}", element));
                Scorm12ApiResult::empty_value(error, Some(element.to_string()))
            }
        }
    }

    /// LMSSetValue(element, value) - Set data model element value
    fn lms_set_value(&mut self, session_id: &Scorm12SessionId, element: &str, value: &str) -> Scorm12ApiResult {
        let session = match self.state.sessions.get_mut(session_id) {
            Some(s) => s,
            None => return Scorm12ApiResult::error(
                Scorm12Error::GeneralException,
                Some("Session not found".to_string())
            )
        };

        session.api_call_count += 1;
        session.last_activity_at = DateTime::now();

        // Check initialization
        if !matches!(session.state, Scorm12SessionState::Initialized) {
            session.last_error = Scorm12Error::NotInitialized;
            return Scorm12ApiResult::error(Scorm12Error::NotInitialized, None)
        }

        // Set value based on element path
        let result = self.set_cmi_value(&mut session.cmi, element, value);

        match result {
            Ok(()) => {
                session.last_error = Scorm12Error::NoError;
                session.is_dirty = true;
                Scorm12ApiResult::success()
            },
            Err(error) => {
                session.last_error = error.clone();
                session.error_diagnostic = Some(format!("Element: {}, Value: {}", element, value));
                Scorm12ApiResult::error(error, Some(element.to_string()))
            }
        }
    }

    /// LMSCommit("") - Persist data
    fn lms_commit(&mut self, session_id: &Scorm12SessionId, param: &str) -> Scorm12ApiResult {
        if !param.is_empty() {
            return Scorm12ApiResult::error(
                Scorm12Error::InvalidArgumentError,
                Some("LMSCommit parameter must be empty string".to_string())
            )
        }

        let session = match self.state.sessions.get_mut(session_id) {
            Some(s) => s,
            None => return Scorm12ApiResult::error(
                Scorm12Error::GeneralException,
                Some("Session not found".to_string())
            )
        };

        session.api_call_count += 1;
        session.last_activity_at = DateTime::now();

        if !matches!(session.state, Scorm12SessionState::Initialized) {
            session.last_error = Scorm12Error::NotInitialized;
            return Scorm12ApiResult::error(Scorm12Error::NotInitialized, None)
        }

        // Persist data to storage
        let persist_key = format!("{}_{}", session.user_id, session.sco_id);
        self.state.persisted_data.insert(persist_key, session.cmi.clone());
        session.is_dirty = false;
        session.last_error = Scorm12Error::NoError;

        Scorm12ApiResult::success()
    }

    /// LMSGetLastError() - Get last error code
    fn lms_get_last_error(&self, session_id: &Scorm12SessionId) -> Scorm12ApiResult {
        match self.state.sessions.get(session_id) {
            Some(session) => Scorm12ApiResult::success_value(session.last_error.code()),
            None => Scorm12ApiResult::success_value("0".to_string())
        }
    }

    /// LMSGetErrorString(errorCode) - Get error description
    fn lms_get_error_string(&self, error_code: &str) -> Scorm12ApiResult {
        let error = match error_code {
            "0" => Scorm12Error::NoError,
            "101" => Scorm12Error::GeneralException,
            "201" => Scorm12Error::InvalidArgumentError,
            "202" => Scorm12Error::ElementCannotHaveChildren,
            "203" => Scorm12Error::ElementNotAnArray,
            "301" => Scorm12Error::NotInitialized,
            "401" => Scorm12Error::NotImplementedError,
            "402" => Scorm12Error::InvalidSetValueKeyword,
            "403" => Scorm12Error::ElementIsReadOnly,
            "404" => Scorm12Error::ElementIsWriteOnly,
            "405" => Scorm12Error::IncorrectDataType,
            _ => return Scorm12ApiResult::success_value("".to_string())
        };

        Scorm12ApiResult::success_value(error.description())
    }

    /// LMSGetDiagnostic(param) - Get diagnostic info
    fn lms_get_diagnostic(&self, session_id: &Scorm12SessionId, param: &str) -> Scorm12ApiResult {
        match self.state.sessions.get(session_id) {
            Some(session) => {
                let diagnostic = session.error_diagnostic.clone()
                    .unwrap_or_else(|| session.last_error.description());
                Scorm12ApiResult::success_value(diagnostic)
            },
            None => Scorm12ApiResult::success_value("No session".to_string())
        }
    }

    // =========================================================================
    // CMI DATA MODEL ACCESS
    // =========================================================================

    /// Get CMI value by element path
    fn get_cmi_value(&self, cmi: &CmiDataModel, element: &str) -> Result<String, Scorm12Error> {
        match element {
            // Core elements (mostly read-only)
            "cmi.core.student_id" => Ok(cmi.core.student_id.clone()),
            "cmi.core.student_name" => Ok(cmi.core.student_name.clone()),
            "cmi.core.lesson_location" => Ok(cmi.core.lesson_location.clone().unwrap_or_default()),
            "cmi.core.credit" => Ok(cmi.core.credit.to_string()),
            "cmi.core.lesson_status" => Ok(cmi.core.lesson_status.to_string()),
            "cmi.core.entry" => Ok(cmi.core.entry.to_string()),
            "cmi.core.score.raw" => Ok(cmi.core.score.raw.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.core.score.min" => Ok(cmi.core.score.min.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.core.score.max" => Ok(cmi.core.score.max.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.core.score._children" => Ok("raw,min,max".to_string()),
            "cmi.core.total_time" => Ok(cmi.core.total_time.clone().unwrap_or_default()),
            "cmi.core.lesson_mode" => Ok(cmi.core.lesson_mode.to_string()),
            "cmi.core.exit" => Err(Scorm12Error::ElementIsWriteOnly),
            "cmi.core.session_time" => Err(Scorm12Error::ElementIsWriteOnly),
            "cmi.core._children" => Ok("student_id,student_name,lesson_location,credit,lesson_status,entry,score,total_time,lesson_mode,exit,session_time".to_string()),

            // Suspend data
            "cmi.suspend_data" => Ok(cmi.suspend_data.data.clone().unwrap_or_default()),

            // Launch data (read-only)
            "cmi.launch_data" => Ok(cmi.launch_data.data.clone().unwrap_or_default()),

            // Comments
            "cmi.comments" => Ok(cmi.comments.content.clone().unwrap_or_default()),
            "cmi.comments_from_lms" => Ok(cmi.comments_from_lms.content.clone().unwrap_or_default()),

            // Objectives
            "cmi.objectives._count" => Ok(cmi.objectives.len().to_string()),
            "cmi.objectives._children" => Ok("id,score,status".to_string()),

            // Interactions
            "cmi.interactions._count" => Ok(cmi.interactions.len().to_string()),
            "cmi.interactions._children" => Ok("id,objectives,time,type,correct_responses,weighting,student_response,result,latency".to_string()),

            // Student data (read-only)
            "cmi.student_data.mastery_score" => Ok(cmi.student_data.mastery_score.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.student_data.max_time_allowed" => Ok(cmi.student_data.max_time_allowed.clone().unwrap_or_default()),
            "cmi.student_data.time_limit_action" => Ok(cmi.student_data.time_limit_action.to_string()),
            "cmi.student_data._children" => Ok("mastery_score,max_time_allowed,time_limit_action".to_string()),

            // Student preference
            "cmi.student_preference.audio" => Ok(cmi.student_preference.audio.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.student_preference.language" => Ok(cmi.student_preference.language.clone().unwrap_or_default()),
            "cmi.student_preference.speed" => Ok(cmi.student_preference.speed.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.student_preference.text" => Ok(cmi.student_preference.text.map(|v| v.to_string()).unwrap_or_default()),
            "cmi.student_preference._children" => Ok("audio,language,speed,text".to_string()),

            // Version
            "cmi._version" => Ok("3.4".to_string()),
            "cmi._children" => Ok("core,suspend_data,launch_data,comments,comments_from_lms,objectives,student_data,student_preference,interactions".to_string()),

            _ => {
                // Handle indexed elements (objectives.n.*, interactions.n.*)
                if element.starts_with("cmi.objectives.") {
                    return self.get_objective_value(cmi, element)
                }
                if element.starts_with("cmi.interactions.") {
                    return self.get_interaction_value(cmi, element)
                }
                Err(Scorm12Error::NotImplementedError)
            }
        }
    }

    /// Get objective value by indexed path
    fn get_objective_value(&self, cmi: &CmiDataModel, element: &str) -> Result<String, Scorm12Error> {
        // Parse cmi.objectives.n.element
        let parts: List<&str> = element.split('.').collect();
        if parts.len() < 4 {
            return Err(Scorm12Error::InvalidArgumentError)
        }

        let index: usize = parts[2].parse().map_err(|_| Scorm12Error::InvalidArgumentError)?;
        if index >= cmi.objectives.len() {
            return Err(Scorm12Error::InvalidArgumentError)
        }

        let objective = &cmi.objectives[index];
        match parts[3] {
            "id" => Ok(objective.id.clone()),
            "score" if parts.len() > 4 => match parts[4] {
                "raw" => Ok(objective.score.raw.map(|v| v.to_string()).unwrap_or_default()),
                "min" => Ok(objective.score.min.map(|v| v.to_string()).unwrap_or_default()),
                "max" => Ok(objective.score.max.map(|v| v.to_string()).unwrap_or_default()),
                "_children" => Ok("raw,min,max".to_string()),
                _ => Err(Scorm12Error::InvalidArgumentError)
            },
            "status" => Ok(objective.status.to_string()),
            _ => Err(Scorm12Error::InvalidArgumentError)
        }
    }

    /// Get interaction value by indexed path
    fn get_interaction_value(&self, cmi: &CmiDataModel, element: &str) -> Result<String, Scorm12Error> {
        let parts: List<&str> = element.split('.').collect();
        if parts.len() < 4 {
            return Err(Scorm12Error::InvalidArgumentError)
        }

        let index: usize = parts[2].parse().map_err(|_| Scorm12Error::InvalidArgumentError)?;
        if index >= cmi.interactions.len() {
            return Err(Scorm12Error::InvalidArgumentError)
        }

        let interaction = &cmi.interactions[index];
        match parts[3] {
            "id" => Err(Scorm12Error::ElementIsWriteOnly),
            "objectives" if parts.len() > 4 => {
                if parts[4] == "_count" {
                    Ok(interaction.objectives.len().to_string())
                } else {
                    Err(Scorm12Error::ElementIsWriteOnly)
                }
            },
            "time" => Err(Scorm12Error::ElementIsWriteOnly),
            "type" => Err(Scorm12Error::ElementIsWriteOnly),
            "correct_responses" if parts.len() > 4 => {
                if parts[4] == "_count" {
                    Ok(interaction.correct_responses.len().to_string())
                } else {
                    Err(Scorm12Error::ElementIsWriteOnly)
                }
            },
            "weighting" => Err(Scorm12Error::ElementIsWriteOnly),
            "student_response" => Err(Scorm12Error::ElementIsWriteOnly),
            "result" => Err(Scorm12Error::ElementIsWriteOnly),
            "latency" => Err(Scorm12Error::ElementIsWriteOnly),
            _ => Err(Scorm12Error::InvalidArgumentError)
        }
    }

    /// Set CMI value by element path
    fn set_cmi_value(&self, cmi: &mut CmiDataModel, element: &str, value: &str) -> Result<(), Scorm12Error> {
        match element {
            // Read-only core elements
            "cmi.core.student_id" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.core.student_name" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.core.credit" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.core.entry" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.core.total_time" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.core.lesson_mode" => Err(Scorm12Error::ElementIsReadOnly),

            // Writable core elements
            "cmi.core.lesson_location" => {
                if value.len() > 255 {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.core.lesson_location = Some(value.to_string());
                Ok(())
            },
            "cmi.core.lesson_status" => {
                cmi.core.lesson_status = CmiLessonStatus::from_string(value)
                    .ok_or(Scorm12Error::IncorrectDataType)?;
                Ok(())
            },
            "cmi.core.score.raw" => {
                cmi.core.score.raw = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                Ok(())
            },
            "cmi.core.score.min" => {
                cmi.core.score.min = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                Ok(())
            },
            "cmi.core.score.max" => {
                cmi.core.score.max = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                Ok(())
            },
            "cmi.core.exit" => {
                cmi.core.exit = CmiExit::from_string(value);
                Ok(())
            },
            "cmi.core.session_time" => {
                // Validate timespan format
                if parse_timespan(value).is_none() {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.core.session_time = Some(value.to_string());
                Ok(())
            },

            // Suspend data
            "cmi.suspend_data" => {
                if value.len() > 4096 {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.suspend_data.data = Some(value.to_string());
                Ok(())
            },

            // Launch data (read-only)
            "cmi.launch_data" => Err(Scorm12Error::ElementIsReadOnly),

            // Comments
            "cmi.comments" => {
                cmi.comments.content = Some(value.to_string());
                Ok(())
            },
            "cmi.comments_from_lms" => Err(Scorm12Error::ElementIsReadOnly),

            // Student data (read-only)
            "cmi.student_data.mastery_score" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.student_data.max_time_allowed" => Err(Scorm12Error::ElementIsReadOnly),
            "cmi.student_data.time_limit_action" => Err(Scorm12Error::ElementIsReadOnly),

            // Student preference
            "cmi.student_preference.audio" => {
                let vol: i32 = value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?;
                if vol < -1 || vol > 100 {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.student_preference.audio = Some(vol);
                Ok(())
            },
            "cmi.student_preference.language" => {
                if value.len() > 255 {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.student_preference.language = Some(value.to_string());
                Ok(())
            },
            "cmi.student_preference.speed" => {
                let speed: i32 = value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?;
                if speed < -100 || speed > 100 {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.student_preference.speed = Some(speed);
                Ok(())
            },
            "cmi.student_preference.text" => {
                let text: i32 = value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?;
                if text < -1 || text > 1 {
                    return Err(Scorm12Error::IncorrectDataType)
                }
                cmi.student_preference.text = Some(text);
                Ok(())
            },

            // Keywords
            "cmi._version" => Err(Scorm12Error::InvalidSetValueKeyword),
            "cmi._children" => Err(Scorm12Error::InvalidSetValueKeyword),
            "cmi.core._children" => Err(Scorm12Error::InvalidSetValueKeyword),
            "cmi.core.score._children" => Err(Scorm12Error::InvalidSetValueKeyword),

            _ => {
                // Handle indexed elements
                if element.starts_with("cmi.objectives.") {
                    return self.set_objective_value(cmi, element, value)
                }
                if element.starts_with("cmi.interactions.") {
                    return self.set_interaction_value(cmi, element, value)
                }
                Err(Scorm12Error::NotImplementedError)
            }
        }
    }

    /// Set objective value by indexed path
    fn set_objective_value(&self, cmi: &mut CmiDataModel, element: &str, value: &str) -> Result<(), Scorm12Error> {
        let parts: List<&str> = element.split('.').collect();
        if parts.len() < 4 {
            return Err(Scorm12Error::InvalidArgumentError)
        }

        let index: usize = parts[2].parse().map_err(|_| Scorm12Error::InvalidArgumentError)?;

        // Auto-expand objectives array if needed
        while cmi.objectives.len() <= index {
            cmi.objectives.push(CmiObjective::new(format!("obj_{}", cmi.objectives.len())));
        }

        let objective = &mut cmi.objectives[index];
        match parts[3] {
            "id" => {
                objective.id = value.to_string();
                Ok(())
            },
            "score" if parts.len() > 4 => match parts[4] {
                "raw" => {
                    objective.score.raw = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                    Ok(())
                },
                "min" => {
                    objective.score.min = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                    Ok(())
                },
                "max" => {
                    objective.score.max = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                    Ok(())
                },
                _ => Err(Scorm12Error::InvalidArgumentError)
            },
            "status" => {
                objective.status = CmiObjectiveStatus::from_string(value)
                    .ok_or(Scorm12Error::IncorrectDataType)?;
                Ok(())
            },
            _ => Err(Scorm12Error::InvalidArgumentError)
        }
    }

    /// Set interaction value by indexed path
    fn set_interaction_value(&self, cmi: &mut CmiDataModel, element: &str, value: &str) -> Result<(), Scorm12Error> {
        let parts: List<&str> = element.split('.').collect();
        if parts.len() < 4 {
            return Err(Scorm12Error::InvalidArgumentError)
        }

        let index: usize = parts[2].parse().map_err(|_| Scorm12Error::InvalidArgumentError)?;

        // Auto-expand interactions array if needed
        while cmi.interactions.len() <= index {
            cmi.interactions.push(CmiInteraction::new(format!("int_{}", cmi.interactions.len())));
        }

        let interaction = &mut cmi.interactions[index];
        match parts[3] {
            "id" => {
                interaction.id = value.to_string();
                Ok(())
            },
            "objectives" if parts.len() > 4 => {
                let obj_index: usize = parts[4].parse().map_err(|_| Scorm12Error::InvalidArgumentError)?;
                if parts.len() > 5 && parts[5] == "id" {
                    while interaction.objectives.len() <= obj_index {
                        interaction.objectives.push(String::new());
                    }
                    interaction.objectives[obj_index] = value.to_string();
                    Ok(())
                } else {
                    Err(Scorm12Error::InvalidArgumentError)
                }
            },
            "time" => {
                interaction.time = Some(value.to_string());
                Ok(())
            },
            "type" => {
                interaction.interaction_type = CmiInteractionType::from_string(value)
                    .ok_or(Scorm12Error::IncorrectDataType)?;
                Ok(())
            },
            "correct_responses" if parts.len() > 4 => {
                let cr_index: usize = parts[4].parse().map_err(|_| Scorm12Error::InvalidArgumentError)?;
                if parts.len() > 5 && parts[5] == "pattern" {
                    while interaction.correct_responses.len() <= cr_index {
                        interaction.correct_responses.push(String::new());
                    }
                    interaction.correct_responses[cr_index] = value.to_string();
                    Ok(())
                } else {
                    Err(Scorm12Error::InvalidArgumentError)
                }
            },
            "weighting" => {
                interaction.weighting = Some(value.parse().map_err(|_| Scorm12Error::IncorrectDataType)?);
                Ok(())
            },
            "student_response" => {
                interaction.student_response = Some(value.to_string());
                Ok(())
            },
            "result" => {
                interaction.result = CmiInteractionResult::from_string(value);
                Ok(())
            },
            "latency" => {
                interaction.latency = Some(value.to_string());
                Ok(())
            },
            _ => Err(Scorm12Error::InvalidArgumentError)
        }
    }

    /// Persist session data to storage
    fn persist_session(&mut self, session_id: &Scorm12SessionId) -> Result<(), String> {
        let session = self.state.sessions.get(session_id)
            .ok_or("Session not found")?;

        let persist_key = format!("{}_{}", session.user_id, session.sco_id);
        self.state.persisted_data.insert(persist_key, session.cmi.clone());

        Ok(())
    }
}

