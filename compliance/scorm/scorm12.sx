/// A learning objective tracked by the SCO
type CmiObjective {
    /// Unique identifier for this objective
    id: ObjectiveId,

    /// Score achieved on this objective
    score: CmiScore,

    /// Status of this objective
    status: CmiObjectiveStatus
}

/// Objective status
enum CmiObjectiveStatus {
    Passed,
    Completed,
    Failed,
    Incomplete,
    Browsed,
    NotAttempted
}

impl CmiObjectiveStatus {
    fn to_string(&self) -> String {
        match self {
            CmiObjectiveStatus::Passed => "passed".to_string(),
            CmiObjectiveStatus::Completed => "completed".to_string(),
            CmiObjectiveStatus::Failed => "failed".to_string(),
            CmiObjectiveStatus::Incomplete => "incomplete".to_string(),
            CmiObjectiveStatus::Browsed => "browsed".to_string(),
            CmiObjectiveStatus::NotAttempted => "not attempted".to_string()
        }
    }

    fn from_string(s: &str) -> Option<CmiObjectiveStatus> {
        match s {
            "passed" => Some(CmiObjectiveStatus::Passed),
            "completed" => Some(CmiObjectiveStatus::Completed),
            "failed" => Some(CmiObjectiveStatus::Failed),
            "incomplete" => Some(CmiObjectiveStatus::Incomplete),
            "browsed" => Some(CmiObjectiveStatus::Browsed),
            "not attempted" => Some(CmiObjectiveStatus::NotAttempted),
            _ => None
        }
    }
}

impl CmiObjective {
    fn new(id: ObjectiveId) -> CmiObjective {
        CmiObjective {
