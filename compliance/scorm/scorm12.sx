/// Intelligo LMS - SCORM 1.2 Runtime
///
/// This module implements the SCORM 1.2 Run-Time Environment (RTE),
/// including the CMI data model, API functions, and session management.
/// Based on SCORM 1.2 Runtime Environment specification (ADL).

module intelligo::compliance::scorm::scorm12

use intelligo::core::types::*
use std::time::{DateTime, Duration, Instant}
use std::collections::{Map, Set, List}

// =============================================================================
// SCORM 1.2 IDENTITY TYPES
// =============================================================================

/// Unique identifier for a SCORM 1.2 session
type Scorm12SessionId = String

/// Unique identifier for a CMI data record
type CmiDataId = String

/// Unique identifier for an objective
type ObjectiveId = String

/// Unique identifier for an interaction
type InteractionId = String

// =============================================================================
// SCORM 1.2 ERROR CODES
// =============================================================================

/// SCORM 1.2 Error Codes (per specification)
enum Scorm12Error {
    /// No error
    NoError,                        // 0
    /// General exception
    GeneralException,               // 101
    /// Invalid argument error
    InvalidArgumentError,           // 201
    /// Element cannot have children
    ElementCannotHaveChildren,      // 202
    /// Element not an array - cannot have count
    ElementNotAnArray,              // 203
    /// Not initialized
    NotInitialized,                 // 301
    /// Not implemented error
    NotImplementedError,            // 401
    /// Invalid set value, element is a keyword
    InvalidSetValueKeyword,         // 402
    /// Element is read only
    ElementIsReadOnly,              // 403
    /// Element is write only
    ElementIsWriteOnly,             // 404
    /// Incorrect data type
    IncorrectDataType               // 405
}

impl Scorm12Error {
    /// Get the numeric error code
    fn code(&self) -> String {
        match self {
            Scorm12Error::NoError => "0".to_string(),
            Scorm12Error::GeneralException => "101".to_string(),
            Scorm12Error::InvalidArgumentError => "201".to_string(),
            Scorm12Error::ElementCannotHaveChildren => "202".to_string(),
            Scorm12Error::ElementNotAnArray => "203".to_string(),
            Scorm12Error::NotInitialized => "301".to_string(),
            Scorm12Error::NotImplementedError => "401".to_string(),
            Scorm12Error::InvalidSetValueKeyword => "402".to_string(),
            Scorm12Error::ElementIsReadOnly => "403".to_string(),
            Scorm12Error::ElementIsWriteOnly => "404".to_string(),
            Scorm12Error::IncorrectDataType => "405".to_string()
        }
    }

    /// Get error description
    fn description(&self) -> String {
        match self {
            Scorm12Error::NoError => "No error".to_string(),
            Scorm12Error::GeneralException => "General Exception".to_string(),
            Scorm12Error::InvalidArgumentError => "Invalid argument error".to_string(),
            Scorm12Error::ElementCannotHaveChildren => "Element cannot have children".to_string(),
            Scorm12Error::ElementNotAnArray => "Element not an array - cannot have count".to_string(),
            Scorm12Error::NotInitialized => "Not initialized".to_string(),
            Scorm12Error::NotImplementedError => "Not implemented error".to_string(),
            Scorm12Error::InvalidSetValueKeyword => "Invalid set value, element is a keyword".to_string(),
            Scorm12Error::ElementIsReadOnly => "Element is read only".to_string(),
            Scorm12Error::ElementIsWriteOnly => "Element is write only".to_string(),
            Scorm12Error::IncorrectDataType => "Incorrect Data Type".to_string()
        }
    }

    /// Get diagnostic message for extended error info
    fn diagnostic(&self, element: Option<String>) -> String {
        match element {
            Some(el) => format!("{} - Element: {}", self.description(), el),
            None => self.description()
        }
    }
}

// =============================================================================
// SCORM 1.2 CMI DATA MODEL - CORE
// =============================================================================

/// CMI Core data model element
type CmiCore {
    /// Identifies the learner (read-only, LMS provided)
    student_id: String,

    /// Name of the learner (read-only, LMS provided)
    student_name: String,

    /// Indicates learner's location in the SCO (read/write)
    lesson_location: Option<String>,

    /// Current learner credit mode (read-only)
    credit: CmiCredit,

    /// Current completion status of the SCO
    lesson_status: CmiLessonStatus,

    /// Asserted by SCO if passed/failed is determined
    entry: CmiEntry,

    /// Cumulative score for the SCO
    score: CmiScore,

    /// Total time in this attempt
    total_time: Option<String>,

    /// Current session time
    session_time: Option<String>,

    /// SCO can request exit behavior
    exit: CmiExit,

    /// Indicates how learner left SCO last time
    lesson_mode: CmiLessonMode
}

/// Credit mode
enum CmiCredit {
    Credit,
    NoCredit
}

impl CmiCredit {
    fn to_string(&self) -> String {
        match self {
            CmiCredit::Credit => "credit".to_string(),
            CmiCredit::NoCredit => "no-credit".to_string()
        }
    }

    fn from_string(s: &str) -> Option<CmiCredit> {
        match s {
            "credit" => Some(CmiCredit::Credit),
            "no-credit" => Some(CmiCredit::NoCredit),
            _ => None
        }
    }
}

/// Lesson status
enum CmiLessonStatus {
    Passed,
    Completed,
    Failed,
    Incomplete,
    Browsed,
    NotAttempted
}

impl CmiLessonStatus {
    fn to_string(&self) -> String {
        match self {
            CmiLessonStatus::Passed => "passed".to_string(),
            CmiLessonStatus::Completed => "completed".to_string(),
            CmiLessonStatus::Failed => "failed".to_string(),
            CmiLessonStatus::Incomplete => "incomplete".to_string(),
            CmiLessonStatus::Browsed => "browsed".to_string(),
            CmiLessonStatus::NotAttempted => "not attempted".to_string()
        }
    }

    fn from_string(s: &str) -> Option<CmiLessonStatus> {
        match s {
            "passed" => Some(CmiLessonStatus::Passed),
            "completed" => Some(CmiLessonStatus::Completed),
            "failed" => Some(CmiLessonStatus::Failed),
            "incomplete" => Some(CmiLessonStatus::Incomplete),
            "browsed" => Some(CmiLessonStatus::Browsed),
            "not attempted" => Some(CmiLessonStatus::NotAttempted),
            _ => None
        }
    }

    /// Check if this is a completion status
    fn is_complete(&self) -> Bool {
        matches!(self, CmiLessonStatus::Passed | CmiLessonStatus::Completed | CmiLessonStatus::Failed)
    }

    /// Check if this indicates success
    fn is_successful(&self) -> Bool {
        matches!(self, CmiLessonStatus::Passed | CmiLessonStatus::Completed)
    }
}

/// Entry state
enum CmiEntry {
    AbInitio,
    Resume,
    Empty
}

impl CmiEntry {
    fn to_string(&self) -> String {
        match self {
            CmiEntry::AbInitio => "ab-initio".to_string(),
            CmiEntry::Resume => "resume".to_string(),
            CmiEntry::Empty => "".to_string()
        }
    }

    fn from_string(s: &str) -> CmiEntry {
        match s {
            "ab-initio" => CmiEntry::AbInitio,
            "resume" => CmiEntry::Resume,
            _ => CmiEntry::Empty
        }
    }
}

/// Exit state (write-only)
enum CmiExit {
    TimeOut,
    Suspend,
    Logout,
    Empty
}

impl CmiExit {
    fn to_string(&self) -> String {
        match self {
            CmiExit::TimeOut => "time-out".to_string(),
            CmiExit::Suspend => "suspend".to_string(),
            CmiExit::Logout => "logout".to_string(),
            CmiExit::Empty => "".to_string()
        }
    }

    fn from_string(s: &str) -> CmiExit {
        match s {
            "time-out" => CmiExit::TimeOut,
            "suspend" => CmiExit::Suspend,
            "logout" => CmiExit::Logout,
