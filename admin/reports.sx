}

/// Cached report
type CachedReport {
    result: ReportResult,
    expires_at: DateTime
}

/// Report job
type ReportJob {
    id: String,
    request: ReportRequest,
    status: JobStatus,
    started_at: DateTime,
    completed_at: Option<DateTime>,
    error: Option<String>
}

/// Job status
enum JobStatus {
    Pending,
    Running,
    Completed,
    Failed
}

/// Exported report
type ExportedReport {
    filename: String,
    content_type: String,
    data: List<u8>
}
