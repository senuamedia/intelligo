/// Scheduled report configuration
type ScheduledReport {
    id: String,
    tenant_id: TenantId,
    report_id: String,
    name: String,
    description: Option<String>,
    schedule: ReportSchedule,
    filters: Map<String, Dynamic>,
    columns: List<String>,
    export_format: ExportFormat,
    recipients: List<ReportRecipient>,
    enabled: Bool,
    last_run: Option<DateTime>,
    next_run: DateTime,
    created_by: UserId,
    created_at: DateTime
}

/// Report schedule
type ReportSchedule {
    frequency: ScheduleFrequency,
    day_of_week: Option<i32>,
