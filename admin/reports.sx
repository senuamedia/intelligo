/// Intelligo LMS - Reports & Analytics
///
/// Comprehensive reporting and analytics for learning data,
/// including enrollment, completion, grades, activity, and SCORM/xAPI reports.

module intelligo::admin::reports

use intelligo::core::types::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// REPORT DEFINITIONS
// =============================================================================

/// A report definition
type ReportDefinition {
    /// Report ID
    id: String,

    /// Report name
    name: String,

    /// Description
    description: String,

    /// Report category
    category: ReportCategory,

    /// Available columns
    columns: List<ReportColumn>,

    /// Default columns
    default_columns: List<String>,

    /// Available filters
    filters: List<ReportFilter>,

    /// Supported export formats
    export_formats: List<ExportFormat>,

    /// Required permission
    permission: PermissionId,

    /// Whether scheduled reports are supported
    schedulable: Bool
}

/// Report category
enum ReportCategory {
    Enrollment,
    Completion,
    Grades,
    Activity,
    Compliance,
    Revenue,
    User,
    System
}

/// Report column definition
type ReportColumn {
    /// Column ID
    id: String,

    /// Display label
    label: String,

    /// Data type
    data_type: ColumnDataType,

    /// Sortable
    sortable: Bool,

    /// Aggregatable (for summaries)
    aggregatable: Bool,

    /// Format string
    format: Option<String>
}

/// Column data type
enum ColumnDataType {
    Text,
    Number,
    Percentage,
    Currency,
    Date,
    DateTime,
    Duration,
    Boolean,
    Status
}

/// Report filter
type ReportFilter {
    /// Filter ID
    id: String,

    /// Display label
    label: String,

    /// Filter type
    filter_type: FilterType,

    /// Options (for select types)
    options: Option<List<FilterOption>>,

    /// Default value
    default_value: Option<Dynamic>
}

/// Filter type
enum FilterType {
    Text,
    Select,
    MultiSelect,
    DateRange,
    NumberRange,
    Boolean,
    Course,
    User,
    Assessment
}

/// Filter option
type FilterOption {
    value: String,
    label: String
}

/// Export format
enum ExportFormat {
    Csv,
    Excel,
    Pdf,
    Json
}

// =============================================================================
// REPORT EXECUTION
// =============================================================================

/// Report execution request
type ReportRequest {
    /// Report ID
    report_id: String,

    /// Tenant
    tenant_id: TenantId,

    /// Selected columns
    columns: List<String>,

    /// Filter values
    filters: Map<String, Dynamic>,

    /// Sort configuration
    sort: Option<ReportSort>,

    /// Pagination
    pagination: Pagination,

    /// Date range
    date_range: Option<DateRange>,

    /// Group by columns
    group_by: Option<List<String>>
}

/// Report sort configuration
type ReportSort {
    column: String,
    direction: SortOrder
}

/// Report execution result
type ReportResult {
    /// Report metadata
    report: ReportDefinition,

    /// Executed at
    executed_at: DateTime,

    /// Data rows
    rows: List<Map<String, Dynamic>>,

    /// Summary row (if grouped/aggregated)
    summary: Option<Map<String, Dynamic>>,

    /// Total row count (before pagination)
    total_count: i64,

    /// Execution time in ms
    execution_time_ms: i64,

    /// Pagination info
    pagination: PaginationInfo
}

/// Pagination info
type PaginationInfo {
    page: i32,
    per_page: i32,
    total_pages: i32,
    has_more: Bool
}

