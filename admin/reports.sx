    delivery_method: DeliveryMethod
}

/// Delivery method
enum DeliveryMethod {
    Email,
    Download,
    Webhook
}

// =============================================================================
// REPORTS ACTOR
// =============================================================================

/// Reports actor for generating and managing reports
actor ReportsActor {
    state {
        /// Report definitions
        definitions: Map<String, ReportDefinition>,

        /// Scheduled reports
        scheduled: Map<String, ScheduledReport>,

        /// Report cache
        cache: Map<String, CachedReport>,

        /// Running report jobs
        running_jobs: Map<String, ReportJob>
    }

    /// Initialize reports actor
    fn init() -> ReportsActor {
        let definitions = Self::build_report_definitions();

        ReportsActor {
            state: ReportsActorState {
                definitions,
                scheduled: Map::new(),
                cache: Map::new(),
                running_jobs: Map::new()
            }
        }
    }

    /// Get all report definitions
    fn get_definitions(&self, context: &AccessContext) -> List<ReportDefinition> {
        self.state.definitions.values()
            .filter(|d| context.has_permission(&d.permission))
            .cloned()
            .collect()
    }

    /// Get report definition by ID
    fn get_definition(&self, report_id: &str) -> Option<ReportDefinition> {
        self.state.definitions.get(report_id).cloned()
    }

    /// Execute a report
    fn execute(&self, request: ReportRequest) -> Result<ReportResult, LmsError> {
        let start_time = std::time::Instant::now();

        // Get report definition
        let report = self.get_definition(&request.report_id)
            .ok_or_else(|| LmsError::NotFound {
                entity_type: "Report".to_string(),
                id: request.report_id.clone()
            })?;

        // Execute based on report type
        let (rows, total_count, summary) = match request.report_id.as_str() {
            "enrollment_report" => self.execute_enrollment_report(&request),
            "completion_report" => self.execute_completion_report(&request),
            "grade_report" => self.execute_grade_report(&request),
            "activity_log" => self.execute_activity_report(&request),
            "scorm_report" => self.execute_scorm_report(&request),
            "xapi_report" => self.execute_xapi_report(&request),
            "revenue_report" => self.execute_revenue_report(&request),
            _ => (vec![], 0, None)
        };

        let execution_time = start_time.elapsed().as_millis() as i64;
        let total_pages = ((total_count as f32) / (request.pagination.per_page as f32)).ceil() as i32;

        Ok(ReportResult {
            report,
            executed_at: DateTime::now(),
            rows,
            summary,
            total_count,
            execution_time_ms: execution_time,
            pagination: PaginationInfo {
                page: request.pagination.page,
                per_page: request.pagination.per_page,
                total_pages,
                has_more: request.pagination.page < total_pages
            }
        })
    }

    /// Execute enrollment report
    fn execute_enrollment_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        // Would query enrollment data from database
        (vec![], 0, None)
    }

    /// Execute completion report
    fn execute_completion_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        (vec![], 0, None)
    }

    /// Execute grade report
    fn execute_grade_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        (vec![], 0, None)
    }

    /// Execute activity report
    fn execute_activity_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        (vec![], 0, None)
    }

    /// Execute SCORM report
    fn execute_scorm_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        (vec![], 0, None)
    }

    /// Execute xAPI report
    fn execute_xapi_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        (vec![], 0, None)
    }

    /// Execute revenue report
    fn execute_revenue_report(&self, request: &ReportRequest) -> (List<Map<String, Dynamic>>, i64, Option<Map<String, Dynamic>>) {
        (vec![], 0, None)
    }

    /// Export report
    fn export(&self, request: ReportRequest, format: ExportFormat) -> Result<ExportedReport, LmsError> {
        let result = self.execute(request)?;

        match format {
            ExportFormat::Csv => self.export_csv(&result),
            ExportFormat::Excel => self.export_excel(&result),
            ExportFormat::Pdf => self.export_pdf(&result),
            ExportFormat::Json => self.export_json(&result)
        }
    }

    /// Export to CSV
    fn export_csv(&self, result: &ReportResult) -> Result<ExportedReport, LmsError> {
        // Generate CSV content
        Ok(ExportedReport {
            filename: format!("{}-{}.csv", result.report.id, DateTime::now().format("%Y%m%d")),
            content_type: "text/csv".to_string(),
            data: vec![]
        })
    }

    /// Export to Excel
    fn export_excel(&self, result: &ReportResult) -> Result<ExportedReport, LmsError> {
        Ok(ExportedReport {
            filename: format!("{}-{}.xlsx", result.report.id, DateTime::now().format("%Y%m%d")),
            content_type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet".to_string(),
            data: vec![]
        })
    }

    /// Export to PDF
    fn export_pdf(&self, result: &ReportResult) -> Result<ExportedReport, LmsError> {
        Ok(ExportedReport {
            filename: format!("{}-{}.pdf", result.report.id, DateTime::now().format("%Y%m%d")),
            content_type: "application/pdf".to_string(),
            data: vec![]
        })
    }

    /// Export to JSON
    fn export_json(&self, result: &ReportResult) -> Result<ExportedReport, LmsError> {
        Ok(ExportedReport {
            filename: format!("{}-{}.json", result.report.id, DateTime::now().format("%Y%m%d")),
            content_type: "application/json".to_string(),
            data: vec![]
        })
    }

    /// Schedule a report
    fn schedule(&mut self, config: ScheduledReport) -> Result<ScheduledReport, LmsError> {
        let id = config.id.clone();
        self.state.scheduled.insert(id.clone(), config.clone());
        Ok(config)
    }

    /// Update scheduled report
    fn update_schedule(&mut self, id: &str, config: ScheduledReport) -> Result<ScheduledReport, LmsError> {
        if !self.state.scheduled.contains_key(id) {
            return Err(LmsError::NotFound {
                entity_type: "ScheduledReport".to_string(),
                id: id.to_string()
            })
        }

        self.state.scheduled.insert(id.to_string(), config.clone());
        Ok(config)
    }

    /// Delete scheduled report
    fn delete_schedule(&mut self, id: &str) -> Result<(), LmsError> {
        self.state.scheduled.remove(id);
        Ok(())
    }

    /// Get scheduled reports for tenant
    fn get_scheduled(&self, tenant_id: &TenantId) -> List<ScheduledReport> {
        self.state.scheduled.values()
            .filter(|s| &s.tenant_id == tenant_id)
            .cloned()
            .collect()
    }

    /// Build report definitions
    fn build_report_definitions() -> Map<String, ReportDefinition> {
        let mut definitions = Map::new();

        // Enrollment Report
        definitions.insert("enrollment_report".to_string(), ReportDefinition {
            id: "enrollment_report".to_string(),
            name: "Enrollment Report".to_string(),
            description: "Detailed enrollment data with progress and completion status".to_string(),
            category: ReportCategory::Enrollment,
            columns: vec![
                ReportColumn { id: "user_name".to_string(), label: "Student Name".to_string(), data_type: ColumnDataType::Text, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "user_email".to_string(), label: "Email".to_string(), data_type: ColumnDataType::Text, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "course_title".to_string(), label: "Course".to_string(), data_type: ColumnDataType::Text, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "enrolled_at".to_string(), label: "Enrolled".to_string(), data_type: ColumnDataType::DateTime, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "status".to_string(), label: "Status".to_string(), data_type: ColumnDataType::Status, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "progress_percent".to_string(), label: "Progress".to_string(), data_type: ColumnDataType::Percentage, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "completed_at".to_string(), label: "Completed".to_string(), data_type: ColumnDataType::DateTime, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "grade".to_string(), label: "Grade".to_string(), data_type: ColumnDataType::Text, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "time_spent_minutes".to_string(), label: "Time Spent".to_string(), data_type: ColumnDataType::Duration, sortable: true, aggregatable: true, format: None }
            ],
            default_columns: vec!["user_name".to_string(), "course_title".to_string(), "enrolled_at".to_string(), "status".to_string(), "progress_percent".to_string()],
            filters: vec![
                ReportFilter { id: "course".to_string(), label: "Course".to_string(), filter_type: FilterType::Course, options: None, default_value: None },
                ReportFilter { id: "status".to_string(), label: "Status".to_string(), filter_type: FilterType::MultiSelect, options: Some(vec![
                    FilterOption { value: "active".to_string(), label: "Active".to_string() },
                    FilterOption { value: "completed".to_string(), label: "Completed".to_string() },
                    FilterOption { value: "withdrawn".to_string(), label: "Withdrawn".to_string() }
                ]), default_value: None },
                ReportFilter { id: "date_range".to_string(), label: "Enrolled Between".to_string(), filter_type: FilterType::DateRange, options: None, default_value: None }
            ],
            export_formats: vec![ExportFormat::Csv, ExportFormat::Excel, ExportFormat::Pdf],
            permission: "admin.reports.enrollment".to_string(),
            schedulable: true
        });

        // Completion Report
        definitions.insert("completion_report".to_string(), ReportDefinition {
            id: "completion_report".to_string(),
            name: "Completion Report".to_string(),
            description: "Course and module completion rates and statistics".to_string(),
            category: ReportCategory::Completion,
            columns: vec![
                ReportColumn { id: "course_title".to_string(), label: "Course".to_string(), data_type: ColumnDataType::Text, sortable: true, aggregatable: false, format: None },
                ReportColumn { id: "total_enrollments".to_string(), label: "Total Enrolled".to_string(), data_type: ColumnDataType::Number, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "not_started".to_string(), label: "Not Started".to_string(), data_type: ColumnDataType::Number, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "in_progress".to_string(), label: "In Progress".to_string(), data_type: ColumnDataType::Number, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "completed".to_string(), label: "Completed".to_string(), data_type: ColumnDataType::Number, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "completion_rate".to_string(), label: "Completion Rate".to_string(), data_type: ColumnDataType::Percentage, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "avg_completion_days".to_string(), label: "Avg Days to Complete".to_string(), data_type: ColumnDataType::Number, sortable: true, aggregatable: true, format: None },
                ReportColumn { id: "avg_score".to_string(), label: "Avg Score".to_string(), data_type: ColumnDataType::Percentage, sortable: true, aggregatable: true, format: None }
            ],
            default_columns: vec!["course_title".to_string(), "total_enrollments".to_string(), "completed".to_string(), "completion_rate".to_string()],
            filters: vec![
