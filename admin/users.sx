    fn get_role_permissions(self, role: &UserRole) -> Result<Vec<Permission>, UserError> {
        // Return default permissions based on role
        let permissions = match role {
            UserRole::Admin => vec![
                Permission::ManageUsers,
                Permission::ManageCourses,
                Permission::ManageEnrollments,
                Permission::ViewReports,
            ],
            UserRole::Instructor => vec![
                Permission::CreateCourses,
                Permission::ManageOwnCourses,
                Permission::GradeAssessments,
            ],
            UserRole::Learner => vec![
                Permission::ViewCourses,
                Permission::SubmitAssessments,
            ],
            _ => vec![],
        };
        Ok(permissions)
    }

    fn get_group_permissions(self, group_id: &str) -> Result<Vec<Permission>, UserError> {
        // Would query group permissions from database
        Ok(vec![])
    }

    fn parse_csv(self, csv_data: &str) -> Result<Vec<Map<String, String>>, UserError> {
        let mut records = vec![];
        let lines: Vec<&str> = csv_data.lines().collect();

        if lines.is_empty() {
            return Ok(records);
        }

        let headers: Vec<&str> = lines[0].split(',').map(|s| s.trim()).collect();

        for line in &lines[1..] {
            let values: Vec<&str> = line.split(',').map(|s| s.trim()).collect();
            let mut record = Map::new();

            for (i, header) in headers.iter().enumerate() {
                if i < values.len() {
                    record.insert(header.to_string(), values[i].to_string());
                }
            }
            records.push(record);
        }

        Ok(records)
    }

    fn csv_record_to_create_request(self, record: &Map<String, String>, options: &ImportOptions) -> Result<CreateUserRequest, UserError> {
        let email = record.get("email").ok_or(
            UserError::ValidationError("Email is required".to_string())
        )?;

        Ok(CreateUserRequest {
            email: email.clone(),
            username: record.get("username").cloned(),
            password: None,
            first_name: record.get("first_name").cloned(),
            last_name: record.get("last_name").cloned(),
            display_name: record.get("display_name").cloned(),
            role: options.default_role.clone(),
            groups: options.default_groups.clone(),
            send_welcome_email: options.send_welcome_email,
            metadata: None,
        })
    }

    fn create_request_to_update_request(self, request: &CreateUserRequest) -> UpdateUserRequest {
        UpdateUserRequest {
            username: request.username.clone(),
            first_name: request.first_name.clone(),
            last_name: request.last_name.clone(),
            display_name: request.display_name.clone(),
            role: request.role.clone(),
            metadata: request.metadata.clone(),
        }
    }
}

// ============================================================================
// Types
// ============================================================================

/// User entity
pub type User = type {
    id: String,
    tenant_id: String,
    email: String,
    username: String,
    password_hash: Option<String>,
    first_name: String,
    last_name: String,
    display_name: Option<String>,
    avatar_url: Option<String>,
    role: UserRole,
    status: UserStatus,
    email_verified: bool,
    phone: Option<String>,
    phone_verified: bool,
    timezone: String,
    locale: String,
    metadata: Map<String, String>,
    groups: Vec<String>,
    permissions: Vec<Permission>,
    last_login_at: Option<DateTime>,
    login_count: i32,
    created_at: DateTime,
    updated_at: DateTime,
    created_by: Option<String>,
    deleted_at: Option<DateTime>
}

/// User role
pub enum UserRole {
    SuperAdmin,
    TenantAdmin,
    Instructor,
    TeachingAssistant,
    Learner,
    Observer,
    Guest,
    Custom(String)
}

/// User account status
pub enum UserStatus {
    Pending,
    Active,
    Inactive,
    Suspended,
    Locked,
    Deleted
}

/// Permission definition
pub type Permission = type {
    resource: String,
    action: String,
    conditions: Option<Map<String, String>>
}

/// User group
pub type Group = type {
    id: String,
    tenant_id: String,
    name: String,
    description: Option<String>,
    parent_id: Option<String>,
    permissions: Vec<Permission>,
    metadata: Map<String, String>,
    member_count: i32,
    created_at: DateTime,
    updated_at: DateTime
}

/// Create user request
pub type CreateUserRequest = type {
    email: String,
    username: Option<String>,
    password: Option<String>,
    first_name: String,
    last_name: String,
    display_name: Option<String>,
    avatar_url: Option<String>,
    role: Option<UserRole>,
    phone: Option<String>,
    timezone: Option<String>,
    locale: Option<String>,
    metadata: Option<Map<String, String>>,
    group_ids: Option<Vec<String>>,
    send_welcome_email: Option<bool>,
    created_by: Option<String>
}

/// Update user request
pub type UpdateUserRequest = type {
    email: Option<String>,
    first_name: Option<String>,
    last_name: Option<String>,
    display_name: Option<String>,
    avatar_url: Option<String>,
    role: Option<UserRole>,
    status: Option<UserStatus>,
    phone: Option<String>,
    timezone: Option<String>,
    locale: Option<String>,
    metadata: Option<Map<String, String>>,
    updated_by: Option<String>
}

/// User list query
pub type UserListQuery = type {
    page: Option<i32>,
    page_size: Option<i32>,
    sort_by: Option<String>,
    sort_order: Option<SortOrder>,
    status: Option<UserStatus>,
    role: Option<UserRole>,
    group_id: Option<String>,
    created_after: Option<DateTime>,
    created_before: Option<DateTime>
}

/// User search query
pub type UserSearchQuery = type {
    query: String,
    fields: Option<Vec<String>>,
    limit: Option<i32>
}

/// User search result
pub type UserSearchResult = type {
    user: User,
    score: f64,
    highlights: Map<String, String>
}

/// Password reset token
pub type PasswordResetToken = type {
    token: String,
    user_id: String,
    expires_at: DateTime,
    used: bool
}

/// Import options
pub type ImportOptions = type {
    skip_duplicates: bool,
    update_existing: bool,
    default_role: Option<UserRole>,
    default_groups: Option<Vec<String>>,
    send_welcome_email: bool,
    require_password_change: bool
}

/// Import result
pub type ImportResult = type {
    created: i32,
    updated: i32,
    skipped: i32,
    errors: Vec<ImportError>
}

impl ImportResult {
    pub fn new() -> Self {
        ImportResult { created: 0, updated: 0, skipped: 0, errors: vec![] }
    }

    pub fn add_created(mut self) { self.created += 1; }
    pub fn add_updated(mut self) { self.updated += 1; }
    pub fn add_skipped(mut self, line: usize, reason: &str) { self.skipped += 1; }
    pub fn add_error(mut self, line: usize, message: String) {
        self.errors.push(ImportError { line, message });
    }
}

pub type ImportError = type { line: usize, message: String }

/// Bulk operation result
pub type BulkOperationResult<T> = type {
    successes: Vec<T>,
    failures: Vec<BulkFailure>
}

impl<T> BulkOperationResult<T> {
    pub fn new() -> Self {
        BulkOperationResult { successes: vec![], failures: vec![] }
    }

    pub fn add_success(mut self, item: T) {
        self.successes.push(item);
    }

    pub fn add_failure(mut self, id: String, error: String) {
        self.failures.push(BulkFailure { id, error });
    }

    pub fn success_count(self) -> usize { self.successes.len() }
    pub fn failure_count(self) -> usize { self.failures.len() }
}

pub type BulkFailure = type { id: String, error: String }

/// Paged result
pub type PagedResult<T> = type {
    items: Vec<T>,
    total: i64,
    page: i32,
    page_size: i32,
    total_pages: i32
}

/// Sort order
pub enum SortOrder {
    Ascending,
    Descending
}

/// User errors
pub enum UserError {
    NotFound(String),
    DuplicateEmail(String),
    ValidationError(String),
    WeakPassword(String),
    TokenExpired,
    TokenAlreadyUsed,
    Unauthorized,
    InternalError(String)
}

impl UserError {
    pub fn to_string(self) -> String {
        match self {
            UserError::NotFound(id) => format!("User not found: {}", id),
            UserError::DuplicateEmail(email) => format!("Email already exists: {}", email),
            UserError::ValidationError(msg) => msg,
            UserError::WeakPassword(msg) => msg,
            UserError::TokenExpired => "Token has expired".to_string(),
            UserError::TokenAlreadyUsed => "Token has already been used".to_string(),
            UserError::Unauthorized => "Unauthorized".to_string(),
            UserError::InternalError(msg) => msg
        }
    }
}
