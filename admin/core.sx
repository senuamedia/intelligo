    /// Filter navigation based on permissions
    fn filter_by_permissions(&self, context: &AccessContext) -> AdminNavigation {
        let filtered = self.items.iter()
            .filter(|item| {
                if let Some(ref perm) = item.permission {
                    context.has_permission(perm)
                } else {
                    true
                }
            })
            .map(|item| {
                let mut filtered_item = item.clone();
                filtered_item.children = item.children.iter()
                    .filter(|child| {
                        if let Some(ref perm) = child.permission {
                            context.has_permission(perm)
                        } else {
                            true
                        }
                    })
                    .cloned()
                    .collect();
                filtered_item
            })
            .collect();

        AdminNavigation { items: filtered }
    }

    /// Mark the active item based on current path
    fn mark_active(&mut self, current_path: &str) {
        for item in &mut self.items {
            if item.path == current_path {
                item.active = true;
            }
            for child in &mut item.children {
                if child.path == current_path {
                    child.active = true;
                    item.expanded = true;
                }
            }
        }
    }
}

// =============================================================================
// ADMIN WIDGETS
// =============================================================================

/// A dashboard widget
type DashboardWidget {
    /// Widget identifier
    id: String,

    /// Widget title
    title: String,

    /// Widget type
    widget_type: WidgetType,

    /// Grid column span (1-12)
    col_span: i32,

    /// Grid row span
    row_span: i32,

    /// Configuration options
    config: Map<String, Dynamic>,

    /// Required permission
    permission: Option<PermissionId>,

    /// Refresh interval in seconds (0 = no auto-refresh)
    refresh_interval: i32
}

/// Widget type
enum WidgetType {
    /// Numeric statistic with optional trend
    Stat { value: String, label: String, trend: Option<Trend> },

    /// Line/bar/pie chart
    Chart { chart_type: ChartType, data: ChartData },

    /// Data table
    Table { columns: List<TableColumn>, rows: List<Map<String, Dynamic>> },

    /// Activity feed
    ActivityFeed { items: List<ActivityItem> },

    /// Quick action buttons
    QuickActions { actions: List<QuickAction> },

    /// Progress indicator
    Progress { current: f32, target: f32, label: String },

    /// Alert/notification list
    Alerts { alerts: List<Alert> },

    /// Custom widget (rendered by client)
    Custom { component: String, props: Map<String, Dynamic> }
}

/// Trend indicator
type Trend {
    direction: TrendDirection,
    value: f32,
    label: String
}

/// Trend direction
enum TrendDirection {
    Up,
    Down,
    Flat
}

/// Chart type
enum ChartType {
    Line,
    Bar,
    Pie,
    Doughnut,
    Area,
    Scatter
}

/// Chart data
type ChartData {
    labels: List<String>,
    datasets: List<ChartDataset>
}

/// Chart dataset
type ChartDataset {
    label: String,
    data: List<f32>,
    color: Option<String>
}

/// Table column definition
type TableColumn {
    key: String,
    label: String,
    sortable: Bool,
    width: Option<String>
}

/// Activity feed item
type ActivityItem {
    id: String,
    actor: String,
    action: String,
    target: String,
    timestamp: DateTime,
    icon: Option<String>
}

/// Quick action button
type QuickAction {
    id: String,
    label: String,
    icon: String,
    path: String,
    permission: Option<PermissionId>
}

/// Alert notification
type Alert {
    id: String,
    level: AlertLevel,
    title: String,
    message: String,
    timestamp: DateTime,
    action_url: Option<String>,
    dismissable: Bool
}

/// Alert level
enum AlertLevel {
    Info,
    Success,
    Warning,
    Error
}

// =============================================================================
// ADMIN LAYOUT
// =============================================================================

/// Admin page layout
type AdminLayout {
    /// Page title
    title: String,

    /// Breadcrumb trail
    breadcrumbs: List<Breadcrumb>,

    /// Page-level actions (buttons in header)
    actions: List<PageAction>,

    /// Navigation state
    navigation: AdminNavigation,

    /// Current user info
    current_user: UserInfo,

    /// Tenant info
    tenant: TenantInfo,

    /// Global notifications
    notifications: List<Notification>
}

/// Breadcrumb item
type Breadcrumb {
    label: String,
    path: Option<String>
}

/// Page action button
type PageAction {
    id: String,
    label: String,
    icon: Option<String>,
    variant: ActionVariant,
    path: Option<String>,
    action: Option<String>,
    permission: Option<PermissionId>
}

/// Action button variant
enum ActionVariant {
    Primary,
    Secondary,
    Danger,
    Ghost
}

/// User info for display
type UserInfo {
    id: UserId,
    name: String,
    email: String,
    avatar: Option<String>,
    role: String
}

/// Tenant info for display
type TenantInfo {
    id: TenantId,
    name: String,
    logo: Option<String>,
    subdomain: String
}

/// Notification for user
type Notification {
    id: String,
    title: String,
    message: String,
    timestamp: DateTime,
    read: Bool,
    action_url: Option<String>
}

// =============================================================================
// ADMIN ACTOR
// =============================================================================

/// Admin core actor handling navigation and layout
actor AdminCore {
    state {
        /// Cached navigation per tenant
        navigation_cache: Map<TenantId, AdminNavigation>,

        /// Widget definitions
        widgets: Map<String, DashboardWidget>,

        /// User preferences
        user_preferences: Map<UserId, AdminPreferences>
    }

    /// Initialize the admin core
    fn init() -> AdminCore {
        AdminCore {
            state: AdminCoreState {
                navigation_cache: Map::new(),
                widgets: Map::new(),
                user_preferences: Map::new()
            }
        }
    }

    /// Get navigation for a user
    fn get_navigation(&self, context: &AccessContext, tenant_id: &TenantId) -> AdminNavigation {
        let base_nav = AdminNavigation::build_default(context, tenant_id);
        base_nav.filter_by_permissions(context)
    }

    /// Get layout for a page
    fn get_layout(
        &self,
        context: &AccessContext,
        tenant: &TenantInfo,
        page_title: &str,
        breadcrumbs: List<Breadcrumb>,
        actions: List<PageAction>
    ) -> AdminLayout {
        let mut navigation = self.get_navigation(context, &tenant.id);

        // Get current user info
        let user_info = UserInfo {
            id: context.user_id.clone(),
            name: "User".to_string(), // Would be fetched from user service
            email: "user@example.com".to_string(),
            avatar: None,
            role: "Administrator".to_string()
        };

        AdminLayout {
            title: page_title.to_string(),
            breadcrumbs,
            actions: actions.into_iter()
                .filter(|a| {
                    if let Some(ref perm) = a.permission {
                        context.has_permission(perm)
                    } else {
                        true
                    }
                })
                .collect(),
            navigation,
            current_user: user_info,
            tenant: tenant.clone(),
            notifications: vec![]
        }
    }

    /// Get user preferences
    fn get_preferences(&self, user_id: &UserId) -> AdminPreferences {
        self.state.user_preferences
            .get(user_id)
            .cloned()
            .unwrap_or_else(|| AdminPreferences::default())
    }

    /// Save user preferences
    fn save_preferences(&mut self, user_id: UserId, preferences: AdminPreferences) {
        self.state.user_preferences.insert(user_id, preferences);
    }
}

/// Admin user preferences
type AdminPreferences {
    /// Sidebar collapsed
    sidebar_collapsed: Bool,

    /// Theme preference
    theme: ThemePreference,

    /// Dashboard widget layout
    dashboard_widgets: List<String>,

    /// Items per page in lists
    items_per_page: i32,

    /// Default date format
    date_format: String,

    /// Notification preferences
    notifications: NotificationPreferences
}

/// Theme preference
enum ThemePreference {
    Light,
    Dark,
    System
}

/// Notification preferences
type NotificationPreferences {
    email_enabled: Bool,
    browser_enabled: Bool,
    digest_frequency: DigestFrequency
}

/// Digest email frequency
enum DigestFrequency {
    Realtime,
    Daily,
    Weekly,
    Never
}

impl AdminPreferences {
    fn default() -> AdminPreferences {
        AdminPreferences {
            sidebar_collapsed: false,
            theme: ThemePreference::System,
            dashboard_widgets: vec![
                "active_users".to_string(),
                "enrollments_chart".to_string(),
                "recent_activity".to_string(),
                "pending_grading".to_string()
            ],
            items_per_page: 25,
            date_format: "YYYY-MM-DD".to_string(),
            notifications: NotificationPreferences {
                email_enabled: true,
                browser_enabled: true,
                digest_frequency: DigestFrequency::Daily
            }
        }
    }
}

// =============================================================================
// ADMIN SEARCH
// =============================================================================

/// Global search functionality
type AdminSearch {
    query: String,
    filters: SearchFilters,
    results: SearchResults
}

/// Search filters
type SearchFilters {
    entity_types: List<String>,
    date_range: Option<DateRange>,
    status: Option<String>
}

/// Search results
type SearchResults {
    courses: List<SearchResult>,
    users: List<SearchResult>,
    enrollments: List<SearchResult>,
    assessments: List<SearchResult>,
    total_count: i32
}

/// Individual search result
type SearchResult {
    id: String,
    entity_type: String,
    title: String,
    subtitle: Option<String>,
    path: String,
    icon: String,
    relevance: f32
}

// =============================================================================
// AUDIT LOG
// =============================================================================

/// Audit log entry
type AuditLogEntry {
    id: String,
    tenant_id: TenantId,
    user_id: UserId,
    action: String,
    entity_type: String,
    entity_id: String,
    old_values: Option<Map<String, Dynamic>>,
    new_values: Option<Map<String, Dynamic>>,
    ip_address: String,
    user_agent: String,
    timestamp: DateTime
}

/// Audit log query
type AuditLogQuery {
    tenant_id: TenantId,
    user_id: Option<UserId>,
    action: Option<String>,
    entity_type: Option<String>,
    entity_id: Option<String>,
    date_range: Option<DateRange>,
    pagination: Pagination
}

/// Audit log actor
actor AuditLogger {
    state {
        /// Recent entries (in-memory buffer)
        recent_entries: List<AuditLogEntry>
    }

    /// Log an action
    fn log(
        &mut self,
        tenant_id: TenantId,
        user_id: UserId,
        action: String,
        entity_type: String,
        entity_id: String,
        old_values: Option<Map<String, Dynamic>>,
        new_values: Option<Map<String, Dynamic>>,
        ip_address: String,
        user_agent: String
    ) -> AuditLogEntry {
        let entry = AuditLogEntry {
            id: generate_uuid(),
            tenant_id,
            user_id,
            action,
            entity_type,
            entity_id,
            old_values,
            new_values,
            ip_address,
            user_agent,
            timestamp: DateTime::now()
        };

        // Buffer in memory (would also persist to DB)
        self.state.recent_entries.push(entry.clone());

        // Keep only last 1000 in memory
        if self.state.recent_entries.len() > 1000 {
            self.state.recent_entries.remove(0);
        }

        entry
    }

    /// Query audit log
    fn query(&self, query: AuditLogQuery) -> QueryResult<AuditLogEntry> {
        // In production, this would query the database
        let filtered: Vec<_> = self.state.recent_entries.iter()
            .filter(|e| e.tenant_id == query.tenant_id)
            .filter(|e| {
                if let Some(ref uid) = query.user_id {
                    &e.user_id == uid
                } else {
                    true
                }
            })
            .filter(|e| {
                if let Some(ref action) = query.action {
                    &e.action == action
                } else {
                    true
                }
            })
            .cloned()
            .collect();

        let total = filtered.len() as i64;
        let start = ((query.pagination.page - 1) * query.pagination.per_page) as usize;
        let items: Vec<_> = filtered.into_iter()
            .skip(start)
            .take(query.pagination.per_page as usize)
            .collect();

        QueryResult {
            items,
            total,
            page: query.pagination.page,
            per_page: query.pagination.per_page,
            total_pages: ((total as f32) / (query.pagination.per_page as f32)).ceil() as i32
        }
    }
}
