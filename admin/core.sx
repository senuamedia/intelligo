/// Intelligo LMS - Admin Core
///
/// Core admin shell providing navigation, layout, and shared admin infrastructure.
/// Handles admin authentication, menu building, and widget systems.

module intelligo::admin::core

use intelligo::core::types::*
use intelligo::core::security::*
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}

// =============================================================================
// ADMIN NAVIGATION
// =============================================================================

/// A navigation menu item
type MenuItem {
    /// Unique identifier
    id: String,

    /// Display label
    label: String,

    /// Icon identifier (icon library name)
    icon: Option<String>,

    /// Route path
    path: String,

    /// Required permission to see this item
    permission: Option<PermissionId>,

    /// Child menu items
    children: List<MenuItem>,

    /// Badge count (notifications, pending items)
    badge: Option<MenuBadge>,

    /// Sort order within parent
    weight: i32,

    /// Whether this is the active item
    active: Bool,

    /// Whether this menu is expanded
    expanded: Bool
}

/// Badge displayed on menu item
type MenuBadge {
    /// Count to display
    count: i32,

    /// Badge variant (info, warning, danger)
    variant: BadgeVariant
}

/// Badge styling variant
enum BadgeVariant {
    Info,
    Success,
    Warning,
    Danger
}

/// Admin navigation builder
type AdminNavigation {
    items: List<MenuItem>
}

