/// Get learner insights
async fn get_learner_insights(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    let is_own = ctx.auth.as_ref().map(|a| a.user_id.to_string() == user_id).unwrap_or(false);
    if !is_own {
        ctx.require_permission(Permission::ViewAnalytics)?;
    }

    let result = call_observation_hive(&db, ObservationHiveRequest::LearnerInsights {
        user_id: user_id.clone()
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(result.insights.unwrap(), &ctx)))
}

