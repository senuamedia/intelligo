// Request/response types for hives
type TutorRequest {
    user_id: UserId,
    session_id: String,
    message: String,
    conversation_history: List<AiMessage>,
    context: Option<TutorContext>,
    preferences: Option<TutorPreferences>
}

type TutorHiveResponse {
    content: String,
    suggestions: Option<List<String>>,
    related_resources: Option<List<ResourceReference>>,
    follow_up_questions: Option<List<String>>,
    tokens_used: i64,
    metadata: Option<Map<String, Dynamic>>
}

type ExplainHiveRequest {
    topic: String,
    context: Option<String>,
    level: DifficultyLevel,
    style: ExplanationStyle,
    include_examples: Bool
}

type ExplainHiveResponse {
    result: ExplainResponse,
    tokens_used: i64
}

enum ContentHiveRequest {
    StudyGuide { content: String, topic: Option<String>, learning_objectives: Option<List<String>>, format: StudyGuideFormat },
    Flashcards { content: String, topic: Option<String>, count: i32, difficulty: DifficultyLevel, include_hints: Bool },
    PracticeQuiz { content: String, topic: Option<String>, question_count: i32, question_types: List<QuestionType>, difficulty: DifficultyLevel },
    Summary { content: String, max_length: Option<i32>, style: SummaryStyle, include_key_points: Bool },
    Lesson { title: String, topic: String, learning_objectives: List<String>, target_audience: Option<String>, difficulty: DifficultyLevel, duration_minutes: i32, include_activities: Bool, include_assessments: Bool },
    Improve { content: String, improvement_type: String, instructions: Option<String> }
}

type ContentHiveResponse {
    study_guide: Option<StudyGuideResponse>,
    flashcards: Option<FlashcardResponse>,
    quiz: Option<PracticeQuizResponse>,
    summary: Option<SummaryResponse>,
    lesson: Option<GeneratedLessonResponse>,
    improved_content: Option<String>,
    tokens_used: i64
}

enum AssessmentHiveRequest {
    GenerateQuestions { content: String, learning_objectives: Option<List<String>>, question_count: i32, question_types: List<QuestionType>, difficulty: DifficultyLevel, bloom_levels: Option<List<BloomLevel>> },
    GenerateRubric { assignment_description: String, learning_objectives: List<String>, criteria_count: i32, scale_points: i32, include_exemplars: Bool },
    GenerateFeedback { submission_content: String, rubric: Option<GeneratedRubricResponse>, assignment_description: Option<String>, learning_objectives: Option<List<String>>, feedback_style: FeedbackStyle, include_suggestions: Bool },
    AutoGrade { submission_content: String, question: Option<String>, rubric: Option<GeneratedRubricResponse>, correct_answer: Option<String>, max_points: f64, grading_type: GradingType },
    Evaluate { question: String, response: String, correct_answer: Option<String>, rubric: Option<String> },
    Plagiarism { content: String, check_against: Option<List<String>>, threshold: f64 }
}

type AssessmentHiveResponse {
    questions: Option<GeneratedQuestionsResponse>,
    rubric: Option<GeneratedRubricResponse>,
    feedback: Option<GeneratedFeedbackResponse>,
    grade: Option<AutoGradeResponse>,
    evaluation: Option<Map<String, Dynamic>>,
    plagiarism_result: Option<PlagiarismCheckResponse>,
    tokens_used: i64
}

enum LearningPathHiveRequest {
    Recommend { user_id: Option<UserId>, goal: String, current_skills: Option<List<Skill>>, time_available_hours: Option<f64>, learning_style: Option<LearningStyle>, constraints: Option<PathConstraints> },
    Generate { goal: String, current_skills: Option<List<Skill>>, time_available_hours: Option<f64>, constraints: Option<PathConstraints> },
    Adapt { path_id: String, user_id: UserId, progress_data: Map<String, Dynamic>, feedback: Option<String> },
    Diagnostic { topic: String, skill_areas: List<String>, question_count: i32 }
}

type LearningPathHiveResponse {
    path: Option<LearningPathResponse>,
    diagnostic: Option<DiagnosticResponse>,
    tokens_used: i64
}

enum ObservationHiveRequest {
    LearnerInsights { user_id: UserId },
    CourseInsights { course_id: CourseId },
    AtRisk { course_id: Option<CourseId> },
    Predict { course_id: CourseId, user_ids: Option<List<UserId>> }
}

type ObservationHiveResponse {
    insights: Option<LearnerInsightsResponse>,
    course_insights: Option<CourseInsightsResponse>,
    at_risk: Option<AtRiskStudentsResponse>,
    predictions: Option<PredictOutcomesResponse>
}

