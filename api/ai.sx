    let ctx = RequestContext::from_request(&req);
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let topic = req.query_param("topic").ok_or_else(|| ApiError::BadRequest {
        message: "Topic required".to_string()
    })?;

    let diagnostic = db.diagnostics().find_by_user_and_topic(&auth.user_id, &topic).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    match diagnostic {
        Some(d) => Ok(Response::json(ApiResponse::success(d, &ctx))),
        None => Err(ApiError::NotFound { resource: "Diagnostic".to_string(), id: topic })
    }
}

