/// Intelligo LMS - AI API
///
/// This module provides AI-powered learning endpoints:
/// - AI tutoring and chat
/// - Content generation
/// - Assessment assistance
/// - Learning path recommendations
/// - Analytics and insights

module intelligo::api::ai

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::ai::coordinator::*
use intelligo::ai::hives::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the AI router
pub fn router(db: Database) -> Router {
    Router::new()
        // Tutoring
        .post("/tutor/chat", move |req| tutor_chat(req, db.clone()))
        .post("/tutor/explain", move |req| tutor_explain(req, db.clone()))
        .get("/tutor/sessions", move |req| get_tutor_sessions(req, db.clone()))
        .get("/tutor/sessions/:session_id", move |req| get_tutor_session(req, db.clone()))
        .delete("/tutor/sessions/:session_id", move |req| delete_tutor_session(req, db.clone()))

        // Study assistance
        .post("/study/guide", move |req| generate_study_guide(req, db.clone()))
        .post("/study/flashcards", move |req| generate_flashcards(req, db.clone()))
        .post("/study/quiz", move |req| generate_practice_quiz(req, db.clone()))
        .post("/study/summary", move |req| summarize_content(req, db.clone()))

        // Content generation
        .post("/content/lesson", move |req| generate_lesson(req, db.clone()))
        .post("/content/questions", move |req| generate_questions(req, db.clone()))
        .post("/content/rubric", move |req| generate_rubric(req, db.clone()))
        .post("/content/feedback", move |req| generate_feedback(req, db.clone()))
        .post("/content/improve", move |req| improve_content(req, db.clone()))

        // Assessment
        .post("/assess/grade", move |req| auto_grade(req, db.clone()))
        .post("/assess/evaluate", move |req| evaluate_response(req, db.clone()))
        .post("/assess/plagiarism", move |req| check_plagiarism(req, db.clone()))

        // Learning paths
        .post("/paths/recommend", move |req| recommend_path(req, db.clone()))
        .post("/paths/generate", move |req| generate_path(req, db.clone()))
        .post("/paths/adapt", move |req| adapt_path(req, db.clone()))
        .get("/paths/diagnostic", move |req| get_diagnostic(req, db.clone()))
        .post("/paths/diagnostic", move |req| run_diagnostic(req, db.clone()))

        // Analytics and insights
        .get("/insights/learner/:user_id", move |req| get_learner_insights(req, db.clone()))
        .get("/insights/course/:course_id", move |req| get_course_insights(req, db.clone()))
        .get("/insights/at-risk", move |req| get_at_risk_students(req, db.clone()))
        .post("/insights/predict", move |req| predict_outcomes(req, db.clone()))

        // Admin
        .get("/usage", move |req| get_ai_usage(req, db.clone()))
        .get("/models", move |req| list_models(req, db.clone()))
        .post("/models/test", move |req| test_model(req, db.clone()))
}

