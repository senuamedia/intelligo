// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

fn generate_session_id() -> String {
    format!("tutor_{}", generate_uuid())
}

fn generate_uuid() -> String {
    use std::random::random;
    format!("{:08x}{:08x}", random::<u32>(), random::<u32>())
}

async fn get_or_create_tutor_session(db: &Database, user_id: &str, session_id: &str, context: Option<&TutorContext>) -> Result<TutorSessionResponse, ApiError> {
    match db.tutor_sessions().find_by_id(session_id).await {
        Ok(Some(session)) => Ok(session),
        _ => {
            let session = db.tutor_sessions().create(CreateTutorSessionInput {
                id: session_id.to_string(),
                user_id: user_id.to_string(),
                course_id: context.and_then(|c| c.course_id.clone()),
                topic: context.and_then(|c| c.topic.clone())
            }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: "".to_string() })?;
            Ok(session)
        }
    }
}

async fn save_tutor_message(db: &Database, session_id: &str, role: &str, content: &str) -> Result<(), String> {
    db.tutor_sessions().add_message(session_id, AiMessage {
        role: role.to_string(),
        content: content.to_string(),
        timestamp: DateTime::now(),
        metadata: None
    }).await
}

async fn track_ai_usage(db: &Database, user_id: &str, feature: &str, tokens: i64) -> Result<(), String> {
    db.ai_usage().record(user_id, feature, tokens).await
}

async fn get_content_from_lessons(db: &Database, lesson_ids: &List<String>) -> Result<String, ApiError> {
    let mut content = String::new();
    for id in lesson_ids {
        if let Some(lesson) = db.lessons().find_by_id(id).await.ok().flatten() {
            content.push_str(&lesson.content);
            content.push_str("\n\n");
        }
    }
    Ok(content)
}

async fn get_available_models() -> List<Map<String, Dynamic>> {
    vec![
        Map::from([
            ("id".to_string(), Dynamic::String("gpt-4".to_string())),
            ("name".to_string(), Dynamic::String("GPT-4".to_string())),
            ("available".to_string(), Dynamic::Bool(true))
        ]),
        Map::from([
            ("id".to_string(), Dynamic::String("claude-3".to_string())),
            ("name".to_string(), Dynamic::String("Claude 3".to_string())),
            ("available".to_string(), Dynamic::Bool(true))
        ])
    ]
}

async fn test_model_connection(model: &str, prompt: &str) -> Result<Map<String, Dynamic>, String> {
    Ok(Map::from([
        ("success".to_string(), Dynamic::Bool(true)),
        ("response".to_string(), Dynamic::String("Test response".to_string())),
        ("latency_ms".to_string(), Dynamic::Int(150))
    ]))
}

