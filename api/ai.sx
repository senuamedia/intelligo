// STUDY ASSISTANCE
// =============================================================================

/// Generate study guide
async fn generate_study_guide(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let body: StudyGuideRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request: {}", e)
    })?;

    let content = if let Some(c) = body.content {
        c
    } else if let Some(lesson_ids) = body.lesson_ids {
        get_content_from_lessons(&db, &lesson_ids).await?
    } else {
        return Err(ApiError::BadRequest { message: "Content or lesson_ids required".to_string() })
    };

    let result = call_content_hive(&db, ContentHiveRequest::StudyGuide {
        content,
        topic: body.topic,
        learning_objectives: body.learning_objectives,
        format: body.format.unwrap_or(StudyGuideFormat::Outline)
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    track_ai_usage(&db, &auth.user_id, "study_guide", result.tokens_used).await.ok();

    Ok(Response::json(ApiResponse::success(result.study_guide.unwrap(), &ctx)))
}

