// =============================================================================
// TUTORING ENDPOINTS
// =============================================================================

/// Tutor chat
async fn tutor_chat(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let body: TutorChatRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request: {}", e)
    })?;

    // Get or create session
    let session_id = body.session_id.unwrap_or_else(|| generate_session_id());
    let session = get_or_create_tutor_session(&db, &auth.user_id, &session_id, body.context.as_ref()).await?;

    // Build AI request
    let ai_request = TutorRequest {
        user_id: auth.user_id.clone(),
        session_id: session_id.clone(),
        message: body.message.clone(),
        conversation_history: session.messages.clone(),
        context: body.context,
        preferences: body.preferences
    };

    // Call tutor hive
    let ai_response = call_tutor_hive(&db, ai_request).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Save messages to session
    save_tutor_message(&db, &session_id, "user", &body.message).await.ok();
    save_tutor_message(&db, &session_id, "assistant", &ai_response.content).await.ok();

    // Track AI usage
    track_ai_usage(&db, &auth.user_id, "tutor_chat", ai_response.tokens_used).await.ok();

    let response = TutorChatResponse {
        session_id,
        message: AiMessage {
            role: "assistant".to_string(),
            content: ai_response.content,
            timestamp: DateTime::now(),
            metadata: ai_response.metadata
        },
        suggestions: ai_response.suggestions,
        related_resources: ai_response.related_resources,
        follow_up_questions: ai_response.follow_up_questions
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Tutor explain
async fn tutor_explain(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let body: ExplainRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request: {}", e)
    })?;

    let ai_response = call_explain_hive(&db, ExplainHiveRequest {
        topic: body.topic,
        context: body.context,
        level: body.level.unwrap_or(DifficultyLevel::Intermediate),
        style: body.style.unwrap_or(ExplanationStyle::Detailed),
        include_examples: body.include_examples.unwrap_or(true)
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    track_ai_usage(&db, &auth.user_id, "explain", ai_response.tokens_used).await.ok();

    Ok(Response::json(ApiResponse::success(ai_response.result, &ctx)))
}

/// Get tutor sessions
async fn get_tutor_sessions(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let sessions = db.tutor_sessions().find_by_user(&auth.user_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(sessions, &ctx)))
}

/// Get tutor session
async fn get_tutor_session(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let session_id = req.param("session_id").ok_or_else(|| ApiError::BadRequest {
        message: "Session ID required".to_string()
    })?;

    let session = db.tutor_sessions().find_by_id(&session_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "TutorSession".to_string(), id: session_id.clone() })?;

    if session.user_id != auth.user_id && !ctx.is_admin() {
        return Err(ApiError::Forbidden { message: "Access denied".to_string(), required_permission: None })
    }

    Ok(Response::json(ApiResponse::success(session, &ctx)))
}

/// Delete tutor session
async fn delete_tutor_session(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let session_id = req.param("session_id").ok_or_else(|| ApiError::BadRequest {
        message: "Session ID required".to_string()
    })?;

    let session = db.tutor_sessions().find_by_id(&session_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "TutorSession".to_string(), id: session_id.clone() })?;

    if session.user_id != auth.user_id && !ctx.is_admin() {
        return Err(ApiError::Forbidden { message: "Access denied".to_string(), required_permission: None })
    }

    db.tutor_sessions().delete(&session_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(Map::from([("deleted".to_string(), Dynamic::Bool(true))])))
}

