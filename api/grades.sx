// =============================================================================
// GRADEBOOK ENDPOINTS
// =============================================================================

/// Get full gradebook for a course
async fn get_gradebook(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    ctx.require_permission(Permission::ViewGradebook)?;
    verify_course_access(&db, &ctx, &course_id, CourseAccessLevel::Instructor).await?;

    let course = db.courses()
        .find_by_id(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.clone()
        })?;

    let grading_scheme = get_grading_scheme(&db, &course).await?;
    let categories = db.grade_categories().find_by_course(&course_id).await.unwrap_or_default();
    let assignments = db.assignments().find_gradable_by_course(&course_id).await.unwrap_or_default();
    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();
    let grades = db.grades().find_by_course(&course_id).await.unwrap_or_default();

    let gradebook = build_gradebook_response(&course, grading_scheme, categories, assignments, enrollments, grades)?;

    Ok(Response::json(ApiResponse::success(gradebook, &ctx)))
}

/// Get grades for a specific student
async fn get_student_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;
    let student_id = req.param("student_id").ok_or_else(|| ApiError::BadRequest {
        message: "Student ID required".to_string()
    })?;

    let is_own = ctx.auth.as_ref().map(|a| a.user_id.to_string() == student_id).unwrap_or(false);

    if !is_own {
        ctx.require_permission(Permission::ViewGradebook)?;
        verify_course_access(&db, &ctx, &course_id, CourseAccessLevel::Instructor).await?;
    } else {
        verify_course_access(&db, &ctx, &course_id, CourseAccessLevel::Student).await?;
    }

    let student = db.users().find_by_id(&student_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "User".to_string(), id: student_id.clone() })?;

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    let grades = db.grades().find_by_user_and_course(&student_id, &course_id).await.unwrap_or_default();
    let assignments = db.assignments().find_gradable_by_course(&course_id).await.unwrap_or_default();

    let response = build_student_grades_response(&student, &course, assignments, grades)?;

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Get grades for assignment
async fn get_assignment_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;
    let assignment_id = req.param("assignment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assignment ID required".to_string()
    })?;

    ctx.require_permission(Permission::ViewGradebook)?;
    verify_course_access(&db, &ctx, &course_id, CourseAccessLevel::Instructor).await?;

    let grades = db.grades().find_by_assignment(&assignment_id).await.unwrap_or_default();
    let stats = calculate_assignment_statistics(&grades);

    Ok(Response::json(ApiResponse::success(Map::from([
        ("grades".to_string(), Dynamic::List(grades.iter().map(|g| Dynamic::Map(grade_to_map(g))).collect())),
        ("statistics".to_string(), Dynamic::Map(stats_to_map(&stats)))
    ]), &ctx)))
}

// =============================================================================
// INDIVIDUAL GRADE ENDPOINTS
// =============================================================================

/// Get a single grade
async fn get_grade(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let grade_id = req.param("grade_id").ok_or_else(|| ApiError::BadRequest {
        message: "Grade ID required".to_string()
    })?;

    let grade = db.grades().find_by_id(&grade_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Grade".to_string(), id: grade_id.clone() })?;

    let is_own = ctx.auth.as_ref().map(|a| a.user_id == grade.student_id).unwrap_or(false);
    if !is_own {
        ctx.require_permission(Permission::ViewGradebook)?;
    }

    Ok(Response::json(ApiResponse::success(grade_to_response(&grade), &ctx)))
}

/// Create a new grade
async fn create_grade(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    let body: CreateGradeRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let assignment = db.assignments().find_by_id(&body.assignment_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Assignment".to_string(), id: body.assignment_id.clone() })?;

    let existing = db.grades().find_by_assignment_and_student(&body.assignment_id, &body.student_id).await.ok().flatten();
    if existing.is_some() {
        return Err(ApiError::Conflict { message: "Grade already exists".to_string() })
    }

    let grader_id = ctx.auth.as_ref().map(|a| a.user_id.clone());

    let grade = db.grades().create(CreateGradeInput {
        assignment_id: body.assignment_id.clone(),
        student_id: body.student_id.clone(),
        score: body.score,
        feedback: body.feedback,
        graded_by: grader_id,
        graded_at: Some(DateTime::now())
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    if body.notify_student.unwrap_or(false) {
        notify_grade_posted(&grade, &assignment).await.ok();
    }

    Ok(Response::json(ApiResponse::success(grade_to_response(&grade), &ctx)).with_status(StatusCode::CREATED))
}

/// Update a grade
async fn update_grade(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    let grade_id = req.param("grade_id").ok_or_else(|| ApiError::BadRequest {
        message: "Grade ID required".to_string()
    })?;

    let body: UpdateGradeRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let grader_id = ctx.auth.as_ref().map(|a| a.user_id.clone());

    let grade = db.grades().update(&grade_id, UpdateGradeInput {
        score: body.score,
        feedback: body.feedback,
        excused: body.excused,
        graded_by: grader_id,
        graded_at: Some(DateTime::now())
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(grade_to_response(&grade), &ctx)))
}

/// Delete a grade
async fn delete_grade(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    let grade_id = req.param("grade_id").ok_or_else(|| ApiError::BadRequest {
        message: "Grade ID required".to_string()
    })?;

    db.grades().delete(&grade_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Grade deleted".to_string()))
    ])))
}

// =============================================================================
// BULK OPERATIONS
// =============================================================================

/// Bulk create grades
async fn bulk_create_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    let body: BulkGradeRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let grader_id = ctx.auth.as_ref().map(|a| a.user_id.clone());
    let mut created = 0;
    let mut updated = 0;
    let mut errors: List<String> = vec![];

    for entry in body.grades {
        let existing = db.grades().find_by_assignment_and_student(&body.assignment_id, &entry.student_id).await.ok().flatten();

        let result = if let Some(existing_grade) = existing {
            db.grades().update(&existing_grade.id, UpdateGradeInput {
                score: Some(entry.score),
                feedback: entry.feedback,
                excused: None,
                graded_by: grader_id.clone(),
                graded_at: Some(DateTime::now())
            }).await.map(|_| { updated += 1; })
        } else {
            db.grades().create(CreateGradeInput {
                assignment_id: body.assignment_id.clone(),
                student_id: entry.student_id.clone(),
                score: entry.score,
                feedback: entry.feedback,
                graded_by: grader_id.clone(),
                graded_at: Some(DateTime::now())
            }).await.map(|_| { created += 1; })
        };

        if let Err(e) = result {
            errors.push(format!("Error for student {}: {}", entry.student_id, e));
        }
    }

    Ok(Response::json(ApiResponse::success(BulkGradeResponse {
        created, updated, errors, total: body.grades.len() as i32
    }, &ctx)))
}

/// Bulk update grades
async fn bulk_update_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    #[derive(Deserialize)]
    struct BulkUpdateRequest {
        updates: List<GradeUpdateEntry>
    }

    #[derive(Deserialize)]
    struct GradeUpdateEntry {
        grade_id: String,
        score: Option<f64>,
        feedback: Option<String>
    }

    let body: BulkUpdateRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let grader_id = ctx.auth.as_ref().map(|a| a.user_id.clone());
    let mut updated = 0;
    let mut errors: List<String> = vec![];

    for entry in body.updates {
        match db.grades().update(&entry.grade_id, UpdateGradeInput {
            score: entry.score,
            feedback: entry.feedback,
            excused: None,
            graded_by: grader_id.clone(),
            graded_at: Some(DateTime::now())
        }).await {
            Ok(_) => updated += 1,
            Err(e) => errors.push(format!("Error for grade {}: {}", entry.grade_id, e))
        }
    }

    Ok(Response::json(ApiResponse::success(BulkGradeResponse {
        created: 0, updated, errors, total: body.updates.len() as i32
    }, &ctx)))
}

// =============================================================================
// GRADE OVERRIDES
// =============================================================================

/// Create grade override
async fn create_override(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::OverrideGrades)?;

    let grade_id = req.param("grade_id").ok_or_else(|| ApiError::BadRequest {
        message: "Grade ID required".to_string()
    })?;

    let body: GradeOverrideRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let grader_id = ctx.auth.as_ref().map(|a| a.user_id.clone());

    let grade = db.grades().create_override(&grade_id, CreateOverrideInput {
        override_score: body.override_score,
        reason: body.reason,
        overridden_by: grader_id
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(grade_to_response(&grade), &ctx)))
}

/// Remove grade override
async fn remove_override(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::OverrideGrades)?;

    let grade_id = req.param("grade_id").ok_or_else(|| ApiError::BadRequest {
        message: "Grade ID required".to_string()
    })?;

    let grade = db.grades().remove_override(&grade_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(grade_to_response(&grade), &ctx)))
}

// =============================================================================
// CALCULATIONS
// =============================================================================

/// Calculate final grade for student
async fn calculate_final_grade(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;
    let student_id = req.param("student_id").ok_or_else(|| ApiError::BadRequest {
        message: "Student ID required".to_string()
    })?;

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    let grades = db.grades().find_by_user_and_course(&student_id, &course_id).await.unwrap_or_default();
    let assignments = db.assignments().find_gradable_by_course(&course_id).await.unwrap_or_default();
    let categories = db.grade_categories().find_by_course(&course_id).await.unwrap_or_default();
    let grading_scheme = get_grading_scheme(&db, &course).await?;

    let calculation = calculate_weighted_grade(&student_id, &course_id, &grades, &assignments, &categories, &grading_scheme)?;

    Ok(Response::json(ApiResponse::success(calculation, &ctx)))
}

/// Recalculate all grades in course
async fn recalculate_all_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();
    let mut recalculated = 0;

    for enrollment in enrollments {
        db.grades().recalculate_final_grade(&enrollment.user_id, &course_id).await.ok();
        recalculated += 1;
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String(format!("Recalculated grades for {} students", recalculated)))
    ])))
}

