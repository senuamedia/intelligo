/// Export grades
async fn export_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewGradebook)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let format = req.query_param("format").map(|f| match f.as_str() {
        "excel" => GradeExportFormat::Excel,
        "pdf" => GradeExportFormat::PDF,
        _ => GradeExportFormat::CSV
    }).unwrap_or(GradeExportFormat::CSV);

    let grades = db.grades().find_by_course(&course_id).await.unwrap_or_default();
    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();
    let assignments = db.assignments().find_gradable_by_course(&course_id).await.unwrap_or_default();

    let (content, content_type, filename) = match format {
        GradeExportFormat::CSV => {
            let csv = generate_grades_csv(&grades, &enrollments, &assignments)?;
            (csv, "text/csv", format!("grades_{}.csv", course_id))
        },
        GradeExportFormat::Excel => {
            let excel = generate_grades_excel(&grades, &enrollments, &assignments)?;
            (excel, "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", format!("grades_{}.xlsx", course_id))
        },
        GradeExportFormat::PDF => {
            let pdf = generate_grades_pdf(&grades, &enrollments, &assignments)?;
            (pdf, "application/pdf", format!("grades_{}.pdf", course_id))
        }
    };

    Ok(Response::new()
        .with_header("Content-Type", content_type)
        .with_header("Content-Disposition", &format!("attachment; filename=\"{}\"", filename))
        .with_body(content))
}

/// Import grades
async fn import_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::EditGrades)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    #[derive(Deserialize)]
    struct GradeImportRequest {
        assignment_id: String,
        format: String,
        data: String
    }

    let body: GradeImportRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let import_data = parse_grade_import(&body.data, &body.format)?;
    let grader_id = ctx.auth.as_ref().map(|a| a.user_id.clone());
    let mut imported = 0;
    let mut errors: List<String> = vec![];

    for row in import_data {
        match db.grades().upsert(UpsertGradeInput {
            assignment_id: body.assignment_id.clone(),
            student_id: row.student_id.clone(),
            score: row.score,
            feedback: row.feedback,
            graded_by: grader_id.clone(),
            graded_at: Some(DateTime::now())
        }).await {
            Ok(_) => imported += 1,
            Err(e) => errors.push(format!("Error for student {}: {}", row.student_id, e))
        }
    }

    Ok(Response::json(ApiResponse::success(Map::from([
        ("imported".to_string(), Dynamic::Int(imported)),
        ("errors".to_string(), Dynamic::List(errors.iter().map(|e| Dynamic::String(e.clone())).collect()))
    ]), &ctx)))
}

// =============================================================================
// STUDENT VIEWS
// =============================================================================

/// Get my grades for a course
async fn get_my_grades(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, &course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::Forbidden { message: "Not enrolled".to_string(), required_permission: None })?;

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    if !course.settings.show_gradebook_to_students {
        return Err(ApiError::Forbidden {
            message: "Gradebook not available".to_string(),
            required_permission: None
        })
    }

    let grades = db.grades().find_by_user_and_course(&auth.user_id, &course_id).await.unwrap_or_default();
    let assignments = db.assignments().find_published_by_course(&course_id).await.unwrap_or_default();

    let student = db.users().find_by_id(&auth.user_id).await.ok().flatten()
        .unwrap_or_else(|| User::default());

    let response = build_student_grades_response(&student, &course, assignments, grades)?;

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Get grade summary across all courses
async fn get_my_grade_summary(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let enrollments = db.enrollments().find_active_by_user(&auth.user_id).await.unwrap_or_default();
    let mut course_grades: List<CourseGradeSummary> = vec![];

    for enrollment in enrollments {
        if let Some(course) = db.courses().find_by_id(&enrollment.course_id).await.ok().flatten() {
            if course.settings.show_gradebook_to_students {
                let grades = db.grades().find_by_user_and_course(&auth.user_id, &course.id).await.unwrap_or_default();
                let current_grade = calculate_current_grade(&grades);

                course_grades.push(CourseGradeSummary {
                    course_id: course.id.clone(),
                    course_title: course.title.clone(),
                    course_code: course.code.clone(),
                    current_grade,
                    current_letter: current_grade.map(|g| grade_to_letter(g)),
                    assignments_completed: grades.len() as i32,
                    assignments_total: 0
                });
            }
        }
    }

    Ok(Response::json(ApiResponse::success(course_grades, &ctx)))
}

