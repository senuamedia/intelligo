/// Intelligo LMS - Grades API
///
/// This module provides grading and gradebook endpoints:
/// - Gradebook views (instructor and student)
/// - Grade entry and modification
/// - Grade calculations and aggregation
/// - Grade export and import
/// - Grade override management

module intelligo::api::grades

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::entities::grade::*
use intelligo::entities::course::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the grades router
pub fn router(db: Database) -> Router {
    Router::new()
        // Gradebook views
        .get("/courses/:course_id/gradebook", move |req| get_gradebook(req, db.clone()))
        .get("/courses/:course_id/gradebook/student/:student_id", move |req| get_student_grades(req, db.clone()))
        .get("/courses/:course_id/gradebook/assignment/:assignment_id", move |req| get_assignment_grades(req, db.clone()))

        // Individual grades
        .get("/:grade_id", move |req| get_grade(req, db.clone()))
        .post("/", move |req| create_grade(req, db.clone()))
        .patch("/:grade_id", move |req| update_grade(req, db.clone()))
        .delete("/:grade_id", move |req| delete_grade(req, db.clone()))

        // Bulk operations
        .post("/bulk", move |req| bulk_create_grades(req, db.clone()))
        .patch("/bulk", move |req| bulk_update_grades(req, db.clone()))

        // Grade overrides
        .post("/:grade_id/override", move |req| create_override(req, db.clone()))
        .delete("/:grade_id/override", move |req| remove_override(req, db.clone()))

        // Grade calculations
        .get("/courses/:course_id/calculate/:student_id", move |req| calculate_final_grade(req, db.clone()))
        .post("/courses/:course_id/recalculate", move |req| recalculate_all_grades(req, db.clone()))

        // Grade history
        .get("/:grade_id/history", move |req| get_grade_history(req, db.clone()))

        // Export/Import
        .get("/courses/:course_id/export", move |req| export_grades(req, db.clone()))
        .post("/courses/:course_id/import", move |req| import_grades(req, db.clone()))

        // Student's own grades
        .get("/my/courses/:course_id", move |req| get_my_grades(req, db.clone()))
        .get("/my/summary", move |req| get_my_grade_summary(req, db.clone()))

        // Grade statistics
        .get("/courses/:course_id/statistics", move |req| get_grade_statistics(req, db.clone()))
        .get("/courses/:course_id/distribution", move |req| get_grade_distribution(req, db.clone()))
}

