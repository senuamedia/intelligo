/// Get grade statistics
async fn get_grade_statistics(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewGradebook)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    verify_course_access(&db, &ctx, &course_id, CourseAccessLevel::Instructor).await?;

    let grades = db.grades().find_by_course(&course_id).await.unwrap_or_default();
    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();

    let statistics = compute_grade_statistics(&course_id, &grades, &enrollments)?;

    Ok(Response::json(ApiResponse::success(statistics, &ctx)))
}

/// Get grade distribution
async fn get_grade_distribution(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewGradebook)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    verify_course_access(&db, &ctx, &course_id, CourseAccessLevel::Instructor).await?;

    let final_grades = db.grades().find_final_grades_by_course(&course_id).await.unwrap_or_default();
    let distribution = compute_grade_distribution(&course_id, &final_grades)?;

    Ok(Response::json(ApiResponse::success(distribution, &ctx)))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

enum CourseAccessLevel {
    Student,
    Instructor
}

async fn verify_course_access(db: &Database, ctx: &RequestContext, course_id: &str, level: CourseAccessLevel) -> Result<(), ApiError> {
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    if ctx.is_admin() { return Ok(()) }

    let enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, course_id).await.ok().flatten();

    match level {
        CourseAccessLevel::Student => {
            if enrollment.is_some() { return Ok(()) }
        },
        CourseAccessLevel::Instructor => {
            if let Some(e) = enrollment {
                if e.role.is_instructor() { return Ok(()) }
            }
        }
    }

    Err(ApiError::Forbidden { message: "Insufficient access".to_string(), required_permission: None })
}

async fn get_grading_scheme(db: &Database, course: &Course) -> Result<GradingSchemeResponse, ApiError> {
    if let Some(scheme_id) = &course.grading_scheme_id {
        if let Some(scheme) = db.grading_schemes().find_by_id(scheme_id).await.ok().flatten() {
            return Ok(GradingSchemeResponse {
                id: scheme.id,
                name: scheme.name,
                aggregation_type: scheme.aggregation_type,
                passing_grade: scheme.passing_grade,
                letter_grades: scheme.letter_grades.into_iter().map(|lg| LetterGradeMapping {
                    letter: lg.letter,
                    min_percentage: lg.min_percentage,
                    max_percentage: lg.max_percentage,
                    gpa_value: lg.gpa_value
                }).collect(),
                drop_lowest: scheme.drop_lowest
            })
        }
    }
    Ok(default_grading_scheme())
}

fn default_grading_scheme() -> GradingSchemeResponse {
    GradingSchemeResponse {
        id: "default".to_string(),
        name: "Standard".to_string(),
        aggregation_type: GradeAggregationType::WeightedMean,
        passing_grade: 60.0,
        letter_grades: vec![
            LetterGradeMapping { letter: "A".to_string(), min_percentage: 90.0, max_percentage: 100.0, gpa_value: Some(4.0) },
            LetterGradeMapping { letter: "B".to_string(), min_percentage: 80.0, max_percentage: 89.99, gpa_value: Some(3.0) },
            LetterGradeMapping { letter: "C".to_string(), min_percentage: 70.0, max_percentage: 79.99, gpa_value: Some(2.0) },
            LetterGradeMapping { letter: "D".to_string(), min_percentage: 60.0, max_percentage: 69.99, gpa_value: Some(1.0) },
            LetterGradeMapping { letter: "F".to_string(), min_percentage: 0.0, max_percentage: 59.99, gpa_value: Some(0.0) }
        ],
        drop_lowest: None
    }
}

fn grade_to_response(grade: &Grade) -> GradeResponse {
    GradeResponse {
        id: grade.id.clone(),
        student_id: grade.student_id.clone(),
        student_name: "".to_string(),
        score: grade.score,
        grade: grade.calculated_grade,
        letter_grade: grade.letter_grade.clone(),
        feedback: grade.feedback.clone(),
        status: grade.status.clone(),
        has_override: grade.has_override,
        override_reason: grade.override_reason.clone(),
        graded_at: grade.graded_at,
        graded_by_name: None,
        excused: grade.excused,
        late: grade.late
    }
}

fn grade_to_map(grade: &Grade) -> Map<String, Dynamic> {
    let mut m = Map::new();
    m.insert("id".to_string(), Dynamic::String(grade.id.clone()));
    m.insert("student_id".to_string(), Dynamic::String(grade.student_id.clone()));
    m.insert("score".to_string(), grade.score.map(Dynamic::Float).unwrap_or(Dynamic::Null));
    m
}

fn stats_to_map(stats: &GradeStats) -> Map<String, Dynamic> {
    let mut m = Map::new();
    m.insert("mean".to_string(), Dynamic::Float(stats.mean));
    m.insert("median".to_string(), Dynamic::Float(stats.median));
    m.insert("std_deviation".to_string(), Dynamic::Float(stats.std_deviation));
    m.insert("min".to_string(), Dynamic::Float(stats.min));
    m.insert("max".to_string(), Dynamic::Float(stats.max));
    m
}

fn calculate_assignment_statistics(grades: &List<Grade>) -> GradeStats {
    let scores: Vec<f64> = grades.iter().filter_map(|g| g.score).collect();
    if scores.is_empty() {
        return GradeStats { mean: 0.0, median: 0.0, mode: None, std_deviation: 0.0, min: 0.0, max: 0.0, range: 0.0 }
    }

    let mean = scores.iter().sum::<f64>() / scores.len() as f64;
    let mut sorted = scores.clone();
    sorted.sort_by(|a, b| a.partial_cmp(b).unwrap());
    let median = sorted[sorted.len() / 2];
    let min = *sorted.first().unwrap_or(&0.0);
    let max = *sorted.last().unwrap_or(&0.0);
    let variance = scores.iter().map(|&x| (x - mean).powi(2)).sum::<f64>() / scores.len() as f64;

    GradeStats { mean, median, mode: None, std_deviation: variance.sqrt(), min, max, range: max - min }
}

fn calculate_current_grade(grades: &List<Grade>) -> Option<f64> {
    if grades.is_empty() { return None }
    let total: f64 = grades.iter().filter_map(|g| g.calculated_grade).sum();
    Some(total / grades.len() as f64)
}

fn grade_to_letter(grade: f64) -> String {
    if grade >= 90.0 { "A".to_string() }
    else if grade >= 80.0 { "B".to_string() }
    else if grade >= 70.0 { "C".to_string() }
    else if grade >= 60.0 { "D".to_string() }
    else { "F".to_string() }
}

fn build_gradebook_response(course: &Course, grading_scheme: GradingSchemeResponse, categories: List<GradeCategory>, assignments: List<Assignment>, enrollments: List<Enrollment>, grades: List<Grade>) -> Result<GradebookResponse, ApiError> {
    Ok(GradebookResponse {
        course_id: course.id.clone(),
        course_title: course.title.clone(),
        grading_scheme,
        categories: categories.iter().map(|c| GradeCategoryResponse {
            id: c.id.clone(), name: c.name.clone(), weight: c.weight, drop_lowest: c.drop_lowest, assignment_count: 0
        }).collect(),
        assignments: assignments.iter().map(|a| GradebookAssignment {
            id: a.id.clone(), title: a.title.clone(), category_id: a.category_id.clone(),
            points_possible: a.points_possible, due_date: a.due_date, published: a.published, grading_type: a.grading_type.clone()
        }).collect(),
        students: vec![],
        summary: GradebookSummary {
            total_students: enrollments.len() as i32, average_grade: None, median_grade: None,
            highest_grade: None, lowest_grade: None, passing_count: 0, failing_count: 0, missing_submissions: 0
        }
    })
}

fn build_student_grades_response(student: &User, course: &Course, assignments: List<Assignment>, grades: List<Grade>) -> Result<StudentGradesResponse, ApiError> {
    Ok(StudentGradesResponse {
        student: StudentInfo {
            user_id: student.id.clone(),
            name: format!("{} {}", student.first_name, student.last_name),
            email: student.email.clone(),
            avatar_url: student.avatar_url.clone(),
            section_name: None
        },
        course: CourseInfo { id: course.id.clone(), title: course.title.clone(), code: course.code.clone() },
        grades: grades.iter().map(|g| {
            let assignment = assignments.iter().find(|a| a.id == g.assignment_id);
            StudentGradeItem {
                assignment_id: g.assignment_id.clone(),
                assignment_title: assignment.map(|a| a.title.clone()).unwrap_or_default(),
                category_name: None,
                due_date: assignment.and_then(|a| a.due_date),
                points_possible: assignment.map(|a| a.points_possible).unwrap_or(0.0),
                score: g.score,
                grade: g.calculated_grade,
                letter_grade: g.letter_grade.clone(),
                status: g.status.clone(),
                submission_status: SubmissionStatus::Submitted,
                feedback: g.feedback.clone(),
                graded_at: g.graded_at,
                has_override: g.has_override,
                excused: g.excused
            }
        }).collect(),
        current_grade: calculate_current_grade(&grades),
        current_letter: calculate_current_grade(&grades).map(|g| grade_to_letter(g)),
        category_grades: vec![],
        grade_trend: vec![]
    })
}

fn calculate_weighted_grade(student_id: &str, course_id: &str, grades: &List<Grade>, assignments: &List<Assignment>, categories: &List<GradeCategory>, scheme: &GradingSchemeResponse) -> Result<GradeCalculationResult, ApiError> {
    let total_earned: f64 = grades.iter().filter_map(|g| g.score).sum();
    let total_possible: f64 = grades.iter().filter_map(|g| {
        assignments.iter().find(|a| a.id == g.assignment_id).map(|a| a.points_possible)
    }).sum();

    let current_grade = if total_possible > 0.0 { (total_earned / total_possible) * 100.0 } else { 0.0 };

    Ok(GradeCalculationResult {
        student_id: student_id.to_string(),
        course_id: course_id.to_string(),
        current_grade,
        current_letter: grade_to_letter(current_grade),
        projected_grade: None,
        category_grades: vec![],
        points_earned: total_earned,
        points_possible: total_possible,
        assignments_graded: grades.len() as i32,
        assignments_total: assignments.len() as i32
    })
}

fn compute_grade_statistics(course_id: &str, grades: &List<Grade>, enrollments: &List<Enrollment>) -> Result<GradeStatisticsResponse, ApiError> {
    let stats = calculate_assignment_statistics(grades);
    Ok(GradeStatisticsResponse {
        course_id: course_id.to_string(),
        total_students: enrollments.len() as i32,
        graded_assignments: 0,
        grade_statistics: stats,
        category_statistics: vec![],
        at_risk_students: vec![]
    })
}

fn compute_grade_distribution(course_id: &str, grades: &List<Grade>) -> Result<GradeDistributionResponse, ApiError> {
    let mut letter_counts: Map<String, i32> = Map::new();
    for grade in grades {
        if let Some(letter) = &grade.letter_grade {
            *letter_counts.entry(letter.clone()).or_insert(0) += 1;
        }
    }

    let total = grades.len() as f64;
    let letter_distribution = letter_counts.iter().map(|(letter, count)| LetterDistribution {
        letter: letter.clone(),
        count: *count,
        percentage: (*count as f64 / total) * 100.0
    }).collect();

    Ok(GradeDistributionResponse {
        course_id: course_id.to_string(),
        letter_distribution,
        score_distribution: vec![],
        histogram_data: vec![]
    })
}

fn generate_grades_csv(grades: &List<Grade>, enrollments: &List<Enrollment>, assignments: &List<Assignment>) -> Result<String, ApiError> {
    let mut csv = String::from("Student ID,Assignment,Score,Grade,Letter\n");
    for grade in grades {
        csv.push_str(&format!("{},{},{},{},{}\n",
            grade.student_id,
            grade.assignment_id,
            grade.score.map(|s| s.to_string()).unwrap_or_default(),
            grade.calculated_grade.map(|g| g.to_string()).unwrap_or_default(),
            grade.letter_grade.clone().unwrap_or_default()
        ));
    }
    Ok(csv)
}

fn generate_grades_excel(grades: &List<Grade>, enrollments: &List<Enrollment>, assignments: &List<Assignment>) -> Result<String, ApiError> {
    Ok(String::new())
}

fn generate_grades_pdf(grades: &List<Grade>, enrollments: &List<Enrollment>, assignments: &List<Assignment>) -> Result<String, ApiError> {
    Ok(String::new())
}

type GradeImportRow {
    student_id: UserId,
    score: f64,
    feedback: Option<String>
}

fn parse_grade_import(data: &str, format: &str) -> Result<List<GradeImportRow>, ApiError> {
    let mut rows = vec![];
    for line in data.lines().skip(1) {
        let parts: Vec<&str> = line.split(',').collect();
        if parts.len() >= 2 {
            if let Ok(score) = parts[1].trim().parse::<f64>() {
                rows.push(GradeImportRow {
                    student_id: parts[0].trim().to_string(),
                    score,
                    feedback: parts.get(2).map(|s| s.trim().to_string())
                });
            }
        }
    }
    Ok(rows)
}

async fn notify_grade_posted(grade: &Grade, assignment: &Assignment) -> Result<(), String> {
    Ok(())
}

