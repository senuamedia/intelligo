async fn find_or_create_oauth_user(
    db: &Database,
    provider: &OAuthProvider,
    oauth_user: &OAuthUserInfo
) -> Result<User, String> {
    let provider_name = match provider {
        OAuthProvider::Google => "google",
        OAuthProvider::Microsoft => "microsoft",
        OAuthProvider::GitHub => "github",
        OAuthProvider::Apple => "apple",
    };

    // Try to find existing user by OAuth provider identity
    let existing = db.user_identities()
        .find_by_provider_id(provider_name, &oauth_user.id)
        .await
        .map_err(|e| e.to_string())?;

    if let Some(identity) = existing {
        // Found existing linked identity, get the user
        let user = db.users()
            .find_by_id(&identity.user_id)
            .await
            .map_err(|e| e.to_string())?
            .ok_or("User linked to identity not found")?;

        // Update last login timestamp
        db.user_identities()
            .update_last_used(&identity.id)
            .await
            .ok();

        return Ok(user);
    }

    // Check if user exists by email
    let existing_user = db.users()
        .find_by_email(&oauth_user.email)
        .await
        .map_err(|e| e.to_string())?;

    if let Some(user) = existing_user {
        // User exists but doesn't have this OAuth provider linked
        // Link the new OAuth identity to existing user
        db.user_identities().create(CreateUserIdentityInput {
            user_id: user.id.clone(),
            provider: provider_name.to_string(),
            provider_user_id: oauth_user.id.clone(),
            email: oauth_user.email.clone(),
            name: oauth_user.name.clone(),
            avatar_url: oauth_user.avatar_url.clone(),
            access_token: None, // Don't store tokens by default
            refresh_token: None,
            expires_at: None,
        }).await.map_err(|e| e.to_string())?;

        return Ok(user);
    }

    // Create new user from OAuth data
    let (first_name, last_name) = if let (Some(first), Some(last)) = (&oauth_user.first_name, &oauth_user.last_name) {
        (first.clone(), last.clone())
    } else {
        // Parse name into first/last
        let parts: Vec<&str> = oauth_user.name.splitn(2, ' ').collect();
        (
            parts.get(0).unwrap_or(&"").to_string(),
            parts.get(1).unwrap_or(&"").to_string()
        )
    };

    // Generate a random password for OAuth users (they won't use it)
    let random_password = format!("oauth_{}", generate_uuid());
    let password_hash = hash_password(&random_password)
        .map_err(|e| e.to_string())?;

    let user = db.users().create(CreateUserInput {
        email: oauth_user.email.clone(),
        password_hash,
        first_name,
        last_name,
        tenant_id: None,
        role: SystemRole::Student,
        email_verified: oauth_user.email_verified, // Trust OAuth provider's verification
    }).await.map_err(|e| e.to_string())?;

    // Set avatar if provided
    if let Some(avatar_url) = &oauth_user.avatar_url {
        db.users()
            .update(&user.id, UpdateUserInput {
                avatar_url: Some(avatar_url.clone()),
                ..Default::default()
            })
            .await
            .ok();
    }

    // Create the OAuth identity link
    db.user_identities().create(CreateUserIdentityInput {
        user_id: user.id.clone(),
        provider: provider_name.to_string(),
        provider_user_id: oauth_user.id.clone(),
        email: oauth_user.email.clone(),
        name: oauth_user.name.clone(),
        avatar_url: oauth_user.avatar_url.clone(),
        access_token: None,
        refresh_token: None,
        expires_at: None,
    }).await.map_err(|e| e.to_string())?;

    Ok(user)
}

