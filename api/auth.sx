/// Redirect to SSO provider
async fn sso_redirect(req: Request, db: Database) -> Result<Response, ApiError> {
    let provider = req.param("provider").ok_or_else(|| ApiError::BadRequest {
        message: "Provider parameter required".to_string()
    })?;

    // Get SSO config from tenant settings
    let tenant_id = req.query_param("tenant");
    let sso_config = get_sso_config(&provider, tenant_id.as_deref()).await?;

    // Generate SAML request or OIDC authorization URL
    let redirect_url = build_sso_redirect_url(&sso_config).await?;

    Ok(Response::redirect(&redirect_url))
}

/// Handle SSO callback
async fn sso_callback(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let provider = req.param("provider").ok_or_else(|| ApiError::BadRequest {
        message: "Provider parameter required".to_string()
    })?;

    // Parse SSO response (SAML assertion or OIDC tokens)
    let sso_user = parse_sso_response(&req, &provider).await
        .map_err(|e| ApiError::Unauthorized {
            message: format!("SSO authentication failed: {}", e)
        })?;

    // Find or create user
    let user = find_or_create_sso_user(&db, &provider, &sso_user).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Generate tokens
    let (access_token, refresh_token) = generate_token_pair(&user, Duration::hours(24))
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = LoginResponse {
        access_token: access_token.token,
        refresh_token: refresh_token.token,
        token_type: "Bearer".to_string(),
        expires_in: access_token.expires_in.as_seconds(),
        user: user_to_info(&user),
        requires_mfa: false,
        mfa_token: None
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// SESSION MANAGEMENT
// =============================================================================

/// List active sessions
async fn list_sessions(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let sessions = db.sessions()
        .find_by_user(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let current_session_id = auth.session_id.clone();

    let session_infos: List<SessionInfo> = sessions.iter().map(|s| SessionInfo {
        id: s.id.clone(),
        device_info: s.device_info.clone(),
        ip_address: s.ip_address.clone(),
        location: s.location.clone(),
        created_at: s.created_at,
        last_activity: s.last_activity,
        is_current: current_session_id.as_ref() == Some(&s.id)
    }).collect();

    Ok(Response::json(ApiResponse::success(session_infos, &ctx)))
}

/// Revoke a specific session
async fn revoke_session(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let session_id = req.param("session_id").ok_or_else(|| ApiError::BadRequest {
        message: "Session ID required".to_string()
    })?;

    // Verify session belongs to user
    let session = db.sessions()
        .find_by_id(&session_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Session".to_string(),
            id: session_id.clone()
        })?;

    if session.user_id != auth.user_id {
        return Err(ApiError::Forbidden {
            message: "Cannot revoke another user's session".to_string(),
            required_permission: None
        })
    }

    // Revoke session
    destroy_session(&session_id).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Session revoked successfully.".to_string()))
    ])))
}

