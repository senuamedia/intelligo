type SsoUser {
    id: String,
    email: String,
    name: String,
    groups: List<String>
}

async fn find_or_create_sso_user(
    db: &Database,
    provider: &str,
    sso_user: &SsoUser
) -> Result<User, String> {
    // SSO users are typically enterprise users, so we need to:
    // 1. Find by SSO external ID
    // 2. Fall back to email lookup
    // 3. Create new user if neither found

    // Try to find by SSO external ID
    let existing = db.users()
        .find_by_external_id(provider, &sso_user.id)
        .await
        .map_err(|e| e.to_string())?;

    if let Some(user) = existing {
        // Update SSO attributes that may have changed
        let updated = db.users()
            .update(&user.id, UpdateUserInput {
                display_name: Some(sso_user.name.clone()),
                sso_groups: Some(sso_user.groups.clone()),
                last_sso_login: Some(DateTime::now()),
                ..Default::default()
            })
            .await
            .map_err(|e| e.to_string())?;

        // Sync group memberships if enabled
        if !sso_user.groups.is_empty() {
            sync_sso_groups(db, &user.id, &sso_user.groups).await.ok();
        }

        return Ok(updated);
    }

    // Try to find by email
    let existing_by_email = db.users()
        .find_by_email(&sso_user.email)
        .await
        .map_err(|e| e.to_string())?;

    if let Some(user) = existing_by_email {
        // Link SSO identity to existing user
        db.users()
            .update(&user.id, UpdateUserInput {
                external_id: Some(sso_user.id.clone()),
                external_provider: Some(provider.to_string()),
                sso_groups: Some(sso_user.groups.clone()),
                last_sso_login: Some(DateTime::now()),
                ..Default::default()
            })
            .await
            .map_err(|e| e.to_string())?;

        // Sync groups
        if !sso_user.groups.is_empty() {
            sync_sso_groups(db, &user.id, &sso_user.groups).await.ok();
        }

        return Ok(user);
    }

    // Determine tenant from SSO configuration
    let tenant_id = db.sso_configs()
        .get_tenant_for_provider(provider)
        .await
        .map_err(|e| e.to_string())?;

    // Parse name into first/last
    let parts: Vec<&str> = sso_user.name.splitn(2, ' ').collect();
    let first_name = parts.get(0).unwrap_or(&"").to_string();
    let last_name = parts.get(1).unwrap_or(&"").to_string();

    // Generate a random password (SSO users authenticate via SSO, not password)
    let random_password = format!("sso_{}", generate_uuid());
    let password_hash = hash_password(&random_password)
        .map_err(|e| e.to_string())?;

    // Determine role from SSO groups
    let role = determine_role_from_groups(&sso_user.groups);

    let user = db.users().create(CreateUserInput {
        email: sso_user.email.clone(),
        password_hash,
        first_name,
        last_name,
        tenant_id,
        role,
        email_verified: true, // SSO users are considered verified
    }).await.map_err(|e| e.to_string())?;

    // Set SSO-specific attributes
    db.users()
        .update(&user.id, UpdateUserInput {
            external_id: Some(sso_user.id.clone()),
            external_provider: Some(provider.to_string()),
            sso_groups: Some(sso_user.groups.clone()),
            auth_method: Some(AuthMethod::SSO { provider: provider.to_string() }),
            last_sso_login: Some(DateTime::now()),
            ..Default::default()
        })
        .await
        .map_err(|e| e.to_string())?;

    // Sync group memberships
    if !sso_user.groups.is_empty() {
        sync_sso_groups(db, &user.id, &sso_user.groups).await.ok();
    }

    Ok(user)
}

/// Sync user's group memberships based on SSO groups
async fn sync_sso_groups(db: &Database, user_id: &UserId, sso_groups: &List<String>) -> Result<(), String> {
    // Get group mapping configuration
    let mappings = db.sso_group_mappings()
        .get_all()
        .await
        .map_err(|e| e.to_string())?;

    let mut target_roles: List<SystemRole> = vec![];
    let mut target_course_enrollments: List<(CourseId, CourseRole)> = vec![];

    for sso_group in sso_groups {
        for mapping in &mappings {
            if mapping.sso_group == *sso_group {
                match &mapping.target {
                    GroupMappingTarget::SystemRole(role) => {
                        if !target_roles.contains(role) {
                            target_roles.push(role.clone());
                        }
                    }
                    GroupMappingTarget::CourseEnrollment { course_id, role } => {
                        target_course_enrollments.push((course_id.clone(), role.clone()));
                    }
                }
            }
        }
    }

    // Update system roles
    if !target_roles.is_empty() {
        db.users()
            .set_roles(user_id, &target_roles)
            .await
            .map_err(|e| e.to_string())?;
    }

    // Create/update course enrollments
    for (course_id, role) in target_course_enrollments {
        db.enrollments()
            .upsert_sso_enrollment(user_id, &course_id, &role)
            .await
            .ok();
    }

    Ok(())
}

/// Determine initial system role from SSO groups
fn determine_role_from_groups(groups: &List<String>) -> SystemRole {
    // Check for admin-like groups
    let admin_patterns = ["admin", "administrator", "superuser", "super_admin"];
    for group in groups {
        let lower = group.to_lowercase();
        for pattern in &admin_patterns {
            if lower.contains(pattern) {
                return SystemRole::Admin;
            }
        }
    }

    // Check for instructor/teacher groups
    let instructor_patterns = ["instructor", "teacher", "faculty", "professor"];
    for group in groups {
        let lower = group.to_lowercase();
        for pattern in &instructor_patterns {
            if lower.contains(pattern) {
                return SystemRole::Instructor;
            }
        }
    }

    // Check for staff groups
    let staff_patterns = ["staff", "support", "helpdesk"];
    for group in groups {
        let lower = group.to_lowercase();
        for pattern in &staff_patterns {
            if lower.contains(pattern) {
                return SystemRole::Staff;
            }
        }
    }

    // Default to student
    SystemRole::Student
}

/// Group mapping target type
enum GroupMappingTarget {
    SystemRole(SystemRole),
    CourseEnrollment { course_id: CourseId, role: CourseRole }
}

