/// Update current user
async fn update_current_user(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    #[derive(Deserialize)]
    struct UpdateUserRequest {
        first_name: Option<String>,
        last_name: Option<String>,
        display_name: Option<String>,
        phone: Option<String>,
        timezone: Option<String>,
        locale: Option<String>,
        bio: Option<String>
    }

    let body: UpdateUserRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let user = db.users()
        .update(&auth.user_id, UpdateUserInput {
            first_name: body.first_name,
            last_name: body.last_name,
            display_name: body.display_name,
            phone: body.phone,
            timezone: body.timezone,
            locale: body.locale,
            bio: body.bio,
            ..Default::default()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(user_to_info(&user), &ctx)))
}

// =============================================================================
// MFA ENDPOINTS
// =============================================================================

/// Setup MFA for current user
async fn setup_mfa(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    // Generate TOTP secret
    let secret = generate_totp_secret();
    let qr_code_url = generate_totp_qr_url(&auth.user_id, &secret);
    let backup_codes = generate_backup_codes(10);

    // Store pending MFA setup (not activated yet)
    db.users()
        .store_pending_mfa(&auth.user_id, &secret, &backup_codes)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = MfaSetupResponse {
        secret,
        qr_code_url,
        backup_codes
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Verify and activate MFA
async fn verify_mfa(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: MfaVerifyRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Handle MFA verification during login (with mfa_token)
    if let Some(mfa_token) = body.mfa_token {
        return verify_login_mfa(&db, &ctx, &mfa_token, &body.code).await
    }

    // Handle MFA activation (authenticated user)
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    // Get pending MFA secret
    let pending = db.users()
        .get_pending_mfa(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::BadRequest {
            message: "No pending MFA setup found".to_string()
        })?;

    // Verify code against pending secret
    if !verify_totp(&pending.secret, &body.code) {
        return Err(ApiError::Unauthorized {
            message: "Invalid verification code".to_string()
        })
    }

    // Activate MFA
    db.users()
        .activate_mfa(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("MFA enabled successfully.".to_string()))
    ])))
}

/// Verify MFA during login
async fn verify_login_mfa(
    db: &Database,
    ctx: &RequestContext,
    mfa_token: &str,
    code: &str
) -> Result<Response, ApiError> {
    // Validate MFA token and get user ID
    let user_id = validate_mfa_token(mfa_token)
        .map_err(|e| ApiError::Unauthorized {
            message: "Invalid or expired MFA token".to_string()
        })?;

    // Get user
    let user = db.users()
        .find_by_id(&user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: user_id.to_string()
        })?;

    // Verify code
    let mfa_valid = verify_mfa_code(&user, code)
        .map_err(|e| ApiError::Unauthorized {
            message: "Invalid MFA code".to_string()
        })?;

    if !mfa_valid {
        return Err(ApiError::Unauthorized {
            message: "Invalid MFA code".to_string()
        })
    }

    // Generate tokens
    let (access_token, refresh_token) = generate_token_pair(&user, Duration::hours(24))
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = LoginResponse {
        access_token: access_token.token,
        refresh_token: refresh_token.token,
        token_type: "Bearer".to_string(),
        expires_in: access_token.expires_in.as_seconds(),
        user: user_to_info(&user),
        requires_mfa: false,
        mfa_token: None
    };

    Ok(Response::json(ApiResponse::success(response, ctx)))
}

/// Disable MFA
async fn disable_mfa(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    #[derive(Deserialize)]
    struct DisableMfaRequest {
        password: String,
        code: String
    }

    let body: DisableMfaRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Get user
    let user = db.users()
        .find_by_id(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: auth.user_id.to_string()
        })?;

    // Verify password
    let password_valid = verify_password(&body.password, &user.password_hash)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if !password_valid {
        return Err(ApiError::Unauthorized {
            message: "Invalid password".to_string()
        })
    }

    // Verify MFA code
    let mfa_valid = verify_mfa_code(&user, &body.code)
        .map_err(|e| ApiError::Unauthorized {
            message: "Invalid MFA code".to_string()
        })?;

    if !mfa_valid {
        return Err(ApiError::Unauthorized {
            message: "Invalid MFA code".to_string()
        })
    }

    // Disable MFA
    db.users()
        .disable_mfa(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("MFA disabled successfully.".to_string()))
    ])))
}

/// Get MFA recovery codes
async fn get_recovery_codes(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
