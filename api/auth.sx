        .get_recovery_codes(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(codes, &ctx)))
}

/// Regenerate MFA recovery codes
async fn regenerate_recovery_codes(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    #[derive(Deserialize)]
    struct RegenerateRequest {
        password: String
    }

    let body: RegenerateRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Get user
    let user = db.users()
        .find_by_id(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: auth.user_id.to_string()
        })?;

    // Verify password
    let password_valid = verify_password(&body.password, &user.password_hash)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if !password_valid {
        return Err(ApiError::Unauthorized {
            message: "Invalid password".to_string()
        })
    }

    // Generate new codes
    let new_codes = generate_backup_codes(10);

    // Store new codes
    db.users()
        .update_recovery_codes(&auth.user_id, &new_codes)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(new_codes, &ctx)))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

/// Convert user to info struct
fn user_to_info(user: &User) -> UserInfo {
    UserInfo {
        id: user.id.clone(),
        email: user.email.clone(),
        name: format!("{} {}", user.first_name, user.last_name),
        first_name: user.first_name.clone(),
        last_name: user.last_name.clone(),
        avatar_url: user.avatar_url.clone(),
        roles: user.roles.clone(),
        permissions: user.get_permission_strings(),
        tenant_id: user.primary_tenant_id.clone(),
        email_verified: user.email_verified,
        mfa_enabled: user.mfa_enabled
    }
}

/// Validate email format
fn is_valid_email(email: &str) -> Bool {
    // Basic email validation
    email.contains('@') && email.contains('.') && email.len() >= 5
}

/// Check password strength
fn is_strong_password(password: &str) -> Bool {
    if password.len() < 8 {
        return false
    }

    let has_upper = password.chars().any(|c| c.is_uppercase());
    let has_lower = password.chars().any(|c| c.is_lowercase());
    let has_digit = password.chars().any(|c| c.is_numeric());
    let has_special = password.chars().any(|c| !c.is_alphanumeric());

    has_upper && has_lower && has_digit && has_special
}

/// Extract token from request
fn extract_token_from_request(req: &Request) -> Option<String> {
    if let Some(auth_header) = req.header("Authorization") {
        if auth_header.starts_with("Bearer ") {
            return Some(auth_header[7..].to_string())
        }
    }
    None
}

// Placeholder functions for external services
fn generate_verification_token(user_id: &UserId) -> String {
    format!("verify_{}", generate_uuid())
}

fn generate_password_reset_token(user_id: &UserId) -> String {
    format!("reset_{}", generate_uuid())
}

fn generate_mfa_token(user_id: &UserId) -> String {
    // Create a short-lived JWT for MFA challenge
    let now = std::time::now().as_secs() as i64;
    let exp = now + 300; // 5 minutes expiration

    let header = base64::encode_url_safe(r#"{"alg":"HS256","typ":"JWT"}"#);

    let payload = std::json::to_string(&Map::from([
        ("sub".to_string(), Dynamic::String(user_id.0.clone())),
        ("type".to_string(), Dynamic::String("mfa_challenge".to_string())),
        ("iat".to_string(), Dynamic::Int(now)),
        ("exp".to_string(), Dynamic::Int(exp)),
        ("jti".to_string(), Dynamic::String(generate_uuid()))
    ])).unwrap_or_default();

    let payload_b64 = base64::encode_url_safe(&payload);

    // Sign with MFA token secret
    let mfa_secret = std::env::var("MFA_TOKEN_SECRET")
        .unwrap_or_else(|_| "default_mfa_secret_change_in_production".to_string());

    let header_payload = format!("{}.{}", header, payload_b64);
    let signature = std::crypto::hmac_sha256(mfa_secret.as_bytes(), header_payload.as_bytes());
    let signature_b64 = base64::encode_url_safe(&signature);

    format!("mfa_{}.{}.{}", header, payload_b64, signature_b64)
}

fn validate_mfa_token(token: &str) -> Result<UserId, String> {
    // MFA tokens are short-lived JWTs that grant access to complete MFA flow
    // Format: mfa_<jwt>

    if !token.starts_with("mfa_") {
        return Err("Invalid MFA token format".to_string());
    }

    let jwt_part = &token[4..];

    // Parse JWT structure
    let parts: Vec<&str> = jwt_part.split('.').collect();
    if parts.len() != 3 {
        return Err("Invalid MFA token JWT structure".to_string());
    }

    // Decode payload
    let payload_bytes = base64::decode_url_safe(parts[1])
        .map_err(|e| format!("Failed to decode MFA token payload: {}", e))?;

    let payload_str = String::from_utf8(payload_bytes)
        .map_err(|e| format!("Invalid UTF-8 in MFA token: {}", e))?;

    let claims: Map<String, Dynamic> = std::json::from_str(&payload_str)
        .map_err(|e| format!("Failed to parse MFA token claims: {}", e))?;

    // Check expiration
    if let Some(exp) = claims.get("exp").and_then(|v| v.as_i64()) {
        let now = std::time::now().as_secs() as i64;
        if now > exp {
            return Err("MFA token has expired".to_string());
        }
    } else {
        return Err("MFA token missing expiration".to_string());
    }

    // Check token type
    if claims.get("type").and_then(|v| v.as_str()) != Some("mfa_challenge") {
        return Err("Invalid MFA token type".to_string());
    }

    // Extract user ID
    let user_id = claims.get("sub")
        .and_then(|v| v.as_str())
        .ok_or("MFA token missing subject claim")?;

    // Verify signature against MFA secret
    let mfa_secret = std::env::var("MFA_TOKEN_SECRET")
        .map_err(|_| "MFA token secret not configured")?;

    let header_payload = format!("{}.{}", parts[0], parts[1]);
    let signature = base64::decode_url_safe(parts[2])
        .map_err(|_| "Invalid MFA token signature encoding")?;

    let expected = std::crypto::hmac_sha256(mfa_secret.as_bytes(), header_payload.as_bytes());

    if !std::crypto::constant_time_eq(&signature, &expected) {
        return Err("Invalid MFA token signature".to_string());
    }

    Ok(UserId(user_id.to_string()))
}

fn verify_mfa_code(user: &User, code: &str) -> Result<Bool, String> {
    // Check if code is a recovery code first
    if code.len() == 8 && code.chars().all(|c| c.is_numeric()) {
        return verify_recovery_code(user, code);
    }

    // Otherwise verify as TOTP code
    verify_totp_code(user, code)
}

fn verify_totp_code(user: &User, code: &str) -> Result<Bool, String> {
    // TOTP codes are 6 digits
    if code.len() != 6 || !code.chars().all(|c| c.is_numeric()) {
        return Ok(false);
    }

    let secret = user.mfa_secret.as_ref()
        .ok_or("User does not have MFA configured")?;

    // Decode the base32 secret
    let secret_bytes = base32::decode(secret)
        .ok_or("Invalid MFA secret format")?;

    // Get current time step (30 seconds per step)
    let now = std::time::now().as_secs();
    let time_step = now / 30;

    // Check current time step and adjacent steps for clock skew tolerance
    for offset in [-1i64, 0, 1] {
        let check_step = (time_step as i64 + offset) as u64;
        let expected_code = generate_totp(&secret_bytes, check_step);

        if code == expected_code {
            return Ok(true);
        }
    }

    Ok(false)
}

fn generate_totp(secret: &[u8], time_step: u64) -> String {
    // HMAC-SHA1 based TOTP generation (RFC 6238)
    let time_bytes = time_step.to_be_bytes();

    let hmac = std::crypto::hmac_sha1(secret, &time_bytes);

    // Dynamic truncation
    let offset = (hmac[19] & 0x0f) as usize;
    let binary = ((hmac[offset] & 0x7f) as u32) << 24
        | (hmac[offset + 1] as u32) << 16
        | (hmac[offset + 2] as u32) << 8
        | (hmac[offset + 3] as u32);

    // Generate 6-digit code
    let code = binary % 1_000_000;
    format!("{:06}", code)
}

fn verify_recovery_code(user: &User, code: &str) -> Result<Bool, String> {
    // Recovery codes are stored hashed
    let code_hash = std::crypto::sha256(code.as_bytes());
    let hash_hex = std::hex::encode(&code_hash);

    // Check against stored recovery codes
    if let Some(ref recovery_codes) = user.recovery_codes {
        for stored in recovery_codes {
            if stored.hash == hash_hex && !stored.used {
                // Mark code as used (would need database update)
                return Ok(true);
            }
        }
    }

    Ok(false)
}

fn generate_totp_secret() -> String {
    // Would generate base32 secret
    "JBSWY3DPEHPK3PXP".to_string()
}

