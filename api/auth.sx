/// Intelligo LMS - Authentication API
///
/// This module provides authentication endpoints:
/// - Login (email/password, SSO, OAuth)
/// - Registration
/// - Password reset
/// - Token refresh
/// - Logout
/// - OAuth callbacks

module intelligo::api::auth

use intelligo::core::types::*
use intelligo::core::auth::{
    AuthContext, Session, Token, TokenType, AuthProvider,
    hash_password, verify_password, generate_token_pair,
    validate_token, refresh_token as refresh_auth_token, revoke_token,
    create_session, destroy_session, validate_session,
    OAuthProvider, OAuthConfig, OAuthToken
}
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the authentication router
pub fn router(db: Database) -> Router {
    Router::new()
        // Public endpoints (no auth required)
        .post("/login", move |req| login(req, db.clone()))
        .post("/register", move |req| register(req, db.clone()))
        .post("/forgot-password", move |req| forgot_password(req, db.clone()))
        .post("/reset-password", move |req| reset_password(req, db.clone()))
        .post("/verify-email", move |req| verify_email(req, db.clone()))
        .post("/resend-verification", move |req| resend_verification(req, db.clone()))

        // Token management
        .post("/refresh", move |req| refresh(req, db.clone()))
        .post("/logout", move |req| logout(req, db.clone()))
        .post("/logout-all", move |req| logout_all(req, db.clone()))

        // OAuth endpoints
        .get("/oauth/:provider", move |req| oauth_redirect(req, db.clone()))
        .get("/oauth/:provider/callback", move |req| oauth_callback(req, db.clone()))
        .post("/oauth/:provider/token", move |req| oauth_token_exchange(req, db.clone()))

        // SSO endpoints
        .get("/sso/:provider", move |req| sso_redirect(req, db.clone()))
        .post("/sso/:provider/callback", move |req| sso_callback(req, db.clone()))

        // Session management (authenticated)
        .get("/sessions", move |req| list_sessions(req, db.clone()))
        .delete("/sessions/:session_id", move |req| revoke_session(req, db.clone()))

        // Current user info
        .get("/me", move |req| get_current_user(req, db.clone()))
        .patch("/me", move |req| update_current_user(req, db.clone()))
        .post("/me/change-password", move |req| change_password(req, db.clone()))

        // MFA endpoints
        .post("/mfa/setup", move |req| setup_mfa(req, db.clone()))
        .post("/mfa/verify", move |req| verify_mfa(req, db.clone()))
        .post("/mfa/disable", move |req| disable_mfa(req, db.clone()))
        .get("/mfa/recovery-codes", move |req| get_recovery_codes(req, db.clone()))
        .post("/mfa/recovery-codes/regenerate", move |req| regenerate_recovery_codes(req, db.clone()))
}

// =============================================================================
// REQUEST/RESPONSE TYPES
// =============================================================================

/// Login request
type LoginRequest {
    email: String,
    password: String,
    remember_me: Option<Bool>,
    mfa_code: Option<String>,
    device_info: Option<DeviceInfo>
}

/// Device information for session tracking
type DeviceInfo {
    device_type: Option<String>,
    device_name: Option<String>,
    os: Option<String>,
    browser: Option<String>
}

/// Login response
type LoginResponse {
    access_token: String,
    refresh_token: String,
    token_type: String,
    expires_in: i64,
    user: UserInfo,
    requires_mfa: Bool,
    mfa_token: Option<String>
}

/// User info for auth responses
type UserInfo {
    id: UserId,
    email: String,
    name: String,
    first_name: String,
    last_name: String,
    avatar_url: Option<String>,
    roles: List<SystemRole>,
    permissions: List<String>,
    tenant_id: Option<TenantId>,
    email_verified: Bool,
    mfa_enabled: Bool
}

/// Registration request
type RegisterRequest {
    email: String,
    password: String,
    first_name: String,
    last_name: String,
    invite_code: Option<String>,
    tenant_code: Option<String>,
    accept_terms: Bool
}

/// Registration response
type RegisterResponse {
    user: UserInfo,
    access_token: Option<String>,
    refresh_token: Option<String>,
    requires_verification: Bool,
    message: String
}

/// Password reset request
type ForgotPasswordRequest {
    email: String
}

/// Reset password request
type ResetPasswordRequest {
    token: String,
    password: String,
    password_confirmation: String
}

/// Change password request
type ChangePasswordRequest {
    current_password: String,
    new_password: String,
    new_password_confirmation: String
}

/// Token refresh request
type RefreshRequest {
    refresh_token: String
}

/// Token refresh response
type RefreshResponse {
    access_token: String,
    refresh_token: String,
    token_type: String,
    expires_in: i64
}

/// Email verification request
type VerifyEmailRequest {
    token: String
}

/// MFA setup response
type MfaSetupResponse {
    secret: String,
    qr_code_url: String,
    backup_codes: List<String>
}

/// MFA verify request
type MfaVerifyRequest {
    code: String,
    mfa_token: Option<String>
}

/// Session info
type SessionInfo {
    id: String,
    device_info: Option<DeviceInfo>,
    ip_address: String,
    location: Option<String>,
    created_at: DateTime,
    last_activity: DateTime,
    is_current: Bool
}

// =============================================================================
// LOGIN ENDPOINT
// =============================================================================

/// Handle user login
async fn login(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    // Parse request body
    let body: LoginRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate input
    validate_login_input(&body)?;

    // Find user by email
    let user = db.users()
        .find_by_email(&body.email)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Unauthorized {
            message: "Invalid email or password".to_string()
        })?;

    // Check if account is active
    if !user.is_active {
        return Err(ApiError::Unauthorized {
            message: "Account is disabled. Please contact support.".to_string()
        })
    }

    // Check if account is locked
    if user.is_locked() {
        return Err(ApiError::Unauthorized {
            message: "Account is temporarily locked due to too many failed login attempts.".to_string()
        })
    }

    // Verify password
    let password_valid = verify_password(&body.password, &user.password_hash)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if !password_valid {
        // Record failed attempt
        db.users().record_failed_login(&user.id).await.ok();

        return Err(ApiError::Unauthorized {
            message: "Invalid email or password".to_string()
        })
    }

    // Check MFA if enabled
    if user.mfa_enabled {
        if let Some(mfa_code) = body.mfa_code {
            // Verify MFA code
            let mfa_valid = verify_mfa_code(&user, &mfa_code)
                .map_err(|e| ApiError::Unauthorized {
                    message: "Invalid MFA code".to_string()
                })?;

            if !mfa_valid {
                return Err(ApiError::Unauthorized {
                    message: "Invalid MFA code".to_string()
                })
            }
        } else {
            // MFA required but not provided - return partial response
            let mfa_token = generate_mfa_token(&user.id);

            return Ok(Response::json(LoginResponse {
                access_token: "".to_string(),
                refresh_token: "".to_string(),
                token_type: "Bearer".to_string(),
                expires_in: 0,
                user: user_to_info(&user),
                requires_mfa: true,
                mfa_token: Some(mfa_token)
            }).with_status(StatusCode::OK))
        }
    }

    // Generate tokens
    let token_duration = if body.remember_me.unwrap_or(false) {
        Duration::days(30)
    } else {
        Duration::hours(24)
    };

    let (access_token, refresh_token) = generate_token_pair(&user, token_duration)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Create session
    let session = create_session(
        &user.id,
        &ctx.ip_address,
        body.device_info.as_ref()
    ).await.map_err(|e| ApiError::InternalError {
        message: e.to_string(),
        trace_id: ctx.trace_id.clone()
    })?;

    // Record successful login
    db.users().record_successful_login(&user.id, &ctx.ip_address).await.ok();

    // Build response
    let response = LoginResponse {
        access_token: access_token.token,
        refresh_token: refresh_token.token,
        token_type: "Bearer".to_string(),
        expires_in: access_token.expires_in.as_seconds(),
        user: user_to_info(&user),
        requires_mfa: false,
        mfa_token: None
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Validate login input
fn validate_login_input(input: &LoginRequest) -> Result<(), ApiError> {
    let mut errors = vec![];

    if input.email.is_empty() {
        errors.push(FieldError {
            field: "email".to_string(),
            code: "required".to_string(),
            message: "Email is required".to_string()
        });
    } else if !is_valid_email(&input.email) {
        errors.push(FieldError {
            field: "email".to_string(),
            code: "invalid".to_string(),
            message: "Invalid email format".to_string()
        });
    }

    if input.password.is_empty() {
        errors.push(FieldError {
            field: "password".to_string(),
            code: "required".to_string(),
            message: "Password is required".to_string()
        });
    }

    if !errors.is_empty() {
        return Err(ApiError::ValidationError {
            field: "".to_string(),
            message: "Validation failed".to_string(),
            errors
        })
    }

    Ok(())
}

// =============================================================================
// REGISTRATION ENDPOINT
// =============================================================================

/// Handle user registration
async fn register(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    // Parse request body
    let body: RegisterRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate input
    validate_register_input(&body)?;

    // Check terms acceptance
    if !body.accept_terms {
        return Err(ApiError::ValidationError {
            field: "accept_terms".to_string(),
            message: "You must accept the terms of service".to_string(),
            errors: vec![FieldError {
                field: "accept_terms".to_string(),
                code: "required".to_string(),
                message: "Terms acceptance is required".to_string()
            }]
        })
    }

    // Check if email already exists
    let existing = db.users()
        .find_by_email(&body.email)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if existing.is_some() {
        return Err(ApiError::Conflict {
            message: "An account with this email already exists".to_string()
        })
    }

    // Hash password
    let password_hash = hash_password(&body.password)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Determine tenant
    let tenant_id = if let Some(code) = body.tenant_code {
        db.tenants()
            .find_by_code(&code)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
            .map(|t| t.id)
    } else {
        None
    };

    // Handle invite code
    let invite = if let Some(code) = &body.invite_code {
        db.invites()
            .find_by_code(code)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    } else {
        None
    };

    // Create user
    let user = db.users().create(CreateUserInput {
        email: body.email.clone(),
        password_hash,
        first_name: body.first_name.clone(),
        last_name: body.last_name.clone(),
        tenant_id,
        role: SystemRole::Student,
        email_verified: false
    }).await.map_err(|e| ApiError::InternalError {
        message: e.to_string(),
        trace_id: ctx.trace_id.clone()
    })?;

    // Process invite if present
    if let Some(invite) = invite {
        db.invites().mark_used(&invite.id, &user.id).await.ok();

        // Auto-enroll if invite has course
        if let Some(course_id) = invite.course_id {
            db.enrollments().create(CreateEnrollmentInput {
                course_id,
                user_id: user.id.clone(),
                role: invite.role.unwrap_or(CourseRole::Student),
                section_id: invite.section_id,
                start_date: None,
                end_date: None,
                source: EnrollmentSource::Invite,
                external_id: None,
                metadata: None
            }).await.ok();
        }
    }

    // Send verification email
    let verification_token = generate_verification_token(&user.id);
    send_verification_email(&user.email, &user.first_name, &verification_token).await.ok();

    // Build response (don't auto-login if email verification required)
    let requires_verification = true; // Could be configurable

    let response = if requires_verification {
        RegisterResponse {
            user: user_to_info(&user),
            access_token: None,
            refresh_token: None,
            requires_verification: true,
            message: "Registration successful. Please check your email to verify your account.".to_string()
        }
    } else {
        // Auto-login
        let (access_token, refresh_token) = generate_token_pair(&user, Duration::hours(24))
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?;

        RegisterResponse {
            user: user_to_info(&user),
            access_token: Some(access_token.token),
            refresh_token: Some(refresh_token.token),
            requires_verification: false,
            message: "Registration successful.".to_string()
        }
    };

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Validate registration input
fn validate_register_input(input: &RegisterRequest) -> Result<(), ApiError> {
    let mut errors = vec![];

    if input.email.is_empty() {
        errors.push(FieldError {
            field: "email".to_string(),
            code: "required".to_string(),
            message: "Email is required".to_string()
        });
    } else if !is_valid_email(&input.email) {
        errors.push(FieldError {
            field: "email".to_string(),
            code: "invalid".to_string(),
            message: "Invalid email format".to_string()
        });
    }

    if input.password.is_empty() {
        errors.push(FieldError {
            field: "password".to_string(),
            code: "required".to_string(),
            message: "Password is required".to_string()
        });
    } else if input.password.len() < 8 {
        errors.push(FieldError {
            field: "password".to_string(),
            code: "too_short".to_string(),
            message: "Password must be at least 8 characters".to_string()
        });
    } else if !is_strong_password(&input.password) {
        errors.push(FieldError {
            field: "password".to_string(),
            code: "weak".to_string(),
            message: "Password must contain uppercase, lowercase, number, and special character".to_string()
        });
    }

    if input.first_name.is_empty() {
        errors.push(FieldError {
            field: "first_name".to_string(),
            code: "required".to_string(),
            message: "First name is required".to_string()
        });
    }

    if input.last_name.is_empty() {
        errors.push(FieldError {
            field: "last_name".to_string(),
            code: "required".to_string(),
            message: "Last name is required".to_string()
        });
    }

    if !errors.is_empty() {
        return Err(ApiError::ValidationError {
            field: "".to_string(),
            message: "Validation failed".to_string(),
            errors
        })
    }

    Ok(())
}

// =============================================================================
// PASSWORD RESET ENDPOINTS
// =============================================================================

/// Handle forgot password request
async fn forgot_password(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: ForgotPasswordRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Always return success to prevent email enumeration
    let response_message = "If an account exists with this email, you will receive a password reset link.";

    // Find user (don't reveal if not found)
    let user = db.users()
        .find_by_email(&body.email)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if let Some(user) = user {
        // Generate reset token
        let reset_token = generate_password_reset_token(&user.id);

        // Store reset token
        db.password_resets().create(&user.id, &reset_token, Duration::hours(24)).await.ok();

        // Send email
        send_password_reset_email(&user.email, &user.first_name, &reset_token).await.ok();
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String(response_message.to_string()))
    ])))
}

/// Handle password reset
async fn reset_password(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: ResetPasswordRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate passwords match
    if body.password != body.password_confirmation {
        return Err(ApiError::ValidationError {
            field: "password_confirmation".to_string(),
            message: "Passwords do not match".to_string(),
            errors: vec![FieldError {
                field: "password_confirmation".to_string(),
                code: "mismatch".to_string(),
                message: "Passwords do not match".to_string()
            }]
        })
    }

    // Validate password strength
    if !is_strong_password(&body.password) {
        return Err(ApiError::ValidationError {
            field: "password".to_string(),
            message: "Password is too weak".to_string(),
            errors: vec![FieldError {
                field: "password".to_string(),
                code: "weak".to_string(),
                message: "Password must contain uppercase, lowercase, number, and special character".to_string()
            }]
        })
    }

    // Find and validate reset token
    let reset = db.password_resets()
        .find_by_token(&body.token)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::BadRequest {
            message: "Invalid or expired reset token".to_string()
        })?;

    // Check if expired
    if reset.is_expired() {
        return Err(ApiError::BadRequest {
            message: "Reset token has expired".to_string()
        })
    }

    // Hash new password
    let password_hash = hash_password(&body.password)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Update password
    db.users()
        .update_password(&reset.user_id, &password_hash)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Invalidate all sessions for security
    db.sessions().revoke_all_for_user(&reset.user_id).await.ok();

    // Mark reset token as used
    db.password_resets().mark_used(&body.token).await.ok();

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Password has been reset successfully.".to_string()))
    ])))
}

/// Handle password change (authenticated)
async fn change_password(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    // Require authentication
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let body: ChangePasswordRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate passwords match
    if body.new_password != body.new_password_confirmation {
        return Err(ApiError::ValidationError {
            field: "new_password_confirmation".to_string(),
            message: "Passwords do not match".to_string(),
            errors: vec![FieldError {
                field: "new_password_confirmation".to_string(),
                code: "mismatch".to_string(),
                message: "Passwords do not match".to_string()
            }]
        })
    }

    // Get user
    let user = db.users()
        .find_by_id(&auth.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: auth.user_id.to_string()
        })?;

    // Verify current password
    let current_valid = verify_password(&body.current_password, &user.password_hash)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if !current_valid {
        return Err(ApiError::Unauthorized {
            message: "Current password is incorrect".to_string()
        })
    }

    // Validate new password strength
    if !is_strong_password(&body.new_password) {
        return Err(ApiError::ValidationError {
            field: "new_password".to_string(),
            message: "Password is too weak".to_string(),
            errors: vec![FieldError {
                field: "new_password".to_string(),
                code: "weak".to_string(),
                message: "Password must contain uppercase, lowercase, number, and special character".to_string()
            }]
        })
    }

    // Hash and update password
    let password_hash = hash_password(&body.new_password)
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    db.users()
        .update_password(&auth.user_id, &password_hash)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Password changed successfully.".to_string()))
    ])))
}

// =============================================================================
// TOKEN MANAGEMENT
// =============================================================================

/// Refresh access token
async fn refresh(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: RefreshRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate and refresh token
    let (new_access, new_refresh) = refresh_auth_token(&body.refresh_token)
        .await
        .map_err(|e| ApiError::Unauthorized {
            message: "Invalid or expired refresh token".to_string()
        })?;

    let response = RefreshResponse {
        access_token: new_access.token,
        refresh_token: new_refresh.token,
        token_type: "Bearer".to_string(),
        expires_in: new_access.expires_in.as_seconds()
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Logout (invalidate current token)
async fn logout(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    // Get token from request
    if let Some(token) = extract_token_from_request(&req) {
        // Revoke the token
        revoke_token(&token).await.ok();
    }

    // Destroy session if exists
    if let Some(auth) = &ctx.auth {
        if let Some(session_id) = &auth.session_id {
            destroy_session(session_id).await.ok();
        }
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Logged out successfully.".to_string()))
    ])))
}

/// Logout from all devices
async fn logout_all(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    // Revoke all tokens for user
    db.tokens().revoke_all_for_user(&auth.user_id).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Destroy all sessions
    db.sessions().revoke_all_for_user(&auth.user_id).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Logged out from all devices.".to_string()))
    ])))
}

// =============================================================================
// EMAIL VERIFICATION
// =============================================================================

/// Verify email address
async fn verify_email(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: VerifyEmailRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Find verification record
    let verification = db.email_verifications()
        .find_by_token(&body.token)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::BadRequest {
            message: "Invalid or expired verification token".to_string()
        })?;

    // Check if expired
    if verification.is_expired() {
        return Err(ApiError::BadRequest {
            message: "Verification token has expired".to_string()
        })
    }

    // Mark email as verified
    db.users()
        .verify_email(&verification.user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Mark token as used
    db.email_verifications().mark_used(&body.token).await.ok();

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Email verified successfully.".to_string()))
    ])))
}

/// Resend verification email
async fn resend_verification(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    #[derive(Deserialize)]
    struct ResendRequest {
        email: String
    }

    let body: ResendRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Find user
    let user = db.users()
        .find_by_email(&body.email)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if let Some(user) = user {
        if !user.email_verified {
            // Generate new token
            let token = generate_verification_token(&user.id);

            // Send email
            send_verification_email(&user.email, &user.first_name, &token).await.ok();
        }
    }

    // Always return success to prevent enumeration
    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("If the email exists and is not verified, a verification email has been sent.".to_string()))
    ])))
}

// =============================================================================
// OAUTH ENDPOINTS
// =============================================================================

/// Redirect to OAuth provider
async fn oauth_redirect(req: Request, db: Database) -> Result<Response, ApiError> {
    let provider = req.param("provider").ok_or_else(|| ApiError::BadRequest {
        message: "Provider parameter required".to_string()
    })?;

    let oauth_provider = parse_oauth_provider(&provider)?;
    let config = get_oauth_config(&oauth_provider)?;

    // Generate state token for CSRF protection
    let state = generate_oauth_state();

    // Build authorization URL
    let auth_url = build_oauth_auth_url(&config, &state);

    // Store state for verification
    store_oauth_state(&state, &provider).await;

    Ok(Response::redirect(&auth_url))
}

/// Handle OAuth callback
async fn oauth_callback(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let provider = req.param("provider").ok_or_else(|| ApiError::BadRequest {
        message: "Provider parameter required".to_string()
    })?;

    let code = req.query_param("code").ok_or_else(|| ApiError::BadRequest {
        message: "Authorization code required".to_string()
    })?;

    let state = req.query_param("state").ok_or_else(|| ApiError::BadRequest {
        message: "State parameter required".to_string()
    })?;

    // Verify state
    if !verify_oauth_state(&state).await {
        return Err(ApiError::BadRequest {
            message: "Invalid state parameter".to_string()
        })
    }

    let oauth_provider = parse_oauth_provider(&provider)?;
    let config = get_oauth_config(&oauth_provider)?;

    // Exchange code for tokens
    let oauth_tokens = exchange_oauth_code(&config, &code).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Get user info from provider
    let oauth_user = get_oauth_user_info(&config, &oauth_tokens.access_token).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Find or create user
    let user = find_or_create_oauth_user(&db, &oauth_provider, &oauth_user).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Generate tokens
    let (access_token, refresh_token) = generate_token_pair(&user, Duration::hours(24))
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Create session
    create_session(&user.id, &ctx.ip_address, None).await.ok();

    let response = LoginResponse {
        access_token: access_token.token,
        refresh_token: refresh_token.token,
        token_type: "Bearer".to_string(),
        expires_in: access_token.expires_in.as_seconds(),
        user: user_to_info(&user),
        requires_mfa: false,
        mfa_token: None
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Exchange OAuth token (for mobile apps)
async fn oauth_token_exchange(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let provider = req.param("provider").ok_or_else(|| ApiError::BadRequest {
        message: "Provider parameter required".to_string()
    })?;

    #[derive(Deserialize)]
    struct TokenExchangeRequest {
        access_token: String
    }

    let body: TokenExchangeRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let oauth_provider = parse_oauth_provider(&provider)?;
    let config = get_oauth_config(&oauth_provider)?;

    // Get user info using the provided token
    let oauth_user = get_oauth_user_info(&config, &body.access_token).await
        .map_err(|e| ApiError::Unauthorized {
            message: "Invalid OAuth token".to_string()
        })?;

    // Find or create user
    let user = find_or_create_oauth_user(&db, &oauth_provider, &oauth_user).await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Generate our tokens
    let (access_token, refresh_token) = generate_token_pair(&user, Duration::hours(24))
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = LoginResponse {
        access_token: access_token.token,
        refresh_token: refresh_token.token,
        token_type: "Bearer".to_string(),
        expires_in: access_token.expires_in.as_seconds(),
        user: user_to_info(&user),
        requires_mfa: false,
        mfa_token: None
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

