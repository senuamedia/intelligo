// =============================================================================
// DOCUMENTATION ENDPOINTS
// =============================================================================

/// Serve API documentation page
async fn serve_docs(req: Request) -> Response {
    let html = r#"
<!DOCTYPE html>
<html>
<head>
    <title>Intelligo LMS API Documentation</title>
    <link rel="stylesheet" type="text/css" href="https://unpkg.com/swagger-ui-dist/swagger-ui.css">
</head>
<body>
    <div id="swagger-ui"></div>
    <script src="https://unpkg.com/swagger-ui-dist/swagger-ui-bundle.js"></script>
    <script>
        SwaggerUIBundle({
            url: "/docs/openapi.json",
            dom_id: '#swagger-ui',
            presets: [
                SwaggerUIBundle.presets.apis,
                SwaggerUIBundle.SwaggerUIStandalonePreset
            ],
            layout: "BaseLayout"
        });
    </script>
</body>
</html>
    "#;

    Response::html(html)
}

/// Serve OpenAPI specification
async fn serve_openapi_spec(req: Request) -> Response {
    let spec = generate_openapi_spec();
    Response::json(spec)
}

fn generate_openapi_spec() -> Map<String, Dynamic> {
    let mut spec = Map::new();

    spec.insert("openapi".to_string(), Dynamic::String("3.0.3".to_string()));

    let mut info = Map::new();
    info.insert("title".to_string(), Dynamic::String("Intelligo LMS API".to_string()));
    info.insert("version".to_string(), Dynamic::String("1.0.0".to_string()));
    info.insert("description".to_string(), Dynamic::String(
        "REST API for Intelligo Learning Management System. Provides endpoints for course management, user authentication, assessments, grading, and AI-powered learning features.".to_string()
    ));
    spec.insert("info".to_string(), Dynamic::Map(info));

    let mut servers = vec![];
    let mut server = Map::new();
    server.insert("url".to_string(), Dynamic::String("/api/v1".to_string()));
    server.insert("description".to_string(), Dynamic::String("API v1".to_string()));
    servers.push(Dynamic::Map(server));
    spec.insert("servers".to_string(), Dynamic::List(servers));

    // Security schemes
    let mut security_schemes = Map::new();
    let mut bearer = Map::new();
    bearer.insert("type".to_string(), Dynamic::String("http".to_string()));
    bearer.insert("scheme".to_string(), Dynamic::String("bearer".to_string()));
    bearer.insert("bearerFormat".to_string(), Dynamic::String("JWT".to_string()));
    security_schemes.insert("bearerAuth".to_string(), Dynamic::Map(bearer));

    let mut components = Map::new();
    components.insert("securitySchemes".to_string(), Dynamic::Map(security_schemes));
    spec.insert("components".to_string(), Dynamic::Map(components));

    // Paths would be generated dynamically from route definitions
    // For brevity, this is a placeholder
    spec.insert("paths".to_string(), Dynamic::Map(Map::new()));

    spec
}

// =============================================================================
// ERROR HANDLERS
// =============================================================================

/// 404 Not Found handler
async fn not_found_handler(req: Request) -> Response {
    let error = ApiError::NotFound {
        resource: "Endpoint".to_string(),
        id: req.path().to_string()
    };

    error.to_response()
}

// =============================================================================
// SERVER STARTUP
// =============================================================================

/// API server
type ApiServer {
    config: ApiConfig,
    router: Router,
    server_config: ServerConfig
}

impl ApiServer {
    /// Create a new API server
    fn new(config: ApiConfig, db: Database) -> ApiServer {
        let router = build_router(&config, db);

        let server_config = ServerConfig {
            host: "0.0.0.0".to_string(),
            port: 8080,
            keep_alive: true,
            request_timeout_secs: 30,
            max_connections: 10000
        };

        ApiServer {
            config,
            router,
            server_config
        }
    }

    /// Configure server settings
    fn with_config(mut self, server_config: ServerConfig) -> ApiServer {
        self.server_config = server_config;
        self
    }

    /// Start the server
    async fn start(&self) -> Result<(), RuntimeError> {
        println!(
            "Starting Intelligo API server on {}:{}",
            self.server_config.host,
            self.server_config.port
        );
        println!("API version: {}", self.config.version);
        println!("Documentation: {}", if self.config.enable_docs { "enabled" } else { "disabled" });

        Server::new(self.server_config.clone())
            .serve(self.router.clone())
            .await
    }

    /// Start with graceful shutdown
    async fn start_with_shutdown(&self, shutdown_signal: impl Future<Output = ()>) -> Result<(), RuntimeError> {
        println!(
            "Starting Intelligo API server on {}:{} with graceful shutdown",
            self.server_config.host,
            self.server_config.port
        );

        Server::new(self.server_config.clone())
            .serve(self.router.clone())
            .with_graceful_shutdown(shutdown_signal)
            .await
    }
}

