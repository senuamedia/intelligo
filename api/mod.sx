/// API information endpoint
async fn api_info(req: Request, config: &ApiConfig) -> Response {
    let info = ApiInfo {
        name: "Intelligo LMS API".to_string(),
        version: config.version.clone(),
        description: "REST API for Intelligo Learning Management System".to_string(),
        documentation_url: if config.enable_docs {
            Some(format!("{}", config.docs_path))
        } else {
            None
        },
        endpoints: get_endpoint_summary(),
        contact: ApiContact {
            email: "support@intelligo.io".to_string(),
            url: "https://intelligo.io".to_string()
        }
    };

    Response::json(info)
}

type ApiInfo {
    name: String,
    version: String,
    description: String,
    documentation_url: Option<String>,
    endpoints: List<EndpointGroup>,
    contact: ApiContact
}

type EndpointGroup {
    name: String,
    base_path: String,
    description: String
}

type ApiContact {
    email: String,
    url: String
}

