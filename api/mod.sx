/// Intelligo LMS - API Module
///
/// This is the main API module that configures and exports the REST API router.
/// It aggregates all API sub-modules and sets up global middleware.

module intelligo::api

use modulus::http::{Router, Request, Response, StatusCode, Server, ServerConfig}
use modulus::runtime::{Context, Error as RuntimeError}
use std::time::DateTime

// Import all API sub-modules
use intelligo::api::middleware::*
use intelligo::api::auth as auth_api
use intelligo::api::users as users_api
use intelligo::api::courses as courses_api
use intelligo::api::modules as modules_api
use intelligo::api::lessons as lessons_api
use intelligo::api::assessments as assessments_api
use intelligo::api::submissions as submissions_api
use intelligo::api::grades as grades_api
use intelligo::api::enrollments as enrollments_api
use intelligo::api::ai as ai_api
use intelligo::api::progress as progress_api

// Import core modules
use intelligo::core::types::*
use intelligo::core::storage::Database

// =============================================================================
// API CONFIGURATION
// =============================================================================

/// API configuration
type ApiConfig {
    /// Base path for API (e.g., "/api/v1")
    base_path: String,

    /// API version
    version: String,

    /// Whether to enable API documentation
    enable_docs: Bool,

    /// Documentation path
    docs_path: String,

    /// CORS configuration
    cors: CorsConfig,

    /// Rate limiting configuration
    rate_limit: RateLimitConfig,

    /// Body size limits
    body_limits: BodyLimitConfig,

    /// Logging configuration
    logging: LoggingConfig,

    /// Authentication configuration
    auth: AuthConfig
}

impl ApiConfig {
    /// Default API configuration
    fn default() -> ApiConfig {
        ApiConfig {
            base_path: "/api/v1".to_string(),
            version: "1.0.0".to_string(),
            enable_docs: true,
            docs_path: "/docs".to_string(),
            cors: CorsConfig::default(),
            rate_limit: RateLimitConfig::default(),
            body_limits: BodyLimitConfig::default(),
            logging: LoggingConfig::default(),
            auth: AuthConfig::default().with_skip_paths(vec![
                "/api/v1/auth/login".to_string(),
                "/api/v1/auth/register".to_string(),
                "/api/v1/auth/forgot-password".to_string(),
                "/api/v1/auth/reset-password".to_string(),
                "/api/v1/auth/oauth/*".to_string(),
                "/api/v1/health".to_string(),
                "/api/v1/ready".to_string(),
                "/docs/*".to_string()
            ])
        }
    }

    /// Development configuration
    fn development() -> ApiConfig {
        let mut config = ApiConfig::default();
        config.cors.allow_any_origin = true;
        config.logging.log_body = true;
        config.logging.log_response = true;
        config
    }

    /// Production configuration
    fn production() -> ApiConfig {
        let mut config = ApiConfig::default();
        config.enable_docs = false;
        config.rate_limit = RateLimitConfig::strict();
        config
    }
}

// =============================================================================
// ROUTER BUILDER
// =============================================================================

/// Build the main API router
fn build_router(config: &ApiConfig, db: Database) -> Router {
    let rate_limiter = RateLimiter::new(config.rate_limit.clone());

    Router::new()
        // Global middleware
        .middleware(move |req, next| {
            cors_middleware(req, &config.cors, next)
        })
        .middleware(move |req, next| {
            let mut ctx = RequestContext::from_request(&req);
            error_handler_middleware(req, &ctx, next)
        })
        .middleware(move |req, next| {
            let mut ctx = RequestContext::from_request(&req);
            logging_middleware(req, &ctx, &config.logging, next)
        })
        .middleware(move |req, next| {
            let mut ctx = RequestContext::from_request(&req);
            body_limit_middleware(req, &config.body_limits, &ctx, next)
        })
        .middleware(move |req, next| {
            let mut ctx = RequestContext::from_request(&req);
            rate_limit_middleware(req, &ctx, &rate_limiter, next)
        })
        .middleware(move |req, next| {
            let mut ctx = RequestContext::from_request(&req);
            auth_middleware(req, &mut ctx, &config.auth, next)
        })
        .middleware(move |req, next| {
            let mut ctx = RequestContext::from_request(&req);
            tenant_middleware(req, &mut ctx, next)
        })

        // Health check endpoints
        .get("/api/v1/health", health_check)
        .get("/api/v1/ready", readiness_check)

        // API info endpoint
        .get("/api/v1", |req| api_info(req, &config))

        // Mount sub-routers
        .mount("/api/v1/auth", auth_api::router(db.clone()))
        .mount("/api/v1/users", users_api::router(db.clone()))
        .mount("/api/v1/courses", courses_api::router(db.clone()))
        .mount("/api/v1/modules", modules_api::router(db.clone()))
        .mount("/api/v1/lessons", lessons_api::router(db.clone()))
        .mount("/api/v1/assessments", assessments_api::router(db.clone()))
        .mount("/api/v1/submissions", submissions_api::router(db.clone()))
        .mount("/api/v1/grades", grades_api::router(db.clone()))
        .mount("/api/v1/enrollments", enrollments_api::router(db.clone()))
        .mount("/api/v1/ai", ai_api::router(db.clone()))
        .mount("/api/v1/progress", progress_api::router(db.clone()))

        // API documentation
        .get("/docs", serve_docs)
        .get("/docs/openapi.json", serve_openapi_spec)

        // Catch-all 404
        .fallback(not_found_handler)
}

// =============================================================================
// HEALTH CHECK ENDPOINTS
// =============================================================================

/// Health check endpoint
async fn health_check(req: Request) -> Response {
    let health = HealthStatus {
        status: "healthy".to_string(),
        timestamp: DateTime::now(),
        version: env!("CARGO_PKG_VERSION").to_string()
    };

    Response::json(health).with_status(StatusCode::OK)
}

/// Readiness check endpoint (checks all dependencies)
async fn readiness_check(req: Request) -> Response {
    let mut checks = Map::new();
    let mut all_ready = true;

    // Check database
    let db_status = check_database().await;
    checks.insert("database".to_string(), db_status.clone());
    if !db_status.ready {
        all_ready = false;
    }

    // Check cache
    let cache_status = check_cache().await;
    checks.insert("cache".to_string(), cache_status.clone());
    if !cache_status.ready {
        all_ready = false;
    }

    // Check external services
    let services_status = check_external_services().await;
    for (name, status) in services_status {
        checks.insert(name, status.clone());
        if !status.ready {
            all_ready = false;
        }
    }

    let response = ReadinessStatus {
        ready: all_ready,
        timestamp: DateTime::now(),
        checks
    };

    let status_code = if all_ready {
        StatusCode::OK
    } else {
        StatusCode::SERVICE_UNAVAILABLE
    };

    Response::json(response).with_status(status_code)
}

type HealthStatus {
    status: String,
    timestamp: DateTime,
    version: String
}

type ReadinessStatus {
    ready: Bool,
    timestamp: DateTime,
    checks: Map<String, DependencyStatus>
}

type DependencyStatus {
    ready: Bool,
    latency_ms: Option<i64>,
    error: Option<String>
}

async fn check_database() -> DependencyStatus {
    let start = std::time::Instant::now();

    // Actually ping the database with a simple query
    match db::query_one("SELECT 1 as health_check", []).await {
        Ok(Some(_)) => DependencyStatus {
            ready: true,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: None
        },
        Ok(None) => DependencyStatus {
            ready: false,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: Some("Database returned no result".to_string())
        },
        Err(e) => DependencyStatus {
            ready: false,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: Some(format!("Database connection failed: {}", e))
        }
    }
}

async fn check_cache() -> DependencyStatus {
    let start = std::time::Instant::now();

    // Actually ping the cache (Redis/Memcached)
    match cache::ping().await {
        Ok(_) => DependencyStatus {
            ready: true,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: None
        },
        Err(e) => DependencyStatus {
            ready: false,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: Some(format!("Cache connection failed: {}", e))
        }
    }
}

async fn check_search() -> DependencyStatus {
    let start = std::time::Instant::now();

    // Check search engine (Elasticsearch/OpenSearch/Meilisearch)
    match search::health_check().await {
        Ok(healthy) => DependencyStatus {
            ready: healthy,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: if healthy { None } else { Some("Search engine unhealthy".to_string()) }
        },
        Err(e) => DependencyStatus {
            ready: false,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: Some(format!("Search engine connection failed: {}", e))
        }
    }
}

async fn check_storage() -> DependencyStatus {
    let start = std::time::Instant::now();

    // Check file storage (S3/GCS/Azure Blob)
    match storage::health_check().await {
        Ok(_) => DependencyStatus {
            ready: true,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: None
        },
        Err(e) => DependencyStatus {
            ready: false,
            latency_ms: Some(start.elapsed().as_millis() as i64),
            error: Some(format!("Storage connection failed: {}", e))
        }
    }
}

async fn check_external_services() -> Map<String, DependencyStatus> {
    let mut statuses = Map::new();

    // Check AI service
    let ai_start = std::time::Instant::now();
    match ai::health_check().await {
        Ok(_) => {
            statuses.insert("ai_service".to_string(), DependencyStatus {
                ready: true,
                latency_ms: Some(ai_start.elapsed().as_millis() as i64),
                error: None
            });
        },
        Err(e) => {
            statuses.insert("ai_service".to_string(), DependencyStatus {
                ready: false,
                latency_ms: Some(ai_start.elapsed().as_millis() as i64),
                error: Some(format!("AI service unavailable: {}", e))
            });
        }
    }

    // Check storage service
    let storage_status = check_storage().await;
    statuses.insert("storage_service".to_string(), storage_status);

    // Check search service
    let search_status = check_search().await;
    statuses.insert("search_service".to_string(), search_status);

    statuses
}

// =============================================================================
