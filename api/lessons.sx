// =============================================================================
// LESSON CONTENT
// =============================================================================

/// Get lesson content
async fn get_lesson_content(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let lesson = get_viewable_lesson(&db, &lesson_id, &ctx).await?;

    // Check if user has access (enrolled or free preview)
    if !lesson.is_free_preview && !is_enrolled_in_course(&db, &lesson.course_id, &ctx).await {
        return Err(ApiError::Forbidden {
            message: "Enrollment required to view this content".to_string(),
            required_permission: None
        })
    }

    let content = db.lesson_content()
        .find_by_lesson(&lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Record view
    if let Some(user_id) = ctx.user_id() {
        record_lesson_view(&db, &lesson_id, &user_id).await.ok();
    }

    Ok(Response::json(ApiResponse::success(content, &ctx)))
}

/// Update lesson content
async fn update_lesson_content(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let _ = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    let body: LessonContent = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let content = db.lesson_content()
        .upsert(&lesson_id, body)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(content, &ctx)))
}

// =============================================================================
// LESSON MEDIA
// =============================================================================

/// Upload lesson media
async fn upload_lesson_media(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let _ = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    let file = req.file("media").await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid file upload: {}", e)
    })?;

    let media = db.storage()
        .upload_lesson_media(&lesson_id, &file)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(media, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Get lesson media
async fn get_lesson_media(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let _ = get_viewable_lesson(&db, &lesson_id, &ctx).await?;

    let media = db.lesson_media()
        .find_by_lesson(&lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(media, &ctx)))
}

/// Delete lesson media
async fn delete_lesson_media(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let media_id = req.param("media_id").ok_or_else(|| ApiError::BadRequest {
        message: "Media ID required".to_string()
    })?;

    let _ = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    db.lesson_media()
        .delete(&media_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    db.storage()
        .delete_media(&media_id)
        .await
        .ok();

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Media deleted".to_string()))
    ])))
}

// =============================================================================
// LESSON PROGRESS
// =============================================================================

/// Get lesson progress for current user
async fn get_lesson_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let lesson = get_viewable_lesson(&db, &lesson_id, &ctx).await?;

    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &lesson.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled in this course".to_string(),
            required_permission: None
        })?;

    let progress = db.progress()
        .get_lesson_progress(&enrollment.id, &lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .unwrap_or_else(|| LessonProgress {
            lesson_id: lesson_id.clone(),
            enrollment_id: enrollment.id.clone(),
            status: ProgressStatus::NotStarted,
            progress_percentage: 0.0,
            time_spent_seconds: 0,
            started_at: None,
            completed_at: None,
            last_position: None,
            video_position_seconds: None,
            page_number: None
        });

    Ok(Response::json(ApiResponse::success(progress, &ctx)))
}

/// Update lesson progress
async fn update_lesson_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let lesson = get_viewable_lesson(&db, &lesson_id, &ctx).await?;

    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &lesson.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled in this course".to_string(),
            required_permission: None
        })?;

    let body: UpdateProgressRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let progress = db.progress()
        .update_lesson_progress(&enrollment.id, &lesson_id, UpdateLessonProgressInput {
            progress_percentage: body.progress_percentage,
            time_spent_seconds: body.time_spent_seconds,
            video_position_seconds: body.video_position_seconds,
            page_number: body.page_number,
            last_position: body.last_position
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(progress, &ctx)))
}

/// Mark lesson as complete
async fn mark_lesson_complete(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let lesson = get_viewable_lesson(&db, &lesson_id, &ctx).await?;

    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &lesson.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled in this course".to_string(),
            required_permission: None
        })?;

    let progress = db.progress()
        .mark_lesson_complete(&enrollment.id, &lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Check if module is complete
    check_and_update_module_completion(&db, &enrollment.id, &lesson.module_id).await.ok();

    Ok(Response::json(ApiResponse::success(progress, &ctx)))
}

// =============================================================================
// ATTACHMENTS
// =============================================================================

/// Get lesson attachments
async fn get_attachments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let _ = get_viewable_lesson(&db, &lesson_id, &ctx).await?;

    let attachments = db.lesson_attachments()
        .find_by_lesson(&lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(attachments, &ctx)))
}

/// Add attachment to lesson
async fn add_attachment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let _ = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    let file = req.file("attachment").await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid file upload: {}", e)
    })?;

    let attachment = db.lesson_attachments()
        .create(&lesson_id, &file)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(attachment, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Remove attachment
async fn remove_attachment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let attachment_id = req.param("attachment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Attachment ID required".to_string()
    })?;

    let _ = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    db.lesson_attachments()
        .delete(&attachment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Attachment removed".to_string()))
    ])))
}

// =============================================================================
// DUPLICATION
// =============================================================================

/// Duplicate a lesson
async fn duplicate_lesson(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let lesson = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    #[derive(Deserialize)]
    struct DuplicateRequest {
        new_title: Option<String>,
        target_module_id: Option<ModuleId>,
        include_content: Option<Bool>
    }

    let body: DuplicateRequest = req.json().await.unwrap_or(DuplicateRequest {
        new_title: None,
        target_module_id: None,
        include_content: Some(true)
    });

    // Verify target module access if different
    let target_module = body.target_module_id.clone().unwrap_or(lesson.module_id.clone());
    if target_module != lesson.module_id {
        let module = db.modules()
            .find_by_id(&target_module)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
            .ok_or_else(|| ApiError::NotFound {
                resource: "Module".to_string(),
                id: target_module.clone()
            })?;

        verify_course_edit_access(&db, &module.course_id, &ctx).await?;
    }

    let new_lesson = db.lessons()
        .duplicate(
            &lesson_id,
            body.new_title.as_deref(),
            Some(&target_module),
            body.include_content.unwrap_or(true)
        )
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = lesson_to_response(&new_lesson);

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

fn lesson_to_response(lesson: &Lesson) -> LessonResponse {
    LessonResponse {
        id: lesson.id.clone(),
        module_id: lesson.module_id.clone(),
        course_id: lesson.course_id.clone(),
        title: lesson.title.clone(),
        description: lesson.description.clone(),
        lesson_type: lesson.lesson_type.clone(),
        position: lesson.position,
        duration_minutes: lesson.duration_minutes,
        is_published: lesson.is_published,
        is_required: lesson.is_required,
        is_free_preview: lesson.is_free_preview,
        unlock_at: lesson.unlock_at,
        due_date: lesson.due_date,
        content_summary: None,
        attachments_count: 0,
        created_at: lesson.created_at,
        updated_at: lesson.updated_at
    }
}

async fn filter_unpublished_lessons(db: &Database, lessons: List<Lesson>, ctx: &RequestContext) -> List<Lesson> {
    if lessons.is_empty() {
        return lessons
    }

    // Check if user can edit the course
    let course_id = &lessons[0].course_id;
    let can_edit = can_edit_course_content(db, course_id, ctx).await;

    if can_edit {
        lessons
    } else {
        lessons.into_iter().filter(|l| l.is_published).collect()
    }
}

async fn verify_course_access(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Result<(), ApiError> {
    if ctx.has_permission(Permission::ViewAllCourses) {
        return Ok(())
    }

    if let Some(user_id) = ctx.user_id() {
        let enrolled = db.enrollments()
            .is_enrolled(&user_id, course_id)
            .await
            .unwrap_or(false);
        if enrolled {
            return Ok(())
        }
    }

    let course = db.courses()
        .find_by_id(course_id)
        .await
        .ok()
        .flatten();

    if let Some(c) = course {
        if c.visibility == CourseVisibility::Public && c.status == CourseStatus::Published {
            return Ok(())
        }
    }

    Err(ApiError::Forbidden {
        message: "Access denied".to_string(),
        required_permission: None
    })
}

async fn verify_course_edit_access(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Result<(), ApiError> {
    if ctx.has_permission(Permission::EditAllCourses) {
        return Ok(())
    }

    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, course_id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            if e.can_edit_content() {
                return Ok(())
            }
        }
    }

    Err(ApiError::Forbidden {
        message: "You don't have permission to edit this course".to_string(),
        required_permission: Some("EditCourses".to_string())
    })
}

async fn can_edit_course_content(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Bool {
    if ctx.has_permission(Permission::EditAllCourses) {
        return true
    }

    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, course_id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            return e.can_edit_content()
        }
    }

    false
}

async fn get_viewable_lesson(db: &Database, lesson_id: &str, ctx: &RequestContext) -> Result<Lesson, ApiError> {
    let lesson = db.lessons()
        .find_by_id(lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Lesson".to_string(),
            id: lesson_id.to_string()
        })?;

    verify_course_access(db, &lesson.course_id, ctx).await?;

    if !lesson.is_published && !can_edit_course_content(db, &lesson.course_id, ctx).await {
        return Err(ApiError::NotFound {
            resource: "Lesson".to_string(),
            id: lesson_id.to_string()
        })
    }

    Ok(lesson)
}

async fn get_editable_lesson(db: &Database, lesson_id: &str, ctx: &RequestContext) -> Result<Lesson, ApiError> {
    let lesson = db.lessons()
        .find_by_id(lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Lesson".to_string(),
            id: lesson_id.to_string()
        })?;

    verify_course_edit_access(db, &lesson.course_id, ctx).await?;

    Ok(lesson)
}

async fn is_enrolled_in_course(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Bool {
    if ctx.has_permission(Permission::ViewAllCourses) {
        return true
    }

    if let Some(user_id) = ctx.user_id() {
        return db.enrollments()
            .is_enrolled(&user_id, course_id)
            .await
            .unwrap_or(false)
    }

    false
}

async fn record_lesson_view(db: &Database, lesson_id: &LessonId, user_id: &UserId) -> Result<(), String> {
    db.lesson_views()
        .record(lesson_id, user_id)
        .await
}

async fn check_and_update_module_completion(db: &Database, enrollment_id: &EnrollmentId, module_id: &ModuleId) -> Result<(), String> {
    db.progress()
        .check_module_completion(enrollment_id, module_id)
        .await
}

fn parse_lesson_type(s: &str) -> Result<LessonType, ApiError> {
    match s.to_lowercase().as_str() {
        "video" => Ok(LessonType::Video),
        "text" | "article" => Ok(LessonType::Text),
        "document" | "pdf" => Ok(LessonType::Document),
        "presentation" => Ok(LessonType::Presentation),
        "interactive" => Ok(LessonType::Interactive),
        "external" => Ok(LessonType::External),
        "audio" => Ok(LessonType::Audio),
        "live" => Ok(LessonType::Live),
        "scorm" => Ok(LessonType::Scorm),
        "xapi" => Ok(LessonType::Xapi),
        _ => Err(ApiError::ValidationError {
            field: "lesson_type".to_string(),
            message: format!("Unknown lesson type: {}", s),
            errors: vec![]
        })
    }
}

