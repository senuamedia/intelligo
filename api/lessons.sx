/// Delete a lesson
async fn delete_lesson(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let _ = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    db.lessons()
        .delete(&lesson_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Lesson deleted".to_string()))
    ])))
}

