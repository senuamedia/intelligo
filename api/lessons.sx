/// Intelligo LMS - Lessons API
///
/// This module provides lesson management endpoints:
/// - Lesson CRUD operations
/// - Lesson content management
/// - Lesson progress tracking

module intelligo::api::lessons

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::entities::lesson::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the lessons router
pub fn router(db: Database) -> Router {
    Router::new()
        // Lesson CRUD
        .get("/", move |req| list_lessons(req, db.clone()))
        .get("/:lesson_id", move |req| get_lesson(req, db.clone()))
        .post("/", move |req| create_lesson(req, db.clone()))
        .patch("/:lesson_id", move |req| update_lesson(req, db.clone()))
        .delete("/:lesson_id", move |req| delete_lesson(req, db.clone()))

        // Lesson publishing
        .post("/:lesson_id/publish", move |req| publish_lesson(req, db.clone()))
        .post("/:lesson_id/unpublish", move |req| unpublish_lesson(req, db.clone()))

        // Lesson content
        .get("/:lesson_id/content", move |req| get_lesson_content(req, db.clone()))
        .put("/:lesson_id/content", move |req| update_lesson_content(req, db.clone()))

        // Lesson media
        .post("/:lesson_id/media", move |req| upload_lesson_media(req, db.clone()))
        .get("/:lesson_id/media", move |req| get_lesson_media(req, db.clone()))
        .delete("/:lesson_id/media/:media_id", move |req| delete_lesson_media(req, db.clone()))

        // Lesson progress (for student)
        .get("/:lesson_id/progress", move |req| get_lesson_progress(req, db.clone()))
        .post("/:lesson_id/progress", move |req| update_lesson_progress(req, db.clone()))
        .post("/:lesson_id/complete", move |req| mark_lesson_complete(req, db.clone()))

        // Lesson attachments
        .get("/:lesson_id/attachments", move |req| get_attachments(req, db.clone()))
        .post("/:lesson_id/attachments", move |req| add_attachment(req, db.clone()))
        .delete("/:lesson_id/attachments/:attachment_id", move |req| remove_attachment(req, db.clone()))

        // Duplication
        .post("/:lesson_id/duplicate", move |req| duplicate_lesson(req, db.clone()))
}

// =============================================================================
// REQUEST/RESPONSE TYPES
// =============================================================================

/// Lesson response type
type LessonResponse {
    id: LessonId,
    module_id: ModuleId,
    course_id: CourseId,
    title: String,
    description: Option<String>,
    lesson_type: LessonType,
    position: i32,
    duration_minutes: Option<i32>,
    is_published: Bool,
    is_required: Bool,
    is_free_preview: Bool,
    unlock_at: Option<DateTime>,
    due_date: Option<DateTime>,
    content_summary: Option<ContentSummary>,
    attachments_count: i32,
    created_at: DateTime,
    updated_at: DateTime
}

/// Content summary for lesson list
type ContentSummary {
    word_count: Option<i32>,
    video_duration_seconds: Option<i32>,
    page_count: Option<i32>,
    has_interactive: Bool
}

/// Lesson type enum
enum LessonType {
    Video,
    Text,
    Document,
    Presentation,
    Interactive,
    External,
    Audio,
    Live,
    Scorm,
    Xapi
}

/// Create lesson request
type CreateLessonRequest {
    module_id: ModuleId,
    title: String,
    lesson_type: String,
    description: Option<String>,
    duration_minutes: Option<i32>,
    is_required: Option<Bool>,
    is_free_preview: Option<Bool>,
    position: Option<i32>
}

/// Update lesson request
type UpdateLessonRequest {
    title: Option<String>,
    description: Option<String>,
    lesson_type: Option<String>,
    duration_minutes: Option<i32>,
    is_required: Option<Bool>,
    is_free_preview: Option<Bool>,
    unlock_at: Option<DateTime>,
    due_date: Option<DateTime>,
    position: Option<i32>
}

/// Lesson content types
enum LessonContent {
    /// Video content
    Video {
        video_id: MediaId,
        video_url: String,
        duration_seconds: i32,
        transcript: Option<String>,
        captions: List<CaptionTrack>,
        chapters: List<VideoChapter>
    },

    /// Text/article content
    Text {
        body: String,
        format: TextFormat,
        word_count: i32
    },

    /// Document content (PDF, etc)
    Document {
        document_id: MediaId,
        document_url: String,
        page_count: i32,
        preview_url: Option<String>
    },

    /// Presentation content
    Presentation {
        presentation_id: MediaId,
        slides: List<Slide>,
        slide_count: i32
    },

    /// Interactive content (H5P, etc)
    Interactive {
        content_id: String,
        content_type: String,
        embed_url: String,
        width: Option<i32>,
        height: Option<i32>
    },

    /// External URL
    External {
        url: String,
        embed: Bool,
        new_window: Bool
    },

    /// Audio content
    Audio {
        audio_id: MediaId,
        audio_url: String,
        duration_seconds: i32,
        transcript: Option<String>
    },

    /// Live session
    Live {
        session_type: LiveSessionType,
        meeting_url: Option<String>,
        start_time: DateTime,
        end_time: DateTime,
        recording_available: Bool,
        recording_url: Option<String>
    },

    /// SCORM package
    Scorm {
        package_id: String,
        version: String,
        launch_url: String
    },

    /// xAPI content
    Xapi {
        activity_id: String,
        launch_url: String,
        activity_type: String
    }
}

/// Caption track
type CaptionTrack {
    id: String,
    language: String,
    label: String,
    url: String,
    is_default: Bool
}

/// Video chapter
type VideoChapter {
    title: String,
    start_seconds: i32,
    end_seconds: i32
}

/// Presentation slide
type Slide {
    id: String,
    position: i32,
    image_url: String,
    notes: Option<String>
}

/// Live session type
enum LiveSessionType {
    Zoom,
    Teams,
    Meet,
    Webex,
    Custom
}

/// Text format
enum TextFormat {
    PlainText,
    Markdown,
    Html,
    RichText
}

/// Lesson progress
type LessonProgress {
    lesson_id: LessonId,
    enrollment_id: EnrollmentId,
    status: ProgressStatus,
    progress_percentage: f32,
    time_spent_seconds: i64,
    started_at: Option<DateTime>,
    completed_at: Option<DateTime>,
    last_position: Option<i32>,
    video_position_seconds: Option<i32>,
    page_number: Option<i32>
}

/// Progress status
enum ProgressStatus {
    NotStarted,
    InProgress,
    Completed
}

/// Update progress request
type UpdateProgressRequest {
    progress_percentage: Option<f32>,
    time_spent_seconds: Option<i64>,
    video_position_seconds: Option<i32>,
    page_number: Option<i32>,
    last_position: Option<i32>
}

/// Lesson attachment
type LessonAttachment {
    id: String,
    lesson_id: LessonId,
    filename: String,
    file_size: i64,
    mime_type: String,
    download_url: String,
    uploaded_at: DateTime
}

// =============================================================================
// LIST LESSONS
// =============================================================================

/// List lessons
async fn list_lessons(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let pagination = PaginationParams::from_request(&req);
    let module_id = req.query_param("module_id");
    let course_id = req.query_param("course_id");

    let (lessons, total) = if let Some(mid) = module_id {
        // Verify access via module
        let module = db.modules()
            .find_by_id(&mid)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
            .ok_or_else(|| ApiError::NotFound {
                resource: "Module".to_string(),
                id: mid.clone()
            })?;

        verify_course_access(&db, &module.course_id, &ctx).await?;

        let lessons = db.lessons()
            .find_by_module(&mid)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?;

        (lessons.clone(), lessons.len() as i64)
    } else if let Some(cid) = course_id {
        verify_course_access(&db, &cid, &ctx).await?;

        db.lessons()
            .find_by_course(&cid, pagination.limit(), pagination.offset())
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    } else {
        ctx.require_permission(Permission::ViewAllCourses)?;

        db.lessons()
            .list_all(ctx.tenant_id().as_ref(), pagination.limit(), pagination.offset())
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    };

    // Filter unpublished if not editor
    let filtered = filter_unpublished_lessons(&db, lessons, &ctx).await;

    let items: List<LessonResponse> = filtered.iter().map(lesson_to_response).collect();

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(items, meta, &ctx)))
}

// =============================================================================
// GET LESSON
// =============================================================================

/// Get a specific lesson
async fn get_lesson(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let lesson = get_viewable_lesson(&db, &lesson_id, &ctx).await?;
    let response = lesson_to_response(&lesson);

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// CREATE LESSON
// =============================================================================

/// Create a new lesson
async fn create_lesson(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: CreateLessonRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Verify module access
    let module = db.modules()
        .find_by_id(&body.module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: body.module_id.clone()
        })?;

    verify_course_edit_access(&db, &module.course_id, &ctx).await?;

    // Validate
    if body.title.is_empty() {
        return Err(ApiError::ValidationError {
            field: "title".to_string(),
            message: "Lesson title is required".to_string(),
            errors: vec![]
        })
    }

    let lesson_type = parse_lesson_type(&body.lesson_type)?;

    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.lessons()
            .get_next_position(&body.module_id)
            .await
            .unwrap_or(0)
    };

    let lesson = db.lessons()
        .create(CreateLessonInput {
            module_id: body.module_id,
            course_id: module.course_id,
            title: body.title,
            lesson_type,
            description: body.description,
            duration_minutes: body.duration_minutes,
            is_required: body.is_required.unwrap_or(true),
            is_free_preview: body.is_free_preview.unwrap_or(false),
            position,
            tenant_id: ctx.tenant_id()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = lesson_to_response(&lesson);

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

// =============================================================================
// UPDATE LESSON
// =============================================================================

/// Update a lesson
async fn update_lesson(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let lesson = get_editable_lesson(&db, &lesson_id, &ctx).await?;

    let body: UpdateLessonRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let lesson_type = if let Some(lt) = body.lesson_type {
        Some(parse_lesson_type(&lt)?)
    } else {
        None
    };

    let updated = db.lessons()
        .update(&lesson_id, UpdateLessonInput {
            title: body.title,
            description: body.description,
            lesson_type,
            duration_minutes: body.duration_minutes,
            is_required: body.is_required,
            is_free_preview: body.is_free_preview,
            unlock_at: body.unlock_at,
            due_date: body.due_date,
            position: body.position
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = lesson_to_response(&updated);

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

