/// Intelligo LMS - Progress API
///
/// This module provides learning progress tracking endpoints:
/// - Progress tracking and completion
/// - xAPI statement handling
/// - SCORM data management
/// - Learning analytics
/// - Activity tracking

module intelligo::api::progress

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::compliance::xapi::*
use intelligo::compliance::scorm::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the progress router
pub fn router(db: Database) -> Router {
    Router::new()
        // Progress tracking
        .get("/courses/:course_id", move |req| get_course_progress(req, db.clone()))
        .get("/courses/:course_id/users/:user_id", move |req| get_user_course_progress(req, db.clone()))
        .get("/lessons/:lesson_id", move |req| get_lesson_progress(req, db.clone()))
        .post("/lessons/:lesson_id/complete", move |req| mark_lesson_complete(req, db.clone()))
        .post("/lessons/:lesson_id/track", move |req| track_lesson_progress(req, db.clone()))

        // Module progress
        .get("/modules/:module_id", move |req| get_module_progress(req, db.clone()))
        .post("/modules/:module_id/unlock", move |req| unlock_module(req, db.clone()))

        // Assessment progress
        .get("/assessments/:assessment_id", move |req| get_assessment_progress(req, db.clone()))
        .post("/assessments/:assessment_id/start", move |req| start_assessment(req, db.clone()))
        .post("/assessments/:assessment_id/resume", move |req| resume_assessment(req, db.clone()))

        // My progress
        .get("/my", move |req| get_my_progress(req, db.clone()))
        .get("/my/courses/:course_id", move |req| get_my_course_progress(req, db.clone()))
        .get("/my/activity", move |req| get_my_activity(req, db.clone()))

        // xAPI endpoints
        .post("/xapi/statements", move |req| post_xapi_statement(req, db.clone()))
        .get("/xapi/statements", move |req| get_xapi_statements(req, db.clone()))
        .put("/xapi/statements", move |req| put_xapi_statement(req, db.clone()))
        .get("/xapi/activities/state", move |req| get_activity_state(req, db.clone()))
        .put("/xapi/activities/state", move |req| put_activity_state(req, db.clone()))
        .delete("/xapi/activities/state", move |req| delete_activity_state(req, db.clone()))
        .get("/xapi/activities/profile", move |req| get_activity_profile(req, db.clone()))
        .put("/xapi/activities/profile", move |req| put_activity_profile(req, db.clone()))
        .get("/xapi/agents/profile", move |req| get_agent_profile(req, db.clone()))
        .put("/xapi/agents/profile", move |req| put_agent_profile(req, db.clone()))

        // SCORM endpoints
        .post("/scorm/initialize", move |req| scorm_initialize(req, db.clone()))
        .post("/scorm/terminate", move |req| scorm_terminate(req, db.clone()))
        .get("/scorm/value", move |req| scorm_get_value(req, db.clone()))
        .post("/scorm/value", move |req| scorm_set_value(req, db.clone()))
        .post("/scorm/commit", move |req| scorm_commit(req, db.clone()))
        .get("/scorm/data/:sco_id", move |req| get_scorm_data(req, db.clone()))

        // Analytics
        .get("/analytics/courses/:course_id", move |req| get_course_analytics(req, db.clone()))
        .get("/analytics/users/:user_id", move |req| get_user_analytics(req, db.clone()))
        .get("/analytics/engagement", move |req| get_engagement_analytics(req, db.clone()))

        // Time tracking
        .post("/time/start", move |req| start_time_tracking(req, db.clone()))
        .post("/time/heartbeat", move |req| time_heartbeat(req, db.clone()))
        .post("/time/stop", move |req| stop_time_tracking(req, db.clone()))
}

