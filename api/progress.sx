/// Get course analytics
async fn get_course_analytics(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewAnalytics)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();
    let all_progress = db.progress().find_by_course(&course_id).await.unwrap_or_default();

    let analytics = compute_course_analytics(&course_id, &enrollments, &all_progress);

    Ok(Response::json(ApiResponse::success(analytics, &ctx)))
}

/// Get user analytics
async fn get_user_analytics(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    let is_own = ctx.auth.as_ref().map(|a| a.user_id.to_string() == user_id).unwrap_or(false);
    if !is_own {
        ctx.require_permission(Permission::ViewAnalytics)?;
    }

    let enrollments = db.enrollments().find_by_user(&user_id).await.unwrap_or_default();
    let activity = db.activity().find_by_user(&user_id, 100).await.unwrap_or_default();

    let analytics = compute_user_analytics(&user_id, &enrollments, &activity);

    Ok(Response::json(ApiResponse::success(analytics, &ctx)))
}

/// Get engagement analytics
async fn get_engagement_analytics(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewAnalytics)?;

    let course_id = req.query_param("course_id");
    let days = req.query_param("days").and_then(|d| d.parse::<i32>().ok()).unwrap_or(30);

    let analytics = db.analytics().get_engagement(course_id.as_deref(), days).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(analytics, &ctx)))
}

