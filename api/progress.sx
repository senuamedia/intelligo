// =============================================================================
// PROGRESS TRACKING
// =============================================================================

/// Get course progress
async fn get_course_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let user_id = req.query_param("user_id");
    let target_user = if let Some(uid) = user_id {
        if !ctx.is_admin() && ctx.auth.as_ref().map(|a| a.user_id.to_string() != uid).unwrap_or(true) {
            ctx.require_permission(Permission::ViewProgress)?;
        }
        uid
    } else {
        ctx.auth.as_ref().map(|a| a.user_id.clone()).ok_or_else(|| ApiError::Unauthorized {
            message: "Authentication required".to_string()
        })?
    };

    let progress = db.progress().get_course_progress(&target_user, &course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let modules = db.modules().find_by_course(&course_id).await.unwrap_or_default();
    let module_progress = get_module_progress_list(&db, &target_user, &modules).await;

    let response = CourseProgressResponse {
        course_id: course_id.clone(),
        user_id: target_user.clone(),
        overall_progress: progress.overall_progress,
        completed_items: progress.completed_items,
        total_items: progress.total_items,
        modules: module_progress,
        current_grade: progress.current_grade,
        time_spent_minutes: progress.time_spent_minutes,
        last_activity: progress.last_activity,
        started_at: progress.started_at,
        completed_at: progress.completed_at,
        status: progress.status.clone()
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Get user course progress (instructor view)
async fn get_user_course_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewProgress)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;
    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    let progress = db.progress().get_course_progress(&user_id, &course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let modules = db.modules().find_by_course(&course_id).await.unwrap_or_default();
    let module_progress = get_module_progress_list(&db, &user_id, &modules).await;

    let response = CourseProgressResponse {
        course_id: course_id.clone(),
        user_id: user_id.clone(),
        overall_progress: progress.overall_progress,
        completed_items: progress.completed_items,
        total_items: progress.total_items,
        modules: module_progress,
        current_grade: progress.current_grade,
        time_spent_minutes: progress.time_spent_minutes,
        last_activity: progress.last_activity,
        started_at: progress.started_at,
        completed_at: progress.completed_at,
        status: progress.status.clone()
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Get lesson progress
async fn get_lesson_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let progress = db.progress().get_lesson_progress(&auth.user_id, &lesson_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let response = LessonProgressResponse {
        lesson_id: lesson_id.clone(),
        user_id: auth.user_id.clone(),
        status: progress.status.clone(),
        progress: progress.progress,
        time_spent_minutes: progress.time_spent_minutes,
        started_at: progress.started_at,
        completed_at: progress.completed_at,
        last_position: progress.last_position.map(|p| LessonPosition {
            content_type: p.content_type,
            position: p.position,
            timestamp: p.timestamp
        }),
        attempts: progress.attempts,
        score: progress.score
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Mark lesson complete
async fn mark_lesson_complete(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    // Verify lesson access
    let lesson = db.lessons().find_by_id(&lesson_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Lesson".to_string(), id: lesson_id.clone() })?;

    // Check enrollment
    let enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, &lesson.course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::Forbidden { message: "Not enrolled".to_string(), required_permission: None })?;

    // Update progress
    let progress = db.progress().mark_lesson_complete(&auth.user_id, &lesson_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Record xAPI statement
    record_completion_statement(&db, &auth.user_id, &lesson).await.ok();

    // Check for module/course completion
    check_and_update_completions(&db, &auth.user_id, &lesson).await.ok();

    // Record activity
    record_activity(&db, &auth.user_id, ActivityType::LessonCompleted, Some(&lesson.course_id), Some(&lesson_id), Some(&lesson.title)).await.ok();

    Ok(Response::json(ApiResponse::success(Map::from([
        ("completed".to_string(), Dynamic::Bool(true)),
        ("progress".to_string(), Dynamic::Float(progress.progress))
    ]), &ctx)))
}

/// Track lesson progress
async fn track_lesson_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let lesson_id = req.param("lesson_id").ok_or_else(|| ApiError::BadRequest {
        message: "Lesson ID required".to_string()
    })?;

    let body: TrackProgressRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Update progress based on event type
    let progress = match body.event_type {
        ProgressEventType::Started => {
            db.progress().start_lesson(&auth.user_id, &lesson_id).await
        },
        ProgressEventType::Progressed => {
            db.progress().update_lesson_progress(&auth.user_id, &lesson_id, UpdateProgressInput {
                position: body.position,
                time_spent_seconds: body.time_spent_seconds,
                data: body.data
            }).await
        },
        ProgressEventType::Completed => {
            db.progress().mark_lesson_complete(&auth.user_id, &lesson_id).await
        },
        ProgressEventType::Paused | ProgressEventType::Resumed | ProgressEventType::Interacted => {
            db.progress().update_lesson_progress(&auth.user_id, &lesson_id, UpdateProgressInput {
                position: body.position,
                time_spent_seconds: body.time_spent_seconds,
                data: body.data
            }).await
        }
    }.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(Map::from([
        ("progress".to_string(), Dynamic::Float(progress.progress)),
        ("status".to_string(), Dynamic::String(format!("{:?}", progress.status)))
    ]), &ctx)))
}

