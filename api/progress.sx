/// Resume assessment
async fn resume_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let attempt = db.progress().get_in_progress_attempt(&auth.user_id, &assessment_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Assessment attempt".to_string(),
            id: assessment_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(attempt, &ctx)))
}

// =============================================================================
// MY PROGRESS
// =============================================================================

/// Get my overall progress
async fn get_my_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let enrollments = db.enrollments().find_by_user(&auth.user_id).await.unwrap_or_default();

    let mut courses: List<CourseProgressSummary> = vec![];
    let mut completed = 0;
    let mut in_progress = 0;
    let mut total_time = 0.0;

    for enrollment in &enrollments {
        if let Some(course) = db.courses().find_by_id(&enrollment.course_id).await.ok().flatten() {
            let progress = db.progress().get_course_progress(&auth.user_id, &course.id).await.ok();

            if let Some(p) = &progress {
                if p.status == ProgressStatus::Completed { completed += 1; }
                else if p.status == ProgressStatus::InProgress { in_progress += 1; }
                total_time += p.time_spent_minutes as f64 / 60.0;
            }

            let next_item = get_next_item(&db, &auth.user_id, &course.id).await;

            courses.push(CourseProgressSummary {
                course_id: course.id.clone(),
                course_title: course.title.clone(),
                course_code: course.code.clone(),
                thumbnail_url: course.thumbnail_url.clone(),
                progress: progress.as_ref().map(|p| p.overall_progress).unwrap_or(0.0),
                current_grade: progress.as_ref().and_then(|p| p.current_grade),
                last_activity: progress.as_ref().and_then(|p| p.last_activity),
                next_item
            });
        }
    }

    let recent_activity = db.activity().find_by_user(&auth.user_id, 10).await.unwrap_or_default()
        .into_iter().map(|a| activity_to_response(&a)).collect();

    let upcoming_deadlines = get_upcoming_deadlines(&db, &auth.user_id).await;

    let streak = calculate_streak(&db, &auth.user_id).await;

    Ok(Response::json(ApiResponse::success(MyProgressResponse {
        total_courses: enrollments.len() as i32,
        completed_courses: completed,
        in_progress_courses: in_progress,
        total_time_spent_hours: total_time,
        current_streak_days: streak,
        courses,
        recent_activity,
        upcoming_deadlines
    }, &ctx)))
}

/// Get my course progress
async fn get_my_course_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let progress = db.progress().get_course_progress(&auth.user_id, &course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let modules = db.modules().find_by_course(&course_id).await.unwrap_or_default();
    let module_progress = get_module_progress_list(&db, &auth.user_id, &modules).await;

    let response = CourseProgressResponse {
        course_id: course_id.clone(),
        user_id: auth.user_id.clone(),
        overall_progress: progress.overall_progress,
        completed_items: progress.completed_items,
        total_items: progress.total_items,
        modules: module_progress,
        current_grade: progress.current_grade,
        time_spent_minutes: progress.time_spent_minutes,
        last_activity: progress.last_activity,
        started_at: progress.started_at,
        completed_at: progress.completed_at,
        status: progress.status.clone()
    };

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Get my activity
async fn get_my_activity(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let limit = req.query_param("limit").and_then(|l| l.parse::<i32>().ok()).unwrap_or(50);
    let offset = req.query_param("offset").and_then(|o| o.parse::<i64>().ok()).unwrap_or(0);

    let activities = db.activity().find_by_user_paginated(&auth.user_id, limit, offset).await.unwrap_or_default();

    let response: List<ActivityItem> = activities.into_iter().map(|a| activity_to_response(&a)).collect();

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// xAPI ENDPOINTS
// =============================================================================

/// Post xAPI statement
async fn post_xapi_statement(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let statements: Vec<XapiStatement> = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid xAPI statement: {}", e)
    })?;

    let mut ids: List<String> = vec![];

    for mut statement in statements {
        // Validate and enrich statement
        statement = validate_and_enrich_statement(statement, &auth.user_id)?;

        // Store statement
        let id = db.xapi().store_statement(&statement).await
            .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

        ids.push(id);

        // Process statement for progress tracking
        process_xapi_statement(&db, &statement).await.ok();
    }

    Ok(Response::json(ids).with_status(StatusCode::OK))
}

/// Get xAPI statements
async fn get_xapi_statements(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ViewProgress)?;

    let statement_id = req.query_param("statementId");
    let agent = req.query_param("agent");
    let verb = req.query_param("verb");
    let activity = req.query_param("activity");
    let since = req.query_param("since").and_then(|s| DateTime::parse_from_rfc3339(&s).ok());
    let until = req.query_param("until").and_then(|u| DateTime::parse_from_rfc3339(&u).ok());
    let limit = req.query_param("limit").and_then(|l| l.parse::<i32>().ok()).unwrap_or(100);

    let statements = db.xapi().query_statements(XapiQuery {
        statement_id,
        agent,
        verb,
        activity,
        since,
        until,
        limit
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(statements))
}

/// Put xAPI statement
async fn put_xapi_statement(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let statement_id = req.query_param("statementId").ok_or_else(|| ApiError::BadRequest {
        message: "statementId required".to_string()
    })?;

    let mut statement: XapiStatement = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid xAPI statement: {}", e)
    })?;

    statement.id = Some(statement_id.clone());
    statement = validate_and_enrich_statement(statement, &auth.user_id)?;

    db.xapi().store_statement(&statement).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::new().with_status(StatusCode::NO_CONTENT))
}

