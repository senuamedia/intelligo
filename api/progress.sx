/// Unlock module
async fn unlock_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    // Check if prerequisites are met
    let can_unlock = db.progress().check_module_prerequisites(&auth.user_id, &module_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    if !can_unlock {
        return Err(ApiError::BadRequest {
            message: "Prerequisites not met".to_string()
        })
    }

    db.progress().unlock_module(&auth.user_id, &module_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(Map::from([
        ("unlocked".to_string(), Dynamic::Bool(true))
    ])))
}

