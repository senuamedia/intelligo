/// Start time tracking
async fn start_time_tracking(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    #[derive(Deserialize)]
    struct StartTimeRequest {
        course_id: Option<CourseId>,
        lesson_id: Option<String>
    }

    let body: StartTimeRequest = req.json().await.unwrap_or(StartTimeRequest {
        course_id: None,
        lesson_id: None
    });

    let session = db.time_tracking().start_session(&auth.user_id, body.course_id, body.lesson_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(Map::from([
        ("session_id".to_string(), Dynamic::String(session.session_id))
    ])))
}

