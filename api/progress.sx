// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

async fn get_module_progress_list(db: &Database, user_id: &str, modules: &List<Module>) -> List<ModuleProgressSummary> {
    let mut result = vec![];
    for module in modules {
        let progress = db.progress().get_module_progress(user_id, &module.id).await.ok();
        result.push(ModuleProgressSummary {
            module_id: module.id.clone(),
            title: module.title.clone(),
            progress: progress.as_ref().map(|p| p.progress).unwrap_or(0.0),
            completed_lessons: progress.as_ref().map(|p| p.completed_lessons).unwrap_or(0),
            total_lessons: module.lesson_count,
            is_locked: progress.as_ref().map(|p| p.is_locked).unwrap_or(false),
            unlock_date: progress.as_ref().and_then(|p| p.unlock_date),
            completed_at: progress.as_ref().and_then(|p| p.completed_at)
        });
    }
    result
}

async fn get_next_item(db: &Database, user_id: &str, course_id: &str) -> Option<NextItemInfo> {
    db.progress().get_next_item(user_id, course_id).await.ok().flatten().map(|item| NextItemInfo {
        item_type: item.item_type,
        item_id: item.item_id,
        item_title: item.item_title
    })
}

async fn get_upcoming_deadlines(db: &Database, user_id: &str) -> List<DeadlineItem> {
    db.assignments().find_upcoming_for_user(user_id, 5).await.ok().unwrap_or_default()
        .into_iter().map(|a| DeadlineItem {
            item_type: "assignment".to_string(),
            item_id: a.id,
            item_title: a.title,
            course_id: a.course_id,
            course_title: a.course_title.unwrap_or_default(),
            due_date: a.due_date.unwrap(),
            is_past_due: a.due_date.map(|d| d < DateTime::now()).unwrap_or(false)
        }).collect()
}

async fn calculate_streak(db: &Database, user_id: &str) -> i32 {
    db.activity().calculate_streak(user_id).await.unwrap_or(0)
}

fn activity_to_response(activity: &Activity) -> ActivityItem {
    ActivityItem {
        id: activity.id.clone(),
        type_: activity.activity_type.clone(),
        description: activity.description.clone(),
        course_id: activity.course_id.clone(),
        course_title: activity.course_title.clone(),
        item_id: activity.item_id.clone(),
        item_title: activity.item_title.clone(),
        timestamp: activity.timestamp,
        data: activity.data.clone()
    }
}

