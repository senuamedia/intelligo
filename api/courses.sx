/// Get course enrollments
async fn get_course_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    // Must be instructor or admin
    let course = get_editable_course(&db, &course_id, &ctx).await?;

    let pagination = PaginationParams::from_request(&req);
    let role = req.query_param("role").and_then(|r| parse_course_role(&r));
    let status = req.query_param("status").and_then(|s| parse_enrollment_status(&s));

    let (enrollments, total) = db.enrollments()
        .list_by_course(&course_id, role.as_ref(), status.as_ref(), pagination.limit(), pagination.offset())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(enrollments, meta, &ctx)))
}

