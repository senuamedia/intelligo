fn validate_create_course_input(input: &CreateCourseRequest) -> Result<(), ApiError> {
    let mut errors = vec![];

    if input.code.is_empty() {
        errors.push(FieldError {
            field: "code".to_string(),
            code: "required".to_string(),
            message: "Course code is required".to_string()
        });
    }

    if input.title.is_empty() {
        errors.push(FieldError {
            field: "title".to_string(),
            code: "required".to_string(),
            message: "Course title is required".to_string()
        });
    }

    if !errors.is_empty() {
        return Err(ApiError::ValidationError {
            field: "".to_string(),
            message: "Validation failed".to_string(),
            errors
        })
    }

    Ok(())
}

async fn can_view_course(ctx: &RequestContext, course: &Course, db: &Database) -> Bool {
    // Public courses are viewable by all
    if course.visibility == CourseVisibility::Public && course.status == CourseStatus::Published {
        return true
    }

    // Admins can view all
    if ctx.has_permission(Permission::ViewAllCourses) {
        return true
    }

    // Check enrollment
    if let Some(user_id) = ctx.user_id() {
        let enrolled = db.enrollments()
            .is_enrolled(&user_id, &course.id)
            .await
            .unwrap_or(false);
        if enrolled {
            return true
        }
    }

    false
}

async fn can_edit_course(ctx: &RequestContext, course: &Course, db: &Database) -> Bool {
    // Admins can edit all
    if ctx.has_permission(Permission::EditAllCourses) {
        return true
    }

    // Check if instructor
    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, &course.id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            return e.can_edit_content()
        }
    }

    false
}

async fn get_viewable_course(db: &Database, course_id: &str, ctx: &RequestContext) -> Result<Course, ApiError> {
    let course = db.courses()
        .find_by_id(course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.to_string()
        })?;

    if !can_view_course(ctx, &course, db).await {
        return Err(ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.to_string()
        })
    }

    Ok(course)
}

async fn get_editable_course(db: &Database, course_id: &str, ctx: &RequestContext) -> Result<Course, ApiError> {
    let course = db.courses()
        .find_by_id(course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.to_string()
        })?;

    if !can_edit_course(ctx, &course, db).await {
        return Err(ApiError::Forbidden {
            message: "You don't have permission to edit this course".to_string(),
            required_permission: Some("EditCourses".to_string())
        })
    }

    Ok(course)
}

async fn validate_for_publishing(db: &Database, course: &Course) -> Result<(), ApiError> {
    let mut errors = vec![];

    // Check has at least one module
    let module_count = db.modules()
        .count_by_course(&course.id)
        .await
        .unwrap_or(0);

    if module_count == 0 {
        errors.push(FieldError {
            field: "modules".to_string(),
            code: "required".to_string(),
            message: "Course must have at least one module".to_string()
        });
    }

    // Check has title and description
    if course.title.is_empty() {
        errors.push(FieldError {
            field: "title".to_string(),
            code: "required".to_string(),
            message: "Course must have a title".to_string()
        });
    }

    if !errors.is_empty() {
        return Err(ApiError::ValidationError {
            field: "".to_string(),
            message: "Course is not ready for publishing".to_string(),
            errors
        })
    }

    Ok(())
}

