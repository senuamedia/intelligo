fn parse_course_status(s: &str) -> Option<CourseStatus> {
    match s.to_lowercase().as_str() {
        "draft" => Some(CourseStatus::Draft),
        "published" => Some(CourseStatus::Published),
        "archived" => Some(CourseStatus::Archived),
        _ => None
    }
}

fn parse_course_visibility(s: &str) -> Option<CourseVisibility> {
    match s.to_lowercase().as_str() {
        "public" => Some(CourseVisibility::Public),
        "private" => Some(CourseVisibility::Private),
        "institution" => Some(CourseVisibility::Institution),
        _ => None
    }
}

fn parse_course_role(s: &str) -> Option<CourseRole> {
    match s.to_lowercase().as_str() {
        "student" => Some(CourseRole::Student),
        "teacher" | "instructor" => Some(CourseRole::Teacher),
        "ta" | "teaching_assistant" => Some(CourseRole::TeachingAssistant),
        "grader" => Some(CourseRole::Grader),
        "auditor" => Some(CourseRole::Auditor),
        _ => None
    }
}

fn parse_enrollment_status(s: &str) -> Option<EnrollmentStatus> {
    match s.to_lowercase().as_str() {
        "active" => Some(EnrollmentStatus::Active),
        "completed" => Some(EnrollmentStatus::Completed),
        "withdrawn" => Some(EnrollmentStatus::Withdrawn),
        "inactive" => Some(EnrollmentStatus::Inactive),
        _ => None
    }
}

