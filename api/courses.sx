/// Get grading configuration
async fn get_grading_config(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_viewable_course(&db, &course_id, &ctx).await?;

    let config = db.grading_configs()
        .find_by_course(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(config, &ctx)))
}

/// Update grading configuration
async fn update_grading_config(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    let body: GradingConfig = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let config = db.grading_configs()
        .upsert(&course_id, body)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(config, &ctx)))
}

// =============================================================================
// ANNOUNCEMENTS
// =============================================================================

/// List course announcements
async fn list_announcements(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_viewable_course(&db, &course_id, &ctx).await?;

    let pagination = PaginationParams::from_request(&req);

    let (announcements, total) = db.announcements()
        .list_by_course(&course_id, pagination.limit(), pagination.offset())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(announcements, meta, &ctx)))
}

/// Create announcement
async fn create_announcement(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    #[derive(Deserialize)]
    struct CreateAnnouncementRequest {
        title: String,
        content: String,
        is_pinned: Option<Bool>,
        publish_at: Option<DateTime>,
        send_notification: Option<Bool>
    }

    let body: CreateAnnouncementRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let announcement = db.announcements()
        .create(CreateAnnouncementInput {
            course_id: course_id.clone(),
            title: body.title,
            content: body.content,
            author_id: ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
                message: "User ID required".to_string()
            })?,
            is_pinned: body.is_pinned.unwrap_or(false),
            publish_at: body.publish_at
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Send notifications if requested
    if body.send_notification.unwrap_or(true) && body.publish_at.is_none() {
        send_announcement_notifications(&db, &course_id, &announcement).await.ok();
    }

    Ok(Response::json(ApiResponse::success(announcement, &ctx))
        .with_status(StatusCode::CREATED))
}

