// =============================================================================
// COURSE DUPLICATION
// =============================================================================

/// Duplicate a course
async fn duplicate_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::CreateCourses)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let source = get_viewable_course(&db, &course_id, &ctx).await?;

    #[derive(Deserialize)]
    struct DuplicateRequest {
        new_code: String,
        new_title: String,
        include_content: Option<Bool>,
        include_assessments: Option<Bool>,
        include_enrollments: Option<Bool>
    }

    let body: DuplicateRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Check code uniqueness
    let existing = db.courses()
        .find_by_code(&body.new_code, ctx.tenant_id().as_ref())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if existing.is_some() {
        return Err(ApiError::Conflict {
            message: "A course with this code already exists".to_string()
        })
    }

    let new_course = db.courses()
        .duplicate(
            &course_id,
            &body.new_code,
            &body.new_title,
            ctx.tenant_id().as_ref(),
            ctx.user_id().as_ref(),
            body.include_content.unwrap_or(true),
            body.include_assessments.unwrap_or(true)
        )
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(course_to_list_item(&new_course), &ctx))
        .with_status(StatusCode::CREATED))
}

/// Export course
async fn export_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    #[derive(Deserialize)]
    struct ExportRequest {
        format: Option<String>,  // "imscc", "scorm", "json"
        include_media: Option<Bool>
    }

    let body: ExportRequest = req.json().await.unwrap_or(ExportRequest {
        format: Some("imscc".to_string()),
        include_media: Some(true)
    });

    let format = body.format.unwrap_or("imscc".to_string());

    let export_url = db.courses()
        .export(&course_id, &format, body.include_media.unwrap_or(true))
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("download_url".to_string(), Dynamic::String(export_url)),
        ("format".to_string(), Dynamic::String(format)),
        ("message".to_string(), Dynamic::String("Export started. Download will be available shortly.".to_string()))
    ])))
}

/// Import course
async fn import_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::CreateCourses)?;

    let file = req.file("package").await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid file upload: {}", e)
    })?;

    #[derive(Deserialize)]
    struct ImportOptions {
        code: String,
        title: Option<String>
    }

    let options: ImportOptions = req.form_field("options")
        .and_then(|o| serde_json::from_str(&o).ok())
        .ok_or_else(|| ApiError::BadRequest {
            message: "Import options required".to_string()
        })?;

    // Check code uniqueness
    let existing = db.courses()
        .find_by_code(&options.code, ctx.tenant_id().as_ref())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if existing.is_some() {
        return Err(ApiError::Conflict {
            message: "A course with this code already exists".to_string()
        })
    }

    let course = db.courses()
        .import(&file, &options.code, options.title.as_deref(), ctx.tenant_id().as_ref(), ctx.user_id().as_ref())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(course_to_list_item(&course), &ctx))
        .with_status(StatusCode::CREATED))
}

