// =============================================================================
// LIST COURSES
// =============================================================================

/// List courses with pagination and filtering
async fn list_courses(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    // Parse pagination
    let pagination = PaginationParams::from_request(&req);

    // Parse filters
    let status = req.query_param("status").and_then(|s| parse_course_status(&s));
    let visibility = req.query_param("visibility").and_then(|v| parse_course_visibility(&v));
    let category_id = req.query_param("category_id");
    let instructor_id = req.query_param("instructor_id");
    let search = req.query_param("search");

    // Determine access scope
    let scope = if ctx.has_permission(Permission::ViewAllCourses) {
        CourseScope::All
    } else if let Some(user_id) = ctx.user_id() {
        CourseScope::UserEnrolledOrInstructing(user_id)
    } else {
        CourseScope::PublicOnly
    };

    // Query courses
    let filter = CourseFilter {
        status,
        visibility,
        category_id,
        instructor_id,
        search,
        tenant_id: ctx.tenant_id(),
        scope
    };

    let (courses, total) = db.courses()
        .list_with_filter(&filter, pagination.limit(), pagination.offset())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Convert to list items
    let items: List<CourseListItem> = courses.iter().map(course_to_list_item).collect();

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(items, meta, &ctx)))
}

// =============================================================================
// GET COURSE
// =============================================================================

/// Get a specific course
async fn get_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let course = db.courses()
        .find_by_id(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.clone()
        })?;

    // Check access
    if !can_view_course(&ctx, &course, &db).await {
        return Err(ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id
        })
    }

    // Get additional data
    let instructors = db.enrollments()
        .get_instructors(&course_id)
        .await
        .unwrap_or_default();

    let enrollment_count = db.enrollments()
        .count_by_course(&course_id)
        .await
        .unwrap_or(0);

    let response = course_to_response(&course, &instructors, enrollment_count);

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// CREATE COURSE
// =============================================================================

/// Create a new course
async fn create_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::CreateCourses)?;

    let body: CreateCourseRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate input
    validate_create_course_input(&body)?;

    // Check code uniqueness
    let existing = db.courses()
        .find_by_code(&body.code, ctx.tenant_id().as_ref())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if existing.is_some() {
        return Err(ApiError::Conflict {
            message: "A course with this code already exists".to_string()
        })
    }

    // Create course
    let course = db.courses()
        .create(CreateCourseInput {
            code: body.code,
            title: body.title,
            short_description: body.short_description,
            description: body.description,
            category_id: body.category_id,
            tags: body.tags.unwrap_or_default(),
            level: body.level,
            language: body.language.unwrap_or("en".to_string()),
            start_date: body.start_date,
            end_date: body.end_date,
            self_enrollment: body.self_enrollment.unwrap_or(false),
            visibility: body.visibility.unwrap_or(CourseVisibility::Private),
            tenant_id: ctx.tenant_id(),
            created_by: ctx.user_id()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Add creator as instructor
    if let Some(user_id) = ctx.user_id() {
        db.enrollments()
            .create(CreateEnrollmentInput {
                course_id: course.id.clone(),
                user_id: user_id.clone(),
                role: CourseRole::Teacher,
                section_id: None,
                start_date: None,
                end_date: None,
                source: EnrollmentSource::Manual,
                external_id: None,
                metadata: None
            })
            .await
            .ok();
    }

    // If template provided, copy structure
    if let Some(template_id) = body.template_id {
        copy_course_structure(&db, &template_id, &course.id).await.ok();
    }

    let instructors = vec![];
    let response = course_to_response(&course, &instructors, 0);

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

// =============================================================================
// UPDATE COURSE
// =============================================================================

/// Update a course
async fn update_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    // Get course
    let course = db.courses()
        .find_by_id(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.clone()
        })?;

    // Check permission
    if !can_edit_course(&ctx, &course, &db).await {
        return Err(ApiError::Forbidden {
            message: "You don't have permission to edit this course".to_string(),
            required_permission: Some("EditCourses".to_string())
        })
    }

    let body: UpdateCourseRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Check code uniqueness if changing
    if let Some(new_code) = &body.code {
        if new_code != &course.code {
            let existing = db.courses()
                .find_by_code(new_code, ctx.tenant_id().as_ref())
                .await
                .map_err(|e| ApiError::InternalError {
                    message: e.to_string(),
                    trace_id: ctx.trace_id.clone()
                })?;

            if existing.is_some() {
                return Err(ApiError::Conflict {
                    message: "A course with this code already exists".to_string()
                })
            }
        }
    }

    // Update course
    let updated = db.courses()
        .update(&course_id, UpdateCourseInput::from(body))
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let instructors = db.enrollments()
        .get_instructors(&course_id)
        .await
        .unwrap_or_default();

    let enrollment_count = db.enrollments()
        .count_by_course(&course_id)
        .await
        .unwrap_or(0);

    let response = course_to_response(&updated, &instructors, enrollment_count);

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// DELETE COURSE
// =============================================================================

/// Delete a course
async fn delete_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    // Get course
    let course = db.courses()
        .find_by_id(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Course".to_string(),
            id: course_id.clone()
        })?;

    // Check permission
    ctx.require_permission(Permission::DeleteCourses)?;

    // Check if course has active enrollments
    let enrollment_count = db.enrollments()
        .count_active_by_course(&course_id)
        .await
        .unwrap_or(0);

    if enrollment_count > 0 {
        let force = req.query_param("force").map(|v| v == "true").unwrap_or(false);
        if !force {
            return Err(ApiError::Conflict {
                message: format!("Course has {} active enrollments. Use ?force=true to delete anyway.", enrollment_count)
            })
        }
    }

    // Soft delete
    db.courses()
        .soft_delete(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Course deleted successfully".to_string()))
    ])))
}

// =============================================================================
// PUBLISH/UNPUBLISH
// =============================================================================

/// Publish a course
async fn publish_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let course = get_editable_course(&db, &course_id, &ctx).await?;

    // Validate course is ready for publishing
    validate_for_publishing(&db, &course).await?;

    // Publish
    let updated = db.courses()
        .publish(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Course published successfully".to_string())),
        ("status".to_string(), Dynamic::String(format!("{:?}", updated.status)))
    ])))
}

/// Unpublish a course
async fn unpublish_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    db.courses()
        .unpublish(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Course unpublished".to_string()))
    ])))
}

/// Archive a course
async fn archive_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    db.courses()
        .archive(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Course archived".to_string()))
    ])))
}

// =============================================================================
// COURSE STRUCTURE
// =============================================================================

/// Get course structure (modules, lessons, assessments hierarchy)
async fn get_course_structure(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let course = get_viewable_course(&db, &course_id, &ctx).await?;

    let modules = db.modules()
        .find_by_course(&course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let mut structure_modules = vec![];
    let mut total_lessons = 0;
    let mut total_assessments = 0;
    let mut total_duration = 0;

    for module in modules {
        let lessons = db.lessons()
            .find_by_module(&module.id)
            .await
            .unwrap_or_default();

        let assessments = db.assessments()
            .find_by_module(&module.id)
            .await
            .unwrap_or_default();

        total_lessons += lessons.len() as i32;
        total_assessments += assessments.len() as i32;

        for lesson in &lessons {
            if let Some(duration) = lesson.duration_minutes {
                total_duration += duration;
            }
        }

        structure_modules.push(ModuleStructure {
            id: module.id.clone(),
            title: module.title.clone(),
            position: module.position,
            is_published: module.is_published,
            lessons: lessons.iter().map(|l| LessonStructure {
                id: l.id.clone(),
                title: l.title.clone(),
                lesson_type: format!("{:?}", l.lesson_type),
                position: l.position,
                duration_minutes: l.duration_minutes,
                is_published: l.is_published,
                is_required: l.is_required
            }).collect(),
            assessments: assessments.iter().map(|a| AssessmentStructure {
                id: a.id.clone(),
                title: a.title.clone(),
                assessment_type: format!("{:?}", a.assessment_type),
                position: a.position,
                points: a.max_points,
                is_published: a.is_published,
                due_date: a.due_date
            }).collect()
        });
    }

    let structure = CourseStructure {
        course_id: course_id.clone(),
        modules: structure_modules,
        total_lessons,
        total_assessments,
        total_duration_minutes: total_duration
    };

    Ok(Response::json(ApiResponse::success(structure, &ctx)))
}

/// Update course structure (reorder modules, lessons)
async fn update_course_structure(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    #[derive(Deserialize)]
    struct UpdateStructureRequest {
        modules: List<ModuleOrderItem>
    }

    #[derive(Deserialize)]
    struct ModuleOrderItem {
        id: ModuleId,
        position: i32,
        lessons: Option<List<LessonOrderItem>>,
        assessments: Option<List<AssessmentOrderItem>>
    }

    #[derive(Deserialize)]
    struct LessonOrderItem {
        id: LessonId,
        position: i32
    }

    #[derive(Deserialize)]
    struct AssessmentOrderItem {
        id: AssessmentId,
        position: i32
    }

    let body: UpdateStructureRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Update module positions
    for module_item in &body.modules {
        db.modules()
            .update_position(&module_item.id, module_item.position)
            .await
            .ok();

        // Update lesson positions
        if let Some(lessons) = &module_item.lessons {
            for lesson_item in lessons {
                db.lessons()
                    .update_position(&lesson_item.id, lesson_item.position)
                    .await
                    .ok();
            }
        }

        // Update assessment positions
        if let Some(assessments) = &module_item.assessments {
            for assessment_item in assessments {
                db.assessments()
                    .update_position(&assessment_item.id, assessment_item.position)
                    .await
                    .ok();
            }
        }
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Course structure updated".to_string()))
    ])))
}

