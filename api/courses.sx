/// Intelligo LMS - Courses API
///
/// This module provides course management endpoints:
/// - Course CRUD operations
/// - Course publishing and versioning
/// - Course settings and configuration
/// - Course duplication and templates

module intelligo::api::courses

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::entities::course::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the courses router
pub fn router(db: Database) -> Router {
    Router::new()
        // Course CRUD
        .get("/", move |req| list_courses(req, db.clone()))
        .get("/:course_id", move |req| get_course(req, db.clone()))
        .post("/", move |req| create_course(req, db.clone()))
        .patch("/:course_id", move |req| update_course(req, db.clone()))
        .delete("/:course_id", move |req| delete_course(req, db.clone()))

        // Course publishing
        .post("/:course_id/publish", move |req| publish_course(req, db.clone()))
        .post("/:course_id/unpublish", move |req| unpublish_course(req, db.clone()))
        .post("/:course_id/archive", move |req| archive_course(req, db.clone()))

        // Course structure
        .get("/:course_id/structure", move |req| get_course_structure(req, db.clone()))
        .put("/:course_id/structure", move |req| update_course_structure(req, db.clone()))

        // Course modules (nested)
        .get("/:course_id/modules", move |req| get_course_modules(req, db.clone()))
        .post("/:course_id/modules", move |req| add_module_to_course(req, db.clone()))
        .put("/:course_id/modules/order", move |req| reorder_modules(req, db.clone()))

        // Course settings
        .get("/:course_id/settings", move |req| get_course_settings(req, db.clone()))
        .patch("/:course_id/settings", move |req| update_course_settings(req, db.clone()))

        // Course enrollments summary
        .get("/:course_id/enrollments", move |req| get_course_enrollments(req, db.clone()))
        .get("/:course_id/enrollments/stats", move |req| get_enrollment_stats(req, db.clone()))

        // Course analytics
        .get("/:course_id/analytics", move |req| get_course_analytics(req, db.clone()))
        .get("/:course_id/analytics/engagement", move |req| get_engagement_analytics(req, db.clone()))
        .get("/:course_id/analytics/completion", move |req| get_completion_analytics(req, db.clone()))

        // Course content
        .get("/:course_id/syllabus", move |req| get_syllabus(req, db.clone()))
        .put("/:course_id/syllabus", move |req| update_syllabus(req, db.clone()))

        // Course media
        .post("/:course_id/thumbnail", move |req| upload_thumbnail(req, db.clone()))
        .delete("/:course_id/thumbnail", move |req| delete_thumbnail(req, db.clone()))
        .post("/:course_id/banner", move |req| upload_banner(req, db.clone()))

        // Course duplication and templates
        .post("/:course_id/duplicate", move |req| duplicate_course(req, db.clone()))
        .post("/:course_id/export", move |req| export_course(req, db.clone()))
        .post("/import", move |req| import_course(req, db.clone()))

        // Course versioning
        .get("/:course_id/versions", move |req| list_versions(req, db.clone()))
        .post("/:course_id/versions", move |req| create_version(req, db.clone()))
        .get("/:course_id/versions/:version_id", move |req| get_version(req, db.clone()))
        .post("/:course_id/versions/:version_id/restore", move |req| restore_version(req, db.clone()))

        // Grading configuration
        .get("/:course_id/grading", move |req| get_grading_config(req, db.clone()))
        .put("/:course_id/grading", move |req| update_grading_config(req, db.clone()))

        // Announcements
        .get("/:course_id/announcements", move |req| list_announcements(req, db.clone()))
        .post("/:course_id/announcements", move |req| create_announcement(req, db.clone()))
}

