/// Add module to course
async fn add_module_to_course(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    #[derive(Deserialize)]
    struct AddModuleRequest {
        title: String,
        description: Option<String>,
        position: Option<i32>
    }

    let body: AddModuleRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Get next position if not specified
    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.modules()
            .get_next_position(&course_id)
            .await
            .unwrap_or(0)
    };

    let module = db.modules()
        .create(CreateModuleInput {
            course_id: course_id.clone(),
            title: body.title,
            description: body.description,
            position,
            tenant_id: ctx.tenant_id()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(module, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Reorder modules
async fn reorder_modules(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    #[derive(Deserialize)]
    struct ReorderRequest {
        module_ids: List<ModuleId>
    }

    let body: ReorderRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    for (position, module_id) in body.module_ids.iter().enumerate() {
        db.modules()
            .update_position(module_id, position as i32)
            .await
            .ok();
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Modules reordered".to_string()))
    ])))
}

