/// Upload course thumbnail
async fn upload_thumbnail(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    let file = req.file("thumbnail").await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid file upload: {}", e)
    })?;

    // Validate file
    if !file.content_type.starts_with("image/") {
        return Err(ApiError::ValidationError {
            field: "thumbnail".to_string(),
            message: "File must be an image".to_string(),
            errors: vec![]
        })
    }

    let url = db.storage()
        .upload_course_thumbnail(&course_id, &file)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    db.courses()
        .update_thumbnail(&course_id, &url)
        .await
        .ok();

    Ok(Response::json(Map::from([
        ("thumbnail_url".to_string(), Dynamic::String(url))
    ])))
}

/// Delete course thumbnail
async fn delete_thumbnail(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    db.storage().delete_course_thumbnail(&course_id).await.ok();
    db.courses().update_thumbnail(&course_id, "").await.ok();

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Thumbnail deleted".to_string()))
    ])))
}

