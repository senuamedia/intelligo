// Types referenced but not defined
type GradingConfig {
    course_id: CourseId,
    scheme_id: String,
    categories: List<GradingCategory>,
    late_policy: LatePolicy
}

type GradingCategory {
    id: String,
    name: String,
    weight: f32,
    drop_lowest: i32
}

type LatePolicy {
    penalty_type: String,
    penalty_per_day: f32,
    max_penalty: f32,
    grace_period_hours: i32
}

type CreateAnnouncementInput {
    course_id: CourseId,
    title: String,
    content: String,
    author_id: UserId,
    is_pinned: Bool,
    publish_at: Option<DateTime>
}

enum CourseScope {
    All,
    UserEnrolledOrInstructing(UserId),
    PublicOnly
}

type CourseFilter {
    status: Option<CourseStatus>,
    visibility: Option<CourseVisibility>,
    category_id: Option<String>,
    instructor_id: Option<UserId>,
    search: Option<String>,
    tenant_id: Option<TenantId>,
    scope: CourseScope
}

