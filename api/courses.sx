    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let version_id = req.param("version_id").ok_or_else(|| ApiError::BadRequest {
        message: "Version ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    let version = db.course_versions()
        .find_by_id(&version_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Version".to_string(),
            id: version_id
        })?;

    Ok(Response::json(ApiResponse::success(version, &ctx)))
}

/// Restore a version
async fn restore_version(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let version_id = req.param("version_id").ok_or_else(|| ApiError::BadRequest {
        message: "Version ID required".to_string()
    })?;

    let _ = get_editable_course(&db, &course_id, &ctx).await?;

    db.course_versions()
        .restore(&course_id, &version_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Version restored".to_string()))
    ])))
}

