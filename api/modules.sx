/// Add assessment to module
async fn add_assessment_to_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = get_editable_module(&db, &module_id, &ctx).await?;

    #[derive(Deserialize)]
    struct AddAssessmentRequest {
        title: String,
        assessment_type: String,
        description: Option<String>,
        max_points: Option<f32>,
        due_date: Option<DateTime>,
        position: Option<i32>
    }

    let body: AddAssessmentRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.assessments()
            .get_next_position(&module_id)
            .await
            .unwrap_or(0)
    };

    let assessment = db.assessments()
        .create(CreateAssessmentInput {
            module_id: module_id.clone(),
            course_id: module.course_id.clone(),
            title: body.title,
            assessment_type: parse_assessment_type(&body.assessment_type)?,
