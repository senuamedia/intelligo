/// Intelligo LMS - Modules API
///
/// This module provides module management endpoints:
/// - Module CRUD operations
/// - Module ordering and visibility
/// - Module content management

module intelligo::api::modules

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::entities::module::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the modules router
pub fn router(db: Database) -> Router {
    Router::new()
        // Module CRUD
        .get("/", move |req| list_modules(req, db.clone()))
        .get("/:module_id", move |req| get_module(req, db.clone()))
        .post("/", move |req| create_module(req, db.clone()))
        .patch("/:module_id", move |req| update_module(req, db.clone()))
        .delete("/:module_id", move |req| delete_module(req, db.clone()))

        // Module publishing
        .post("/:module_id/publish", move |req| publish_module(req, db.clone()))
        .post("/:module_id/unpublish", move |req| unpublish_module(req, db.clone()))

        // Module lessons
        .get("/:module_id/lessons", move |req| get_module_lessons(req, db.clone()))
        .post("/:module_id/lessons", move |req| add_lesson_to_module(req, db.clone()))
        .put("/:module_id/lessons/order", move |req| reorder_lessons(req, db.clone()))

        // Module assessments
        .get("/:module_id/assessments", move |req| get_module_assessments(req, db.clone()))
        .post("/:module_id/assessments", move |req| add_assessment_to_module(req, db.clone()))

        // Module prerequisites
        .get("/:module_id/prerequisites", move |req| get_prerequisites(req, db.clone()))
        .put("/:module_id/prerequisites", move |req| update_prerequisites(req, db.clone()))

        // Module progress (for student)
        .get("/:module_id/progress", move |req| get_module_progress(req, db.clone()))

        // Bulk operations
        .post("/bulk/publish", move |req| bulk_publish_modules(req, db.clone()))
        .post("/bulk/delete", move |req| bulk_delete_modules(req, db.clone()))

        // Duplication
        .post("/:module_id/duplicate", move |req| duplicate_module(req, db.clone()))
}

// =============================================================================
// REQUEST/RESPONSE TYPES
// =============================================================================

/// Module response type
type ModuleResponse {
    id: ModuleId,
    course_id: CourseId,
    title: String,
    description: Option<String>,
    position: i32,
    is_published: Bool,
    unlock_at: Option<DateTime>,
    lock_at: Option<DateTime>,
    require_sequential: Bool,
    prerequisites: List<PrerequisiteInfo>,
    lesson_count: i32,
    assessment_count: i32,
    duration_minutes: i32,
    completion_type: ModuleCompletionType,
    created_at: DateTime,
    updated_at: DateTime
}

/// Module list item
type ModuleListItem {
    id: ModuleId,
    course_id: CourseId,
    title: String,
    position: i32,
    is_published: Bool,
    lesson_count: i32,
    assessment_count: i32
}

/// Prerequisite info
type PrerequisiteInfo {
    module_id: ModuleId,
    title: String,
    requirement_type: PrerequisiteType
}

/// Create module request
type CreateModuleRequest {
    course_id: CourseId,
    title: String,
    description: Option<String>,
    position: Option<i32>,
    unlock_at: Option<DateTime>,
    lock_at: Option<DateTime>,
    require_sequential: Option<Bool>,
    completion_type: Option<ModuleCompletionType>
}

/// Update module request
type UpdateModuleRequest {
    title: Option<String>,
    description: Option<String>,
    position: Option<i32>,
    unlock_at: Option<DateTime>,
    lock_at: Option<DateTime>,
    require_sequential: Option<Bool>,
    completion_type: Option<ModuleCompletionType>
}

/// Module completion type
enum ModuleCompletionType {
    /// All items must be completed
    All,
    /// Specific items must be completed
    Required,
    /// Any subset of items
    Any { minimum: i32 },
    /// No completion tracking
    None
}

/// Prerequisite type
enum PrerequisiteType {
    /// Must complete the prerequisite module
    Complete,
    /// Must view the prerequisite module
    View,
    /// Must score above threshold on prerequisite
    Score { minimum: f32 }
}

/// Module progress response
type ModuleProgressResponse {
    module_id: ModuleId,
    enrollment_id: EnrollmentId,
    percentage: f32,
    is_completed: Bool,
    completed_at: Option<DateTime>,
    items_completed: i32,
    total_items: i32,
    lesson_progress: List<LessonProgressItem>,
    assessment_progress: List<AssessmentProgressItem>,
    time_spent_seconds: i64
}

/// Lesson progress item
type LessonProgressItem {
    lesson_id: LessonId,
    title: String,
    is_completed: Bool,
    completed_at: Option<DateTime>,
    time_spent_seconds: i64
}

/// Assessment progress item
type AssessmentProgressItem {
    assessment_id: AssessmentId,
    title: String,
    is_completed: Bool,
    score: Option<f32>,
    max_score: f32,
    attempts: i32
}

// =============================================================================
// LIST MODULES
// =============================================================================

/// List modules
async fn list_modules(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let pagination = PaginationParams::from_request(&req);
    let course_id = req.query_param("course_id");

    let (modules, total) = if let Some(cid) = course_id {
        // Verify course access
        verify_course_access(&db, &cid, &ctx).await?;

        db.modules()
            .find_by_course(&cid)
            .await
            .map(|m| (m.clone(), m.len() as i64))
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    } else {
        ctx.require_permission(Permission::ViewAllCourses)?;

        db.modules()
            .list_all(ctx.tenant_id().as_ref(), pagination.limit(), pagination.offset())
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    };

    let items: List<ModuleListItem> = modules.iter().map(|m| ModuleListItem {
        id: m.id.clone(),
        course_id: m.course_id.clone(),
        title: m.title.clone(),
        position: m.position,
        is_published: m.is_published,
        lesson_count: 0, // Would be populated
        assessment_count: 0
    }).collect();

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(items, meta, &ctx)))
}

// =============================================================================
// GET MODULE
// =============================================================================

/// Get a specific module
async fn get_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = db.modules()
        .find_by_id(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id.clone()
        })?;

    // Verify course access
    verify_course_access(&db, &module.course_id, &ctx).await?;

    // Check if module is visible (published or user can edit)
    if !module.is_published && !can_edit_course_content(&db, &module.course_id, &ctx).await {
        return Err(ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id
        })
    }

    let response = module_to_response(&db, &module).await;

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// CREATE MODULE
// =============================================================================

/// Create a new module
async fn create_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: CreateModuleRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Verify course edit access
    verify_course_edit_access(&db, &body.course_id, &ctx).await?;

    // Validate
    if body.title.is_empty() {
        return Err(ApiError::ValidationError {
            field: "title".to_string(),
            message: "Module title is required".to_string(),
            errors: vec![]
        })
    }

    // Get next position if not specified
    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.modules()
            .get_next_position(&body.course_id)
            .await
            .unwrap_or(0)
    };

    let module = db.modules()
        .create(CreateModuleInput {
            course_id: body.course_id,
            title: body.title,
            description: body.description,
            position,
            unlock_at: body.unlock_at,
            lock_at: body.lock_at,
            require_sequential: body.require_sequential.unwrap_or(false),
            completion_type: body.completion_type.unwrap_or(ModuleCompletionType::All),
            tenant_id: ctx.tenant_id()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = module_to_response(&db, &module).await;

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

// =============================================================================
// UPDATE MODULE
// =============================================================================

/// Update a module
async fn update_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = db.modules()
        .find_by_id(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id.clone()
        })?;

    // Verify course edit access
    verify_course_edit_access(&db, &module.course_id, &ctx).await?;

    let body: UpdateModuleRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let updated = db.modules()
        .update(&module_id, UpdateModuleInput {
            title: body.title,
            description: body.description,
            position: body.position,
            unlock_at: body.unlock_at,
            lock_at: body.lock_at,
            require_sequential: body.require_sequential,
            completion_type: body.completion_type
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = module_to_response(&db, &updated).await;

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// DELETE MODULE
// =============================================================================

/// Delete a module
async fn delete_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = db.modules()
        .find_by_id(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id.clone()
        })?;

    // Verify course edit access
    verify_course_edit_access(&db, &module.course_id, &ctx).await?;

    // Check for content
    let lesson_count = db.lessons()
        .count_by_module(&module_id)
        .await
        .unwrap_or(0);

    let assessment_count = db.assessments()
        .count_by_module(&module_id)
        .await
        .unwrap_or(0);

    if lesson_count > 0 || assessment_count > 0 {
        let force = req.query_param("force").map(|v| v == "true").unwrap_or(false);
        if !force {
            return Err(ApiError::Conflict {
                message: format!("Module has {} lessons and {} assessments. Use ?force=true to delete.", lesson_count, assessment_count)
            })
        }

        // Delete all content
        db.lessons().delete_by_module(&module_id).await.ok();
        db.assessments().delete_by_module(&module_id).await.ok();
    }

    db.modules()
        .delete(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Module deleted".to_string()))
    ])))
}

