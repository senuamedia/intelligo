/// Publish a module
async fn publish_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = get_editable_module(&db, &module_id, &ctx).await?;

    db.modules()
        .publish(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Module published".to_string()))
    ])))
}

/// Unpublish a module
async fn unpublish_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let _ = get_editable_module(&db, &module_id, &ctx).await?;

    db.modules()
        .unpublish(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Module unpublished".to_string()))
    ])))
}

// =============================================================================
// MODULE LESSONS
// =============================================================================

/// Get module lessons
async fn get_module_lessons(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = get_viewable_module(&db, &module_id, &ctx).await?;

    let lessons = db.lessons()
        .find_by_module(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Filter unpublished if not editor
    let can_edit = can_edit_course_content(&db, &module.course_id, &ctx).await;
    let filtered: List<_> = if can_edit {
        lessons
    } else {
        lessons.into_iter().filter(|l| l.is_published).collect()
    };

    Ok(Response::json(ApiResponse::success(filtered, &ctx)))
}

/// Add lesson to module
async fn add_lesson_to_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = get_editable_module(&db, &module_id, &ctx).await?;

    #[derive(Deserialize)]
    struct AddLessonRequest {
        title: String,
        lesson_type: String,
        description: Option<String>,
        duration_minutes: Option<i32>,
        position: Option<i32>
    }

    let body: AddLessonRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.lessons()
            .get_next_position(&module_id)
            .await
            .unwrap_or(0)
    };

    let lesson = db.lessons()
        .create(CreateLessonInput {
            module_id: module_id.clone(),
            course_id: module.course_id.clone(),
            title: body.title,
            lesson_type: parse_lesson_type(&body.lesson_type)?,
            description: body.description,
            duration_minutes: body.duration_minutes,
            position,
            tenant_id: ctx.tenant_id()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(lesson, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Reorder lessons
async fn reorder_lessons(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let _ = get_editable_module(&db, &module_id, &ctx).await?;

    #[derive(Deserialize)]
    struct ReorderRequest {
        lesson_ids: List<LessonId>
    }

    let body: ReorderRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    for (position, lesson_id) in body.lesson_ids.iter().enumerate() {
        db.lessons()
            .update_position(lesson_id, position as i32)
            .await
            .ok();
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Lessons reordered".to_string()))
    ])))
}

