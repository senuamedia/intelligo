// =============================================================================
// PREREQUISITES
// =============================================================================

/// Get module prerequisites
async fn get_prerequisites(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let _ = get_viewable_module(&db, &module_id, &ctx).await?;

    let prerequisites = db.module_prerequisites()
        .find_by_module(&module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(prerequisites, &ctx)))
}

/// Update module prerequisites
async fn update_prerequisites(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let _ = get_editable_module(&db, &module_id, &ctx).await?;

    #[derive(Deserialize)]
    struct UpdatePrerequisitesRequest {
        prerequisites: List<PrerequisiteInput>
    }

    #[derive(Deserialize)]
    struct PrerequisiteInput {
        module_id: ModuleId,
        requirement_type: PrerequisiteType
    }

    let body: UpdatePrerequisitesRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate no circular dependencies
    for prereq in &body.prerequisites {
        if prereq.module_id == module_id {
            return Err(ApiError::ValidationError {
                field: "prerequisites".to_string(),
                message: "Module cannot be its own prerequisite".to_string(),
                errors: vec![]
            })
        }
    }

    // Replace prerequisites
    db.module_prerequisites()
        .replace(&module_id, &body.prerequisites)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Prerequisites updated".to_string()))
    ])))
}

// =============================================================================
// MODULE PROGRESS
// =============================================================================

/// Get module progress for current user
async fn get_module_progress(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let module = get_viewable_module(&db, &module_id, &ctx).await?;

    // Get enrollment
    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &module.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled in this course".to_string(),
            required_permission: None
        })?;

    let progress = db.progress()
        .get_module_progress(&enrollment.id, &module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(progress, &ctx)))
}

// =============================================================================
// BULK OPERATIONS
// =============================================================================

/// Bulk publish modules
async fn bulk_publish_modules(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    #[derive(Deserialize)]
    struct BulkPublishRequest {
        module_ids: List<ModuleId>
    }

    let body: BulkPublishRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let mut published = 0;
    let mut errors = vec![];

    for module_id in body.module_ids {
        match get_editable_module(&db, &module_id, &ctx).await {
            Ok(_) => {
                match db.modules().publish(&module_id).await {
                    Ok(_) => published += 1,
                    Err(e) => errors.push(Map::from([
                        ("module_id".to_string(), Dynamic::String(module_id)),
                        ("error".to_string(), Dynamic::String(e.to_string()))
                    ]))
                }
            },
            Err(e) => errors.push(Map::from([
                ("module_id".to_string(), Dynamic::String(module_id)),
                ("error".to_string(), Dynamic::String(format!("{:?}", e)))
            ]))
        }
    }

    Ok(Response::json(Map::from([
        ("published".to_string(), Dynamic::Int(published)),
        ("errors".to_string(), Dynamic::List(errors.into_iter().map(Dynamic::Map).collect()))
    ])))
}

/// Bulk delete modules
async fn bulk_delete_modules(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    #[derive(Deserialize)]
    struct BulkDeleteRequest {
        module_ids: List<ModuleId>,
        force: Option<Bool>
    }

    let body: BulkDeleteRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let force = body.force.unwrap_or(false);
    let mut deleted = 0;
    let mut errors = vec![];

    for module_id in body.module_ids {
        match get_editable_module(&db, &module_id, &ctx).await {
            Ok(_) => {
                if force {
                    db.lessons().delete_by_module(&module_id).await.ok();
                    db.assessments().delete_by_module(&module_id).await.ok();
                }

                match db.modules().delete(&module_id).await {
                    Ok(_) => deleted += 1,
                    Err(e) => errors.push(Map::from([
                        ("module_id".to_string(), Dynamic::String(module_id)),
                        ("error".to_string(), Dynamic::String(e.to_string()))
                    ]))
                }
            },
            Err(e) => errors.push(Map::from([
                ("module_id".to_string(), Dynamic::String(module_id)),
                ("error".to_string(), Dynamic::String(format!("{:?}", e)))
            ]))
        }
    }

    Ok(Response::json(Map::from([
        ("deleted".to_string(), Dynamic::Int(deleted)),
        ("errors".to_string(), Dynamic::List(errors.into_iter().map(Dynamic::Map).collect()))
    ])))
}

// =============================================================================
// DUPLICATION
// =============================================================================

/// Duplicate a module
async fn duplicate_module(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let module_id = req.param("module_id").ok_or_else(|| ApiError::BadRequest {
        message: "Module ID required".to_string()
    })?;

    let module = get_editable_module(&db, &module_id, &ctx).await?;

    #[derive(Deserialize)]
    struct DuplicateRequest {
        new_title: Option<String>,
        target_course_id: Option<CourseId>,
        include_content: Option<Bool>
    }

    let body: DuplicateRequest = req.json().await.unwrap_or(DuplicateRequest {
        new_title: None,
        target_course_id: None,
        include_content: Some(true)
    });

    // Verify target course access if different
    let target_course = body.target_course_id.clone().unwrap_or(module.course_id.clone());
    if target_course != module.course_id {
        verify_course_edit_access(&db, &target_course, &ctx).await?;
    }

    let new_module = db.modules()
        .duplicate(
            &module_id,
            body.new_title.as_deref(),
            Some(&target_course),
            body.include_content.unwrap_or(true)
        )
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = module_to_response(&db, &new_module).await;

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

async fn module_to_response(db: &Database, module: &Module) -> ModuleResponse {
    let lesson_count = db.lessons()
        .count_by_module(&module.id)
        .await
        .unwrap_or(0) as i32;

    let assessment_count = db.assessments()
        .count_by_module(&module.id)
        .await
        .unwrap_or(0) as i32;

    let duration_minutes = db.lessons()
        .total_duration_by_module(&module.id)
        .await
        .unwrap_or(0);

    ModuleResponse {
        id: module.id.clone(),
        course_id: module.course_id.clone(),
        title: module.title.clone(),
        description: module.description.clone(),
        position: module.position,
        is_published: module.is_published,
        unlock_at: module.unlock_at,
        lock_at: module.lock_at,
        require_sequential: module.require_sequential,
        prerequisites: vec![],
        lesson_count,
        assessment_count,
        duration_minutes,
        completion_type: module.completion_type.clone(),
        created_at: module.created_at,
        updated_at: module.updated_at
    }
}

async fn verify_course_access(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Result<(), ApiError> {
    if ctx.has_permission(Permission::ViewAllCourses) {
        return Ok(())
    }

    if let Some(user_id) = ctx.user_id() {
        let enrolled = db.enrollments()
            .is_enrolled(&user_id, course_id)
            .await
            .unwrap_or(false);

        if enrolled {
            return Ok(())
        }
    }

    // Check if course is public
    let course = db.courses()
        .find_by_id(course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if let Some(c) = course {
        if c.visibility == CourseVisibility::Public && c.status == CourseStatus::Published {
            return Ok(())
        }
    }

    Err(ApiError::Forbidden {
        message: "Access denied".to_string(),
        required_permission: None
    })
}

async fn verify_course_edit_access(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Result<(), ApiError> {
    if ctx.has_permission(Permission::EditAllCourses) {
        return Ok(())
    }

    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, course_id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            if e.can_edit_content() {
                return Ok(())
            }
        }
    }

    Err(ApiError::Forbidden {
        message: "You don't have permission to edit this course".to_string(),
        required_permission: Some("EditCourses".to_string())
    })
}

async fn can_edit_course_content(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Bool {
    if ctx.has_permission(Permission::EditAllCourses) {
        return true
    }

    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, course_id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            return e.can_edit_content()
        }
    }

    false
}

async fn get_viewable_module(db: &Database, module_id: &str, ctx: &RequestContext) -> Result<Module, ApiError> {
    let module = db.modules()
        .find_by_id(module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id.to_string()
        })?;

    verify_course_access(db, &module.course_id, ctx).await?;

    if !module.is_published && !can_edit_course_content(db, &module.course_id, ctx).await {
        return Err(ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id.to_string()
        })
    }

    Ok(module)
}

async fn get_editable_module(db: &Database, module_id: &str, ctx: &RequestContext) -> Result<Module, ApiError> {
    let module = db.modules()
        .find_by_id(module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: module_id.to_string()
        })?;

    verify_course_edit_access(db, &module.course_id, ctx).await?;

    Ok(module)
}

fn parse_lesson_type(s: &str) -> Result<LessonType, ApiError> {
    match s.to_lowercase().as_str() {
        "video" => Ok(LessonType::Video),
        "text" | "article" => Ok(LessonType::Text),
        "document" | "pdf" => Ok(LessonType::Document),
        "presentation" => Ok(LessonType::Presentation),
        "interactive" => Ok(LessonType::Interactive),
        "external" => Ok(LessonType::External),
        "audio" => Ok(LessonType::Audio),
        "live" => Ok(LessonType::Live),
        _ => Err(ApiError::ValidationError {
            field: "lesson_type".to_string(),
            message: format!("Unknown lesson type: {}", s),
            errors: vec![]
        })
    }
}

fn parse_assessment_type(s: &str) -> Result<AssessmentType, ApiError> {
    match s.to_lowercase().as_str() {
        "quiz" => Ok(AssessmentType::Quiz),
        "exam" => Ok(AssessmentType::Exam),
        "assignment" => Ok(AssessmentType::Assignment),
        "discussion" => Ok(AssessmentType::Discussion),
        "project" => Ok(AssessmentType::Project),
        "survey" => Ok(AssessmentType::Survey),
        _ => Err(ApiError::ValidationError {
            field: "assessment_type".to_string(),
            message: format!("Unknown assessment type: {}", s),
            errors: vec![]
        })
    }
}

