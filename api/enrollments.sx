/// Intelligo LMS - Enrollments API
///
/// This module provides enrollment management endpoints:
/// - Enrollment CRUD operations
/// - Bulk enrollment operations
/// - Self-enrollment and enrollment requests
/// - Enrollment analytics and reporting

module intelligo::api::enrollments

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::entities::enrollment::*
use intelligo::entities::course::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the enrollments router
pub fn router(db: Database) -> Router {
    Router::new()
        // Enrollment CRUD
        .get("/", move |req| list_enrollments(req, db.clone()))
        .get("/:enrollment_id", move |req| get_enrollment(req, db.clone()))
        .post("/", move |req| create_enrollment(req, db.clone()))
        .patch("/:enrollment_id", move |req| update_enrollment(req, db.clone()))
        .delete("/:enrollment_id", move |req| delete_enrollment(req, db.clone()))

        // Course-specific enrollments
        .get("/courses/:course_id", move |req| get_course_enrollments(req, db.clone()))
        .post("/courses/:course_id/bulk", move |req| bulk_enroll(req, db.clone()))
        .delete("/courses/:course_id/bulk", move |req| bulk_unenroll(req, db.clone()))

        // User-specific enrollments
        .get("/users/:user_id", move |req| get_user_enrollments(req, db.clone()))
        .get("/my", move |req| get_my_enrollments(req, db.clone()))

        // Self-enrollment
        .post("/courses/:course_id/self-enroll", move |req| self_enroll(req, db.clone()))
        .delete("/courses/:course_id/self-unenroll", move |req| self_unenroll(req, db.clone()))

        // Enrollment requests
        .get("/requests", move |req| list_enrollment_requests(req, db.clone()))
        .post("/courses/:course_id/request", move |req| request_enrollment(req, db.clone()))
        .post("/requests/:request_id/approve", move |req| approve_request(req, db.clone()))
        .post("/requests/:request_id/deny", move |req| deny_request(req, db.clone()))

        // Invitations
        .post("/courses/:course_id/invite", move |req| send_invitation(req, db.clone()))
        .post("/invitations/:code/accept", move |req| accept_invitation(req, db.clone()))
        .get("/invitations/:code", move |req| get_invitation(req, db.clone()))

        // Sections
        .get("/courses/:course_id/sections", move |req| get_course_sections(req, db.clone()))
        .post("/courses/:course_id/sections", move |req| create_section(req, db.clone()))
        .patch("/sections/:section_id", move |req| update_section(req, db.clone()))
        .delete("/sections/:section_id", move |req| delete_section(req, db.clone()))
        .post("/sections/:section_id/assign", move |req| assign_to_section(req, db.clone()))

        // Analytics
        .get("/courses/:course_id/analytics", move |req| get_enrollment_analytics(req, db.clone()))
        .get("/courses/:course_id/activity", move |req| get_enrollment_activity(req, db.clone()))

        // Import/Export
        .get("/courses/:course_id/export", move |req| export_enrollments(req, db.clone()))
        .post("/courses/:course_id/import", move |req| import_enrollments(req, db.clone()))
}

// =============================================================================
// REQUEST/RESPONSE TYPES
// =============================================================================

/// Enrollment response
type EnrollmentResponse {
    id: EnrollmentId,
    user_id: UserId,
    user_name: String,
    user_email: String,
    user_avatar: Option<String>,
    course_id: CourseId,
    course_title: String,
    course_code: String,
    role: CourseRole,
    status: EnrollmentStatus,
    section_id: Option<String>,
    section_name: Option<String>,
    start_date: Option<DateTime>,
    end_date: Option<DateTime>,
    progress: Option<EnrollmentProgress>,
    last_activity: Option<DateTime>,
    enrolled_at: DateTime,
    enrolled_by: Option<UserId>,
    source: EnrollmentSource,
    metadata: Option<Map<String, Dynamic>>
}

/// Enrollment progress
type EnrollmentProgress {
    completed_items: i32,
    total_items: i32,
    percentage: f64,
    current_grade: Option<f64>,
    current_letter: Option<String>,
    time_spent_minutes: i64
}

/// Create enrollment request
type CreateEnrollmentRequest {
    user_id: UserId,
    course_id: CourseId,
    role: Option<CourseRole>,
    section_id: Option<String>,
    start_date: Option<DateTime>,
    end_date: Option<DateTime>,
    notify_user: Option<Bool>,
    metadata: Option<Map<String, Dynamic>>
}

/// Update enrollment request
type UpdateEnrollmentRequest {
    role: Option<CourseRole>,
    status: Option<EnrollmentStatus>,
    section_id: Option<String>,
    start_date: Option<DateTime>,
    end_date: Option<DateTime>,
    metadata: Option<Map<String, Dynamic>>
}

