// INVITATIONS
// =============================================================================

/// Send enrollment invitations
async fn send_invitation(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let body: SendInvitationRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    let created_by = ctx.auth.as_ref().map(|a| a.user_id.clone());
    let expires_at = DateTime::now() + Duration::days(body.expires_in_days.unwrap_or(7) as i64);

    let mut invitations: List<InvitationResponse> = vec![];

    for email in body.emails {
        let code = generate_invitation_code();

        let invitation = db.invitations().create(CreateInvitationInput {
            course_id: course_id.clone(),
            email: email.clone(),
            role: body.role.clone().unwrap_or(CourseRole::Student),
            section_id: body.section_id.clone(),
            code: code.clone(),
            expires_at,
            created_by: created_by.clone()
        }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

        // Send invitation email
        send_invitation_email(&email, &course, &code, body.message.as_deref()).await.ok();

        invitations.push(invitation_to_response(&invitation));
    }

    Ok(Response::json(ApiResponse::success(invitations, &ctx)))
}

/// Accept invitation
async fn accept_invitation(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let code = req.param("code").ok_or_else(|| ApiError::BadRequest {
        message: "Invitation code required".to_string()
    })?;

    let invitation = db.invitations().find_by_code(&code).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Invitation".to_string(), id: code.clone() })?;

    if invitation.status != InvitationStatus::Pending {
        return Err(ApiError::BadRequest { message: "Invitation is no longer valid".to_string() })
    }

    if invitation.expires_at < DateTime::now() {
        return Err(ApiError::BadRequest { message: "Invitation has expired".to_string() })
    }

    // Create enrollment
    let enrollment = db.enrollments().create(CreateEnrollmentInput {
        user_id: auth.user_id.clone(),
        course_id: invitation.course_id.clone(),
        role: invitation.role.clone(),
        section_id: invitation.section_id.clone(),
        start_date: None,
        end_date: None,
        source: EnrollmentSource::Invite,
        enrolled_by: None,
        metadata: None
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Mark invitation as accepted
    db.invitations().mark_accepted(&code, &auth.user_id).await.ok();

    Ok(Response::json(ApiResponse::success(enrollment_to_response(&enrollment), &ctx)))
}

/// Get invitation details
async fn get_invitation(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let code = req.param("code").ok_or_else(|| ApiError::BadRequest {
        message: "Invitation code required".to_string()
    })?;

    let invitation = db.invitations().find_by_code(&code).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Invitation".to_string(), id: code.clone() })?;

    Ok(Response::json(ApiResponse::success(invitation_to_response(&invitation), &ctx)))
}

