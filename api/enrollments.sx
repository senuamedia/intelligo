async fn build_enrollment_with_course(enrollment: &Enrollment, course: &Course, db: &Database) -> EnrollmentWithCourse {
    EnrollmentWithCourse {
        enrollment: enrollment_to_response(enrollment),
        course: CourseInfo {
            id: course.id.clone(),
            code: course.code.clone(),
            title: course.title.clone(),
            short_description: course.short_description.clone(),
            thumbnail_url: course.thumbnail_url.clone(),
            instructor_names: vec![],
            start_date: course.start_date,
            end_date: course.end_date
        },
        next_deadline: None,
        recent_activity: None
    }
}

fn compute_enrollment_analytics(course_id: &str, enrollments: &List<Enrollment>, sections: &List<Section>) -> EnrollmentAnalyticsResponse {
    let total = enrollments.len() as i32;
    let active = enrollments.iter().filter(|e| e.status == EnrollmentStatus::Active).count() as i32;
    let completed = enrollments.iter().filter(|e| e.status == EnrollmentStatus::Completed).count() as i32;
    let dropped = enrollments.iter().filter(|e| e.status == EnrollmentStatus::Dropped).count() as i32;

    let mut role_counts: Map<CourseRole, i32> = Map::new();
    for e in enrollments {
        *role_counts.entry(e.role.clone()).or_insert(0) += 1;
    }

    let role_distribution = role_counts.iter()
        .map(|(role, count)| RoleCount { role: role.clone(), count: *count })
        .collect();

    let mut section_counts: Map<String, i32> = Map::new();
    for e in enrollments {
        if let Some(sid) = &e.section_id {
            *section_counts.entry(sid.clone()).or_insert(0) += 1;
        }
    }

    let section_distribution = section_counts.iter()
        .map(|(sid, count)| {
            let name = sections.iter().find(|s| s.id == *sid).map(|s| s.name.clone()).unwrap_or_default();
            SectionCount { section_id: sid.clone(), section_name: name, count: *count }
        })
        .collect();

    EnrollmentAnalyticsResponse {
        course_id: course_id.to_string(),
        total_enrolled: total,
        active_enrollments: active,
        completed_enrollments: completed,
        dropped_enrollments: dropped,
        enrollment_trend: vec![],
        role_distribution,
        section_distribution,
        completion_stats: CompletionStats {
            not_started: 0,
            in_progress: active,
            completed,
            average_completion_percentage: 0.0,
            average_time_to_complete_days: None
        }
    }
}

fn parse_enrollment_status(s: &str) -> Option<EnrollmentStatus> {
    match s.to_lowercase().as_str() {
        "active" => Some(EnrollmentStatus::Active),
        "completed" => Some(EnrollmentStatus::Completed),
        "dropped" => Some(EnrollmentStatus::Dropped),
        "pending" => Some(EnrollmentStatus::Pending),
        _ => None
    }
}

fn parse_course_role(s: &str) -> Option<CourseRole> {
    match s.to_lowercase().as_str() {
        "student" => Some(CourseRole::Student),
        "instructor" => Some(CourseRole::Instructor),
        "ta" | "teaching_assistant" => Some(CourseRole::TeachingAssistant),
        "observer" => Some(CourseRole::Observer),
        "designer" => Some(CourseRole::Designer),
        _ => None
    }
}

fn generate_invitation_code() -> String {
    use std::random::random;
    let chars: Vec<char> = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789".chars().collect();
    (0..8).map(|_| chars[(random::<u8>() as usize) % chars.len()]).collect()
}

