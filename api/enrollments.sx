// =============================================================================
// ENROLLMENT CRUD
// =============================================================================

/// List all enrollments (admin)
async fn list_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let pagination = PaginationParams::from_request(&req);

    let course_id = req.query_param("course_id");
    let user_id = req.query_param("user_id");
    let status = req.query_param("status").map(|s| parse_enrollment_status(&s));
    let role = req.query_param("role").map(|r| parse_course_role(&r));

    let (enrollments, total) = db.enrollments()
        .find_with_filters(EnrollmentFilters {
            course_id,
            user_id,
            status,
            role,
            limit: Some(pagination.limit()),
            offset: Some(pagination.offset())
        })
        .await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let responses: List<EnrollmentResponse> = enrollments.iter()
        .map(|e| enrollment_to_response(e))
        .collect();

    Ok(Response::json(ApiResponse::paginated(responses, pagination.to_meta(total), &ctx)))
}

/// Get single enrollment
async fn get_enrollment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let enrollment_id = req.param("enrollment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Enrollment ID required".to_string()
    })?;

    let enrollment = db.enrollments().find_by_id(&enrollment_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Enrollment".to_string(), id: enrollment_id.clone() })?;

    // Check access
    let is_own = ctx.auth.as_ref().map(|a| a.user_id == enrollment.user_id).unwrap_or(false);
    if !is_own && !ctx.has_permission(Permission::ViewEnrollments) {
        return Err(ApiError::Forbidden { message: "Access denied".to_string(), required_permission: None })
    }

    Ok(Response::json(ApiResponse::success(enrollment_to_response(&enrollment), &ctx)))
}

/// Create enrollment
async fn create_enrollment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let body: CreateEnrollmentRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Verify course exists
    let course = db.courses().find_by_id(&body.course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: body.course_id.clone() })?;

    // Verify user exists
    let user = db.users().find_by_id(&body.user_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "User".to_string(), id: body.user_id.clone() })?;

    // Check for existing enrollment
    let existing = db.enrollments().find_by_user_and_course(&body.user_id, &body.course_id).await.ok().flatten();
    if existing.is_some() {
        return Err(ApiError::Conflict { message: "User is already enrolled in this course".to_string() })
    }

    // Check enrollment cap
    if let Some(cap) = course.enrollment_cap {
        let current_count = db.enrollments().count_by_course(&body.course_id).await.unwrap_or(0);
        if current_count >= cap as i64 {
            return Err(ApiError::BadRequest { message: "Course enrollment cap reached".to_string() })
        }
    }

    let enrolled_by = ctx.auth.as_ref().map(|a| a.user_id.clone());

    let enrollment = db.enrollments().create(CreateEnrollmentInput {
        user_id: body.user_id.clone(),
        course_id: body.course_id.clone(),
        role: body.role.unwrap_or(CourseRole::Student),
        section_id: body.section_id,
        start_date: body.start_date,
        end_date: body.end_date,
        source: EnrollmentSource::Manual,
        enrolled_by,
        metadata: body.metadata
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Notify user if requested
    if body.notify_user.unwrap_or(true) {
        notify_enrollment(&enrollment, &course, &user).await.ok();
    }

    Ok(Response::json(ApiResponse::success(enrollment_to_response(&enrollment), &ctx))
        .with_status(StatusCode::CREATED))
}

/// Update enrollment
async fn update_enrollment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let enrollment_id = req.param("enrollment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Enrollment ID required".to_string()
    })?;

    let body: UpdateEnrollmentRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let enrollment = db.enrollments().update(&enrollment_id, UpdateEnrollmentInput {
        role: body.role,
        status: body.status,
        section_id: body.section_id,
        start_date: body.start_date,
        end_date: body.end_date,
        metadata: body.metadata
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(enrollment_to_response(&enrollment), &ctx)))
}

/// Delete enrollment
async fn delete_enrollment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let enrollment_id = req.param("enrollment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Enrollment ID required".to_string()
    })?;

    db.enrollments().delete(&enrollment_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Enrollment deleted".to_string()))
    ])))
}

// =============================================================================
// COURSE ENROLLMENTS
// =============================================================================

/// Get course enrollments
async fn get_course_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    // Verify course access
    verify_course_instructor_access(&db, &ctx, &course_id).await?;

    let pagination = PaginationParams::from_request(&req);
    let status = req.query_param("status").map(|s| parse_enrollment_status(&s));
    let role = req.query_param("role").map(|r| parse_course_role(&r));
    let section_id = req.query_param("section_id");
    let search = req.query_param("search");

    let (enrollments, total) = db.enrollments()
        .find_by_course_with_filters(&course_id, EnrollmentCourseFilters {
            status,
            role,
            section_id,
            search,
            limit: Some(pagination.limit()),
            offset: Some(pagination.offset())
        })
        .await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let responses: List<EnrollmentResponse> = enrollments.iter()
        .map(|e| enrollment_to_response(e))
        .collect();

    Ok(Response::json(ApiResponse::paginated(responses, pagination.to_meta(total), &ctx)))
}

/// Bulk enroll users
async fn bulk_enroll(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let body: BulkEnrollRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    let enrolled_by = ctx.auth.as_ref().map(|a| a.user_id.clone());
    let mut enrolled = 0;
    let mut failed = 0;
    let mut errors: List<BulkEnrollError> = vec![];
    let mut enrollments: List<EnrollmentResponse> = vec![];

    for user_entry in body.users {
        let user_id = if let Some(id) = user_entry.user_id {
            Some(id)
        } else if let Some(email) = &user_entry.email {
            db.users().find_by_email(email).await.ok().flatten().map(|u| u.id)
        } else {
            None
        };

        let identifier = user_entry.user_id.clone()
            .or(user_entry.email.clone())
            .unwrap_or_else(|| "unknown".to_string());

        match user_id {
            Some(uid) => {
                // Check if already enrolled
                let existing = db.enrollments().find_by_user_and_course(&uid, &course_id).await.ok().flatten();
                if existing.is_some() {
                    errors.push(BulkEnrollError {
                        user_identifier: identifier,
                        error: "Already enrolled".to_string()
                    });
                    failed += 1;
                    continue;
                }

                match db.enrollments().create(CreateEnrollmentInput {
                    user_id: uid.clone(),
                    course_id: course_id.clone(),
                    role: user_entry.role.or(body.role).unwrap_or(CourseRole::Student),
                    section_id: body.section_id.clone(),
                    start_date: body.start_date,
                    end_date: body.end_date,
                    source: EnrollmentSource::Manual,
                    enrolled_by: enrolled_by.clone(),
                    metadata: None
                }).await {
                    Ok(e) => {
                        enrolled += 1;
                        enrollments.push(enrollment_to_response(&e));
                    },
                    Err(e) => {
                        errors.push(BulkEnrollError {
                            user_identifier: identifier,
                            error: e.to_string()
                        });
                        failed += 1;
                    }
                }
            },
            None => {
                errors.push(BulkEnrollError {
                    user_identifier: identifier,
                    error: "User not found".to_string()
                });
                failed += 1;
            }
        }
    }

    // Notify users if requested
    if body.notify_users.unwrap_or(true) && enrolled > 0 {
        notify_bulk_enrollment(&course, enrolled).await.ok();
    }

    Ok(Response::json(ApiResponse::success(BulkEnrollResponse {
        enrolled, failed, errors, enrollments
    }, &ctx)))
}

/// Bulk unenroll users
async fn bulk_unenroll(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    #[derive(Deserialize)]
    struct BulkUnenrollRequest {
        user_ids: List<UserId>,
        notify_users: Option<Bool>
    }

    let body: BulkUnenrollRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let mut unenrolled = 0;
    let mut errors: List<String> = vec![];

    for user_id in body.user_ids {
        match db.enrollments().delete_by_user_and_course(&user_id, &course_id).await {
            Ok(_) => unenrolled += 1,
            Err(e) => errors.push(format!("Error for user {}: {}", user_id, e))
        }
    }

    Ok(Response::json(ApiResponse::success(Map::from([
        ("unenrolled".to_string(), Dynamic::Int(unenrolled)),
        ("errors".to_string(), Dynamic::List(errors.iter().map(|e| Dynamic::String(e.clone())).collect()))
    ]), &ctx)))
}

// =============================================================================
// USER ENROLLMENTS
// =============================================================================

/// Get user enrollments
async fn get_user_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    let is_own = ctx.auth.as_ref().map(|a| a.user_id.to_string() == user_id).unwrap_or(false);
    if !is_own && !ctx.has_permission(Permission::ViewEnrollments) {
        return Err(ApiError::Forbidden { message: "Access denied".to_string(), required_permission: None })
    }

    let enrollments = db.enrollments().find_by_user(&user_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let responses: List<EnrollmentResponse> = enrollments.iter()
        .map(|e| enrollment_to_response(e))
        .collect();

    Ok(Response::json(ApiResponse::success(responses, &ctx)))
}

/// Get my enrollments
async fn get_my_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let enrollments = db.enrollments().find_by_user(&auth.user_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let now = DateTime::now();
    let mut current: List<EnrollmentWithCourse> = vec![];
    let mut past: List<EnrollmentWithCourse> = vec![];
    let mut upcoming: List<EnrollmentWithCourse> = vec![];

    for enrollment in enrollments {
        if let Some(course) = db.courses().find_by_id(&enrollment.course_id).await.ok().flatten() {
            let enrollment_with_course = build_enrollment_with_course(&enrollment, &course, &db).await;

            if enrollment.status == EnrollmentStatus::Completed {
                past.push(enrollment_with_course);
            } else if enrollment.start_date.map(|d| d > now).unwrap_or(false) {
                upcoming.push(enrollment_with_course);
            } else {
                current.push(enrollment_with_course);
            }
        }
    }

    Ok(Response::json(ApiResponse::success(MyEnrollmentsResponse {
        current, past, upcoming
    }, &ctx)))
}

// =============================================================================
// SELF-ENROLLMENT
// =============================================================================

/// Self enroll in course
async fn self_enroll(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let body: SelfEnrollRequest = req.json().await.unwrap_or(SelfEnrollRequest {
        enrollment_code: None,
        section_id: None
    });

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    // Check if self enrollment is allowed
    if !course.self_enrollment {
        return Err(ApiError::Forbidden {
            message: "Self-enrollment is not enabled for this course".to_string(),
            required_permission: None
        })
    }

    // Check enrollment code if required
    if let Some(required_code) = &course.enrollment_code {
        let provided_code = body.enrollment_code.as_ref().ok_or_else(|| ApiError::BadRequest {
            message: "Enrollment code required".to_string()
        })?;

        if provided_code != required_code {
            return Err(ApiError::BadRequest {
                message: "Invalid enrollment code".to_string()
            })
        }
    }

    // Check if already enrolled
    let existing = db.enrollments().find_by_user_and_course(&auth.user_id, &course_id).await.ok().flatten();
    if existing.is_some() {
        return Err(ApiError::Conflict {
            message: "You are already enrolled in this course".to_string()
        })
    }

    // Check enrollment cap
    if let Some(cap) = course.enrollment_cap {
        let current_count = db.enrollments().count_by_course(&course_id).await.unwrap_or(0);
        if current_count >= cap as i64 {
            return Err(ApiError::BadRequest {
                message: "Course enrollment cap reached".to_string()
            })
        }
    }

    // Check enrollment window
    let now = DateTime::now();
    if let Some(start) = course.enrollment_start {
        if now < start {
            return Err(ApiError::BadRequest {
                message: "Enrollment has not opened yet".to_string()
            })
        }
    }
    if let Some(end) = course.enrollment_end {
        if now > end {
            return Err(ApiError::BadRequest {
                message: "Enrollment has closed".to_string()
            })
        }
    }

    let enrollment = db.enrollments().create(CreateEnrollmentInput {
        user_id: auth.user_id.clone(),
        course_id: course_id.clone(),
        role: CourseRole::Student,
        section_id: body.section_id,
        start_date: None,
        end_date: None,
        source: EnrollmentSource::SelfEnrollment,
        enrolled_by: None,
        metadata: None
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(enrollment_to_response(&enrollment), &ctx))
        .with_status(StatusCode::CREATED))
}

/// Self unenroll from course
async fn self_unenroll(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, &course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Enrollment".to_string(),
            id: format!("{}/{}", course_id, auth.user_id)
        })?;

    // Only allow self-unenroll if originally self-enrolled
    if enrollment.source != EnrollmentSource::SelfEnrollment {
        return Err(ApiError::Forbidden {
            message: "Cannot self-unenroll from this course".to_string(),
            required_permission: None
        })
    }

    db.enrollments().delete(&enrollment.id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Successfully unenrolled".to_string()))
    ])))
}

