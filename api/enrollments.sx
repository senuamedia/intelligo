// =============================================================================
// IMPORT/EXPORT
// =============================================================================

/// Export enrollments
async fn export_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();

    let mut csv = String::from("User ID,Email,Name,Role,Section,Status,Enrolled At\n");
    for e in enrollments {
        csv.push_str(&format!("{},{},{},{},{},{},{}\n",
            e.user_id,
            e.user_email.unwrap_or_default(),
            e.user_name.unwrap_or_default(),
            format!("{:?}", e.role),
            e.section_name.unwrap_or_default(),
            format!("{:?}", e.status),
            e.enrolled_at.to_rfc3339()
        ));
    }

    Ok(Response::new()
        .with_header("Content-Type", "text/csv")
        .with_header("Content-Disposition", &format!("attachment; filename=\"enrollments_{}.csv\"", course_id))
        .with_body(csv))
}

/// Import enrollments
async fn import_enrollments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    #[derive(Deserialize)]
    struct ImportRequest {
        data: String,
        notify_users: Option<Bool>
    }

    let body: ImportRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let enrolled_by = ctx.auth.as_ref().map(|a| a.user_id.clone());
    let mut imported = 0;
    let mut errors: List<String> = vec![];

    for line in body.data.lines().skip(1) {
        let parts: Vec<&str> = line.split(',').collect();
        if parts.len() >= 2 {
            let email = parts[0].trim();
            let role = parts.get(1).map(|r| parse_course_role(r.trim())).flatten().unwrap_or(CourseRole::Student);

            if let Some(user) = db.users().find_by_email(email).await.ok().flatten() {
                match db.enrollments().create(CreateEnrollmentInput {
                    user_id: user.id.clone(),
                    course_id: course_id.clone(),
                    role,
                    section_id: None,
                    start_date: None,
                    end_date: None,
                    source: EnrollmentSource::Import,
                    enrolled_by: enrolled_by.clone(),
                    metadata: None
                }).await {
                    Ok(_) => imported += 1,
                    Err(e) => errors.push(format!("{}: {}", email, e))
                }
            } else {
                errors.push(format!("{}: User not found", email));
            }
        }
    }

    Ok(Response::json(ApiResponse::success(Map::from([
        ("imported".to_string(), Dynamic::Int(imported)),
        ("errors".to_string(), Dynamic::List(errors.iter().map(|e| Dynamic::String(e.clone())).collect()))
    ]), &ctx)))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

async fn verify_course_access(db: &Database, ctx: &RequestContext, course_id: &str) -> Result<(), ApiError> {
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    if ctx.is_admin() { return Ok(()) }

    let enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, course_id).await.ok().flatten();
    if enrollment.is_some() { return Ok(()) }

    Err(ApiError::Forbidden { message: "Access denied".to_string(), required_permission: None })
}

async fn verify_course_instructor_access(db: &Database, ctx: &RequestContext, course_id: &str) -> Result<(), ApiError> {
    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    if ctx.is_admin() { return Ok(()) }

    let enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, course_id).await.ok().flatten();
    if let Some(e) = enrollment {
        if e.role.is_instructor() { return Ok(()) }
    }

    Err(ApiError::Forbidden { message: "Instructor access required".to_string(), required_permission: None })
}

fn enrollment_to_response(enrollment: &Enrollment) -> EnrollmentResponse {
    EnrollmentResponse {
        id: enrollment.id.clone(),
        user_id: enrollment.user_id.clone(),
        user_name: enrollment.user_name.clone().unwrap_or_default(),
        user_email: enrollment.user_email.clone().unwrap_or_default(),
        user_avatar: enrollment.user_avatar.clone(),
        course_id: enrollment.course_id.clone(),
        course_title: enrollment.course_title.clone().unwrap_or_default(),
        course_code: enrollment.course_code.clone().unwrap_or_default(),
        role: enrollment.role.clone(),
        status: enrollment.status.clone(),
        section_id: enrollment.section_id.clone(),
        section_name: enrollment.section_name.clone(),
        start_date: enrollment.start_date,
        end_date: enrollment.end_date,
        progress: enrollment.progress.as_ref().map(|p| EnrollmentProgress {
            completed_items: p.completed_items,
            total_items: p.total_items,
            percentage: p.percentage,
            current_grade: p.current_grade,
            current_letter: p.current_letter.clone(),
            time_spent_minutes: p.time_spent_minutes
        }),
        last_activity: enrollment.last_activity,
        enrolled_at: enrollment.enrolled_at,
        enrolled_by: enrollment.enrolled_by.clone(),
        source: enrollment.source.clone(),
        metadata: enrollment.metadata.clone()
    }
}

fn enrollment_request_to_response(request: &EnrollmentRequest) -> EnrollmentRequestResponse {
    EnrollmentRequestResponse {
        id: request.id.clone(),
        user_id: request.user_id.clone(),
        user_name: request.user_name.clone().unwrap_or_default(),
        user_email: request.user_email.clone().unwrap_or_default(),
        course_id: request.course_id.clone(),
        course_title: request.course_title.clone().unwrap_or_default(),
        message: request.message.clone(),
        status: request.status.clone(),
        requested_at: request.requested_at,
        reviewed_at: request.reviewed_at,
        reviewed_by: request.reviewed_by.clone(),
        review_note: request.review_note.clone()
    }
}

