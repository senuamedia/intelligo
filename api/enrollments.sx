/// Create section
async fn create_section(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    let body: CreateSectionRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let section = db.sections().create(CreateSectionInput {
        course_id: course_id.clone(),
        name: body.name,
        code: body.code,
        description: body.description,
        instructor_ids: body.instructor_ids.unwrap_or_default(),
        max_enrollment: body.max_enrollment,
        start_date: body.start_date,
        end_date: body.end_date,
        meeting_times: body.meeting_times,
        location: body.location
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    Ok(Response::json(ApiResponse::success(section_to_response(&section), &ctx))
        .with_status(StatusCode::CREATED))
}

/// Update section
