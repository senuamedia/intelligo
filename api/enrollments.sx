    ])))
}

/// Assign students to section
async fn assign_to_section(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let section_id = req.param("section_id").ok_or_else(|| ApiError::BadRequest {
        message: "Section ID required".to_string()
    })?;

    #[derive(Deserialize)]
    struct AssignToSectionRequest {
        enrollment_ids: List<EnrollmentId>
    }

    let body: AssignToSectionRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let mut assigned = 0;

    for enrollment_id in body.enrollment_ids {
        match db.enrollments().update(&enrollment_id, UpdateEnrollmentInput {
            role: None,
            status: None,
            section_id: Some(section_id.clone()),
            start_date: None,
            end_date: None,
            metadata: None
        }).await {
            Ok(_) => assigned += 1,
            Err(_) => {}
        }
    }

    Ok(Response::json(Map::from([
        ("assigned".to_string(), Dynamic::Int(assigned))
    ])))
}

