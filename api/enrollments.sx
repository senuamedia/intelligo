    })?;

    verify_course_instructor_access(&db, &ctx, &course_id).await?;

    let enrollments = db.enrollments().find_by_course(&course_id).await.unwrap_or_default();
    let sections = db.sections().find_by_course(&course_id).await.unwrap_or_default();

    let analytics = compute_enrollment_analytics(&course_id, &enrollments, &sections);

    Ok(Response::json(ApiResponse::success(analytics, &ctx)))
}

/// Get enrollment activity
async fn get_enrollment_activity(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    verify_course_instructor_access(&db, &ctx, &course_id).await?;

    let days = req.query_param("days").and_then(|d| d.parse::<i32>().ok()).unwrap_or(30);
