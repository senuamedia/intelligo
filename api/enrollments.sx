async fn notify_enrollment_request(request: &EnrollmentRequest, course: &Course) -> Result<(), String> { Ok(()) }
async fn notify_request_approved(request: &EnrollmentRequest) -> Result<(), String> { Ok(()) }
async fn notify_request_denied(request: &EnrollmentRequest) -> Result<(), String> { Ok(()) }
async fn send_invitation_email(email: &str, course: &Course, code: &str, message: Option<&str>) -> Result<(), String> { Ok(()) }

