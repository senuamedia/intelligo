/// List enrollment requests
async fn list_enrollment_requests(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let course_id = req.query_param("course_id");
    let status = req.query_param("status");

    let requests = db.enrollment_requests()
        .find_with_filters(EnrollmentRequestFilters { course_id, status })
        .await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    let responses: List<EnrollmentRequestResponse> = requests.iter()
        .map(|r| enrollment_request_to_response(r))
        .collect();

    Ok(Response::json(ApiResponse::success(responses, &ctx)))
}

/// Request enrollment
async fn request_enrollment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let auth = ctx.auth.as_ref().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let course_id = req.param("course_id").ok_or_else(|| ApiError::BadRequest {
        message: "Course ID required".to_string()
    })?;

    #[derive(Deserialize)]
    struct RequestEnrollmentBody {
        message: Option<String>
    }

    let body: RequestEnrollmentBody = req.json().await.unwrap_or(RequestEnrollmentBody { message: None });

    let course = db.courses().find_by_id(&course_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "Course".to_string(), id: course_id.clone() })?;

    // Check if already enrolled
    let existing_enrollment = db.enrollments().find_by_user_and_course(&auth.user_id, &course_id).await.ok().flatten();
    if existing_enrollment.is_some() {
        return Err(ApiError::Conflict { message: "Already enrolled".to_string() })
    }

    // Check for existing pending request
    let existing_request = db.enrollment_requests()
        .find_pending_by_user_and_course(&auth.user_id, &course_id)
        .await
        .ok()
        .flatten();
    if existing_request.is_some() {
        return Err(ApiError::Conflict { message: "Enrollment request already pending".to_string() })
    }

    let request = db.enrollment_requests().create(CreateEnrollmentRequestInput {
        user_id: auth.user_id.clone(),
        course_id: course_id.clone(),
        message: body.message
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Notify course instructors
    notify_enrollment_request(&request, &course).await.ok();

    Ok(Response::json(ApiResponse::success(enrollment_request_to_response(&request), &ctx))
        .with_status(StatusCode::CREATED))
}

/// Approve enrollment request
async fn approve_request(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let request_id = req.param("request_id").ok_or_else(|| ApiError::BadRequest {
        message: "Request ID required".to_string()
    })?;

    let enrollment_request = db.enrollment_requests().find_by_id(&request_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "EnrollmentRequest".to_string(), id: request_id.clone() })?;

    if enrollment_request.status != EnrollmentRequestStatus::Pending {
        return Err(ApiError::BadRequest { message: "Request is not pending".to_string() })
    }

    let reviewer_id = ctx.auth.as_ref().map(|a| a.user_id.clone());

    // Create enrollment
    let enrollment = db.enrollments().create(CreateEnrollmentInput {
        user_id: enrollment_request.user_id.clone(),
        course_id: enrollment_request.course_id.clone(),
        role: CourseRole::Student,
        section_id: None,
        start_date: None,
        end_date: None,
        source: EnrollmentSource::Request,
        enrolled_by: reviewer_id.clone(),
        metadata: None
    }).await.map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Update request status
    db.enrollment_requests().update_status(&request_id, EnrollmentRequestStatus::Approved, reviewer_id, None).await.ok();

    // Notify user
    notify_request_approved(&enrollment_request).await.ok();

    Ok(Response::json(ApiResponse::success(enrollment_to_response(&enrollment), &ctx)))
}

/// Deny enrollment request
async fn deny_request(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);
    ctx.require_permission(Permission::ManageEnrollments)?;

    let request_id = req.param("request_id").ok_or_else(|| ApiError::BadRequest {
        message: "Request ID required".to_string()
    })?;

    #[derive(Deserialize)]
    struct DenyRequestBody {
        reason: Option<String>
    }

    let body: DenyRequestBody = req.json().await.unwrap_or(DenyRequestBody { reason: None });

    let enrollment_request = db.enrollment_requests().find_by_id(&request_id).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?
        .ok_or_else(|| ApiError::NotFound { resource: "EnrollmentRequest".to_string(), id: request_id.clone() })?;

    if enrollment_request.status != EnrollmentRequestStatus::Pending {
        return Err(ApiError::BadRequest { message: "Request is not pending".to_string() })
    }

    let reviewer_id = ctx.auth.as_ref().map(|a| a.user_id.clone());

    db.enrollment_requests().update_status(&request_id, EnrollmentRequestStatus::Denied, reviewer_id, body.reason).await
        .map_err(|e| ApiError::InternalError { message: e.to_string(), trace_id: ctx.trace_id.clone() })?;

    // Notify user
    notify_request_denied(&enrollment_request).await.ok();

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Request denied".to_string()))
    ])))
}

