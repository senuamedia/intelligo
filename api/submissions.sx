/// Get plagiarism result
async fn get_plagiarism_result(
    ctx: RequestContext,
    id: SubmissionId
) -> Result<ApiResponse<Option<PlagiarismResult>>, ApiError> {
    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id)
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Check permission - students can see their own results
    if submission.student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ViewPlagiarismResults, &ctx.tenant)?;
    }

    Ok(ApiResponse::ok(submission.plagiarism))
}

/// Trigger plagiarism check
async fn trigger_plagiarism_check(
    ctx: RequestContext,
    id: SubmissionId,
    body: TriggerPlagiarismRequest
) -> Result<ApiResponse<PlagiarismCheckStatus>, ApiError> {
    check_permission(&ctx.user, Permission::ManagePlagiarism, &ctx.tenant)?;

    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify tenant
    if submission.tenant_id != ctx.tenant.id {
        return Err(ApiError::NotFound("Submission not found".into()));
    }

    // Initialize plagiarism result
    submission.plagiarism = Some(PlagiarismResult {
        provider: body.provider.unwrap_or(PlagiarismProvider::Builtin),
        similarity_score: 0.0,
        ai_probability: if body.check_ai.unwrap_or(false) { Some(0.0) } else { None },
        matches: vec![],
        sources: vec![],
        report_url: None,
        status: PlagiarismStatus::Pending,
        checked_at: DateTime::now(),
        error_message: None
    });

    db.submissions().update(&submission).await?;

    // Trigger async check
    trigger_plagiarism_check_async(&id).await;

    Ok(ApiResponse::ok(PlagiarismCheckStatus {
        submission_id: id,
        status: PlagiarismStatus::Pending,
        estimated_completion: Some(DateTime::now() + Duration::minutes(5))
    }))
}

