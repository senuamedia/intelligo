    let scores: Vec<f32> = submissions.iter().filter_map(|s| s.score).collect();
    let avg_score = if !scores.is_empty() {
        Some(scores.iter().sum::<f32>() / scores.len() as f32)
    } else {
        None
    };

    let plagiarism_flags = submissions.iter()
        .filter(|s| s.plagiarism.as_ref().map(|p| p.similarity_score > 25.0).unwrap_or(false))
        .count() as i32;

    let proctoring_flags = submissions.iter()
        .filter(|s| !s.proctoring_flags.is_empty())
