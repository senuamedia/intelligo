/// Get proctoring session
async fn get_proctoring_session(
    ctx: RequestContext,
    id: SubmissionId
) -> Result<ApiResponse<Option<ProctoringSession>>, ApiError> {
    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id)
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify access
    if submission.student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ViewProctoring, &ctx.tenant)?;
    }

    Ok(ApiResponse::ok(submission.proctoring_session))
}

/// Start proctoring session
async fn start_proctoring(
    ctx: RequestContext,
    id: SubmissionId,
    body: StartProctoringRequest
) -> Result<ApiResponse<ProctoringSession>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify ownership
    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    // Check if already started
    if submission.proctoring_session.is_some() {
        return Err(ApiError::BadRequest("Proctoring session already exists".into()));
    }

    let session = ProctoringSession::new(body.provider);
    submission.proctoring_session = Some(session.clone());
    submission.proctoring_status = Some(ProctoringStatus::PendingReview);

    db.submissions().update(&submission).await?;

    ctx.log_activity("proctoring_started", &id);

    Ok(ApiResponse::created(session))
}

/// End proctoring session
async fn end_proctoring(
    ctx: RequestContext,
    id: SubmissionId
) -> Result<ApiResponse<ProctoringSession>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify ownership
    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    let session = submission.proctoring_session
        .as_mut()
        .ok_or(ApiError::NotFound("No proctoring session".into()))?;

    session.end();

    db.submissions().update(&submission).await?;

    ctx.log_activity("proctoring_ended", &id);

    Ok(ApiResponse::ok(submission.proctoring_session.unwrap()))
}

/// Record proctoring event
async fn record_proctoring_event(
    ctx: RequestContext,
    id: SubmissionId,
    body: ProctoringEventRequest
) -> Result<ApiResponse<()>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Events can come from student or system
    if submission.student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ManageProctoring, &ctx.tenant)?;
    }

    let session = submission.proctoring_session
        .as_mut()
        .ok_or(ApiError::NotFound("No proctoring session".into()))?;

    // Determine severity
    let severity = match &body.event_type {
        ProctoringEventType::MultipleFaces => RiskLevel::High,
        ProctoringEventType::PhoneDetected => RiskLevel::High,
        ProctoringEventType::TabSwitch => RiskLevel::Medium,
        ProctoringEventType::FocusLost => RiskLevel::Low,
        _ => RiskLevel::Low
    };

    let event = ProctoringEvent {
        event_type: body.event_type.clone(),
        timestamp: DateTime::now(),
        severity: severity.clone(),
        data: body.data.clone(),
        screenshot_url: None // Would upload screenshot if provided
    };

    session.events.push(event);

    // Create flag for significant events
    if matches!(severity, RiskLevel::Medium | RiskLevel::High | RiskLevel::Critical) {
        let flag = ProctoringFlag {
            id: generate_uuid(),
            flag_type: body.event_type,
            severity,
            detected_at: DateTime::now(),
            description: format!("Proctoring event detected"),
            evidence: None,
            reviewed: false,
            decision: None,
            reviewer_notes: None,
            reviewed_by: None,
            reviewed_at: None
        };
        submission.proctoring_flags.push(flag);
    }

    db.submissions().update(&submission).await?;

    Ok(ApiResponse::no_content())
}

/// Get proctoring flags
async fn get_proctoring_flags(
    ctx: RequestContext,
    id: SubmissionId
) -> Result<ApiResponse<List<ProctoringFlag>>, ApiError> {
    check_permission(&ctx.user, Permission::ViewProctoring, &ctx.tenant)?;

    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id)
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    Ok(ApiResponse::ok(submission.proctoring_flags))
}

/// Review proctoring flag
async fn review_proctoring_flag(
    ctx: RequestContext,
    id: SubmissionId,
    flag_id: String,
    body: ReviewFlagRequest
) -> Result<ApiResponse<ProctoringFlag>, ApiError> {
    check_permission(&ctx.user, Permission::ManageProctoring, &ctx.tenant)?;

    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    let flag = submission.proctoring_flags
        .iter_mut()
        .find(|f| f.id == flag_id)
        .ok_or(ApiError::NotFound("Flag not found".into()))?;

    flag.reviewed = true;
    flag.decision = Some(body.decision);
    flag.reviewer_notes = body.notes;
    flag.reviewed_by = Some(ctx.user.id.clone());
    flag.reviewed_at = Some(DateTime::now());

    let updated_flag = flag.clone();

    db.submissions().update(&submission).await?;

    ctx.log_activity("proctoring_flag_reviewed", &flag_id);

    Ok(ApiResponse::ok(updated_flag))
}

/// Verify student identity
async fn verify_identity(
    ctx: RequestContext,
    id: SubmissionId,
    body: VerifyIdentityRequest
) -> Result<ApiResponse<IdentityVerification>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    let session = submission.proctoring_session
        .as_mut()
        .ok_or(ApiError::NotFound("No proctoring session".into()))?;

    // Perform identity verification (simplified)
    let verification = IdentityVerification {
        verified: true, // Would integrate with actual verification service
        method: body.method,
        confidence: 0.95,
        verified_at: DateTime::now(),
        photo_id_url: None,
        face_match_score: Some(0.95)
    };

    session.identity_verification = Some(verification.clone());

    db.submissions().update(&submission).await?;

    Ok(ApiResponse::ok(verification))
}

/// Submit room scan
async fn submit_room_scan(
    ctx: RequestContext,
    id: SubmissionId,
    body: RoomScanRequest
) -> Result<ApiResponse<RoomScanResult>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    let session = submission.proctoring_session
        .as_mut()
        .ok_or(ApiError::NotFound("No proctoring session".into()))?;

    let result = RoomScanResult {
        completed: true,
        completed_at: Some(DateTime::now()),
        recording_url: Some(body.recording_url),
        flags: vec![]
    };

    session.room_scan = Some(result.clone());

    db.submissions().update(&submission).await?;

    Ok(ApiResponse::ok(result))
}

// =============================================================================
// LATE SUBMISSIONS
// =============================================================================

/// Get late submission info
async fn get_late_info(
    ctx: RequestContext,
    id: SubmissionId
) -> Result<ApiResponse<LateInfoResponse>, ApiError> {
    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify access
    if submission.student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;
    }

    let assessment = db.assessments()
        .get(submission.assessment_id.clone())
        .await?
        .ok_or(ApiError::Internal("Assessment not found".into()))?;

    let due_date = assessment.settings.due_date
        .ok_or(ApiError::BadRequest("No due date set".into()))?;

    // Check for accommodation
    let enrollment = db.enrollments()
        .get(submission.enrollment_id.clone())
        .await?;

    let effective_due_date = enrollment
        .and_then(|e| e.accommodations)
        .map(|a| a.adjust_due_date(due_date))
        .unwrap_or(due_date);

    let exception = db.late_exceptions()
        .filter(LateExceptionFilter {
            submission_id: Some(id),
            ..Default::default()
        })
        .first()
        .await?;

    let final_due_date = exception.as_ref()
        .and_then(|e| e.extended_due_date)
        .unwrap_or(effective_due_date);

    let submitted_at = submission.submitted_at.unwrap_or(DateTime::now());
    let is_late = submitted_at > final_due_date;
    let late_duration = if is_late {
        Some(submitted_at - final_due_date)
    } else {
        None
    };

    Ok(ApiResponse::ok(LateInfoResponse {
        is_late,
        late_duration,
        penalty_applied: None, // Would calculate based on policy
        exception_granted: exception,
        original_due_date: due_date,
        effective_due_date: final_due_date
    }))
}

/// Grant late exception
async fn grant_late_exception(
    ctx: RequestContext,
    id: SubmissionId,
    body: GrantLateExceptionRequest
) -> Result<ApiResponse<LateException>, ApiError> {
    check_permission(&ctx.user, Permission::ManageSubmissions, &ctx.tenant)?;

    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify tenant
    if submission.tenant_id != ctx.tenant.id {
        return Err(ApiError::NotFound("Submission not found".into()));
    }

    let exception = LateException {
        reason: body.reason,
        extended_due_date: body.extended_due_date,
        penalty_waived: body.penalty_waived,
        granted_by: ctx.user.id.clone(),
        granted_at: DateTime::now()
    };

    db.late_exceptions().insert(id.clone(), &exception).await?;

    ctx.log_activity("late_exception_granted", &id);

    Ok(ApiResponse::created(exception))
}

// =============================================================================
// BATCH OPERATIONS
// =============================================================================

/// Get submissions needing grading
async fn get_needs_grading(
    ctx: RequestContext,
    query: NeedsGradingFilter
) -> Result<ApiResponse<List<Submission>>, ApiError> {
    check_permission(&ctx.user, Permission::GradeSubmissions, &ctx.tenant)?;

    let db = ctx.get_db();

    let submissions = db.submissions()
        .filter(SubmissionFilter {
            tenant_id: Some(ctx.tenant.id.clone()),
            course_id: query.course_id,
            assessment_id: query.assessment_id,
            needs_grading: Some(true),
            ..Default::default()
        })
        .order_by("submitted_at", Ascending)
        .limit(query.limit.unwrap_or(50))
        .fetch()
        .await?;

    Ok(ApiResponse::ok(submissions))
}

/// Get submissions by assessment
async fn get_by_assessment(
    ctx: RequestContext,
    assessment_id: AssessmentId,
    pagination: PaginationParams
) -> Result<ApiResponse<List<Submission>>, ApiError> {
    check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;

    let db = ctx.get_db();

    // Verify assessment tenant
    let assessment = db.assessments()
        .get(assessment_id.clone())
        .await?
        .ok_or(ApiError::NotFound("Assessment not found".into()))?;

    if assessment.tenant_id != ctx.tenant.id {
        return Err(ApiError::NotFound("Assessment not found".into()));
    }

    let submissions = db.submissions()
        .filter(SubmissionFilter {
            assessment_id: Some(assessment_id),
            tenant_id: Some(ctx.tenant.id.clone()),
            ..Default::default()
        })
        .order_by("submitted_at", Descending)
        .offset(pagination.offset)
        .limit(pagination.limit)
        .fetch()
        .await?;

    let total = db.submissions()
        .filter(SubmissionFilter {
            assessment_id: Some(assessment_id),
            ..Default::default()
        })
        .count()
        .await?;

    Ok(ApiResponse::paginated(submissions, total, pagination))
}

/// Get submissions by student
async fn get_by_student(
    ctx: RequestContext,
    student_id: StudentId,
    pagination: PaginationParams
) -> Result<ApiResponse<List<Submission>>, ApiError> {
    // Students can view their own, instructors can view all
    if student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;
    }

    let db = ctx.get_db();

    let submissions = db.submissions()
        .filter(SubmissionFilter {
            student_id: Some(student_id),
            tenant_id: Some(ctx.tenant.id.clone()),
            ..Default::default()
        })
        .order_by("submitted_at", Descending)
        .offset(pagination.offset)
        .limit(pagination.limit)
        .fetch()
        .await?;

    let total = db.submissions()
        .filter(SubmissionFilter {
            student_id: Some(student_id),
            ..Default::default()
        })
        .count()
        .await?;

    Ok(ApiResponse::paginated(submissions, total, pagination))
}

// =============================================================================
// STATISTICS
// =============================================================================

/// Get submission stats for an assessment
async fn get_assessment_submission_stats(
    ctx: RequestContext,
    assessment_id: AssessmentId
) -> Result<ApiResponse<SubmissionStats>, ApiError> {
    check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;

    let db = ctx.get_db();

    let submissions = db.submissions()
        .filter(SubmissionFilter {
            assessment_id: Some(assessment_id.clone()),
            tenant_id: Some(ctx.tenant.id.clone()),
            ..Default::default()
        })
        .fetch()
        .await?;

    let total = submissions.len() as i32;
    let submitted = submissions.iter().filter(|s| s.status == SubmissionStatus::Submitted).count() as i32;
    let in_progress = submissions.iter().filter(|s| s.status == SubmissionStatus::InProgress).count() as i32;
    let graded = submissions.iter().filter(|s| s.is_graded).count() as i32;
    let late = submissions.iter().filter(|s| s.is_late).count() as i32;

    let total_time: i64 = submissions.iter().map(|s| s.time_spent_seconds).sum();
    let avg_time = if total > 0 { total_time as f64 / total as f64 } else { 0.0 };

    let scores: Vec<f32> = submissions.iter().filter_map(|s| s.score).collect();
    let avg_score = if !scores.is_empty() {
        Some(scores.iter().sum::<f32>() / scores.len() as f32)
    } else {
        None
    };

    let plagiarism_flags = submissions.iter()
        .filter(|s| s.plagiarism.as_ref().map(|p| p.similarity_score > 25.0).unwrap_or(false))
        .count() as i32;

    let proctoring_flags = submissions.iter()
        .filter(|s| !s.proctoring_flags.is_empty())
        .count() as i32;

    Ok(ApiResponse::ok(SubmissionStats {
        total_submissions: total,
        submitted_count: submitted,
        in_progress_count: in_progress,
        graded_count: graded,
        late_count: late,
        average_time_seconds: avg_time,
        average_score: avg_score,
        plagiarism_flags,
        proctoring_flags
    }))
}

/// Get submission stats for a course
async fn get_course_submission_stats(
    ctx: RequestContext,
    course_id: CourseId
) -> Result<ApiResponse<SubmissionStats>, ApiError> {
    check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;

