/// Get all responses for a submission
async fn get_responses(
    ctx: RequestContext,
    id: SubmissionId
) -> Result<ApiResponse<List<QuestionResponse>>, ApiError> {
    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id)
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify access
    if submission.student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;
    }

    Ok(ApiResponse::ok(submission.question_responses))
}

/// Save a single response
async fn save_response(
    ctx: RequestContext,
    id: SubmissionId,
    question_id: String,
    body: QuestionResponseInput
) -> Result<ApiResponse<QuestionResponse>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify ownership
    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    // Check if submitted
    if submission.status == SubmissionStatus::Submitted {
        return Err(ApiError::BadRequest("Cannot modify submitted submission".into()));
    }

    // Find or create response
    let response = if let Some(r) = submission.question_responses.iter_mut().find(|r| r.question_id == question_id) {
        r.update_response(body.response);
        r.time_spent_seconds += body.time_spent_seconds;
        if let Some(flagged) = body.flagged {
            r.flagged_for_review = flagged;
        }
        r.clone()
    } else {
        let mut new_response = QuestionResponse::new(question_id, 0.0);
        new_response.response = body.response;
        new_response.time_spent_seconds = body.time_spent_seconds;
        if let Some(flagged) = body.flagged {
            new_response.flagged_for_review = flagged;
        }
        submission.question_responses.push(new_response.clone());
        new_response
    };

    submission.updated_at = DateTime::now();
    db.submissions().update(&submission).await?;

    Ok(ApiResponse::ok(response))
}

/// Save multiple responses at once
async fn save_bulk_responses(
    ctx: RequestContext,
    id: SubmissionId,
    body: SaveProgressRequest
) -> Result<ApiResponse<i32>, ApiError> {
    // Reuse save_progress logic with the submission directly
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify ownership
    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    if submission.status == SubmissionStatus::Submitted {
        return Err(ApiError::BadRequest("Cannot modify submitted submission".into()));
    }

    let count = body.responses.len() as i32;

    for input in body.responses {
        let existing = submission.question_responses
            .iter_mut()
            .find(|r| r.question_id == input.question_id);

        if let Some(response) = existing {
            response.update_response(input.response);
            response.time_spent_seconds += input.time_spent_seconds;
        } else {
            let mut new_response = QuestionResponse::new(input.question_id, 0.0);
            new_response.response = input.response;
            new_response.time_spent_seconds = input.time_spent_seconds;
            submission.question_responses.push(new_response);
        }
    }

    submission.updated_at = DateTime::now();
    db.submissions().update(&submission).await?;

    Ok(ApiResponse::ok(count))
}

/// Toggle question flag
async fn toggle_flag(
    ctx: RequestContext,
    id: SubmissionId,
    question_id: String
) -> Result<ApiResponse<Bool>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    if submission.status == SubmissionStatus::Submitted {
        return Err(ApiError::BadRequest("Cannot modify submitted submission".into()));
    }

    let response = submission.question_responses
        .iter_mut()
        .find(|r| r.question_id == question_id)
        .ok_or(ApiError::NotFound("Response not found".into()))?;

    response.flagged_for_review = !response.flagged_for_review;
    let flagged = response.flagged_for_review;

    db.submissions().update(&submission).await?;

    Ok(ApiResponse::ok(flagged))
}

// =============================================================================
// FILE HANDLING
// =============================================================================

/// Upload a file to submission
async fn upload_file(
    ctx: RequestContext,
    id: SubmissionId,
    body: UploadFileRequest
) -> Result<ApiResponse<SubmittedFile>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    if submission.status == SubmissionStatus::Submitted {
        return Err(ApiError::BadRequest("Cannot modify submitted submission".into()));
    }

    // Validate file size and type
    let max_size = 50 * 1024 * 1024; // 50MB
    if body.file.size > max_size {
        return Err(ApiError::BadRequest("File too large".into()));
    }

    // Upload to storage
    let media_id = ctx.storage()
        .upload(body.file.data, body.file.content_type.clone())
        .await?;

    let submitted_file = SubmittedFile {
        id: generate_uuid(),
        media_id,
        filename: body.file.filename,
        file_size: body.file.size,
        mime_type: body.file.content_type,
        uploaded_at: DateTime::now(),
        file_hash: None,
        preview_url: None
    };

    // Add to submission content
    match &mut submission.content {
        SubmissionContent::Files { files } => {
            files.push(submitted_file.clone());
        },
        _ => {
            submission.content = SubmissionContent::Files {
                files: vec![submitted_file.clone()]
            };
        }
    }

    submission.updated_at = DateTime::now();
    db.submissions().update(&submission).await?;

    Ok(ApiResponse::created(submitted_file))
}

/// Delete a file from submission
async fn delete_file(
    ctx: RequestContext,
    id: SubmissionId,
    file_id: String
) -> Result<ApiResponse<()>, ApiError> {
    let db = ctx.get_db();

    let mut submission = db.submissions()
        .get(id.clone())
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    if submission.student_id != ctx.user.id {
        return Err(ApiError::Forbidden("Not your submission".into()));
    }

    if submission.status == SubmissionStatus::Submitted {
        return Err(ApiError::BadRequest("Cannot modify submitted submission".into()));
    }

    // Remove file from content
    if let SubmissionContent::Files { files } = &mut submission.content {
        let original_len = files.len();
        files.retain(|f| f.id != file_id);

        if files.len() == original_len {
            return Err(ApiError::NotFound("File not found".into()));
        }
    }

    submission.updated_at = DateTime::now();
    db.submissions().update(&submission).await?;

    Ok(ApiResponse::no_content())
}

/// Download a file from submission
async fn download_file(
    ctx: RequestContext,
    id: SubmissionId,
    file_id: String
) -> Result<FileDownload, ApiError> {
    let db = ctx.get_db();

    let submission = db.submissions()
        .get(id)
        .await?
        .ok_or(ApiError::NotFound("Submission not found".into()))?;

    // Verify access
    if submission.student_id != ctx.user.id {
        check_permission(&ctx.user, Permission::ViewSubmissions, &ctx.tenant)?;
    }

    let file = match &submission.content {
        SubmissionContent::Files { files } => {
            files.iter().find(|f| f.id == file_id)
        },
        _ => None
    }.ok_or(ApiError::NotFound("File not found".into()))?;

    let data = ctx.storage().download(file.media_id.clone()).await?;

    Ok(FileDownload {
        filename: file.filename.clone(),
        content_type: file.mime_type.clone(),
        data
    })
}

/// File download response
type FileDownload {
    filename: String,
    content_type: String,
    data: Bytes
}

