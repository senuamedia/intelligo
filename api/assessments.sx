    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let pagination = PaginationParams::from_request(&req);
    let status = req.query_param("status");
    let needs_grading = req.query_param("needs_grading").map(|v| v == "true");

    let (submissions, total) = db.submissions()
        .list_by_assessment(&assessment_id, status.as_deref(), needs_grading, pagination.limit(), pagination.offset())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(submissions, meta, &ctx)))
}

// =============================================================================
// DUPLICATION & PREVIEW
// =============================================================================

/// Duplicate assessment
async fn duplicate_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let assessment = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    #[derive(Deserialize)]
    struct DuplicateRequest {
        new_title: Option<String>,
        target_module_id: Option<ModuleId>
    }

    let body: DuplicateRequest = req.json().await.unwrap_or(DuplicateRequest {
        new_title: None,
        target_module_id: None
    });

    let target_module = body.target_module_id.clone().unwrap_or(assessment.module_id.clone());
    if target_module != assessment.module_id {
        let module = db.modules()
            .find_by_id(&target_module)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
            .ok_or_else(|| ApiError::NotFound {
                resource: "Module".to_string(),
                id: target_module.clone()
            })?;

        verify_course_edit_access(&db, &module.course_id, &ctx).await?;
    }

    let new_assessment = db.assessments()
        .duplicate(&assessment_id, body.new_title.as_deref(), Some(&target_module))
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = assessment_to_response(&new_assessment, 0);

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Preview assessment
async fn preview_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let questions = db.questions()
        .find_by_assessment(&assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let preview = questions.iter().map(question_to_response_student).collect::<List<_>>();

    Ok(Response::json(ApiResponse::success(preview, &ctx)))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

fn assessment_to_response(assessment: &Assessment, question_count: i32) -> AssessmentResponse {
    AssessmentResponse {
        id: assessment.id.clone(),
        module_id: assessment.module_id.clone(),
        course_id: assessment.course_id.clone(),
        title: assessment.title.clone(),
        description: assessment.description.clone(),
        instructions: assessment.instructions.clone(),
        assessment_type: assessment.assessment_type.clone(),
        position: assessment.position,
        max_points: assessment.max_points,
        passing_score: assessment.passing_score,
        is_published: assessment.is_published,
        due_date: assessment.due_date,
        available_from: assessment.available_from,
        available_until: assessment.available_until,
        time_limit_minutes: assessment.time_limit_minutes,
        attempts_allowed: assessment.attempts_allowed,
        question_count,
        submission_count: 0,
        grading_type: assessment.grading_type.clone(),
        has_rubric: false,
        created_at: assessment.created_at,
        updated_at: assessment.updated_at
    }
}

fn question_to_response_full(question: &Question) -> QuestionResponse {
    QuestionResponse {
        id: question.id.clone(),
        assessment_id: question.assessment_id.clone(),
        question_type: question.question_type.clone(),
        position: question.position,
        points: question.points,
        content: question.content.clone(),
        is_required: question.is_required,
        hint: question.hint.clone(),
        feedback: question.feedback.clone(),
        settings: question.settings.clone(),
        tags: question.tags.clone(),
        created_at: question.created_at,
        updated_at: question.updated_at
    }
}

fn question_to_response_student(question: &Question) -> QuestionResponse {
    let mut content = question.content.clone();
    content.correct_answer = None;

    QuestionResponse {
        id: question.id.clone(),
        assessment_id: question.assessment_id.clone(),
        question_type: question.question_type.clone(),
        position: question.position,
        points: question.points,
        content,
        is_required: question.is_required,
        hint: question.hint.clone(),
        feedback: None,
        settings: question.settings.clone(),
        tags: vec![],
        created_at: question.created_at,
        updated_at: question.updated_at
    }
}

async fn filter_unpublished(db: &Database, assessments: List<Assessment>, ctx: &RequestContext) -> List<Assessment> {
    if assessments.is_empty() {
        return assessments
    }

    let course_id = &assessments[0].course_id;
    let can_edit = can_edit_course_content(db, course_id, ctx).await;

    if can_edit {
        assessments
    } else {
        assessments.into_iter().filter(|a| a.is_published).collect()
    }
}

async fn verify_course_access(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Result<(), ApiError> {
    if ctx.has_permission(Permission::ViewAllCourses) {
        return Ok(())
    }

    if let Some(user_id) = ctx.user_id() {
        if db.enrollments().is_enrolled(&user_id, course_id).await.unwrap_or(false) {
            return Ok(())
        }
    }

    Err(ApiError::Forbidden {
        message: "Access denied".to_string(),
        required_permission: None
    })
}

async fn verify_course_edit_access(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Result<(), ApiError> {
    if ctx.has_permission(Permission::EditAllCourses) {
        return Ok(())
    }

    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, course_id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            if e.can_edit_content() {
                return Ok(())
            }
        }
    }

    Err(ApiError::Forbidden {
        message: "Edit access required".to_string(),
        required_permission: Some("EditCourses".to_string())
    })
}

async fn can_edit_course_content(db: &Database, course_id: &CourseId, ctx: &RequestContext) -> Bool {
    if ctx.has_permission(Permission::EditAllCourses) {
        return true
    }

    if let Some(user_id) = ctx.user_id() {
        let enrollment = db.enrollments()
            .find_by_user_and_course(&user_id, course_id)
            .await
            .ok()
            .flatten();

        if let Some(e) = enrollment {
            return e.can_edit_content()
        }
    }

    false
}

async fn get_viewable_assessment(db: &Database, assessment_id: &str, ctx: &RequestContext) -> Result<Assessment, ApiError> {
    let assessment = db.assessments()
        .find_by_id(assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Assessment".to_string(),
            id: assessment_id.to_string()
        })?;

    verify_course_access(db, &assessment.course_id, ctx).await?;

    if !assessment.is_published && !can_edit_course_content(db, &assessment.course_id, ctx).await {
        return Err(ApiError::NotFound {
            resource: "Assessment".to_string(),
            id: assessment_id.to_string()
        })
    }

    Ok(assessment)
}

async fn get_editable_assessment(db: &Database, assessment_id: &str, ctx: &RequestContext) -> Result<Assessment, ApiError> {
    let assessment = db.assessments()
        .find_by_id(assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Assessment".to_string(),
            id: assessment_id.to_string()
        })?;

    verify_course_edit_access(db, &assessment.course_id, ctx).await?;

    Ok(assessment)
}

fn check_assessment_availability(assessment: &Assessment) -> Result<(), ApiError> {
    let now = DateTime::now();

    if let Some(from) = assessment.available_from {
        if now < from {
            return Err(ApiError::Forbidden {
                message: "Assessment is not yet available".to_string(),
                required_permission: None
            })
        }
    }

    if let Some(until) = assessment.available_until {
        if now > until {
            return Err(ApiError::Forbidden {
                message: "Assessment is no longer available".to_string(),
                required_permission: None
            })
        }
    }

    Ok(())
}

async fn build_attempt_response(db: &Database, attempt: &Submission, assessment: &Assessment) -> Result<AttemptResponse, ApiError> {
    let questions = db.questions()
        .find_by_assessment(&assessment.id)
        .await
        .unwrap_or_default();

    let responses = db.question_responses()
        .find_by_submission(&attempt.id)
        .await
        .unwrap_or_default();

    let time_remaining = if let Some(limit) = assessment.time_limit_minutes {
        let elapsed = DateTime::now() - attempt.started_at;
        let limit_secs = (limit * 60) as i64;
        Some((limit_secs - elapsed.as_seconds()).max(0))
    } else {
        None
    };

    let attempt_questions: List<AttemptQuestion> = questions.iter().map(|q| {
        let response = responses.get(&q.id);
        AttemptQuestion {
            question_id: q.id.clone(),
            position: q.position,
            content: QuestionContent {
                text: q.content.text.clone(),
                text_format: q.content.text_format.clone(),
                media: q.content.media.clone(),
                options: q.content.options.clone(),
                correct_answer: None,
                matching_pairs: q.content.matching_pairs.clone(),
                blanks: q.content.blanks.clone()
            },
            points: q.points,
            response: response.cloned(),
            is_flagged: false,
            time_spent_seconds: 0
        }
    }).collect();

    let answered_count = responses.len() as i32;
    let total_count = questions.len() as i32;

    Ok(AttemptResponse {
        attempt_id: attempt.id.clone(),
        assessment_id: assessment.id.clone(),
        student_id: attempt.student_id.clone(),
        attempt_number: attempt.attempt_number,
        status: AttemptStatus::InProgress,
        started_at: attempt.started_at,
        time_remaining_seconds: time_remaining,
        questions: attempt_questions,
        progress: AttemptProgress {
            answered_count,
            total_count,
            flagged_count: 0
        }
    })
}

async fn recalculate_assessment_points(db: &Database, assessment_id: &AssessmentId) -> Result<(), String> {
    let questions = db.questions()
        .find_by_assessment(assessment_id)
        .await?;

    let total_points: f32 = questions.iter().map(|q| q.points).sum();

    db.assessments()
        .update_max_points(assessment_id, total_points)
        .await
}

async fn auto_grade_submission(db: &Database, submission_id: &SubmissionId, assessment_id: &AssessmentId) -> Result<(), String> {
    db.grading()
        .auto_grade_submission(submission_id, assessment_id)
        .await
}

fn parse_assessment_type(s: &str) -> Result<AssessmentType, ApiError> {
    match s.to_lowercase().as_str() {
        "quiz" => Ok(AssessmentType::Quiz),
        "exam" => Ok(AssessmentType::Exam),
        "assignment" => Ok(AssessmentType::Assignment),
        "discussion" => Ok(AssessmentType::Discussion),
        "project" => Ok(AssessmentType::Project),
        "survey" => Ok(AssessmentType::Survey),
        "peer_review" => Ok(AssessmentType::PeerReview),
        _ => Err(ApiError::ValidationError {
            field: "assessment_type".to_string(),
            message: format!("Unknown assessment type: {}", s),
            errors: vec![]
        })
    }
}

fn parse_question_type(s: &str) -> Result<QuestionType, ApiError> {
    match s.to_lowercase().as_str() {
        "multiple_choice" | "multiplechoice" => Ok(QuestionType::MultipleChoice),
        "multiple_select" | "multipleselect" => Ok(QuestionType::MultipleSelect),
        "true_false" | "truefalse" => Ok(QuestionType::TrueFalse),
        "short_answer" | "shortanswer" => Ok(QuestionType::ShortAnswer),
        "essay" => Ok(QuestionType::Essay),
        "matching" => Ok(QuestionType::Matching),
        "ordering" => Ok(QuestionType::Ordering),
        "fill_in_blank" | "fillinblank" => Ok(QuestionType::FillInBlank),
        "numeric" => Ok(QuestionType::Numeric),
        "file_upload" | "fileupload" => Ok(QuestionType::FileUpload),
        "hotspot" => Ok(QuestionType::Hotspot),
        "likert" => Ok(QuestionType::Likert),
        _ => Err(ApiError::ValidationError {
            field: "question_type".to_string(),
            message: format!("Unknown question type: {}", s),
            errors: vec![]
        })
    }
}

impl QuestionSettings {
    fn default() -> QuestionSettings {
        QuestionSettings {
            shuffle_options: false,
            allow_partial_credit: false,
            partial_credit_method: None,
            time_limit_seconds: None
        }
    }
}

impl AssessmentSettings {
    fn default_for(assessment_id: &AssessmentId) -> AssessmentSettings {
        AssessmentSettings {
            assessment_id: assessment_id.clone(),
            availability: AvailabilitySettings {
                available_from: None,
                available_until: None,
                require_access_code: false,
                access_code: None,
                ip_restrictions: vec![]
            },
            timing: TimingSettings {
                time_limit_minutes: None,
                grace_period_minutes: 0,
                auto_submit: true,
                show_time_remaining: true
            },
            attempts: AttemptSettings {
                attempts_allowed: None,
                score_to_keep: ScoreKeepingMethod::Highest,
                cooldown_minutes: 0,
                resume_in_progress: true
            },
            presentation: PresentationSettings {
                shuffle_questions: false,
                shuffle_options: false,
                one_question_per_page: false,
                show_question_count: true,
                allow_backtracking: true,
                show_correct_answers: ShowCorrectAnswersOption::AfterSubmission
            },
            security: SecuritySettings {
                require_lockdown_browser: false,
                proctoring_enabled: false,
                proctoring_provider: None,
                webcam_required: false,
                prevent_copy_paste: false,
                disable_right_click: false
            },
            grading: GradingSettings {
                grading_type: GradingType::AutoGraded,
                auto_release_grades: true,
                anonymous_grading: false,
                late_submission_policy: LateSubmissionPolicy {
                    accept_late: true,
                    penalty_type: "none".to_string(),
                    penalty_per_day: 0.0,
                    max_penalty: 0.0,
                    hard_cutoff: None
                }
            },
            feedback: FeedbackSettings {
                show_score: true,
                show_points_per_question: true,
                show_correct_answers: ShowCorrectAnswersOption::AfterSubmission,
                show_feedback: true,
                allow_review: true
            }
        }
    }
}

