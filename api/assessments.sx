/// Get questions from question bank
async fn get_from_question_bank(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let assessment = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let tags = req.query_param("tags");
    let question_type = req.query_param("type");
    let limit = req.query_param("limit")
        .and_then(|l| l.parse::<i64>().ok())
        .unwrap_or(50);

    let questions = db.question_bank()
        .search(&assessment.course_id, tags.as_deref(), question_type.as_deref(), limit)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(questions, &ctx)))
}

/// Import questions from question bank
async fn import_questions(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    #[derive(Deserialize)]
    struct ImportRequest {
        question_ids: List<String>
    }

    let body: ImportRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let mut imported = 0;
    for qid in body.question_ids {
        match db.questions().copy_from_bank(&qid, &assessment_id).await {
            Ok(_) => imported += 1,
            Err(_) => {}
        }
    }

    recalculate_assessment_points(&db, &assessment_id).await.ok();

    Ok(Response::json(Map::from([
        ("imported".to_string(), Dynamic::Int(imported))
    ])))
}

