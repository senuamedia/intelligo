// =============================================================================
// LIST ASSESSMENTS
// =============================================================================

/// List assessments
async fn list_assessments(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let pagination = PaginationParams::from_request(&req);
    let module_id = req.query_param("module_id");
    let course_id = req.query_param("course_id");
    let assessment_type = req.query_param("type");

    let (assessments, total) = if let Some(mid) = module_id {
        let module = db.modules()
            .find_by_id(&mid)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
            .ok_or_else(|| ApiError::NotFound {
                resource: "Module".to_string(),
                id: mid.clone()
            })?;

        verify_course_access(&db, &module.course_id, &ctx).await?;

        let assessments = db.assessments()
            .find_by_module(&mid)
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?;

        (assessments.clone(), assessments.len() as i64)
    } else if let Some(cid) = course_id {
        verify_course_access(&db, &cid, &ctx).await?;

        db.assessments()
            .find_by_course(&cid, pagination.limit(), pagination.offset())
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    } else {
        ctx.require_permission(Permission::ViewAllCourses)?;

        db.assessments()
            .list_all(ctx.tenant_id().as_ref(), pagination.limit(), pagination.offset())
            .await
            .map_err(|e| ApiError::InternalError {
                message: e.to_string(),
                trace_id: ctx.trace_id.clone()
            })?
    };

    let filtered = filter_unpublished(&db, assessments, &ctx).await;
    let items: List<AssessmentResponse> = filtered.iter().map(|a| assessment_to_response(a, 0)).collect();

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(items, meta, &ctx)))
}

// =============================================================================
// GET ASSESSMENT
// =============================================================================

/// Get a specific assessment
async fn get_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let assessment = get_viewable_assessment(&db, &assessment_id, &ctx).await?;

    let question_count = db.questions()
        .count_by_assessment(&assessment_id)
        .await
        .unwrap_or(0) as i32;

    let response = assessment_to_response(&assessment, question_count);

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// CREATE ASSESSMENT
// =============================================================================

/// Create a new assessment
async fn create_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let body: CreateAssessmentRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let module = db.modules()
        .find_by_id(&body.module_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Module".to_string(),
            id: body.module_id.clone()
        })?;

    verify_course_edit_access(&db, &module.course_id, &ctx).await?;

    if body.title.is_empty() {
        return Err(ApiError::ValidationError {
            field: "title".to_string(),
            message: "Assessment title is required".to_string(),
            errors: vec![]
        })
    }

    let assessment_type = parse_assessment_type(&body.assessment_type)?;

    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.assessments()
            .get_next_position(&body.module_id)
            .await
            .unwrap_or(0)
    };

    let assessment = db.assessments()
        .create(CreateAssessmentInput {
            module_id: body.module_id,
            course_id: module.course_id,
            title: body.title,
            assessment_type,
            description: body.description,
            instructions: body.instructions,
            max_points: body.max_points.unwrap_or(100.0),
            due_date: body.due_date,
            time_limit_minutes: body.time_limit_minutes,
            attempts_allowed: body.attempts_allowed,
            position,
            tenant_id: ctx.tenant_id()
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = assessment_to_response(&assessment, 0);

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

// =============================================================================
// UPDATE ASSESSMENT
// =============================================================================

/// Update an assessment
async fn update_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let assessment = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let body: UpdateAssessmentRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let updated = db.assessments()
        .update(&assessment_id, UpdateAssessmentInput {
            title: body.title,
            description: body.description,
            instructions: body.instructions,
            max_points: body.max_points,
            passing_score: body.passing_score,
            due_date: body.due_date,
            available_from: body.available_from,
            available_until: body.available_until,
            time_limit_minutes: body.time_limit_minutes,
            attempts_allowed: body.attempts_allowed,
            position: body.position
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let question_count = db.questions()
        .count_by_assessment(&assessment_id)
        .await
        .unwrap_or(0) as i32;

    let response = assessment_to_response(&updated, question_count);

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

// =============================================================================
// DELETE ASSESSMENT
// =============================================================================

/// Delete an assessment
async fn delete_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let submission_count = db.submissions()
        .count_by_assessment(&assessment_id)
        .await
        .unwrap_or(0);

    if submission_count > 0 {
        let force = req.query_param("force").map(|v| v == "true").unwrap_or(false);
        if !force {
            return Err(ApiError::Conflict {
                message: format!("Assessment has {} submissions. Use ?force=true to delete.", submission_count)
            })
        }
    }

    db.questions().delete_by_assessment(&assessment_id).await.ok();
    db.assessments()
        .delete(&assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Assessment deleted".to_string()))
    ])))
}

// =============================================================================
// PUBLISH/UNPUBLISH
// =============================================================================

/// Publish an assessment
async fn publish_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let question_count = db.questions()
        .count_by_assessment(&assessment_id)
        .await
        .unwrap_or(0);

    if question_count == 0 {
        return Err(ApiError::ValidationError {
            field: "questions".to_string(),
            message: "Assessment must have at least one question to publish".to_string(),
            errors: vec![]
        })
    }

    db.assessments()
        .publish(&assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Assessment published".to_string()))
    ])))
}

/// Unpublish an assessment
async fn unpublish_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    db.assessments()
        .unpublish(&assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Assessment unpublished".to_string()))
    ])))
}

// =============================================================================
// QUESTIONS
// =============================================================================

/// Get assessment questions
async fn get_questions(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let assessment = get_viewable_assessment(&db, &assessment_id, &ctx).await?;

    let can_edit = can_edit_course_content(&db, &assessment.course_id, &ctx).await;

    let questions = db.questions()
        .find_by_assessment(&assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let responses: List<QuestionResponse> = if can_edit {
        questions.iter().map(question_to_response_full).collect()
    } else {
        questions.iter().map(question_to_response_student).collect()
    };

    Ok(Response::json(ApiResponse::success(responses, &ctx)))
}

/// Add question to assessment
async fn add_question(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let body: CreateQuestionRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let question_type = parse_question_type(&body.question_type)?;

    let position = if let Some(pos) = body.position {
        pos
    } else {
        db.questions()
            .get_next_position(&assessment_id)
            .await
            .unwrap_or(0)
    };

    let question = db.questions()
        .create(CreateQuestionInput {
            assessment_id: assessment_id.clone(),
            question_type,
            content: body.content,
            points: body.points,
            is_required: body.is_required.unwrap_or(true),
            hint: body.hint,
            feedback: body.feedback,
            settings: body.settings.unwrap_or_else(QuestionSettings::default),
            tags: body.tags.unwrap_or_default(),
            position
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    recalculate_assessment_points(&db, &assessment_id).await.ok();

    Ok(Response::json(ApiResponse::success(question_to_response_full(&question), &ctx))
        .with_status(StatusCode::CREATED))
}

/// Reorder questions
async fn reorder_questions(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    #[derive(Deserialize)]
    struct ReorderRequest {
        question_ids: List<String>
    }

    let body: ReorderRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    for (position, question_id) in body.question_ids.iter().enumerate() {
        db.questions()
            .update_position(question_id, position as i32)
            .await
            .ok();
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Questions reordered".to_string()))
    ])))
}

/// Update a question
async fn update_question(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let question_id = req.param("question_id").ok_or_else(|| ApiError::BadRequest {
        message: "Question ID required".to_string()
    })?;

    let _ = get_editable_assessment(&db, &assessment_id, &ctx).await?;

    let body: CreateQuestionRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let question_type = parse_question_type(&body.question_type)?;

    let updated = db.questions()
        .update(&question_id, UpdateQuestionInput {
            question_type: Some(question_type),
            content: Some(body.content),
            points: Some(body.points),
            is_required: body.is_required,
            hint: body.hint,
            feedback: body.feedback,
            settings: body.settings,
            tags: body.tags,
            position: body.position
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    recalculate_assessment_points(&db, &assessment_id).await.ok();

    Ok(Response::json(ApiResponse::success(question_to_response_full(&updated), &ctx)))
}

/// Delete a question
