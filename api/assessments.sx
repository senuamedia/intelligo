// =============================================================================
// TAKING ASSESSMENT
// =============================================================================

/// Start an assessment attempt
async fn start_attempt(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let assessment = get_viewable_assessment(&db, &assessment_id, &ctx).await?;

    // Check if published
    if !assessment.is_published {
        return Err(ApiError::Forbidden {
            message: "Assessment is not available".to_string(),
            required_permission: None
        })
    }

    // Check enrollment
    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &assessment.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled in this course".to_string(),
            required_permission: None
        })?;

    // Check availability
    check_assessment_availability(&assessment)?;

    // Check access code if required
    #[derive(Deserialize)]
    struct StartRequest {
        access_code: Option<String>
    }

    let body: StartRequest = req.json().await.unwrap_or(StartRequest { access_code: None });

    let settings = db.assessment_settings()
        .find_by_assessment(&assessment_id)
        .await
        .ok()
        .flatten();

    if let Some(s) = &settings {
        if s.availability.require_access_code {
            let code = body.access_code.ok_or_else(|| ApiError::Forbidden {
                message: "Access code required".to_string(),
                required_permission: None
            })?;

            if s.availability.access_code.as_ref() != Some(&code) {
                return Err(ApiError::Forbidden {
                    message: "Invalid access code".to_string(),
                    required_permission: None
                })
            }
        }
    }

    // Check attempt limits
    let attempt_count = db.submissions()
        .count_attempts(&enrollment.id, &assessment_id)
        .await
        .unwrap_or(0);

    if let Some(max_attempts) = assessment.attempts_allowed {
        if attempt_count >= max_attempts as i64 {
            return Err(ApiError::Forbidden {
                message: "Maximum attempts exceeded".to_string(),
                required_permission: None
            })
        }
    }

    // Check for existing in-progress attempt
    let existing = db.submissions()
        .find_in_progress(&enrollment.id, &assessment_id)
        .await
        .ok()
        .flatten();

    if let Some(existing_attempt) = existing {
        // Resume existing attempt
        let response = build_attempt_response(&db, &existing_attempt, &assessment).await?;
        return Ok(Response::json(ApiResponse::success(response, &ctx)))
    }

    // Create new attempt
    let attempt = db.submissions()
        .create_attempt(&enrollment.id, &assessment_id, (attempt_count + 1) as i32)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let response = build_attempt_response(&db, &attempt, &assessment).await?;

    Ok(Response::json(ApiResponse::success(response, &ctx))
        .with_status(StatusCode::CREATED))
}

/// Get current attempt
async fn get_current_attempt(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let assessment = get_viewable_assessment(&db, &assessment_id, &ctx).await?;

    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &assessment.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled".to_string(),
            required_permission: None
        })?;

    let attempt = db.submissions()
        .find_in_progress(&enrollment.id, &assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Attempt".to_string(),
            id: assessment_id.clone()
        })?;

    let response = build_attempt_response(&db, &attempt, &assessment).await?;

    Ok(Response::json(ApiResponse::success(response, &ctx)))
}

/// Submit assessment
async fn submit_assessment(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let assessment_id = req.param("assessment_id").ok_or_else(|| ApiError::BadRequest {
        message: "Assessment ID required".to_string()
    })?;

    let user_id = ctx.user_id().ok_or_else(|| ApiError::Unauthorized {
        message: "Authentication required".to_string()
    })?;

    let assessment = get_viewable_assessment(&db, &assessment_id, &ctx).await?;

    let enrollment = db.enrollments()
        .find_by_user_and_course(&user_id, &assessment.course_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::Forbidden {
            message: "Not enrolled".to_string(),
            required_permission: None
        })?;

    let attempt = db.submissions()
        .find_in_progress(&enrollment.id, &assessment_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "Attempt".to_string(),
            id: assessment_id.clone()
        })?;

    #[derive(Deserialize)]
    struct SubmitRequest {
        responses: Map<String, StudentResponse>
    }

    let body: SubmitRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Save responses
    for (question_id, response) in body.responses {
        db.question_responses()
            .save(&attempt.id, &question_id, &response)
            .await
            .ok();
    }

    // Submit the attempt
    let submission = db.submissions()
        .submit(&attempt.id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    // Auto-grade if applicable
    if assessment.grading_type == GradingType::AutoGraded {
        auto_grade_submission(&db, &submission.id, &assessment_id).await.ok();
    }

    Ok(Response::json(Map::from([
        ("message".to_string(), Dynamic::String("Assessment submitted".to_string())),
        ("submission_id".to_string(), Dynamic::String(submission.id))
    ])))
}

