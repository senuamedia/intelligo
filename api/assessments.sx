/// Intelligo LMS - Assessments API
///
/// This module provides assessment management endpoints:
/// - Assessment CRUD operations
/// - Question management
/// - Assessment configuration
/// - Assessment taking and submission

module intelligo::api::assessments

use intelligo::core::types::*
use intelligo::core::security::{Permission, check_permission}
use intelligo::core::storage::Database
use intelligo::api::middleware::*
use intelligo::entities::assessment::*

use modulus::http::{Router, Request, Response, StatusCode}
use std::time::{DateTime, Duration}
use std::collections::{Map, List}

// =============================================================================
// ROUTER
// =============================================================================

/// Build the assessments router
pub fn router(db: Database) -> Router {
    Router::new()
        // Assessment CRUD
        .get("/", move |req| list_assessments(req, db.clone()))
        .get("/:assessment_id", move |req| get_assessment(req, db.clone()))
        .post("/", move |req| create_assessment(req, db.clone()))
        .patch("/:assessment_id", move |req| update_assessment(req, db.clone()))
        .delete("/:assessment_id", move |req| delete_assessment(req, db.clone()))

        // Assessment publishing
        .post("/:assessment_id/publish", move |req| publish_assessment(req, db.clone()))
        .post("/:assessment_id/unpublish", move |req| unpublish_assessment(req, db.clone()))

        // Questions
        .get("/:assessment_id/questions", move |req| get_questions(req, db.clone()))
        .post("/:assessment_id/questions", move |req| add_question(req, db.clone()))
        .put("/:assessment_id/questions/order", move |req| reorder_questions(req, db.clone()))
        .patch("/:assessment_id/questions/:question_id", move |req| update_question(req, db.clone()))
        .delete("/:assessment_id/questions/:question_id", move |req| delete_question(req, db.clone()))

        // Question banks
        .get("/:assessment_id/question-bank", move |req| get_from_question_bank(req, db.clone()))
        .post("/:assessment_id/questions/import", move |req| import_questions(req, db.clone()))

        // Rubrics
        .get("/:assessment_id/rubric", move |req| get_rubric(req, db.clone()))
        .put("/:assessment_id/rubric", move |req| update_rubric(req, db.clone()))

        // Assessment settings
        .get("/:assessment_id/settings", move |req| get_settings(req, db.clone()))
        .patch("/:assessment_id/settings", move |req| update_settings(req, db.clone()))

        // Taking assessment (student)
        .post("/:assessment_id/start", move |req| start_attempt(req, db.clone()))
        .get("/:assessment_id/attempt", move |req| get_current_attempt(req, db.clone()))
        .post("/:assessment_id/submit", move |req| submit_assessment(req, db.clone()))

        // Assessment results
        .get("/:assessment_id/results", move |req| get_results(req, db.clone()))
        .get("/:assessment_id/statistics", move |req| get_statistics(req, db.clone()))

        // Submissions (instructor view)
        .get("/:assessment_id/submissions", move |req| get_submissions(req, db.clone()))

        // Duplication
        .post("/:assessment_id/duplicate", move |req| duplicate_assessment(req, db.clone()))

        // Preview
        .get("/:assessment_id/preview", move |req| preview_assessment(req, db.clone()))
}

// =============================================================================
// REQUEST/RESPONSE TYPES
// =============================================================================

/// Assessment response type
type AssessmentResponse {
    id: AssessmentId,
    module_id: ModuleId,
    course_id: CourseId,
    title: String,
    description: Option<String>,
    instructions: Option<String>,
    assessment_type: AssessmentType,
    position: i32,
    max_points: f32,
    passing_score: Option<f32>,
    is_published: Bool,
    due_date: Option<DateTime>,
    available_from: Option<DateTime>,
    available_until: Option<DateTime>,
    time_limit_minutes: Option<i32>,
    attempts_allowed: Option<i32>,
    question_count: i32,
    submission_count: i32,
    grading_type: GradingType,
    has_rubric: Bool,
    created_at: DateTime,
    updated_at: DateTime
}

/// Assessment type enum
enum AssessmentType {
    Quiz,
    Exam,
    Assignment,
    Discussion,
    Project,
    Survey,
    PeerReview
}

/// Grading type
enum GradingType {
    AutoGraded,
    ManualGraded,
    RubricBased,
    PassFail,
    PeerGraded,
    AiAssisted
}

/// Create assessment request
type CreateAssessmentRequest {
    module_id: ModuleId,
    title: String,
    assessment_type: String,
    description: Option<String>,
    instructions: Option<String>,
    max_points: Option<f32>,
    due_date: Option<DateTime>,
    time_limit_minutes: Option<i32>,
    attempts_allowed: Option<i32>,
    position: Option<i32>
}

/// Update assessment request
type UpdateAssessmentRequest {
    title: Option<String>,
    description: Option<String>,
    instructions: Option<String>,
    max_points: Option<f32>,
    passing_score: Option<f32>,
    due_date: Option<DateTime>,
    available_from: Option<DateTime>,
    available_until: Option<DateTime>,
    time_limit_minutes: Option<i32>,
    attempts_allowed: Option<i32>,
    position: Option<i32>
}

/// Question types
enum QuestionType {
    MultipleChoice,
    MultipleSelect,
    TrueFalse,
    ShortAnswer,
    Essay,
    Matching,
    Ordering,
    FillInBlank,
    Numeric,
    FileUpload,
    Hotspot,
    Likert
}

/// Question response type
type QuestionResponse {
    id: String,
    assessment_id: AssessmentId,
    question_type: QuestionType,
    position: i32,
    points: f32,
    content: QuestionContent,
    is_required: Bool,
    hint: Option<String>,
    feedback: Option<QuestionFeedback>,
    settings: QuestionSettings,
    tags: List<String>,
    created_at: DateTime,
    updated_at: DateTime
}

/// Question content (varies by type)
type QuestionContent {
    text: String,
    text_format: TextFormat,
    media: Option<MediaAttachment>,
    options: Option<List<QuestionOption>>,
    correct_answer: Option<CorrectAnswer>,
    matching_pairs: Option<List<MatchingPair>>,
    blanks: Option<List<BlankDefinition>>
}

/// Question option (for multiple choice, etc.)
type QuestionOption {
    id: String,
    text: String,
    is_correct: Bool,
    feedback: Option<String>,
    position: i32
}

/// Correct answer (for auto-graded questions)
enum CorrectAnswer {
    SingleOption { option_id: String },
    MultipleOptions { option_ids: List<String> },
    Boolean { value: Bool },
    Text { patterns: List<String>, case_sensitive: Bool },
    Numeric { value: f64, tolerance: Option<f64>, units: Option<String> },
    Range { min: f64, max: f64 }
}

/// Matching pair
type MatchingPair {
    id: String,
    premise: String,
    response: String
}

/// Blank definition for fill-in-blank
type BlankDefinition {
    id: String,
    position: i32,
    correct_answers: List<String>,
    case_sensitive: Bool
}

/// Question feedback
type QuestionFeedback {
    correct: Option<String>,
    incorrect: Option<String>,
    partial: Option<String>
}

/// Question settings
type QuestionSettings {
    shuffle_options: Bool,
    allow_partial_credit: Bool,
    partial_credit_method: Option<String>,
    time_limit_seconds: Option<i32>
}

/// Media attachment
type MediaAttachment {
    media_id: MediaId,
    media_type: String,
    url: String,
    alt_text: Option<String>
}

/// Create question request
type CreateQuestionRequest {
    question_type: String,
    content: QuestionContent,
    points: f32,
    is_required: Option<Bool>,
    hint: Option<String>,
    feedback: Option<QuestionFeedback>,
    settings: Option<QuestionSettings>,
    tags: Option<List<String>>,
    position: Option<i32>
}

/// Rubric type
type Rubric {
    id: String,
    assessment_id: AssessmentId,
    title: String,
    description: Option<String>,
    criteria: List<RubricCriterion>,
    total_points: f32
}

/// Rubric criterion
type RubricCriterion {
    id: String,
    title: String,
    description: Option<String>,
    position: i32,
    points: f32,
    levels: List<RubricLevel>
}

/// Rubric level
type RubricLevel {
    id: String,
    label: String,
    description: String,
    points: f32,
    position: i32
}

/// Assessment settings
type AssessmentSettings {
    assessment_id: AssessmentId,
    availability: AvailabilitySettings,
    timing: TimingSettings,
    attempts: AttemptSettings,
    presentation: PresentationSettings,
    security: SecuritySettings,
    grading: GradingSettings,
    feedback: FeedbackSettings
}

/// Availability settings
type AvailabilitySettings {
    available_from: Option<DateTime>,
    available_until: Option<DateTime>,
    require_access_code: Bool,
    access_code: Option<String>,
    ip_restrictions: List<String>
}

/// Timing settings
type TimingSettings {
    time_limit_minutes: Option<i32>,
    grace_period_minutes: i32,
    auto_submit: Bool,
    show_time_remaining: Bool
}

/// Attempt settings
type AttemptSettings {
    attempts_allowed: Option<i32>,
    score_to_keep: ScoreKeepingMethod,
    cooldown_minutes: i32,
    resume_in_progress: Bool
}

/// Score keeping method
enum ScoreKeepingMethod {
    Highest,
    Latest,
    Average,
    First
}

/// Presentation settings
type PresentationSettings {
    shuffle_questions: Bool,
    shuffle_options: Bool,
    one_question_per_page: Bool,
    show_question_count: Bool,
    allow_backtracking: Bool,
    show_correct_answers: ShowCorrectAnswersOption
}

/// When to show correct answers
enum ShowCorrectAnswersOption {
    Never,
    AfterSubmission,
    AfterDueDate,
    AfterAttempts { count: i32 }
}

/// Security settings
type SecuritySettings {
    require_lockdown_browser: Bool,
    proctoring_enabled: Bool,
    proctoring_provider: Option<String>,
    webcam_required: Bool,
    prevent_copy_paste: Bool,
    disable_right_click: Bool
}

/// Grading settings (assessment-level)
type GradingSettings {
    grading_type: GradingType,
    auto_release_grades: Bool,
    anonymous_grading: Bool,
    late_submission_policy: LateSubmissionPolicy
}

/// Late submission policy
type LateSubmissionPolicy {
    accept_late: Bool,
    penalty_type: String,
    penalty_per_day: f32,
    max_penalty: f32,
    hard_cutoff: Option<DateTime>
}

/// Feedback settings
type FeedbackSettings {
    show_score: Bool,
    show_points_per_question: Bool,
    show_correct_answers: ShowCorrectAnswersOption,
    show_feedback: Bool,
    allow_review: Bool
}

/// Attempt response
type AttemptResponse {
    attempt_id: String,
    assessment_id: AssessmentId,
    student_id: StudentId,
    attempt_number: i32,
    status: AttemptStatus,
    started_at: DateTime,
    time_remaining_seconds: Option<i64>,
    questions: List<AttemptQuestion>,
    progress: AttemptProgress
}

/// Attempt status
enum AttemptStatus {
    InProgress,
    Submitted,
    TimedOut,
    Abandoned
}

/// Question in an attempt (with student's perspective)
type AttemptQuestion {
    question_id: String,
    position: i32,
    content: QuestionContent,
    points: f32,
    response: Option<StudentResponse>,
    is_flagged: Bool,
    time_spent_seconds: i64
}

/// Student response to a question
type StudentResponse {
    selected_options: Option<List<String>>,
    text: Option<String>,
    file_ids: Option<List<MediaId>>,
    numeric_value: Option<f64>,
    ordering: Option<List<String>>,
    matches: Option<Map<String, String>>
}

/// Attempt progress
type AttemptProgress {
    answered_count: i32,
    total_count: i32,
    flagged_count: i32
}

/// Assessment results (for student)
type AssessmentResults {
    assessment_id: AssessmentId,
    attempt_id: String,
    attempt_number: i32,
    score: f32,
    max_score: f32,
    percentage: f32,
    passed: Option<Bool>,
    submitted_at: DateTime,
    graded_at: Option<DateTime>,
    time_spent_seconds: i64,
    question_results: List<QuestionResult>
}

/// Result for a single question
type QuestionResult {
    question_id: String,
    points_earned: f32,
    max_points: f32,
    is_correct: Option<Bool>,
    response: StudentResponse,
    correct_answer: Option<CorrectAnswer>,
    feedback: Option<String>
}

/// Assessment statistics (for instructor)
type AssessmentStatistics {
    assessment_id: AssessmentId,
    submission_count: i32,
    average_score: f32,
    median_score: f32,
    high_score: f32,
    low_score: f32,
    standard_deviation: f32,
    average_time_minutes: f32,
    completion_rate: f32,
    passing_rate: f32,
