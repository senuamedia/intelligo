// =============================================================================
// BULK OPERATIONS
// =============================================================================

/// Bulk create users
async fn bulk_create_users(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::AdminUsers)?;

    #[derive(Deserialize)]
    struct BulkCreateRequest {
        users: List<CreateUserRequest>,
        send_welcome_emails: Option<Bool>
    }

    let body: BulkCreateRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let mut created = vec![];
    let mut errors = vec![];

    for (index, user_input) in body.users.iter().enumerate() {
        match create_single_user(&db, user_input, &ctx, body.send_welcome_emails.unwrap_or(true)).await {
            Ok(user) => created.push(user),
            Err(e) => errors.push(Map::from([
                ("index".to_string(), Dynamic::Int(index as i64)),
                ("email".to_string(), Dynamic::String(user_input.email.clone())),
                ("error".to_string(), Dynamic::String(format!("{:?}", e)))
            ]))
        }
    }

    Ok(Response::json(Map::from([
        ("created".to_string(), Dynamic::Int(created.len() as i64)),
        ("errors".to_string(), Dynamic::List(errors.into_iter().map(Dynamic::Map).collect()))
    ])))
}

/// Bulk update users
async fn bulk_update_users(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::AdminUsers)?;

    #[derive(Deserialize)]
    struct BulkUpdateRequest {
        updates: List<BulkUpdateItem>
    }

    #[derive(Deserialize)]
    struct BulkUpdateItem {
        user_id: UserId,
        update: UpdateUserRequest
    }

    let body: BulkUpdateRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    let mut updated = 0;
    let mut errors = vec![];

    for item in body.updates {
        match db.users().update(&item.user_id, UpdateUserInput::from(item.update)).await {
            Ok(_) => updated += 1,
            Err(e) => errors.push(Map::from([
                ("user_id".to_string(), Dynamic::String(item.user_id.clone())),
                ("error".to_string(), Dynamic::String(e.to_string()))
            ]))
        }
    }

    Ok(Response::json(Map::from([
        ("updated".to_string(), Dynamic::Int(updated)),
        ("errors".to_string(), Dynamic::List(errors.into_iter().map(Dynamic::Map).collect()))
    ])))
}

/// Bulk delete users
async fn bulk_delete_users(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::AdminDeleteUsers)?;

    #[derive(Deserialize)]
    struct BulkDeleteRequest {
        user_ids: List<UserId>,
        hard_delete: Option<Bool>
    }

    let body: BulkDeleteRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Prevent self-deletion
    if let Some(current_user_id) = ctx.user_id() {
        if body.user_ids.contains(&current_user_id) {
            return Err(ApiError::Forbidden {
                message: "Cannot delete your own account".to_string(),
                required_permission: None
            })
        }
    }

    let hard_delete = body.hard_delete.unwrap_or(false);
    let mut deleted = 0;
    let mut errors = vec![];

    for user_id in body.user_ids {
        let result = if hard_delete {
            db.users().hard_delete(&user_id).await
        } else {
            db.users().soft_delete(&user_id).await
        };

        match result {
            Ok(_) => deleted += 1,
            Err(e) => errors.push(Map::from([
                ("user_id".to_string(), Dynamic::String(user_id)),
                ("error".to_string(), Dynamic::String(e.to_string()))
            ]))
        }
    }

    Ok(Response::json(Map::from([
        ("deleted".to_string(), Dynamic::Int(deleted)),
        ("errors".to_string(), Dynamic::List(errors.into_iter().map(Dynamic::Map).collect()))
    ])))
}

// =============================================================================
// SEARCH
// =============================================================================

/// Search users
async fn search_users(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::ViewUsers)?;

    let query = req.query_param("q").ok_or_else(|| ApiError::BadRequest {
        message: "Search query required".to_string()
    })?;

    let limit = req.query_param("limit")
        .and_then(|l| l.parse::<i64>().ok())
        .unwrap_or(20)
        .min(100);

    let users = db.users()
        .search(&query, ctx.tenant_id().as_ref(), limit)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let items: List<UserListItem> = users.iter().map(user_to_list_item).collect();

    Ok(Response::json(ApiResponse::success(items, &ctx)))
}

// =============================================================================
// IMPERSONATION
// =============================================================================

/// Impersonate a user (admin only)
async fn impersonate_user(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    // Require super admin or impersonation permission
    if !ctx.has_role(SystemRole::SuperAdmin) && !ctx.has_permission(Permission::ImpersonateUsers) {
        return Err(ApiError::Forbidden {
            message: "Impersonation requires super admin or explicit permission".to_string(),
            required_permission: Some("ImpersonateUsers".to_string())
        })
    }

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    // Cannot impersonate self
    if ctx.user_id().map(|id| id == user_id).unwrap_or(false) {
        return Err(ApiError::BadRequest {
            message: "Cannot impersonate yourself".to_string()
        })
    }

    // Get target user
    let target_user = db.users()
        .find_by_id(&user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: user_id.clone()
        })?;

    // Cannot impersonate super admins
    if target_user.roles.contains(&SystemRole::SuperAdmin) {
        return Err(ApiError::Forbidden {
            message: "Cannot impersonate super admin users".to_string(),
            required_permission: None
        })
    }

    // Log impersonation
    db.audit_logs().create(AuditLogEntry {
        action: "user.impersonate".to_string(),
        actor_id: ctx.user_id(),
        target_type: "User".to_string(),
        target_id: Some(user_id.clone()),
        details: Map::from([
            ("target_email".to_string(), Dynamic::String(target_user.email.clone()))
        ]),
        ip_address: Some(ctx.ip_address.clone()),
        timestamp: DateTime::now()
    }).await.ok();

    // Generate impersonation token
    let (access_token, refresh_token) = generate_impersonation_token(
        &target_user,
        ctx.user_id().as_ref().unwrap(),
        Duration::hours(1)
    ).map_err(|e| ApiError::InternalError {
        message: e.to_string(),
        trace_id: ctx.trace_id.clone()
    })?;

    Ok(Response::json(Map::from([
        ("access_token".to_string(), Dynamic::String(access_token)),
        ("refresh_token".to_string(), Dynamic::String(refresh_token)),
        ("impersonating".to_string(), Dynamic::Map(Map::from([
            ("user_id".to_string(), Dynamic::String(target_user.id)),
            ("email".to_string(), Dynamic::String(target_user.email)),
            ("name".to_string(), Dynamic::String(format!("{} {}", target_user.first_name, target_user.last_name)))
        ]))),
        ("expires_in".to_string(), Dynamic::Int(3600))
    ])))
}

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

fn user_to_response(user: &User) -> UserResponse {
    UserResponse {
        id: user.id.clone(),
        email: user.email.clone(),
        first_name: user.first_name.clone(),
        last_name: user.last_name.clone(),
        display_name: user.display_name.clone(),
        avatar_url: user.avatar_url.clone(),
        roles: user.roles.clone(),
        status: user.status.clone(),
        email_verified: user.email_verified,
        mfa_enabled: user.mfa_enabled,
        timezone: user.timezone.clone(),
        locale: user.locale.clone(),
        created_at: user.created_at,
        updated_at: user.updated_at,
        last_login_at: user.last_login_at
    }
}

fn user_to_list_item(user: &User) -> UserListItem {
    UserListItem {
        id: user.id.clone(),
        email: user.email.clone(),
        name: format!("{} {}", user.first_name, user.last_name),
        avatar_url: user.avatar_url.clone(),
        roles: user.roles.clone(),
        status: user.status.clone(),
        created_at: user.created_at,
        last_login_at: user.last_login_at
    }
}

fn validate_create_user_input(input: &CreateUserRequest) -> Result<(), ApiError> {
    let mut errors = vec![];

    if input.email.is_empty() {
        errors.push(FieldError {
            field: "email".to_string(),
            code: "required".to_string(),
            message: "Email is required".to_string()
        });
    }

    if input.first_name.is_empty() {
        errors.push(FieldError {
            field: "first_name".to_string(),
            code: "required".to_string(),
            message: "First name is required".to_string()
        });
    }

    if input.last_name.is_empty() {
        errors.push(FieldError {
            field: "last_name".to_string(),
            code: "required".to_string(),
            message: "Last name is required".to_string()
        });
    }

    if !errors.is_empty() {
        return Err(ApiError::ValidationError {
            field: "".to_string(),
            message: "Validation failed".to_string(),
            errors
        })
    }

    Ok(())
}

async fn create_single_user(
    db: &Database,
    input: &CreateUserRequest,
    ctx: &RequestContext,
    send_email: Bool
) -> Result<UserResponse, ApiError> {
    // Similar to create_user but without the request parsing
    validate_create_user_input(input)?;

    let password_hash = if let Some(ref password) = input.password {
        hash_password(password).map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
    } else {
        hash_password(&generate_temp_password()).map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
    };

    let tenant_id = input.tenant_id.clone().or_else(|| ctx.tenant_id());

    let user = db.users()
        .create(CreateUserInput {
            email: input.email.clone(),
            password_hash,
            first_name: input.first_name.clone(),
            last_name: input.last_name.clone(),
            tenant_id,
            role: input.roles.as_ref()
                .and_then(|r| r.first())
                .cloned()
                .unwrap_or(SystemRole::Student),
            email_verified: false
        })
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    if send_email {
        send_welcome_email(&user.email, &user.first_name).await.ok();
    }

    Ok(user_to_response(&user))
}

fn generate_temp_password() -> String {
    use std::random::random;
    let chars: Vec<char> = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%".chars().collect();
    (0..16).map(|_| chars[(random::<u8>() as usize) % chars.len()]).collect()
}

async fn send_welcome_email(email: &str, name: &str) -> Result<(), String> {
    // Would send welcome email
    Ok(())
}

fn parse_user_status(s: &str) -> Option<UserStatus> {
    match s.to_lowercase().as_str() {
        "active" => Some(UserStatus::Active),
        "inactive" => Some(UserStatus::Inactive),
        "suspended" => Some(UserStatus::Suspended),
        "pending" => Some(UserStatus::Pending),
        _ => None
    }
}

fn parse_system_role(s: &str) -> Option<SystemRole> {
    match s.to_lowercase().as_str() {
        "superadmin" | "super_admin" => Some(SystemRole::SuperAdmin),
        "admin" => Some(SystemRole::Admin),
        "instructor" | "teacher" => Some(SystemRole::Instructor),
        "student" => Some(SystemRole::Student),
        "ta" | "teaching_assistant" => Some(SystemRole::TeachingAssistant),
        _ => None
    }
}

fn generate_impersonation_token(
    target: &User,
    impersonator_id: &UserId,
    duration: Duration
) -> Result<(String, String), String> {
    // Would generate JWT with impersonation claims
    Ok(("access_token".to_string(), "refresh_token".to_string()))
}

