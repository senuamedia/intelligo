    }

    let pagination = PaginationParams::from_request(&req);
    let unread_only = req.query_param("unread_only").map(|v| v == "true").unwrap_or(false);

    let (notifications, total) = db.notifications()
        .find_by_user(&user_id, unread_only, pagination.limit(), pagination.offset())
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    let meta = pagination.to_meta(total);
    Ok(Response::json(ApiResponse::paginated(notifications, meta, &ctx)))
