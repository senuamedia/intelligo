/// Get user roles
async fn get_user_roles(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::ViewUsers)?;

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    let user = db.users()
        .find_by_id(&user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: user_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(user.roles, &ctx)))
}

/// Update user roles
async fn update_user_roles(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    ctx.require_permission(Permission::ManageRoles)?;

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    // Prevent changing own roles
    if ctx.user_id().map(|id| id == user_id).unwrap_or(false) {
        return Err(ApiError::Forbidden {
            message: "Cannot modify your own roles".to_string(),
            required_permission: None
        })
    }

    #[derive(Deserialize)]
    struct UpdateRolesRequest {
        roles: List<SystemRole>
    }

    let body: UpdateRolesRequest = req.json().await.map_err(|e| ApiError::BadRequest {
        message: format!("Invalid request body: {}", e)
    })?;

    // Validate roles
    if body.roles.is_empty() {
        return Err(ApiError::ValidationError {
            field: "roles".to_string(),
            message: "At least one role is required".to_string(),
            errors: vec![]
        })
    }

    // SuperAdmin role requires super admin permission
    if body.roles.contains(&SystemRole::SuperAdmin) {
        if !ctx.has_role(SystemRole::SuperAdmin) {
            return Err(ApiError::Forbidden {
                message: "Only super admins can grant super admin role".to_string(),
                required_permission: None
            })
        }
    }

    db.users()
        .set_roles(&user_id, &body.roles)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?;

    Ok(Response::json(ApiResponse::success(body.roles, &ctx)))
}

/// Get user permissions
async fn get_user_permissions(req: Request, db: Database) -> Result<Response, ApiError> {
    let ctx = RequestContext::from_request(&req);

    let user_id = req.param("user_id").ok_or_else(|| ApiError::BadRequest {
        message: "User ID required".to_string()
    })?;

    // Only self or admin can view permissions
    let is_self = ctx.user_id().map(|id| id == user_id).unwrap_or(false);
    if !is_self {
        ctx.require_permission(Permission::ViewUsers)?;
    }

    let user = db.users()
        .find_by_id(&user_id)
        .await
        .map_err(|e| ApiError::InternalError {
            message: e.to_string(),
            trace_id: ctx.trace_id.clone()
        })?
        .ok_or_else(|| ApiError::NotFound {
            resource: "User".to_string(),
            id: user_id.clone()
        })?;

    let permissions = user.get_permission_strings();

    Ok(Response::json(ApiResponse::success(permissions, &ctx)))
}

