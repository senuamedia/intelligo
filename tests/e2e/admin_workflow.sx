fn get_course_enrollments(course_id: &str) -> Vec<Enrollment> { todo!() }
fn get_enrollment(user_id: &str, course_id: &str) -> Enrollment { todo!() }
fn set_enrollment_deadline(enrollment_id: &str, deadline: DateTime) -> Result<(), String> { todo!() }
fn extend_enrollment_deadline(enrollment_id: &str, extension: Duration) -> Result<(), String> { todo!() }
fn get_enrollment_requests(course_id: &str, status: RequestStatus) -> Vec<EnrollmentRequest> { todo!() }
