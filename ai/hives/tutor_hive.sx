// =============================================================================
// INTELLIGO LMS - Tutor Hive
// =============================================================================
// AI-powered tutoring chatbot system following CHAI patterns.
// Provides question answering with RAG, concept explanation, practice problem
// generation, study guide creation, and Socratic facilitation for guided
// discovery learning.
// =============================================================================

module intelligo::ai::hives::tutor_hive

use intelligo::core::types::*
use simplex_inference::{Model, Prompt, EmbeddingModel}
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set}
use std::sync::{Arc, RwLock}

// =============================================================================
// Tutor Hive Types
// =============================================================================

type ConversationId = String
type MessageId = String
type TutorSessionId = String
type ChunkId = String

/// Tutor Hive Configuration
pub struct TutorHiveConfig {
    /// Default model for tutoring
    default_model: ModelConfig,
    /// Embedding model for RAG
    embedding_model: EmbeddingModelConfig,
    /// Maximum context window tokens
    max_context_tokens: i32,
    /// Number of chunks to retrieve for RAG
    rag_top_k: i32,
    /// Minimum similarity for chunk retrieval
    rag_similarity_threshold: f64,
    /// Session timeout
    session_timeout: Duration,
    /// Maximum conversation history to maintain
    max_history_messages: i32,
    /// Enable Socratic mode by default
    default_socratic_mode: bool,
    /// Maximum hints per problem
    max_hints_per_problem: i32,
}

impl Default for TutorHiveConfig {
    fn default() -> Self {
        TutorHiveConfig {
            default_model: ModelConfig {
                provider: ModelProvider::Anthropic,
                model_id: "claude-sonnet-4-20250514".to_string(),
                temperature: 0.7,
                max_tokens: 4096,
                top_p: Some(0.9),
                frequency_penalty: None,
                presence_penalty: None,
                stop_sequences: vec![],
                input_cost_per_1k: 0.003,
                output_cost_per_1k: 0.015,
            },
            embedding_model: EmbeddingModelConfig {
                provider: ModelProvider::OpenAI,
                model_id: "text-embedding-3-large".to_string(),
                dimensions: 1536,
                input_cost_per_1k: 0.00013,
            },
            max_context_tokens: 8000,
            rag_top_k: 5,
            rag_similarity_threshold: 0.7,
            session_timeout: Duration::hours(2),
            max_history_messages: 20,
            default_socratic_mode: false,
            max_hints_per_problem: 3,
        }
    }
}

/// Model configuration
pub struct ModelConfig {
    provider: ModelProvider,
    model_id: String,
    temperature: f64,
    max_tokens: i32,
    top_p: Option<f64>,
    frequency_penalty: Option<f64>,
    presence_penalty: Option<f64>,
    stop_sequences: List<String>,
    input_cost_per_1k: f64,
    output_cost_per_1k: f64,
}

/// Embedding model configuration
pub struct EmbeddingModelConfig {
    provider: ModelProvider,
    model_id: String,
    dimensions: i32,
    input_cost_per_1k: f64,
}

/// Model provider
pub enum ModelProvider {
    Anthropic,
    OpenAI,
    Google,
    Local { endpoint: String },
}

