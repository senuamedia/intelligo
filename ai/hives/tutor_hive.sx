    /// Session metrics
    metrics: SessionMetrics,
    /// Created timestamp
    created_at: DateTime,
    /// Last activity
    last_activity: DateTime,
}

/// Conversation history
pub struct Conversation {
    id: ConversationId,
    messages: List<Message>,
