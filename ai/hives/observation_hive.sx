    /// Active users count
    active_users: i64,
    /// Active sessions
    active_sessions: i64,
    /// Error rate
    error_rate: f64,
    /// Issues detected
    issues: List<SystemIssue>,
}

/// API performance metrics
pub struct ApiMetrics {
    /// Average response time (ms)
    avg_response_time: f64,
    /// P95 response time
    p95_response_time: f64,
    /// P99 response time
    p99_response_time: f64,
    /// Requests per second
    requests_per_second: f64,
    /// Error rate
