// Learner Profile Types
// =============================================================================

/// Comprehensive learner profile
pub struct LearnerProfile {
    id: LearnerProfileId,
    student_id: StudentId,
    /// Knowledge state for each node
    knowledge_state: Map<PathNodeId, KnowledgeState>,
    /// Detected learning style
    learning_style: LearningStyleProfile,
    /// Learning preferences
    preferences: LearningPreferences,
    /// Performance history
    performance_history: List<PerformanceRecord>,
    /// Current learning velocity
    learning_velocity: f64,
    /// Engagement patterns
    engagement_patterns: EngagementPatterns,
    /// Goals and targets
    goals: List<LearningGoal>,
    /// Strengths
    strengths: List<PathNodeId>,
    /// Areas needing improvement
    weaknesses: List<PathNodeId>,
    /// Last updated
    updated_at: DateTime,
}

/// Knowledge state for a concept
pub struct KnowledgeState {
    node_id: PathNodeId,
    /// Mastery level (0.0 - 1.0)
    mastery: f64,
    /// Confidence in mastery estimate
    confidence: f64,
    /// Number of attempts
    attempts: i32,
    /// Time spent learning (minutes)
    time_spent: i32,
    /// Last interaction
    last_interaction: Option<DateTime>,
    /// History of mastery changes
    mastery_history: List<MasteryRecord>,
    /// Current status
    status: KnowledgeStatus,
}

/// Mastery record
pub struct MasteryRecord {
    timestamp: DateTime,
    mastery: f64,
    source: MasterySource,
}

/// Source of mastery update
pub enum MasterySource {
    Assessment { assessment_id: AssessmentId, score: f32 },
    Practice { activity_id: String },
    ContentCompletion { content_id: String },
    TimeDecay,
    InstructorOverride { instructor_id: UserId },
}

/// Knowledge status
pub enum KnowledgeStatus {
    /// Not started
    NotStarted,
    /// Currently learning
    InProgress,
    /// Needs review (mastery declining)
    NeedsReview,
    /// Mastered
    Mastered,
    /// Struggling (low progress)
    Struggling,
}

/// Learning style profile (VARK model plus extensions)
pub struct LearningStyleProfile {
    /// Visual learning preference
    visual: f64,
    /// Auditory learning preference
    auditory: f64,
    /// Reading/writing preference
    reading_writing: f64,
    /// Kinesthetic preference
    kinesthetic: f64,
    /// Social learning preference
    social: f64,
    /// Solitary learning preference
    solitary: f64,
    /// Confidence in this profile
    confidence: f64,
    /// Evidence supporting this profile
    evidence: List<StyleEvidence>,
}

impl Default for LearningStyleProfile {
    fn default() -> Self {
        LearningStyleProfile {
            visual: 0.25,
            auditory: 0.25,
            reading_writing: 0.25,
            kinesthetic: 0.25,
            social: 0.5,
            solitary: 0.5,
            confidence: 0.0,
            evidence: vec![],
        }
    }
}

/// Evidence for learning style
pub struct StyleEvidence {
    source: String,
    dimension: String,
    value: f64,
    timestamp: DateTime,
}

/// Learning preferences
pub struct LearningPreferences {
    /// Preferred content types
    preferred_content_types: List<ContentType>,
    /// Preferred session length (minutes)
    preferred_session_length: i32,
    /// Preferred time of day
    preferred_time_of_day: Option<TimeOfDay>,
    /// Pace preference
    pace_preference: PacePreference,
    /// Feedback frequency preference
    feedback_frequency: FeedbackFrequency,
    /// Challenge level preference
    challenge_preference: ChallengePreference,
}

impl Default for LearningPreferences {
    fn default() -> Self {
        LearningPreferences {
            preferred_content_types: vec![],
            preferred_session_length: 30,
            preferred_time_of_day: None,
            pace_preference: PacePreference::Moderate,
            feedback_frequency: FeedbackFrequency::Regular,
            challenge_preference: ChallengePreference::Balanced,
        }
    }
}

