    Slow,
    Moderate,
    Fast,
    SelfDirected,
}

/// Feedback frequency
pub enum FeedbackFrequency {
    Minimal,
    Regular,
    Frequent,
    Immediate,
}

/// Challenge level preference
pub enum ChallengePreference {
    Conservative,
    Balanced,
    Challenging,
    Adaptive,
}

