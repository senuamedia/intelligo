// =============================================================================
// INTELLIGO LMS - Learning Path Hive
// =============================================================================
// AI-powered adaptive learning system following CHAI patterns.
// Provides prerequisite analysis, skill gap identification, content
// recommendation, pace optimization, learning style adaptation, and
// competency tracking for personalized learning experiences.
// =============================================================================

module intelligo::ai::hives::learning_path_hive

use intelligo::core::types::*
use simplex_inference::{Model, Prompt, EmbeddingModel}
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set, PriorityQueue}
use std::sync::{Arc, RwLock}

// =============================================================================
// Learning Path Hive Types
// =============================================================================

type PathNodeId = String
type KnowledgeGraphId = String
type RecommendationId = String
type LearnerProfileId = String

/// Learning Path Hive Configuration
pub struct LearningPathConfig {
    /// Default model for analysis
    default_model: ModelConfig,
    /// Embedding model for content similarity
    embedding_model: EmbeddingModelConfig,
    /// Update learner profile after N interactions
    profile_update_frequency: i32,
    /// Recommendation cache TTL
    cache_ttl: Duration,
    /// Minimum mastery threshold for progression
    mastery_threshold: f64,
    /// Enable adaptive pacing
    adaptive_pacing_enabled: bool,
    /// Enable learning style detection
    learning_style_detection: bool,
    /// Knowledge graph depth for prerequisite analysis
    prerequisite_depth: i32,
}

impl Default for LearningPathConfig {
    fn default() -> Self {
        LearningPathConfig {
            default_model: ModelConfig {
                provider: ModelProvider::Anthropic,
                model_id: "claude-sonnet-4-20250514".to_string(),
                temperature: 0.3,
                max_tokens: 4096,
                top_p: None,
                frequency_penalty: None,
                presence_penalty: None,
                stop_sequences: vec![],
                input_cost_per_1k: 0.003,
                output_cost_per_1k: 0.015,
            },
            embedding_model: EmbeddingModelConfig {
                provider: ModelProvider::OpenAI,
                model_id: "text-embedding-3-large".to_string(),
                dimensions: 1536,
                input_cost_per_1k: 0.00013,
            },
            profile_update_frequency: 5,
            cache_ttl: Duration::hours(1),
            mastery_threshold: 0.8,
            adaptive_pacing_enabled: true,
            learning_style_detection: true,
            prerequisite_depth: 3,
        }
    }
}

/// Model configuration
pub struct ModelConfig {
    provider: ModelProvider,
    model_id: String,
    temperature: f64,
    max_tokens: i32,
    top_p: Option<f64>,
    frequency_penalty: Option<f64>,
    presence_penalty: Option<f64>,
    stop_sequences: List<String>,
    input_cost_per_1k: f64,
    output_cost_per_1k: f64,
}

/// Embedding model configuration
pub struct EmbeddingModelConfig {
    provider: ModelProvider,
    model_id: String,
    dimensions: i32,
    input_cost_per_1k: f64,
}

/// Model provider
pub enum ModelProvider {
    Anthropic,
    OpenAI,
    Google,
    Local { endpoint: String },
}

// =============================================================================
// Knowledge Graph Types
// =============================================================================

/// Knowledge graph representing learning domain
pub struct KnowledgeGraph {
    id: KnowledgeGraphId,
    name: String,
    description: Option<String>,
    /// All concepts/skills in the graph
    nodes: Map<PathNodeId, KnowledgeNode>,
    /// Prerequisite relationships
    edges: List<KnowledgeEdge>,
    /// Metadata
    created_at: DateTime,
    updated_at: DateTime,
}

/// A node in the knowledge graph
pub struct KnowledgeNode {
    id: PathNodeId,
    /// Type of knowledge
    node_type: KnowledgeNodeType,
    /// Name/title
    name: String,
    /// Description
    description: String,
    /// Bloom's taxonomy level
    bloom_level: BloomLevel,
    /// Estimated time to master (minutes)
    estimated_time: i32,
    /// Difficulty level
    difficulty: SkillLevel,
    /// Tags for categorization
    tags: List<String>,
    /// Linked content items
    content_ids: List<ContentLink>,
    /// Linked assessments
    assessment_ids: List<AssessmentId>,
    /// Embedding for similarity matching
    embedding: Option<Vec<f64>>,
}

/// Type of knowledge node
pub enum KnowledgeNodeType {
    /// Core concept
    Concept,
    /// Skill/ability
    Skill,
    /// Competency (cluster of skills)
    Competency,
    /// Learning objective
    Objective,
    /// Topic area
    Topic,
}

/// Link to content
pub struct ContentLink {
    content_id: String,
    content_type: ContentType,
    primary: bool,
}

/// Edge representing prerequisite relationship
pub struct KnowledgeEdge {
    /// Source node (prerequisite)
    from_id: PathNodeId,
    /// Target node (dependent)
    to_id: PathNodeId,
    /// Relationship type
    relationship: PrerequisiteType,
    /// Strength of relationship (0.0 - 1.0)
    strength: f64,
}

/// Type of prerequisite relationship
pub enum PrerequisiteType {
    /// Must complete before
    Required,
    /// Recommended before
    Recommended,
    /// Helpful but optional
    Optional,
    /// Co-requisite (can be taken together)
    Corequisite,
}

