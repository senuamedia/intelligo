// Error Types
// =============================================================================

pub enum AssessmentError {
    AlreadyRunning,
    NotRunning,
    TaskNotFound { id: GradingTaskId },
    GradingFailed { reason: String },
    EvaluationFailed { reason: String },
    RubricFailed { reason: String },
    FeedbackFailed { reason: String },
    PlagiarismCheckFailed { reason: String },
    CalibrationFailed { reason: String },
    InvalidSubmission { reason: String },
}

pub enum GradingError {
    InvalidSubmission { reason: String },
    ModelError { message: String },
    ParseError { message: String },
    UnsupportedLanguage { language: String },
    SandboxError { message: String },
    InsufficientSamples { required: usize, provided: usize },
    UnsupportedTaskType,
}

