// =============================================================================
// Sandbox Execution Types and Implementations
// =============================================================================

/// Request for sandbox code execution
pub struct SandboxExecutionRequest {
    /// Programming language
    language: String,
    /// Source code to execute
    source_code: String,
    /// Additional files needed
    additional_files: Map<String, String>,
    /// Entry point file or function
    entry_point: Option<String>,
    /// Standard input
    stdin: String,
    /// Execution timeout in milliseconds
    timeout_ms: i64,
    /// Memory limit in MB
    memory_limit_mb: i64,
    /// CPU limit as percentage
    cpu_limit_percent: i32,
    /// Allow network access
    network_enabled: bool,
    /// Mount filesystem as read-only
    filesystem_readonly: bool,
}

/// Result from sandbox execution
pub struct SandboxExecutionResult {
    /// Standard output
    stdout: String,
    /// Standard error
    stderr: String,
    /// Exit code
    exit_code: i32,
    /// Execution time in milliseconds
    execution_time_ms: i64,
    /// Memory used in bytes
    memory_used_bytes: i64,
    /// Error message if execution failed
    error: Option<String>,
}

/// Trait for sandbox executors
pub trait SandboxExecutor: Send + Sync {
    /// Execute code in sandbox
    async fn execute(&self, request: &SandboxExecutionRequest) -> Result<SandboxExecutionResult, String>;

    /// Check if executor is available
    fn is_available(&self) -> bool;

    /// Get supported languages
    fn supported_languages(&self) -> List<String>;
}

/// Docker-based sandbox executor
pub struct DockerSandboxExecutor {
    language: String,
    image_map: Map<String, String>,
}

impl DockerSandboxExecutor {
    pub fn new(language: &str) -> Self {
        let mut image_map = Map::new();
        image_map.insert("python".to_string(), "intelligo/sandbox-python:3.11".to_string());
        image_map.insert("javascript".to_string(), "intelligo/sandbox-node:20".to_string());
        image_map.insert("typescript".to_string(), "intelligo/sandbox-node:20".to_string());
        image_map.insert("java".to_string(), "intelligo/sandbox-java:17".to_string());
        image_map.insert("cpp".to_string(), "intelligo/sandbox-cpp:gcc13".to_string());
        image_map.insert("c".to_string(), "intelligo/sandbox-cpp:gcc13".to_string());
        image_map.insert("rust".to_string(), "intelligo/sandbox-rust:1.74".to_string());
        image_map.insert("go".to_string(), "intelligo/sandbox-go:1.21".to_string());
        image_map.insert("ruby".to_string(), "intelligo/sandbox-ruby:3.2".to_string());
        image_map.insert("swift".to_string(), "intelligo/sandbox-swift:5.9".to_string());
        image_map.insert("kotlin".to_string(), "intelligo/sandbox-kotlin:1.9".to_string());

        DockerSandboxExecutor {
            language: language.to_lowercase(),
            image_map,
        }
    }

    fn get_image(&self) -> Result<String, String> {
        self.image_map.get(&self.language)
            .cloned()
            .ok_or_else(|| format!("No Docker image for language: {}", self.language))
    }

    fn get_run_command(&self) -> String {
        match self.language.as_str() {
            "python" => "python3 main.py".to_string(),
            "javascript" => "node main.js".to_string(),
            "typescript" => "npx ts-node main.ts".to_string(),
            "java" => "javac Main.java && java Main".to_string(),
            "cpp" => "g++ -o main main.cpp && ./main".to_string(),
            "c" => "gcc -o main main.c && ./main".to_string(),
            "rust" => "rustc main.rs && ./main".to_string(),
            "go" => "go run main.go".to_string(),
            "ruby" => "ruby main.rb".to_string(),
            "swift" => "swift main.swift".to_string(),
            "kotlin" => "kotlinc main.kt -include-runtime -d main.jar && java -jar main.jar".to_string(),
            _ => format!("echo 'Unsupported language: {}'", self.language),
        }
    }

    fn get_main_filename(&self) -> String {
        match self.language.as_str() {
            "python" => "main.py".to_string(),
            "javascript" => "main.js".to_string(),
            "typescript" => "main.ts".to_string(),
            "java" => "Main.java".to_string(),
            "cpp" => "main.cpp".to_string(),
            "c" => "main.c".to_string(),
            "rust" => "main.rs".to_string(),
            "go" => "main.go".to_string(),
            "ruby" => "main.rb".to_string(),
            "swift" => "main.swift".to_string(),
            "kotlin" => "main.kt".to_string(),
            _ => "main.txt".to_string(),
        }
    }
}

impl SandboxExecutor for DockerSandboxExecutor {
    async fn execute(&self, request: &SandboxExecutionRequest) -> Result<SandboxExecutionResult, String> {
        let image = self.get_image()?;
        let run_cmd = self.get_run_command();
        let main_file = self.get_main_filename();

        // Create temporary directory for code
        let temp_dir = std::temp::create_dir()?;
        let code_path = format!("{}/{}", temp_dir, main_file);

        // Write source code to file
        std::fs::write(&code_path, &request.source_code)?;

        // Write additional files
        for (filename, content) in &request.additional_files {
            let file_path = format!("{}/{}", temp_dir, filename);
            std::fs::write(&file_path, content)?;
        }

        // Write stdin to file if provided
        let stdin_file = format!("{}/stdin.txt", temp_dir);
        std::fs::write(&stdin_file, &request.stdin)?;

        // Build Docker command with security constraints
        let docker_args = vec![
            "run".to_string(),
            "--rm".to_string(),
            "--network=none".to_string(),  // No network access
            format!("--memory={}m", request.memory_limit_mb),
            format!("--cpus={}", request.cpu_limit_percent as f64 / 100.0),
            "--pids-limit=64".to_string(),  // Limit processes
            "--read-only".to_string(),  // Read-only filesystem
            "--tmpfs=/tmp:rw,size=64m".to_string(),  // Writeable /tmp
            "--security-opt=no-new-privileges".to_string(),
            "--cap-drop=ALL".to_string(),  // Drop all capabilities
            format!("-v={}:/code:ro", temp_dir),  // Mount code read-only
            "-w=/code".to_string(),
            image,
            "sh".to_string(),
            "-c".to_string(),
            format!("timeout {} sh -c '{} < stdin.txt'", request.timeout_ms / 1000, run_cmd),
        ];

        // Execute Docker command
        let start_time = std::time::Instant::now();
        let output = std::process::Command::new("docker")
            .args(&docker_args)
            .output()
            .await
            .map_err(|e| format!("Failed to execute Docker: {}", e))?;

        let execution_time_ms = start_time.elapsed().as_millis() as i64;

        // Cleanup temp directory
        std::fs::remove_dir_all(&temp_dir).ok();

        // Check for timeout
        if execution_time_ms >= request.timeout_ms {
            return Ok(SandboxExecutionResult {
                stdout: String::new(),
                stderr: "Execution timed out".to_string(),
                exit_code: 124,  // Standard timeout exit code
                execution_time_ms,
                memory_used_bytes: 0,
                error: Some("Execution exceeded time limit".to_string()),
            });
        }

        Ok(SandboxExecutionResult {
            stdout: String::from_utf8_lossy(&output.stdout).to_string(),
            stderr: String::from_utf8_lossy(&output.stderr).to_string(),
            exit_code: output.exit_code.unwrap_or(-1),
            execution_time_ms,
            memory_used_bytes: 0,  // Would need cgroup stats for accurate measurement
            error: None,
        })
    }

    fn is_available(&self) -> bool {
        std::process::Command::new("docker")
            .arg("version")
            .output()
            .is_ok()
    }

    fn supported_languages(&self) -> List<String> {
        self.image_map.keys().cloned().collect()
    }
}

/// Firecracker microVM-based sandbox executor (more secure than Docker)
pub struct FirecrackerSandboxExecutor {
    language: String,
    kernel_path: String,
    rootfs_map: Map<String, String>,
}

impl FirecrackerSandboxExecutor {
    pub fn new(language: &str) -> Self {
        let mut rootfs_map = Map::new();
        rootfs_map.insert("python".to_string(), "/var/lib/firecracker/rootfs/python.ext4".to_string());
        rootfs_map.insert("javascript".to_string(), "/var/lib/firecracker/rootfs/node.ext4".to_string());
        rootfs_map.insert("java".to_string(), "/var/lib/firecracker/rootfs/java.ext4".to_string());

        FirecrackerSandboxExecutor {
            language: language.to_lowercase(),
            kernel_path: "/var/lib/firecracker/vmlinux".to_string(),
            rootfs_map,
        }
    }
}

impl SandboxExecutor for FirecrackerSandboxExecutor {
    async fn execute(&self, request: &SandboxExecutionRequest) -> Result<SandboxExecutionResult, String> {
        let rootfs = self.rootfs_map.get(&self.language)
            .ok_or_else(|| format!("No Firecracker rootfs for language: {}", self.language))?;

        // Create Firecracker configuration
        let config = json!({
            "boot-source": {
                "kernel_image_path": self.kernel_path,
                "boot_args": "console=ttyS0 reboot=k panic=1 pci=off"
            },
            "drives": [{
                "drive_id": "rootfs",
                "path_on_host": rootfs,
                "is_root_device": true,
                "is_read_only": true
            }],
            "machine-config": {
                "vcpu_count": 1,
                "mem_size_mib": request.memory_limit_mb,
                "smt": false
            },
            "network-interfaces": []
        });

        // Start Firecracker microVM
        let socket_path = format!("/tmp/firecracker-{}.sock", generate_uuid());

        let fc_process = std::process::Command::new("firecracker")
            .args(&["--api-sock", &socket_path, "--config-file", "/dev/stdin"])
            .stdin(config.to_string())
            .spawn()
            .map_err(|e| format!("Failed to start Firecracker: {}", e))?;

        // Wait for VM to boot and execute code
        // This is simplified - real implementation would use vsock for communication
        let start_time = std::time::Instant::now();

        // Send code to VM via API
        let response = http::put(&format!("http+unix://{}/actions", socket_path))
            .json(&json!({
                "action_type": "SendCode",
                "payload": {
                    "source": request.source_code,
                    "stdin": request.stdin,
                    "language": request.language
                }
            }))
            .timeout(Duration::from_millis(request.timeout_ms as u64))
            .send()
            .await;

        let execution_time_ms = start_time.elapsed().as_millis() as i64;

        // Cleanup - terminate VM
        fc_process.kill().ok();
        std::fs::remove_file(&socket_path).ok();

        match response {
            Ok(resp) => {
                let result: SandboxExecutionResult = resp.json().await
                    .map_err(|e| format!("Failed to parse response: {}", e))?;
                Ok(result)
            }
            Err(e) => Ok(SandboxExecutionResult {
                stdout: String::new(),
                stderr: e.to_string(),
                exit_code: -1,
                execution_time_ms,
                memory_used_bytes: 0,
                error: Some(e.to_string()),
            })
        }
    }

    fn is_available(&self) -> bool {
        std::path::Path::new("/usr/bin/firecracker").exists()
    }

    fn supported_languages(&self) -> List<String> {
        self.rootfs_map.keys().cloned().collect()
    }
}

/// AWS Lambda-based sandbox executor
pub struct LambdaSandboxExecutor {
    language: String,
    function_map: Map<String, String>,
    region: String,
}

impl LambdaSandboxExecutor {
    pub fn new(language: &str) -> Self {
        let mut function_map = Map::new();
        function_map.insert("python".to_string(), "intelligo-sandbox-python".to_string());
        function_map.insert("javascript".to_string(), "intelligo-sandbox-node".to_string());
        function_map.insert("java".to_string(), "intelligo-sandbox-java".to_string());

        LambdaSandboxExecutor {
            language: language.to_lowercase(),
            function_map,
            region: std::env::var("AWS_REGION").unwrap_or("us-east-1".to_string()),
        }
    }
}

impl SandboxExecutor for LambdaSandboxExecutor {
    async fn execute(&self, request: &SandboxExecutionRequest) -> Result<SandboxExecutionResult, String> {
        let function_name = self.function_map.get(&self.language)
            .ok_or_else(|| format!("No Lambda function for language: {}", self.language))?;

        // Create Lambda invocation payload
        let payload = json!({
            "source_code": request.source_code,
            "additional_files": request.additional_files,
            "stdin": request.stdin,
            "timeout_ms": request.timeout_ms,
            "memory_limit_mb": request.memory_limit_mb
        });

        // Invoke Lambda function
        let start_time = std::time::Instant::now();

        let lambda_client = aws::lambda::Client::new(&self.region);
        let response = lambda_client.invoke(&function_name, &payload)
            .await
            .map_err(|e| format!("Lambda invocation failed: {}", e))?;

        let execution_time_ms = start_time.elapsed().as_millis() as i64;

        // Parse Lambda response
        let result: SandboxExecutionResult = serde_json::from_value(response)
            .map_err(|e| format!("Failed to parse Lambda response: {}", e))?;

        Ok(SandboxExecutionResult {
            execution_time_ms,
            ..result
        })
    }

    fn is_available(&self) -> bool {
        std::env::var("AWS_ACCESS_KEY_ID").is_ok()
    }

    fn supported_languages(&self) -> List<String> {
        self.function_map.keys().cloned().collect()
    }
}

/// nsjail-based sandbox executor (Linux sandboxing)
pub struct NsjailSandboxExecutor {
    language: String,
    config_dir: String,
}

impl NsjailSandboxExecutor {
    pub fn new(language: &str) -> Self {
        NsjailSandboxExecutor {
            language: language.to_lowercase(),
            config_dir: "/etc/nsjail".to_string(),
        }
    }

    fn get_config_path(&self) -> String {
        format!("{}/{}.cfg", self.config_dir, self.language)
    }
}

impl SandboxExecutor for NsjailSandboxExecutor {
    async fn execute(&self, request: &SandboxExecutionRequest) -> Result<SandboxExecutionResult, String> {
        let config_path = self.get_config_path();

        if !std::path::Path::new(&config_path).exists() {
            return Err(format!("nsjail config not found for language: {}", self.language));
        }

        // Create temp directory for code
        let temp_dir = std::temp::create_dir()?;
        let code_path = format!("{}/code", temp_dir);
        std::fs::write(&code_path, &request.source_code)?;

        // Build nsjail command
        let nsjail_args = vec![
            "--config".to_string(),
            config_path,
            "--time_limit".to_string(),
            (request.timeout_ms / 1000).to_string(),
            "--rlimit_as".to_string(),
            (request.memory_limit_mb * 1024 * 1024).to_string(),
            "--cwd".to_string(),
            temp_dir.clone(),
            "--".to_string(),
        ];

        let start_time = std::time::Instant::now();

        let output = std::process::Command::new("nsjail")
            .args(&nsjail_args)
            .stdin(request.stdin.as_bytes())
            .output()
            .await
            .map_err(|e| format!("nsjail execution failed: {}", e))?;

        let execution_time_ms = start_time.elapsed().as_millis() as i64;

        // Cleanup
        std::fs::remove_dir_all(&temp_dir).ok();

        Ok(SandboxExecutionResult {
            stdout: String::from_utf8_lossy(&output.stdout).to_string(),
            stderr: String::from_utf8_lossy(&output.stderr).to_string(),
            exit_code: output.exit_code.unwrap_or(-1),
            execution_time_ms,
            memory_used_bytes: 0,
            error: None,
        })
    }

    fn is_available(&self) -> bool {
        std::path::Path::new("/usr/bin/nsjail").exists()
    }

    fn supported_languages(&self) -> List<String> {
        // List languages by scanning config directory
        std::fs::read_dir(&self.config_dir)
            .map(|entries| {
                entries
                    .filter_map(|e| e.ok())
                    .filter_map(|e| {
                        let name = e.file_name().to_string_lossy().to_string();
                        if name.ends_with(".cfg") {
                            Some(name.trim_end_matches(".cfg").to_string())
                        } else {
                            None
                        }
                    })
                    .collect()
            })
            .unwrap_or_default()
    }
}

fn parse_json<T>(json_str: &str) -> Result<T, String> {
    // JSON parsing implementation
    std::json::parse(json_str)
}

