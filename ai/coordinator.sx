    fn compute_cache_key(&self, request: &AiRequest) -> String {
        // Create deterministic cache key from request
        format!("{:?}:{:?}", request.tenant_id, request.request_type)
    }

    fn is_cacheable(&self, request: &AiRequest) -> bool {
        // Only cache certain request types
        matches!(request.request_type,
            AiRequestType::GenerateQuestions(_) |
            AiRequestType::CreateLesson(_) |
            AiRequestType::BuildRubric(_) |
            AiRequestType::SummarizeContent(_)
        )
    }

    fn extract_cost_info(&self, result: &AiResult) -> (i64, f64, String) {
        // Extract tokens and cost from result
        // Would be populated from actual hive responses
        (0, 0.0, "unknown".to_string())
    }

    async fn process_request_queue(&mut self) {
        while self.is_running {
            if let Some(request) = self.request_queue.dequeue() {
                let request_id = request.id.clone();

                match self.route_request(&request).await {
                    Ok(result) => {
                        // Store result for retrieval
                        self.pending_requests.remove(&request_id);
                    },
                    Err(e) => {
                        // Handle error
                        self.metrics.errors += 1;
                    }
                }
            }

            sleep(Duration::millis(10)).await;
        }
    }

    async fn health_check_loop(&mut self) {
        while self.is_running {
            // Check health of all hives
            for (name, cb) in &mut self.circuit_breakers {
                // Would ping actual hives
            }

            sleep(self.config.health_check_interval).await;
        }
    }

    async fn cache_cleanup_loop(&mut self) {
        while self.is_running {
            let now = DateTime::now();

            // Remove expired cache entries
            self.request_cache.retain(|_, (_, cached_at)| {
                now - *cached_at < self.config.cache_ttl
            });

            sleep(Duration::minutes(5)).await;
        }
    }
}

// =============================================================================
// Types
// =============================================================================

/// Request status
pub enum RequestStatus {
    Pending,
    Processing,
    Completed,
    Failed,
}

/// Coordinator health
pub struct CoordinatorHealth {
    is_running: bool,
    queue_depth: usize,
    hive_health: Map<String, HiveHealth>,
    metrics: CoordinatorMetrics,
}

/// Hive health
pub struct HiveHealth {
    available: bool,
    circuit_state: String,
    failure_count: i32,
}

/// Cost report
pub struct CostReport {
    total_cost: f64,
    monthly_cost: f64,
    monthly_tokens: i64,
    by_hive: Map<String, f64>,
}

/// Coordinator metrics
#[derive(Clone, Default)]
pub struct CoordinatorMetrics {
    pub requests_processed: i64,
    pub requests_queued: i64,
    pub cache_hits: i64,
    pub cache_misses: i64,
    pub errors: i64,
    pub total_processing_time_ms: i64,
    pub total_tokens: i64,
    pub total_cost: f64,
}

impl Default for RequestContext {
    fn default() -> Self {
        RequestContext {
            user_id: None,
            course_id: None,
            session_id: None,
            metadata: Map::new(),
        }
    }
}

// =============================================================================
// Error Types
// =============================================================================

pub enum CoordinatorError {
    AlreadyRunning,
    NotRunning,
    HiveNotAvailable { hive: String },
    CircuitOpen { hive: String },
    RateLimitExceeded { tenant_id: TenantId },
    BudgetExceeded { tenant_id: TenantId },
    RequestTimeout { request_id: RequestId },
    UnsupportedRequestType,
    UnexpectedResult,
    HiveError { hive: String, message: String },
}

// =============================================================================
// Utility Functions
// =============================================================================

fn generate_uuid() -> String {
    std::uuid::v4()
}

// =============================================================================
// Tests
// =============================================================================

#[cfg(test)]
mod tests {
    use super::*

    #[test]
    fn test_coordinator_creation() {
        let coordinator = AiCoordinator::new();
        assert!(!coordinator.is_running);
    }

    #[test]
    fn test_rate_limiter() {
        let mut limiter = RateLimiter::new(10.0);

        // Should allow burst
        for _ in 0..100 {
            assert!(limiter.try_acquire());
        }

        // Eventually should throttle
        let mut denied = false;
        for _ in 0..1000 {
            if !limiter.try_acquire() {
                denied = true;
                break;
            }
        }
        assert!(denied);
    }

    #[test]
    fn test_circuit_breaker() {
        let mut cb = CircuitBreaker::new(3);

        assert!(cb.is_available());

        // Record failures
        cb.record_failure();
        cb.record_failure();
        assert!(cb.is_available());

        cb.record_failure();
        assert!(!cb.is_available()); // Should be open now
    }

    #[test]
    fn test_request_queue_priority() {
        let mut queue = RequestQueue::new();

        queue.enqueue(AiRequest {
            id: RequestId("low".to_string()),
            tenant_id: TenantId("t1".to_string()),
            request_type: AiRequestType::GetSystemHealth,
            priority: RequestPriority::Low,
            context: RequestContext::default(),
            created_at: DateTime::now(),
            timeout: Duration::seconds(30),
        });

        queue.enqueue(AiRequest {
            id: RequestId("critical".to_string()),
            tenant_id: TenantId("t1".to_string()),
            request_type: AiRequestType::GetSystemHealth,
            priority: RequestPriority::Critical,
            context: RequestContext::default(),
            created_at: DateTime::now(),
            timeout: Duration::seconds(30),
        });

        // Critical should come first
        let first = queue.dequeue().unwrap();
        assert_eq!(first.id.0, "critical");
    }

    #[test]
    fn test_cost_tracker() {
        let mut tracker = CostTracker::new();

        tracker.record_cost(&TenantId("t1".to_string()), "assessment", 0.05, 1000);
        tracker.record_cost(&TenantId("t1".to_string()), "content", 0.03, 500);

        let record = tracker.get_tenant_cost(&TenantId("t1".to_string())).unwrap();
        assert!((record.monthly_cost - 0.08).abs() < 0.001);
    }
}
