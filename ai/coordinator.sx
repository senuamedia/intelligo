    /// Grade a submission
    pub receive GradeSubmission(tenant_id: TenantId, request: GradeSubmissionRequest) -> Result<GradingResult, CoordinatorError> {
        let ai_request = AiRequest {
            id: RequestId(generate_uuid()),
            tenant_id,
            request_type: AiRequestType::GradeSubmission(request),
            priority: RequestPriority::High,
            context: RequestContext::default(),
            created_at: DateTime::now(),
            timeout: self.config.request_timeout,
        };

        let response = send self <- Submit(ai_request)?;
        match response.result {
            AiResult::GradingResult(r) => Ok(r),
            AiResult::Error(e) => Err(e),
            _ => Err(CoordinatorError::UnexpectedResult),
        }
    }

