    // =========================================================================
    // Internal Methods
    // =========================================================================

    fn check_rate_limit(&mut self, tenant_id: &TenantId) -> bool {
        // Check global rate limit
        if !self.global_rate_limiter.try_acquire() {
            return false;
        }

        // Check per-tenant rate limit
        let limiter = self.rate_limiters.entry(tenant_id.clone())
            .or_insert_with(|| RateLimiter::new(100.0)); // 100 req/sec per tenant

        limiter.try_acquire()
    }

    async fn route_request(&mut self, request: &AiRequest) -> Result<AiResult, CoordinatorError> {
        match &request.request_type {
            // Assessment Hive routing
            AiRequestType::GradeSubmission(req) => {
                self.route_to_assessment_hive(request, |hive| async {
                    // Would call actual hive method
                    Ok(AiResult::GradingResult(GradingResult::default()))
                }).await
            },
            AiRequestType::CheckPlagiarism(req) => {
                self.route_to_assessment_hive(request, |hive| async {
                    Ok(AiResult::PlagiarismResult(PlagiarismResult::default()))
                }).await
            },

            // Learning Path Hive routing
            AiRequestType::GetLearningPath(req) => {
                self.route_to_learning_path_hive(request, |hive| async {
                    Ok(AiResult::LearningPath(PathRecommendation::default()))
                }).await
            },
            AiRequestType::GetRecommendations(req) => {
                self.route_to_learning_path_hive(request, |hive| async {
                    Ok(AiResult::Recommendations(vec![]))
                }).await
            },

            // Content Hive routing
            AiRequestType::GenerateQuestions(req) => {
                self.route_to_content_hive(request, |hive| async {
                    Ok(AiResult::Questions(vec![]))
                }).await
            },
            AiRequestType::CreateLesson(req) => {
                self.route_to_content_hive(request, |hive| async {
                    Ok(AiResult::Lesson(GeneratedLesson::default()))
                }).await
            },

            // Tutor Hive routing
            AiRequestType::StartTutorSession(req) => {
                self.route_to_tutor_hive(request, |hive| async {
                    Ok(AiResult::TutorSession(TutorSession::default()))
                }).await
            },
            AiRequestType::Chat(req) => {
                self.route_to_tutor_hive(request, |hive| async {
                    Ok(AiResult::ChatResponse(ChatResponse::default()))
                }).await
            },

            // Observation Hive routing
            AiRequestType::GetSystemHealth => {
                self.route_to_observation_hive(request, |hive| async {
                    Ok(AiResult::SystemHealth(SystemHealth::default()))
                }).await
            },
            AiRequestType::EvaluateStudentRisk(req) => {
                self.route_to_observation_hive(request, |hive| async {
                    Ok(AiResult::RiskAssessment(AtRiskStudent::default()))
                }).await
            },

            _ => Err(CoordinatorError::UnsupportedRequestType),
        }
    }

    async fn route_to_assessment_hive<F, Fut>(&mut self, request: &AiRequest, handler: F) -> Result<AiResult, CoordinatorError>
    where
        F: FnOnce(&Arc<AssessmentHive>) -> Fut,
        Fut: std::future::Future<Output = Result<AiResult, CoordinatorError>>,
    {
        let hive = self.hives.get_assessment()
            .ok_or(CoordinatorError::HiveNotAvailable { hive: "assessment".to_string() })?;

        let cb = self.circuit_breakers.get_mut("assessment")
            .ok_or(CoordinatorError::HiveNotAvailable { hive: "assessment".to_string() })?;

        if !cb.is_available() {
            return Err(CoordinatorError::CircuitOpen { hive: "assessment".to_string() });
        }

        match handler(hive).await {
            Ok(result) => {
                cb.record_success();
                Ok(result)
            },
            Err(e) => {
                cb.record_failure();
                self.metrics.errors += 1;
                Err(e)
            }
        }
    }

    async fn route_to_learning_path_hive<F, Fut>(&mut self, request: &AiRequest, handler: F) -> Result<AiResult, CoordinatorError>
    where
        F: FnOnce(&Arc<LearningPathHive>) -> Fut,
        Fut: std::future::Future<Output = Result<AiResult, CoordinatorError>>,
    {
        let hive = self.hives.get_learning_path()
            .ok_or(CoordinatorError::HiveNotAvailable { hive: "learning_path".to_string() })?;

        let cb = self.circuit_breakers.get_mut("learning_path")
            .ok_or(CoordinatorError::HiveNotAvailable { hive: "learning_path".to_string() })?;

        if !cb.is_available() {
            return Err(CoordinatorError::CircuitOpen { hive: "learning_path".to_string() });
        }

        match handler(hive).await {
            Ok(result) => {
                cb.record_success();
                Ok(result)
            },
            Err(e) => {
                cb.record_failure();
                self.metrics.errors += 1;
                Err(e)
            }
        }
    }

