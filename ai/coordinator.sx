// =============================================================================
// INTELLIGO LMS - AI Coordinator
// =============================================================================
// Central orchestration layer for all AI hives following CHAI patterns.
// Coordinates cross-hive operations, manages shared resources, handles
// routing, load balancing, cost tracking, and provides unified API access
// to the AI subsystem.
// =============================================================================

module intelligo::ai::coordinator

use intelligo::core::types::*
use intelligo::ai::hives::assessment_hive::{AssessmentHive, GradingTask, GradingResult, AssessmentError}
use intelligo::ai::hives::learning_path_hive::{LearningPathHive, PathRecommendation, DiagnosticResult, LearningPathError}
use intelligo::ai::hives::content_hive::{ContentHive, GeneratedQuestion, GeneratedLesson, GeneratedRubric, ContentError}
use intelligo::ai::hives::tutor_hive::{TutorHive, TutorSession, ChatResponse, StudyGuide, TutorError}
use intelligo::ai::hives::observation_hive::{ObservationHive, SystemHealth, LearningAnalyticsReport, AtRiskStudent, ObservationError}
use std::time::{DateTime, Duration}
use std::collections::{Map, List, Set, VecDeque}
use std::sync::{Arc, RwLock, Mutex}

// =============================================================================
// Coordinator Types
// =============================================================================

type RequestId = String
type TenantId = String

/// Coordinator configuration
pub struct CoordinatorConfig {
    /// Maximum concurrent requests per tenant
    max_requests_per_tenant: i32,
    /// Global rate limit (requests per second)
    global_rate_limit: f64,
    /// Request timeout
    request_timeout: Duration,
    /// Cost tracking enabled
    cost_tracking_enabled: bool,
    /// Cost budget per tenant (monthly)
    tenant_cost_budget: Option<f64>,
    /// Enable request caching
    caching_enabled: bool,
    /// Cache TTL
    cache_ttl: Duration,
    /// Enable circuit breaker
    circuit_breaker_enabled: bool,
    /// Circuit breaker failure threshold
    circuit_breaker_threshold: i32,
    /// Enable load balancing across model instances
    load_balancing_enabled: bool,
    /// Health check interval
    health_check_interval: Duration,
    /// Enable request prioritization
    prioritization_enabled: bool,
}

impl Default for CoordinatorConfig {
    fn default() -> Self {
        CoordinatorConfig {
            max_requests_per_tenant: 100,
            global_rate_limit: 1000.0,
            request_timeout: Duration::seconds(120),
            cost_tracking_enabled: true,
            tenant_cost_budget: None,
            caching_enabled: true,
            cache_ttl: Duration::hours(1),
            circuit_breaker_enabled: true,
            circuit_breaker_threshold: 5,
            load_balancing_enabled: true,
            health_check_interval: Duration::seconds(30),
            prioritization_enabled: true,
        }
    }
}

/// AI request with routing information
pub struct AiRequest {
    id: RequestId,
    tenant_id: TenantId,
    request_type: AiRequestType,
    priority: RequestPriority,
    context: RequestContext,
    created_at: DateTime,
    timeout: Duration,
}

/// AI request type for routing
pub enum AiRequestType {
    // Assessment Hive
    GradeSubmission(GradeSubmissionRequest),
    CheckPlagiarism(PlagiarismCheckRequest),
    CalibrateGrading(CalibrationRequest),

    // Learning Path Hive
    GetLearningPath(LearningPathRequest),
    GetRecommendations(RecommendationRequest),
    RunDiagnostic(DiagnosticRequest),
    UpdateMastery(MasteryUpdateRequest),

    // Content Hive
    GenerateQuestions(QuestionGenerationRequest),
    CreateLesson(LessonCreationRequest),
    BuildRubric(RubricBuildRequest),
    SummarizeContent(SummarizationRequest),
    TranscribeMedia(TranscriptionRequest),

    // Tutor Hive
    StartTutorSession(TutorSessionRequest),
    Chat(ChatRequest),
    ExplainConcept(ConceptExplanationRequest),
    GeneratePractice(PracticeGenerationRequest),
    CreateStudyGuide(StudyGuideRequest),

    // Observation Hive
    GetSystemHealth,
    GenerateAnalyticsReport(AnalyticsReportRequest),
    EvaluateStudentRisk(RiskEvaluationRequest),
    PredictCompletion(CompletionPredictionRequest),
}

/// Request priority
pub enum RequestPriority {
    /// Critical operations (real-time tutoring)
    Critical,
    /// High priority (grading during exam)
    High,
    /// Normal priority (standard operations)
    Normal,
    /// Low priority (background tasks)
    Low,
    /// Batch operations
    Batch,
}

/// Request context
pub struct RequestContext {
    user_id: Option<UserId>,
    course_id: Option<CourseId>,
    session_id: Option<String>,
    metadata: Map<String, Dynamic>,
}

/// AI response wrapper
pub struct AiResponse {
    request_id: RequestId,
    result: AiResult,
    metrics: ResponseMetrics,
    completed_at: DateTime,
}

/// AI result enum
pub enum AiResult {
    // Assessment results
    GradingResult(GradingResult),
    PlagiarismResult(PlagiarismResult),
    CalibrationResult(CalibrationAdjustments),

    // Learning path results
    LearningPath(PathRecommendation),
    Recommendations(List<ContentRecommendation>),
    Diagnostic(DiagnosticResult),
    MasteryUpdated,

    // Content results
    Questions(List<GeneratedQuestion>),
    Lesson(GeneratedLesson),
    Rubric(GeneratedRubric),
    Summary(GeneratedSummary),
    Transcript(GeneratedTranscript),

    // Tutor results
    TutorSession(TutorSession),
    ChatResponse(ChatResponse),
    ConceptExplanation(ConceptExplanation),
    PracticeProblem(PracticeProblem),
    StudyGuide(StudyGuide),

    // Observation results
    SystemHealth(SystemHealth),
    AnalyticsReport(LearningAnalyticsReport),
    RiskAssessment(AtRiskStudent),
    CompletionPrediction(CompletionPrediction),

    // Error
    Error(CoordinatorError),
}

/// Response metrics
pub struct ResponseMetrics {
    processing_time_ms: i64,
    tokens_used: i64,
    cost: f64,
    hive_used: String,
    cache_hit: bool,
}

