// =============================================================================
// Cost Tracking
// =============================================================================

/// Cost tracker for AI usage
pub struct CostTracker {
    /// Per-tenant costs
    tenant_costs: Map<TenantId, TenantCostRecord>,
    /// Per-hive costs
    hive_costs: Map<String, f64>,
    /// Daily cost history
    daily_history: VecDeque<DailyCost>,
    /// Total cost
    total_cost: f64,
}

impl CostTracker {
    pub fn new() -> Self {
        CostTracker {
            tenant_costs: Map::new(),
            hive_costs: Map::new(),
            daily_history: VecDeque::with_capacity(90),
            total_cost: 0.0,
        }
    }

    pub fn record_cost(&mut self, tenant_id: &TenantId, hive: &str, cost: f64, tokens: i64) {
        // Update tenant costs
        let record = self.tenant_costs.entry(tenant_id.clone())
            .or_insert_with(|| TenantCostRecord::new());
        record.add_cost(cost, tokens);

        // Update hive costs
        *self.hive_costs.entry(hive.to_string()).or_insert(0.0) += cost;

        // Update total
        self.total_cost += cost;

        // Update daily history
        let today = DateTime::now().date();
        if let Some(last) = self.daily_history.back_mut() {
            if last.date == today {
                last.cost += cost;
                last.tokens += tokens;
                return;
            }
        }

        if self.daily_history.len() >= 90 {
            self.daily_history.pop_front();
        }
        self.daily_history.push_back(DailyCost {
            date: today,
            cost,
            tokens,
        });
    }

    pub fn get_tenant_cost(&self, tenant_id: &TenantId) -> Option<&TenantCostRecord> {
        self.tenant_costs.get(tenant_id)
    }

    pub fn get_monthly_cost(&self, tenant_id: &TenantId) -> f64 {
        self.tenant_costs.get(tenant_id)
            .map(|r| r.monthly_cost)
            .unwrap_or(0.0)
    }

    pub fn is_over_budget(&self, tenant_id: &TenantId, budget: f64) -> bool {
        self.get_monthly_cost(tenant_id) >= budget
    }
}

/// Tenant cost record
pub struct TenantCostRecord {
    total_cost: f64,
    monthly_cost: f64,
    monthly_tokens: i64,
    requests_this_month: i64,
    month_start: DateTime,
}

impl TenantCostRecord {
    pub fn new() -> Self {
        TenantCostRecord {
            total_cost: 0.0,
            monthly_cost: 0.0,
            monthly_tokens: 0,
            requests_this_month: 0,
            month_start: DateTime::now().start_of_month(),
        }
    }

    pub fn add_cost(&mut self, cost: f64, tokens: i64) {
        // Reset monthly if new month
        let current_month = DateTime::now().start_of_month();
        if current_month > self.month_start {
            self.monthly_cost = 0.0;
            self.monthly_tokens = 0;
            self.requests_this_month = 0;
            self.month_start = current_month;
        }

        self.total_cost += cost;
        self.monthly_cost += cost;
        self.monthly_tokens += tokens;
        self.requests_this_month += 1;
    }
}

/// Daily cost record
pub struct DailyCost {
    date: DateTime,
    cost: f64,
    tokens: i64,
}

// =============================================================================
// Circuit Breaker
// =============================================================================

/// Circuit breaker for fault tolerance
pub struct CircuitBreaker {
    state: CircuitState,
    failure_count: i32,
    threshold: i32,
    last_failure: Option<DateTime>,
    reset_timeout: Duration,
}

/// Circuit state
pub enum CircuitState {
    Closed,
    Open,
    HalfOpen,
}

impl CircuitBreaker {
    pub fn new(threshold: i32) -> Self {
        CircuitBreaker {
            state: CircuitState::Closed,
            failure_count: 0,
            threshold,
            last_failure: None,
            reset_timeout: Duration::seconds(30),
        }
    }

    pub fn is_available(&mut self) -> bool {
        match self.state {
            CircuitState::Closed => true,
            CircuitState::Open => {
                if let Some(last) = &self.last_failure {
                    if DateTime::now() - *last > self.reset_timeout {
                        self.state = CircuitState::HalfOpen;
                        return true;
                    }
                }
                false
            },
            CircuitState::HalfOpen => true,
        }
    }

    pub fn record_success(&mut self) {
        self.failure_count = 0;
        self.state = CircuitState::Closed;
    }

    pub fn record_failure(&mut self) {
        self.failure_count += 1;
        self.last_failure = Some(DateTime::now());

        if self.failure_count >= self.threshold {
            self.state = CircuitState::Open;
        }
    }
}

// =============================================================================
// Rate Limiter
// =============================================================================

/// Token bucket rate limiter
pub struct RateLimiter {
    tokens: f64,
    capacity: f64,
    refill_rate: f64,
    last_refill: DateTime,
}

impl RateLimiter {
    pub fn new(rate_per_second: f64) -> Self {
        RateLimiter {
            tokens: rate_per_second,
            capacity: rate_per_second * 10.0, // Allow burst of 10 seconds
            refill_rate: rate_per_second,
            last_refill: DateTime::now(),
        }
    }

    pub fn try_acquire(&mut self) -> bool {
        self.refill();

        if self.tokens >= 1.0 {
            self.tokens -= 1.0;
            true
        } else {
            false
        }
    }

    fn refill(&mut self) {
        let now = DateTime::now();
        let elapsed = (now - self.last_refill).as_seconds() as f64;
        self.tokens = (self.tokens + elapsed * self.refill_rate).min(self.capacity);
        self.last_refill = now;
    }
}

// =============================================================================
// Request Queue
// =============================================================================

/// Priority request queue
pub struct RequestQueue {
    critical: VecDeque<AiRequest>,
    high: VecDeque<AiRequest>,
    normal: VecDeque<AiRequest>,
    low: VecDeque<AiRequest>,
    batch: VecDeque<AiRequest>,
}

impl RequestQueue {
    pub fn new() -> Self {
        RequestQueue {
            critical: VecDeque::new(),
            high: VecDeque::new(),
            normal: VecDeque::new(),
            low: VecDeque::new(),
            batch: VecDeque::new(),
        }
    }

    pub fn enqueue(&mut self, request: AiRequest) {
        match request.priority {
            RequestPriority::Critical => self.critical.push_back(request),
            RequestPriority::High => self.high.push_back(request),
            RequestPriority::Normal => self.normal.push_back(request),
            RequestPriority::Low => self.low.push_back(request),
            RequestPriority::Batch => self.batch.push_back(request),
        }
    }

    pub fn dequeue(&mut self) -> Option<AiRequest> {
        self.critical.pop_front()
            .or_else(|| self.high.pop_front())
            .or_else(|| self.normal.pop_front())
            .or_else(|| self.low.pop_front())
            .or_else(|| self.batch.pop_front())
    }

    pub fn len(&self) -> usize {
        self.critical.len() + self.high.len() + self.normal.len() + self.low.len() + self.batch.len()
    }

    pub fn is_empty(&self) -> bool {
        self.len() == 0
    }
}

// =============================================================================
// Hive Registry
// =============================================================================

/// Registry of all AI hives
pub struct HiveRegistry {
    assessment: Option<Arc<AssessmentHive>>,
    learning_path: Option<Arc<LearningPathHive>>,
    content: Option<Arc<ContentHive>>,
    tutor: Option<Arc<TutorHive>>,
    observation: Option<Arc<ObservationHive>>,
}

impl HiveRegistry {
    pub fn new() -> Self {
        HiveRegistry {
            assessment: None,
            learning_path: None,
            content: None,
            tutor: None,
            observation: None,
        }
    }

    pub fn register_assessment(&mut self, hive: Arc<AssessmentHive>) {
        self.assessment = Some(hive);
    }

    pub fn register_learning_path(&mut self, hive: Arc<LearningPathHive>) {
        self.learning_path = Some(hive);
    }

    pub fn register_content(&mut self, hive: Arc<ContentHive>) {
        self.content = Some(hive);
    }

    pub fn register_tutor(&mut self, hive: Arc<TutorHive>) {
        self.tutor = Some(hive);
    }

    pub fn register_observation(&mut self, hive: Arc<ObservationHive>) {
        self.observation = Some(hive);
    }

    pub fn get_assessment(&self) -> Option<&Arc<AssessmentHive>> {
        self.assessment.as_ref()
    }

    pub fn get_learning_path(&self) -> Option<&Arc<LearningPathHive>> {
        self.learning_path.as_ref()
    }

    pub fn get_content(&self) -> Option<&Arc<ContentHive>> {
        self.content.as_ref()
    }

    pub fn get_tutor(&self) -> Option<&Arc<TutorHive>> {
        self.tutor.as_ref()
    }

    pub fn get_observation(&self) -> Option<&Arc<ObservationHive>> {
        self.observation.as_ref()
    }
}

// =============================================================================
// AI Coordinator Actor
// =============================================================================

/// Central AI Coordinator
pub actor AiCoordinator {
    var config: CoordinatorConfig = CoordinatorConfig::default()
    var hives: HiveRegistry = HiveRegistry::new()

    var cost_tracker: CostTracker = CostTracker::new()
    var circuit_breakers: Map<String, CircuitBreaker> = Map::new()
    var rate_limiters: Map<TenantId, RateLimiter> = Map::new()
    var global_rate_limiter: RateLimiter

    var request_queue: RequestQueue = RequestQueue::new()
    var pending_requests: Map<RequestId, AiRequest> = Map::new()
    var request_cache: Map<String, (AiResult, DateTime)> = Map::new()

    var metrics: CoordinatorMetrics = CoordinatorMetrics::default()
    var is_running: bool = false

    pub fn new() -> Self {
        let config = CoordinatorConfig::default();

        AiCoordinator {
            config: config.clone(),
            global_rate_limiter: RateLimiter::new(config.global_rate_limit),
            ..Default::default()
        }
    }

    /// Initialize all hives
    pub receive Initialize() -> Result<(), CoordinatorError> {
        println!("[AiCoordinator] Initializing all hives...");

        // Create and register all hives
        let assessment_hive = Arc::new(AssessmentHive::new());
        let learning_path_hive = Arc::new(LearningPathHive::new());
        let content_hive = Arc::new(ContentHive::new());
        let tutor_hive = Arc::new(TutorHive::new());
        let observation_hive = Arc::new(ObservationHive::new());

        self.hives.register_assessment(assessment_hive);
        self.hives.register_learning_path(learning_path_hive);
        self.hives.register_content(content_hive);
        self.hives.register_tutor(tutor_hive);
        self.hives.register_observation(observation_hive);

        // Initialize circuit breakers
        self.circuit_breakers.insert("assessment".to_string(), CircuitBreaker::new(self.config.circuit_breaker_threshold));
        self.circuit_breakers.insert("learning_path".to_string(), CircuitBreaker::new(self.config.circuit_breaker_threshold));
        self.circuit_breakers.insert("content".to_string(), CircuitBreaker::new(self.config.circuit_breaker_threshold));
        self.circuit_breakers.insert("tutor".to_string(), CircuitBreaker::new(self.config.circuit_breaker_threshold));
        self.circuit_breakers.insert("observation".to_string(), CircuitBreaker::new(self.config.circuit_breaker_threshold));

        println!("[AiCoordinator] All hives registered");

        checkpoint();
        Ok(())
    }

    /// Start all hives
    pub receive Start() -> Result<(), CoordinatorError> {
        if self.is_running {
            return Err(CoordinatorError::AlreadyRunning);
        }

        println!("[AiCoordinator] Starting all hives...");

        // Start each hive
        if let Some(hive) = self.hives.get_assessment() {
            send hive <- Start().await?;
        }
        if let Some(hive) = self.hives.get_learning_path() {
            send hive <- Start().await?;
        }
        if let Some(hive) = self.hives.get_content() {
            send hive <- Start().await?;
        }
        if let Some(hive) = self.hives.get_tutor() {
            send hive <- Start().await?;
        }
        if let Some(hive) = self.hives.get_observation() {
            send hive <- Start().await?;
        }

        self.is_running = true;

        // Start background tasks
        spawn self.process_request_queue();
        spawn self.health_check_loop();
        spawn self.cache_cleanup_loop();

        println!("[AiCoordinator] All hives started");

        checkpoint();
        Ok(())
    }

    /// Stop all hives
    pub receive Stop() {
        println!("[AiCoordinator] Stopping all hives...");

        self.is_running = false;

        if let Some(hive) = self.hives.get_assessment() {
            send hive <- Stop();
        }
        if let Some(hive) = self.hives.get_learning_path() {
            send hive <- Stop();
        }
        if let Some(hive) = self.hives.get_content() {
            send hive <- Stop();
        }
        if let Some(hive) = self.hives.get_tutor() {
            send hive <- Stop();
        }
        if let Some(hive) = self.hives.get_observation() {
            send hive <- Stop();
        }

        println!("[AiCoordinator] All hives stopped");
        checkpoint();
    }

    /// Submit an AI request
    pub receive Submit(request: AiRequest) -> Result<AiResponse, CoordinatorError> {
        let start_time = DateTime::now();
        let request_id = request.id.clone();

        // Check rate limits
        if !self.check_rate_limit(&request.tenant_id) {
            return Err(CoordinatorError::RateLimitExceeded { tenant_id: request.tenant_id.clone() });
        }

        // Check budget
        if let Some(budget) = self.config.tenant_cost_budget {
            if self.cost_tracker.is_over_budget(&request.tenant_id, budget) {
                return Err(CoordinatorError::BudgetExceeded { tenant_id: request.tenant_id.clone() });
            }
        }

        // Check cache
        let cache_key = self.compute_cache_key(&request);
        if self.config.caching_enabled {
            if let Some((result, cached_at)) = self.request_cache.get(&cache_key) {
                if DateTime::now() - *cached_at < self.config.cache_ttl {
                    self.metrics.cache_hits += 1;
                    return Ok(AiResponse {
                        request_id,
                        result: result.clone(),
                        metrics: ResponseMetrics {
                            processing_time_ms: 0,
                            tokens_used: 0,
                            cost: 0.0,
                            hive_used: "cache".to_string(),
                            cache_hit: true,
                        },
                        completed_at: DateTime::now(),
                    });
                }
            }
        }

        // Route to appropriate hive
        let result = self.route_request(&request).await?;

        // Calculate metrics
        let processing_time = (DateTime::now() - start_time).as_millis() as i64;

        // Track cost
        let (tokens, cost, hive_name) = self.extract_cost_info(&result);
        self.cost_tracker.record_cost(&request.tenant_id, &hive_name, cost, tokens);

        // Cache result
        if self.config.caching_enabled && self.is_cacheable(&request) {
            self.request_cache.insert(cache_key, (result.clone(), DateTime::now()));
        }

        // Update metrics
        self.metrics.requests_processed += 1;
        self.metrics.total_processing_time_ms += processing_time;

        checkpoint();
        Ok(AiResponse {
            request_id,
            result,
            metrics: ResponseMetrics {
                processing_time_ms: processing_time,
                tokens_used: tokens,
                cost,
                hive_used: hive_name,
                cache_hit: false,
            },
            completed_at: DateTime::now(),
        })
    }

    /// Queue a request for async processing
    pub receive QueueRequest(request: AiRequest) -> RequestId {
        let request_id = request.id.clone();
        self.pending_requests.insert(request_id.clone(), request.clone());
        self.request_queue.enqueue(request);
        self.metrics.requests_queued += 1;
        checkpoint();
        request_id
    }

    /// Get request status
    pub receive GetRequestStatus(request_id: RequestId) -> Option<RequestStatus> {
        if self.pending_requests.contains_key(&request_id) {
            Some(RequestStatus::Pending)
        } else {
            None
        }
    }

    /// Get coordinator health
    pub receive GetHealth() -> CoordinatorHealth {
        let mut hive_health = Map::new();

        for (name, cb) in &self.circuit_breakers {
            hive_health.insert(name.clone(), HiveHealth {
                available: cb.is_available(),
                circuit_state: match cb.state {
                    CircuitState::Closed => "closed".to_string(),
                    CircuitState::Open => "open".to_string(),
                    CircuitState::HalfOpen => "half_open".to_string(),
                },
                failure_count: cb.failure_count,
            });
        }

        CoordinatorHealth {
            is_running: self.is_running,
            queue_depth: self.request_queue.len(),
            hive_health,
            metrics: self.metrics.clone(),
        }
    }

    /// Get cost report
    pub receive GetCostReport(tenant_id: Option<TenantId>) -> CostReport {
        match tenant_id {
            Some(tid) => {
                let record = self.cost_tracker.get_tenant_cost(&tid);
                CostReport {
                    total_cost: record.map(|r| r.total_cost).unwrap_or(0.0),
                    monthly_cost: record.map(|r| r.monthly_cost).unwrap_or(0.0),
                    monthly_tokens: record.map(|r| r.monthly_tokens).unwrap_or(0),
                    by_hive: self.cost_tracker.hive_costs.clone(),
                }
            },
            None => {
                CostReport {
                    total_cost: self.cost_tracker.total_cost,
                    monthly_cost: 0.0, // Would sum all tenants
                    monthly_tokens: 0,
                    by_hive: self.cost_tracker.hive_costs.clone(),
                }
            }
        }
    }

    /// Get all metrics
    pub receive GetMetrics() -> CoordinatorMetrics {
        self.metrics.clone()
    }

    // =========================================================================
